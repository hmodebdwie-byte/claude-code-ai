@@ -0,0 +1,1154 @@
+import { useCallback, useEffect, useState } from "react";
+import axios from "../../utils/axios";
+import { usePermission } from "../../hooks/usePermission";
+import "./CreatorPlatform.css";
+const tabs = [
+  ["packages", "Packages"],
+  ["history", "History & imports"],
+  ["data", "Feature catalog"],
+  ["research", "Research jobs"],
+  ["marketplace", "Publication review"],
+  ["licenses", "Licenses"],
+  ["runs", "Runtime"],
+  ["expert-journal", "Live orders"],
+  ["settings", "Settings"],
+  ["audit", "Audit trail"],
+];
+const fmt = (v) =>
+  v == null
+    ? "—"
+    : Number(v).toLocaleString(undefined, { maximumFractionDigits: 2 });
+const date = (v) => (v ? new Date(v).toLocaleString() : "—");
+const get = async (p) => (await axios.get(`/admin/creator/${p}`)).data;
+const post = async (p, b) =>
+  (await axios.post(`/admin/creator/${p}`, b, { timeout: 45000 })).data;
+const saveFile = (name, data) => {
+  const url = URL.createObjectURL(
+    new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }),
+  );
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = name;
+  a.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+};
+export default function CreatorPlatform() {
+  const canView = usePermission("creator.view"),
+    canManage = usePermission("creator.manage");
+  const [tab, setTab] = useState("history"),
+    [overview, setOverview] = useState(null),
+    [rows, setRows] = useState([]),
+    [data, setData] = useState(null),
+    [settings, setSettings] = useState(null),
+    [error, setError] = useState(""),
+    [notice, setNotice] = useState(""),
+    [loading, setLoading] = useState(false),
+    [target, setTarget] = useState(null),
+    [reason, setReason] = useState(""),
+    [action, setAction] = useState(""),
+    [mode, setMode] = useState("all"),
+    [search, setSearch] = useState("");
+  const [importForm, setImport] = useState({
+      mode: "arena",
+      name: "",
+      symbol: "TICK",
+      format: "json",
+      content: "",
+    }),
+    [preview, setPreview] = useState(null),
+    [retention, setRetention] = useState(null),
+    [confirmation, setConfirmation] = useState(""),
+    [grant, setGrant] = useState({
+      ownerId: "",
+      listingId: "",
+      expiresAt: "",
+      reason: "",
+    }),
+    [tradeId, setTradeId] = useState(""),
+    [sourceReview, setSourceReview] = useState(null);
+  const load = useCallback(async () => {
+    if (!canView) return;
+    setLoading(true);
+    try {
+      const [o, r] = await Promise.all([get("overview"), get(tab)]);
+      setOverview(o);
+      if (tab === "data") setData(r);
+      else if (tab === "settings") setSettings((s) => s || r);
+      else setRows(r);
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setLoading(false);
+    }
+  }, [tab, canView]);
+  useEffect(() => {
+    setRows([]);
+    setError("");
+    setSearch("");
+    setNotice("");
+    void load();
+    const timer = setInterval(() => {
+      if (tab !== "settings" && !target) void load();
+    }, 12000);
+    return () => clearInterval(timer);
+  }, [load]);
+  useEffect(() => {
+    const key = (e) => {
+      if (e.key === "Escape") {
+        setTarget(null);
+        setSourceReview(null);
+      }
+    };
+    window.addEventListener("keydown", key);
+    return () => window.removeEventListener("keydown", key);
+  }, []);
+  async function task(fn) {
+    setLoading(true);
+    setError("");
+    try {
+      await fn();
+      await load();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setLoading(false);
+    }
+  }
+  function ask(row, kind) {
+    setTarget(row);
+    setAction(kind);
+    setReason("");
+    setTradeId("");
+    setConfirmation("");
+  }
+  async function perform() {
+    await task(async () => {
+      if (action === "package")
+        await axios.patch(`/admin/creator/packages/${target.id}`, {
+          disabled: !target.disabled,
+          reason,
+        });
+      if (["published", "rejected", "suspended"].includes(action))
+        await axios.patch(`/admin/creator/marketplace/${target.id}`, {
+          status: action,
+          reason,
+        });
+      if (action === "revoke-license")
+        await post(`licenses/${target.id}/revoke`, { reason });
+      if (action === "stop")
+        await post(`experts/${target.id}/stop`, { reason });
+      if (action === "resolve")
+        await post(`expert-journal/${target.id}/resolve`, {
+          reason,
+          ...(tradeId
+            ? { tradeId: Number(tradeId) }
+            : { confirm: confirmation }),
+        });
+      setTarget(null);
+      setNotice("Action recorded in Creator audit trail.");
+    });
+  }
+  const visible = rows.filter(
+    (r) =>
+      (mode === "all" || r.mode === mode || tab !== "history") &&
+      JSON.stringify(r).toLowerCase().includes(search.toLowerCase()),
+  );
+  if (!canView)
+    return (
+      <div className="cp-admin">You do not have Creator Platform access.</div>
+    );
+  return (
+    <section className="cp-admin">
+      <header>
+        <div>
+          <span className="cp-eyebrow">TICKTRADE / CREATOR INFRASTRUCTURE</span>
+          <h1>One workspace. A complete record.</h1>
+          <p>
+            Operate the historical archive, script runtime, expert permissions
+            and creator marketplace.
+          </p>
+        </div>
+        <div className="cp-actions">
+          <button disabled={loading} onClick={load}>
+            Refresh
+          </button>
+          <button
+            onClick={() =>
+              saveFile(
+                `creator-${tab}.json`,
+                tab === "data" ? data : tab === "settings" ? settings : rows,
+              )
+            }
+          >
+            Export view
+          </button>
+        </div>
+      </header>
+      <div className="cp-stats">
+        {[
+          ["Packages", overview?.packages],
+          ["Active installations", overview?.active],
+          ["Paper experts", overview?.paper],
+          ["Runtime errors", overview?.errors],
+        ].map(([label, v]) => (
+          <div key={label}>
+            <span>{label}</span>
+            <strong>{fmt(v)}</strong>
+          </div>
+        ))}
+      </div>
+      <nav>
+        {tabs.map(([id, label]) => (
+          <button
+            key={id}
+            className={tab === id ? "active" : ""}
+            onClick={() => setTab(id)}
+          >
+            {label}
+          </button>
+        ))}
+      </nav>
+      {error && (
+        <p className="cp-error" role="alert">
+          {error}
+        </p>
+      )}
+      {notice && (
+        <p className="cp-good" role="status">
+          {notice}
+        </p>
+      )}
+      {!["settings", "data"].includes(tab) && (
+        <div className="cp-filters">
+          <input
+            aria-label="Search Creator records"
+            placeholder="Search this view…"
+            value={search}
+            onChange={(e) => setSearch(e.target.value)}
+          />
+          {tab === "history" && (
+            <select
+              aria-label="History market mode"
+              value={mode}
+              onChange={(e) => setMode(e.target.value)}
+            >
+              <option value="all">Arena + Binary</option>
+              <option value="arena">Arena</option>
+              <option value="binary">Binary</option>
+            </select>
+          )}
+          <small>{visible.length} records shown</small>
+        </div>
+      )}
+      {tab === "history" && (
+        <>
+          <div className="cp-table-wrap">
+            <table>
+              <thead>
+                <tr>
+                  <th>Dataset</th>
+                  <th>Mode / type</th>
+                  <th>Observations</th>
+                  <th>First / last</th>
+                  <th>Provenance</th>
+                </tr>
+              </thead>
+              <tbody>
+                {visible.map((r) => (
+                  <tr key={r.id}>
+                    <td>
+                      <strong>{r.name}</strong>
+                      <small>{r.id}</small>
+                    </td>
+                    <td>
+                      {r.mode} / {r.kind}
+                      <small>{r.symbol}</small>
+                    </td>
+                    <td>{fmt(r.coverage?.count)}</td>
+                    <td>
+                      {date(r.coverage?.from)}
+                      <small>{date(r.coverage?.to)}</small>
+                    </td>
+                    <td>
+                      <code>
+                        {r.checksum?.slice(0, 16) || "Continuous capture"}
+                      </code>
+                      <small>{r.metadata?.source || "Validated import"}</small>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          <p className="cp-note">
+            Arena capture reads existing price records and adds timestamped
+            feature snapshots. Binary history is stored independently; Binary
+            execution remains unavailable.
+          </p>
+          {canManage && (
+            <div className="cp-admin-grid">
+              <article className="cp-panel">
+                <h2>Capture & retention</h2>
+                <p>
+                  Backfill existing records and continue recording without
+                  changing engine or settlement records.
+                </p>
+                <div className="cp-actions">
+                  <button
+                    disabled={loading}
+                    onClick={() =>
+                      task(async () => {
+                        const r = await post("history/capture", {});
