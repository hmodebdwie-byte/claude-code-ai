+              <textarea
+                autoFocus
+                minLength={action === "resolve" ? 10 : 5}
+                maxLength="500"
+                rows="4"
+                value={reason}
+                onChange={(e) => setReason(e.target.value)}
+              />
+            </label>
+            <div className="cp-actions">
+              <button onClick={() => setTarget(null)}>Cancel</button>
+              <button
+                disabled={
+                  loading ||
+                  reason.trim().length < (action === "resolve" ? 10 : 5) ||
+                  (action === "resolve" &&
+                    !tradeId &&
+                    confirmation !== "NO TRADE EXECUTED")
+                }
+                onClick={perform}
+              >
+                Confirm action
+              </button>
+            </div>
+            {error && <p className="cp-error">{error}</p>}
+          </section>
+        </div>
+      )}
+    </section>
+  );
+}
