+                          max={p.max}
+                          step={p.type === "integer" ? 1 : "any"}
+                          value={params[k] ?? p.default}
+                          onChange={(e) =>
+                            setParams((v) => ({
+                              ...v,
+                              [k]: Number(e.target.value),
+                            }))
+                          }
+                        />
+                      )}
+                    </label>
+                  ),
+                )}
+              </div>
+              {selected.manifest?.kind === "expert" && (
+                <p>
+                  Adding expert signals does not place orders. Use Studio →
+                  Experts to configure paper or live execution.
+                </p>
+              )}
+              <button
+                className="cr-button primary"
+                disabled={busy || !selected.manifest?.modes?.includes("arena")}
+                onClick={() => task(attach)}
+              >
+                <Plus size={16} />
+                {busy ? "Adding…" : "Add to Arena"}
+              </button>
+              {!selected.manifest?.modes?.includes("arena") && (
+                <p>
+                  Binary tools are available for historical research in Studio.
+                </p>
+              )}
+            </>
+          ) : selected.available === false ? (
+            <p>
+              This license or package is inactive.{" "}
+              {selected.expiresAt
+                ? `License ended ${dateTime(selected.expiresAt)}.`
+                : ""}
+            </p>
+          ) : (
+            <button
+              className="cr-button primary"
+              disabled={busy}
+              onClick={() => task(acquire)}
+            >
+              {selected.license === "free"
+                ? "Add to collection"
+                : `${selected.license === "purchase" ? "Purchase" : "Rent / subscribe"} · ${(selected.priceCents / 100).toFixed(2)} ${selected.currency?.toUpperCase()}`}
+            </button>
+          )}
+          {selected.own && (
+            <a
+              className="cr-button"
+              href={`/studio?version=${selected.versionId}`}
+              target="_blank"
+              rel="noopener"
+            >
+              Open code in Studio <ExternalLink size={13} />
+            </a>
+          )}
+        </Modal>
+      )}
+    </>
+  );
+  return (
+    <div className={`cr-studio cr-explorer ${onClose ? "is-modal" : ""}`}>
+      {onClose ? (
+        <Modal title="Indicators & experts" wide onClose={onClose}>
+          {content}
+        </Modal>
+      ) : (
+        <>
+          <header className="cr-v3-header">
+            <a className="cr-brand" href="/">
+              TT <strong>Indicators</strong>
+            </a>
+            <a className="cr-button" href="/">
+              Trading screen
+            </a>
+          </header>
+          <main className="cr-explorer-page">{content}</main>
+        </>
+      )}
+    </div>
+  );
+}
