+          external: r.external || {},
+          ...(r.round ? { round: r.round } : {}),
+        })),
+      });
+      if (after)
+        setError(
+          "Downloaded 50,000 observations. The export includes a continuation cursor for the remaining archive.",
+        );
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <section className="cr-section-page">
+      <div className="cr-page-heading">
+        <div>
+          <span className="cr-eyebrow">TICKTRADE INTELLIGENCE</span>
