+import { useState } from "react";
+import {
+  Eye,
+  EyeOff,
+  Layers,
+  RotateCcw,
+  X,
+  ExternalLink,
+  Settings2,
+} from "lucide-react";
+import { Link } from "react-router-dom";
+import { creatorApi } from "./api";
+import { creatorStore, refreshCreator } from "./store";
+import { Modal, ErrorBox } from "./ui";
+import "./creator.css";
+export default function ChartIndicatorControls({
+  compact = false,
+  rows: provided,
+  onChanged,
+}) {
+  const stored = creatorStore((s) => s.installations),
+    rows = provided || stored;
+  const [open, setOpen] = useState(false),
+    [busy, setBusy] = useState(""),
+    [error, setError] = useState(""),
+    [editing, setEditing] = useState(null),
+    [form, setForm] = useState(null);
+  async function act(r, body, reload = false) {
+    setBusy(r.id);
+    setError("");
+    try {
+      if (reload) await creatorApi.reloadHistory(r.id);
+      else await creatorApi.update(r.id, body);
+      await refreshCreator();
+      onChanged?.();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy("");
+    }
+  }
+  function settings(r) {
+    setEditing(r);
+    setError("");
+    setForm({
+      params: { ...r.params },
+      budget: Number(r.budget),
+      maxStake: Number(r.maxStake),
+      minIntervalSec: r.minIntervalSec,
+      risk: { ...r.risk },
+    });
+  }
+  async function configure() {
+    setBusy(editing.id);
+    setError("");
+    try {
+      await creatorApi.post(`installations/${editing.id}/configure`, form);
+      await refreshCreator();
+      setEditing(null);
+      onChanged?.();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy("");
+    }
+  }
+  return (
+    <div className={`cr-chart-controls ${compact ? "compact" : ""}`}>
+      <button
+        className="cr-button"
+        onClick={() => setOpen(!open)}
+        aria-expanded={open}
+        aria-label="Manage chart indicators"
+      >
+        <Layers size={14} />
+        {compact ? "" : "Indicators"}{" "}
+        <span>{rows.filter((r) => r.chart).length}</span>
+      </button>
+      {open && (
+        <div className="cr-chart-menu">
+          <div className="cr-card-heading">
+            <strong>Chart indicators</strong>
+            <button
+              className="cr-icon-button"
+              aria-label="Close indicator menu"
+              onClick={() => setOpen(false)}
+            >
+              <X size={14} />
+            </button>
+          </div>
+          <p className="cr-muted">
+            Hide or remove a drawing here. Expert execution has separate
+            controls.
+          </p>
+          {!rows.length && (
+            <div className="cr-empty">
+              Apply your first indicator from Studio.
+            </div>
+          )}
+          {rows.map((r) => (
+            <div className="cr-chart-menu-row" key={r.id}>
+              <div>
+                <strong>
+                  {r.version?.manifest?.name ||
+                    r.output?.card?.title ||
+                    "Indicator"}
+                </strong>
+                <small>
+                  {r.status} · {r.warmupInfo?.calculated ?? 0} historical frames
+                </small>
+              </div>
+              <button
+                disabled={!!busy}
+                className="cr-icon-button"
+                aria-label={`Settings for ${r.version?.manifest?.name}`}
+                title="Indicator inputs and limits"
+                onClick={() => settings(r)}
+              >
+                <Settings2 size={14} />
+              </button>
+              <button
+                disabled={!!busy}
+                className="cr-icon-button"
+                aria-label={`${r.chart ? "Hide" : "Show"} ${r.version?.manifest?.name}`}
+                title={r.chart ? "Hide from chart" : "Show on chart"}
+                onClick={() => act(r, { chart: !r.chart })}
+              >
+                {r.chart ? <Eye size={14} /> : <EyeOff size={14} />}
+              </button>
+              <button
+                disabled={!!busy}
+                className="cr-icon-button"
+                title="Reload historical calculations"
+                aria-label="Reload history"
+                onClick={() => act(r, null, true)}
+              >
+                <RotateCcw size={13} />
+              </button>
+              <button
+                disabled={!!busy || !r.chart}
+                className="cr-icon-button"
+                title="Remove from this chart"
+                aria-label={`Remove ${r.version?.manifest?.name} from chart`}
+                onClick={() => act(r, { chart: false })}
+              >
+                <X size={14} />
+              </button>
+            </div>
+          ))}
+          <ErrorBox error={error} />
+          <Link to="/studio" className="cr-button">
+            <ExternalLink size={13} />
+            Open Studio
+          </Link>
+        </div>
+      )}
+      {editing && form && (
+        <Modal
+          title={`${editing.version?.manifest?.name} · settings`}
+          onClose={() => setEditing(null)}
+        >
+          <div className="cr-form">
+            <div className="cr-parameter-grid">
+              {Object.entries(editing.version?.manifest?.parameters || {}).map(
+                ([key, p]) => (
+                  <label key={key}>
+                    {p.label}
+                    {p.type === "boolean" ? (
+                      <input
+                        type="checkbox"
+                        checked={!!form.params[key]}
+                        onChange={(e) =>
+                          setForm((v) => ({
+                            ...v,
+                            params: { ...v.params, [key]: e.target.checked },
+                          }))
+                        }
+                      />
+                    ) : (
+                      <input
+                        type="number"
+                        min={p.min}
+                        max={p.max}
+                        step={p.type === "integer" ? 1 : "any"}
+                        value={form.params[key] ?? p.default}
+                        onChange={(e) =>
+                          setForm((v) => ({
+                            ...v,
+                            params: {
+                              ...v.params,
+                              [key]: Number(e.target.value),
+                            },
+                          }))
+                        }
+                      />
+                    )}
+                  </label>
+                ),
+              )}
+            </div>
+            {editing.version?.manifest?.kind === "expert" && (
+              <>
+                <div className="cr-parameter-grid">
+                  {[
+                    [
+                      "budget",
+                      "Session budget",
+                      Number(editing.spent) || 1,
+                      100000,
+                    ],
+                    ["maxStake", "Maximum stake", 0.01, 10000],
+                    ["minIntervalSec", "Cooldown (seconds)", 5, 300],
+                  ].map(([key, label, min, max]) => (
+                    <label key={key}>
+                      {label}
+                      <input
+                        type="number"
+                        min={min}
+                        max={max}
+                        step={key === "minIntervalSec" ? 1 : 0.01}
+                        value={form[key]}
+                        onChange={(e) =>
+                          setForm((v) => ({
+                            ...v,
+                            [key]: Number(e.target.value),
+                          }))
+                        }
+                      />
+                    </label>
+                  ))}
+                  {[
+                    ["maxPerRound", "Maximum per round"],
+                    ["maxPerDay", "Maximum per day"],
+                    ["maxOrdersPerRound", "Orders per round"],
+                    ["lossStop", "Daily realized loss stop"],
+                  ].map(([key, label]) => (
+                    <label key={key}>
+                      {label}
+                      <input
+                        type="number"
+                        min="1"
+                        max={key === "maxOrdersPerRound" ? 100 : 100000}
+                        step={key === "maxOrdersPerRound" ? 1 : 0.01}
+                        placeholder="Not set"
+                        value={form.risk[key] ?? ""}
+                        onChange={(e) =>
+                          setForm((v) => ({
+                            ...v,
+                            risk: { ...v.risk, [key]: Number(e.target.value) },
+                          }))
+                        }
+                      />
+                    </label>
+                  ))}
+                </div>
+                <p className="cr-callout">
+                  Changing expert inputs pauses the run. Review the recalculated
+                  history, then resume from Experts. Existing orders and budget
+                  reservations stay recorded.
+                </p>
+              </>
+            )}
+            <p className="cr-muted">
+              Saving recalculates historical plots with these inputs. Script
+              code and the pinned version stay unchanged.
+            </p>
+            <ErrorBox error={error} />
+            <button
+              className="cr-button primary"
+              disabled={!!busy}
+              onClick={configure}
+            >
+              {busy ? "Recalculating…" : "Save & recalculate"}
+            </button>
+          </div>
+        </Modal>
+      )}
+    </div>
+  );
+}
