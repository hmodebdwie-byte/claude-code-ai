--- /dev/null
+++ b/src/creator/Authoring.jsx
@@ -0,0 +1,354 @@
+import { useState } from "react";
+import { Plus, X, Sparkles, Download, Code2 } from "lucide-react";
+import { creatorApi } from "./api";
+import { ErrorBox, downloadFile } from "./ui";
+export default function Authoring({ capabilities, source, onSource }) {
+  const [tab, setTab] = useState("visual"),
+    [name, setName] = useState("My capital pressure strategy"),
+    [kind, setKind] = useState("indicator"),
+    [match, setMatch] = useState("all"),
+    [conditions, setConditions] = useState([
+      { field: "imbalance", operator: ">", value: 0.25 },
+      { field: "trades", operator: ">=", value: 10 },
+    ]),
+    [side, setSide] = useState("BUY"),
+    [stake, setStake] = useState(5),
+    [confirmations, setConfirmations] = useState(2),
+    [scope, setScope] = useState("round"),
+    [prompt, setPrompt] = useState(""),
+    [useDraft, setUseDraft] = useState(false),
+    [busy, setBusy] = useState(false),
+    [error, setError] = useState(""),
+    [notice, setNotice] = useState("");
+  const fields = capabilities?.fields || [];
+  async function task(fn) {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      const r = await fn();
+      if (r?.source) {
+        onSource(r.source);
+        setNotice(
+          r.ok
+            ? "Validated draft opened in the editor. Save and apply when ready."
+            : "Draft opened with validation diagnostics. Review the editor before applying.",
+        );
+      }
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy(false);
+    }
+  }
+  const update = (i, key, value) =>
+    setConditions((list) =>
+      list.map((c, n) => (n === i ? { ...c, [key]: value } : c)),
+    );
+  const rule = {
+    name,
+    kind,
+    match,
+    conditions,
+    side,
+    stake: Number(stake),
+    confirmations: Number(confirmations),
+    stateScope: scope,
+  };
+  return (
+    <div className="cr-authoring">
+      <div className="cr-subnav">
+        <button
+          className={tab === "visual" ? "active" : ""}
+          onClick={() => setTab("visual")}
+        >
+          Visual rules
+        </button>
+        <button
+          className={tab === "ai" ? "active" : ""}
+          onClick={() => setTab("ai")}
+        >
+          AI authoring
+        </button>
+        <button
+          className={tab === "developer" ? "active" : ""}
+          onClick={() => setTab("developer")}
+        >
+          Developer kit
+        </button>
+      </div>
+      <ErrorBox error={error} />
+      {notice && <p className="cr-success">{notice}</p>}
+      {tab === "visual" && (
