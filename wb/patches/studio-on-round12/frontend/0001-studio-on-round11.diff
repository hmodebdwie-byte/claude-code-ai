diff --git a/src/creator/compatibilityMath.mjs b/src/creator/compatibilityMath.mjs
new file mode 100644
index 0000000..5089102
--- /dev/null
+++ b/src/creator/compatibilityMath.mjs
@@ -0,0 +1,40 @@
+export const REQUIRED_CREATOR_PROTOCOL = 5;
+export function versionMismatch() {
+  const error = new Error(
+    'Your app and indicator service are different versions. Refresh to load the latest app. If this continues, contact support.',
+  );
+  error.code = 'CREATOR_VERSION_MISMATCH';
+  return error;
+}
+
+/** One check per signed-in identity, including when several surfaces mount at once. */
+export function createCompatibilityCheck(request, getIdentity, now = Date.now) {
+  let cache;
+  return function ensure({ force = false } = {}) {
+    const identity = getIdentity();
+    if (cache?.identity === identity) {
+      if (cache.promise) return cache.promise;
+      if (!force && cache.until > now())
+        return cache.error ? Promise.reject(cache.error) : Promise.resolve(cache.value);
+    }
+    const entry = { identity, until: 0, promise: null };
+    cache = entry;
+    entry.promise = Promise.resolve().then(request).then((value) => {
+      if (value?.protocolVersion < REQUIRED_CREATOR_PROTOCOL ||
+          !Number.isInteger(value?.protocolVersion) ||
+          value.features?.intelligenceBank < 4 ||
+          value.features?.installationFeed < 2 ||
+          !value.features?.intelligenceBank || !value.features?.installationFeed)
+        throw versionMismatch();
+      entry.value = value;
+      entry.until = now() + 60000;
+      return value;
+    }).catch((cause) => {
+      const error = cause?.response?.status === 404 ? versionMismatch() : cause;
+      entry.error = error;
+      entry.until = now() + (error?.code === 'CREATOR_VERSION_MISMATCH' ? 60000 : 15000);
+      throw error;
+    }).finally(() => { entry.promise = null; });
+    return entry.promise;
+  };
+}
