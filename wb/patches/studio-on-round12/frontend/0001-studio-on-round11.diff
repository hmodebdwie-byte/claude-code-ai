+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+const source = (
+  await readFile(
+    new URL("../src/creator/chartHost.js", import.meta.url),
+    "utf8",
+  )
+).replace(
+  '"./seriesData"',
+  JSON.stringify(new URL("../src/creator/seriesData.js", import.meta.url).href),
+);
+const { createIndicatorChartHost } = await import(
+  `data:text/javascript;base64,${Buffer.from(source).toString("base64")}`
+);
+const fake = () => {
+  const makePane = (index) => ({
+    paneIndex: () => index,
+    getHeight: () => 150,
+    setHeight: () => {},
+    setStretchFactor: () => {},
+  });
+  const panes = [makePane(0)],
+    all = [],
+    markerCalls = [];
+  const chart = {
+    panes: () => panes,
+    subscribeCrosshairMove: () => {},
+    unsubscribeCrosshairMove: () => {},
+    removeSeries: () => {},
+    addSeries: (_kind, opts, index) => {
+      if (!panes[index]) panes[index] = makePane(index);
+      const entry = {
+        opts,
+        index,
+        data: [],
+        full: 0,
+        updates: [],
+        getPane: () => panes[index],
+        priceScale: () => ({ applyOptions: () => {} }),
+        applyOptions: () => {},
+        createPriceLine: () => {},
+        setData(d) {
+          this.data = d;
+          this.full++;
+        },
+        update(p) {
+          this.updates.push(p);
+        },
+      };
+      all.push(entry);
+      return entry;
+    },
+  };
+  const lwc = {
+    LineSeries: "line",
+    AreaSeries: "area",
+    HistogramSeries: "histogram",
+    createSeriesMarkers: () => ({
+      setMarkers: (v) => markerCalls.push(v),
+      detach: () => {},
+    }),
+  };
+  return { chart, lwc, all, markerCalls };
+};
+test("chart plots retain recorded histogram colors and incompatible units have separate panes", () => {
+  const f = fake(),
+    host = createIndicatorChartHost(f.chart, f.lwc, {}, {});
+  const row = {
+    id: "a",
+    chart: true,
+    cursor: { epoch: "one" },
+    output: {
+      plots: [
+        {
+          id: "flow",
+          placement: "pane",
+          pane: "study",
+          unit: "%",
+          style: "histogram",
+        },
+        { id: "response", placement: "pane", pane: "study", unit: "pips" },
+      ],
+    },
+    history: {
+      flow: [
+        { time: 1, value: 2, color: "#00cfff" },
+        { time: 2, value: -2, color: "#ff006e" },
+      ],
+      response: [{ time: 1, value: 0.00002 }],
+      $signals: [],
+    },
+  };
+  host.update([row]);
+  assert.notEqual(f.all[0].index, f.all[1].index);
+  assert.equal(f.all[0].data[0].color, "#00cfff");
+  assert.equal(f.all[0].data[1].color, "#ff006e");
+  host.update([{ ...row, error: "interrupted" }]);
+  assert.equal(f.all[0].full, 1);
+  assert.equal(f.all[0].updates.length, 0);
+  assert.equal(f.markerCalls.length, 1);
+});
+test("new chart observations append at their actual time without forward-filled prices", () => {
+  const f = fake(),
+    legends = [],
+    host = createIndicatorChartHost(
+      f.chart,
+      f.lwc,
+      {},
+      { onLegend: (v) => legends.push(v) },
