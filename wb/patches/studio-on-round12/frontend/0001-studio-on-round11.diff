+            <option value="">Select history</option>
+            {datasets
+              .filter((d) => d.mode === mode)
+              .map((d) => (
+                <option key={d.id} value={d.id}>
+                  {d.name}
+                </option>
+              ))}
+          </select>
+        </label>
+        <label>
+          Rolling window
+          <select
+            value={windowSeconds}
+            onChange={(e) => setWindow(Number(e.target.value))}
+          >
+            {[5, 15, 30, 60, 120, 300].map((n) => (
+              <option key={n} value={n}>
+                {n} seconds
+              </option>
+            ))}
+          </select>
