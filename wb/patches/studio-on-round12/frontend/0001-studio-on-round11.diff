diff --git a/src/creator/seriesData.js b/src/creator/seriesData.js
new file mode 100644
index 0000000..75b4da3
--- /dev/null
+++ b/src/creator/seriesData.js
@@ -0,0 +1,45 @@
+/** Incremental chart writes; full replacement only on rewind, epoch change or bounded compaction. */
+export function writeSeries(series, data, state = {}, epoch = "") {
+  const last = data.at(-1);
+  const reset =
+    state.epoch !== epoch ||
+    !state.last ||
+    !last ||
+    last.time < state.last.time ||
+    state.count > 3256 ||
+    data[0]?.time < state.first ||
+    !data.some((p) => p.time === state.last.time);
+  if (reset) {
+    series.setData(data);
+    state.count = data.length;
+    state.first = data[0]?.time;
+  } else {
+    for (let i = data.length - 1; i >= 0; i--) {
+      if (data[i].time < state.last.time) {
+        for (const p of data.slice(i + 1)) {
+          if (
+            p.time === state.last.time &&
+            JSON.stringify(p) === JSON.stringify(state.last)
+          )
+            continue;
+          series.update(p);
+          if (p.time > state.last.time) state.count++;
+        }
+        break;
+      }
+      if (i === 0)
+        for (const p of data) {
+          if (
+            p.time === state.last.time &&
+            JSON.stringify(p) === JSON.stringify(state.last)
+          )
+            continue;
+          series.update(p);
+          if (p.time > state.last.time) state.count++;
+        }
+    }
+  }
+  state.last = last;
+  state.epoch = epoch;
+  return state;
+}
diff --git a/src/creator/store.js b/src/creator/store.js
new file mode 100644
index 0000000..f50e440
--- /dev/null
+++ b/src/creator/store.js
@@ -0,0 +1,135 @@
+import { useEffect } from "react";
+import { create } from "zustand";
+import { authStore } from "../stores/authStore";
+import { creatorApi, CREATOR_CHANGED_EVENT, CREATOR_CHANGED_KEY } from "./api";
+import { ensureCreatorCompatibility } from "./compatibility";
+import { mergeCreatorFeed } from "./feedMath";
+import { createFeedCoordinator } from "./feedCoordinator.mjs";
+import { createIdentitySnapshot } from "./identitySnapshot.mjs";
+const EMPTY_INSTALLATIONS = Object.freeze([]);
+const EMPTY_STATE = Object.freeze({ installations: EMPTY_INSTALLATIONS, error: "", receivedAt: 0, feedState: "idle" });
+const cacheIdentity = () => {
+  const auth = authStore.getState(), stored = localStorage.getItem("token");
+  return !stored || auth.isGuest ? null : `${auth.token || ""}\n${stored}`;
+};
+const internalStore = create(() => ({ ...EMPTY_STATE, sessionIdentity: cacheIdentity() }));
+const safeSnapshot = createIdentitySnapshot(cacheIdentity, EMPTY_STATE);
+// A stable, identity-checked snapshot is used by both React selectors and chart
+// subscriptions. Clearing in an effect alone allows a previous account to flash.
+export const creatorStore = Object.assign(
+  (selector = (state) => state) => internalStore((state) => selector(safeSnapshot(state))),
+  internalStore,
+  {
+    getState: () => safeSnapshot(internalStore.getState()),
+    getInitialState: () => safeSnapshot(internalStore.getInitialState()),
+    subscribe: (listener) => {
+      let previous = safeSnapshot(internalStore.getState());
+      return internalStore.subscribe((state) => {
+        const next = safeSnapshot(state);
+        listener(next, previous);
+        previous = next;
+      });
+    },
+  },
+);
+let consumers = 0,
+  timer = null;
+const coordinator = createFeedCoordinator({
+  getIdentity: () =>
+    authStore.getState().isGuest ? null : localStorage.getItem("token"),
+  onReset: () =>
+    creatorStore.setState({ ...EMPTY_STATE, sessionIdentity: cacheIdentity() }),
+  request: async (signal) => {
+    await ensureCreatorCompatibility();
+    if (signal.aborted) throw new DOMException("Aborted", "AbortError");
+    const state = creatorStore.getState();
+    if (!state.receivedAt) creatorStore.setState({ feedState: "loading" });
+    const known = Object.fromEntries(
+      state.installations.filter((r) => r.cursor).map((r) => [r.id, r.cursor]),
+    );
+    return creatorApi.feed(known, signal);
+  },
+  onData: (feed) => {
+    if (!Array.isArray(feed?.rows) || !Array.isArray(feed?.ids)) {
+      creatorStore.setState({
+        error: "Indicator updates could not be read. Reconnecting…",
+        feedState: "reconnecting",
+      });
+      return;
+    }
+    const old = creatorStore.getState().installations;
+    const changed =
+      feed.rows.length || feed.ids.join() !== old.map((r) => r.id).join();
+    creatorStore.setState({
+      ...(changed ? { installations: mergeCreatorFeed(old, feed) } : {}),
+      error: "",
+      sessionIdentity: cacheIdentity(),
+      receivedAt: Date.now(),
+      feedState: "ready",
+    });
+  },
+  onError: (e) =>
+    creatorStore.setState({
+      error: e.message || "Indicator connection interrupted",
+      feedState: "reconnecting",
+    }),
+});
+// Invalidate even while Studio/trading surfaces are unmounted. No credentials
+// are stored outside the existing browser session and no new request is started.
+const clearSessionCache = () => {
+  coordinator.stop();
+  creatorStore.setState({ ...EMPTY_STATE, sessionIdentity: cacheIdentity() });
+};
+authStore.subscribe((next, previous) => {
+  if (next.token !== previous.token || next.isGuest !== previous.isGuest) clearSessionCache();
+});
+window.addEventListener("storage", (event) => {
+  if (event.key === "token" || event.key === "role" || event.key === null) clearSessionCache();
+});
+export const refreshCreator = () => coordinator.refresh();
+const poll = () => {
+  if (!document.hidden) void coordinator.refresh({ afterCurrent: false });
+};
+const changed = () => {
+  if (consumers) void refreshCreator();
+};
+const stored = (event) => {
+  if (
+    [CREATOR_CHANGED_KEY, "token", "role"].includes(event.key) ||
+    event.key === null
+  )
+    changed();
+};
+export function useCreatorFeed(enabled = true) {
+  const token = authStore((s) => s.token),
+    guest = authStore((s) => s.isGuest);
+  useEffect(() => {
+    if (!enabled) return;
+    if (guest || !localStorage.getItem("token")) {
+      void coordinator.refresh({ afterCurrent: false });
+      return;
+    }
+    consumers++;
+    poll();
+    if (!timer) {
+      timer = setInterval(poll, 1500);
+      document.addEventListener("visibilitychange", poll);
+      window.addEventListener("focus", poll);
+      window.addEventListener("online", changed);
+      window.addEventListener(CREATOR_CHANGED_EVENT, changed);
+      window.addEventListener("storage", stored);
+    }
+    return () => {
+      if (--consumers === 0) {
+        clearInterval(timer);
+        timer = null;
+        document.removeEventListener("visibilitychange", poll);
+        window.removeEventListener("focus", poll);
+        window.removeEventListener("online", changed);
+        window.removeEventListener(CREATOR_CHANGED_EVENT, changed);
+        window.removeEventListener("storage", stored);
+        coordinator.stop();
+      }
+    };
+  }, [token, guest, enabled]);
+}
diff --git a/src/creator/ui.jsx b/src/creator/ui.jsx
new file mode 100644
index 0000000..e895ecf
--- /dev/null
+++ b/src/creator/ui.jsx
@@ -0,0 +1,216 @@
+import { useEffect, useRef, useState } from "react";
+import { X, Download } from "lucide-react";
+export const formatNumber = (n, digits = 2) =>
+  n == null || !Number.isFinite(Number(n))
+    ? "—"
+    : Number(n).toLocaleString(undefined, { maximumFractionDigits: digits });
+export const dateTime = (v) => (v ? new Date(v).toLocaleString() : "—");
+export function downloadFile(name, value, type = "application/json") {
+  const url = URL.createObjectURL(
+    new Blob(
+      [typeof value === "string" ? value : JSON.stringify(value, null, 2)],
+      { type },
+    ),
+  );
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = name;
+  a.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+export function ErrorBox({ error }) {
+  return error ? (
+    <p className="cr-error" role="alert">
+      {error}
+    </p>
+  ) : null;
+}
+export function Empty({ title, children }) {
+  return (
+    <div className="cr-empty-state">
+      <span className="cr-empty-symbol">⌁</span>
+      <h3>{title}</h3>
+      <p>{children}</p>
+    </div>
+  );
+}
+export function Modal({ title, children, onClose, wide = false }) {
+  const dialog = useRef(null),
+    close = useRef(onClose);
+  close.current = onClose;
+  useEffect(() => {
+    const previous = document.activeElement;
+    const root = dialog.current;
+    const focusable = () =>
+      [
+        ...root.querySelectorAll(
+          'button:not(:disabled),input:not(:disabled),select:not(:disabled),textarea:not(:disabled),a[href],[tabindex="0"]',
+        ),
+      ].filter((el) => el.getClientRects().length);
+    (root.querySelector("[autofocus]") || focusable()[0] || root).focus();
+    const key = (e) => {
+      if (e.key === "Escape") {
+        e.stopPropagation();
+        close.current();
+      }
+      if (e.key === "Tab") {
+        const all = focusable(),
+          first = all[0],
+          last = all.at(-1);
+        if (!first) {
+          e.preventDefault();
+          root.focus();
+        } else if (
+          e.shiftKey &&
+          (document.activeElement === first || document.activeElement === root)
+        ) {
+          e.preventDefault();
+          last.focus();
+        } else if (!e.shiftKey && document.activeElement === last) {
+          e.preventDefault();
+          first.focus();
+        }
+      }
+    };
+    root.addEventListener("keydown", key);
+    return () => {
+      root.removeEventListener("keydown", key);
+      if (previous?.isConnected) previous.focus();
+    };
+  }, []);
+  return (
+    <div
+      className="cr-modal-shade"
+      onMouseDown={(e) => {
+        if (e.target === e.currentTarget) onClose();
+      }}
+    >
+      <section
+        ref={dialog}
+        tabIndex={-1}
+        className={`cr-modal ${wide ? "wide" : ""}`}
+        role="dialog"
+        aria-modal="true"
+        aria-label={title}
+      >
+        <header>
+          <h2>{title}</h2>
+          <button
+            className="cr-icon-button"
+            onClick={onClose}
+            aria-label="Close dialog"
+          >
+            <X size={17} />
+          </button>
+        </header>
+        {children}
+      </section>
+    </div>
+  );
+}
+export function Metric({ label, value, sub, tone = "" }) {
+  return (
+    <div className="cr-stat">
+      <span>{label}</span>
+      <strong className={tone ? `cr-tone-${tone}` : ""}>{value}</strong>
+      {sub && <small>{sub}</small>}
+    </div>
+  );
+}
+export function Spark({
+  values = [],
+  color = "#12d4e8",
+  height = 100,
+  label = "Historical series",
+}) {
+  const [hover, setHover] = useState(null);
+  const valid = values
+    .filter((v) => v != null)
+    .map(Number)
+    .filter(Number.isFinite);
+  if (valid.length < 2)
+    return <div className="cr-spark-empty">More observations needed</div>;
+  const min = Math.min(...valid),
+    max = Math.max(...valid);
+  let gap = true;
+  const d = values
+    .map((v, i) => {
+      if (v === null || !Number.isFinite(Number(v))) {
+        gap = true;
+        return "";
+      }
+      const part = `${gap ? "M" : "L"}${(i / (values.length - 1)) * 600},${90 - ((Number(v) - min) / (max - min || 1)) * 75}`;
+      gap = false;
+      return part;
+    })
+    .join(" ");
+  return (
+    <div className="cr-spark-wrap" style={{ height }}>
+      <svg
+        viewBox="0 0 600 100"
+        preserveAspectRatio="none"
+        role="img"
+        aria-label={label}
+        onMouseMove={(e) => {
+          const box = e.currentTarget.getBoundingClientRect();
+          setHover(
+            Math.min(
+              values.length - 1,
+              Math.max(
+                0,
+                Math.round(
+                  ((e.clientX - box.left) / box.width) * (values.length - 1),
+                ),
+              ),
+            ),
+          );
+        }}
+        onMouseLeave={() => setHover(null)}
+      >
+        {[20, 55, 90].map((y) => (
+          <line
+            key={y}
+            x1="0"
+            x2="600"
+            y1={y}
+            y2={y}
+            stroke="currentColor"
+            strokeOpacity=".09"
+          />
+        ))}
+        <path
+          d={d}
+          fill="none"
+          stroke={color}
+          strokeWidth="2"
+          vectorEffect="non-scaling-stroke"
+        />
+        {hover !== null && (
+          <line
+            x1={(hover / (values.length - 1)) * 600}
+            x2={(hover / (values.length - 1)) * 600}
+            y1="0"
+            y2="100"
+            stroke={color}
+            strokeDasharray="3 4"
+          />
+        )}
+      </svg>
+      <div className="cr-spark-axis">
+        <span>{formatNumber(min, 5)}</span>
+        <span>
+          {hover === null ? "Observed range" : formatNumber(values[hover], 5)}
+        </span>
+        <span>{formatNumber(max, 5)}</span>
+      </div>
+    </div>
+  );
+}
+export function ExportButton({ name, value }) {
+  return (
+    <button className="cr-button" onClick={() => downloadFile(name, value)}>
+      <Download size={13} />
+      Export
+    </button>
+  );
+}
