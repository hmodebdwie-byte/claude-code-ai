@@ -0,0 +1,37 @@
+export const BUILT_IN_CARD_PAGES = Object.freeze([
+  { id: 'chat', label: 'Chat', group: 0 },
+  { id: 'market', label: 'Market overview', group: 1 },
+  { id: 'flow', label: 'Order flow', group: 2 },
+  { id: 'round', label: 'Round insights', group: 3 },
+]);
+
+// Only page metadata is observed by Matches. Price/history updates must not
+// rerender the entire trading screen just to keep this navigation current.
+export function creatorCardPageSignature(installations) {
+  return JSON.stringify(installations
+    .filter((row) => row.card && !row.version?.script?.disabled)
+    // New installations append to the carousel even though the API returns
+    // newest first. Ties use the persisted ID, never incidental feed ordering.
+    .sort((a, b) => (Date.parse(a.createdAt) || 0) - (Date.parse(b.createdAt) || 0)
+      || (String(a.id) < String(b.id) ? -1 : String(a.id) > String(b.id) ? 1 : 0))
+    .map((row) => [String(row.id), row.version?.manifest?.name || row.output?.card?.title || 'Indicator']));
+}
+
+export function arenaCardPages(signature) {
+  return [...BUILT_IN_CARD_PAGES, ...JSON.parse(signature).map(([installationId, label]) => ({
+    id: `creator:${installationId}`, installationId, label,
+  }))];
+}
+
+export function reconcileCardPage(selectedId, pages, previousPages = pages) {
+  if (pages.some((page) => page.id === selectedId)) return selectedId;
+  // Removing a page moves to its successor; removing the last page moves back.
+  // Reordering and inserting pages never change a still-present selection.
+  const previousIndex = previousPages.findIndex((page) => page.id === selectedId);
+  return pages[Math.max(0, Math.min(previousIndex, pages.length - 1))]?.id || 'chat';
+}
+
+export function adjacentCardPage(selectedId, pages, direction) {
+  const index = pages.findIndex((page) => page.id === selectedId);
+  return pages[Math.max(0, Math.min(pages.length - 1, Math.max(0, index) + direction))]?.id || 'chat';
+}
