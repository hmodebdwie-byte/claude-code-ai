+                  onChange={(e) => field("sourceVisibility", e.target.value)}
+                >
+                  <option value="protected">
+                    Protected · server execution
+                  </option>
+                  <option value="open">Open · source visible</option>
+                </select>
+              </label>
+            </div>
+            <label>
+              Tags (comma separated)
+              <input
+                value={form.tags}
+                maxLength="240"
+                onChange={(e) => field("tags", e.target.value)}
+              />
+            </label>
+            <div className="cr-two-fields">
+              <label>
+                License
+                <select
+                  value={form.license}
+                  onChange={(e) => field("license", e.target.value)}
+                >
+                  <option value="free">Free</option>
+                  <option value="purchase">One-time purchase</option>
+                  <option value="rental">Rental</option>
+                  <option value="subscription">Monthly subscription</option>
+                </select>
+              </label>
+              {form.license !== "free" && (
+                <label>
+                  Price (USD)
+                  <input
+                    type="number"
+                    required
+                    min="0.50"
+                    max="10000"
+                    step="0.01"
+                    value={form.price}
+                    onChange={(e) => field("price", e.target.value)}
+                  />
+                </label>
+              )}
+              {form.license === "rental" && (
+                <label>
+                  Rental days
+                  <input
+                    type="number"
+                    min="1"
+                    max="365"
+                    value={form.rentalDays}
+                    onChange={(e) => field("rentalDays", e.target.value)}
+                  />
+                </label>
+              )}
+            </div>
+            <p className="cr-muted">
+              Free releases can publish after review. Paid releases also require
+              a connected seller account and configured payment provider.
+            </p>
+            <ErrorBox error={error} />
+            <button className="cr-button primary" disabled={busy} type="submit">
+              Submit for review
+            </button>
+          </form>
+        </Modal>
+      )}
+    </section>
+  );
+}
diff --git a/src/creator/PreviewChart.jsx b/src/creator/PreviewChart.jsx
new file mode 100644
index 0000000..94d9049
--- /dev/null
+++ b/src/creator/PreviewChart.jsx
@@ -0,0 +1,258 @@
+import { writeSeries } from "./seriesData";
+import { useEffect, useRef, useState } from "react";
+import { Maximize2, Radio, X } from "lucide-react";
+import { loadLightweightCharts } from "../utils/loadLightweightCharts";
+import { createIndicatorChartHost } from "./chartHost";
+import { creatorApi } from "./api";
+import { refreshCreator } from "./store";
+import { formatValue } from "./IndicatorCard";
+
+export default function PreviewChart({
+  frame,
+  rows = [],
+  candles = [],
+  prices,
+  mode = "arena",
+  chartType = "line",
+  height = 500,
+  paneHeight = 140,
+  readOnly = false,
+  datasetId = "arena-live",
+  resolution = 1,
+}) {
+  const element = useRef(null),
+    runtime = useRef(null),
+    latest = useRef(null),
+    fit = useRef(false);
+  const [paneCount, setPaneCount] = useState(0);
+  const [legends, setLegends] = useState([]),
+    [follow, setFollow] = useState(true),
+    [error, setError] = useState("");
+  latest.current = { frame, rows, candles, prices, follow };
+  function update() {
+    const r = runtime.current;
+    if (!r) return;
+    const v = latest.current;
+    let data;
+    if (chartType === "candles")
+      data = (v.candles || []).map((c) => ({
+        time: Number(c.time),
+        open: Number(c.open),
+        high: Number(c.high),
+        low: Number(c.low),
+        close: Number(c.close),
+      }));
+    else
+      data = (
+        v.prices ||
+        (v.candles?.length
+          ? v.candles.map((c) => ({
+              time: Number(c.time),
+              value: Number(c.close),
+            }))
+          : v.frame?.prices) ||
+        []
+      ).map((p) => ({ time: Number(p.time), value: Number(p.value) }));
+    if (v.frame?.fresh && datasetId === "arena-live" && chartType === "line")
+      data.push({
+        time: Math.floor(v.frame.time / 1000 / resolution) * resolution,
+        value: v.frame.data.market.price,
+      });
+    data = [
+      ...new Map(
+        data
+          .filter(
+            (p) =>
+              Number.isFinite(p.time) && Number.isFinite(p.value ?? p.close),
+          )
+          .map((p) => [p.time, p]),
+      ).values(),
+    ].sort((a, b) => a.time - b.time);
+    r.writes = writeSeries(
+      r.price,
+      data,
+      r.writes,
+      `${datasetId}:${chartType}:${resolution}`,
+    );
+    r.host.update(v.rows);
+    if (data.length && !fit.current) {
+      r.chart.timeScale().fitContent();
+      fit.current = true;
+    } else if (v.follow && v.frame?.fresh)
+      r.chart.timeScale().scrollToRealTime();
+  }
+  useEffect(() => {
+    let disposed = false;
+    fit.current = false;
+    setLegends([]);
+    setError("");
+    loadLightweightCharts()
+      .then((LWC) => {
+        if (disposed) return;
+        const light = mode === "binary";
+        const chart = LWC.createChart(element.current, {
+          autoSize: true,
+          layout: {
+            background: { color: light ? "#ffffff" : "#080a0e" },
+            textColor: light ? "#526070" : "#7e8b9e",
+            fontSize: 11,
+            panes: {
+              separatorColor: light ? "#dce1e8" : "#262c37",
+              separatorHoverColor: "#12d4e8",
+              enableResize: true,
+            },
+          },
+          grid: {
+            vertLines: { color: light ? "#f0f2f6" : "#11151c" },
+            horzLines: { color: light ? "#f0f2f6" : "#11151c" },
+          },
+          rightPriceScale: {
+            borderColor: light ? "#e0e5ed" : "#222934",
+            minimumWidth: 65,
+          },
+          timeScale: {
+            timeVisible: true,
+            secondsVisible: true,
+            borderColor: light ? "#e0e5ed" : "#222934",
+            rightOffset: 8,
+            shiftVisibleRangeOnNewBar: false,
+          },
+          crosshair: { mode: 0 },
+        });
+        const price = chart.addSeries(
+          chartType === "candles" ? LWC.CandlestickSeries : LWC.LineSeries,
+          {
+            color: light ? "#2962ff" : "#dbe7f2",
+            lineWidth: 2,
+            upColor: "#00b98a",
+            downColor: "#f04472",
+            wickUpColor: "#00b98a",
+            wickDownColor: "#f04472",
+            borderVisible: false,
+            priceLineVisible: true,
+            lastValueVisible: true,
+            priceFormat: { type: "price", precision: 5, minMove: 0.00001 },
+          },
+        );
+        runtime.current = {
+          chart,
+          price,
+          host: createIndicatorChartHost(chart, LWC, price, {
+            paneHeight,
+            priceHeight: height - 30,
+            onLayout: setPaneCount,
+            resolution,
+            onLegend: setLegends,
+          }),
+        };
+        update();
+      })
+      .catch((e) => setError(e.message));
+    return () => {
+      disposed = true;
+      runtime.current?.host.dispose();
+      runtime.current?.chart.remove();
+      runtime.current = null;
+    };
+  }, [mode, chartType, datasetId, resolution]);
+  useEffect(() => {
+    if (!element.current) return;
+    const observer = new ResizeObserver(() =>
+      requestAnimationFrame(() => runtime.current?.host.refreshLegends()),
+    );
+    observer.observe(element.current);
+    return () => observer.disconnect();
+  }, []);
+  useEffect(update, [frame, rows, candles, prices, follow]);
+  useEffect(() => {
+    runtime.current?.host.resizePanes(paneHeight);
+  }, [paneHeight]);
+  async function remove(id) {
+    try {
+      await creatorApi.update(id, { chart: false });
+      await refreshCreator();
+    } catch (e) {
+      setError(e.message);
+    }
+  }
+  return (
+    <div
+      className="cr-chart-shell"
+      style={{ height: height + paneCount * (paneHeight + 1) }}
+    >
+      <div
+        className="cr-preview-chart"
+        ref={element}
+        onWheel={() => setFollow(false)}
+        onPointerDown={() => setFollow(false)}
+        onPointerUp={() => runtime.current?.host.refreshLegends()}
+        aria-label={`${mode} historical indicator chart`}
+      />
+      <div className="cr-chart-legends">
+        {legends.map((group) => (
+          <div
+            className={`cr-pane-legend ${group.index === 0 ? "overlay" : ""}`}
+            key={group.index}
+            style={{ top: group.top + 6 }}
+          >
+            {group.items.map((p) => (
+              <span key={`${p.installationId}:${p.id}`}>
+                <i style={{ background: p.color }} />
+                <span>{p.label}</span>
+                <b style={{ color: p.color }}>{formatValue(p.value, p.precision ?? 2)}</b>
+                {!readOnly && (
+                  <button
+                    title="Remove this indicator from chart"
+                    aria-label={`Remove ${p.label} from chart`}
+                    onClick={() => remove(p.installationId)}
+                  >
+                    <X size={11} />
+                  </button>
+                )}
+              </span>
+            ))}
+          </div>
+        ))}
+      </div>
+      <div className="cr-chart-navigation">
+        <button
+          className={`cr-icon-button ${follow ? "active" : ""}`}
+          title="Follow live price"
+          aria-label="Follow live price"
+          onClick={() => {
+            setFollow(true);
+            runtime.current?.chart.timeScale().scrollToRealTime();
+          }}
+        >
+          <Radio size={14} />
+        </button>
+        <button
+          className="cr-icon-button"
+          title="Fit all history"
+          aria-label="Fit chart history"
+          onClick={() => {
+            setFollow(false);
+            runtime.current?.chart.timeScale().fitContent();
+          }}
+        >
+          <Maximize2 size={14} />
+        </button>
+      </div>
+      {!candles.length && !prices?.length && !frame?.prices?.length && (
+        <div className="cr-chart-empty">
+          <strong>
+            {mode === "binary"
+              ? "Binary research workspace"
+              : "Waiting for recorded history"}
+          </strong>
+          <span>
+            {mode === "binary"
+              ? "White chart workspace · live Binary trading is not enabled. Select an imported Binary dataset to explore history."
+              : "History appears as the archive captures existing price records."}
+          </span>
+        </div>
+      )}
+      {error && <div className="cr-chart-error">{error}</div>}
+    </div>
+  );
+}
diff --git a/src/creator/ResearchLab.jsx b/src/creator/ResearchLab.jsx
new file mode 100644
index 0000000..a8d99e8
--- /dev/null
+++ b/src/creator/ResearchLab.jsx
@@ -0,0 +1,615 @@
+import { useEffect, useState } from "react";
+import { Play, Pause, FlaskConical, Square, RefreshCw } from "lucide-react";
+import { creatorApi } from "./api";
+import PreviewChart from "./PreviewChart";
+import {
+  Metric,
+  ErrorBox,
+  Empty,
+  ExportButton,
+  dateTime,
+  formatNumber,
+  Spark,
+} from "./ui";
+const inputDate = (d) =>
+  new Date(+new Date(d) - new Date(d).getTimezoneOffset() * 60000)
+    .toISOString()
+    .slice(0, 16);
+export default function ResearchLab({
+  mode,
+  datasets,
+  datasetId,
+  onDataset,
+  library,
+  versionId,
+}) {
+  const [jobs, setJobs] = useState([]),
+    [selected, setSelected] = useState(null),
+    [result, setResult] = useState(null),
+    [kind, setKind] = useState("replay"),
+    [version, setVersion] = useState(versionId || ""),
+    [from, setFrom] = useState(inputDate(Date.now() - 3600000)),
+    [to, setTo] = useState(inputDate(Date.now())),
+    [interval, setIntervalValue] = useState(5),
+    [horizon, setHorizon] = useState(30),
+    [configs, setConfigs] = useState("[{}]"),
+    [error, setError] = useState(""),
+    [busy, setBusy] = useState(false),
+    [cursor, setCursor] = useState(0),
+    [playing, setPlaying] = useState(false),
+    [speed, setSpeed] = useState(5),
+    [runIndex, setRunIndex] = useState(0),
+    [shadow, setShadow] = useState(null);
+  const dataset = datasets.find((d) => d.id === datasetId);
+  useEffect(() => {
+    if (versionId) setVersion(versionId);
+  }, [versionId]);
+  useEffect(() => {
+    if (dataset?.coverage?.to) {
+      setTo(inputDate(dataset.coverage.to));
+      setFrom(
+        inputDate(
+          Math.max(
+            +new Date(dataset.coverage.from),
+            +new Date(dataset.coverage.to) - 3600000,
+          ),
+        ),
+      );
+    }
+  }, [datasetId]);
+  async function load() {
+    try {
+      setJobs(await creatorApi.research());
+      if (selected) {
+        const j = await creatorApi.job(selected);
+        setResult(j);
+      }
+    } catch (e) {
+      setError(e.message);
+    }
+  }
+  useEffect(() => {
+    void load();
+    const timer = setInterval(load, 2500);
+    return () => clearInterval(timer);
+  }, [selected]);
+  useEffect(() => {
+    setCursor(result?.result?.prices?.length || 0);
+    setPlaying(false);
+    setRunIndex(0);
+    setShadow(null);
+  }, [result?.id, result?.status]);
+  const prices = result?.result?.prices || [],
+    run = result?.result?.runs?.[runIndex],
+    cutoff = prices[Math.max(0, cursor - 1)]?.time || 0;
+  useEffect(() => {
+    if (!playing) return;
+    const timer = setInterval(
+      () =>
+        setCursor((n) => {
+          const next = Math.min(prices.length, n + speed);
+          if (next === prices.length) setPlaying(false);
+          return next;
+        }),
+      150,
+    );
+    return () => clearInterval(timer);
+  }, [playing, prices.length, speed]);
+  async function create() {
+    setBusy(true);
+    setError("");
+    try {
+      let configurations = JSON.parse(configs);
+      if (!Array.isArray(configurations))
+        throw Error("Parameter variants must be an array");
+      const j = await creatorApi.createResearch({
+        kind,
+        datasetId,
+        versionId: kind === "calibrate" ? undefined : version,
+        from: new Date(from).toISOString(),
+        to: new Date(to).toISOString(),
+        interval: mode === "arena" ? 1 : Number(interval),
+        horizonSeconds: Number(horizon),
+        params: configurations[0] || {},
+        configurations,
+        name: "Tipping pressure / time holdout",
+      });
+      setSelected(j.id);
+      setResult(j);
+      setJobs(await creatorApi.research());
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy(false);
+    }
+  }
+  const history = Object.fromEntries(
+    Object.entries(run?.history || {}).map(([key, points]) => [
+      key,
+      Array.isArray(points) ? points.filter((p) => p.time <= cutoff) : points,
+    ]),
+  );
+  const replayRows = run
+    ? [
+        {
+          id: "research-preview",
+          chart: true,
+          enabled: true,
+          output: run.output,
+          history,
+        },
+      ]
+    : [];
+  return (
+    <section className="cr-section-page">
+      <div className="cr-page-heading">
+        <div>
+          <span className="cr-eyebrow">REPLAY / COMPARE / CALIBRATE</span>
+          <h1>A laboratory for every idea.</h1>
+          <p>
+            Run the same script against a fixed archive, inspect its evidence
+            and replay its decisions.
+          </p>
+        </div>
+        <button className="cr-button" onClick={load}>
+          <RefreshCw size={14} />
+          Refresh jobs
+        </button>
+      </div>
+      <ErrorBox error={error} />
+      <div className="cr-research-grid">
+        <aside className="cr-panel cr-research-setup">
+          <h3>
+            <FlaskConical size={17} />
+            New experiment
+          </h3>
+          <label>
+            Study type
+            <select value={kind} onChange={(e) => setKind(e.target.value)}>
+              <option value="replay">Historical replay</option>
+              <option value="compare">Parameter comparison</option>
+              <option value="calibrate">Tipping pressure calibration</option>
+            </select>
+          </label>
+          <label>
+            Dataset
+            <select
+              value={datasetId || ""}
+              onChange={(e) => onDataset(e.target.value)}
+            >
+              <option value="">Select history</option>
+              {datasets
+                .filter((d) => d.mode === mode)
+                .map((d) => (
+                  <option key={d.id} value={d.id}>
+                    {d.name}
+                  </option>
+                ))}
+            </select>
+          </label>
+          {kind !== "calibrate" && (
+            <label>
+              Saved version
+              <select
+                value={version}
+                onChange={(e) => setVersion(e.target.value)}
+              >
+                <option value="">Choose an immutable version</option>
+                {library.flatMap((s) =>
+                  s.versions.map((v) => (
+                    <option key={v.id} value={v.id}>
+                      {s.name} · v{v.revision}
+                    </option>
+                  )),
+                )}
+              </select>
+            </label>
+          )}
+          <label>
+            From
+            <input
+              type="datetime-local"
+              value={from}
+              onChange={(e) => setFrom(e.target.value)}
+            />
+          </label>
+          <label>
+            To
+            <input
+              type="datetime-local"
+              value={to}
+              onChange={(e) => setTo(e.target.value)}
+            />
+          </label>
+          <div className="cr-two-fields">
+            {mode === "binary" && (
+              <label>
+                Sample interval
+                <select
+                  value={interval}
+                  onChange={(e) => setIntervalValue(e.target.value)}
+                >
+                  {[1, 5, 15, 30, 60, 300].map((v) => (
+                    <option key={v} value={v}>
+                      {v}s
+                    </option>
+                  ))}
+                </select>
+              </label>
+            )}
+            <label>
+              Markout horizon
+              <input
+                type="number"
+                min="1"
+                max="300"
+                value={horizon}
+                onChange={(e) => setHorizon(e.target.value)}
+              />
+            </label>
+          </div>
+          {kind !== "calibrate" && (
+            <label>
+              {kind === "compare"
+                ? "Parameter variants (up to 8)"
+                : "Parameters (one object in an array)"}
+              <textarea
+                className="cr-json-editor"
+                value={configs}
+                onChange={(e) => setConfigs(e.target.value)}
+                rows="4"
+                spellCheck="false"
+              />
+              <small>
+                Example: [&#123;"windowSeconds":15&#125;,
+                &#123;"windowSeconds":60&#125;]
+              </small>
+            </label>
+          )}
+          <button
+            className="cr-button primary"
+            disabled={busy || !datasetId || (kind !== "calibrate" && !version)}
+            onClick={create}
+          >
+            <Play size={14} />
+            {busy ? "Queuing…" : "Run experiment"}
+          </button>
+          <p className="cr-muted">
+            Historical replay never places live trades. Missing data is reported
+            in the results.
+          </p>
+          <h3>Recent experiments</h3>
+          <div className="cr-job-list">
+            {jobs.map((j) => (
+              <button
+                className={j.id === selected ? "selected" : ""}
+                key={j.id}
+                onClick={() => setSelected(j.id)}
+              >
+                <strong>
+                  {j.kind} <span>{j.status}</span>
+                </strong>
+                <small>{dateTime(j.createdAt)}</small>
+                {j.status === "running" && (
+                  <progress value={j.progress} max="100" />
+                )}
+              </button>
+            ))}
+          </div>
+        </aside>
+        <div className="cr-research-results">
+          {!result ? (
+            <Empty title="Select or create an experiment">
+              Replays pin the script version and the archive boundary so
+              subsequent market records cannot change the selected inputs.
+            </Empty>
+          ) : (
+            <>
+              <div className="cr-panel">
+                <div className="cr-card-heading">
+                  <h2>
+                    {result.kind === "calibrate"
+                      ? "Tipping pressure calibration"
+                      : "Historical experiment"}
+                  </h2>
+                  <span
+                    className={`cr-status ${result.status === "complete" ? "good" : "warn"}`}
+                  >
+                    {result.status} · {result.progress}%
+                  </span>
+                </div>
+                <p className="cr-muted">
+                  {dateTime(result.spec.from)} → {dateTime(result.spec.to)} ·{" "}
+                  {result.spec.interval}s observations
+                </p>
+                {["running", "queued"].includes(result.status) && (
+                  <>
+                    <progress max="100" value={result.progress} />
+                    <button
+                      className="cr-button"
+                      onClick={async () => {
+                        await creatorApi.post(
+                          `research/${result.id}/cancel`,
+                          {},
+                        );
+                        await load();
+                      }}
+                    >
+                      <Square size={12} />
+                      Cancel experiment
+                    </button>
+                  </>
+                )}
+                <ErrorBox error={result.error} />
+              </div>
+              {result.status === "complete" && result.kind !== "calibrate" && (
+                <>
+                  <div className="cr-stat-grid">
+                    <Metric
+                      label="REPLAYED FRAMES"
+                      value={formatNumber(result.result.frames, 0)}
+                    />
+                    <Metric
+                      label="SIGNALS / MATURED"
+                      value={`${run?.metrics?.signals || 0} / ${run?.metrics?.matured || 0}`}
+                    />
+                    <Metric
+                      label="POSITIVE MARKOUT"
+                      value={
+                        run?.metrics?.positiveMarkoutRate == null
+                          ? "—"
+                          : `${formatNumber(run.metrics.positiveMarkoutRate * 100)}%`
+                      }
+                    />
+                    <Metric
+                      label="MISSING FEATURE FRAMES"
+                      value={formatNumber(run?.missingFrames || 0, 0)}
+                    />
+                  </div>
+                  {result.result.runs.length > 1 && (
+                    <div className="cr-panel cr-table-wrap">
+                      <table>
+                        <thead>
+                          <tr>
+                            <th>Variant</th>
+                            <th>Parameters</th>
+                            <th>Matured</th>
+                            <th>Positive markouts</th>
+                            <th>Mean directional pips</th>
+                          </tr>
+                        </thead>
+                        <tbody>
+                          {result.result.runs.map((r, i) => (
+                            <tr
+                              key={i}
+                              className={i === runIndex ? "selected" : ""}
+                              onClick={() => setRunIndex(i)}
+                            >
+                              <td>
+                                <button
+                                  className="cr-button"
+                                  onClick={() => setRunIndex(i)}
+                                >
+                                  View {i + 1}
+                                </button>
+                              </td>
+                              <td>
+                                <code>{JSON.stringify(r.params)}</code>
+                              </td>
+                              <td>{r.metrics.matured}</td>
+                              <td>
+                                {r.metrics.positiveMarkoutRate == null
+                                  ? "—"
+                                  : `${formatNumber(r.metrics.positiveMarkoutRate * 100)}%`}
+                              </td>
+                              <td>
+                                {formatNumber(r.metrics.meanDirectionalPips)}
+                              </td>
+                            </tr>
+                          ))}
+                        </tbody>
+                      </table>
+                    </div>
+                  )}
+                  <div className="cr-panel cr-replay-chart">
+                    <div className="cr-replay-controls">
+                      <button
+                        className="cr-icon-button"
+                        aria-label={playing ? "Pause replay" : "Play replay"}
+                        onClick={() => {
+                          if (cursor >= prices.length) setCursor(1);
+                          setPlaying(!playing);
+                        }}
+                      >
+                        {playing ? <Pause size={15} /> : <Play size={15} />}
+                      </button>
+                      <input
+                        aria-label="Replay position"
+                        type="range"
+                        min="1"
+                        max={prices.length || 1}
+                        value={cursor || 1}
+                        onChange={(e) => {
+                          setPlaying(false);
+                          setCursor(Number(e.target.value));
+                        }}
+                      />
+                      <select
+                        aria-label="Replay speed"
+                        value={speed}
+                        onChange={(e) => setSpeed(Number(e.target.value))}
+                      >
+                        {[1, 5, 20, 100].map((v) => (
+                          <option key={v} value={v}>
+                            {v}×
+                          </option>
+                        ))}
+                      </select>
+                      <span>
+                        {cursor}/{prices.length}
+                      </span>
+                    </div>
+                    <PreviewChart
+                      readOnly
+                      mode={mode}
+                      rows={replayRows}
+                      prices={prices.slice(0, cursor)}
+                      height={460}
+                      datasetId={`research-${result.id}`}
+                      resolution={result.spec.interval}
+                    />
+                  </div>
+                  <div className="cr-panel">
+                    <div className="cr-card-heading">
+                      <h3>Signal evidence</h3>
+                      <ExportButton
+                        name={`ticktrade-research-${result.id}.json`}
+                        value={result}
+                      />
+                    </div>
+                    <p className="cr-muted">{run?.metrics?.note}</p>
+                    {!!run?.missingFeatures?.length && (
+                      <p className="cr-error">
+                        Unavailable: {run.missingFeatures.join(", ")}
+                      </p>
+                    )}
+                    <div className="cr-table-wrap">
+                      <table>
+                        <thead>
+                          <tr>
+                            <th>Observed at</th>
+                            <th>Round</th>
+                            <th>Side</th>
+                            <th>Reference quote</th>
+                            <th>Markout (pips)</th>
+                            <th>Reason</th>
+                          </tr>
+                        </thead>
+                        <tbody>
+                          {(run?.signals || [])
+                            .filter((s) => s.time / 1000 <= cutoff)
+                            .slice(-100)
+                            .reverse()
+                            .map((s, i) => (
+                              <tr key={i}>
+                                <td>{dateTime(s.time)}</td>
+                                <td>{s.roundId}</td>
+                                <td
+                                  className={`cr-tone-${s.side === "BUY" ? "buy" : "sell"}`}
+                                >
+                                  {s.side}
+                                </td>
+                                <td>{formatNumber(s.entry, 5)}</td>
+                                <td>{formatNumber(s.directionalPips)}</td>
+                                <td>{s.reason}</td>
+                              </tr>
+                            ))}
+                        </tbody>
+                      </table>
+                    </div>
+                  </div>
+                </>
+              )}
+              {result.status === "complete" && result.kind === "calibrate" && (
+                <>
+                  <div className="cr-stat-grid">
+                    <Metric
+                      label="TRAINING LABELS"
+                      value={formatNumber(
+                        result.result.metrics.trainingSamples,
+                        0,
+                      )}
+                    />
+                    <Metric
+                      label="HELD-OUT LABELS"
+                      value={formatNumber(
+                        result.result.metrics.holdoutSamples,
+                        0,
+                      )}
+                    />
+                    <Metric
+                      label="BRIER SCORE"
+                      value={formatNumber(result.result.metrics.brier, 4)}
+                      sub={`Baseline ${formatNumber(result.result.metrics.baselineBrier, 4)}`}
+                    />
+                    <Metric
+                      label="HELD-OUT ROUNDS"
+                      value={result.result.metrics.holdoutRounds}
+                    />
+                  </div>
+                  <div className="cr-panel">
+                    <h3>Observed calibration</h3>
+                    <p>{result.result.metrics.target}</p>
+                    <Spark
+                      color="#ab7aff"
+                      values={result.result.metrics.calibration.map(
+                        (c) => c.observed,
+                      )}
+                      label="Holdout calibration"
+                    />
+                    <table>
+                      <thead>
+                        <tr>
+                          <th>Forecast bin</th>
+                          <th>Samples</th>
+                          <th>Mean prediction</th>
+                          <th>Observed up rate</th>
+                        </tr>
+                      </thead>
+                      <tbody>
+                        {result.result.metrics.calibration
+                          .filter((c) => c.n)
+                          .map((c) => (
+                            <tr key={c.from}>
+                              <td>
+                                {c.from.toFixed(1)}–{c.to.toFixed(1)}
+                              </td>
+                              <td>{c.n}</td>
+                              <td>{formatNumber(c.predicted, 3)}</td>
+                              <td>{formatNumber(c.observed, 3)}</td>
+                            </tr>
+                          ))}
+                      </tbody>
+                    </table>
+                    <p className="cr-muted">
+                      {result.result.metrics.limitations.join(" ")}
+                    </p>
+                    <div className="cr-row-actions">
+                      <ExportButton
+                        name="ticktrade-pressure-model.json"
+                        value={result.result}
+                      />
+                      <button
+                        className="cr-button"
+                        onClick={async () => {
+                          try {
+                            setShadow(
+                              await creatorApi.get(
+                                `models/${result.result.modelId}/shadow`,
+                              ),
+                            );
+                          } catch (e) {
+                            setError(e.message);
+                          }
+                        }}
+                      >
+                        Inspect latest shadow estimate
+                      </button>
+                    </div>
+                    {shadow && (
+                      <p className="cr-callout">
+                        {shadow.available
+                          ? `${formatNumber(shadow.probability * 100)}% upward estimate · ${shadow.trainingBinSamples} training observations in this pressure bin · ${dateTime(shadow.time)}. ${shadow.warning}`
+                          : "No current observations for this model."}
+                      </p>
+                    )}
+                  </div>
+                </>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+    </section>
+  );
+}
diff --git a/src/creator/TradingChartLegends.jsx b/src/creator/TradingChartLegends.jsx
new file mode 100644
index 0000000..2963a84
--- /dev/null
+++ b/src/creator/TradingChartLegends.jsx
@@ -0,0 +1,72 @@
+import { useState } from "react";
+import { X } from "lucide-react";
+import { creatorApi } from "./api";
+import { creatorStore, refreshCreator } from "./store";
+import { formatValue } from "./IndicatorCard";
+import "./chart-legends.css";
+
+export default function TradingChartLegends({ groups, onRemove }) {
+  const feedError = creatorStore((s) => s.error);
+  const [error, setError] = useState(""),
+    [removing, setRemoving] = useState(null);
+  async function remove(id) {
+    if (removing) return;
+    setRemoving(id);
+    try {
+      if (onRemove) await onRemove(id);
+      else {
+        await creatorApi.update(id, { chart: false });
+        await refreshCreator();
+      }
+      setError("");
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setRemoving(null);
+    }
+  }
+  return (
+    <>
+      <div className="cr-chart-legends cr-trading-legends">
+        {groups.map((g) => (
+          <div
+            key={g.index}
+            className={`cr-pane-legend ${g.index === 0 ? "overlay" : ""}`}
+            style={{ top: g.top + 6 }}
+          >
+            {g.items.map((p) => (
+              <span key={`${p.installationId}:${p.id}`}>
+                <i style={{ background: p.color }} />
+                <span title={p.label}>{p.label}</span>
+                <b style={{ color: p.color }}>
+                  {formatValue(p.value, p.precision ?? 2)}
+                </b>
+                {p.error && (
+                  <small
+                    className="cr-plot-delayed"
+                    title="Last recorded calculation; updates interrupted"
+                  >
+                    Delayed
+                  </small>
+                )}
+                <button
+                  disabled={Boolean(removing)}
+                  title="Remove from chart"
+                  aria-label={`Remove ${p.label} from chart`}
+                  onClick={() => remove(p.installationId)}
+                >
+                  <X size={11} />
+                </button>
+              </span>
+            ))}
+          </div>
+        ))}
+      </div>
+      {(error || (!onRemove && groups.length > 0 && feedError)) && (
+        <div className="cr-chart-error" role="alert">
+          {error || "Indicator updates are interrupted. Reconnecting…"}
+        </div>
+      )}
+    </>
+  );
+}
