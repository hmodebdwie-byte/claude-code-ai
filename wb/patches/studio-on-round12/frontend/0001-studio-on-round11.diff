@@ -0,0 +1,79 @@
+import { useEffect, useRef, useState } from "react";
+import { ChevronDown, ChevronUp } from "lucide-react";
+
+/** Reserve each pane's height; make overflow explicit instead of compressing plots. */
+export default function ChartViewport({ studio, paneCount, children }) {
+  const viewport = useRef(null);
+  const [scroll, setScroll] = useState({
+    overflow: false,
+    top: true,
+    bottom: true,
+  });
+  useEffect(() => {
+    const el = viewport.current;
+    const measure = () => {
+      const next = {
+        overflow: el.scrollHeight > el.clientHeight + 2,
+        top: el.scrollTop <= 2,
+        bottom: el.scrollTop + el.clientHeight >= el.scrollHeight - 2,
+      };
+      setScroll((old) =>
+        old.overflow === next.overflow &&
+        old.top === next.top &&
+        old.bottom === next.bottom
+          ? old
+          : next,
+      );
+    };
+    const observer = new ResizeObserver(measure);
+    observer.observe(el);
+    if (el.firstElementChild) observer.observe(el.firstElementChild);
+    el.addEventListener("scroll", measure, { passive: true });
+    measure();
+    return () => {
+      observer.disconnect();
+      el.removeEventListener("scroll", measure);
+    };
+  }, [paneCount]);
+  const move = (direction) =>
+    viewport.current.scrollBy({
+      top: direction * Math.max(150, viewport.current.clientHeight * 0.65),
+      behavior: "smooth",
+    });
+  return (
+    <div className="cr-chart-frame">
+      <div
+        ref={viewport}
+        className={`cr-live-chart-viewport ${studio ? "studio" : ""}`}
+        tabIndex={scroll.overflow ? 0 : undefined}
+        aria-label="Price chart and indicator panes"
+      >
+        {children}
+      </div>
+      {scroll.overflow && (
+        <div className="cr-pane-scroll">
+          <span>
+            {paneCount} indicator {paneCount === 1 ? "pane" : "panes"} · Scroll
+            to explore
+          </span>
+          <div>
+            <button
+              aria-label="Scroll chart panes up"
+              disabled={scroll.top}
+              onClick={() => move(-1)}
+            >
+              <ChevronUp size={16} />
+            </button>
+            <button
+              aria-label="Scroll chart panes down"
+              disabled={scroll.bottom}
+              onClick={() => move(1)}
+            >
+              <ChevronDown size={16} />
+            </button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/creator/CodeEditor.jsx b/src/creator/CodeEditor.jsx
new file mode 100644
index 0000000..2240765
--- /dev/null
+++ b/src/creator/CodeEditor.jsx
@@ -0,0 +1,112 @@
+// Register services before the editor initializes its standalone service container.
+import "monaco-editor/editor/contrib/codelens/browser/codeLensCache.js";
+import "monaco-editor/editor/common/services/treeViewsDndService.js";
+import { useEffect, useRef } from "react";
+import * as monaco from "monaco-editor/editor/editor.api.js";
+import * as typescript from "monaco-editor/languages/features/typescript/register.js";
+import "monaco-editor/languages/definitions/typescript/register.js";
+import "monaco-editor/editor/contrib/suggest/browser/suggestController.js";
+import "monaco-editor/editor/contrib/hover/browser/hoverContribution.js";
+import EditorWorker from "monaco-editor/editor/editor.worker.js?worker";
+import TypeScriptWorker from "monaco-editor/languages/features/typescript/ts.worker.js?worker";
+
+self.MonacoEnvironment = {
+  getWorker: (_module, label) =>
+    label === "typescript" || label === "javascript"
+      ? new TypeScriptWorker()
+      : new EditorWorker(),
+};
+
+export default function CodeEditor({
+  value,
+  onChange,
+  sdk,
+  diagnostics = [],
+  mode = "arena",
+}) {
+  const container = useRef(null),
+    editor = useRef(null),
+    onChangeRef = useRef(onChange);
+  onChangeRef.current = onChange;
+  useEffect(() => {
+    const defaults = typescript.typescriptDefaults;
+    defaults.setCompilerOptions({
+      target: typescript.ScriptTarget.ES2020,
+      module: typescript.ModuleKind.CommonJS,
+      strict: true,
+      noLib: false,
+      lib: ["lib.es2020.d.ts"],
+      types: [],
+      allowNonTsExtensions: true,
+    });
+    const lib = defaults.addExtraLib(sdk, "file:///ticktrade/sdk.d.ts");
+    const model = monaco.editor.createModel(
+      value,
+      "typescript",
+      monaco.Uri.parse(`file:///ticktrade/script-${crypto.randomUUID()}.ts`),
+    );
+    monaco.editor.defineTheme("ticktrade-night", {
+      base: "vs-dark",
+      inherit: true,
+      rules: [{ token: "comment", foreground: "76867d" }],
+      colors: {
+        "editor.background": "#0d0f0e",
+        "editorGutter.background": "#0d0f0e",
+        "editorLineNumber.foreground": "#65716a",
+        "editorCursor.foreground": "#00df9a",
+        "editor.selectionBackground": "#00df9a30",
+        "editor.lineHighlightBackground": "#ffffff05",
+      },
+    });
+    const instance = monaco.editor.create(container.current, {
+      model,
+      theme: mode === "binary" ? "vs" : "ticktrade-night",
+      automaticLayout: true,
+      fontSize: 13,
+      lineHeight: 21,
+      minimap: { enabled: false },
+      padding: { top: 16 },
+      scrollBeyondLastLine: false,
+      wordWrap: "on",
+      tabSize: 2,
+      ariaLabel: "TickScript code editor",
+    });
+    editor.current = instance;
+    const change = instance.onDidChangeModelContent(() =>
+      onChangeRef.current(instance.getValue()),
+    );
+    return () => {
+      change.dispose();
+      instance.dispose();
+      model.dispose();
+      lib.dispose();
+      editor.current = null;
+    };
+    // A document is retained while editing; source changes are applied below.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [sdk]);
+  useEffect(() => {
+    const instance = editor.current;
+    if (instance && instance.getValue() !== value) instance.setValue(value);
+  }, [value]);
+  useEffect(() => {
+    monaco.editor.setTheme(mode === "binary" ? "vs" : "ticktrade-night");
+  }, [mode]);
+  useEffect(() => {
+    const model = editor.current?.getModel();
+    if (model)
+      monaco.editor.setModelMarkers(
+        model,
+        "ticktrade",
+        diagnostics.map((d) => ({
+          startLineNumber: d.line || 1,
+          endLineNumber: d.line || 1,
+          startColumn: d.column || 1,
+          endColumn: (d.column || 1) + 1,
+          message: d.message,
+          severity: monaco.MarkerSeverity.Error,
+        })),
+      );
+  }, [diagnostics]);
+  return <div className="cr-code-editor" ref={container} />;
+}
diff --git a/src/creator/CreatorCards.jsx b/src/creator/CreatorCards.jsx
new file mode 100644
index 0000000..45d4c55
--- /dev/null
+++ b/src/creator/CreatorCards.jsx
@@ -0,0 +1,42 @@
+import { useState } from "react";
+import { creatorApi } from "./api";
+import { creatorStore, refreshCreator } from "./store";
+import IndicatorCard from "./IndicatorCard";
+
+// Matches owns navigation. This surface deliberately mounts one installation,
+// so a phone swipe has exactly the same meaning for native and custom cards.
+export default function CreatorCards({ installationId }) {
+  const row = creatorStore((s) => s.installations.find((r) =>
+    String(r.id) === String(installationId) && r.card && !r.version?.script?.disabled));
+  const feedError = creatorStore((s) => s.error);
+  const [error, setError] = useState("");
+  const [removing, setRemoving] = useState(false);
+  async function remove() {
+    if (!row || removing) return;
+    setError("");
+    setRemoving(true);
+    try {
+      await creatorApi.update(row.id, { card: false });
+      await refreshCreator();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setRemoving(false);
+    }
+  }
+  if (!row) return null;
+  return (
+    <section className="tt-study-page" aria-label={`${row.version?.manifest?.name || 'Indicator'} card`} data-installation-id={row.id}>
+      {error && <p role="alert" className="tt-collection-error">{error}</p>}
+      <IndicatorCard
+        output={row.output}
+        history={row.history}
+        status={row.status}
+        error={row.error || feedError}
+        title={row.version?.manifest?.name}
+        removing={removing}
+        onRemove={remove}
+      />
+    </section>
+  );
+}
diff --git a/src/creator/CreatorStudio.jsx b/src/creator/CreatorStudio.jsx
