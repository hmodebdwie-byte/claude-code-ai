+test('delta feed merges corrected tail, adds new points, retains other plots and removes missing installations',()=>{
+ const previous=[{id:'a',history:{p:[{time:1,value:2},{time:2,value:3}],q:[{time:1,value:8}]}},{id:'removed'}];
+ const merged=mergeCreatorFeed(previous,{ids:['a','new'],rows:[{id:'a',historyTail:true,history:{p:[{time:2,value:4},{time:3,value:5}],$signals:[]}},{id:'new',history:{x:[]}}]});
+ assert.deepEqual(merged[0].history.p,[{time:1,value:2},{time:2,value:4},{time:3,value:5}]);assert.deepEqual(merged[0].history.q,previous[0].history.q);assert.equal(merged.length,2);
+});
+test('warmup reset replaces every plot and bounded merge retains exactly 3000 points',()=>{
+ const old={id:'a',history:{p:Array.from({length:3000},(_,i)=>({time:i,value:i}))}};
+ const merged=mergeCreatorRow(old,{id:'a',historyTail:true,history:{p:[{time:3000,value:3000}]}});assert.equal(merged.history.p.length,3000);assert.equal(merged.history.p[0].time,1);
+ assert.deepEqual(mergeCreatorRow(old,{id:'a',historyTail:false,history:{q:[]}}).history,{q:[]});
+});
+test('3000-point live chart redraw sends one new point and skips identical history',()=>{
+ const full=[],updates=[],s={setData:a=>full.push(a),update:a=>updates.push(a)},data=Array.from({length:3000},(_,i)=>({time:i+1,value:i/2}));
+ const state=writeSeries(s,data,{},'one');writeSeries(s,data,state,'one');assert.equal(full.length,1);assert.equal(updates.length,0);
+ writeSeries(s,[...data,{time:3001,value:123}],state,'one');assert.equal(full.length,1);assert.deepEqual(updates,[{time:3001,value:123}]);
+});
+test('chart handles same-time revision, backwards replay and epoch replacement',()=>{
+ let replacements=0,updates=[];const s={setData:()=>replacements++,update:p=>updates.push(p)};
+ const state=writeSeries(s,[{time:1,value:1},{time:2,value:2}],{},'one');writeSeries(s,[{time:1,value:1},{time:2,value:9}],state,'one');assert.equal(updates[0].value,9);
+ writeSeries(s,[{time:1,value:1}],state,'one');assert.equal(replacements,2);
+ writeSeries(s,[{time:1,value:8}],state,'two');assert.equal(replacements,3);
+});
