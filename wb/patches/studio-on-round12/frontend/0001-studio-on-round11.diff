+                <input
+                  aria-label={`Condition ${i + 1} threshold`}
+                  type="number"
+                  step="any"
+                  value={c.value}
+                  onChange={(e) => update(i, "value", Number(e.target.value))}
+                />
+                <button
+                  className="cr-icon-button"
+                  disabled={conditions.length === 1}
+                  aria-label={`Delete condition ${i + 1}`}
+                  onClick={() =>
+                    setConditions((v) => v.filter((_, n) => n !== i))
+                  }
+                >
+                  <X size={13} />
+                </button>
+              </div>
+            ))}
+          </div>
+          <button
+            className="cr-button"
+            disabled={conditions.length >= 12}
+            onClick={() =>
+              setConditions((c) => [
+                ...c,
+                { field: "seconds", operator: ">", value: 30 },
+              ])
+            }
+          >
+            <Plus size={13} />
+            Add condition
+          </button>
+          <div className="cr-two-fields">
+            <label>
+              Consecutive confirmations
+              <input
+                type="number"
+                min="1"
+                max="100"
+                value={confirmations}
+                onChange={(e) => setConfirmations(e.target.value)}
+              />
+            </label>
+            {kind === "expert" && (
+              <>
+                <label>
+                  Entry side
+                  <select
+                    value={side}
+                    onChange={(e) => setSide(e.target.value)}
+                  >
+                    <option>BUY</option>
+                    <option>SELL</option>
+                  </select>
+                </label>
+                <label>
+                  Requested stake
+                  <input
+                    type="number"
+                    min="0.01"
+                    max="10000"
+                    step="0.01"
+                    value={stake}
+                    onChange={(e) => setStake(e.target.value)}
+                  />
+                </label>
+              </>
+            )}
+          </div>
+          <p className="cr-callout">
+            {kind === "expert"
+              ? "Emit one request when the conditions become confirmed. Reset the trigger only when conditions become false."
+              : "Display the rule state as a chart oscillator and indicator card."}{" "}
+            Both preserve plotted history across rounds.
+          </p>
+          <div className="cr-row-actions">
+            <button
+              className="cr-button primary"
+              disabled={busy}
+              onClick={() =>
+                task(() => creatorApi.post("authoring/build", rule))
+              }
+            >
+              <Code2 size={15} />
+              Generate validated code
+            </button>
+            <button
+              className="cr-button"
+              onClick={() => downloadFile("ticktrade-rule-graph.json", rule)}
+            >
+              <Download size={13} />
+              Export rules
+            </button>
+          </div>
+        </div>
+      )}
+      {tab === "ai" && (
+        <div className="cr-form">
+          <span className="cr-badge">
+            {capabilities?.aiConfigured
+              ? capabilities.model
+              : "Connect a provider in admin configuration"}
