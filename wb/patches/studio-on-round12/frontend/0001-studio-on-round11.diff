+  const p = { id: "price", label: "Price", placement: "overlay" };
+  host.update([
+    {
+      id: "a",
+      chart: true,
+      cursor: { epoch: "one" },
+      output: { plots: [p] },
+      history: { price: [{ time: 100, value: 1.2 }] },
+    },
+  ]);
+  host.update([
+    {
+      id: "a",
+      chart: true,
+      error: "delayed",
+      cursor: { epoch: "one" },
+      output: { plots: [p] },
+      history: {
+        price: [
+          { time: 100, value: 1.2 },
+          { time: 103, value: 1.21 },
+        ],
+      },
+    },
+  ]);
+  assert.deepEqual(f.all[0].updates, [{ time: 103, value: 1.21 }]);
+  assert.equal(legends.at(-1)[0].items[0].precision, 5);
+  assert.equal(legends.at(-1)[0].items[0].error, true);
+});
+test("native Arena plots cannot extend the native price domain and move forward without losing stored history", () => {
+  const frames = [];
+  const previousRequest = globalThis.requestAnimationFrame,
+    previousCancel = globalThis.cancelAnimationFrame;
