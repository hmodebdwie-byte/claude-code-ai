@@ -0,0 +1,60 @@
+import axios from "../utils/axios";
+export const CREATOR_CHANGED_EVENT = "ticktrade:creator-changed";
+export const CREATOR_CHANGED_KEY = "ticktrade:creator-revision";
+const announceChange = (result) => {
+  window.dispatchEvent(new Event(CREATOR_CHANGED_EVENT));
+  try {
+    localStorage.setItem(CREATOR_CHANGED_KEY, `${Date.now()}:${Math.random()}`);
+  } catch {
+    /* Storage may be unavailable; polling still works. */
+  }
+  return result;
+};
+const get = async (path) => (await axios.get(`/creator/${path}`)).data;
+const post = async (path, body) =>
+  (await axios.post(`/creator/${path}`, body, { timeout: 30000 })).data;
+export const creatorApi = {
+  get,
+  post,
+  feed: async (known, signal) =>
+    (
+      await axios.post(
+        "/creator/installations/feed",
+        { known },
+        { signal, timeout: 10000 },
+      )
+    ).data,
+  delete: async (path) => (await axios.delete(`/creator/${path}`)).data,
+  workspace: () => get("workspace"),
+  reloadHistory: (id) => post(`installations/${id}/history`, {}),
+  datasets: (mode) => get(`datasets${mode ? `?mode=${mode}` : ""}`),
+  chart: (id, q = {}) =>
+    get(`datasets/${encodeURIComponent(id)}/chart?${new URLSearchParams(q)}`),
+  explore: (id, q = {}) =>
+    get(`datasets/${encodeURIComponent(id)}/explore?${new URLSearchParams(q)}`),
+  research: () => get("research"),
+  job: (id) => get(`research/${id}`),
+  createResearch: (body) => post("research", body),
+  generate: async (body) =>
+    (await axios.post("/creator/authoring/generate", body, { timeout: 120000 }))
+      .data,
+  catalog: () => get("catalog"),
+  library: () => get("scripts"),
+  installations: () => get("installations"),
+  frame: (window = 30) => get(`frame?windowSeconds=${window}`),
+  version: (id) => get(`versions/${id}`),
+  validate: (source, params) => post("validate", { source, params }),
+  preview: (source, params) => post("preview", { source, params }),
+  save: (source, scriptId) =>
+    post("scripts", { source, ...(scriptId ? { scriptId } : {}) }),
+  install: async (body) => announceChange(await post("installations", body)),
+  update: async (id, body) =>
+    announceChange(
+      (await axios.patch(`/creator/installations/${id}`, body)).data,
+    ),
+  remove: async (id) =>
+    announceChange((await axios.delete(`/creator/installations/${id}`)).data),
+  removeScript: async (id) =>
+    announceChange((await axios.delete(`/creator/scripts/${id}`)).data),
+  decisions: (id) => get(`installations/${id}/decisions`),
+};
diff --git a/src/creator/cardGeometry.mjs b/src/creator/cardGeometry.mjs
new file mode 100644
index 0000000..6cd2de1
--- /dev/null
+++ b/src/creator/cardGeometry.mjs
@@ -0,0 +1,120 @@
+/** Share actual scales within a named pane; price never shares an oscillator axis. */
+export function cardChartGroups(plots, selected) {
+  const groups = new Map();
+  for (const p of plots) {
+    if (selected && !selected.includes(p.id)) continue;
+    const key =
+      p.placement === "overlay"
+        ? "price"
+        : `${p.pane || "study"}:${p.unit || ""}`;
+    if (!groups.has(key)) groups.set(key, { key, plots: [] });
+    groups.get(key).plots.push(p);
+  }
+  return [...groups.values()];
+}
+/** Preserve discontinuities and extrema with a bounded SVG vertex count. */
+export function reduceCardPoints(points, limit = 180) {
+  if (points.length <= limit) return points;
+  const result = [],
+    size = Math.ceil(points.length / (limit / 5));
+  for (let i = 0; i < points.length; i += size) {
+    const bucket = points.slice(i, i + size),
+      finite = bucket.filter((p) => Number.isFinite(p.value));
+    const candidates = [bucket[0], bucket.at(-1)];
+    if (finite.length)
+      candidates.push(
+        finite.reduce((a, b) => (a.value < b.value ? a : b)),
+        finite.reduce((a, b) => (a.value > b.value ? a : b)),
+      );
+    const gap = bucket.find((p) => !Number.isFinite(p.value));
+    if (gap) candidates.push(gap);
+    result.push(...[...new Set(candidates)].sort((a, b) => a.time - b.time));
+  }
+  return result;
+}
+export function chartGeometry(plots, history, windowSeconds = 300) {
+  let min = Infinity,
+    max = -Infinity,
+    start = Infinity,
+    end = -Infinity;
+  // Calculation warmup can span many rounds; a phone card displays one Arena window.
+  const latest = Math.max(
+    -Infinity,
+    ...plots.map((p) => {
+      const values = history[p.id] || [];
+      return values.reduce(
+        (last, point) =>
+          Number.isFinite(Number(point.time))
+            ? Math.max(last, Number(point.time))
+            : last,
+        -Infinity,
+      );
+    }),
+  );
+  const series = plots.map((plot) => {
+    const sorted = (history[plot.id] || [])
+      .slice(-1200)
+      .filter(
+        (p) =>
+          Number.isFinite(Number(p.time)) &&
+          Number(p.time) >= latest - windowSeconds,
+      )
+      .map((p) => ({
+        ...p,
+        time: Number(p.time),
+        value: Number.isFinite(p.value) ? p.value : null,
+      }))
+      .sort((a, b) => a.time - b.time);
+    const unique = [...new Map(sorted.map((p) => [p.time, p])).values()];
+    const intervals = unique
+      .slice(1)
+      .map((p, i) => p.time - unique[i].time)
+      .filter((d) => d > 0)
+      .sort((a, b) => a - b);
+    const gapLimit = Math.max(
+      15,
+      (intervals[Math.floor(intervals.length / 2)] || 1) * 4,
+    );
+    const raw = [];
+    for (const p of unique) {
+      const previous = raw.at(-1);
+      if (previous && p.time - previous.time > gapLimit)
+        raw.push({ time: previous.time + 0.001, value: null });
+      raw.push(p);
+    }
+    for (const p of raw) {
+      start = Math.min(start, p.time);
+      end = Math.max(end, p.time);
+      if (p.value !== null) {
+        min = Math.min(min, p.value);
+        max = Math.max(max, p.value);
+      }
+    }
+    if (plot.style === "histogram" && raw.some((p) => p.value !== null)) {
+      min = Math.min(min, 0);
+      max = Math.max(max, 0);
+    }
+    const points = reduceCardPoints(raw),
+      segments = [];
+    let segment = [];
+    for (const p of points) {
+      if (p.value === null) {
+        if (segment.length) segments.push(segment);
+        segment = [];
+      } else segment.push(p);
+    }
+    if (segment.length) segments.push(segment);
+    return { plot, points, segments };
+  });
+  if (!Number.isFinite(min) || !Number.isFinite(max) || !Number.isFinite(start))
+    return null;
+  const pad = (max - min || Math.abs(max) * 0.02 || 1) * 0.08;
+  min -= pad;
+  max += pad;
+  const mins = plots.map((p) => p.scaleMin).filter(Number.isFinite),
+    maxs = plots.map((p) => p.scaleMax).filter(Number.isFinite);
+  if (mins.length) min = Math.min(...mins);
+  if (maxs.length) max = Math.max(...maxs);
+  if (max <= min) max = min + 1;
+  return { min, max, start, end, series };
+}
