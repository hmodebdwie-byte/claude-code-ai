+      quote: [
+        { time: 90, value: 0.9 },
+        { time: 100, value: 1 },
+        { time: 101, value: 1.1 },
+        { time: 102, value: 1.2 },
+        { time: 103, value: 1.3 },
+        { time: 104, value: 1.4 },
+      ],
+      $signals: [
+        { time: 90, side: "BUY" },
+        { time: 101, side: "BUY" },
+        { time: 104, side: "SELL" },
+      ],
+    };
+    const row = {
+      id: "native",
+      chart: true,
+      cursor: { epoch: "one" },
+      history,
+      output: {
+        plots: [{ id: "quote", label: "Quote", placement: "overlay" }],
+      },
+    };
+    host.update([row]);
+    assert.deepEqual(
+      f.all[0].data.map((p) => p.time),
+      [100, 101, 102],
+    );
+    assert.deepEqual(
+      f.markerCalls.at(-1).map((p) => p.time),
+      [101],
+    );
+    assert.equal(
+      legends.at(-1)[0].items[0].value,
+      1.2,
+      "Legend must report its last rendered observation, not a future stored value",
+    );
+    native = [
+      { time: 100, value: 1 },
+      { time: 103, value: 1.3 },
+    ];
+    listener();
+    listener();
+    assert.equal(
+      frames.length,
+      1,
+      "Native timestamp changes batch into one frame",
+    );
+    frames.shift()();
+    assert.deepEqual(f.all[0].updates, [{ time: 103, value: 1.3 }]);
+    assert.equal(
+      f.all[0].full,
+      1,
+      "Only advancing the right edge must remain incremental",
+    );
+    listener();
+    assert.equal(
+      frames.length,
+      0,
+      "Animated price revisions at the same native timestamp do not rebuild Creator history",
+    );
+    native = [
+      { time: 102, value: 1.2 },
+      { time: 103, value: 1.3 },
+    ];
+    listener();
+    frames.shift()();
+    assert.equal(f.all[0].full, 2);
+    assert.deepEqual(
+      f.all[0].data.map((p) => p.time),
+      [102, 103],
+      "Moving the left edge must remove expired plotted history",
+    );
+    native = [{ time: 300, value: 2 }];
+    listener();
+    frames.shift()();
+    assert.deepEqual(
+      f.all[0].data,
+      [],
+      "A native round reset cannot leave an old indicator plot behind",
+    );
+    assert.equal(
+      history.quote.length,
+      6,
+      "Display bounds never truncate calculation history",
+    );
+    host.update([
+      {
+        ...row,
+        history: {
+          ...history,
