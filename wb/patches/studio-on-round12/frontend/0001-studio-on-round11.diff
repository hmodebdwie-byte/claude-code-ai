diff --git a/src/creator/feedCoordinator.mjs b/src/creator/feedCoordinator.mjs
new file mode 100644
index 0000000..f7a1340
--- /dev/null
+++ b/src/creator/feedCoordinator.mjs
@@ -0,0 +1,87 @@
+/** One network request at a time. Mutations during a request coalesce into one fresh read. */
+export function createFeedCoordinator({
+  getIdentity,
+  request,
+  onReset,
+  onData,
+  onError,
+}) {
+  let identity = undefined,
+    generation = 0,
+    active = null,
+    controller = null,
+    dirty = false;
+  const synchronize = () => {
+    const next = getIdentity();
+    if (next !== identity) {
+      identity = next;
+      generation++;
+      controller?.abort();
+      controller = null;
+      active = null;
+      dirty = false;
+      onReset();
+    }
+    return next;
+  };
+  return {
+    get pending() {
+      return Boolean(active);
+    },
+    refresh({ afterCurrent = true } = {}) {
+      const token = synchronize();
+      if (!token) return Promise.resolve();
+      if (active) {
+        if (afterCurrent) dirty = true;
+        return active;
+      }
+      const ownGeneration = generation;
+      // Schedule after active is assigned, including when request throws synchronously.
+      const task = Promise.resolve()
+        .then(async () => {
+          do {
+            dirty = false;
+            const abort = new AbortController();
+            controller = abort;
+            try {
+              const result = await request(abort.signal);
+              if (
+                ownGeneration !== generation ||
+                getIdentity() !== token ||
+                abort.signal.aborted
+              )
+                return;
+              onData(result);
+            } catch (error) {
+              if (
+                ownGeneration !== generation ||
+                getIdentity() !== token ||
+                abort.signal.aborted
+              )
+                return;
+              onError(error);
+            }
+          } while (
+            dirty &&
+            ownGeneration === generation &&
+            getIdentity() === token
+          );
+        })
+        .finally(() => {
+          if (active === task) {
+            active = null;
+            controller = null;
+          }
+        });
+      active = task;
+      return task;
+    },
+    stop() {
+      generation++;
+      controller?.abort();
+      controller = null;
+      active = null;
+      dirty = false;
+    },
+  };
+}
diff --git a/src/creator/feedMath.js b/src/creator/feedMath.js
new file mode 100644
index 0000000..d312c50
--- /dev/null
+++ b/src/creator/feedMath.js
@@ -0,0 +1,30 @@
+/** Server histories are append-only within an epoch; reset epochs replace the complete history. */
+export function mergeCreatorRow(previous, row) {
+  if (!row.historyTail || !previous) return row;
+  const history = { ...previous.history };
+  for (const [key, points] of Object.entries(row.history || {})) {
+    if (key === "$signals") {
+      history[key] = points;
+      continue;
+    }
+    if (!points.length) continue;
+    const before = history[key] || [];
+    const cut = before.findIndex((p) => p.time >= points[0].time);
+    history[key] = [
+      ...(cut < 0 ? before : before.slice(0, cut)),
+      ...points,
+    ].slice(-3000);
+  }
+  return { ...row, history };
+}
+export function mergeCreatorFeed(previous, feed) {
+  const changed = new Map(feed.rows.map((r) => [r.id, r]));
+  const old = new Map(previous.map((r) => [r.id, r]));
+  return feed.ids
+    .map((id) =>
+      changed.has(id)
+        ? mergeCreatorRow(old.get(id), changed.get(id))
+        : old.get(id),
+    )
+    .filter(Boolean);
+}
diff --git a/src/creator/identitySnapshot.mjs b/src/creator/identitySnapshot.mjs
new file mode 100644
index 0000000..32ed38c
--- /dev/null
+++ b/src/creator/identitySnapshot.mjs
@@ -0,0 +1,13 @@
+/** Never expose another session's cached data, including the first render before effects. */
+export function createIdentitySnapshot(getIdentity, emptyState) {
+  let emptyIdentity = Symbol('uninitialized'), empty;
+  return (state) => {
+    const identity = getIdentity();
+    if (state.sessionIdentity === identity) return state;
+    if (emptyIdentity !== identity) {
+      emptyIdentity = identity;
+      empty = Object.freeze({ ...emptyState, sessionIdentity: identity });
+    }
+    return empty;
+  };
+}
