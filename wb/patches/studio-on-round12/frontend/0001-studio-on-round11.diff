+                    >
+                      {data?.latest?.data?.[f.key] != null
+                        ? "Available"
+                        : "No coverage"}
+                    </span>
+                  </button>
+                ))}
+              </div>
+            </div>
+            <article className="cr-panel cr-feature-detail">
+              <span className="cr-eyebrow">
+                {active?.category} / FEATURE CONTRACT
+              </span>
+              <h2>{active?.label}</h2>
+              <p>{active?.description}</p>
+              <div className="cr-code-line">
+                <code>{active?.id}</code>
+                <button
+                  className="cr-icon-button"
+                  aria-label="Copy feature dependency"
+                  onClick={async () => {
+                    try {
+                      await navigator.clipboard.writeText(
+                        `requires: ["${active.id}"]`,
+                      );
+                      setCopied(true);
+                    } catch {
+                      setError(
+                        "Clipboard unavailable; select and copy the dependency above.",
+                      );
+                    }
+                  }}
+                >
+                  <Copy size={13} />
+                  {copied ? "Copied" : ""}
+                </button>
+              </div>
+              <h4>Latest observed values</h4>
+              {snapshot == null ? (
+                <Empty title="Coverage unavailable">
+                  This feature needs recorded observations that are absent from
+                  the selected history.
+                </Empty>
+              ) : (
+                <div className="cr-value-table">
+                  {Object.entries(snapshot)
+                    .filter(([k]) => k !== "candles")
+                    .slice(0, 30)
+                    .map(([k, v]) => (
+                      <div key={k}>
+                        <span>{k}</span>
+                        <b>
+                          {typeof v === "number"
+                            ? formatNumber(v, 6)
+                            : Array.isArray(v)
+                              ? v.join(", ") || "None"
+                              : typeof v === "object"
+                                ? JSON.stringify(v)
+                                : String(v)}
+                        </b>
+                      </div>
+                    ))}
+                </div>
+              )}
+              <p className="cr-muted">
+                As of {dateTime(data?.latest?.time)} ·{" "}
+                {data?.latest?.source || "No source"}.
+              </p>
+            </article>
+          </div>
+          <div className="cr-panel cr-quality-panel">
+            <h3>Evidence & coverage</h3>
+            <div className="cr-stat-grid">
+              <Metric
+                label="RECONSTRUCTED FRAMES"
+                value={formatNumber(data?.quality?.reconstructedFrames, 0)}
+              />
+              <Metric
+                label="MISSING PARTICIPANT FRAMES"
+                value={formatNumber(data?.quality?.missingParticipants, 0)}
+              />
+              <Metric
+                label="LARGEST OBSERVED GAP"
+                value={`${formatNumber(data?.quality?.maxObservedGapSeconds)} s`}
+              />
+              <Metric
+                label="ANALYSIS WINDOW"
+                value={
+                  data?.quality?.truncated
+                    ? "Bounded sample"
+                    : "Complete selection"
+                }
+              />
+            </div>
+            <p className="cr-muted">
+              {data?.quality?.note} Gaps remain gaps. Tipping pressure is
+              descriptive; calibrated research lives in Research Lab.
+            </p>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
