@@ -0,0 +1,115 @@
+import { useState } from "react";
+import { Database, Search, Copy } from "lucide-react";
+import { Modal, formatNumber } from "./ui";
+export default function BankMetricBrowser({ metrics, bank }) {
+  const [open, setOpen] = useState(false),
+    [search, setSearch] = useState(""),
+    [group, setGroup] = useState("All"),
+    [copied, setCopied] = useState("");
+  const values = bank?.values || {},
+    available = metrics.filter(
+      (m) => values[m.key] !== null && values[m.key] !== undefined,
+    ).length;
+  const filtered = metrics.filter(
+    (m) =>
+      (group === "All" || m.group === group) &&
+      `${m.label} ${m.key} ${m.definition}`
+        .toLowerCase()
+        .includes(search.toLowerCase()),
+  );
+  return (
+    <section className="cr-panel cr-metric-bank-summary">
+      <div>
+        <span className="cr-eyebrow">MARKET INTELLIGENCE</span>
+        <h2>{metrics.length} defined metrics</h2>
+        <p>
+          Participation, sizing, displacement and matured event responses.{" "}
+          {available} values available in this observation.
+        </p>
+      </div>
+      <button className="cr-button primary" onClick={() => setOpen(true)}>
+        <Database size={15} /> Explore metric dictionary
+      </button>
+      {open && (
+        <Modal
+          title="TickTrade metric bank"
+          wide
+          onClose={() => setOpen(false)}
+        >
+          <p>
+            This view describes aggregate priced market events. Account
+            histories, balances and uncommitted budgets are private; those
+            reference fields remain unavailable here. Event horizons mean
+            subsequent accepted events, not seconds.
+          </p>
+          <div className="cr-explorer-search">
+            <Search size={17} />
+            <input
+              aria-label="Search bank metrics"
+              placeholder="Find a statistic or API key"
+              value={search}
+              onChange={(e) => setSearch(e.target.value)}
+            />
+            <select
+              aria-label="Metric group"
+              value={group}
+              onChange={(e) => setGroup(e.target.value)}
+            >
+              {["All", ...new Set(metrics.map((m) => m.group))].map((g) => (
+                <option key={g}>{g}</option>
+              ))}
+            </select>
+          </div>
+          <div
+            className="cr-metric-table"
+            role="table"
+            aria-label="Market metric dictionary"
+          >
+            {filtered.map((m) => (
+              <article key={m.key} className="cr-metric-record" role="row">
+                <div>
+                  <small>{m.group}</small>
+                  <strong>{m.label}</strong>
+                  <code>{m.key}</code>
+                  <p>{m.definition}</p>
+                </div>
+                <div>
+                  <strong>{formatNumber(values[m.key], 4)}</strong>
+                  <small>{m.unit}</small>
+                  <span>
+                    {m.availability !== "measured"
+                      ? "Requires private account data"
+                      : values[m.key] == null
+                        ? "Insufficient eligible observations"
+                        : "Observed market events"}
+                  </span>
+                  <button
+                    className="cr-button"
+                    onClick={async () => {
+                      try {
+                        await navigator.clipboard.writeText(
+                          `ctx.data.bank!.values[${JSON.stringify(m.key)}]`,
+                        );
+                        setCopied(m.key);
+                      } catch {
+                        setCopied("Clipboard unavailable");
+                      }
+                    }}
+                  >
+                    <Copy size={12} />
+                    {copied === m.key ? "Copied" : "Copy SDK field"}
+                  </button>
+                </div>
+              </article>
+            ))}
+          </div>
+          <p className="cr-muted">
+            Declare <code>arena.bank@1</code> in requires. Every script must
+            handle null and inspect sample coverage. Displacement and response
+            statistics are descriptive evidence, not trading profits.
+          </p>
+        </Modal>
+      )}
+    </section>
+  );
+}
