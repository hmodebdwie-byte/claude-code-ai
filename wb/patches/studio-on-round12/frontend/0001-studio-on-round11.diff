+        </button>
+      </div>
+      <ErrorBox error={error} />
+      <div className="cr-stat-grid">
+        <Metric
+          label="ACTIVE EXPERTS"
+          value={
+            experts.filter((r) => r.enabled && r.executionMode !== "signals")
+              .length
+          }
+        />
+        <Metric
+          label="PAPER RUNS"
+          value={experts.filter((r) => r.enabled && r.paper).length}
+        />
+        <Metric
+          label="LIVE RUNS"
+          value={
+            experts.filter((r) => r.enabled && r.executionMode === "live")
+              .length
+          }
+        />
+        <Metric
+          label="LIVE CAPABILITY"
+          value={capabilities?.liveEnabled ? "Enabled" : "Disabled"}
+          sub="Server + admin permission"
+        />
+      </div>
+      {!experts.length ? (
+        <Empty title="Your first expert starts in the editor">
+          Add an expert from Indicators to bring it into this desk. Configure
+          its limits and test a paper run here before enabling live orders.{" "}
+          <a
+            className="cr-button"
+            href="/indicators"
+            target="_blank"
+            rel="noopener"
+          >
+            Explore experts
+          </a>{" "}
+          <button className="cr-button" onClick={onCreate}>
+            Open editor
+          </button>
+        </Empty>
+      ) : (
+        <div className="cr-expert-grid">
+          <aside className="cr-panel">
+            <h3>Installed experts</h3>
+            {experts.map((r) => (
+              <button
+                className={`cr-expert-selector ${current?.id === r.id ? "selected" : ""}`}
+                key={r.id}
+                onClick={() => setSelected(r.id)}
+              >
+                <strong>{r.version.manifest.name}</strong>
+                <small>
+                  {r.executionMode} · {r.status}
+                </small>
+                <progress value={Number(r.spent)} max={Number(r.budget)} />
+                <span>
+                  {formatNumber(r.spent)} / {formatNumber(r.budget)} budget used
+                  or reserved
+                </span>
+              </button>
+            ))}
+          </aside>
+          <div>
+            <div className="cr-panel">
+              <div className="cr-card-heading">
+                <h2>{current.version.manifest.name}</h2>
+                <span
+                  className={`cr-status ${current.enabled ? "good" : "warn"}`}
+                >
+                  {current.status}
+                </span>
+              </div>
+              <div className="cr-stat-grid">
+                <Metric label="BUDGET" value={formatNumber(current.budget)} />
+                <Metric
+                  label="USED / RESERVED"
+                  value={formatNumber(current.spent)}
+                />
+                <Metric
+                  label="MAXIMUM STAKE"
+                  value={formatNumber(current.maxStake)}
+                />
+                <Metric label="COOLDOWN" value={`${current.minIntervalSec}s`} />
+              </div>
+              <div className="cr-row-actions">
+                <button
+                  className="cr-button"
+                  onClick={() =>
+                    setSettings({
+                      id: current.id,
+                      budget: Number(current.budget),
+                      maxStake: Number(current.maxStake),
+                      minIntervalSec: current.minIntervalSec,
+                      risk: { ...current.risk },
+                      params: { ...current.params },
+                      manifest: current.version.manifest,
+                    })
+                  }
+                >
+                  Limits & inputs
+                </button>
+                <button
+                  className="cr-button danger"
+                  disabled={busy || !current.enabled}
+                  onClick={() =>
+                    task(() =>
+                      creatorApi.update(current.id, { enabled: false }),
+                    )
+                  }
+                >
+                  <Square size={13} />
+                  Stop
+                </button>
+                <button
+                  className="cr-button"
+                  disabled={busy}
+                  onClick={() =>
+                    task(() =>
+                      creatorApi.update(current.id, {
+                        enabled: true,
+                        executionMode: "paper",
+                      }),
+                    )
+                  }
+                >
+                  <Play size={13} />
+                  Run in paper
+                </button>
+                <button
+                  className="cr-button"
+                  disabled={busy || !capabilities?.liveEnabled}
+                  onClick={() => {
+                    setLiveTarget(current);
+                    setConsent(false);
+                  }}
+                >
+                  <ShieldCheck size={14} />
+                  Enable live orders
+                </button>
+                <button
+                  className="cr-button"
+                  disabled={busy}
+                  onClick={() =>
+                    task(() =>
+                      creatorApi.update(current.id, {
+                        executionMode: "signals",
+                      }),
+                    )
+                  }
+                >
+                  Signals only
+                </button>
+              </div>
+              <ErrorBox error={current.error} />
+              <p className="cr-muted">
+                Historical warmup: {current.warmupInfo?.calculated || 0}{" "}
+                calculated frames; {current.warmupInfo?.missingFrames || 0}{" "}
+                missing. State scope:{" "}
+                {current.version.manifest.stateScope || "round"}. Drawing
+                history remains when the round changes.
+              </p>
+              <p className="cr-callout">
+                <AlertCircle size={15} />
+                {capabilities?.restartPolicy}. Arena positions settle through
+                the existing round mechanism; manual close orders are
+                unavailable.
+              </p>
+            </div>
+            <div className="cr-panel">
+              <div className="cr-card-heading">
+                <h3>Decision & settlement journal</h3>
+                <ExportButton
+                  name={`expert-${current.id}-journal.json`}
+                  value={journal}
+                />
+              </div>
+              <div className="cr-table-wrap">
+                <table>
+                  <thead>
+                    <tr>
+                      <th>Time / Round</th>
+                      <th>Side</th>
+                      <th>Requested</th>
+                      <th>Mode</th>
+                      <th>State</th>
+                      <th>Trade / Payout</th>
+                      <th>Reason</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {journal.map((d) => (
+                      <tr key={d.id}>
+                        <td>
+                          {dateTime(d.time)}
+                          <small>Round {d.roundId}</small>
+                        </td>
+                        <td
+                          className={`cr-tone-${d.side === "BUY" ? "buy" : "sell"}`}
+                        >
+                          {d.side}
+                        </td>
+                        <td>{formatNumber(d.amount)}</td>
+                        <td>{d.mode}</td>
+                        <td>{d.status}</td>
+                        <td>
+                          {d.tradeId || "—"} / {formatNumber(d.payout)}
+                        </td>
+                        <td>{d.response?.message || d.reason}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+              {!journal.length && (
+                <Empty title="No decisions yet">
+                  An expert records a decision when its script emits a signal. A
+                  quiet expert can be waiting for its conditions.
+                </Empty>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+      {settings && (
+        <Modal
+          title="Expert limits & inputs"
+          wide
+          onClose={() => setSettings(null)}
+        >
+          <p>
+            Saving recalculates history and pauses execution. Your spent budget
+            and decision journal are retained. Resume explicitly from the
+            Experts page.
+          </p>
+          <ErrorBox error={error} />
+          <div className="cr-settings-grid">
+            {Object.entries({
+              budget: "Total session budget",
+              maxStake: "Maximum stake",
+              minIntervalSec: "Minimum seconds between orders",
+            }).map(([key, label]) => (
+              <label key={key}>
+                {label}
+                <input
+                  type="number"
+                  min={key === "minIntervalSec" ? 5 : 1}
+                  max={key === "minIntervalSec" ? 300 : 100000}
+                  value={settings[key]}
+                  onChange={(e) =>
+                    setSettings((s) => ({
+                      ...s,
+                      [key]: Number(e.target.value),
+                    }))
+                  }
+                />
+              </label>
+            ))}
+            {Object.entries({
+              maxPerRound: "Maximum amount per round",
+              maxPerDay: "Maximum amount per day",
+              maxOrdersPerRound: "Maximum orders per round",
+              lossStop: "Daily realized loss stop",
+            }).map(([key, label]) => (
+              <label key={key}>
+                {label}
+                <input
+                  type="number"
+                  min="1"
+                  placeholder="No additional limit"
+                  value={settings.risk[key] ?? ""}
+                  onChange={(e) =>
+                    setSettings((s) => {
+                      const risk = { ...s.risk };
+                      if (e.target.value === "") delete risk[key];
+                      else risk[key] = Number(e.target.value);
+                      return { ...s, risk };
+                    })
+                  }
+                />
+              </label>
+            ))}
+            {Object.entries(settings.manifest.parameters || {}).map(
+              ([key, p]) => (
+                <label key={key}>
+                  {p.label}
+                  {p.type === "boolean" ? (
+                    <input
+                      type="checkbox"
+                      checked={!!settings.params[key]}
+                      onChange={(e) =>
+                        setSettings((s) => ({
+                          ...s,
+                          params: { ...s.params, [key]: e.target.checked },
+                        }))
+                      }
+                    />
+                  ) : (
+                    <input
+                      type="number"
+                      min={p.min}
+                      max={p.max}
+                      step={p.type === "integer" ? 1 : "any"}
+                      value={settings.params[key] ?? p.default}
+                      onChange={(e) =>
+                        setSettings((s) => ({
+                          ...s,
+                          params: {
+                            ...s.params,
+                            [key]: Number(e.target.value),
+                          },
+                        }))
+                      }
+                    />
+                  )}
+                </label>
+              ),
+            )}
+          </div>
+          <button
+            className="cr-button primary"
+            disabled={busy}
+            onClick={() =>
+              task(async () => {
+                const { id, manifest, ...body } = settings;
+                await creatorApi.post(`installations/${id}/configure`, body);
+                setSettings(null);
+              })
+            }
+          >
+            Save limits & pause
+          </button>
+        </Modal>
+      )}
+      {liveTarget && (
+        <Modal
+          title="Enable live expert execution"
+          onClose={() => setLiveTarget(null)}
+        >
+          <div className="cr-form">
+            <h3>{liveTarget.version.manifest.name}</h3>
+            <p>
+              This expert can submit real BUY and SELL orders while the page is
+              closed. The maximum requested stake is{" "}
+              {formatNumber(liveTarget.maxStake)}, with{" "}
+              {formatNumber(
+                Number(liveTarget.budget) - Number(liveTarget.spent),
+              )}{" "}
+              remaining in its session budget.
+            </p>
+            <p>
+              Existing trading restrictions still apply. Stop prevents new
+              dispatches; a request already sent may still complete.
+            </p>
+            <label className="cr-check">
+              <input
+                type="checkbox"
+                checked={consent}
+                onChange={(e) => setConsent(e.target.checked)}
+              />
+              I authorize live trades under these limits.
+            </label>
+            <ErrorBox error={error} />
+            <button
+              className="cr-button danger"
+              disabled={!consent || busy}
+              onClick={() =>
+                task(async () => {
+                  await creatorApi.update(liveTarget.id, {
+                    enabled: true,
+                    executionMode: "live",
+                    confirmLive: "ALLOW LIVE TRADES",
+                  });
+                  setLiveTarget(null);
+                })
+              }
+            >
+              Authorize live execution
+            </button>
+          </div>
+        </Modal>
+      )}
+    </section>
+  );
+}
