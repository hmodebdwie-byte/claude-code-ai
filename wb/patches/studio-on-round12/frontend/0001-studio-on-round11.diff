+          <span className="cr-eyebrow">AUTOMATION DESK</span>
+          <h1>Every decision, under your control.</h1>
+          <p>
+            Server execution, durable journals and explicit limits. Drawings and
+            trading can be controlled independently.
+          </p>
+        </div>
+        <button
+          className="cr-button danger"
+          disabled={busy || !experts.some((r) => r.enabled)}
+          onClick={() => task(() => creatorApi.post("experts/stop-all", {}))}
+        >
+          <Square size={14} />
