index 0000000..a52d1a1
--- /dev/null
+++ b/src/creator/CreatorStudio.jsx
@@ -0,0 +1,909 @@
+import { lazy, Suspense, useEffect, useRef, useState } from "react";
+import {
+  Braces,
+  Check,
+  Play,
+  Save,
+  Library,
+  SlidersHorizontal,
+  LayoutTemplate,
+  X,
+  Square,
+  Sparkles,
+  ExternalLink,
+  Download,
+} from "lucide-react";
+import { creatorApi } from "./api";
+import { ensureCreatorCompatibility } from "./compatibility";
+import { creatorStore, useCreatorFeed } from "./store";
+import { mergeCreatorRow } from "./feedMath";
+import { authStore } from "../stores/authStore";
+import RunningLineChart from "../components/NewChart";
+import PreviewChart from "./PreviewChart";
+import IndicatorCard from "./IndicatorCard";
+import DataBank from "./DataBank";
+import ResearchLab from "./ResearchLab";
+import Marketplace from "./Marketplace";
+import ExpertDesk from "./ExpertDesk";
+import Authoring from "./Authoring";
+import { ErrorBox, Empty, Modal, downloadFile, dateTime } from "./ui";
+import "./creator.css";
+const CodeEditor = lazy(() => import("./CodeEditor"));
+const defaults = (m) =>
+  Object.fromEntries(
+    Object.entries(m?.parameters || {}).map(([k, p]) => [k, p.default]),
+  );
+const allowed = (m) => !m?.requires?.includes("arena.cohorts@1");
+export default function CreatorStudio() {
+  useCreatorFeed();
+  const installations = creatorStore((s) => s.installations);
+  const user = authStore((s) => s.user);
+  const [ownerKey, setOwnerKey] = useState(user?.id || null);
+  const [openRevision, setOpenRevision] = useState(0);
+  const [pasteSource, setPasteSource] = useState("");
+  const [catalog, setCatalog] = useState(null),
+    [capabilities, setCapabilities] = useState(null),
+    [library, setLibrary] = useState([]),
+    [datasets, setDatasets] = useState([]);
+  const [source, setSource] = useState(""),
+    [scriptId, setScriptId] = useState(null),
+    [versionId, setVersionId] = useState(null),
+    [manifest, setManifest] = useState(null),
+    [params, setParams] = useState({}),
+    [diagnostics, setDiagnostics] = useState([]);
+  const [mode, setMode] = useState("arena"),
+    [tab, setTab] = useState("workbench"),
+    [dialog, setDialog] = useState(""),
+    [busy, setBusy] = useState(""),
+    [error, setError] = useState(""),
+    [notice, setNotice] = useState("");
+  const [datasetId, setDatasetId] = useState("arena-live"),
+    [binaryHistory, setBinaryHistory] = useState(null),
+    [interval, setIntervalValue] = useState(60),
+    [chartHeight, setChartHeight] = useState(390),
+    [paneHeight, setPaneHeight] = useState(160),
+    [editorShare, setEditorShare] = useState(52);
+  const [previewId, setPreviewId] = useState(null),
+    [previewRow, setPreviewRow] = useState(null),
+    [showCard, setShowCard] = useState(true),
+    [showPlots, setShowPlots] = useState(true),
+    [previewSource, setPreviewSource] = useState("");
+  const previewRef = useRef(null),
+    mounted = useRef(true),
+    generation = useRef(0),
+    draftReady = useRef(false);
+  previewRef.current = previewRow;
+  async function task(name, fn) {
+    setBusy(name);
+    setError("");
+    setNotice("");
+    try {
+      return await fn();
+    } catch (e) {
+      if (mounted.current) {
+        setError(e.response?.data?.message || e.message);
+        setDiagnostics(e.response?.data?.diagnostics || []);
+      }
+    } finally {
+      if (mounted.current) setBusy("");
+    }
+  }
+  const refreshLibrary = async () => {
+    const r = await creatorApi.library();
+    setLibrary(r.filter((s) => allowed(s.versions[0]?.manifest)));
+  };
+  const refreshDatasets = async () => setDatasets(await creatorApi.datasets());
+  function useDocument(text, id = null, version = null, m = null) {
+    generation.current++;
+    setSource(text);
+    setScriptId(id);
+    setVersionId(version);
+    setManifest(m);
+    setParams(defaults(m));
+    setDiagnostics([]);
+    setDialog("");
+    setTab("workbench");
+  }
+  async function openVersion(id) {
+    const v = await creatorApi.version(id);
+    useDocument(v.source, v.scriptId, v.id, v.manifest);
+  }
+  useEffect(() => {
+    mounted.current = true;
+    let active = true;
+    void task("Opening Studio", async () => {
+      await ensureCreatorCompatibility({ force: openRevision > 0 });
+      const [c, l, d, w] = await Promise.all([
+        creatorApi.catalog(),
+        creatorApi.library(),
+        creatorApi.datasets(),
+        creatorApi.workspace(),
+      ]);
+      if (!active) return;
+      setCatalog(c);
+      setLibrary(l.filter((s) => allowed(s.versions[0]?.manifest)));
+      setDatasets(d);
+      setCapabilities(w);
+      setOwnerKey(w.ownerId);
+      const v = new URLSearchParams(location.search).get("version");
+      if (v) await openVersion(v);
+      else {
+        let draft;
+        try {
+          draft = JSON.parse(
+            localStorage.getItem(`creator-v3-draft:${w.ownerId}`),
+          );
+        } catch {
+          /* Invalid local draft falls back to the first example. */
+        }
+        const first =
+          c.examples.find((e) => e.id === "adaptive-envelope") ||
+          c.examples[1] ||
+          c.examples[0];
+        useDocument(
+          draft?.source || first.source,
+          draft?.scriptId || null,
+          draft?.versionId || null,
+          draft?.manifest || null,
+        );
+      }
+      draftReady.current = true;
+    });
+    return () => {
+      active = false;
+      mounted.current = false;
+    };
+  }, [openRevision]);
+  useEffect(() => {
+    if (!draftReady.current || !source || !ownerKey) return;
+    const timer = setTimeout(() => {
+      try {
+        localStorage.setItem(
+          `creator-v3-draft:${ownerKey}`,
+          JSON.stringify({ source, scriptId, versionId, manifest }),
+        );
+      } catch {
+        /* Private server saves remain available when local storage is full. */
+      }
+    }, 700);
+    return () => clearTimeout(timer);
+  }, [source, scriptId, versionId, manifest, ownerKey]);
+  useEffect(() => {
+    if (
+      mode !== "binary" ||
+      !datasetId ||
+      datasetId === "arena-live" ||
+      tab !== "workbench"
+    )
+      return;
+    let active = true;
+    creatorApi
+      .chart(datasetId, { interval, limit: 2000 })
+      .then((r) => {
+        if (active) setBinaryHistory(r);
+      })
+      .catch((e) => {
+        if (active) setError(e.message);
+      });
+    return () => {
+      active = false;
+    };
+  }, [mode, datasetId, interval, tab]);
+  useEffect(() => {
+    if (!previewId) return;
+    let active = true,
+      flight = false;
+    const poll = async () => {
+      if (
+        !active ||
+        flight ||
+        document.hidden ||
+        tab !== "workbench" ||
+        mode !== "arena"
+      )
+        return;
+      flight = true;
+      try {
+        const old = previewRef.current;
+        const after = Math.max(
+          0,
+          ...Object.entries(old?.history || {})
+            .filter(([k]) => k !== "$signals")
+            .map(([, v]) => v.at(-1)?.time || 0),
+        );
+        const r = await creatorApi.get(
+          `preview/sessions/${previewId}?after=${after}`,
+        );
+        if (active) {
+          setPreviewRow((prev) => mergeCreatorRow(prev, r.row));
+          if (r.status === "running" || r.status === "ready")
+            setNotice((old) =>
+              old.startsWith("Live preview is preparing history.")
+                ? "Live preview ready. Apply saves your code privately."
+                : old,
+            );
+        }
+      } catch (e) {
+        if (active) {
+          setError(e.response?.data?.message || e.message);
+          if (e.response?.status === 404) setPreviewId(null);
+        }
+      } finally {
+        flight = false;
+      }
+    };
+    void poll();
+    const timer = setInterval(poll, 1500);
+    document.addEventListener("visibilitychange", poll);
+    return () => {
+      active = false;
+      clearInterval(timer);
+      document.removeEventListener("visibilitychange", poll);
+    };
+  }, [previewId, tab, mode]);
+  useEffect(
+    () => () => {
+      if (previewId)
+        void creatorApi.delete(`preview/sessions/${previewId}`).catch(() => {});
+    },
+    [previewId],
+  );
+  async function validate() {
+    const r = await creatorApi.validate(source);
+    setDiagnostics(r.diagnostics || []);
+    if (!r.ok) throw Error("Review the highlighted code diagnostics.");
+    setManifest(r.manifest);
+    setParams(r.params);
+    setNotice("Code checked. Ready to test or save privately.");
+    return r;
+  }
+  async function apply() {
+    const r = await creatorApi.save(source, scriptId);
+    setScriptId(r.script.id);
+    setVersionId(r.version.id);
+    setManifest(r.version.manifest);
+    setParams((p) =>
+      Object.fromEntries(
+        Object.entries(defaults(r.version.manifest)).map(([k, v]) => [
+          k,
+          p[k] ?? v,
+        ]),
+      ),
+    );
+    setDiagnostics([]);
+    await refreshLibrary();
+    setNotice(
+      "Saved privately to My creations. Open Indicators to add it to your trading chart or cards.",
+    );
+  }
+  async function testLive() {
+    const checked = await creatorApi.validate(source);
+    if (!checked.ok) {
+      setDiagnostics(checked.diagnostics);
+      throw Error("Review the highlighted code diagnostics.");
+    }
+    const inputs = Object.fromEntries(
+      Object.entries(checked.params).map(([k, v]) => [k, params[k] ?? v]),
+    );
+    setManifest(checked.manifest);
+    setParams(inputs);
+    const r = await creatorApi.post("preview/sessions", {
+      source,
+      params: inputs,
+    });
+    setPreviewRow(null);
+    previewRef.current = null;
+    setPreviewId(r.id);
+    setPreviewSource(source);
+    setShowCard(true);
+    setShowPlots(true);
+    setNotice(
+      "Live preview is preparing history. Your trading screen is unchanged.",
+    );
+  }
+  async function stopPreview() {
+    if (previewId) await creatorApi.delete(`preview/sessions/${previewId}`);
+    setPreviewId(null);
+    setPreviewRow(null);
+    previewRef.current = null;
+  }
+  const previewRows = previewRow ? [{ ...previewRow, chart: showPlots }] : [];
+  function changeMode(value) {
+    setMode(value);
+    setDatasetId(
+      value === "arena"
+        ? "arena-live"
+        : datasets.find((d) => d.mode === "binary")?.id || "",
+    );
+    setBinaryHistory(null);
+  }
+  return (
+    <div className="cr-studio cr-studio-v3" data-mode={mode}>
+      <header className="cr-v3-header">
+        <a className="cr-brand" href="/" target="_blank" rel="noopener">
+          <span>TT</span>
+          <strong>
+            TickTrade <em>Studio</em>
+          </strong>
+        </a>
+        <nav aria-label="Studio sections">
+          {[
+            ["workbench", "Create"],
+            ["data", "DataBank"],
+            ["research", "Research"],
+            ["market", "Publish & market"],
+            ["experts", "Experts"],
+          ].map(([id, label]) => (
+            <button
+              key={id}
+              className={tab === id ? "active" : ""}
+              onClick={() => setTab(id)}
+            >
+              {label}
+            </button>
+          ))}
+        </nav>
+        <div className="cr-v3-header-actions">
+          <a
+            className="cr-button"
+            href="/indicators"
+            target="_blank"
+            rel="noopener"
+          >
+            Indicators <ExternalLink size={13} />
+          </a>
+          <div className="cr-mode-switch">
+            <button
+              className={mode === "arena" ? "active" : ""}
+              onClick={() => changeMode("arena")}
+            >
+              Arena
+            </button>
+            <button
+              className={mode === "binary" ? "active" : ""}
+              onClick={() => changeMode("binary")}
+            >
+              Binary
+            </button>
+          </div>
+        </div>
+      </header>
+      <div className="cr-v3-status" aria-live="polite">
+        {busy || notice || "Your ideas. Your code. Your market."}
+      </div>
+      <ErrorBox error={error} />
+      {error && !catalog && !busy && (
+        <div className="cr-row-actions">
+          <button className="cr-button" onClick={() => setOpenRevision((n) => n + 1)}>
+            Reconnect Studio
+          </button>
+        </div>
+      )}
+      {tab === "workbench" && (
+        <>
+          <div className="cr-workspace-bar">
+            <div>
+              <span className="cr-eyebrow">
+                {mode === "arena"
+                  ? "ARENA · 5-MINUTE ROUNDS"
+                  : "BINARY · HISTORICAL RESEARCH"}
+              </span>
+              <h1>{manifest?.name || "Untitled creation"}</h1>
+            </div>
+            <div className="cr-row-actions">
+              <button
+                className="cr-button"
+                onClick={() => setDialog("library")}
+              >
+                <Library size={15} /> My code
+              </button>
+              <button
+                className="cr-button"
+                onClick={() => setDialog("templates")}
+              >
+                <LayoutTemplate size={15} /> Starters
+              </button>
+              <button
+                className="cr-button"
+                onClick={() => setDialog("settings")}
+              >
+                <SlidersHorizontal size={15} /> Settings
+              </button>
+              <button
+                className="cr-button"
+                onClick={() => setDialog("authoring")}
+              >
+                <Sparkles size={15} /> Build assistant
+              </button>
+            </div>
+          </div>
+          <main
+            className="cr-creation-grid"
+            style={{ "--editor-share": `${editorShare}%` }}
+          >
+            <section className="cr-editor-panel">
+              <div className="cr-editor-toolbar">
+                <span>
+                  <Braces size={15} /> TickScript · TypeScript
+                </span>
+                <div className="cr-row-actions">
+                  <button
+                    className="cr-button"
+                    onClick={() => {
+                      setPasteSource("");
+                      setDialog("paste");
+                    }}
+                  >
+                    Paste code
+                  </button>
+                  <button
+                    className="cr-button"
+                    disabled={!!busy || !source}
+                    onClick={() => task("Checking code", validate)}
+                  >
+                    <Check size={14} /> Check
+                  </button>
+                  <button
+                    className="cr-button primary"
+                    disabled={!!busy || !source}
+                    onClick={() => task("Saving privately", apply)}
+                  >
+                    <Save size={14} /> Apply · save privately
+                  </button>
+                </div>
+              </div>
+              <Suspense
+                fallback={<div className="cr-empty">Opening code editor…</div>}
+              >
+                {catalog && (
+                  <CodeEditor
+                    value={source}
+                    onChange={setSource}
+                    sdk={catalog.sdk}
+                    diagnostics={diagnostics}
+                    mode={mode}
+                  />
+                )}
+              </Suspense>
+              <div className="cr-editor-footer">
+                <span>
+                  {versionId
+                    ? "Private copy saved · Apply to save edits"
+                    : "Draft · only visible to you"}
+                </span>
+                <button
+                  className="cr-text-button"
+                  onClick={() =>
+                    downloadFile("ticktrade-script.ts", source, "text/plain")
+                  }
+                >
+                  <Download size={12} /> Export code
+                </button>
+              </div>
+              {diagnostics.length > 0 && (
+                <div className="cr-diagnostics">
+                  {diagnostics.map((d, i) => (
+                    <p key={i}>
+                      Line {d.line || 1}: {d.message}
+                    </p>
+                  ))}
+                </div>
+              )}
+            </section>
+            <section className="cr-live-workspace">
+              <div className="cr-editor-toolbar">
+                <div>
+                  <strong>
+                    {mode === "arena" ? "Live Arena" : "Binary research"}
+                  </strong>
+                  <small>
+                    {mode === "arena"
+                      ? "The same chart stream as your trading screen"
+                      : "Select an imported dataset in Settings"}
+                  </small>
+                </div>
+                {mode === "arena" && (
+                  <div className="cr-row-actions">
+                    {previewId && (
+                      <button
+                        className="cr-icon-button"
+                        aria-label="Stop live preview"
+                        onClick={() => task("Stopping preview", stopPreview)}
+                      >
+                        <Square size={14} />
+                      </button>
+                    )}
+                    <button
+                      className="cr-button"
+                      disabled={!!busy || !source}
+                      onClick={() => task("Preparing preview", testLive)}
+                    >
+                      <Play size={14} />
+                      {previewId ? "Restart test" : "Test live"}
+                    </button>
+                  </div>
+                )}
+              </div>
+              {mode === "arena" ? (
+                <RunningLineChart
+                  studio
+                  indicatorRows={previewRows}
+                  onRemoveIndicator={() => setShowPlots(false)}
+                  priceHeight={chartHeight}
+                  paneHeight={paneHeight}
