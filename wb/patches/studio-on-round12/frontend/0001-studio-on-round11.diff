+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createIdentitySnapshot } from '../src/creator/identitySnapshot.mjs';
+const installations=Object.freeze([]),empty=Object.freeze({installations,error:'',receivedAt:0,feedState:'idle'});
+test('a new identity cannot read old cached rows or script source before an effect runs',()=>{
+ let identity='first';const guard=createIdentitySnapshot(()=>identity,empty);
+ const prior={sessionIdentity:'first',installations:[{id:'private',source:'secret source'}],receivedAt:10};
+ assert.equal(guard(prior),prior);identity='second';
+ const hidden=guard(prior);assert.equal(hidden.installations,installations);assert.equal(hidden.receivedAt,0);assert.ok(!JSON.stringify(hidden).includes('secret source'));
+ assert.equal(guard(prior),hidden,'Repeated useSyncExternalStore reads must return the same empty object');
+ identity=null;const loggedOut=guard(prior);assert.equal(guard(prior),loggedOut);assert.equal(loggedOut.installations,installations);
+});
+test('valid same-session data remains reference-stable and an old completion stays hidden',()=>{
+ let identity='second';const guard=createIdentitySnapshot(()=>identity,empty);
+ const current={sessionIdentity:'second',installations:[{id:'current'}]};
+ assert.equal(guard(current),current);assert.equal(guard(current),current);
+ assert.equal(guard({sessionIdentity:'first',installations:[{id:'stale result'}]}).installations,installations);
+ assert.equal(guard(current),current);
+});
