diff --git a/test/feed-coordinator.test.mjs b/test/feed-coordinator.test.mjs
new file mode 100644
index 0000000..dce6de1
--- /dev/null
+++ b/test/feed-coordinator.test.mjs
@@ -0,0 +1,124 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createFeedCoordinator } from "../src/creator/feedCoordinator.mjs";
+const deferred = () => {
+  let resolve, reject;
+  const promise = new Promise((a, b) => {
+    resolve = a;
+    reject = b;
+  });
+  return { promise, resolve, reject };
+};
+const flush = () => new Promise((resolve) => setImmediate(resolve));
+test("simultaneous mutation refreshes make one request and one post-mutation read", async () => {
+  const pending = [],
+    seen = [];
+  const queue = createFeedCoordinator({
+    getIdentity: () => "user",
+    onReset: () => {},
+    onData: (r) => seen.push(r),
+    onError: assert.fail,
+    request: () => {
+      const p = deferred();
+      pending.push(p);
+      return p.promise;
+    },
+  });
+  const first = queue.refresh();
+  await flush();
+  assert.equal(pending.length, 1);
+  const a = queue.refresh(),
+    b = queue.refresh(),
+    c = queue.refresh({ afterCurrent: false });
+  assert.equal(first, a);
+  assert.equal(a, b);
+  assert.equal(b, c);
+  pending[0].resolve("before mutation");
+  await flush();
+  assert.equal(pending.length, 2);
+  pending[1].resolve("after mutation");
+  await first;
+  assert.deepEqual(seen, ["before mutation", "after mutation"]);
+  assert.equal(queue.pending, false);
+});
+test("an old account response cannot overwrite a new session or block its request", async () => {
+  let who = "old";
+  const pending = [],
+    seen = [];
+  let resets = 0;
+  const q = createFeedCoordinator({
+    getIdentity: () => who,
+    onReset: () => resets++,
+    onData: (r) => seen.push(r),
+    onError: assert.fail,
+    request: (signal) => {
+      const p = deferred();
+      pending.push({ ...p, signal });
+      return p.promise;
+    },
+  });
+  const old = q.refresh();
+  await flush();
+  who = "new";
+  const current = q.refresh();
+  await flush();
+  assert.equal(pending.length, 2);
+  assert.equal(pending[0].signal.aborted, true);
+  pending[1].resolve("new data");
+  await current;
+  pending[0].resolve("old data");
+  await old;
+  assert.deepEqual(seen, ["new data"]);
+  assert.equal(resets, 2);
+});
+test("timeouts recover on next request and stopping a consumer suppresses late results", async () => {
+  const pending = [],
+    seen = [],
+    errors = [];
+  const q = createFeedCoordinator({
+    getIdentity: () => "user",
+    onReset: () => {},
+    onData: (r) => seen.push(r),
+    onError: (e) => errors.push(e.message),
+    request: () => {
+      const p = deferred();
+      pending.push(p);
+      return p.promise;
+    },
+  });
+  const first = q.refresh();
+  await flush();
+  pending[0].reject(Error("timeout"));
+  await first;
+  const recovered = q.refresh();
+  await flush();
+  pending[1].resolve("recovered");
+  await recovered;
+  const stopped = q.refresh();
+  await flush();
+  q.stop();
+  pending[2].resolve("late");
+  await stopped;
+  assert.deepEqual(errors, ["timeout"]);
+  assert.deepEqual(seen, ["recovered"]);
+  assert.equal(q.pending, false);
+});
+test("logout drops queued old-account work without publishing its result", async () => {
+  let who = "user";
+  const p = deferred(),
+    seen = [];
+  const q = createFeedCoordinator({
+    getIdentity: () => who,
+    onReset: () => {},
+    onData: (r) => seen.push(r),
+    onError: assert.fail,
+    request: () => p.promise,
+  });
+  const old = q.refresh();
+  await flush();
+  who = null;
+  await q.refresh();
+  p.resolve("private");
+  await old;
+  assert.deepEqual(seen, []);
+});
