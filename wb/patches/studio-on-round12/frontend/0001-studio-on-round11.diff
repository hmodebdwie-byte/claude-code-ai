diff --git a/src/creator/chartHost.js b/src/creator/chartHost.js
new file mode 100644
index 0000000..14f376f
--- /dev/null
+++ b/src/creator/chartHost.js
@@ -0,0 +1,338 @@
+import { writeSeries } from "./seriesData";
+/** Owns Creator series only. Installations persist across round transitions. */
+export function createIndicatorChartHost(
+  chart,
+  LWC,
+  priceSeries,
+  options = {},
+) {
+  let disposed = false,
+    signature = "",
+    rows = [],
+    series = new Map(),
+    paneGroups = new Map();
+  const heights = new Map(),
+    writes = new Map(),
+    colors = new Map(),
+    normalized = new Map();
+  let legendFrame = null,
+    legendSignature = "",
+    markerSignature = "",
+    boundsFrame = null,
+    nativeBounds = null;
+  const markers =
+    priceSeries && LWC.createSeriesMarkers
+      ? LWC.createSeriesMarkers(priceSeries, [], { autoScale: false })
+      : null;
+  const finite = (v) => typeof v === "number" && Number.isFinite(v);
+  function readNativeBounds() {
+    if (!options.nativeTimeBounds) return null;
+    // Binary searches in the native series avoid mapping its entire history on
+    // each animated price update. Creator plots never own the time domain.
+    const first = priceSeries?.dataByIndex?.(
+      -Number.MAX_SAFE_INTEGER,
+      LWC.MismatchDirection?.NearestRight ?? 1,
+    );
+    const last = priceSeries?.dataByIndex?.(
+      Number.MAX_SAFE_INTEGER,
+      LWC.MismatchDirection?.NearestLeft ?? -1,
+    );
+    return finite(first?.time) && finite(last?.time)
+      ? { from: first.time, to: last.time }
+      : { from: null, to: null };
+  }
+  const boundsKey = (bounds) =>
+    bounds ? `${bounds.from ?? "empty"}:${bounds.to ?? "empty"}` : "all";
+  const inNativeBounds = (time) =>
+    !options.nativeTimeBounds ||
+    (finite(nativeBounds?.from) &&
+      finite(nativeBounds?.to) &&
+      time >= nativeBounds.from &&
+      time <= nativeBounds.to);
+  function nativeChanged() {
+    if (disposed) return;
+    const next = readNativeBounds();
+    if (boundsKey(next) === boundsKey(nativeBounds)) return;
+    nativeBounds = next;
+    if (boundsFrame !== null) return;
+    boundsFrame = requestAnimationFrame(() => {
+      boundsFrame = null;
+      if (!disposed) host.update(rows);
+    });
+  }
+  function clear() {
+    for (const [key, s] of series) {
+      try {
+        if (s.getPane().paneIndex() > 0)
+          heights.set(paneGroups.get(key), s.getPane().getHeight());
+      } catch {}
+    }
+    for (const s of series.values()) {
+      try {
+        chart.removeSeries(s);
+      } catch {
+        /* parent disposed */
+      }
+    }
+    writes.clear();
+    colors.clear();
+    normalized.clear();
+    series.clear();
+    paneGroups.clear();
+  }
+  function legends(param) {
+    if (!options.onLegend || disposed) return;
+    const groups = new Map();
+    for (const r of rows)
+      for (const p of r.output?.plots || []) {
+        const s = series.get(`${r.id}:${p.id}`);
+        if (!s) continue;
+        const pane = s.getPane(),
+          index = pane.paneIndex();
+        if (!groups.has(index))
+          groups.set(index, {
+            index,
+            top: chart
+              .panes()
+              .slice(0, index)
+              .reduce((a, p) => a + p.getHeight(), 0),
+            height: pane.getHeight(),
+            items: [],
+          });
+        const hit = param?.seriesData?.get(s);
+        const value = param?.time
+          ? (hit?.value ?? hit?.close ?? null)
+          : (normalized.get(`${r.id}:${p.id}`)?.data?.at(-1)?.value ?? null);
+        groups.get(index).items.push({
+          installationId: r.id,
+          id: p.id,
+          label: p.label,
+          color: p.color || "#12d4e8",
+          value,
+          precision: p.precision ?? (p.placement === "overlay" ? 5 : 2),
+          unit: p.unit,
+          status: r.status,
+          error: Boolean(r.error),
+        });
+      }
+    const value = [...groups.values()],
+      next = JSON.stringify(value);
+    if (next !== legendSignature) {
+      legendSignature = next;
+      options.onLegend(value);
+    }
+  }
+  const crosshair = (p) => {
+    cancelAnimationFrame(legendFrame);
+    legendFrame = requestAnimationFrame(() => legends(p));
+  };
+  chart.subscribeCrosshairMove?.(crosshair);
+  const host = {
+    update(nextRows) {
+      if (disposed) return;
+      nativeBounds = readNativeBounds();
+      rows = nextRows.filter(
+        (r) =>
+          r.chart &&
+          !r.version?.script?.disabled &&
+          !r.version?.manifest?.requires?.includes("arena.cohorts@1"),
+      );
+      const next = JSON.stringify(
+        rows.map((r) => [
+          r.id,
+          (r.output?.plots || []).map((p) => [
+            p.id,
+            p.placement,
+            p.precision,
+            p.unit,
+            p.style,
+            p.pane,
+            p.levels,
+            p.scaleMin,
+            p.scaleMax,
+          ]),
+        ]),
+      );
+      if (next !== signature) {
+        clear();
+        signature = next;
+        const panes = new Map();
+        for (const r of rows)
+          for (const p of r.output?.plots || []) {
+            const group = `${r.id}:${p.pane || "main"}:${p.unit || ""}`;
+            let pane = 0;
+            if (p.placement === "pane") {
+              if (!panes.has(group)) panes.set(group, chart.panes().length);
+              pane = panes.get(group);
+            }
+            const style =
+              p.style === "histogram"
+                ? LWC.HistogramSeries
+                : p.style === "area"
+                  ? LWC.AreaSeries
+                  : LWC.LineSeries;
+            const s = chart.addSeries(
+              style,
+              {
+                title: "",
+                lastValueVisible: false,
+                priceLineVisible: false,
+                crosshairMarkerVisible: true,
+                ...(finite(p.scaleMin) &&
+                finite(p.scaleMax) &&
+                p.scaleMin < p.scaleMax
+                  ? {
+                      autoscaleInfoProvider: () => ({
+                        priceRange: {
+                          minValue: p.scaleMin,
+                          maxValue: p.scaleMax,
+                        },
+                      }),
+                    }
+                  : {}),
+                color: p.color || "#12d4e8",
+                lineColor: p.color || "#12d4e8",
+                topColor: `${p.color || "#12d4e8"}22`,
+                bottomColor: `${p.color || "#12d4e8"}00`,
+                lineWidth: 2,
+                lineType: p.style === "step" ? 1 : 0,
+                priceFormat: {
+                  type: "price",
+                  precision: p.precision ?? (p.placement === "overlay" ? 5 : 2),
+                  minMove:
+                    10 ** -(p.precision ?? (p.placement === "overlay" ? 5 : 2)),
+                },
+              },
+              pane,
+            );
+            if (pane > 0) {
+              s.getPane().setHeight(
+                heights.get(group) || options.paneHeight || 150,
+              );
+              s.priceScale().applyOptions({
+                scaleMargins: { top: 0.24, bottom: 0.12 },
+                borderVisible: false,
+              });
+            }
+            series.set(`${r.id}:${p.id}`, s);
+            paneGroups.set(`${r.id}:${p.id}`, group);
+            for (const value of p.levels || [])
+              s.createPriceLine({
+                price: value,
+                color: "#75819466",
+                lineWidth: 1,
+                lineStyle: 2,
+                axisLabelVisible: false,
+                title: "",
+              });
+          }
+        const count = chart.panes().length - 1;
+        options.onLayout?.(count);
+        if (options.priceHeight)
+          chart.panes()[0].setStretchFactor(options.priceHeight);
+        for (const pane of chart.panes().slice(1))
+          pane.setStretchFactor(options.paneHeight || 160);
+      }
+      for (const r of rows)
+        for (const p of r.output?.plots || []) {
+          const s = series.get(`${r.id}:${p.id}`);
+          if (!s) continue;
+          const color = p.color || "#12d4e8",
+            colorKey = `${r.id}:${p.id}`;
+          if (colors.get(colorKey) !== color) {
+            s.applyOptions({
+              color,
+              lineColor: color,
+              topColor: `${color}22`,
+              bottomColor: `${color}00`,
+            });
+            colors.set(colorKey, color);
+          }
+          const key = `${r.id}:${p.id}`;
+          const source = r.history?.[p.id];
+          const cached = normalized.get(key);
+          // Metadata-only feed changes do not rewrite or rescan unchanged histories.
+          if (
+            cached?.source === source &&
+            cached?.epoch === r.cursor?.epoch &&
+            cached?.bounds === boundsKey(nativeBounds)
+          )
+            continue;
+          const unique = new Map(),
+            resolution = options.resolution || 1;
+          for (const point of source || [])
+            if (finite(point.time) && inNativeBounds(point.time)) {
+              const time = Math.floor(point.time / resolution) * resolution;
+              unique.set(
+                time,
+                finite(point.value)
+                  ? {
+                      time,
+                      value: point.value,
+                      ...(point.color ? { color: point.color } : {}),
+                    }
+                  : { time },
+              );
+            }
+          const data = [...unique.values()].sort((a, b) => a.time - b.time);
+          normalized.set(key, {
+            source,
+            epoch: r.cursor?.epoch,
+            bounds: boundsKey(nativeBounds),
+            data,
+          });
+          // Advancing the right edge appends; moving the native left edge or a
+          // round reset replaces displayed points so expired history is removed.
+          const epoch = `${r.cursor?.epoch || JSON.stringify(r.warmupInfo || {})}:${options.nativeTimeBounds ? (nativeBounds?.from ?? "empty") : "all"}`;
+          writes.set(key, writeSeries(s, data, writes.get(key), epoch));
+        }
+      const markerRows = rows
+        .flatMap((r) =>
+          (r.history?.$signals || [])
+            .filter((s) => inNativeBounds(s.time))
+            .map((s) => ({
+              time:
+                Math.floor(s.time / (options.resolution || 1)) *
+                (options.resolution || 1),
+              position: s.side === "BUY" ? "belowBar" : "aboveBar",
+              shape: s.side === "BUY" ? "arrowUp" : "arrowDown",
+              color: s.side === "BUY" ? "#00df9a" : "#ff398d",
+              text: `${s.paper ? "Paper" : "Signal"} ${s.side}`,
+            })),
+        )
+        .sort((a, b) => a.time - b.time)
+        .slice(-100);
+      const nextMarkers = JSON.stringify(markerRows);
+      if (nextMarkers !== markerSignature) {
+        markers?.setMarkers(markerRows);
+        markerSignature = nextMarkers;
+      }
+      legends();
+    },
+    refreshLegends() {
+      legends();
+    },
+    resizePanes(height) {
+      for (const s of series.values())
+        if (s.getPane().paneIndex() > 0) s.getPane().setStretchFactor(height);
+      legends();
+    },
+    dispose() {
+      disposed = true;
+      cancelAnimationFrame(legendFrame);
+      if (boundsFrame !== null) cancelAnimationFrame(boundsFrame);
+      if (options.nativeTimeBounds)
+        priceSeries?.unsubscribeDataChanged?.(nativeChanged);
+      chart.unsubscribeCrosshairMove?.(crosshair);
+      clear();
+      try {
+        markers?.detach();
+      } catch {
+        /* parent disposed */
+      }
+    },
+  };
+  if (options.nativeTimeBounds)
+    priceSeries?.subscribeDataChanged?.(nativeChanged);
+  return host;
+}
