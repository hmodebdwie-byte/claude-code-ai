+        if (listener === fn) listener = null;
+      },
+    };
+    const f = fake(),
+      legends = [];
+    const host = createIndicatorChartHost(f.chart, f.lwc, price, {
+      nativeTimeBounds: true,
+      onLegend: (v) => legends.push(v),
+    });
