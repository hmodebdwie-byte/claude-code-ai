diff --git a/test/card-geometry.test.mjs b/test/card-geometry.test.mjs
new file mode 100644
index 0000000..a52bacd
--- /dev/null
+++ b/test/card-geometry.test.mjs
@@ -0,0 +1,90 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  cardChartGroups,
+  chartGeometry,
+  reduceCardPoints,
+} from "../src/creator/cardGeometry.mjs";
+test("price and distinct units never share an oscillator axis", () => {
+  const plots = [
+    { id: "a", placement: "overlay" },
+    { id: "b", placement: "pane", pane: "ratio", unit: "%" },
+    { id: "c", placement: "pane", pane: "ratio", unit: "%" },
+    { id: "d", placement: "pane", pane: "ratio", unit: "pips" },
+  ];
+  const groups = cardChartGroups(plots);
+  assert.equal(groups.length, 3);
+  assert.equal(groups[1].plots.length, 2);
+  assert.deepEqual(
+    cardChartGroups(plots, ["c"]).map((g) => g.plots.map((p) => p.id)),
+    [["c"]],
+  );
+});
+test("series in the same pane keep their common numeric scale", () => {
+  const g = chartGeometry([{ id: "a" }, { id: "b" }], {
+    a: [
+      { time: 1, value: 10 },
+      { time: 2, value: 12 },
+    ],
+    b: [
+      { time: 1, value: 100 },
+      { time: 2, value: 102 },
+    ],
+  });
+  assert.ok(g.min < 10);
+  assert.ok(g.max > 102);
+  assert.equal(g.series[0].points[0].value, 10);
+});
+test("histograms include zero and empty/null observations do not fabricate zeros", () => {
+  assert.equal(
+    chartGeometry([{ id: "x", style: "histogram" }], {
+      x: [{ time: 1, value: null }],
+    }),
+    null,
+  );
+  const g = chartGeometry([{ id: "x", style: "histogram" }], {
+    x: [
+      { time: 1, value: 100 },
+      { time: 2, value: 101 },
+    ],
+  });
+  assert.ok(g.min <= 0);
+});
+test("large archives preserve peaks, gaps and endpoints within the vertex budget", () => {
+  const points = Array.from({ length: 10000 }, (_, i) => ({
+    time: i,
+    value: i === 2751 ? 999999 : Math.sin(i / 10),
+  }));
+  points[1000].value = null;
+  const small = reduceCardPoints(points);
+  assert.ok(small.length <= 185);
+  assert.equal(small[0].time, 0);
+  assert.equal(small.at(-1).time, 9999);
+  assert.ok(small.some((p) => p.value === 999999));
+  assert.ok(small.some((p) => p.value === null));
+  const g = chartGeometry([{ id: "x", style: "area" }], {
+    x: points.slice(0, 1100),
+  });
+  assert.equal(g.series[0].segments.length, 2);
+});
+test("Arena card displays five minutes, with sorted unique observations and explicit gaps", () => {
+  const g = chartGeometry([{ id: "x" }], {
+    x: [
+      { time: 1, value: 999 },
+      { time: 390, value: 2 },
+      { time: 391, value: 3 },
+      { time: 392, value: 4 },
+      { time: 398, value: 5 },
+      { time: 450, value: 6 },
+      { time: 451, value: 7 },
+      { time: 452, value: 8 },
+      { time: 452, value: 9 },
+      { time: 400, value: 5 },
+    ],
+  });
+  assert.ok(g.start >= 152);
+  assert.ok(g.max < 999);
+  assert.equal(g.series[0].points.at(-1).value, 9);
+  assert.equal(g.series[0].segments.length, 2);
+  assert.ok(g.series[0].points.some((p) => p.value === null));
+});
diff --git a/test/card-pager.test.mjs b/test/card-pager.test.mjs
new file mode 100644
index 0000000..6fac419
--- /dev/null
+++ b/test/card-pager.test.mjs
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { adjacentCardPage, arenaCardPages, creatorCardPageSignature, reconcileCardPage } from '../src/creator/cardPager.mjs';
+const installation = (id, extra = {}) => ({ id, createdAt: new Date(1000 * ({ one: 1, two: 2, three: 3 }[id] || 0)).toISOString(), card: true, version: { manifest: { name: `Card ${id}` } }, ...extra });
+const pagesFor = (rows) => arenaCardPages(creatorCardPageSignature(rows));
+
+test('each installed card is its own page after exactly four native pages', () => {
+  const pages = pagesFor([installation('one'), installation('two'), installation('three')]);
+  assert.deepEqual(pages.map((page) => page.id), ['chat', 'market', 'flow', 'round', 'creator:one', 'creator:two', 'creator:three']);
+  assert.equal(pages[4].label, 'Card one');
+  assert.equal(pages[4].installationId, 'one');
+});
+test('plot-only and disabled installations are not card pages', () => {
+  assert.equal(pagesFor([installation('one', { card: false }), installation('two', { version: { script: { disabled: true } } })]).length, 4);
+});
+test('live output/history updates leave navigation metadata stable', () => {
+  assert.equal(creatorCardPageSignature([installation('one')]), creatorCardPageSignature([installation('one', { history: { plot: [1, 2] }, output: { card: { title: 'Latest output' } } })]));
+});
+test('selection survives refreshing and inserting/reordering earlier pages', () => {
+  const old = pagesFor([installation('one'), installation('two')]);
+  const next = pagesFor([installation('two'), installation('new'), installation('one')]);
+  assert.equal(reconcileCardPage('creator:two', next, old), 'creator:two');
+});
+test('removal picks successor, or preceding page when removing the last', () => {
+  const old = pagesFor([installation('one'), installation('two'), installation('three')]);
+  assert.equal(reconcileCardPage('creator:two', pagesFor([installation('one'), installation('three')]), old), 'creator:three');
+  assert.equal(reconcileCardPage('creator:three', pagesFor([installation('one'), installation('two')]), old), 'creator:two');
+  assert.equal(reconcileCardPage('creator:one', pagesFor([]), pagesFor([installation('one')])), 'round');
+});
+test('one swipe moves one page and clamps at either end', () => {
+  const pages = pagesFor([installation('one'), installation('two')]);
+  assert.equal(adjacentCardPage('round', pages, 1), 'creator:one');
+  assert.equal(adjacentCardPage('creator:one', pages, 1), 'creator:two');
+  assert.equal(adjacentCardPage('creator:two', pages, 1), 'creator:two');
+  assert.equal(adjacentCardPage('creator:one', pages, -1), 'round');
+  assert.equal(adjacentCardPage('chat', pages, -1), 'chat');
+});
+
+test('new cards append by creation time and ties use stable installation IDs', () => {
+  const early = '2026-09-18T10:00:00.000Z', late = '2026-09-18T11:00:00.000Z';
+  const rows = [installation('new', { createdAt: late }), installation('b', { createdAt: early }), installation('a', { createdAt: early })];
+  const before = [...rows];
+  assert.deepEqual(pagesFor(rows).slice(4).map(page => page.installationId), ['a', 'b', 'new']);
+  assert.equal(creatorCardPageSignature(rows), creatorCardPageSignature([...rows].reverse()));
+  assert.deepEqual(rows, before, 'selector must not mutate the store array');
+});
