+export default function ExpertDesk({ rows, capabilities, onCreate }) {
+  const experts = rows.filter((r) => r.version?.manifest?.kind === "expert");
+  const [selected, setSelected] = useState(""),
+    [journal, setJournal] = useState([]),
+    [error, setError] = useState(""),
+    [busy, setBusy] = useState(false),
+    [liveTarget, setLiveTarget] = useState(null),
+    [consent, setConsent] = useState(false),
+    [settings, setSettings] = useState(null);
+  const current = experts.find((r) => r.id === selected) || experts[0];
+  useEffect(() => {
+    let active = true;
+    const poll = async () => {
+      if (!current) return;
+      try {
+        const d = await creatorApi.decisions(current.id);
+        if (active) setJournal(d);
+      } catch (e) {
+        if (active) setError(e.message);
+      }
+    };
+    void poll();
+    const timer = setInterval(poll, 2500);
+    return () => {
+      active = false;
+      clearInterval(timer);
+    };
+  }, [current?.id]);
+  async function task(fn) {
+    setBusy(true);
+    setError("");
+    try {
+      await fn();
+      await refreshCreator();
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <section className="cr-section-page">
+      <div className="cr-page-heading">
