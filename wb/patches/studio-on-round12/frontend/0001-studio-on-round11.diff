+        },
+      },
+    ]);
+    assert.deepEqual(f.all[0].data, [{ time: 300, value: 2 }]);
+    host.dispose();
+    assert.equal(listener, null);
+  } finally {
+    globalThis.requestAnimationFrame = previousRequest;
+    globalThis.cancelAnimationFrame = previousCancel;
+  }
+});
+test("historical research charts keep their full timestamp domain when native bounds are not requested", () => {
+  const f = fake(),
+    host = createIndicatorChartHost(f.chart, f.lwc, {
+      dataByIndex: () => ({ time: 100, value: 1 }),
+    });
+  host.update([
+    {
+      id: "research",
+      chart: true,
+      output: { plots: [{ id: "p", placement: "overlay" }] },
+      history: {
+        p: [
+          { time: 1, value: 1 },
+          { time: 200, value: 2 },
+        ],
+      },
+    },
+  ]);
+  assert.deepEqual(
+    f.all[0].data.map((p) => p.time),
+    [1, 200],
+  );
+});
