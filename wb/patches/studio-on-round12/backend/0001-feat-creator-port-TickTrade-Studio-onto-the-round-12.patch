diff --git a/apps/api/src/creator/creator-research.math.ts b/apps/api/src/creator/creator-research.math.ts
new file mode 100644
index 0000000..3ff7d54
--- /dev/null
+++ b/apps/api/src/creator/creator-research.math.ts
@@ -0,0 +1,177 @@
+/** Time-ordered holdout. Training labels must mature before the test boundary. */
+export function trainPressureModel(
+  frames: any[],
+  horizonSeconds: number,
+  trainFraction = 0.7,
+) {
+  if (frames.length < 100)
+    throw Error('At least 100 observed frames are needed');
+  const split = frames[Math.floor(frames.length * trainFraction)].time;
+  const samples: any[] = [];
+  let j = 0;
+  for (let i = 0; i < frames.length; i++) {
+    const f = frames[i];
+    j = Math.max(j, i + 1);
+    while (j < frames.length && frames[j].time < f.time + horizonSeconds * 1000)
+      j++;
+    if (j >= frames.length) break;
+    const next = frames[j];
+    if (
+      next.roundId !== f.roundId ||
+      next.time - f.time > horizonSeconds * 1500
+    )
+      continue;
+    const x = f.data.liquidity?.imbalance;
+    if (typeof x !== 'number') continue;
+    const delta = next.data.market.price - f.data.market.price;
+    if (delta === 0) continue;
+    samples.push({
+      time: f.time,
+      labelTime: next.time,
+      x,
+      y: delta > 0 ? 1 : 0,
+      roundId: f.roundId,
+    });
+  }
+  const train = samples.filter((s) => s.labelTime < split),
+    test = samples.filter((s) => s.time >= split);
+  if (train.length < 50 || test.length < 30)
+    throw Error(
+      'Insufficient matured training/holdout labels; record more history',
+    );
+  const bins = Array.from({ length: 10 }, (_, i) => ({
+    from: -1 + i * 0.2,
+    to: -0.8 + i * 0.2,
+    n: 0,
+    wins: 0,
+    probability: 0.5,
+  }));
+  for (const s of train) {
+    const b = bins[Math.max(0, Math.min(9, Math.floor((s.x + 1) * 5)))];
+    b.n++;
+    b.wins += s.y;
+  }
+  for (const b of bins) b.probability = (b.wins + 5) / (b.n + 10);
+  const prior = (train.reduce((a, s) => a + s.y, 0) + 5) / (train.length + 10);
+  const calibration = Array.from({ length: 10 }, (_, i) => ({
+    from: i / 10,
+    to: (i + 1) / 10,
+    n: 0,
+    predictedSum: 0,
+    wins: 0,
+  }));
+  let brier = 0,
+    baseline = 0,
+    logLoss = 0;
+  for (const s of test) {
+    const p =
+      bins[Math.max(0, Math.min(9, Math.floor((s.x + 1) * 5)))].probability;
+    brier += (p - s.y) ** 2;
+    baseline += (prior - s.y) ** 2;
+    logLoss -= s.y * Math.log(p) + (1 - s.y) * Math.log(1 - p);
+    const c = calibration[Math.min(9, Math.floor(p * 10))];
+    c.n++;
+    c.predictedSum += p;
+    c.wins += s.y;
+  }
+  const rounds = new Set(test.map((s) => s.roundId)).size;
+  return {
+    artifact: {
+      type: 'empirical-pressure-bins-v1',
+      horizonSeconds,
+      bins,
+      prior,
+    },
+    metrics: {
+      target:
+        'Observed upward price movement within the same round; unchanged prices excluded',
+      trainingSamples: train.length,
+      holdoutSamples: test.length,
+      holdoutRounds: rounds,
+      splitTime: new Date(split).toISOString(),
+      brier: brier / test.length,
+      baselineBrier: baseline / test.length,
+      logLoss: logLoss / test.length,
+      calibration: calibration.map((c) => ({
+        ...c,
+        predicted: c.n ? c.predictedSum / c.n : null,
+        observed: c.n ? c.wins / c.n : null,
+      })),
+      eligibleForShadow: rounds >= 10 && test.length >= 500 && brier < baseline,
+      limitations: [
+        'Overlapping labels are dependent; sample count is not effective independent sample size.',
+        'Price-direction labels do not measure profitability or required reversal capital.',
+        'Research result; no live order permission or production probability is granted.',
+      ],
+    },
+  };
+}
+
+export function signalResearch(
+  frames: any[],
+  outputs: any[],
+  horizonSeconds: number,
+) {
+  const signals: any[] = [];
+  let cursor = 0;
+  for (const o of outputs) {
+    for (const s of o.output?.signals || []) {
+      while (cursor < frames.length && frames[cursor].time < o.time) cursor++;
+      const entry = frames[cursor];
+      if (!entry || entry.time !== o.time) continue;
+      let j = cursor + 1;
+      while (
+        j < frames.length &&
+        frames[j].time < o.time + horizonSeconds * 1000
+      )
+        j++;
+      const exit = frames[j],
+        matured =
+          !!exit &&
+          exit.roundId === o.roundId &&
+          exit.time - o.time <= horizonSeconds * 1500;
+      const change = matured
+        ? (exit.data.market.price - entry.data.market.price) *
+          (s.side === 'BUY' ? 1 : -1)
+        : null;
+      signals.push({
+        time: o.time,
+        roundId: o.roundId,
+        side: s.side,
+        amount: s.amount,
+        reason: s.reason,
+        entry: entry.data.market.price,
+        horizonPrice: matured ? exit.data.market.price : null,
+        directionalPips: change === null ? null : change / 0.0001,
+        matured,
+      });
+    }
+  }
+  const valid = signals.filter((s) => s.matured),
+    wins = valid.filter((s) => s.directionalPips > 0).length;
+  const n = valid.length,
+    z = 1.96,
+    p = n ? wins / n : 0,
+    den = 1 + (z * z) / (n || 1),
+    center = (p + (z * z) / (2 * (n || 1))) / den,
+    half =
+      (z * Math.sqrt((p * (1 - p) + (z * z) / (4 * (n || 1))) / (n || 1))) /
+      den;
+  return {
+    signals: signals.slice(-5000),
+    metrics: {
+      signals: signals.length,
+      matured: n,
+      positiveMarkoutRate: n ? p : null,
+      wilson95: n
+        ? [Math.max(0, center - half), Math.min(1, center + half)]
+        : null,
+      meanDirectionalPips: n
+        ? valid.reduce((a, s) => a + s.directionalPips, 0) / n
+        : null,
+      profit: null,
+      model: 'signal-markout',
+      note: 'Observed price markouts, not simulated Arena cash returns. Historical trades would alter the shared market and settlement.',
+    },
+  };
+}
