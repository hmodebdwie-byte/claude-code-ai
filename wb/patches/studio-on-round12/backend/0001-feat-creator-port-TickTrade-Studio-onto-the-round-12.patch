+    "shrinkageWeight": "rounds / (rounds + 48) * 100",
+    "skillLift": "bayesianWinReliability - 50",
+    "confidenceAdjustedSkill": "clamp(50 + skillLift * evidenceGradeScore / 100, 0, 100)",
+    "persistenceProbability": "clamp(profile.persistence * 100 * 0.35 + stabilityProbability * 0.32 + (100 - Math.abs(recentVsLongZ) * 18) * 0.18 + experienceDepth * 0.15, 0, 100)",
+    "luckSensitivity": "clamp((winInterval.upper - winInterval.lower) * 2.1 + Math.abs(recentVsLongZ) * 12 + (100 - experienceDepth) * 0.22, 0, 100)",
+    "regimeAdjustedSkill": "clamp(confidenceAdjustedSkill * 0.56 + currentRegimeFit * 0.24 + regimeRobustness * 0.20, 0, 100)",
+    "expectedSkillDecay": "clamp(Math.abs(formDelta) * 1.7 + luckSensitivity * 0.38 + (100 - persistenceProbability) * 0.22, 0, 100)",
+    "outOfSampleReadiness": "clamp(experienceDepth * 0.26 + evidenceGradeScore * 0.28 + stabilityProbability * 0.20 + regimeRobustness * 0.14 + (100 - luckSensitivity) * 0.12, 0, 100)",
+    "validationStatus": "outOfSampleReadiness >= 76 ? \"WALK-FORWARD CANDIDATE\" : outOfSampleReadiness >= 52 ? \"HOLDOUT REQUIRED\" : \"INSUFFICIENT SAMPLE\"",
+    "flowToxicityProxy": "clamp(adverseMarkoutRate3 * 0.30 + adverseSelection * 10 + Math.abs(impactAnomalyZ) * 7 + surveillanceSeverity * 0.22, 0, 100)",
+    "liquidityConsumption": "clamp(liquidityDemandBps * 7, 0, 100)",
+    "absorptionEfficiency": "clamp(defenseResponseScore * 0.35 + rescueResponseScore * 0.20 + clamp(50 + responseRetention * 0.25, 0, 100) * 0.25 + executionDiscipline * 0.20, 0, 100)",
+    "marketResilience": "clamp(impactDecayScore * 0.42 + absorptionEfficiency * 0.38 + (100 - flowToxicityProxy) * 0.20, 0, 100)",
+    "markoutConvexity": "meanMarkout5 - meanMarkout1",
+    "arrivalIntensity": "clamp(ordersPerMinute * 8, 0, 100)",
+    "flowPurity": "sideLoyalty",
+    "microstructureEdge": "clamp(executionQualityScore * 0.34 + absorptionEfficiency * 0.20 + impactConsistency * 0.18 + (100 - flowToxicityProxy) * 0.16 + followThroughScore * 0.12, 0, 100)",
