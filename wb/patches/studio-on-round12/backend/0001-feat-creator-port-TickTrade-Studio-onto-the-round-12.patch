diff --git a/apps/api/src/creator/creator.service.ts b/apps/api/src/creator/creator.service.ts
new file mode 100644
index 0000000..503a44b
--- /dev/null
+++ b/apps/api/src/creator/creator.service.ts
@@ -0,0 +1,1553 @@
+import { BANK_METRICS } from './creator-bank.catalog';
+import {
+  BadRequestException,
+  ConflictException,
+  Injectable,
+  Logger,
+  NotFoundException,
+  ServiceUnavailableException,
+  OnModuleDestroy,
+  OnModuleInit,
+} from '@nestjs/common';
+import { Prisma } from '@prisma/client';
+import {
+  FEATURES,
+  LIMITS,
+  parametersFor,
+  ScriptPool,
+} from '@ticktrade/tickscript';
+import { PrismaService } from '../prisma/prisma.service';
+import { CreatorDataService } from './creator-data.service';
+import {
+  InstallScriptDto,
+  ConfigureInstallationDto,
+  SaveScriptDto,
+  UpdateInstallationDto,
+  ValidateScriptDto,
+} from './creator.dto';
+import { CreatorHistoryService } from './creator-history.service';
+import { CreatorAccessService } from './creator-access.service';
+import { CreatorExpertService } from './creator-expert.service';
+import { appendPlotHistory } from './creator-history.math';
+import { CREATOR_EXAMPLES } from './examples';
+import { readFileSync } from 'node:fs';
+import { createHash, randomUUID } from 'node:crypto';
+import { dirname, join } from 'node:path';
+
+@Injectable()
+export class CreatorService implements OnModuleInit, OnModuleDestroy {
+  private readonly pool = new ScriptPool({ timeoutMs: 15000 });
+  private readonly validationPool = new ScriptPool({
+    timeoutMs: 15000,
+    maxQueued: 8,
+  });
+  private readonly historyPool = new ScriptPool({
+    timeoutMs: 30000,
+    maxQueued: 8,
+  });
+  private warming = new Set<string>();
+  private retryAfter = new Map<string, number>();
+  private readonly previewPool = new ScriptPool({
+    timeoutMs: 30000,
+    maxQueued: 8,
+  });
+  private previews = new Map<string, any>();
+  private readonly logger = new Logger(CreatorService.name);
+  private timer?: ReturnType<typeof setInterval>;
+  private ticking = false;
+  private recoveryComplete = false;
+  private recoveryRetryAt = 0;
+  private liveCache = new Map<
+    string,
+    { until: number; promise: Promise<any> }
+  >();
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly data: CreatorDataService,
+    private readonly historyData: CreatorHistoryService,
+    private readonly access: CreatorAccessService,
+    private readonly experts: CreatorExpertService,
+  ) {}
+  onModuleInit() {
+    if (process.env.CREATOR_SCHEDULER_ENABLED !== 'false') {
+      this.timer = setInterval(() => void this.tick(), 1500);
+      this.timer.unref();
+    }
+  }
+  onModuleDestroy() {
+    if (this.timer) clearInterval(this.timer);
+    this.pool.close();
+    this.validationPool.close();
+    this.historyPool.close();
+    this.previewPool.close();
+    this.previews.clear();
+  }
+  catalog() {
+    return {
+      sdkVersion: '1',
+      bankMetrics: BANK_METRICS,
+      features: FEATURES,
+      limits: LIMITS,
+      examples: CREATOR_EXAMPLES,
+      liveExecution: process.env.CREATOR_LIVE_TRADING_ENABLED === 'true',
+      history: true,
+      binary: 'design-and-historical-research',
+      sdk: readFileSync(
+        join(dirname(require.resolve('@ticktrade/tickscript')), 'sdk.d.ts'),
+        'utf8',
+      ),
+    };
+  }
+  async validate(dto: ValidateScriptDto) {
+    if (Buffer.byteLength(dto.source) > LIMITS.sourceBytes)
+      throw new BadRequestException('Source exceeds 64 KB');
+    try {
+      return await this.validationPool.execute({
+        source: dto.source,
+        params: dto.params,
+        inspect: true,
+      });
+    } catch (e) {
+      throw new ServiceUnavailableException((e as Error).message);
+    }
+  }
+  async preview(dto: ValidateScriptDto) {
+    const inspected = await this.validate(dto);
+    if (!inspected.ok) return inspected;
+    const frame = await this.liveFrame(
+      Number(inspected.params?.windowSeconds || 30),
+      inspected.manifest.requires,
+    );
+    if (!frame)
+      return {
+        ...inspected,
+        frame: null,
+        message: 'Waiting for an active Arena round',
+      };
+    const result = await this.pool.execute({
+      source: dto.source,
+      params: inspected.params,
+      frame,
+      state: {},
+    });
+    return { ...result, frame, previewOnly: true };
+  }
+  async startPreview(ownerId: number, dto: ValidateScriptDto) {
+    const result = await this.validate(dto);
+    if (!result.ok)
+      throw new BadRequestException({
+        message: 'Script validation failed',
+        diagnostics: result.diagnostics,
+      });
+    if (!result.manifest.modes.includes('arena'))
+      throw new BadRequestException(
+        'Use historical research for Binary scripts',
+      );
+    for (const [id, v] of this.previews)
+      if (v.ownerId === ownerId || v.expires < Date.now())
+        this.previews.delete(id);
+    if (this.previews.size >= 16)
+      throw new ServiceUnavailableException(
+        'Live preview capacity is busy. Try again shortly.',
+      );
+    const id = randomUUID(),
+      session: any = {
+        id,
+        ownerId,
+        source: dto.source,
+        params: result.params,
+        manifest: result.manifest,
+        state: {},
+        history: {},
+        output: {},
+        status: 'warming',
+        expires: Date.now() + 900000,
+        roundId: null,
+        sequence: null,
+        busy: true,
+      };
+    this.previews.set(id, session);
+    void this.warmPreview(session);
+    return { id, status: session.status };
+  }
+  private async warmPreview(s: any) {
+    try {
+      s.state = {};
+      s.history = {};
+      s.output = {};
+      s.roundId = null;
+      s.sequence = null;
+      s.calculated = 0;
+      const limit = Math.min(5000, Math.max(0, s.manifest.warmupBars ?? 600));
+      const data = await this.historyData.frames('arena-live', {
+        windowSeconds: Number(s.params.windowSeconds || 30),
+        pointLimit: Math.min(50000, Math.max(5000, limit * 10)),
+        frameLimit: limit || 1,
+        requires: s.manifest.requires,
+        omitCoverage: true,
+      });
+      const frames = limit ? data.frames : [];
+      for (let i = 0; i < frames.length; i += 50) {
+        if (!this.previews.has(s.id)) return;
+        const r = await this.previewPool.execute({
+          source: s.source,
+          params: s.params,
+          frames: frames.slice(i, i + 50),
+          state: s.state,
+          previousRoundId: s.roundId,
+        });
+        if (!r.ok) {
+          const error = Error(r.diagnostics.map((d) => d.message).join('; '));
+          (error as any).scriptFailure = true;
+          throw error;
+        }
+        s.state = r.state;
+        s.roundId = r.lastRound;
+        s.history = appendPlotHistory(s.history, r.outputs!, 3000);
+        const last = r.outputs!.filter((o) => o.output).at(-1);
+        if (last) {
+          s.output = { ...last.output, time: last.time };
+          s.sequence = last.sequence;
+        }
+        s.calculated = Math.min(i + 50, frames.length);
+      }
+      s.status = 'ready';
+      s.error = null;
+      s.warmupRetryAt = null;
+    } catch (e) {
+      s.status = (e as any).scriptFailure ? 'error' : 'warming';
+      s.error = (e as any).scriptFailure
+        ? (e as Error).message.slice(0, 500)
+        : 'History preparation temporarily unavailable; retrying automatically';
+      s.warmupRetryAt = (e as any).scriptFailure ? null : Date.now() + 3000;
+    } finally {
+      s.busy = false;
+    }
+  }
+  async readPreview(ownerId: number, id: string, after = 0) {
+    const s = this.previews.get(id);
+    if (!s || s.ownerId !== ownerId || s.expires < Date.now())
+      throw new NotFoundException('Preview expired. Start live testing again.');
+    s.expires = Date.now() + 900000;
+    if (!s.busy && s.warmupRetryAt && s.warmupRetryAt <= Date.now()) {
+      s.busy = true;
+      void this.warmPreview(s);
+    }
+    if (!s.busy && !s.warmupRetryAt && s.status !== 'error') {
+      s.busy = true;
+      try {
+        const frame = await this.liveFrame(
+          Number(s.params.windowSeconds || 30),
+          s.manifest.requires,
+        );
+        if (
+          frame?.fresh &&
+          s.sequence !== frame.sequence &&
+          (!s.output.time || frame.time > s.output.time)
+        ) {
+          const r = await this.previewPool.execute({
+            source: s.source,
+            params: s.params,
+            frame,
+            state: s.state,
+            previousRoundId: s.roundId,
+          });
+          if (!r.ok)
+            throw Error(r.diagnostics.map((d) => d.message).join('; '));
+          s.state = r.output.state;
+          s.roundId = frame.roundId;
+          s.sequence = frame.sequence;
+          s.history = appendPlotHistory(
+            s.history,
+            [{ time: frame.time, roundId: frame.roundId, output: r.output }],
+            3000,
+          );
+          s.output = { ...r.output, time: frame.time };
+          s.status = 'running';
+          s.error = null;
+        }
+      } catch (e) {
+        s.error = (e as Error).message.slice(0, 500);
+      } finally {
+        s.busy = false;
+      }
+    }
+    const { state, ...output } = s.output;
+    const history = Object.fromEntries(
+      Object.entries(s.history).map(([k, v]) => [
+        k,
+        (v as any[]).filter((p) => !after || p.time >= after),
+      ]),
+    );
+    return {
+      id,
+      status: s.status,
+      calculated: s.calculated || 0,
+      error: s.error || null,
+      row: {
+        id: 'preview-' + id,
+        chart: true,
+        card: true,
+        output,
+        history,
+        historyTail: after > 0,
+        version: { manifest: s.manifest },
+        status: s.status,
+        error: s.error || null,
+      },
+      previewOnly: true,
+    };
+  }
+  stopPreview(ownerId: number, id: string) {
+    if (this.previews.get(id)?.ownerId === ownerId) this.previews.delete(id);
+    return { stopped: true };
+  }
+  async useTemplate(ownerId: number, id: string) {
+    const example = CREATOR_EXAMPLES.find((e) => e.id === id);
+    if (!example) throw new NotFoundException('Template not found');
+    const previous = await this.prisma.creatorVersion.findFirst({
+      where: { source: example.source, script: { ownerId, disabled: false } },
+      include: { script: true },
+    });
+    if (previous) return { script: previous.script, version: previous };
+    return this.save(ownerId, { source: example.source });
+  }
+  async save(ownerId: number, dto: SaveScriptDto) {
+    const result = await this.validate(dto);
+    if (!result.ok)
+      throw new BadRequestException({
+        message: 'Script validation failed',
+        diagnostics: result.diagnostics,
+      });
+    return this.prisma.$transaction(async (tx) => {
+      await tx.$queryRaw`SELECT pg_advisory_xact_lock(76231, ${ownerId}::int)::text`;
+      let script = dto.scriptId
+        ? await tx.creatorScript.findFirst({
+            where: { id: dto.scriptId, ownerId },
+          })
+        : null;
+      if (dto.scriptId && !script)
+        throw new NotFoundException('Private script not found');
+      if (script?.disabled)
+        throw new ConflictException(
+          'This script is disabled by an administrator',
+        );
+      if (!script) {
+        if ((await tx.creatorScript.count({ where: { ownerId } })) >= 50)
+          throw new BadRequestException(
+            'The private library limit is 50 scripts',
+          );
+        script = await tx.creatorScript.create({
+          data: { ownerId, name: result.manifest.name },
+        });
+      }
+      const same = await tx.creatorVersion.findFirst({
+        where: { scriptId: script.id, hash: result.hash! },
+      });
+      if (same) return { script, version: same };
+      const count = await tx.creatorVersion.count({
+        where: { scriptId: script.id },
+      });
+      if (count >= 50)
+        throw new BadRequestException('The version limit is 50 per script');
+      const version = await tx.creatorVersion.create({
+        data: {
+          scriptId: script.id,
+          revision: count + 1,
+          hash: result.hash!,
+          source: dto.source,
+          manifest: result.manifest,
+        },
+      });
+      script = await tx.creatorScript.update({
+        where: { id: script.id },
+        data: { name: result.manifest.name },
+      });
+      await tx.creatorAudit.create({
+        data: {
+          actorId: ownerId,
+          action: 'script.saved',
+          targetId: script.id,
+          detail: { versionId: version.id, hash: result.hash! },
+        },
+      });
+      return { script, version };
+    });
+  }
+  async library(ownerId: number) {
+    const rows = await this.prisma.creatorScript.findMany({
+      where: { ownerId },
+      orderBy: { updatedAt: 'desc' },
+      take: 50,
+      include: {
+        versions: {
+          orderBy: { revision: 'desc' },
+          select: {
+            id: true,
+            revision: true,
+            hash: true,
+            manifest: true,
+            createdAt: true,
+          },
+        },
+      },
+    });
+    return rows
+      .map((s) => ({
+        ...s,
+        versions: s.versions.filter(
+          (v) => !(v.manifest as any)?.requires?.includes('arena.cohorts@1'),
+        ),
+      }))
+      .filter((s) => s.versions.length);
+  }
+  async version(ownerId: number, id: string) {
+    const { version: v } = await this.access.version(ownerId, id, true);
+    return v;
+  }
+  async install(
+    ownerId: number,
+    dto: InstallScriptDto,
+    client?: { ip: string | null; uaHash: string | null },
+  ) {
+    const { version, entitlement } = await this.access.version(
+      ownerId,
+      dto.versionId,
+    );
+    if (dto.datasetId && dto.datasetId !== 'arena-live')
+      throw new BadRequestException(
+        'Live installations use Arena. Use Replay for imported and Binary datasets.',
+      );
+    const executionMode =
+      dto.executionMode || (dto.paper ? 'paper' : 'signals');
+    if (executionMode === 'live') {
+      if (dto.confirmLive !== 'ALLOW LIVE TRADES')
+        throw new BadRequestException(
+          'Explicit live trading consent is required',
+        );
+      await this.experts.assertLive();
+    }
+    const risk: any = { ...(dto.risk || {}) };
+    const bounds: Record<string, [number, number]> = {
+      maxPerRound: [1, 100000],
+      maxPerDay: [1, 100000],
+      maxOrdersPerRound: [1, 100],
+      lossStop: [1, 100000],
+    };
+    for (const [key, value] of Object.entries(risk)) {
+      const range = bounds[key];
+      if (
