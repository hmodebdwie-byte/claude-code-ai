+      datasetId: 'arena-live',
+      before: before.toISOString(),
+      count,
+      retentionDays: s.retentionDays,
+    };
+  }
+  async purge(actorId: number, dto: any) {
+    if (dto.confirm !== 'DELETE ARCHIVED HISTORY')
