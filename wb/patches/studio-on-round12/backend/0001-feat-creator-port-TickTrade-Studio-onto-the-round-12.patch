+function regressionSlope(values: number[]) {
+  if (values.length < 2) return null;
+  const center = (values.length - 1) / 2,
+    mean = values.reduce((sum, v) => sum + v, 0) / values.length;
+  let numerator = 0,
+    denominator = 0;
+  for (let i = 0; i < values.length; i++) {
+    numerator += (i - center) * (values[i] - mean);
+    denominator += (i - center) ** 2;
+  }
+  return numerator / denominator;
+}
+/** Pure, chronological analytics. Only observations at or before each frame enter a feature. */
+export type HistoryPoint = {
+  id?: any;
+  sourceKey?: string;
+  roundId: number | null;
+  time: Date | number;
+  price: any;
+  buyVolume?: any;
+  sellVolume?: any;
+  origin?: string;
+  snapshot?: any;
+};
+const sum = (a: number[]) => a.reduce((s, v) => s + v, 0);
+const div = (a: number, b: number) => (b ? a / b : null);
+/** Lightweight price spine shared by sparse live evaluation and full historical replay. */
+export function historyEmissionIndices(
+  points: HistoryPoint[],
+  intervalSeconds = 1,
+) {
+  const indices: number[] = [];
+  let lastBucket = -1;
+  for (let i = 0; i < points.length; i++) {
+    const p = points[i],
+      time = +p.time,
+      price = Number(p.price);
+    if (!Number.isFinite(price) || price <= 0 || !Number.isFinite(time))
+      continue;
+    const bucket = Math.floor(time / (intervalSeconds * 1000));
+    if (
+      i + 1 < points.length &&
+      Math.floor(+points[i + 1].time / (intervalSeconds * 1000)) === bucket &&
+      points[i + 1].roundId === p.roundId
+    )
+      continue;
+    if (lastBucket === bucket) indices.pop();
+    indices.push(i);
+    lastBucket = bucket;
+  }
+  return indices;
+}
+export function makeHistoryFrames(
+  points: HistoryPoint[],
+  mode = 'arena',
+  windowSeconds = 30,
+  intervalSeconds = 1,
+  emitIndices?: Set<number>,
+) {
+  const frames: any[] = [],
+    window: HistoryPoint[] = [],
+    candles: any[] = [];
+  let previousRound: number | null | undefined,
+    lastEmit = -1,
+    roundBuy = 0,
+    roundSell = 0,
+    previousPressure = 0,
+    persistence = 0;
+  for (let i = 0; i < points.length; i++) {
+    const p = points[i],
+      time = +p.time,
+      price = Number(p.price);
+    if (!Number.isFinite(price) || price <= 0 || !Number.isFinite(time))
+      continue;
+    if (previousRound !== p.roundId) {
+      window.length = 0;
+      roundBuy = 0;
+      roundSell = 0;
+      persistence = 0;
+      previousPressure = 0;
+    }
+    previousRound = p.roundId;
+    roundBuy += Number(p.buyVolume || 0);
+    roundSell += Number(p.sellVolume || 0);
+    window.push(p);
+    while (window.length && +window[0].time < time - windowSeconds * 1000)
+      window.shift();
+    // Bound memory during unusually dense feeds; expose a coverage flag below.
+    const dense = window.length > 10000;
+    if (dense) window.splice(0, window.length - 10000);
+    const bucket =
+      Math.floor(time / (intervalSeconds * 1000)) * intervalSeconds;
+    const last = candles.at(-1);
+    if (last?.time === bucket) {
+      last.high = Math.max(last.high, price);
+      last.low = Math.min(last.low, price);
+      last.close = price;
+      last.volume += Number(p.buyVolume || 0) + Number(p.sellVolume || 0);
+    } else {
+      if (last) last.confirmed = true;
+      candles.push({
+        time: bucket,
+        open: price,
+        high: price,
+        low: price,
+        close: price,
+        volume: Number(p.buyVolume || 0) + Number(p.sellVolume || 0),
+        confirmed: false,
+      });
+    }
+    if (candles.length > 128) candles.shift();
+    // Emit the final observation in each bucket, keeping strict as-of timestamps.
+    if (
+      i + 1 < points.length &&
+      Math.floor(+points[i + 1].time / (intervalSeconds * 1000)) *
+        intervalSeconds ===
+        bucket &&
+      points[i + 1].roundId === p.roundId
+    )
+      continue;
+    if (
+      frames.length &&
+      Math.floor(frames.at(-1).time / (intervalSeconds * 1000)) *
+        intervalSeconds ===
+        bucket
+    )
+      frames.pop();
+    lastEmit = bucket;
+    const buy = sum(window.map((t) => Number(t.buyVolume || 0))),
+      sell = sum(window.map((t) => Number(t.sellVolume || 0))),
+      total = buy + sell;
+    const imbalance = total ? (buy - sell) / total : 0;
+    const direction = Math.sign(imbalance);
+    persistence =
+      direction && direction === previousPressure ? persistence + 1 : 0;
+    previousPressure = direction;
+    if (emitIndices && !emitIndices.has(i)) continue;
+    const prices = window.map((t) => Number(t.price));
+    const tickets = window
+      .map((t) => Number(t.buyVolume || 0) + Number(t.sellVolume || 0))
+      .filter((v) => v > 0);
+    const changes = prices.slice(1).map((v, j) => Math.log(v / prices[j]));
+    const mean = changes.length ? sum(changes) / changes.length : 0;
+    const std =
+      changes.length > 1
+        ? Math.sqrt(sum(changes.map((v) => (v - mean) ** 2)) / changes.length)
+        : null;
+    const first = prices[0],
+      high = Math.max(...prices),
+      low = Math.min(...prices);
+    const hhi = total ? sum(tickets.map((v) => (v / total) ** 2)) : null;
+    const observed = p.snapshot?.observed || {},
+      round = p.snapshot?.round || {};
+    const start = Number(
+      round.startPrice || observed.market?.startPrice || first,
+    );
+    const elapsed = Math.max(
+      0,
+      (time - Number(round.startTime || time)) / 1000,
+    );
+    const duration = Number(round.durationSeconds || 0);
+    const remainder = Math.max(0, duration - elapsed);
+    const gaps = window
+      .slice(1)
+      .map((t, j) => (+t.time - +window[j].time) / 1000);
+    const reconstructed = !observed.market;
+    const missing = observed.participants ? [] : ['arena.participants@1'];
+    const response =
+      prices.length > 1
+        ? {
+            change: price - first,
+            changePips: (price - first) / 0.0001,
+            samples: prices.length,
+          }
+        : null;
+    const data: any = {
+      market: {
+        price,
+        startPrice: start,
+        buyPot: roundBuy,
+        sellPot: roundSell,
+        remainingSeconds: remainder,
+        phase:
+          mode === 'binary' ? 'HISTORICAL' : remainder > 0 ? 'OPEN' : 'CLOSED',
+        potBasis: 'archived-priced-events',
+        ...observed.market,
+      },
+      flow: {
+        buy,
