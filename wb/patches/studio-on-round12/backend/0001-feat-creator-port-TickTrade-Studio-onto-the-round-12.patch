+  o[g][p] = v;
+};
+function buildIntelligence(input) {
+  const { asOf, round, participants = [], settled = [], social = [] } = input;
+  const clock = round.endTime ? Math.min(asOf, +new Date(round.endTime)) : asOf;
+  const events = input.events
+    .filter((e) => e.time <= clock && e.amount > 0 && e.price > 0)
+    .sort(
+      (a, b) =>
+        a.time - b.time || String(a.eventId).localeCompare(String(b.eventId), 'en', { numeric: true }),
+    )
+    .map((e, i) => ({
+      ...e,
+      id: e.traderId,
+      sequence: i + 1,
+      side: e.side.toLowerCase(),
+      sign: e.side === "BUY" ? 1 : -1,
+      after: e.price,
+      priceAfter: e.price,
+      priceBefore: NaN,
+      impact: NaN,
+    }));
+  const byTrader = new Map(),
+    sequenceIndex = new Map();
+  for (const [i, e] of events.entries()) {
+    if (!byTrader.has(e.id)) byTrader.set(e.id, []);
+    const own = byTrader.get(e.id);
+    e.switched = own.length > 0 && own.at(-1).side !== e.side;
+    own.push(e);
+    sequenceIndex.set(e.sequence, i);
+  }
+  const profiles = [],
+    rows = [],
+    volumes = events.map((e) => e.amount),
+    volume = sum(volumes),
+    globalGaps = events.slice(1).map((e, i) => e.time - events[i].time);
+  const context = {
+    tape: events,
+    byTrader,
+    sequenceIndex,
+    totalVolume: Math.max(1, volume),
+    totalImpactPips: NaN,
+    signedImpactPips: NaN,
+    firstTime: +new Date(round.startTime),
+    lastTime: clock,
+    largeOrderThreshold: q(volumes, 0.9) || 0,
+    globalIntervalMean: mean(globalGaps),
+    globalIntervalDeviation: sd(globalGaps),
+    globalImpactMean: NaN,
+    globalImpactDeviation: NaN,
+    sourceSequence: events.length,
+    marketCondition: input.marketCondition || "OBSERVED ROUND",
+  };
+  for (const id of [...new Set([...participants, ...byTrader.keys()])]) {
+    const es = byTrader.get(id) || [],
+      sizes = es.map((e) => e.amount),
+      v = sum(sizes),
+      buy = sum(es.filter((e) => e.sign > 0).map((e) => e.amount)),
+      sell = v - buy;
+    const ownRounds = settled
+        .filter((s) => s.traderId === id)
+        .sort((a, b) => a.time - b.time),
+      wins = ownRounds.filter((r) => r.profit > 0).length;
+    const socialRow = social.find((s) => s.traderId === id) || {};
+    let best = 0,
+      run = 0,
+      current = 0;
+    for (const r of ownRounds) {
+      run = r.profit > 0 ? run + 1 : 0;
+      best = Math.max(best, run);
+      current =
+        r.profit > 0
+          ? current > 0
+            ? current + 1
+            : 1
+          : r.profit < 0
+            ? current < 0
