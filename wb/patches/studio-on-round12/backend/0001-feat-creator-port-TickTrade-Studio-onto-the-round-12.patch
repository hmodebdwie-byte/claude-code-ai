+"use strict";
+const {
+  buildTraderIntelligence,
+  percentileRank,
+} = require("./intelligence-reference.cjs");
+const { enrich } = require("./intelligence-measured.cjs");
+const catalog = require("./intelligence-catalog.json");
+const {
+  sum,
+  mean,
+  q,
+  sd,
+  ratio,
+  effective,
+  entropy,
+} = require("./intelligence-utils.cjs");
+const finite = (v) => typeof v === "number" && Number.isFinite(v);
+const get = (o, k) => k.split(".").reduce((a, b) => a?.[b], o);
+const put = (o, k, v) => {
+  const [g, p] = k.split(".");
