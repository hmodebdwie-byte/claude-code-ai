index 0000000..8fffd58
--- /dev/null
+++ b/apps/api/src/creator/creator-history-frame.worker.ts
@@ -0,0 +1,106 @@
+import { Worker, isMainThread, parentPort } from 'node:worker_threads';
+import { framesFromSnapshot } from './creator-history-frame.math';
+
+if (!isMainThread) {
+  parentPort!.on('message', ({ id, snapshot, query }) => {
+    try {
+      parentPort!.postMessage({
+        id,
+        value: framesFromSnapshot(snapshot, query),
+      });
+    } catch (error) {
+      parentPort!.postMessage({
+        id,
+        error: (error as Error).message.slice(0, 400),
+      });
+    }
+  });
+}
+
+/** Historical feature construction has its own bounded CPU/memory queue. Dense
+ * recordings never run their rolling statistics on the HTTP server event loop. */
+export class CreatorHistoryFrameWorker {
+  private worker: Worker | null = null;
+  private serial = 0;
+  private closed = false;
+  private queued: Array<any> = [];
+  private active: any = null;
+  calculate(
+    snapshot: any,
+    query: any,
+  ): Promise<ReturnType<typeof framesFromSnapshot>> {
+    if (this.closed) return Promise.reject(Error('History worker stopped'));
+    if (this.queued.length >= 8)
+      return Promise.reject(Error('History worker is busy; retry shortly'));
+    return new Promise((resolve, reject) => {
+      this.queued.push({ id: ++this.serial, snapshot, query, resolve, reject });
+      this.pump();
+    });
+  }
+  private pump() {
+    if (this.closed || this.active || !this.queued.length) return;
+    if (!this.worker) {
+      const worker = new Worker(__filename, {
+        resourceLimits: { maxOldGenerationSizeMb: 256 },
+        env: {},
+      });
+      worker.unref();
+      this.worker = worker;
+      worker.on('message', (message) => {
+        if (this.worker !== worker || message.id !== this.active?.id) return;
+        const task = this.active;
+        clearTimeout(task.timer);
+        this.active = null;
+        if (message.error) task.reject(Error(message.error));
+        else task.resolve(message.value);
+        this.pump();
+      });
+      const failed = () => {
+        if (this.worker !== worker) return;
+        this.worker = null;
+        void worker.terminate();
+        if (this.active) {
+          clearTimeout(this.active.timer);
+          this.active.reject(
+            Error('History worker unavailable; retry shortly'),
+          );
+          this.active = null;
+        }
+        this.pump();
+      };
+      worker.on('error', failed);
+      worker.on('exit', failed);
+    }
+    const task = this.queued.shift();
+    this.active = task;
+    task.timer = setTimeout(() => {
+      if (this.active !== task) return;
+      const worker = this.worker;
+      this.worker = null;
+      this.active = null;
+      if (worker) void worker.terminate();
+      task.reject(
+        Error('History calculation deadline exceeded; retry shortly'),
+      );
+      this.pump();
+    }, 30000);
+    this.worker!.postMessage({
+      id: task.id,
+      snapshot: task.snapshot,
+      query: task.query,
+    });
+  }
+  close() {
+    this.closed = true;
+    if (this.worker) void this.worker.terminate();
+    this.worker = null;
+    if (this.active) {
+      clearTimeout(this.active.timer);
+      this.active.reject(Error('History worker stopped'));
+      this.active = null;
+    }
+    for (const task of this.queued)
+      task.reject(Error('History worker stopped'));
+    this.queued = [];
+  }
+}
