+  // sorted ladder with the same below + equal/2 formula, so values are identical.
+  const peersByArchetype = new Map();
+  for (const x of records) {
+    const k = x.identity.archetype;
+    let bucket = peersByArchetype.get(k);
+    if (bucket === undefined) peersByArchetype.set(k, (bucket = []));
+    bucket.push(x);
+  }
