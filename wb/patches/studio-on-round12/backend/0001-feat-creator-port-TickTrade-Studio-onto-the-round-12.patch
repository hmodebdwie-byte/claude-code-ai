+  }
+
+  const contribution = records.map((r) => r.impact.orderVolume),
+    buy = sum(events.filter((e) => e.sign > 0).map((e) => e.amount));
+  const summary = {
+    records: records.length,
+    activeRecords: records.filter((r) => r.impact.orderCount).length,
+    acceptedOrders: events.length,
+    acceptedVolume: volume,
+    buyVolume: buy,
+    sellVolume: volume - buy,
+    netFlow: buy - (volume - buy),
+    effectiveTraders: effective(contribution),
+    topFiveShare: ratio(
