+import { ADVANCED_CREATOR_EXAMPLES } from './advanced-examples';
+export const CREATOR_EXAMPLES = [
+  {
+    id: 'crowd-flow',
+    label: 'Crowd × flow',
+    kind: 'indicator',
+    source: `import { defineIndicator, ratio } from '@ticktrade/sdk';
+
+export default defineIndicator({
+  sdkVersion: '1', kind: 'indicator', name: 'Crowd × flow',
+  description: 'Compare active side participation with accepted money flow. Descriptive evidence, not a prediction.',
+  modes: ['arena'], requires: ['arena.market@1', 'arena.flow@1', 'arena.participants@1'],
+  parameters: { windowSeconds: { type: 'integer', label: 'Flow window (seconds)', default: 30, min: 5, max: 300 } },
+  onUpdate(ctx) {
+    const f = ctx.data.flow!;
+    const p = ctx.data.participants!;
+    const traderBias = ratio(100 * (p.buy - p.sell), p.buy + p.sell);
+    const flowBias = ratio(100 * (f.buy - f.sell), f.buy + f.sell);
+    const gap = traderBias === null || flowBias === null ? null : traderBias - flowBias;
+    return {
+      plots: [
+        { id: 'crowd', label: 'Participation bias', placement: 'pane', value: traderBias, color: '#42d7ef' },
+        { id: 'flow', label: 'Flow bias', placement: 'pane', value: flowBias, color: '#fb3989' }
+      ],
+      card: { title: 'CROWD × FLOW', status: gap === null ? 'Waiting for participation and flow' : 'Positive bias = BUY · both-side accounts count on both sides',
+        metrics: [
+          { label: 'PARTICIPATION', value: traderBias, suffix: '%' },
+          { label: 'FLOW', value: flowBias, suffix: '%' },
+          { label: 'GAP', value: gap === null ? null : Math.abs(gap), suffix: 'pts' },
+          { label: 'BUY FLOW', value: f.buy, tone: 'buy' },
+          { label: 'SELL FLOW', value: f.sell, tone: 'sell' },
+          { label: 'BOTH SIDES', value: p.both }
+        ] }
+    };
+  }
+});`,
+  },
+  {
+    id: 'flow-envelope',
+    label: 'Flow response envelope',
+    kind: 'indicator',
+    source: `import { defineIndicator, clamp, ratio } from '@ticktrade/sdk';
+
+export default defineIndicator({
+  sdkVersion: '1', kind: 'indicator', name: 'Flow response envelope',
+  description: 'A smoothed quote envelope with width driven by observed flow imbalance and price response. No forecast probability.',
+  modes: ['arena'], requires: ['arena.market@1', 'arena.flow@1', 'arena.response@1'],
+  parameters: {
+    windowSeconds: { type: 'integer', label: 'Observation window', default: 30, min: 5, max: 300 },
+    smoothing: { type: 'number', label: 'Smoothing', default: 0.15, min: 0.01, max: 1 }
+  },
+  onUpdate(ctx) {
+    const m = ctx.data.market!, f = ctx.data.flow!, r = ctx.data.response!;
+    const alpha = Number(ctx.params.smoothing);
+    const previous = typeof ctx.state.center === 'number' ? ctx.state.center : m.price;
+    const center = previous + alpha * (m.price - previous);
+    const bias = ratio(f.buy - f.sell, f.buy + f.sell) || 0;
+    const width = Math.max(0.0001, Math.abs(r.change)) * (1 + Math.abs(bias));
+    return {
+      state: { center },
+      plots: [
+        { id: 'upper', label: 'Response upper', placement: 'overlay', value: center + width, color: '#42d7ef' },
+        { id: 'center', label: 'Observed center', placement: 'overlay', value: center, color: '#f0c76d' },
+        { id: 'lower', label: 'Response lower', placement: 'overlay', value: center - width, color: '#fb3989' }
+      ],
+      card: { title: 'FLOW RESPONSE', status: 'Observed envelope · resets at each round', metrics: [
+        { label: 'FLOW BIAS', value: clamp(bias * 100, -100, 100), suffix: '%' },
+        { label: 'RESPONSE', value: r.changePips, suffix: 'pips' },
+        { label: 'OBSERVATIONS', value: r.samples }
+      ] }
+    };
+  }
+});`,
+  },
+  {
+    id: 'pressure-expert',
+    label: 'Arena pressure · expert',
+    kind: 'expert',
+    source: `import { defineExpert, ratio } from '@ticktrade/sdk';
+
+export default defineExpert({
+  sdkVersion: '1', kind: 'expert', name: 'Arena pressure · expert',
+  description: 'Emit a signal when observed flow enters a new directional regime. The installation controls paper or explicitly authorized live execution.',
+  modes: ['arena'], requires: ['arena.market@1', 'arena.flow@1'],
+  parameters: {
+    windowSeconds: { type: 'integer', label: 'Flow window', default: 15, min: 5, max: 300 },
+    threshold: { type: 'number', label: 'Bias threshold (%)', default: 25, min: 5, max: 95 },
+    stake: { type: 'number', label: 'Requested stake', default: 5, min: 1, max: 100 }
+  },
+  onUpdate(ctx) {
+    const m = ctx.data.market!, f = ctx.data.flow!;
+    const bias = ratio(100 * (f.buy - f.sell), f.buy + f.sell) || 0;
+    const side = bias > Number(ctx.params.threshold) ? 'BUY' : bias < -Number(ctx.params.threshold) ? 'SELL' : null;
+    const eligible = side !== null && side !== ctx.state.side && f.trades >= 3 && m.remainingSeconds > 10 && m.phase === 'OPEN';
+    return {
+      state: { side },
+      plots: [{ id: 'pressure', label: 'Flow pressure', placement: 'pane', style: 'histogram', value: bias, color: bias >= 0 ? '#42d7ef' : '#fb3989' }],
+      card: { title: 'ARENA PRESSURE', status: eligible ? 'New regime: request emitted' : 'Observing flow · no new request', metrics: [
+        { label: 'BIAS', value: bias, suffix: '%' }, { label: 'TRADES', value: f.trades }, { label: 'REGIME', value: side || 'NEUTRAL' }
+      ] },
+      signals: eligible && side ? [{ id: 'regime', side, amount: Number(ctx.params.stake), reason: 'Flow crossed into a new regime with at least three recorded trades' }] : []
+    };
+  }
+});`,
+  },
+  ...ADVANCED_CREATOR_EXAMPLES,
+];
