+"use strict";
+// Ported from the user's V6 reference. Pure calculations; no simulator or order execution.
+const INTELLIGENCE_BANK_VERSION = "TickTrade.Intelligence/4";
+const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
+const sum = (v) => v.reduce((a, b) => a + b, 0);
+const percentile = (v, p) => {
+  if (!v.length) return NaN;
+  const s = [...v].sort((a, b) => a - b),
+    i = (s.length - 1) * p;
