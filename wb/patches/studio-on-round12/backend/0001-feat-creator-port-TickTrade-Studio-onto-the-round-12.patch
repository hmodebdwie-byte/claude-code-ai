+        data: {
+          actorId,
+          action: 'history.purged',
+          targetId: 'arena-live',
+          detail: { before: before.toISOString(), count: result.count },
+        },
+      });
+      return result;
+    });
+    this.coverageCache.delete('arena-live');
+    return result;
+  }
