@@ -0,0 +1,265 @@
+import {
+  BadRequestException,
+  Injectable,
+  ServiceUnavailableException,
+} from '@nestjs/common';
+import Anthropic from '@anthropic-ai/sdk';
+import { FEATURES, ScriptPool } from '@ticktrade/tickscript';
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { PrismaService } from '../prisma/prisma.service';
+import { CreatorHistoryService } from './creator-history.service';
+
+export const BUILDER_FIELDS = [
+  {
+    id: 'price',
+    feature: 'arena.market@1',
+    expression: 'ctx.data.market!.price',
+    label: 'Market price',
+  },
+  {
+    id: 'seconds',
+    feature: 'arena.market@1',
+    expression: 'ctx.data.market!.remainingSeconds',
+    label: 'Seconds remaining',
+  },
+  {
+    id: 'imbalance',
+    feature: 'arena.liquidity@1',
+    expression: 'ctx.data.liquidity!.imbalance',
+    label: 'Flow imbalance (−1 to 1)',
+  },
+  {
+    id: 'volume',
+    feature: 'arena.liquidity@1',
+    expression: 'ctx.data.liquidity!.total',
+    label: 'Window capital',
+  },
+  {
+    id: 'trades',
+    feature: 'arena.flow@1',
+    expression: 'ctx.data.flow!.trades',
+    label: 'Window trades',
+  },
+  {
+    id: 'participants',
+    feature: 'arena.participants@1',
+    expression: 'ctx.data.participants!.total',
+    label: 'Unique participants',
+  },
+  {
+    id: 'changePips',
+    feature: 'arena.response@1',
+    expression: 'ctx.data.response!.changePips',
+    label: 'Window change (pips)',
+  },
+  {
+    id: 'concentration',
+    feature: 'arena.concentration@1',
+    expression: '(ctx.data.concentration!.hhi ?? 0)',
+    label: 'Ticket concentration HHI',
+  },
+  {
+    id: 'openingDistance',
+    feature: 'arena.structure@1',
+    expression: 'ctx.data.structure!.openingDistancePips',
+    label: 'Distance from round open (pips)',
+  },
+  {
+    id: 'pressure',
+    feature: 'arena.tipping@1',
+    expression: '(ctx.data.tipping!.pressure ?? 0)',
+    label: 'Descriptive tipping pressure',
+  },
+];
+@Injectable()
+export class CreatorAuthoringService {
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly history: CreatorHistoryService,
+  ) {}
+  sdk() {
+    return readFileSync(
+      join(dirname(require.resolve('@ticktrade/tickscript')), 'sdk.d.ts'),
+      'utf8',
+    );
+  }
+  async capabilities() {
+    return {
+      fields: BUILDER_FIELDS.map(({ expression, ...v }) => v),
+      aiConfigured:
+        !!process.env.CREATOR_ANTHROPIC_API_KEY &&
+        !!process.env.CREATOR_AI_MODEL &&
+        (await this.history.settings()).aiEnabled,
+      model: process.env.CREATOR_AI_MODEL || null,
+    };
+  }
+  prompt() {
+    return `Build one TickScript TypeScript module for TickTrade. Import only @ticktrade/sdk and default-export defineIndicator or defineExpert. Use the exact declarations below. No browser, network, file, date, random, async or arbitrary imports. Return finite outputs, retain bounded state explicitly through ctx.state. The runtime supplies only declared requires features. All history is as-of; never assume future outcomes. Persisted price ticks are not an order book. Capital concentration means tickets, not unique users. No profit guarantee or invented probability. Experts emit BUY/SELL requests; the server enforces budget and permissions. Historical replay never executes money orders. Choose stateScope round or series intentionally; warmupBars is limited to 5000. Use null while insufficient history. Do not implement an exit/close position unsupported by Arena.\n\nSDK:\n${this.sdk()}\n\nFEATURES:\n${JSON.stringify(FEATURES)}`;
+  }
+  async inspect(source: string) {
+    const pool = new ScriptPool();
+    try {
+      return await pool.execute({ source, inspect: true });
+    } finally {
+      pool.close();
+    }
+  }
+  async build(dto: any) {
+    if (
+      typeof dto.name !== 'string' ||
+      !dto.name.trim() ||
+      dto.name.length > 80
+    )
+      throw new BadRequestException('Name must contain 1–80 characters');
+    if (
+      !['indicator', 'expert'].includes(dto.kind) ||
+      !['all', 'any'].includes(dto.match || 'all')
+    )
+      throw new BadRequestException(
+        'Invalid builder type or condition matching',
+      );
+    if (
+      !Array.isArray(dto.conditions) ||
+      !dto.conditions.length ||
+      dto.conditions.length > 12
+    )
+      throw new BadRequestException('Choose 1–12 conditions');
+    const requires = new Set<string>(['arena.market@1', 'arena.liquidity@1']);
+    const parameters: any = {
+      windowSeconds: {
+        type: 'integer',
+        label: 'Flow window (seconds)',
+        default: 30,
+        min: 5,
+        max: 300,
+      },
+    };
+    const expressions = dto.conditions.map((c: any, i: number) => {
+      const f = BUILDER_FIELDS.find((f) => f.id === c.field);
+      if (
+        !f ||
+        !['>', '>=', '<', '<=', '===', '!=='].includes(c.operator) ||
+        !Number.isFinite(c.value) ||
+        Math.abs(c.value) > 1e9
+      )
+        throw new BadRequestException(`Invalid condition ${i + 1}`);
+      requires.add(f.feature);
+      parameters[`threshold${i + 1}`] = {
+        type: 'number',
+        label: f.label,
+        default: c.value,
+        min: -1e9,
+        max: 1e9,
+      };
+      return `(${f.expression} ${c.operator} Number(ctx.params.threshold${i + 1}))`;
+    });
+    const side = dto.side || 'BUY',
+      stake = Number(dto.stake || 5);
+    if (
+      !['BUY', 'SELL'].includes(side) ||
+      !Number.isFinite(stake) ||
+      stake < 0.01 ||
+      stake > 10000
+    )
+      throw new BadRequestException('Invalid expert side or stake');
+    const scope = dto.stateScope === 'series' ? 'series' : 'round';
+    if (dto.kind === 'expert')
+      parameters.stake = {
+        type: 'number',
+        label: 'Requested stake',
+        default: stake,
+        min: 0.01,
+        max: 10000,
+      };
+    const source = `import { ${dto.kind === 'expert' ? 'defineExpert' : 'defineIndicator'} } from "@ticktrade/sdk";
+export default ${dto.kind === 'expert' ? 'defineExpert' : 'defineIndicator'}({
+  sdkVersion:"1",name:${JSON.stringify(dto.name)},description:"Visual rules with explicit thresholds, confirmation and rising-edge signals.",kind:${JSON.stringify(dto.kind)},modes:["arena"],stateScope:${JSON.stringify(scope)},warmupBars:600,
+  requires:${JSON.stringify([...requires])},parameters:${JSON.stringify(parameters, null, 2)},
+  onUpdate(ctx){
+    const matched=${expressions.join(dto.match === 'any' ? ' || ' : ' && ')};
+    const streak=matched?Number(ctx.state.streak||0)+1:0;
+    const confirmed=streak>=${Math.min(100, Math.max(1, Math.floor(Number(dto.confirmations) || 1)))};
+    const edge=confirmed&&!ctx.state.wasConfirmed;
+    return {
+      plots:[{id:"pressure",label:"Capital pressure",placement:"pane",value:ctx.data.liquidity!.imbalance*100,color:matched?"#00e5aa":"#586576",scaleMin:-100,scaleMax:100,levels:[0]}],
+      card:{title:${JSON.stringify(dto.name)},status:confirmed?"Conditions confirmed":"Waiting for conditions",tone:confirmed?${JSON.stringify(side === 'BUY' ? 'buy' : 'sell')}:"neutral",metrics:[{label:"Confirmation count",value:streak},{label:"Flow pressure",value:ctx.data.liquidity!.imbalance*100,suffix:"%"}]},
+      ${dto.kind === 'expert' ? `signals:edge?[{id:"rule-entry",side:"${side}",amount:Number(ctx.params.stake),reason:"Visual conditions confirmed on a new edge"}]:[],` : ''}
+      state:{streak,wasConfirmed:confirmed}
+    };
+  }
+});`;
+    const result = await this.inspect(source);
+    return { source, ...result };
+  }
+  async generate(ownerId: number, dto: any) {
+    if (!(await this.capabilities()).aiConfigured)
+      throw new ServiceUnavailableException(
+        'Configure the server-side AI provider and enable authoring in Creator admin, or export the SDK prompt for your own AI',
+      );
+    if (
+      typeof dto.prompt !== 'string' ||
+      dto.prompt.length < 10 ||
+      dto.prompt.length > 12000 ||
+      (dto.source && typeof dto.source !== 'string') ||
+      (dto.source && Buffer.byteLength(dto.source) > 65536)
+    )
+      throw new BadRequestException(
+        'Provide a prompt of 10–12000 characters and an optional source module',
+      );
+    const count = await this.prisma.creatorAudit.count({
+      where: {
+        actorId: ownerId,
+        action: 'authoring.ai-requested',
+        createdAt: { gte: new Date(Date.now() - 86400000) },
+      },
+    });
+    if (count >= 30)
+      throw new BadRequestException(
+        'AI authoring limit is 30 requests per day',
+      );
+    await this.prisma.creatorAudit.create({
+      data: {
+        actorId: ownerId,
+        action: 'authoring.ai-requested',
+        targetId: 'draft',
+        detail: {
+          model: process.env.CREATOR_AI_MODEL!,
+          promptCharacters: dto.prompt.length,
+        },
+      },
+    });
+    const client = new Anthropic({
+      apiKey: process.env.CREATOR_ANTHROPIC_API_KEY,
+      maxRetries: 0,
+      timeout: 90000,
+    });
+    const response = await client.messages.create({
+      model: process.env.CREATOR_AI_MODEL!,
+      max_tokens: 6000,
+      system: this.prompt(),
+      messages: [
+        {
+          role: 'user',
+          content: `${dto.prompt}\n${dto.source ? `Existing draft to revise:\n\`\`\`typescript\n${dto.source}\n\`\`\`` : ''}\nReturn the complete TypeScript module in one code fence. No automatic publication or live execution.`,
+        },
+      ],
+    });
+    const text = response.content
+      .filter((b) => b.type === 'text')
+      .map((b: any) => b.text)
+      .join('\n');
+    const source = (
+      text.match(/```(?:typescript|ts)?\s*\n([\s\S]*?)```/)?.[1] || text
+    ).trim();
+    if (Buffer.byteLength(source) > 65536)
+      throw new BadRequestException('AI draft exceeds the module limit');
+    return {
+      source,
+      ...(await this.inspect(source)),
+      usage: response.usage,
+      model: response.model,
+      draftOnly: true,
+    };
+  }
+}
