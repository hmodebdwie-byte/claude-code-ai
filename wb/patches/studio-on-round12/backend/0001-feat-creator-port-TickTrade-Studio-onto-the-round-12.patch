+    return this.service.removeScript(req.user.userId, id);
+  }
+  @Post('templates/:id') template(
+    @Req() req: RequestUser,
+    @Param('id') id: string,
+  ) {
+    return this.service.useTemplate(req.user.userId, id);
+  }
+  @Get('versions/:id') version(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+  ) {
+    return this.service.version(req.user.userId, id);
+  }
+  @Get('installations') installations(@Req() req: RequestUser) {
+    return this.service.installations(req.user.userId);
+  }
+  @Post('installations/feed') feed(
+    @Req() req: RequestUser,
+    @Body() dto: CreatorFeedDto,
+  ) {
+    return this.service.feed(req.user.userId, dto.known);
+  }
+  @Post('installations') install(
+    @Req() req: RequestUser,
+    @Body() dto: InstallScriptDto,
+  ) {
+    const ctx = secContext(req as any);
+    return this.service.install(req.user.userId, dto, {
+      ip: ctx.ip,
+      uaHash: ctx.deviceHash,
+    });
+  }
+  @Patch('installations/:id') update(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() dto: UpdateInstallationDto,
+  ) {
+    const ctx = secContext(req as any);
+    return this.service.updateInstallation(req.user.userId, id, dto, {
+      ip: ctx.ip,
+      uaHash: ctx.deviceHash,
+    });
+  }
+  @Post('installations/:id/configure') configure(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() dto: ConfigureInstallationDto,
+  ) {
+    return this.service.configure(req.user.userId, id, dto);
+  }
+  @Delete('installations/:id') remove(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+  ) {
+    return this.service.remove(req.user.userId, id);
+  }
+  @Get('installations/:id/decisions') decisions(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+  ) {
+    return this.service.decisions(req.user.userId, id);
+  }
+}
+
+@Controller('admin/creator')
+@UseGuards(JwtAuthGuard, AdminGuard)
+export class CreatorAdminController {
+  constructor(
+    private readonly service: CreatorService,
+    private readonly data: CreatorDataService,
+  ) {}
+  @Get('overview') @RequirePermission('creator.view') overview() {
+    return this.service.overview();
+  }
+  @Get('packages') @RequirePermission('creator.view') packages() {
+    return this.service.adminPackages();
+  }
+  @Get('runs') @RequirePermission('creator.view') runs() {
+    return this.service.adminRuns();
+  }
+  @Get('data') @RequirePermission('creator.view') async features() {
+    return {
+      features: this.data.catalog(),
+      frame: await this.service.liveFrame(),
+    };
+  }
+  @Get('audit') @RequirePermission('creator.view') audit() {
+    return this.service.audit();
+  }
+  @Patch('packages/:id') @RequirePermission('creator.manage') revoke(
+    @Req() req: RequestUser,
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() dto: RevokeScriptDto,
+  ) {
+    return this.service.revoke(req.user.userId, id, dto.disabled, dto.reason);
+  }
+}
