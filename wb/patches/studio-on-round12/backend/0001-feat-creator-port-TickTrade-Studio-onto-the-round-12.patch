+"use strict";
+const LIMITS = Object.freeze({
+  sourceBytes: 65536,
+  outputBytes: 32768,
+  stateBytes: 8192,
+  plots: 8,
+  metrics: 12,
+  signals: 4,
+  runtimeMs: 80,
+  memoryBytes: 16 * 1024 * 1024,
+});
+const FEATURES = Object.freeze([
+  { id: "arena.bank@1", key: "bank", label: "Market event metric bank", category: "Research",
+    description: "Versioned dictionary of 76 reference metrics. Measured values describe aggregate accepted priced events, including exact 1/5/20-event matured responses. Private history/capacity fields are null; unavailable or non-contiguous observations are not fabricated." },
+  {
+    id: "arena.traders@1",
+    key: "traders",
+    label: "Trader breadth & concentration",
+    category: "Traders",
+    description:
+      "Distinct accepted-stake participants, overlapping sides, trader-level HHI, effective trader count and top-1/top-5 capital share. No identities or balances are exposed.",
+  },
+  {
+    id: "arena.behavior@1",
+    key: "behavior",
+    label: "Behaviour & migration",
+    category: "Traders",
+    description:
+      "Within-account side-switch rate, median cadence, directional entropy, ticket size dispersion and old/new-half size drift in the selected historical window.",
+  },
+  {
+    id: "arena.impact@1",
+    key: "impact",
+    label: "Matured impact evidence",
+    category: "Research",
+    description:
+      "Five-second side-aligned price markouts from accepted stakes, matured strictly before the frame timestamp; positive rate, Wilson interval and tail metrics. Not account P&L or causal price impact.",
+  },
+  {
+    id: "market.external@1",
+    key: "external",
+    label: "Imported aggregate fields",
+    category: "Imported",
+    description:
+      "Versioned numeric aggregate fields from an administrator-reviewed dataset. Field names, source and units are documented in dataset metadata.",
+  },
+  {
+    id: "market.ohlcv@1",
+    key: "candles",
+    label: "OHLCV history",
+    category: "Price",
+    description:
+      "Completed and current candles up to this observation only. Current candle is explicitly unconfirmed.",
+  },
+  {
+    id: "arena.liquidity@1",
+    key: "liquidity",
+    label: "Capital & ticket depth",
+    category: "Flow",
+    description:
+      "Accepted priced-event volume, average ticket and buy/sell imbalance. Not an executable order book.",
+  },
+  {
+    id: "arena.volatility@1",
+    key: "volatility",
+    label: "Volatility & drawdown",
+    category: "Price",
+    description:
+      "Observed log-return volatility, range and drawdown in the selected historical window.",
+  },
+  {
+    id: "arena.momentum@1",
+    key: "momentum",
+    label: "Momentum & acceleration",
+    category: "Price",
+    description:
+      "Price impulse, regression slope and acceleration derived without future data.",
+  },
+  {
+    id: "arena.concentration@1",
+    key: "concentration",
+    label: "Capital concentration",
+    category: "Flow",
+    description:
+      "Ticket-size Herfindahl index, effective trade count and largest ticket share. These are ticket statistics, not identity concentration.",
+  },
+  {
+    id: "market.quality@1",
+    key: "quality",
+    label: "Data quality",
+    category: "Quality",
+    description:
+      "Coverage, sample size, observed gap, source quality and reconstruction flags; no inferred observations.",
+  },
+  {
+    id: "arena.structure@1",
+    key: "structure",
+    label: "Round structure",
+    category: "Round",
+    description:
+      "Distance from opening price, time remaining and priced-event capital pressure.",
+  },
+  {
+    id: "arena.tipping@1",
+    key: "tipping",
+    label: "Tipping pressure research",
+    category: "Research",
+    description:
+      "Descriptive capital/response pressure, persistence and evidence sample size. Not a calibrated outcome probability.",
+  },
+  {
+    id: "arena.market@1",
+    key: "market",
+    label: "Round & market",
+    category: "Observed",
+    description:
+      "Persisted quote, round start price, pool totals, phase and time remaining. Prices use quote units; pots use account currency.",
+  },
+  {
+    id: "arena.flow@1",
+    key: "flow",
+    label: "Accepted flow",
+    category: "Derived",
+    description:
+      "BUY/SELL amount and count from persisted priced-event records over windowSeconds. Includes accepted market flow. History can lag the live engine.",
+  },
+  {
+    id: "arena.participants@1",
+    key: "participants",
+    label: "Active participation",
+    category: "Derived",
+    description:
+      "Unique accounts with active stakes: BUY, SELL, BOTH and union. BOTH appears in each side count; no identities are exposed.",
+  },
+  {
+    id: "arena.response@1",
+    key: "response",
+    label: "Price response",
+    category: "Derived",
+    description:
