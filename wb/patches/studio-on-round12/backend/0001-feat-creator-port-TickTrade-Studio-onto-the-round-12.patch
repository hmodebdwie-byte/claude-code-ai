+    rows.push(row);
+  }
+  const measured = enrich(
+    { events, rows, quality: { grossImpact: NaN, end: events.length } },
+    { profiles, clock },
+  );
+  const reasons = [],
+    reasonIndex = new Map();
+  const reasonId = (reason) => {
+    if (!reasonIndex.has(reason)) {
+      reasonIndex.set(reason, reasons.length);
+      reasons.push(reason);
+    }
+    return reasonIndex.get(reason);
+  };
+  const records = profiles.map((profile, i) => {
+    const record = buildTraderIntelligence(profile, context),
+      provenance = {};
