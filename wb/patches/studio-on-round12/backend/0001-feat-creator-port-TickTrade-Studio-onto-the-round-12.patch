+    if (!['https:', 'http:'].includes(url.protocol))
+      throw new ServiceUnavailableException('Invalid Creator public URL');
+    return url.origin;
+  }
+  private fee() {
+    return Math.min(
+      5000,
+      Math.max(
+        0,
