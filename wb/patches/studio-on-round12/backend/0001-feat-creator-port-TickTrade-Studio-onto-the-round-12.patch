+export interface ScriptResult {
+  ok: boolean;
+  hash?: string;
+  manifest?: any;
+  params?: Record<string, number | boolean>;
+  output?: any;
+  outputs?: any[];
+  state?: any;
+  lastRound?: number | null;
+  diagnostics: Array<{ line: number; column: number; message: string }>;
+}
+export class ScriptPool {
+  constructor(options?: { timeoutMs?: number; maxQueued?: number });
+  execute(request: {
+    source: string;
+    inspect?: boolean;
+    params?: any;
+    frame?: any;
+    frames?: any[];
+    previousRoundId?: number | null;
+    replay?: boolean;
+    state?: any;
+  }): Promise<ScriptResult>;
+  stats(): {
+    queued: number;
+    running: boolean;
+    completed: number;
+    failed: number;
+  };
+  close(): void;
+}
+export const FEATURES: ReadonlyArray<{
+  id: string;
+  key: string;
+  label: string;
+  category: string;
+  description: string;
+}>;
+export const LIMITS: Record<string, number>;
+export function validateManifest(value: any): any;
+export function parametersFor(
+  manifest: any,
+  values?: any,
+): Record<string, number | boolean>;
+export function validateOutput(output: any, kind: string): any;
