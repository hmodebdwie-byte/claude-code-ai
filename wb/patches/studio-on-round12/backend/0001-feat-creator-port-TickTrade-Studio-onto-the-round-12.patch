+import {
+  ForbiddenException,
+  Injectable,
+  NotFoundException,
+} from '@nestjs/common';
+import { PrismaService } from '../prisma/prisma.service';
+@Injectable()
+export class CreatorAccessService {
+  constructor(private readonly prisma: PrismaService) {}
+  async version(ownerId: number, id: string, source = false) {
+    const v = await this.prisma.creatorVersion.findUnique({
+      where: { id },
+      include: { script: true },
+    });
+    if (!v || v.script.disabled)
+      throw new NotFoundException('Package unavailable');
+    if (v.script.ownerId === ownerId) return { version: v, entitlement: null };
+    const entitlement = await this.prisma.creatorEntitlement.findFirst({
+      where: {
+        ownerId,
+        versionId: id,
+        status: 'active',
+        OR: [{ expiresAt: null }, { expiresAt: { gt: new Date() } }],
+      },
+      orderBy: { createdAt: 'desc' },
+    });
+    if (!entitlement)
+      throw new ForbiddenException(
+        'An active license for this version is required',
+      );
+    if (source) {
+      const listing = await this.prisma.creatorListing.findUnique({
+        where: { id: entitlement.listingId },
+      });
+      if (listing?.sourceVisibility !== 'open')
+        throw new ForbiddenException('This package protects its source code');
+    }
+    return { version: v, entitlement };
+  }
+  async valid(
+    ownerId: number,
+    versionId: string,
+    entitlementId: string | null,
+  ) {
+    if (!entitlementId)
+      return !!(await this.prisma.creatorVersion.findFirst({
+        where: { id: versionId, script: { ownerId, disabled: false } },
+      }));
+    return !!(await this.prisma.creatorEntitlement.findFirst({
+      where: {
+        id: entitlementId,
+        ownerId,
+        versionId,
+        status: 'active',
+        OR: [{ expiresAt: null }, { expiresAt: { gt: new Date() } }],
+      },
+    }));
+  }
+}
