+                  "executionQuality.meanMarkout3",
+                  "executionQuality.positiveMarkoutRate3",
+                  "executionQuality.adverseMarkoutRate3",
+                  "executionQuality.markoutVolatility",
+                  "executionQuality.tailAdverseMarkout",
+                  "impact.followThroughPips",
+                  "impact.followThroughScore",
+                  "impact.adverseSelectionPips",
+                ]
+              : ["executionQuality.meanMarkout5"];
+        for (const key of keys) {
+          put(record, key, null);
+          provenance[key] = {
+            source: "unavailable",
+            reason: `No completed +${h}-event response in this window.`,
+          };
+        }
+      }
+    }
+    const metrics = measured.rows[i].metrics;
+    for (const m of metrics) {
