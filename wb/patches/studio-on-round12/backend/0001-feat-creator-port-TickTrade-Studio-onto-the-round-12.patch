+    for (const h of [1, 3, 5]) {
+      const n = ownEvents.filter(
+        (e) => sequenceIndex.get(e.sequence) + h < events.length,
+      ).length;
+      if (!n) {
+        const keys =
+          h === 1
+            ? ["executionQuality.meanMarkout1"]
