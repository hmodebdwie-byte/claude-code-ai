+    label: '+20 events \u00b7 Positive fraction',
+    group: 'Event response',
+    unit: 'ratio',
+    definition: 'Positive markouts / mature samples; not account win rate.',
+    availability: 'measured',
+  },
+  {
+    key: 'response.20.low',
+    label: '+20 events \u00b7 Wilson lower 95%',
+    group: 'Event response',
+    unit: 'ratio',
+    definition: 'Approximate Wilson lower; overlapping events are dependent.',
+    availability: 'measured',
+  },
+  {
+    key: 'response.20.high',
+    label: '+20 events \u00b7 Wilson upper 95%',
+    group: 'Event response',
+    unit: 'ratio',
+    definition: 'Approximate Wilson upper; not a forecast interval.',
+    availability: 'measured',
+  },
+] as const;
diff --git a/apps/api/src/creator/creator-bank.math.ts b/apps/api/src/creator/creator-bank.math.ts
new file mode 100644
index 0000000..4799497
--- /dev/null
+++ b/apps/api/src/creator/creator-bank.math.ts
@@ -0,0 +1,224 @@
+import { BANK_METRICS } from './creator-bank.catalog';
+const sum = (v: number[]) => v.reduce((a, b) => a + b, 0);
+const mean = (v: number[]) => (v.length ? sum(v) / v.length : null);
+const ratio = (a: number | null, b: number | null) =>
+  a !== null && b ? a / b : null;
+const q = (v: number[], p: number) => {
+  if (!v.length) return null;
+  const s = [...v].sort((a, b) => a - b),
+    i = (s.length - 1) * p;
+  return s[Math.floor(i)] + (s[Math.ceil(i)] - s[Math.floor(i)]) * (i % 1);
+};
+const sd = (v: number[]) => {
+  if (v.length < 2) return null;
+  const center = mean(v)!;
+  return Math.sqrt(sum(v.map((x) => (x - center) ** 2)) / (v.length - 1));
+};
+const entropy = (v: number[]) => {
+  const t = sum(v);
+  return t
+    ? -sum(v.filter(Boolean).map((x) => (x / t) * Math.log2(x / t)))
+    : null;
+};
+const ess = (v: number[]) => ratio(sum(v) ** 2, sum(v.map((x) => x * x)));
+function wilson(w: number, n: number) {
+  if (!n) return [null, null];
+  const z = 1.96,
+    p = w / n,
+    d = 1 + (z * z) / n,
+    c = (p + (z * z) / (2 * n)) / d,
+    h = (z * Math.sqrt((p * (1 - p) + (z * z) / (4 * n)) / n)) / d;
+  return [Math.max(0, c - h), Math.min(1, c + h)];
+}
+/** Values describe the observable market event sequence. Identities and private capacity are never inferred. */
+export function bankMetrics(
+  points: any[],
+  asOf: number,
+  roundContribution: number | null = null,
+) {
+  const values: Record<string, number | null> = Object.fromEntries(
+    BANK_METRICS.map((m) => [m.key, null]),
+  );
+  const es = points
+    .filter(
+      (p) =>
+        /^price:\d+$/.test(p.sourceKey || '') &&
+        +p.time <= asOf &&
+        Number(p.buyVolume || 0) + Number(p.sellVolume || 0) > 0,
+    )
+    .map((p) => ({
+      id: BigInt(p.sourceKey.slice(6)),
+      time: +p.time,
+      price: Number(p.price),
+      amount: Number(p.buyVolume || 0) + Number(p.sellVolume || 0),
+      sign: Number(p.buyVolume || 0) > 0 ? 1 : -1,
+    }));
+  // Empty native event windows are known zero; imports lacking accepted-event identities are unavailable.
+  const native = points.some((p) => /^price:\d+$/.test(p.sourceKey || ''));
+  if (!native)
+    return {
+      scope: 'aggregate-priced-events',
+      values,
+      samples: 0,
+      observedAt: asOf,
+      available: false,
+    };
+  const sizes = es.map((e) => e.amount),
+    volume = sum(sizes),
+    buy = sum(es.filter((e) => e.sign > 0).map((e) => e.amount)),
+    sell = volume - buy,
+    median = q(sizes, 0.5),
+    gaps = es.slice(1).map((e, i) => (e.time - es[i].time) / 1000);
+  const set = (key: string, value: number | null) => {
+    values[key] = value !== null && Number.isFinite(value) ? value : null;
+  };
+  set('capital.contribution', roundContribution);
+  for (const [k, v] of Object.entries({
+    events: es.length,
+    volume,
+    buy,
+    sell,
+    net: buy - sell,
+    mean: mean(sizes),
+    median,
+  }))
+    set('participation.' + k, v);
+  const switches = es.slice(1).filter((e, i) => e.sign !== es[i].sign).length;
+  for (const [k, v] of Object.entries({
+    p95: q(sizes, 0.95),
+    max: sizes.length ? Math.max(...sizes) : null,
+    cv: ratio(sd(sizes), mean(sizes)),
+    mad:
+      median === null
+        ? null
+        : q(
+            sizes.map((x) => Math.abs(x - median)),
+            0.5,
+          ),
+    tail: ratio(q(sizes, 0.95), median),
+    largest: ratio(sizes.length ? Math.max(...sizes) : null, volume),
+    countEntropy: entropy([
+      es.filter((e) => e.sign > 0).length,
+      es.filter((e) => e.sign < 0).length,
+    ]),
+    volumeEntropy: entropy([buy, sell]),
+    switch: es.length > 1 ? ratio(switches, es.length - 1) : null,
+    cadence: q(gaps, 0.5),
+    cadenceCv: ratio(sd(gaps), mean(gaps)),
+    p90Cadence: q(gaps, 0.9),
+  }))
+    set('behavior.' + k, v);
+  const impacts: number[] = [],
+    aligned: number[] = [],
+    prior: number[] = [];
+  for (let i = 1; i < es.length; i++)
+    if (es[i].id === es[i - 1].id + 1n) {
+      const move = (es[i].price - es[i - 1].price) / 0.0001;
+      impacts.push(move);
+      aligned.push(move * es[i].sign);
+      if (i > 1 && es[i - 1].id === es[i - 2].id + 1n) {
+        const before = es[i - 1].price - es[i - 2].price;
+        if (before) prior.push(Math.sign(before) === es[i].sign ? 1 : 0);
+      }
+    }
+  // No causal per-account attribution is asserted; this is before/after market-event displacement.
+  const gross = impacts.length ? sum(impacts.map(Math.abs)) : null;
+  for (const [k, v] of Object.entries({
+    gross,
+    signed: impacts.length ? sum(impacts) : null,
+    aligned: aligned.length ? sum(aligned) : null,
+    mean: mean(aligned),
+    per1k:
+      aligned.length === es.length - 1 && es.length > 1
+        ? ratio(1000 * sum(aligned), sum(sizes.slice(1)))
+        : null,
+    p95: q(impacts.map(Math.abs), 0.95),
+    sd: sd(aligned),
+  }))
+    set('execution.' + k, v);
+  let longest: number[] = [];
+  for (const h of [1, 5, 20]) {
+    const response: number[] = [];
+    for (let i = 0; i + h < es.length; i++) {
+      let complete = true;
+      for (let j = i; j < i + h; j++)
+        if (es[j + 1].id !== es[j].id + 1n) {
+          complete = false;
+          break;
+        }
+      if (complete)
+        response.push((es[i].sign * (es[i + h].price - es[i].price)) / 0.0001);
+    }
+    const wins = response.filter((v) => v > 0).length,
+      [low, high] = wilson(wins, response.length);
+    for (const [k, v] of Object.entries({
+      n: response.length,
+      mean: mean(response),
+      median: q(response, 0.5),
+      positive: ratio(wins, response.length),
+      low,
+      high,
+    }))
+      set(`response.${h}.${k}`, v);
+    if (h === 20) longest = response;
+  }
+  let run = 0;
+  for (let i = es.length - 1; i >= 0 && es[i].sign === es.at(-1)!.sign; i--)
+    run++;
+  let cumulative = 0,
+    peak = 0,
+    dd = 0;
+  for (const v of longest) {
+    cumulative += v;
+    peak = Math.max(peak, cumulative);
+    dd = Math.max(dd, peak - cumulative);
+  }
+  const half = Math.floor(sizes.length / 2),
+    old = mean(sizes.slice(0, half)),
+    recent = mean(sizes.slice(half));
+  const recency = es.map((_, i) => Math.exp(-(es.length - 1 - i) / 120));
+  for (const [k, v] of Object.entries({
+    effective: ess(sizes),
+    recency: ess(recency),
+    run,
+    alignment: mean(prior),
+    drift: old && recent !== null ? recent / old - 1 : null,
+    tail20: q(longest, 0.05),
+    sd20: sd(longest),
+    dd20: longest.length ? dd : null,
+    coverage20: ratio(longest.length, es.length),
+    age: es.length ? Math.max(0, (asOf - es.at(-1)!.time) / 1000) : null,
+  }))
+    set('evidence.' + k, v);
+  return {
+    scope: 'aggregate-priced-events',
+    values,
+    samples: es.length,
+    observedAt: asOf,
+    available: true,
+  };
+}
+export function enrichBankFrames(
+  frames: any[],
+  points: any[],
+  windowSeconds: number,
+) {
+  let start = 0,
+    end = 0;
+  for (const f of frames) {
+    while (end < points.length && +points[end].time <= f.time) end++;
+    while (
+      start < end &&
+      (+points[start].time < f.time - windowSeconds * 1000 ||
+        points[start].roundId !== f.roundId)
+    )
+      start++;
+    f.data.bank = bankMetrics(
+      points.slice(start, end).filter((p) => p.roundId === f.roundId),
+      f.time,
+      f.data.market?.potBasis === 'archived-priced-events'
+        ? f.data.market.buyPot + f.data.market.sellPot
+        : null,
+    );
+  }
+}
diff --git a/apps/api/src/creator/creator-data.service.ts b/apps/api/src/creator/creator-data.service.ts
new file mode 100644
index 0000000..08e0dbb
--- /dev/null
+++ b/apps/api/src/creator/creator-data.service.ts
@@ -0,0 +1,168 @@
+import { CreatorStakeSourceService } from './creator-stake-source.service';
+import { Injectable } from '@nestjs/common';
+import { FEATURES } from '@ticktrade/tickscript';
+import { PrismaService } from '../prisma/prisma.service';
+
+export interface CreatorFrame {
+  roundId: number;
+  time: number;
+  sequence: string;
+  fresh: boolean;
+  ageMs: number;
+  source: string;
+  quality: string;
+  data: Record<string, any>;
+  prices: Array<{ time: number; value: number }>;
+}
+
+/** Read-only adapter. No engine, wallet, NPC or settlement methods are imported. */
+@Injectable()
+export class CreatorDataService {
+  private cache = new Map<
+    number,
+    { until: number; promise: Promise<CreatorFrame | null> }
+  >();
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly stakeSource: CreatorStakeSourceService,
+  ) {}
+  catalog() {
+    return FEATURES;
+  }
+  frame(windowSeconds = 30): Promise<CreatorFrame | null> {
+    const window = Math.min(300, Math.max(5, Math.floor(windowSeconds)));
+    const cached = this.cache.get(window);
+    if (cached && cached.until > Date.now()) return cached.promise;
+    if (this.cache.size > 30) this.cache.clear();
+    const promise = this.readFrame(window);
+    this.cache.set(window, { until: Date.now() + 1500, promise });
+    promise.catch(() => {
+      if (this.cache.get(window)?.promise === promise)
+        this.cache.delete(window);
+    });
+    return promise;
+  }
+  private async readFrame(window: number): Promise<CreatorFrame | null> {
+    const round = await this.prisma.battle.findFirst({
+      where: { status: 'ACTIVE' },
+      orderBy: { id: 'desc' },
+      select: {
+        id: true,
+        startPrice: true,
+        buyPot: true,
+        sellPot: true,
+        startTime: true,
+        durationSeconds: true,
+        state: true,
+      },
+    });
+    if (!round) return null;
+    // Data is cut at one timestamp. Historical labels and private account fields never enter this object.
+    const now = Date.now();
+    const asOf = new Date(now);
+    const since = new Date(Math.max(+round.startTime, now - window * 1000));
+    const [ticks, flowRows, participants] = await Promise.all([
+      this.prisma.priceTick.findMany({
+        where: {
+          battleId: round.id,
+          createdAt: {
+            gte: new Date(Math.max(+round.startTime, now - 300000)),
+            lte: asOf,
+          },
+        },
+        orderBy: { id: 'desc' },
+        take: 1500,
+        select: { id: true, price: true, createdAt: true },
+      }),
+      this.prisma.priceTick.groupBy({
+        by: ['tradeSide'],
+        where: {
+          battleId: round.id,
+          createdAt: { gte: since, lte: asOf },
+          tradeSide: { in: ['BUY', 'SELL'] },
+          tradeAmount: { not: null },
+        },
+        _sum: { tradeAmount: true },
+        _count: { _all: true },
+      }),
+      this.stakeSource.participants(round.id, asOf),
+    ]);
+    const latest = ticks[0];
+    const ageMs = latest
+      ? Math.max(0, now - +latest.createdAt)
+      : now - +round.startTime;
+    const perSecond = new Map<number, number>();
+    for (const tick of ticks.slice().reverse())
+      perSecond.set(Math.floor(+tick.createdAt / 1000), Number(tick.price));
+    const prices = Array.from(perSecond, ([time, value]) => ({ time, value }))
+      .sort((a, b) => a.time - b.time)
+      .slice(-300);
+    const windowPrices = ticks.filter((t) => +t.createdAt >= +since);
+    const first = windowPrices.at(-1);
+    const flow = {
+      buy: 0,
+      sell: 0,
+      trades: 0,
+      windowSeconds: window,
+      basis: 'persisted-priced-events',
+    };
+    for (const row of flowRows) {
+      if (row.tradeSide === 'BUY') flow.buy = Number(row._sum.tradeAmount || 0);
+      if (row.tradeSide === 'SELL')
+        flow.sell = Number(row._sum.tradeAmount || 0);
+      flow.trades += row._count._all;
+    }
+    const p = participants[0];
+    const remainingSeconds = Math.max(
+      0,
+      Math.ceil((+round.startTime + round.durationSeconds * 1000 - now) / 1000),
+    );
+    return {
+      roundId: round.id,
+      time: now,
+      sequence: `${round.id}:${latest?.id || 0}:${Math.floor(now / 1000)}`,
+      fresh:
+        !!latest &&
+        ageMs <= 10000 &&
+        round.state === 'OPEN' &&
+        remainingSeconds > 0,
+      ageMs,
+      source: 'Persisted TickTrade market records',
+      quality: !latest
+        ? 'waiting'
+        : ageMs > 10000
+          ? 'stale'
+          : ticks.length === 1500
+            ? 'bounded-history'
+            : 'observed',
+      data: {
+        market: {
+          price: Number(latest?.price || round.startPrice),
+          startPrice: Number(round.startPrice),
+          buyPot: Number(round.buyPot),
+          sellPot: Number(round.sellPot),
+          remainingSeconds,
+          phase: round.state,
+        },
+        flow,
+        participants: {
+          buy: Number(p?.buy || 0),
+          sell: Number(p?.sell || 0),
+          both: Number(p?.both || 0),
+          total: Number(p?.total || 0),
+          basis: 'active-stakes',
+        },
+        response:
+          latest && first && windowPrices.length > 1
+            ? {
+                change: Number(latest.price) - Number(first.price),
+                changePips:
+                  (Number(latest.price) - Number(first.price)) / 0.0001,
+                samples: windowPrices.length,
+              }
+            : null,
+      },
+      prices,
+    };
+  }
+}
diff --git a/apps/api/src/creator/creator-expert.service.ts b/apps/api/src/creator/creator-expert.service.ts
new file mode 100644
index 0000000..78c39b5
--- /dev/null
+++ b/apps/api/src/creator/creator-expert.service.ts
@@ -0,0 +1,525 @@
+import { CreatorStakeSourceService } from './creator-stake-source.service';
+import {
+  BadRequestException,
+  Injectable,
+  Logger,
+  NotFoundException,
+  OnModuleDestroy,
+  OnModuleInit,
+} from '@nestjs/common';
+import { PrismaService } from '../prisma/prisma.service';
+import { TradesService } from '../trades/trades.service';
+import { CreatorHistoryService } from './creator-history.service';
+import { CreatorAccessService } from './creator-access.service';
+
+/** Separate durable outbox. Existing trade, price and settlement implementations are unchanged. */
+@Injectable()
+export class CreatorExpertService implements OnModuleInit, OnModuleDestroy {
+  private timer?: ReturnType<typeof setInterval>;
+  private busy = false;
+  private logger = new Logger(CreatorExpertService.name);
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly trades: TradesService,
+    private readonly history: CreatorHistoryService,
+    private readonly access: CreatorAccessService,
+    private readonly stakeSource: CreatorStakeSourceService,
+  ) {}
+  onModuleInit() {
+    if (process.env.CREATOR_SCHEDULER_ENABLED !== 'false') {
+      this.timer = setInterval(() => void this.work(), 1500);
+      this.timer.unref();
+    }
+  }
+  onModuleDestroy() {
+    if (this.timer) clearInterval(this.timer);
+  }
+  async capabilities() {
+    const s = await this.history.settings();
+    return {
+      liveEnabled:
+        process.env.CREATOR_LIVE_TRADING_ENABLED === 'true' &&
+        s.liveExpertsEnabled,
+      orders: ['BUY', 'SELL'],
+      closePosition: false,
+      settlement: 'Existing Arena round settlement',
+      binaryLive: false,
+      restartPolicy:
+        'Unacknowledged sends require reconciliation; they are never blindly resubmitted',
+    };
+  }
+  async assertLive() {
+    if (!(await this.capabilities()).liveEnabled)
+      throw new BadRequestException(
+        'Live experts must be enabled in server configuration and Creator admin settings',
+      );
+  }
+  async work() {
+    if (this.busy) return;
+    this.busy = true;
+    try {
+      // A crash after dispatch cannot prove whether an order reached the engine.
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: {
+          mode: 'live',
+          status: 'dispatching',
+          leaseUntil: { lt: new Date() },
+        },
+        data: {
+          status: 'needs-review',
+          leaseUntil: null,
+          response: {
+            message:
+              'Dispatch was interrupted; reconcile this command before releasing its reservation',
+          },
+        },
+      });
+      const rows = await this.prisma.creatorPaperDecision.findMany({
+        where: {
+          mode: 'live',
+          status: {
+            in: [
+              'live-pending',
+              'awaiting-ack',
+              'accepted',
+              'accepted-buffered',
+              'needs-review',
+            ],
+          },
+        },
+        orderBy: { updatedAt: 'asc' },
+        take: 32,
+        include: {
+          installation: {
+            include: {
+              version: { include: { script: true } },
+              owner: { select: { isBlocked: true, isGuest: true } },
+            },
+          },
+        },
+      });
+      for (const row of rows) {
+        if (row.status === 'live-pending') await this.dispatch(row);
+        else if (row.status === 'awaiting-ack' || row.status === 'needs-review')
+          await this.reconcile(row);
+        else if (row.status === 'accepted-buffered')
+          await this.linkBuffered(row);
+        else if (row.tradeId) await this.settle(row);
+        // Rotate still-pending observations so old active stakes cannot starve newer commands.
+        await this.prisma.creatorPaperDecision.updateMany({
+          where: { id: row.id, updatedAt: row.updatedAt },
+          data: { updatedAt: new Date() },
+        });
+      }
+    } catch (e) {
+      this.logger.warn(
+        `Creator expert dispatcher: ${(e as Error).message.slice(0, 180)}`,
+      );
+    } finally {
+      this.busy = false;
+    }
+  }
+  private async dispatch(row: any) {
+    const run = row.installation;
+    if (
+      !run.enabled ||
+      run.executionMode !== 'live' ||
+      run.version.script.disabled ||
+      run.owner.isBlocked ||
+      run.owner.isGuest ||
+      !(await this.capabilities()).liveEnabled ||
+      !(await this.access.valid(run.ownerId, run.versionId, run.entitlementId))
+    ) {
+      await this.release(row, 'cancelled', {
+        message: 'Expert stopped, disabled or no longer authorized',
+      });
+      return;
+    }
+    if (Date.now() - +row.time > 10000) {
+      await this.release(row, 'expired', {
+        message: 'Signal expired before dispatch',
+      });
+      return;
+    }
+    const commandId = `creator-${row.id}`;
+    const claimed = await this.prisma.creatorPaperDecision.updateMany({
+      where: {
+        id: row.id,
+        status: 'live-pending',
+        installation: {
+          enabled: true,
+          executionMode: 'live',
+          version: { script: { disabled: false } },
+        },
+      },
+      data: {
+        status: 'dispatching',
+        commandId,
+        attempts: { increment: 1 },
+        leaseUntil: new Date(Date.now() + 90000),
+      },
+    });
+    if (!claimed.count) return;
+    try {
+      const result: any = await this.trades.executeDirectTrade(
+        run.ownerId,
+        row.roundId,
+        Number(row.amount),
+        row.side,
+        commandId,
+        null,
+        Date.now(),
+        { source: 'http', client: (run.risk as any)?.client || null },
+      );
+      await this.acceptResult(
+        { ...row, commandId, status: 'dispatching' },
+        result,
+      );
+    } catch (e) {
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: { id: row.id, status: 'dispatching' },
+        data: {
+          status: 'needs-review',
+          leaseUntil: null,
+          response: { message: (e as Error).message.slice(0, 240), commandId },
+        },
+      });
+    }
+  }
+  private async acceptResult(row: any, result: any) {
+    const tradeId = Number(result?.trade?.id || result?.stakeId || 0);
+    if (Number.isInteger(tradeId) && tradeId < 0) {
+      const buffered = (await this.stakeSource.buffered(row.roundId, true)).find(
+        (s) =>
+          s.tempStakeId === tradeId &&
+          s.userId === row.installation.ownerId &&
+          s.side === row.side,
+      );
+      if (
+        !buffered ||
+        Number(buffered.amount) <= 0 ||
+        Number(buffered.amount) > Number(row.amount)
+      )
+        throw new BadRequestException(
+          'Buffered trade acknowledgement cannot be verified',
+        );
+      await this.prisma.$transaction(async (tx) => {
+        const changed = await tx.creatorPaperDecision.updateMany({
+          where: {
+            id: row.id,
+            status: { in: ['dispatching', 'awaiting-ack', 'needs-review'] },
+          },
+          data: {
+            status: 'accepted-buffered',
+            amount: buffered.amount,
+            leaseUntil: null,
+            response: {
+              requestedAmount: Number(row.amount),
+              executedAmount: Number(buffered.amount),
+              commandId: row.commandId,
+              bufferedTrade: {
+                tempStakeId: tradeId,
+                clientStakeId: buffered.clientStakeId,
+                createdAt: new Date(buffered.createdAt).toISOString(),
+                acceptedAt: new Date(buffered.acceptedAt).toISOString(),
+                entryPrice: buffered.entryPrice,
+              },
+            },
+          },
+        });
+        if (changed.count && Number(buffered.amount) < Number(row.amount))
+          await tx.creatorInstallation.update({
+            where: { id: row.installationId },
+            data: {
+              spent: {
+                decrement: Number(row.amount) - Number(buffered.amount),
+              },
+            },
+          });
+      });
+      return;
+    }
+    if (tradeId > 0) {
+      const stake = await this.prisma.stake.findFirst({
+        where: {
+          id: tradeId,
+          userId: row.installation.ownerId,
+          battleId: row.roundId,
+          side: row.side,
+        },
+        select: { amount: true },
+      });
+      if (
+        !stake ||
+        Number(stake.amount) <= 0 ||
+        Number(stake.amount) > Number(row.amount)
+      )
+        throw new BadRequestException(
+          'Acknowledged trade does not match the reserved order',
+        );
+      await this.prisma.$transaction(async (tx) => {
+        const changed = await tx.creatorPaperDecision.updateMany({
+          where: {
+            id: row.id,
+            status: { in: ['dispatching', 'awaiting-ack', 'needs-review'] },
+          },
+          data: {
+            status: 'accepted',
+            tradeId,
+            amount: stake.amount,
+            leaseUntil: null,
+            response: {
+              requestedAmount: Number(row.amount),
+              executedAmount: Number(stake.amount),
+              partialFill: Number(stake.amount) < Number(row.amount),
+              commandId: row.commandId,
+            },
+          },
+        });
+        if (changed.count && Number(stake.amount) < Number(row.amount))
+          await tx.creatorInstallation.update({
+            where: { id: row.installationId },
+            data: {
+              spent: { decrement: Number(row.amount) - Number(stake.amount) },
+            },
+          });
+      });
+      return;
+    }
+    if (result?.success === false) {
+      await this.release(row, 'rejected', {
+        message: String(
+          result.message || result.error || 'Order rejected',
+        ).slice(0, 240),
+      });
+      return;
+    }
+    if (result?.async || result?.command_id || result?.commandId) {
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: {
+          id: row.id,
+          status: { in: ['dispatching', 'awaiting-ack', 'needs-review'] },
+        },
+        data: {
+          status: 'awaiting-ack',
+          commandId: result.commandId || result.command_id || row.commandId,
+          leaseUntil: null,
+          response: { message: 'Engine command queued' },
+        },
+      });
+      return;
+    }
+    await this.prisma.creatorPaperDecision.updateMany({
+      where: { id: row.id, status: { in: ['dispatching', 'awaiting-ack'] } },
+      data: {
+        status: 'needs-review',
+        leaseUntil: null,
+        response: { message: 'No verifiable trade acknowledgement' },
+      },
+    });
+  }
+  private async reconcile(row: any) {
+    if (row.response?.bufferedTrade) {
+      await this.linkBuffered({ ...row, status: 'accepted-buffered' });
+      return;
+    }
+    if (!row.commandId) return;
+    const status = await this.trades.getTradeCommandStatus(
+      row.installation.ownerId,
+      row.commandId,
+    );
+    if (status?.status === 'completed') {
+      await this.acceptResult(row, status.result);
+      return;
+    }
+    // Failed async commands can fail after commit; consult the durable existing idempotency record.
+    const recorded = await this.prisma.idempotencyRecord
+      .findUnique({ where: { commandId: row.commandId } })
+      .catch(() => null);
+    if (
+      recorded &&
+      recorded.userId === row.installation.ownerId &&
+      Number(recorded.resultRef)
+    ) {
+      await this.acceptResult(row, { stakeId: Number(recorded.resultRef) });
+      return;
+    }
+    if (Date.now() - +row.time > 600000)
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: { id: row.id, status: 'awaiting-ack' },
+        data: {
+          status: 'needs-review',
+          response: {
+            message: 'Acknowledgement unavailable; budget remains reserved',
+          },
+        },
+      });
+  }
+  private async linkBuffered(row: any) {
+    const persisted = await this.stakeSource.persistedBuffered(row);
+    if (persisted) {
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: {
+          id: row.id,
+          status: { in: ['accepted-buffered', 'needs-review'] },
+        },
+        data: { tradeId: persisted.id, status: 'accepted' },
+      });
+      return;
+    }
+    const battle = await this.prisma.battle.findUnique({
+      where: { id: row.roundId },
+      select: { status: true },
+    });
+    if (battle?.status !== 'ACTIVE' && Date.now() - +row.time > 120000)
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: { id: row.id, status: 'accepted-buffered' },
+        data: {
+          status: 'needs-review',
+          response: {
+            ...(row.response as any),
+            message:
+              'Accepted buffered trade needs a verified persisted stake link; no resubmission will occur',
+          },
+        },
+      });
+  }
+  private async settle(row: any) {
+    const stake = await this.prisma.stake.findFirst({
+      where: {
+        id: row.tradeId,
+        userId: row.installation.ownerId,
+        battleId: row.roundId,
+      },
+      select: { status: true, payout: true, amount: true },
+    });
+    if (stake && stake.status !== 'ACTIVE')
+      await this.prisma.creatorPaperDecision.updateMany({
+        where: { id: row.id, status: 'accepted' },
+        data: {
+          status: `settled-${stake.status.toLowerCase()}`,
+          payout: stake.payout || 0,
+          response: {
+            ...row.response,
+            actualStake: Number(stake.amount),
+            settlementSource: 'existing Arena stake record',
+          },
+        },
+      });
+  }
+  private async release(row: any, status: string, response: any) {
+    await this.prisma.$transaction(async (tx) => {
+      const changed = await tx.creatorPaperDecision.updateMany({
+        where: {
+          id: row.id,
+          status: {
+            in: ['live-pending', 'dispatching', 'awaiting-ack', 'needs-review'],
+          },
+        },
+        data: { status, response, leaseUntil: null },
+      });
+      if (changed.count)
+        await tx.creatorInstallation.update({
+          where: { id: row.installationId },
+          data: { spent: { decrement: row.amount } },
+        });
+    });
+  }
+  async stopAll(ownerId: number) {
+    return this.prisma.$transaction(async (tx) => {
+      const result = await tx.creatorInstallation.updateMany({
+        where: {
+          ownerId,
+          enabled: true,
+          executionMode: { in: ['paper', 'live'] },
+        },
+        data: { enabled: false, status: 'stopped' },
+      });
+      await tx.creatorAudit.create({
+        data: {
+          actorId: ownerId,
+          action: 'expert.stop-all',
+          targetId: String(ownerId),
+          detail: { count: result.count },
+        },
+      });
+      return result;
+    });
+  }
+  async adminStop(actorId: number, id: string, reason: string) {
+    if (
+      typeof reason !== 'string' ||
+      reason.trim().length < 5 ||
+      reason.length > 240
+    )
+      throw new BadRequestException('A reason of 5–240 characters is required');
+    await this.prisma.$transaction(async (tx) => {
+      await tx.creatorInstallation.update({
+        where: { id },
+        data: { enabled: false, status: 'stopped' },
+      });
+      await tx.creatorAudit.create({
+        data: {
+          actorId,
+          action: 'expert.admin-stopped',
+          targetId: id,
+          detail: { reason },
+        },
+      });
+    });
+    return { stopped: true };
+  }
+  async resolve(actorId: number, id: string, dto: any) {
+    const row = await this.prisma.creatorPaperDecision.findUnique({
+      where: { id },
+      include: { installation: true },
+    });
+    if (!row || row.status !== 'needs-review')
+      throw new NotFoundException('Unresolved command not found');
+    if (
+      typeof dto.reason !== 'string' ||
+      dto.reason.length < 10 ||
+      dto.reason.length > 500
+    )
+      throw new BadRequestException(
+        'Provide a reconciliation reason of 10–500 characters',
+      );
+    if (dto.tradeId) {
+      if (
+        await this.prisma.creatorPaperDecision.findFirst({
+          where: { tradeId: Number(dto.tradeId), id: { not: id } },
+        })
+      )
+        throw new BadRequestException(
+          'Trade already linked to another Creator command',
+        );
+      const stake = await this.prisma.stake.findFirst({
+        where: {
+          id: Number(dto.tradeId),
+          userId: row.installation.ownerId,
+          battleId: row.roundId,
+          side: row.side as any,
+        },
+      });
+      if (!stake)
+        throw new BadRequestException(
+          'Trade does not match this account, round and side',
+        );
+      await this.acceptResult(row, { stakeId: stake.id });
+    } else if (dto.confirm === 'NO TRADE EXECUTED')
+      await this.release(row, 'reconciled-no-trade', { message: dto.reason });
+    else
+      throw new BadRequestException(
+        'Provide a verified trade ID or explicitly attest no trade executed',
+      );
+    await this.prisma.creatorAudit.create({
+      data: {
+        actorId,
+        action: 'expert.reconciled',
+        targetId: id,
+        detail: { reason: dto.reason, tradeId: dto.tradeId || null },
+      },
+    });
+    return { resolved: true };
+  }
+}
diff --git a/apps/api/src/creator/creator-history-frame.math.ts b/apps/api/src/creator/creator-history-frame.math.ts
new file mode 100644
index 0000000..0e7ea30
--- /dev/null
+++ b/apps/api/src/creator/creator-history-frame.math.ts
@@ -0,0 +1,78 @@
+import {
+  historyEmissionIndices,
+  makeHistoryFrames,
+} from './creator-history.math';
+import { enrichBankFrames } from './creator-bank.math';
+import { enrichTraderFrames } from './creator-trader.math';
+
+export function framesFromSnapshot(snapshot: any, query: any = {}) {
+  const from = query.from ? new Date(query.from) : undefined,
+    windowSeconds = Math.min(
+      300,
+      Math.max(5, Number(query.windowSeconds) || 30),
+    );
+  const interval = Math.max(
+    1,
+    Math.min(86400, Math.floor(Number(query.interval) || 1)),
+  );
+  const points = snapshot.points.map((p: any) => ({
+    ...p,
+    time: new Date(p.time),
+  }));
+  const indices = historyEmissionIndices(points, interval);
+  const quoteFrames = indices.map((i) => ({
+    time: +points[i].time,
+    roundId: points[i].roundId,
+    data: {
+      market: {
+        price:
+          points[i].snapshot?.observed?.market?.price ??
+          Number(points[i].price),
+      },
+    },
+  }));
+  const eligible = indices.filter((i) => !from || +points[i].time >= +from);
+  const sampled = query.sampleLimit
+    ? eligible.filter(
+        (_, i) =>
+          i %
+            Math.max(
+              1,
+              Math.ceil(eligible.length / Number(query.sampleLimit)),
+            ) ===
+            0 || i === eligible.length - 1,
+      )
+    : eligible;
+  const selected = query.frameLimit
+    ? sampled.slice(-Math.max(1, Number(query.frameLimit)))
+    : sampled;
+  const frames = makeHistoryFrames(
+    points,
+    snapshot.dataset.mode,
+    windowSeconds,
+    interval,
+    new Set(selected),
+  );
+  if (!Array.isArray(query.requires) || query.requires.includes('arena.bank@1'))
+    enrichBankFrames(frames, points, windowSeconds);
+  if (snapshot.stakes !== null)
+    enrichTraderFrames(
+      frames,
+      snapshot.stakes
+        .map((s: any) => ({
+          ...s,
+          createdAt: new Date(s.acceptedAt || s.createdAt),
+        }))
+        .sort((a: any, b: any) => +a.createdAt - +b.createdAt),
+      windowSeconds,
+      quoteFrames,
+    );
+  return {
+    dataset: snapshot.dataset,
+    frames,
+    coverage: snapshot.coverage,
+    truncated: snapshot.truncated,
+    rawPoints: snapshot.rawPoints,
+    interval,
+  };
+}
