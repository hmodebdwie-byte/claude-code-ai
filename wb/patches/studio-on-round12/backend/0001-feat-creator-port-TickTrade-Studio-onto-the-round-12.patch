+import {
+  IsBoolean,
+  IsIn,
+  IsInt,
+  IsNumber,
+  IsObject,
+  IsOptional,
+  IsString,
+  IsUUID,
+  Max,
+  MaxLength,
+  Min,
+  MinLength,
+} from 'class-validator';
+
+export class ValidateScriptDto {
+  @IsString() @MinLength(1) @MaxLength(65536) source!: string;
+  @IsOptional() @IsObject() params?: Record<string, number | boolean>;
+}
+export class SaveScriptDto extends ValidateScriptDto {
+  @IsOptional() @IsUUID() scriptId?: string;
+}
+export class InstallScriptDto {
+  @IsOptional() @IsString() @MaxLength(80) datasetId?: string;
+  @IsOptional() @IsIn(['signals', 'paper', 'live']) executionMode?: string;
+  @IsOptional() @IsString() @MaxLength(40) confirmLive?: string;
+  @IsOptional() @IsObject() risk?: Record<string, number>;
+
+  @IsUUID() versionId!: string;
+  @IsString() @MinLength(8) @MaxLength(80) clientKey!: string;
+  @IsOptional() @IsObject() params?: Record<string, number | boolean>;
+  @IsOptional() @IsBoolean() chart?: boolean;
+  @IsOptional() @IsBoolean() card?: boolean;
+  @IsOptional() @IsBoolean() paper?: boolean;
+  @IsOptional()
+  @IsNumber({ maxDecimalPlaces: 2 })
+  @Min(1)
+  @Max(100000)
+  budget?: number;
+  @IsOptional()
+  @IsNumber({ maxDecimalPlaces: 2 })
+  @Min(0.01)
+  @Max(10000)
+  maxStake?: number;
+  @IsOptional() @IsInt() @Min(5) @Max(300) minIntervalSec?: number;
+}
+export class UpdateInstallationDto {
+  @IsOptional() @IsIn(['signals', 'paper', 'live']) executionMode?: string;
+  @IsOptional() @IsString() @MaxLength(40) confirmLive?: string;
+
+  @IsOptional() @IsBoolean() enabled?: boolean;
+  @IsOptional() @IsBoolean() chart?: boolean;
+  @IsOptional() @IsBoolean() card?: boolean;
+}
+export class RevokeScriptDto {
+  @IsBoolean() disabled!: boolean;
+  @IsString() @MinLength(5) @MaxLength(240) reason!: string;
+}
+
+export class ConfigureInstallationDto {
+  @IsOptional() @IsObject() params?: Record<string, number | boolean>;
+  @IsOptional() @IsObject() risk?: Record<string, number>;
+  @IsOptional()
+  @IsNumber({ maxDecimalPlaces: 2 })
+  @Min(1)
+  @Max(100000)
+  budget?: number;
+  @IsOptional()
+  @IsNumber({ maxDecimalPlaces: 2 })
+  @Min(0.01)
+  @Max(10000)
+  maxStake?: number;
+  @IsOptional() @IsInt() @Min(5) @Max(300) minIntervalSec?: number;
+}
+
+export class CreatorFeedDto {
+  @IsObject() known!: Record<
+    string,
+    { revision: string; epoch: string; after: number }
+  >;
+}
