+            : key.startsWith("network.")
+              ? "observed-network"
+              : "observed-window",
+        reason,
+      };
+    }
+    // The archive does not link each account stake to its exact price transition.
+    for (const key of [
+      "impact.grossImpactPips",
+      "impact.signedImpactPips",
+      "impact.alignedImpactPips",
+      "impact.impactEfficiency",
+      "impact.causalContributionShare",
+      "impact.controlContribution",
+      "impact.liquidityDemandBps",
+      ...Object.keys(record.causalLab).map((k) => "causalLab." + k),
+    ]) {
+      put(record, key, null);
+      provenance[key] = {
+        source: "unavailable",
+        reason:
+          "Requires a linked authoritative before/after price transition or counterfactual replay; entry prices alone cannot establish this.",
+      };
+    }
+    if (!events.length) {
+      for (const group of [
+        "behavior",
+        "executionQuality",
+        "behavioralSignature",
+        "graph",
+        "microstructure",
+        "surveillance",
+      ])
+        for (const key of Object.keys(record[group]))
+          put(record, group + "." + key, null);
+    }
+    // The reference's scores are exploratory models, not out-of-sample calibration.
+    if (record.forecast.readiness === null) {
+      for (const key of [
+        "continuationProbability",
+        "reversalProbability",
+        "neutralProbability",
+      ]) {
+        record.forecast[key] = null;
+        provenance["forecast." + key] = {
+          source: "unavailable",
+          reason:
+            "The reference probability model is missing required inputs; no equal-probability fallback is published.",
+        };
+      }
+    }
+    record.forecast.status = "RESEARCH MODEL";
+    record.modelAudit.productionGate = "VALIDATION REQUIRED";
+    record.modelAudit.productionGateScore = null;
+    record.modelAudit.privacyGate = "PSEUDONYMOUS";
+    record.intelligence.release = "OBSERVED INPUTS · REFERENCE MODELS";
+    record.intelligence.source = "ACCEPTED STAKES + SETTLED OUTCOMES";
