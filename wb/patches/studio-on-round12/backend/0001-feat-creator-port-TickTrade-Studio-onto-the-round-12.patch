+    rows.splice(5000);
+    const last = rows.at(-1);
+    return json({
+      schemaVersion: 1,
+      datasetId: id,
+      metadata: {
+        ...(dataset.metadata as any),
+        sourceDataset: id,
+        exportFence: String(fence),
+      },
+      rows: rows.map((r) => ({
