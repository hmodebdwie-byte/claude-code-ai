+  async addReview(ownerId: number, id: string, dto: any) {
+    if (
+      !Number.isInteger(dto.rating) ||
+      dto.rating < 1 ||
+      dto.rating > 5 ||
+      !safeString(dto.body, 2000)
+    )
+      throw new BadRequestException('Rating 1–5 and a review are required');
+    if (
+      !(await this.prisma.creatorEntitlement.findFirst({
+        where: { ownerId, listingId: id },
+      }))
+    )
+      throw new ForbiddenException('Acquire this package before reviewing');
+    return this.prisma.creatorReview.upsert({
+      where: { ownerId_listingId: { ownerId, listingId: id } },
+      create: { ownerId, listingId: id, rating: dto.rating, body: dto.body },
+      update: { rating: dto.rating, body: dto.body },
+    });
+  }
+  async grant(actorId: number, dto: any) {
+    if (
+      !Number.isInteger(dto.ownerId) ||
+      dto.ownerId <= 0 ||
+      !safeString(dto.reason, 500) ||
+      dto.reason.length < 5
+    )
+      throw new BadRequestException('User ID and reason are required');
+    const listing = await this.prisma.creatorListing.findUnique({
+      where: { id: dto.listingId },
+    });
+    if (!listing) throw new NotFoundException('Listing not found');
+    const expiresAt = dto.expiresAt ? new Date(dto.expiresAt) : null;
+    if (expiresAt && (!Number.isFinite(+expiresAt) || +expiresAt <= Date.now()))
+      throw new BadRequestException('Expiry must be in the future');
+    if (!(await this.prisma.user.findUnique({ where: { id: dto.ownerId } })))
+      throw new NotFoundException('User not found');
+    return this.prisma.$transaction(async (tx) => {
+      const e = await tx.creatorEntitlement.create({
+        data: {
+          ownerId: dto.ownerId,
+          listingId: listing.id,
+          versionId: listing.versionId,
+          source: 'admin-grant',
+          expiresAt,
+        },
+      });
+      await tx.creatorAudit.create({
+        data: {
+          actorId,
+          action: 'license.granted',
+          targetId: e.id,
+          detail: { reason: dto.reason, ownerId: dto.ownerId },
+        },
+      });
+      return e;
+    });
+  }
+  async revoke(actorId: number, id: string, reason: string) {
+    if (!safeString(reason, 500) || reason.length < 5)
+      throw new BadRequestException('Reason required');
+    return this.prisma.$transaction(async (tx) => {
+      const e = await tx.creatorEntitlement.update({
+        where: { id },
+        data: { status: 'revoked' },
+      });
+      await tx.creatorInstallation.updateMany({
+        where: { entitlementId: id },
+        data: { enabled: false, status: 'license-revoked' },
+      });
+      await tx.creatorAudit.create({
+        data: {
+          actorId,
+          action: 'license.revoked',
+          targetId: id,
+          detail: { reason },
+        },
+      });
+      return e;
+    });
+  }
+  async webhook(raw: Buffer | undefined, signature: string | undefined) {
+    if (!raw || !signature || !process.env.CREATOR_STRIPE_WEBHOOK_SECRET)
+      throw new BadRequestException('Missing signed webhook');
+    const stripe = this.stripe();
+    let event: Stripe.Event;
+    try {
+      event = stripe.webhooks.constructEvent(
+        raw,
+        signature,
+        process.env.CREATOR_STRIPE_WEBHOOK_SECRET,
+      );
+    } catch {
+      throw new BadRequestException('Invalid webhook signature');
+    }
+    if (
+      await this.prisma.creatorWebhookEvent.findUnique({
+        where: { id: event.id },
+      })
+    )
+      return { received: true, duplicate: true };
+    const object: any = event.data.object,
+      idOf = (v: any): string | null =>
+        typeof v === 'string' ? v : v?.id || null;
+    const invoiceSubscription = (v: any) =>
+      idOf(v?.subscription || v?.parent?.subscription_details?.subscription);
+    const periodEnd = (invoice: any, subscription: any) => {
+      const periods = (invoice?.lines?.data || [])
+        .filter(
+          (l: any) =>
+            l.type === 'subscription' ||
+            l.parent?.type === 'subscription_item_details' ||
+            l.subscription,
+        )
+        .map((l: any) => Number(l.period?.end))
+        .filter(Number.isFinite);
+      const fallback = Number(
+        subscription?.current_period_end ||
+          subscription?.items?.data?.[0]?.current_period_end,
+      );
+      const value = periods.length ? Math.min(...periods) : fallback;
+      if (!Number.isFinite(value) || value <= 0)
+        throw new BadRequestException('Missing paid subscription period');
+      return new Date(value * 1000);
+    };
+    let session: any = null,
+      subscription: any = null,
+      invoice: any = null,
+      refundPaymentId: string | null = null,
+      refundPurchaseId: string | null = null,
+      refundSubscriptionId: string | null = null;
+    if (
+      [
+        'checkout.session.completed',
+        'checkout.session.async_payment_succeeded',
+      ].includes(event.type)
+    ) {
+      session = await stripe.checkout.sessions.retrieve(object.id);
+      if (session.subscription) {
+        subscription = await stripe.subscriptions.retrieve(
+          idOf(session.subscription)!,
+        );
+        const id = idOf(session.invoice || subscription.latest_invoice);
+        if (id) invoice = await stripe.invoices.retrieve(id);
+      }
+    }
+    if (event.type === 'invoice.paid') {
+      invoice = await stripe.invoices.retrieve(object.id);
+      const id = invoiceSubscription(invoice);
+      if (id) subscription = await stripe.subscriptions.retrieve(id);
+    }
+    if (
+      [
+        'customer.subscription.updated',
+        'customer.subscription.deleted',
+      ].includes(event.type)
+    )
+      subscription = await stripe.subscriptions.retrieve(object.id);
+    if (['charge.refunded', 'charge.dispute.created'].includes(event.type)) {
+      const charge: any =
+        event.type === 'charge.dispute.created'
+          ? await stripe.charges.retrieve(idOf(object.charge)!)
+          : object;
+      refundPaymentId = idOf(charge.payment_intent);
+      if (refundPaymentId) {
+        const payment: any =
+          await stripe.paymentIntents.retrieve(refundPaymentId);
+        refundPurchaseId = payment.metadata?.creatorPurchaseId || null;
+      }
+      if (charge.invoice) {
+        const bill: any = await stripe.invoices.retrieve(idOf(charge.invoice)!);
+        refundSubscriptionId = invoiceSubscription(bill);
+        if (refundSubscriptionId) {
+          const sub: any =
+            await stripe.subscriptions.retrieve(refundSubscriptionId);
+          refundPurchaseId =
+            refundPurchaseId || sub.metadata?.creatorPurchaseId || null;
+        }
+      }
+      if (refundPurchaseId && !/^[0-9a-f-]{36}$/i.test(refundPurchaseId))
+        refundPurchaseId = null;
+    }
+    try {
+      return await this.prisma.$transaction(
+        async (tx) => {
+          await tx.creatorWebhookEvent.create({
+            data: { id: event.id, type: event.type },
+          });
+          if (session?.payment_status === 'paid') {
+            if (!/^[0-9a-f-]{36}$/i.test(session.client_reference_id || ''))
+              throw new BadRequestException('Missing Creator order reference');
+            await tx.$queryRaw`SELECT id FROM creator_purchases WHERE id=${session.client_reference_id}::uuid FOR UPDATE`;
+            const purchase = await tx.creatorPurchase.findUnique({
+              where: { id: session.client_reference_id },
+            });
+            if (
+              !purchase ||
+              purchase.checkoutId !== session.id ||
+              session.amount_total !== purchase.priceCents ||
+              session.currency !== purchase.currency
+            )
+              throw new BadRequestException(
+                'Checkout receipt does not match a Creator order',
+              );
+            if (purchase.status === 'pending') {
+              if (
+                purchase.license === 'subscription' &&
+                (!subscription || invoice?.status !== 'paid')
+              )
+                throw new BadRequestException(
+                  'Subscription payment is not verified',
+                );
+              const expiresAt =
+                purchase.license === 'subscription'
+                  ? periodEnd(invoice, subscription)
+                  : purchase.license === 'rental'
+                    ? new Date(Date.now() + purchase.rentalDays * 86400000)
+                    : null;
+              const entitlement = await tx.creatorEntitlement.create({
+                data: {
+                  ownerId: purchase.ownerId,
+                  listingId: purchase.listingId,
+                  versionId: purchase.versionId,
+                  source: 'stripe',
+                  expiresAt,
+                  subscriptionId: subscription?.id || null,
+                },
+              });
+              await tx.creatorPurchase.update({
+                where: { id: purchase.id },
+                data: {
+                  status: 'paid',
+                  paymentId: idOf(session.payment_intent),
+                  entitlementId: entitlement.id,
+                },
+              });
+              await tx.creatorAudit.create({
+                data: {
+                  actorId: purchase.ownerId,
+                  action: 'market.purchase-paid',
+                  targetId: purchase.id,
+                  detail: { entitlementId: entitlement.id, eventId: event.id },
+                },
+              });
+            }
+          }
+          if (subscription) {
+            const active = ['active', 'trialing'].includes(subscription.status);
+            const rows = await tx.creatorEntitlement.findMany({
+              where: { subscriptionId: subscription.id },
+            });
+            for (const e of rows) {
+              if (e.status === 'revoked') continue;
+              if (
+                event.type === 'invoice.paid' &&
+                active &&
+                invoice.status === 'paid'
+              ) {
+                const purchase = await tx.creatorPurchase.findFirst({
+                  where: { entitlementId: e.id, status: 'paid' },
+                });
+                if (
+                  purchase &&
+                  invoice.currency === purchase.currency &&
+                  invoice.amount_paid >= purchase.priceCents
+                ) {
+                  const paidUntil = periodEnd(invoice, subscription);
+                  // Late delivery of an old paid invoice cannot shorten access or grant an unpaid period.
+                  if (!e.expiresAt || paidUntil > e.expiresAt)
+                    await tx.creatorEntitlement.update({
+                      where: { id: e.id },
+                      data: { status: 'active', expiresAt: paidUntil },
+                    });
+                }
+              } else if (!active)
+                await tx.creatorEntitlement.update({
+                  where: { id: e.id },
+                  data: { status: 'expired' },
+                });
+            }
+          }
+          if (
+            ['charge.refunded', 'charge.dispute.created'].includes(event.type)
+          ) {
+            const bySubscription = refundSubscriptionId
+              ? await tx.creatorEntitlement.findMany({
+                  where: { subscriptionId: refundSubscriptionId },
+                  select: { id: true },
+                })
+              : [];
+            const or: any[] = [
+              ...(refundPaymentId ? [{ paymentId: refundPaymentId }] : []),
+              ...(refundPurchaseId ? [{ id: refundPurchaseId }] : []),
+              ...(bySubscription.length
+                ? [{ entitlementId: { in: bySubscription.map((e) => e.id) } }]
+                : []),
+            ];
+            if (or.length) {
+              const purchases = await tx.creatorPurchase.findMany({
+                where: { OR: or },
+              });
+              for (const p of purchases) {
+                await tx.$queryRaw`SELECT id FROM creator_purchases WHERE id=${p.id}::uuid FOR UPDATE`;
+                const latest = await tx.creatorPurchase.update({
+                  where: { id: p.id },
+                  data: {
+                    status:
+                      event.type === 'charge.refunded'
+                        ? 'refunded'
+                        : 'disputed',
+                  },
+                });
+                if (latest.entitlementId) {
+                  await tx.creatorEntitlement.update({
+                    where: { id: latest.entitlementId },
+                    data: { status: 'revoked' },
+                  });
+                  await tx.creatorInstallation.updateMany({
+                    where: { entitlementId: latest.entitlementId },
+                    data: { enabled: false, status: 'license-revoked' },
+                  });
+                }
+                await tx.creatorAudit.create({
+                  data: {
+                    actorId: p.ownerId,
+                    action: 'market.payment-reversed',
+                    targetId: p.id,
+                    detail: { eventId: event.id, type: event.type },
+                  },
+                });
+              }
+            }
+          }
+          return { received: true };
+        },
+        { timeout: 15000 },
+      );
+    } catch (e) {
+      if (
+        (e as any).code === 'P2002' &&
+        (await this.prisma.creatorWebhookEvent.findUnique({
+          where: { id: event.id },
+        }))
+      )
+        return { received: true, duplicate: true };
+      throw e;
+    }
+  }
+  async reviewSource(actorId: number, id: string) {
+    const listing = await this.prisma.creatorListing.findUnique({
+      where: { id },
+    });
+    if (!listing) throw new NotFoundException('Listing not found');
+    const version = await this.prisma.creatorVersion.findUnique({
+      where: { id: listing.versionId },
+      select: {
+        id: true,
+        hash: true,
+        revision: true,
+        manifest: true,
+        source: true,
+      },
+    });
+    await this.prisma.creatorAudit.create({
+      data: {
+        actorId,
+        action: 'market.source-reviewed',
+        targetId: id,
+        detail: { versionId: listing.versionId },
+      },
+    });
+    return { listing, version };
+  }
+  adminListings() {
+    return this.prisma.creatorListing.findMany({
+      orderBy: { updatedAt: 'desc' },
+      take: 200,
+    });
+  }
+  adminLicenses() {
+    return this.prisma.creatorEntitlement.findMany({
+      orderBy: { createdAt: 'desc' },
+      take: 200,
+    });
+  }
+}
