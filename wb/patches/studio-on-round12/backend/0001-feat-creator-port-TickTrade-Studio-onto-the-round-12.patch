+          let spent = Number(run.spent),
+            lastDecisionAt = run.lastDecisionAt;
+          const decisions: any[] = [];
+          if (run.paper || run.executionMode === 'live') {
+            for (const signal of output.signals) {
+              const amount = Math.round(signal.amount * 100) / 100;
+              const acceptedStatus =
+                run.executionMode === 'live'
+                  ? 'live-pending'
+                  : 'paper-recorded';
+              let status = acceptedStatus;
+              if (amount > Number(run.maxStake)) status = 'stake-limit';
+              else if (spent + amount > Number(run.budget))
+                status = 'budget-limit';
+              else if (
+                lastDecisionAt &&
+                frame.time - +lastDecisionAt < run.minIntervalSec * 1000
+              )
+                status = 'cooldown';
+              const risk = run.risk as any;
+              if (
+                status === acceptedStatus &&
+                (risk.maxPerRound ||
+                  risk.maxOrdersPerRound ||
+                  risk.maxPerDay ||
+                  risk.lossStop)
+              ) {
+                const recent = await tx.creatorPaperDecision.findMany({
+                  where: {
+                    installationId: id,
+                    time: { gte: new Date(frame.time - 86400000) },
+                    status: {
+                      in: [
+                        'live-pending',
+                        'dispatching',
+                        'awaiting-ack',
+                        'needs-review',
+                        'accepted',
+                        'accepted-buffered',
+                        'paper-recorded',
+                        'settled-won',
+                        'settled-lost',
+                        'settled-refunded',
+                      ],
+                    },
+                  },
+                  select: {
+                    amount: true,
+                    roundId: true,
+                    payout: true,
+                    status: true,
+                  },
+                });
+                const thisRound = recent.filter(
+                  (d) => d.roundId === frame.roundId,
+                );
+                const roundSpend =
+                  thisRound.reduce((a, d) => a + Number(d.amount), 0) +
+                  decisions
+                    .filter((d) => d.status === acceptedStatus)
+                    .reduce((a, d) => a + d.amount, 0);
+                const daySpend =
+                  recent.reduce((a, d) => a + Number(d.amount), 0) +
+                  decisions
+                    .filter((d) => d.status === acceptedStatus)
+                    .reduce((a, d) => a + d.amount, 0);
+                const losses = recent
+                  .filter((d) => d.payout !== null)
+                  .reduce((a, d) => a + Number(d.amount) - Number(d.payout), 0);
+                if (risk.maxPerRound && roundSpend + amount > risk.maxPerRound)
+                  status = 'round-budget';
+                else if (
+                  risk.maxOrdersPerRound &&
+                  thisRound.length +
+                    decisions.filter((d) => d.status === acceptedStatus)
+                      .length >=
+                    risk.maxOrdersPerRound
+                )
+                  status = 'round-order-limit';
+                else if (risk.maxPerDay && daySpend + amount > risk.maxPerDay)
+                  status = 'daily-budget';
+                else if (risk.lossStop && losses >= risk.lossStop)
+                  status = 'loss-stop';
+              }
+              if (status === acceptedStatus) {
+                spent += amount;
+                lastDecisionAt = new Date(frame.time);
+              }
+              decisions.push({
+                installationId: id,
+                eventKey: `${frame.sequence}:${signal.id}`,
+                roundId: frame.roundId,
+                side: signal.side,
+                amount,
+                referencePrice: frame.data.market.price,
+                reason: signal.reason,
+                status,
+                mode: run.executionMode === 'live' ? 'live' : 'paper',
+                time: new Date(frame.time),
+              });
+            }
+          }
+          const markerSignals =
+            run.paper || run.executionMode === 'live'
+              ? decisions.filter((d) =>
+                  ['paper-recorded', 'live-pending'].includes(d.status),
+                )
+              : output.signals;
+          history.$signals = [
+            ...(history.$signals || []),
+            ...markerSignals.map((s: any) => ({
+              time: Math.floor(frame.time / 1000),
+              side: s.side,
+              paper: run.paper,
+            })),
+          ].slice(-100);
+          const { state, signals, ...display } = output;
+          const changed = await tx.creatorInstallation.updateMany({
+            where: {
+              id,
+              enabled: true,
+              updatedAt: run.updatedAt,
+              version: { script: { disabled: false } },
+            },
+            data: {
+              state,
+              output: {
+                ...display,
+                signals,
+                time: frame.time,
+                roundId: frame.roundId,
+                source: frame.source,
+                quality: frame.quality,
+              },
+              history,
+              roundId: frame.roundId,
+              lastSequence: frame.sequence,
+              status: 'running',
+              error: null,
+              spent,
+              lastDecisionAt,
+            },
+          });
+          if (changed.count && decisions.length) {
+            await tx.creatorPaperDecision.createMany({
+              data: decisions,
+              skipDuplicates: true,
+            });
+          }
+        },
+        { timeout: 15000, maxWait: 2000 },
+      );
+    } catch (e) {
+      const message = (e as Error).message;
+      // A process deadline/crash is an infrastructure failure, not proof that
+      // user code is invalid. QuickJS code/CPU/memory failures arrive as diagnostics
+      // above and stop the run; transient infrastructure errors retry with backoff.
+      this.retryAfter.set(id, Date.now() + 3000);
+      this.logger.warn(`Creator run ${id}: ${message.slice(0, 180)}`);
+      await this.prisma.creatorInstallation
+        .updateMany({
+          where: { id, enabled: true },
+          data: {
+            status: 'waiting',
+            error: 'Runtime temporarily unavailable; retrying automatically',
+          },
+        })
+        .catch(() => {});
+    }
+  }
+  liveFrame(window = 30, requires?: string[]): Promise<any> {
+    const seconds = Math.min(300, Math.max(5, Math.floor(window)));
+    const key = `${seconds}:${requires ? [...requires].sort().join(',') : '*'}`;
+    const cached = this.liveCache.get(key);
+    if (cached && cached.until > Date.now()) return cached.promise;
+    if (this.liveCache.size > 64) this.liveCache.clear();
+    const promise = this.readLiveFrame(seconds, requires);
+    this.liveCache.set(key, { until: Date.now() + 1200, promise });
+    promise.catch(() => {
+      if (this.liveCache.get(key)?.promise === promise)
+        this.liveCache.delete(key);
+    });
+    return promise;
+  }
+  private async readLiveFrame(window = 30, requires?: string[]) {
+    const frame = await this.data.frame(window);
+    if (!frame) return null;
+    const direct = [
+      'arena.market@1',
+      'arena.flow@1',
+      'arena.participants@1',
+      'arena.response@1',
+    ];
+    if (requires?.every((id) => direct.includes(id))) return frame;
+    try {
+      const archived = await this.historyData.frames('arena-live', {
+        to: new Date(frame.time).toISOString(),
+        windowSeconds: window,
+        pointLimit: 5000,
+        roundId: frame.roundId,
+        frameLimit: 1,
+        requires,
+        omitCoverage: true,
+      });
+      const previous = archived.frames.at(-1);
+      if (previous) {
+        // data.frame() is shared across scripts. Do not mutate its cached object
+        // with a particular script's historical feature set.
+        return {
+          ...frame,
+          data: {
+            ...previous.data,
+            ...frame.data,
+            quality: {
+              ...previous.data.quality,
+              archiveAgeMs: frame.time - previous.time,
+            },
+          },
+        };
+      }
+    } catch {
+      /* Recording can initialize after the first active round; original observed features still work. */
+    }
+    return frame;
+  }
+  async warmup(id: string) {
+    if (this.warming.has(id)) return;
+    this.warming.add(id);
+    try {
+      await this.calculateWarmup(id);
+    } finally {
+      this.warming.delete(id);
+    }
+  }
+  private async calculateWarmup(id: string) {
+    const run = await this.prisma.creatorInstallation.findUnique({
+      where: { id },
+      include: { version: true },
+    });
+    if (!run || run.warmupStatus !== 'pending') return;
+    try {
+      await this.historyData.ensureDataset();
+      const manifest = run.version.manifest as any,
+        limit = Math.min(5000, Math.max(0, manifest.warmupBars ?? 600));
+      const data = await this.historyData.frames(run.datasetId, {
+        windowSeconds: Number((run.params as any).windowSeconds || 30),
+        pointLimit: Math.min(50000, Math.max(5000, limit * 10)),
+        frameLimit: limit || 1,
+        requires: manifest.requires,
+        omitCoverage: true,
+      });
+      const frames = limit ? data.frames.slice(-limit) : [];
+      let state: any = {},
+        lastRound: number | null = null;
+      const outputs: any[] = [];
+      for (let i = 0; i < frames.length; i += 50) {
+        const result = await this.historyPool.execute({
+          source: run.version.source,
+          params: run.params,
+          frames: frames.slice(i, i + 50),
+          state,
+          previousRoundId: lastRound,
+        });
+        if (!result.ok) {
+          const error = Error(
+            result.diagnostics.map((d) => d.message).join('; '),
+          );
+          (error as any).scriptFailure = true;
+          throw error;
+        }
+        outputs.push(...result.outputs!);
+        state = result.state;
+        lastRound = result.lastRound ?? null;
+      }
+      const usable = outputs.filter((o) => o.output),
+        last = usable.at(-1),
+        missing = outputs.filter((o) => o.missing);
+      await this.prisma.creatorInstallation.updateMany({
+        where: { id, updatedAt: run.updatedAt, warmupStatus: 'pending' },
+        data: {
+          warmupStatus: missing.length ? 'partial' : 'ready',
+          warmupInfo: {
+            completedAt: new Date().toISOString(),
+            requested: limit,
+            frames: frames.length,
+            calculated: usable.length,
+            missingFrames: missing.length,
+            missingFeatures: [...new Set(missing.flatMap((o) => o.missing))],
+            truncated: data.truncated,
+            asOf: frames.at(-1)?.time || null,
+          },
+          history: appendPlotHistory({}, outputs, 3000),
+          state,
+          ...(last
+            ? {
+                output: {
+                  ...last.output,
+                  time: last.time,
+                  roundId: last.roundId,
+                  quality: 'historical-warmup',
+                },
+                roundId: last.roundId,
+                lastSequence: last.sequence,
+              }
+            : {}),
+          status: run.enabled ? 'waiting' : 'stopped',
+          error: null,
+        },
+      });
+    } catch (e) {
+      const scriptFailure = !!(e as any).scriptFailure;
+      if (!scriptFailure) this.retryAfter.set(id, Date.now() + 3000);
+      await this.prisma.creatorInstallation.updateMany({
+        where: { id, updatedAt: run.updatedAt, warmupStatus: 'pending' },
+        data: scriptFailure
+          ? {
+              warmupStatus: 'failed',
+              enabled: false,
+              status: 'error',
+              error: `Historical warmup: ${(e as Error).message.slice(0, 400)}`,
+            }
+          : {
+              status: 'waiting',
+              error:
+                'History preparation temporarily unavailable; retrying automatically',
+            },
+      });
+    }
+  }
+  async reloadHistory(ownerId: number, id: string) {
+    const found = await this.prisma.creatorInstallation.updateMany({
+      where: { id, ownerId },
+      data: { warmupStatus: 'pending' },
+    });
+    if (!found.count) throw new NotFoundException('Installation not found');
+    return { queued: true };
+  }
+  async overview() {
+    const [packages, active, paper, errors] = await Promise.all([
+      this.prisma.creatorScript.count(),
+      this.prisma.creatorInstallation.count({ where: { enabled: true } }),
+      this.prisma.creatorInstallation.count({
+        where: { enabled: true, paper: true },
+      }),
+      this.prisma.creatorInstallation.count({ where: { status: 'error' } }),
+    ]);
+    return {
+      packages,
+      active,
+      paper,
+      errors,
+      runner: this.pool.stats(),
+      liveExecution: process.env.CREATOR_LIVE_TRADING_ENABLED === 'true',
+      history: true,
+      binary: 'design-and-historical-research',
+      feed: 'Read-only persisted market records',
+      schedulerEnabled: process.env.CREATOR_SCHEDULER_ENABLED !== 'false',
+    };
+  }
+  adminPackages() {
+    return this.prisma.creatorScript.findMany({
+      orderBy: { updatedAt: 'desc' },
+      take: 100,
+      include: {
+        versions: {
+          orderBy: { revision: 'desc' },
+          take: 1,
+          select: { id: true, revision: true, manifest: true, hash: true },
+        },
+      },
+    });
+  }
+  async adminRuns() {
+    const rows = await this.prisma.creatorInstallation.findMany({
+      orderBy: { updatedAt: 'desc' },
+      take: 100,
+      include: { version: { select: { manifest: true, revision: true } } },
+    });
+    return rows.map((r) => {
+      const { history, output, ...rest } = this.publicInstallation(r);
+      return rest;
+    });
+  }
+  audit() {
+    return this.prisma.creatorAudit.findMany({
+      orderBy: { createdAt: 'desc' },
+      take: 100,
+    });
+  }
+  async revoke(actorId: number, id: string, disabled: boolean, reason: string) {
+    return this.prisma.$transaction(async (tx) => {
+      const row = await tx.creatorScript.findUnique({ where: { id } });
+      if (!row) throw new NotFoundException('Package not found');
+      await tx.creatorScript.update({ where: { id }, data: { disabled } });
+      if (disabled)
+        await tx.creatorInstallation.updateMany({
+          where: { version: { scriptId: id } },
+          data: { enabled: false, status: 'revoked', error: reason },
+        });
+      await tx.creatorAudit.create({
+        data: {
+          actorId,
+          action: disabled ? 'script.revoked' : 'script.restored',
+          targetId: id,
+          detail: { reason },
+        },
+      });
+      return { disabled };
+    });
+  }
+}
