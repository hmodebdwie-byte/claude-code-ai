+          where: { datasetId: id },
+          orderBy: { id: 'desc' },
+          select: { id: true },
+        })
+      )?.id ??
+      0n;
+    const rows = await this.prisma.creatorHistoryTick.findMany({
+      where: {
+        datasetId: id,
+        id: { lte: fence },
+        time: { ...(from ? { gte: from } : {}), ...(to ? { lte: to } : {}) },
+        ...(cursor
+          ? {
+              OR: [
+                { time: { gt: cursor.time } },
+                { time: cursor.time, id: { gt: cursor.id } },
+              ],
+            }
+          : {}),
+      },
+      orderBy: [{ time: 'asc' }, { id: 'asc' }],
+      take: 5001,
+    });
