+const { test, after } = require("node:test");
+const assert = require("node:assert/strict");
+const { ScriptPool, parametersFor, validateOutput } = require("..");
+const pool = new ScriptPool();
+after(() => pool.close());
+const frame = {
+  roundId: 7,
+  time: 1700000000000,
+  sequence: "7:100",
+  fresh: true,
+  data: {
+    market: {
+      price: 1.25,
+      startPrice: 1.2,
+      buyPot: 100,
+      sellPot: 90,
+      remainingSeconds: 120,
+      phase: "OPEN",
+    },
+    flow: {
+      buy: 72,
+      sell: 28,
+      trades: 10,
+      windowSeconds: 30,
+      basis: "persisted-priced-events",
+    },
+    secret: "must not be passed",
+  },
+};
+const make = (body, extra = "") =>
+  `import { defineIndicator } from '@ticktrade/sdk'; export default defineIndicator({sdkVersion:'1',name:'Test',description:'Runtime contract test',kind:'indicator',modes:['arena'],requires:['arena.market@1'],${extra}onUpdate(ctx){${body}}});`;
+test("typed script returns identical values for identical inputs and explicit state", async () => {
+  const source = make(
+    "const n=Number(ctx.state.n||0)+1; return {state:{n},plots:[{id:'quote',label:'Quote',placement:'overlay',value:ctx.data.market!.price+n}],card:{title:'Quote',metrics:[{label:'Value',value:ctx.data.market!.price+n}]}};",
+  );
+  const a = await pool.execute({ source, frame, state: { n: 4 } }),
+    b = await pool.execute({ source, frame, state: { n: 4 } });
+  assert.equal(a.ok, true);
+  assert.deepEqual(a.output, b.output);
+  assert.equal(a.output.plots[0].value, a.output.card.metrics[0].value);
+  assert.equal(a.output.state.n, 5);
+});
+test("only declared data is supplied; Node and network APIs are unavailable", async () => {
+  const r = await pool.execute({
+    source: make(
+      "return {card:{title:'Isolation',metrics:[{label:'secret',value:typeof (ctx.data as any).secret},{label:'flow',value:typeof ctx.data.flow},{label:'process',value:typeof (globalThis as any).process},{label:'fetch',value:typeof (globalThis as any).fetch}]}};",
+    ),
+    frame,
+  });
+  assert.equal(r.ok, true);
+  assert.deepEqual(
+    r.output.card.metrics.map((x) => x.value),
+    ["undefined", "undefined", "undefined", "undefined"],
+  );
+});
+test("external imports and undeclared types produce line diagnostics", async () => {
+  const r = await pool.execute({
+    source: "import fs from 'node:fs';\n" + make("return {};"),
+    inspect: true,
+  });
+  assert.equal(r.ok, false);
+  assert.ok(r.diagnostics.some((d) => d.line === 1));
+});
+test("infinite loops are interrupted and a subsequent script can run", async () => {
+  const r = await pool.execute({
+    source: make("while(true){} return {};"),
+    frame,
+  });
+  assert.equal(r.ok, false);
+  assert.match(r.diagnostics[0].message, /interrupt/i);
+  const next = await pool.execute({ source: make("return {};"), frame });
+  assert.equal(next.ok, true);
+});
+test("memory growth is stopped inside the guest", async () => {
+  const r = await pool.execute({
+    source: make(
+      "const list=[];while(true){list.push(new Array(100000).fill('x'));}return {};",
+    ),
+    frame,
+  });
+  assert.equal(r.ok, false);
+});
+test("non-finite calculations are rejected instead of becoming missing-data zeroes", async () => {
+  const r = await pool.execute({
+    source: make(
+      "return {plots:[{id:'bad',label:'Bad',placement:'pane',value:Infinity}]};",
+    ),
+    frame,
+  });
+  assert.equal(r.ok, false);
+  assert.match(r.diagnostics[0].message, /Non-finite/);
+});
+test("indicators cannot emit trade intents even with a TypeScript cast", async () => {
+  const r = await pool.execute({
+    source: make(
+      "return {signals:[{id:'order',side:'BUY',amount:5,reason:'test'}]};",
+    ),
+    frame,
+  });
+  assert.equal(r.ok, false);
+  assert.match(r.diagnostics[0].message, /Indicators cannot/);
+});
+test("parameter bounds and unknown keys are enforced", async () => {
+  const source = make(
+    "return {};",
+    "parameters:{period:{type:'integer',label:'Period',default:10,min:2,max:30}},",
+  );
+  assert.equal(
+    (await pool.execute({ source, params: { period: 1 }, inspect: true })).ok,
+    false,
+  );
+  assert.equal(
+    (await pool.execute({ source, params: { other: 10 }, inspect: true })).ok,
+    false,
+  );
+  assert.equal(
+    (await pool.execute({ source, params: { period: 2.5 }, inspect: true })).ok,
+    false,
+  );
+  assert.equal(
+    (await pool.execute({ source, params: { period: 12 }, inspect: true })).ok,
+    true,
+  );
+});
+test("missing required data fails explicitly", async () => {
+  const r = await pool.execute({
+    source: make("return {};"),
+    frame: { ...frame, data: {} },
+  });
+  assert.equal(r.ok, false);
+  assert.match(r.diagnostics[0].message, /Data unavailable/);
+});
+test("duplicate plot IDs and unsafe colors are rejected", () => {
+  const p = { id: "x", label: "X", placement: "pane", value: 1 };
+  assert.throws(
+    () => validateOutput({ plots: [p, p] }, "indicator"),
+    /Duplicate/,
+  );
+  assert.throws(
+    () =>
+      validateOutput(
+        { plots: [{ ...p, color: "url(javascript:bad)" }] },
+        "indicator",
+      ),
+    /hex/,
+  );
+});
+test("source and state size limits are enforced", async () => {
+  await assert.rejects(
+    () => pool.execute({ source: "x".repeat(70000), inspect: true }),
+    /64 KB/,
+  );
+  const r = await pool.execute({
+    source: make("return {state:{large:'x'.repeat(9000)}};"),
+    frame,
+  });
+  assert.equal(r.ok, false);
+  assert.match(r.diagnostics[0].message, /8 KB/);
+});
+test("worker deadline supervision recovers from an unavailable worker", async () => {
+  const short = new ScriptPool({ timeoutMs: 1 });
+  try {
+    await assert.rejects(
+      () => short.execute({ source: make("return {};"), inspect: true }),
+      /deadline/,
+    );
+  } finally {
+    short.close();
+  }
+});
diff --git a/packages/tickscript/worker.cjs b/packages/tickscript/worker.cjs
new file mode 100644
index 0000000..95eabef
--- /dev/null
+++ b/packages/tickscript/worker.cjs
@@ -0,0 +1,269 @@
+"use strict";
+const ts = require("typescript");
+const fs = require("node:fs");
+const path = require("node:path");
+const { createHash } = require("node:crypto");
+const { getQuickJS } = require("quickjs-emscripten");
+const {
+  LIMITS,
+  FEATURES,
+  validateManifest,
+  parametersFor,
+  validateOutput,
+} = require("./contract.cjs");
+const cache = new Map();
+const sdk = fs.readFileSync(path.join(__dirname, "sdk.d.ts"), "utf8");
+const { makeSDK } = require("./ta.cjs");
+const BOOT = `
+  const __sdk = (${makeSDK.toString()})();
+  const require = name => { if(name !== '@ticktrade/sdk') throw Error('Import denied'); return __sdk; };
+  const exports = {};
+  Object.defineProperty(Math,'random',{value:undefined,writable:false,configurable:false});
+  Object.defineProperty(globalThis,'Date',{value:undefined,writable:false,configurable:false});
+`;
+function compile(source) {
+  if (
+    typeof source !== "string" ||
+    !source.trim() ||
+    Buffer.byteLength(source) > LIMITS.sourceBytes
+  )
+    throw Error("Source must contain 1-65536 bytes");
+  const hash = createHash("sha256").update(source).digest("hex");
+  if (cache.has(hash)) return cache.get(hash);
+  const options = {
+    target: ts.ScriptTarget.ES2020,
+    module: ts.ModuleKind.CommonJS,
+    strict: true,
+    noEmitOnError: true,
+    skipLibCheck: true,
+    types: [],
+    lib: ["lib.es2020.d.ts"],
+  };
+  const host = ts.createCompilerHost(options);
+  const originalRead = host.readFile.bind(host);
+  const libDir = path.dirname(ts.getDefaultLibFilePath(options));
+  host.readFile = (file) =>
+    file === "/script.ts"
+      ? source
+      : file === "/sdk.d.ts"
+        ? sdk
+        : path.resolve(file).startsWith(libDir + path.sep)
+          ? originalRead(file)
+          : undefined;
+  host.fileExists = (file) => host.readFile(file) !== undefined;
+  host.getSourceFile = (file, version) => {
+    const text = host.readFile(file);
+    return text === undefined
+      ? undefined
+      : ts.createSourceFile(file, text, version, true);
+  };
+  host.writeFile = () => {};
+  const program = ts.createProgram(["/script.ts", "/sdk.d.ts"], options, host);
+  const diagnostics = ts
+    .getPreEmitDiagnostics(program)
+    .map((d) => {
+      const pos = d.file?.getLineAndCharacterOfPosition(d.start || 0);
+      return {
+        line: (pos?.line || 0) + 1,
+        column: (pos?.character || 0) + 1,
+        message: ts.flattenDiagnosticMessageText(d.messageText, " "),
+      };
+    })
+    .slice(0, 20);
+  const file = program.getSourceFile("/script.ts");
+  const visit = (node) => {
+    if (
+      ts.isImportDeclaration(node) &&
+      node.moduleSpecifier.text !== "@ticktrade/sdk"
+    )
+      diagnostics.push({
+        line: file.getLineAndCharacterOfPosition(node.pos).line + 1,
+        column: 1,
+        message: "Only @ticktrade/sdk imports are allowed",
+      });
+    if (
+      ts.isExportDeclaration(node) ||
+      ts.isImportEqualsDeclaration(node) ||
+      ts.isAwaitExpression(node) ||
+      (ts.isCallExpression(node) &&
+        node.expression.kind === ts.SyntaxKind.ImportKeyword)
+    )
+      diagnostics.push({
+        line: file.getLineAndCharacterOfPosition(node.pos).line + 1,
+        column: 1,
+        message:
+          "Re-exports, dynamic imports and async execution are unavailable in SDK 1",
+      });
+    ts.forEachChild(node, visit);
+  };
+  visit(file);
+  if (diagnostics.length) return { ok: false, diagnostics };
+  const compiled = ts.transpileModule(source, {
+    compilerOptions: options,
+  }).outputText;
+  const value = { ok: true, compiled, hash };
+  if (cache.size >= 24) cache.delete(cache.keys().next().value);
+  cache.set(hash, value);
+  return value;
+}
+async function evaluate(request) {
+  const c = compile(request.source);
+  if (!c.ok) return c;
+  const Q = await getQuickJS();
+  const runtime = Q.newRuntime();
+  runtime.setMemoryLimit(LIMITS.memoryBytes);
+  runtime.setMaxStackSize(512 * 1024);
+  // A Docker CPU quota or a suspended laptop must not turn a harmless indicator
+  // into a permanent script failure. Charge only CPU used by this isolated worker;
+  // the parent still enforces an independent wall-clock execution deadline.
+  let cpuStart = process.cpuUsage();
+  runtime.setInterruptHandler(() => {
+    const used = process.cpuUsage(cpuStart);
+    return used.user + used.system > LIMITS.runtimeMs * 1000;
+  });
+  let vm = runtime.newContext();
+  function evalJSON(code) {
+    cpuStart = process.cpuUsage();
+    const result = vm.evalCode(code, "tickscript.js");
+    if (result.error) {
+      const error = vm.dump(result.error);
+      result.error.dispose();
+      throw Error(error.message || "Script execution failed");
+    }
+    try {
+      const text = vm.getString(result.value);
+      if (Buffer.byteLength(text) > LIMITS.outputBytes)
+        throw Error("Output exceeds 32 KB");
+      return JSON.parse(text);
+    } finally {
+      result.value.dispose();
+    }
+  }
+  function initialize() {
+    cpuStart = process.cpuUsage();
+    const init = vm.evalCode(
+      BOOT + "\n" + c.compiled + "\nconst __script=exports.default;",
+      "script.js",
+    );
+    if (init.error) {
+      const e = vm.dump(init.error);
+      init.error.dispose();
+      throw Error(e.message || "Script initialization failed");
+    }
+    init.value.dispose();
+  }
+  try {
+    initialize();
+    const manifest = validateManifest(
+      evalJSON(
+        `JSON.stringify((()=>{if(!__script || typeof __script.onUpdate!=='function')throw Error('Export a script with onUpdate');const {sdkVersion,name,description,kind,modes,requires,parameters,stateScope,warmupBars}=__script;return {sdkVersion,name,description,kind,modes,requires,parameters,stateScope,warmupBars};})())`,
+      ),
+    );
+    const params = parametersFor(manifest, request.params || {});
+    if (request.inspect)
+      return { ok: true, hash: c.hash, manifest, params, diagnostics: [] };
+    const frames = request.frames || [request.frame];
+    if (!Array.isArray(frames) || !frames.length || frames.length > 500)
+      throw Error("Provide 1–500 frames per batch");
+    const outputs = [];
+    let state = request.state || {},
+      lastRound = Object.hasOwn(request, "previousRoundId")
+        ? request.previousRoundId
+        : (request.frame?.roundId ?? null),
+      lastTime = -Infinity;
+    for (const [index, frame] of frames.entries()) {
+      if (!frame || !Number.isFinite(frame.time) || !frame.data)
+        throw Error("A market frame is required");
+      if (frame.time < lastTime) throw Error("Frames must be chronological");
+      lastTime = frame.time;
+      if (!manifest.modes.includes(frame.mode || "arena"))
+        throw Error("Script does not support this market mode");
+      const data = {};
+      const missing = [];
+      for (const id of manifest.requires) {
+        const key = FEATURES.find((f) => f.id === id).key;
+        if (frame.data[key] == null) missing.push(id);
+        else data[key] = frame.data[key];
+      }
+      if (missing.length) {
+        if (!request.frames)
+          throw Error(`Data unavailable: ${missing.join(", ")}`);
+        outputs.push({
+          time: frame.time,
+          roundId: frame.roundId,
+          sequence: frame.sequence,
+          missing,
+        });
+        continue;
+      }
+      const isNewRound = lastRound !== frame.roundId;
+      if (isNewRound && manifest.stateScope === "round") state = {};
+      const context = {
+        time: frame.time,
+        roundId: frame.roundId ?? 0,
+        sequence: frame.sequence,
+        mode: frame.mode || "arena",
+        replay: !!request.frames || !!request.replay,
+        isNewRound,
+        data,
+        params,
+        state,
+      };
+      if (Buffer.byteLength(JSON.stringify(context)) > 65536)
+        throw Error("Input exceeds 64 KB");
+      // Every update has the same isolation semantics as a live invocation.
+      // Only explicitly returned state persists; globals and prototype edits cannot
+      // change the result when replay batches are split at different boundaries.
+      if (index > 0) {
+        vm.dispose();
+        vm = runtime.newContext();
+        initialize();
+      }
+      const raw = evalJSON(
+        `JSON.stringify(__script.onUpdate(${JSON.stringify(context)}),(_key,value)=>{if(typeof value==='number'&&!Number.isFinite(value))throw Error('Non-finite output value');return value;})`,
+      );
+      const output = validateOutput(raw, manifest.kind);
+      state = output.state;
+      outputs.push({
+        time: frame.time,
+        roundId: frame.roundId,
+        sequence: frame.sequence,
+        output: { ...output, state: undefined },
+      });
+      lastRound = frame.roundId;
+    }
+    return {
+      ok: true,
+      hash: c.hash,
+      manifest,
+      params,
+      output: outputs.at(-1)?.output
+        ? { ...outputs.at(-1).output, state }
+        : undefined,
+      ...(request.frames ? { outputs, state, lastRound } : {}),
+      diagnostics: [],
+    };
+  } finally {
+    vm.dispose();
+    runtime.dispose();
+  }
+}
+process.on("message", async (message) => {
+  try {
+    process.send?.({ id: message.id, result: await evaluate(message.request) });
+  } catch (error) {
+    process.send?.({
+      id: message.id,
+      result: {
+        ok: false,
+        diagnostics: [
+          {
+            line: 1,
+            column: 1,
+            message: String(error.message || error).slice(0, 400),
+          },
+        ],
+      },
+    });
+  }
+});
