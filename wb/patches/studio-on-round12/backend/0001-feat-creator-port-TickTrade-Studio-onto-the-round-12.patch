+      row = {
+        id,
+        name: id,
+        n: es.length,
+        volume: v,
+        buy,
+        sell,
+        netFlow: buy - sell,
+        volumeShare: ratio(v, volume),
+        meanSize: mean(sizes),
+        medianSize: q(sizes, 0.5),
+        p95Size: q(sizes, 0.95),
