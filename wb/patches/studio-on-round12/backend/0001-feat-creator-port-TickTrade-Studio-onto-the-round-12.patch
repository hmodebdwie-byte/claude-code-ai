+export default defineIndicator({
+ sdkVersion:'1',kind:'indicator',name:'Adaptive volatility regime',
+ description:'Continuous price bands, regression slope and standardized displacement using recorded quotes. Compatible with imported Binary history.',
+ modes:['arena','binary'],stateScope:'series',warmupBars:1200,requires:['arena.market@1','market.quality@1'],
+ parameters:{period:{type:'integer',label:'Observation period',default:40,min:10,max:200},width:{type:'number',label:'Band deviations',default:2,min:0.5,max:5}},
+ onUpdate(c){
+  const values=ta.push((c.state.values as number[])||[],c.data.market!.price,200),n=Number(c.params.period);
+  const bands=ta.bands(values,n,Number(c.params.width)),z=ta.zscore(values,n),trend=ta.regression(values,n);
+  const regime=z===null?'WARMING':Math.abs(z)>2?'DISPLACEMENT':Math.abs(z)<0.5?'BALANCED':'TRANSITION';
