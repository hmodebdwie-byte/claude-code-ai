index 0000000..eb776c8
--- /dev/null
+++ b/packages/tickscript/test/batch.test.cjs
@@ -0,0 +1,91 @@
+const { test, after } = require("node:test"),
+  assert = require("node:assert/strict");
+const { ScriptPool } = require("..");
+const pool = new ScriptPool({ timeoutMs: 15000 });
+after(() => pool.close());
+const source = (scope) =>
+  `import {defineIndicator} from '@ticktrade/sdk';let implicit=0;export default defineIndicator({sdkVersion:'1',name:'Batch isolation',description:'Explicit state must be the only state channel',kind:'indicator',modes:['arena','binary'],requires:['arena.market@1'],stateScope:'${scope}',onUpdate(c){implicit++;const n=Number(c.state.n||0)+1;return {state:{n},plots:[{id:'n',label:'Count',placement:'pane',value:n},{id:'global',label:'Global',placement:'pane',value:implicit}]};}});`;
+const frames = [1, 1, 2, 2].map((roundId, i) => ({
+  time: 1700000000000 + i * 1000,
+  roundId,
+  sequence: String(i),
+  mode: "arena",
+  data: { market: { price: 1, phase: "OPEN" } },
+}));
+test("Batch boundaries cannot change results or retain implicit global state", async () => {
+  const code = source("series"),
+    all = await pool.execute({ source: code, frames });
+  assert.equal(all.ok, true, JSON.stringify(all));
+  const head = await pool.execute({ source: code, frames: frames.slice(0, 2) }),
+    tail = await pool.execute({
+      source: code,
+      frames: frames.slice(2),
+      state: head.state,
+      previousRoundId: head.lastRound,
+    });
+  assert.deepEqual(all.outputs, [...head.outputs, ...tail.outputs]);
+  assert.deepEqual(
+    all.outputs.map((o) => o.output.plots[1].value),
+    [1, 1, 1, 1],
+  );
+  let state = {},
+    previousRoundId = null;
+  const live = [];
+  for (const frame of frames) {
+    const r = await pool.execute({
+      source: code,
+      frame,
+      state,
+      previousRoundId,
+    });
+    assert.equal(r.ok, true);
+    state = r.output.state;
+    previousRoundId = frame.roundId;
+    live.push(r.output.plots[0].value);
+  }
+  assert.deepEqual(
+    live,
+    all.outputs.map((o) => o.output.plots[0].value),
+  );
+});
+test("Round state resets while series state continues explicitly", async () => {
+  const r = await pool.execute({ source: source("round"), frames });
+  assert.deepEqual(
+    r.outputs.map((o) => o.output.plots[0].value),
+    [1, 2, 1, 2],
+  );
+  const s = await pool.execute({ source: source("series"), frames });
+  assert.deepEqual(
+    s.outputs.map((o) => o.output.plots[0].value),
+    [1, 2, 3, 4],
+  );
+});
+test("Unavailable features remain missing and never become zero-valued frames", async () => {
+  const partial = [frames[0], { ...frames[1], data: {} }, frames[2]];
+  const r = await pool.execute({ source: source("series"), frames: partial });
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.outputs[1].missing, ["arena.market@1"]);
+  assert.equal(r.outputs[2].output.plots[0].value, 2);
+  const bad = await pool.execute({
+    source: source("series"),
+    frames: [partial[1], { ...frames[0], time: partial[1].time - 1 }],
+  });
