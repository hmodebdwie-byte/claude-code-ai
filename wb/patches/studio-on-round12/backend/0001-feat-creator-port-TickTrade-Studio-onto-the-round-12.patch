+    "arenaState": "Math.abs(arenaScore) < 12 ? \"NEUTRAL PROFILE INPUT\" : arenaScore > 0 ? \"BUY-SIDE PROFILE PRESSURE\" : \"SELL-SIDE PROFILE PRESSURE\"",
+    "binaryState": "Math.abs(binaryScore) < 14 ? \"NO SHORT-HORIZON EDGE\" : binaryScore > 0 ? \"UP-TICK BEHAVIORAL BIAS\" : \"DOWN-TICK BEHAVIORAL BIAS\""
+  }
+}
