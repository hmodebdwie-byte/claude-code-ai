+    "productionGate": "productionGateScore >= 82 ? \"SHADOW VALIDATION READY\" : productionGateScore >= 58 ? \"RESEARCH GATE\" : \"BLOCKED · DATA BUILDING\"",
+    "privacyGate": "\"PSEUDONYMOUS · INTERNAL\"",
+    "coreScore": "clamp(profile.qualityScore * 0.20 + bayesianWinReliability * 0.16 + recentForm * 0.12 + profile.consistencyScore * 0.13 + profile.persistence * 100 * 0.10 + followThroughScore * 0.12 + (50 + controlScore / 2) * 0.10 + defenseResponseScore * 0.07, 0, 100)",
+    "composite": "clamp(coreScore * 0.42 + statisticalReliabilityScore * 0.15 + executionQualityScore * 0.14 + behavioralStabilityScore * 0.10 + riskControlScore * 0.08 + evidenceGradeScore * 0.11, 0, 100)",
+    "tier": "composite >= 82 ? \"ELITE\" : composite >= 70 ? \"INSTITUTIONAL-GRADE\" : composite >= 58 ? \"HIGH SIGNAL\" : composite >= 44 ? \"ESTABLISHED\" : dataSufficiency === \"BUILDING\" ? \"BUILDING\" : \"SPECIALIST\"",
