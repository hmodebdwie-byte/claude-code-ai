@@ -0,0 +1,386 @@
+import {
+  BadRequestException,
+  Injectable,
+  NotFoundException,
+  Logger,
+  OnModuleDestroy,
+  OnModuleInit,
+} from '@nestjs/common';
+import { createHash } from 'node:crypto';
+import { ScriptPool } from '@ticktrade/tickscript';
+import { PrismaService } from '../prisma/prisma.service';
+import { CreatorHistoryService } from './creator-history.service';
+import { CreatorAccessService } from './creator-access.service';
+import { appendPlotHistory } from './creator-history.math';
+import { signalResearch, trainPressureModel } from './creator-research.math';
+
+// PostgreSQL JSONB can reorder object keys. The input hash describes the values,
+// so it must remain identical after a job is stored and resumed.
+const canonical = (value: any): string =>
+  Array.isArray(value)
+    ? `[${value.map(canonical).join(',')}]`
+    : value && typeof value === 'object'
+      ? `{${Object.keys(value)
+          .sort()
+          .map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`)
+          .join(',')}}`
+      : JSON.stringify(value);
+
+@Injectable()
+export class CreatorResearchService implements OnModuleInit, OnModuleDestroy {
+  private pool = new ScriptPool({ timeoutMs: 30000, maxQueued: 8 });
+  private timer?: ReturnType<typeof setInterval>;
+  private busy = false;
+  private logger = new Logger(CreatorResearchService.name);
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly history: CreatorHistoryService,
+    private readonly access: CreatorAccessService,
+  ) {}
+  onModuleInit() {
+    if (process.env.CREATOR_SCHEDULER_ENABLED !== 'false') {
+      this.timer = setInterval(
+        () =>
+          void this.work().catch((e) =>
+            this.logger.warn(String(e.message).slice(0, 180)),
+          ),
+        2000,
+      );
+      this.timer.unref();
+    }
+  }
+  onModuleDestroy() {
+    if (this.timer) clearInterval(this.timer);
+    this.pool.close();
+  }
+  async create(ownerId: number, dto: any) {
+    const kind = dto.kind || 'replay';
+    if (!['replay', 'compare', 'calibrate'].includes(kind))
+      throw new BadRequestException('Unknown research kind');
+    const dataset = await this.history.dataset(dto.datasetId || 'arena-live');
+    const { from, to } = this.history.parseRange(dto);
+    if (!from || !to)
+      throw new BadRequestException('Select an explicit historical date range');
+    if (+to - +from > 31 * 86400000)
+      throw new BadRequestException(
+        'A research window can cover at most 31 days',
+      );
+    if (
+      !Number.isFinite(Number(dto.horizonSeconds ?? 30)) ||
+      Number(dto.horizonSeconds ?? 30) < 1 ||
+      Number(dto.horizonSeconds ?? 30) > 300
+    )
+      throw new BadRequestException('Horizon must be 1–300 seconds');
+    const configs =
+      kind === 'compare' ? dto.configurations : [dto.params || {}];
+    if (
+      !Array.isArray(configs) ||
+      !configs.length ||
+      configs.length > 8 ||
+      configs.some(
+        (p) =>
+          !p ||
+          typeof p !== 'object' ||
+          Array.isArray(p) ||
+          Object.keys(p).length > 24,
+      )
+    )
+      throw new BadRequestException('Provide 1–8 parameter configurations');
+    const interval = Number(dto.interval || 1);
+    if (![1, 5, 15, 30, 60, 300].includes(interval))
+      throw new BadRequestException('Unsupported replay interval');
+    if (kind !== 'calibrate') await this.access.version(ownerId, dto.versionId);
+    const coverage = await this.history.coverage(dataset.id, true);
+    if (!coverage.count)
+      throw new BadRequestException('Dataset has no history yet');
+    return this.prisma.$transaction(async (tx) => {
+      await tx.$queryRaw`SELECT pg_advisory_xact_lock(76235,${ownerId}::int)::text`;
+      if (
+        (await tx.creatorResearchJob.count({
+          where: { ownerId, status: { in: ['queued', 'running'] } },
+        })) >= 3
+      )
+        throw new BadRequestException(
+          'At most three queued/running research jobs',
+        );
+      if (
+        (await tx.creatorResearchJob.count({
+          where: {
+            ownerId,
+            createdAt: { gte: new Date(Date.now() - 86400000) },
+          },
+        })) >= 100
+      )
+        throw new BadRequestException('Research limit: 100 jobs per day');
+      return tx.creatorResearchJob.create({
+        data: {
+          ownerId,
+          kind,
+          spec: {
+            datasetId: dataset.id,
+            versionId: dto.versionId || null,
+            from: from.toISOString(),
+            to: to.toISOString(),
+            interval,
+            windowSeconds: Math.min(
+              300,
+              Math.max(5, Number(dto.windowSeconds) || 30),
+            ),
+            horizonSeconds: Number(dto.horizonSeconds || 30),
+            configurations: configs,
+            fence: coverage.lastId,
+            name: String(dto.name || 'Pressure research').slice(0, 100),
+          },
+        },
+      });
+    });
+  }
+  list(ownerId: number) {
+    return this.prisma.creatorResearchJob.findMany({
+      where: { ownerId },
+      orderBy: { createdAt: 'desc' },
+      take: 100,
+      select: {
+        id: true,
+        kind: true,
+        status: true,
+        progress: true,
+        spec: true,
+        error: true,
+        createdAt: true,
+        updatedAt: true,
+      },
+    });
+  }
+  async get(ownerId: number, id: string) {
+    const j = await this.prisma.creatorResearchJob.findFirst({
+      where: { id, ownerId },
+    });
+    if (!j) throw new NotFoundException('Research job not found');
+    const { inputSnapshot, ...publicJob } = j;
+    return publicJob;
+  }
+  async cancel(ownerId: number, id: string) {
+    await this.get(ownerId, id);
+    return this.prisma.creatorResearchJob.updateMany({
+      where: { id, ownerId, status: { in: ['queued', 'running'] } },
+      data: { cancelRequested: true },
+    });
+  }
+  async work() {
+    if (this.busy) return;
+    this.busy = true;
+    try {
+      await this.prisma.creatorResearchJob.updateMany({
+        where: { status: 'running', leaseUntil: { lt: new Date() } },
+        data: { status: 'queued', progress: 0 },
+      });
+      const job = await this.prisma.creatorResearchJob.findFirst({
+        where: { status: 'queued' },
+        orderBy: { createdAt: 'asc' },
+      });
+      if (!job) return;
+      const claim = await this.prisma.creatorResearchJob.updateMany({
+        where: { id: job.id, status: 'queued' },
+        data: { status: 'running', leaseUntil: new Date(Date.now() + 60000) },
+      });
+      if (!claim.count) return;
+      try {
+        await this.execute(job);
+      } catch (e) {
+        await this.prisma.creatorResearchJob.update({
+          where: { id: job.id },
+          data: {
+            status:
+              (e as Error).message === 'Cancelled' ? 'cancelled' : 'failed',
+            error: (e as Error).message.slice(0, 500),
+            leaseUntil: null,
+          },
+        });
+      }
+    } finally {
+      this.busy = false;
+    }
+  }
+  private async heartbeat(id: string, progress: number) {
+    const row = await this.prisma.creatorResearchJob.findUnique({
+      where: { id },
+      select: { cancelRequested: true },
+    });
+    if (row?.cancelRequested) throw Error('Cancelled');
+    await this.prisma.creatorResearchJob.update({
+      where: { id },
+      data: { progress, leaseUntil: new Date(Date.now() + 60000) },
+    });
+  }
+  private async execute(job: any) {
+    const spec = job.spec;
+    await this.heartbeat(job.id, 1);
+    let snapshot = job.inputSnapshot;
+    if (!snapshot) {
+      snapshot = await this.history.snapshot(spec.datasetId, {
+        ...spec,
+        oldest: true,
+        pointLimit: 50000,
+      });
+      if (Buffer.byteLength(JSON.stringify(snapshot)) > 12 * 1024 * 1024)
+        throw Error('Research input exceeds 12 MB. Narrow the date range.');
+      await this.prisma.creatorResearchJob.update({
+        where: { id: job.id },
+        data: { inputSnapshot: snapshot },
+      });
+    }
+    const inputHash = createHash('sha256')
+      .update(canonical(snapshot))
+      .digest('hex');
+    const data = await this.history.framesFromSnapshotAsync(snapshot, spec);
+    if (data.truncated)
+      throw Error(
+        'The selected range exceeds 50,000 raw observations. Narrow the date range; research never silently omits the tail.',
+      );
+    if (!data.frames.length) throw Error('No observations in this date range');
+    const frames = data.frames;
+    if (frames.length > 10000)
+      throw Error(
+        'Choose a larger sampling interval or shorter range (maximum 10,000 replay frames)',
+      );
+    if (job.kind === 'calibrate') {
+      const trained = trainPressureModel(frames, spec.horizonSeconds);
+      const model = await this.prisma.creatorModel.create({
+        data: {
+          ownerId: job.ownerId,
+          name: spec.name,
+          datasetId: spec.datasetId,
+          spec,
+          metrics: trained.metrics,
+          artifact: trained.artifact,
+        },
+      });
+      await this.heartbeat(job.id, 95);
+      await this.prisma.creatorResearchJob.update({
+        where: { id: job.id },
+        data: {
+          status: 'complete',
+          progress: 100,
+          leaseUntil: null,
+          result: {
+            modelId: model.id,
+            inputHash,
+            inputCapturedAt: snapshot.capturedAt,
+            ...trained,
+            coverage: data.coverage,
+            frames: frames.length,
+          },
+        },
+      });
+      return;
+    }
+    const { version } = await this.access.version(job.ownerId, spec.versionId);
+    const runs: any[] = [];
+    for (let n = 0; n < spec.configurations.length; n++) {
+      const params = spec.configurations[n];
+      const variantFrames = (
+        await this.history.framesFromSnapshotAsync(snapshot, {
+          ...spec,
+          windowSeconds: params.windowSeconds ?? spec.windowSeconds,
+        })
+      ).frames;
+      let state: any = {},
+        lastRound: number | null = null;
+      const outputs: any[] = [];
+      for (let i = 0; i < frames.length; i += 50) {
+        await this.heartbeat(
+          job.id,
+          Math.floor(
+            ((n * frames.length + i) /
+              (frames.length * spec.configurations.length)) *
+              95,
+          ),
+        );
+        const r = await this.pool.execute({
+          source: version.source,
+          params,
+          frames: variantFrames.slice(i, i + 50),
+          state,
+          previousRoundId: lastRound,
+        });
+        if (!r.ok) throw Error(r.diagnostics.map((d) => d.message).join('; '));
+        outputs.push(...r.outputs!);
+        state = r.state;
+        lastRound = r.lastRound ?? null;
+      }
+      const usable = outputs.filter((o) => o.output),
+        last = usable.at(-1),
+        research = signalResearch(variantFrames, outputs, spec.horizonSeconds);
+      runs.push({
+        params,
+        output: last?.output || {},
+        history: appendPlotHistory({}, outputs, 10000),
+        missingFrames: outputs.filter((o) => o.missing).length,
+        missingFeatures: [...new Set(outputs.flatMap((o) => o.missing || []))],
+        ...research,
+      });
+    }
+    await this.heartbeat(job.id, 99);
+    await this.prisma.creatorResearchJob.update({
+      where: { id: job.id },
+      data: {
+        status: 'complete',
+        progress: 100,
+        leaseUntil: null,
+        result: {
+          datasetId: spec.datasetId,
+          versionId: version.id,
+          sourceHash: version.hash,
+          inputHash,
+          inputCapturedAt: snapshot.capturedAt,
+          fence: spec.fence,
+          coverage: data.coverage,
+          frames: frames.length,
+          interval: spec.interval,
+          runs,
+          prices: frames.map((f) => ({
+            time: Math.floor(f.time / 1000),
+            value: f.data.market.price,
+            roundId: f.roundId,
+          })),
+          note: 'Replay is isolated. No trade service is called; missing features skip the affected frames.',
+        },
+      },
+    });
+  }
+  models(ownerId: number) {
+    return this.prisma.creatorModel.findMany({
+      where: { ownerId },
+      orderBy: { createdAt: 'desc' },
+      take: 100,
+    });
+  }
+  async predict(ownerId: number, id: string) {
+    const model = await this.prisma.creatorModel.findFirst({
+      where: { id, ownerId },
+    });
+    if (!model) throw new NotFoundException('Research model not found');
+    const input = await this.history.frames(model.datasetId, {
+      pointLimit: 4000,
+    });
+    const frame = input.frames.at(-1);
+    if (!frame) return { available: false };
+    const a = model.artifact as any,
+      x = frame.data.liquidity.imbalance,
+      b = a.bins[Math.min(9, Math.max(0, Math.floor((x + 1) * 5)))];
+    return {
+      available: true,
+      modelId: id,
+      time: frame.time,
+      pressure: x,
+      probability: b.probability,
+      trainingBinSamples: b.n,
+      horizonSeconds: a.horizonSeconds,
+      shadowOnly: true,
+      holdout: model.metrics,
+      warning:
+        'Research estimate for price direction, not an Arena payout probability.',
+    };
+  }
+}
diff --git a/apps/api/src/creator/creator-stake-source.service.ts b/apps/api/src/creator/creator-stake-source.service.ts
new file mode 100644
index 0000000..38efd8f
--- /dev/null
+++ b/apps/api/src/creator/creator-stake-source.service.ts
@@ -0,0 +1,131 @@
+import { Injectable } from '@nestjs/common';
+import { listBufferedStakes, redisStakeBufferEnabled } from '@ticktrade/shared';
+import { getSharedCommandRedis } from '../redis/redis.client';
+import { PrismaService } from '../prisma/prisma.service';
+
+/** Read-only bridge to the existing write-behind stake path; never flushes or edits it. */
+@Injectable()
+export class CreatorStakeSourceService {
+  private cache = new Map<number, { until: number; promise: Promise<any[]> }>();
+  constructor(private readonly prisma: PrismaService) {}
+  async buffered(roundId: number, refresh = false): Promise<any[]> {
+    if (!redisStakeBufferEnabled()) return [];
+    const cached = this.cache.get(roundId);
+    if (!refresh && cached && cached.until > Date.now()) return cached.promise;
+    if (this.cache.size > 32) this.cache.clear();
+    const promise = listBufferedStakes(getSharedCommandRedis(), roundId).then(
+      (rows) =>
+        rows.map((r) => ({
+          tempStakeId: r.tempStakeId,
+          clientStakeId: r.clientStakeId,
+          battleId: r.battleId,
+          userId: r.userId,
+          side: r.side,
+          amount: r.amount,
+          entryPrice: r.entryPrice,
+          quantity: r.quantity,
+          createdAt: new Date(r.createdAtMs),
+          acceptedAt: new Date(
+            Number((r.orderMeta as any)?.timing?.acceptedAtMs || r.createdAtMs),
+          ),
+          status: 'ACTIVE',
+        })),
+    );
+    this.cache.set(roundId, { until: Date.now() + 400, promise });
+    promise.catch(() => this.cache.delete(roundId));
+    return promise;
+  }
+  merge(persisted: any[], buffered: any[]) {
+    const key = (s: any) =>
+      [
+        s.userId,
+        s.battleId,
+        s.side,
+        Number(s.amount),
+        Number(s.entryPrice).toFixed(5),
+        +new Date(s.createdAt),
+      ].join(':');
+    const seen = new Map<string, number>();
+    for (const s of persisted) seen.set(key(s), (seen.get(key(s)) || 0) + 1);
+    const result = persisted.map((s) => {
+      const { orderMeta, ...safe } = s;
+      const accepted =
+        s.acceptedAt ?? (orderMeta as any)?.timing?.acceptedAtMs ?? s.createdAt;
+      return { ...safe, acceptedAt: new Date(accepted) };
+    });
+    for (const s of buffered) {
+      const k = key(s),
+        copies = seen.get(k) || 0;
+      if (copies) seen.set(k, copies - 1);
+      else result.push(s);
+    }
+    return result;
+  }
+  async participants(roundId: number, asOf: Date) {
+    const [db, buffer] = await Promise.all([
+      this.prisma.stake.findMany({
+        where: {
+          battleId: roundId,
+          status: 'ACTIVE',
+          userId: { not: null },
+          createdAt: { lte: asOf },
+        },
+        select: {
+          userId: true,
+          side: true,
+          acceptedAt: true,
+          orderMeta: true,
+          createdAt: true,
+        },
+      }),
+      this.buffered(roundId),
+    ]);
+    const buy = new Set<number>(),
+      sell = new Set<number>();
+    for (const s of [...db, ...buffer]) {
+      const accepted = +new Date(
+        s.acceptedAt ||
+          (s.orderMeta as any)?.timing?.acceptedAtMs ||
+          s.createdAt,
+      );
+      if (accepted > +asOf) continue;
+      (s.side === 'BUY' ? buy : sell).add(s.userId!);
+    }
+    let both = 0;
+    for (const id of buy) if (sell.has(id)) both++;
+    return [
+      {
+        buy: buy.size,
+        sell: sell.size,
+        both,
+        total: buy.size + sell.size - both,
+      },
+    ];
+  }
+  async persistedBuffered(row: any) {
+    const evidence = row.response?.bufferedTrade;
+    if (!evidence) return null;
+    const matches = await this.prisma.stake.findMany({
+      where: {
+        userId: row.installation.ownerId,
+        battleId: row.roundId,
+        side: row.side,
+        amount: Number(row.amount),
+        createdAt: new Date(evidence.createdAt),
+        entryPrice: Number(Number(evidence.entryPrice).toFixed(5)),
+        ...(evidence.acceptedAt
+          ? {
+              orderMeta: {
+                path: ['timing', 'acceptedAtMs'],
+                equals: +new Date(evidence.acceptedAt),
+              },
+            }
+          : {}),
+      },
+      take: 2,
+      select: { id: true, amount: true, status: true, payout: true },
+    });
+    // Never guess between identical orders if the existing engine did not retain a unique link.
+    return matches.length === 1 ? matches[0] : null;
+  }
+}
diff --git a/apps/api/src/creator/creator-trader.math.ts b/apps/api/src/creator/creator-trader.math.ts
new file mode 100644
index 0000000..634e69d
--- /dev/null
+++ b/apps/api/src/creator/creator-trader.math.ts
@@ -0,0 +1,224 @@
+const total = (a: number[]) => a.reduce((s, v) => s + v, 0);
+const quantile = (a: number[], p: number) => {
+  if (!a.length) return null;
+  const s = [...a].sort((a, b) => a - b),
+    x = (s.length - 1) * p;
+  return s[Math.floor(x)] + (s[Math.ceil(x)] - s[Math.floor(x)]) * (x % 1);
+};
+/** Aggregation is the privacy boundary: no trader IDs, balances or individual histories leave this function. */
+export function enrichTraderFrames(
+  frames: any[],
+  stakes: any[],
+  windowSeconds: number,
+  quoteFrames = frames,
+) {
+  const byRound = new Map<number, any[]>(),
+    ambiguous = new Set<number>();
+  for (const st of stakes) {
+    if (st.status === 'REFUNDED') ambiguous.add(st.battleId);
+    const list = byRound.get(st.battleId) || [];
+    list.push(st);
+    byRound.set(st.battleId, list);
+  }
+  const rounds = new Map<number, any[]>();
+  for (const f of quoteFrames) {
+    const list = rounds.get(f.roundId) || [];
+    list.push(f);
+    rounds.set(f.roundId, list);
+  }
+  const cursors = new Map<
+    number,
+    { index: number; buy: Set<number>; sell: Set<number> }
+  >();
+  for (const f of frames) {
+    if (ambiguous.has(f.roundId)) {
+      f.data.quality.missing.push(
+        'arena.traders@1',
+        'arena.behavior@1',
+        'arena.impact@1',
+      );
+      continue;
+    }
+    const list = byRound.get(f.roundId) || [],
+      cursor = cursors.get(f.roundId) || {
+        index: 0,
+        buy: new Set<number>(),
+        sell: new Set<number>(),
+      };
+    while (
+      cursor.index < list.length &&
+      +list[cursor.index].createdAt <= f.time
+    ) {
+      const st = list[cursor.index++];
+      (st.side === 'BUY' ? cursor.buy : cursor.sell).add(st.userId);
+    }
+    cursors.set(f.roundId, cursor);
+    let both = 0;
+    for (const id of cursor.buy) if (cursor.sell.has(id)) both++;
+    if (!f.data.participants) {
+      f.data.participants = {
+        buy: cursor.buy.size,
+        sell: cursor.sell.size,
+        both,
+        total: cursor.buy.size + cursor.sell.size - both,
+        basis: 'accepted-stake-history',
+      };
+      f.data.quality.missing = f.data.quality.missing.filter(
+        (v: string) => v !== 'arena.participants@1',
+      );
+    }
+    let start = cursor.index;
+    while (
+      start > 0 &&
+      +list[start - 1].createdAt >= f.time - windowSeconds * 1000
+    )
+      start--;
+    const recent = list.slice(start, cursor.index),
+      traders = new Map<
+        number,
+        {
+          buy: number;
+          sell: number;
+          count: number;
+          lastTime: number;
+          lastSide: string;
+        }
+      >(),
+      gaps: number[] = [],
+      sizes: number[] = [];
+    let switches = 0,
+      pairs = 0,
+      buy = 0,
+      sell = 0;
+    for (const s of recent) {
+      const amount = Number(s.amount);
+      sizes.push(amount);
+      const prior = traders.get(s.userId);
+      if (prior) {
+        gaps.push((+s.createdAt - prior.lastTime) / 1000);
+        pairs++;
+        if (prior.lastSide !== s.side) switches++;
+      }
+      const t = prior || {
+        buy: 0,
+        sell: 0,
+        count: 0,
+        lastTime: 0,
+        lastSide: '',
+      };
+      if (s.side === 'BUY') {
+        t.buy += amount;
+        buy += amount;
+      } else {
+        t.sell += amount;
+        sell += amount;
+      }
+      t.count++;
+      t.lastTime = +s.createdAt;
+      t.lastSide = s.side;
+      traders.set(s.userId, t);
+    }
+    const volume = buy + sell,
+      weights = [...traders.values()]
+        .map((t) => t.buy + t.sell)
+        .sort((a, b) => b - a),
+      hhi = volume ? total(weights.map((v) => (v / volume) ** 2)) : null;
+    const bothSides = [...traders.values()].filter(
+      (t) => t.buy && t.sell,
+    ).length;
+    f.data.traders = {
+      unique: traders.size,
+      buy: [...traders.values()].filter((t) => t.buy).length,
+      sell: [...traders.values()].filter((t) => t.sell).length,
+      both: bothSides,
+      hhi,
+      effectiveTraders: hhi ? 1 / hhi : null,
+      top1Share: volume ? weights[0] / volume : null,
+      top5Share: volume ? total(weights.slice(0, 5)) / volume : null,
+      volume,
+      basis: 'accepted-stake-window',
+    };
+    const mean = sizes.length ? volume / sizes.length : 0;
+    const entropy = volume
+      ? -total(
+          [buy / volume, sell / volume]
+            .filter(Boolean)
+            .map((p) => p * Math.log2(p)),
+        )
+      : null;
+    const half = Math.floor(sizes.length / 2),
+      old = half ? total(sizes.slice(0, half)) / half : null,
+      newer =
+        sizes.length > half
+          ? total(sizes.slice(half)) / (sizes.length - half)
+          : null;
+    f.data.behavior = {
+      medianCadenceSeconds: quantile(gaps, 0.5),
+      switchRate: pairs ? switches / pairs : null,
+      directionalEntropy: entropy,
+      medianTicket: quantile(sizes, 0.5),
+      p95Ticket: quantile(sizes, 0.95),
+      sizeCv:
+        sizes.length > 1 && mean
+          ? Math.sqrt(total(sizes.map((v) => (v - mean) ** 2)) / sizes.length) /
+            mean
+          : null,
+      sizeDrift: old && newer ? newer / old - 1 : null,
+      samples: recent.length,
+    };
+    const quotes = rounds.get(f.roundId) || [],
+      markouts: number[] = [];
+    const horizonSeconds = 5;
+    for (const st of recent) {
+      const target = +st.createdAt + horizonSeconds * 1000;
+      if (target > f.time) continue;
+      let lo = 0,
+        hi = quotes.length;
+      while (lo < hi) {
+        const mid = (lo + hi) >>> 1;
+        if (quotes[mid].time < target) lo = mid + 1;
+        else hi = mid;
+      }
+      const quote = quotes[lo];
+      if (!quote || quote.time > f.time || quote.time - target > 2500) continue;
+      const entry = Number(st.entryPrice);
+      if (entry > 0)
+        markouts.push(
+          ((quote.data.market.price - entry) * (st.side === 'BUY' ? 1 : -1)) /
+            0.0001,
+        );
+    }
+    const n = markouts.length,
+      wins = markouts.filter((v) => v > 0).length,
+      z = 1.96,
+      p = n ? wins / n : 0,
+      den = 1 + (z * z) / (n || 1),
+      center = (p + (z * z) / (2 * (n || 1))) / den,
+      halfWidth =
+        (z * Math.sqrt((p * (1 - p) + (z * z) / (4 * (n || 1))) / (n || 1))) /
+        den;
+    let value = 0,
+      peak = 0,
+      drawdown = 0;
+    for (const m of markouts) {
+      value += m;
+      peak = Math.max(peak, value);
+      drawdown = Math.max(drawdown, peak - value);
+    }
+    f.data.impact = {
+      horizonSeconds,
+      matured: n,
+      pending: recent.length - n,
+      positiveRate: n ? p : null,
+      wilsonLow: n ? Math.max(0, center - halfWidth) : null,
+      wilsonHigh: n ? Math.min(1, center + halfWidth) : null,
+      meanMarkoutPips: n ? total(markouts) / n : null,
+      medianMarkoutPips: quantile(markouts, 0.5),
+      tailMarkoutPips: quantile(markouts, 0.05),
+      markoutDrawdownPips: n ? drawdown : null,
+      basis: 'matured-side-aligned-price-markouts',
+      profit: null,
+    };
+  }
+  return frames;
+}
