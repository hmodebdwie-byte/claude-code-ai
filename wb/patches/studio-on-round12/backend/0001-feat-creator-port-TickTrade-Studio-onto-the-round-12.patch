index 0000000..19de107
--- /dev/null
+++ b/packages/tickscript/index.cjs
@@ -0,0 +1,165 @@
+"use strict";
+const { fork } = require("node:child_process");
+const path = require("node:path");
+const { randomUUID } = require("node:crypto");
+const fs = require("node:fs");
+const os = require("node:os");
+const contract = require("./contract.cjs");
+
+// CPU actually burned by a child process, in milliseconds, or null when this
+// platform does not expose it. Linux only (/proc/<pid>/stat fields 14 and 15,
+// utime and stime, in clock ticks). Used to tell a runaway script apart from a
+// healthy one that is merely starved of CPU.
+const CLOCK_TICK_MS = 1000 / 100; // Linux USER_HZ is 100 on every supported target
+function childCpuMs(pid) {
+  if (process.platform !== "linux" || !pid) return null;
+  try {
+    const stat = fs.readFileSync(`/proc/${pid}/stat`, "utf8");
+    // comm can contain spaces and parentheses, so start after the final ')'.
+    const fields = stat.slice(stat.lastIndexOf(")") + 2).split(" ");
+    const utime = Number(fields[11]);
+    const stime = Number(fields[12]);
+    if (!Number.isFinite(utime) || !Number.isFinite(stime)) return null;
+    return (utime + stime) * CLOCK_TICK_MS;
+  } catch {
+    return null;
+  }
+}
+
+class ScriptPool {
+  constructor({
+    timeoutMs = 8000,
+    maxQueued = 24,
+    maxDeadlineGrants = 2,
+    starvedCpuRatio = 0.9,
+  } = {}) {
+    this.starvedCpuRatio = starvedCpuRatio;
+    this.timeoutMs = timeoutMs;
+    // A starved child may be granted at most this many extra deadline periods.
+    // A script that is actually burning CPU never qualifies, so the ceiling on
+    // a misbehaving script stays timeoutMs.
+    this.maxDeadlineGrants = maxDeadlineGrants;
+    this.maxQueued = maxQueued;
+    this.queue = [];
+    this.active = null;
+    this.child = null;
+    this.closed = false;
+    this.completed = 0;
+    this.failed = 0;
+  }
+  execute(request) {
+    if (this.closed) return Promise.reject(Error("Runner is closed"));
+    if (this.queue.length >= this.maxQueued)
+      return Promise.reject(Error("Runner is busy; try again shortly"));
+    if (
+      typeof request.source !== "string" ||
+      Buffer.byteLength(request.source) > contract.LIMITS.sourceBytes
+    )
+      return Promise.reject(Error("Source exceeds 64 KB"));
+    return new Promise((resolve, reject) => {
+      this.queue.push({ id: randomUUID(), request, resolve, reject });
+      this.pump();
+    });
+  }
+  pump() {
+    if (this.active || !this.queue.length || this.closed) return;
+    if (!this.child) {
+      const child = fork(path.join(__dirname, "worker.cjs"), [], {
+        execArgv: ["--max-old-space-size=256"],
+        env: { NODE_ENV: "production" },
+        stdio: ["ignore", "ignore", "ignore", "ipc"],
+      });
+      this.child = child;
+      child.on("message", (message) => {
+        if (this.child !== child || message.id !== this.active?.id) return;
+        const task = this.active;
+        clearTimeout(task.timer);
+        this.active = null;
+        this.completed++;
+        if (!message.result.ok) this.failed++;
+        task.resolve(message.result);
+        this.pump();
+      });
+      const crashed = () => {
+        if (this.child !== child) return;
+        this.child = null;
+        if (this.active) {
+          clearTimeout(this.active.timer);
+          this.active.reject(Error("Script worker stopped"));
+          this.active = null;
+          this.failed++;
+        }
+        this.pump();
+      };
+      child.on("error", crashed);
+      child.on("exit", crashed);
+    }
+    const task = this.queue.shift();
+    this.active = task;
+    task.grants = 0;
+    task.cpuAtStart = childCpuMs(this.child?.pid);
+    const onDeadline = () => {
+      if (this.active !== task) return;
+      const child = this.child;
+      // The guest charges its own 80ms budget in CPU time, so Docker throttling
+      // cannot fail a healthy script there. This outer timer is wall-clock and
+      // could not previously tell those two cases apart: under CPU pressure it
+      // SIGKILLed the shared worker even though the child had barely run, which
+      // also destroyed the queued work of every other script on this pool.
+      // Extend only when the child demonstrably did not get the CPU. A runaway
+      // script burns CPU by definition and is still killed on the first tick.
+      // Threshold from measurement, not taste: on an idle box this worker runs at
+      // 110-120% of a core (it has its own GC thread), so anything at or above a
+      // full core is getting all the CPU it asked for and its wall-clock time is
+      // its own doing. Below that the box is contended.
+      const cpuNow = childCpuMs(child?.pid);
+      const starved =
+        task.cpuAtStart !== null &&
+        cpuNow !== null &&
+        cpuNow - task.cpuAtStart < this.timeoutMs * this.starvedCpuRatio;
+      if (starved && task.grants < this.maxDeadlineGrants) {
+        task.grants++;
+        task.timer = setTimeout(onDeadline, this.timeoutMs);
+        return;
+      }
+      this.child = null;
+      this.active = null;
+      child?.kill("SIGKILL");
+      this.failed++;
+      task.reject(Error("Script exceeded its execution deadline"));
+      this.pump();
+    };
+    task.timer = setTimeout(onDeadline, this.timeoutMs);
+    this.child.send({ id: task.id, request: task.request }, (error) => {
+      if (error && this.active === task) {
+        clearTimeout(task.timer);
+        this.active = null;
+        this.child?.kill("SIGKILL");
+        this.child = null;
+        task.reject(Error("Script worker unavailable"));
+        this.pump();
+      }
+    });
+  }
+  stats() {
+    return {
+      queued: this.queue.length,
+      running: !!this.active,
+      completed: this.completed,
+      failed: this.failed,
+    };
+  }
+  close() {
+    this.closed = true;
+    this.child?.kill();
+    this.child = null;
+    if (this.active) {
+      clearTimeout(this.active.timer);
+      this.active.reject(Error("Runner stopped"));
+      this.active = null;
+    }
+    for (const task of this.queue) task.reject(Error("Runner stopped"));
+    this.queue = [];
+  }
+}
+module.exports = { ScriptPool, ...contract };
