index 0000000..893edd6
--- /dev/null
+++ b/packages/tickscript/ta.cjs
@@ -0,0 +1,146 @@
+"use strict";
+// This entire factory is also evaluated inside QuickJS. It has no host bindings.
+function makeSDK() {
+  const clean = (a) => {
+    if (
+      !Array.isArray(a) ||
+      a.some((v) => typeof v !== "number" || !Number.isFinite(v))
+    )
+      throw Error("TA values must be finite numbers");
+    return a;
+  };
+  const period = (n) => {
+    if (!Number.isInteger(n) || n < 1 || n > 5000)
+      throw Error("TA period must be an integer from 1 to 5000");
+    return n;
+  };
+  const tail = (a, n) => clean(a.slice(-period(n)));
+  const mean = (a) =>
+    a.length ? a.reduce((s, v) => s + v, 0) / a.length : null;
+  const sma = (a, n) => (a.length >= period(n) ? mean(tail(a, n)) : null);
+  const variance = (a) => {
+    const m = mean(a);
+    return m === null ? null : mean(a.map((v) => (v - m) ** 2));
+  };
+  const std = (a, n) => {
+    const v = a.length >= n ? variance(tail(a, n)) : null;
+    return v === null ? null : Math.sqrt(v);
+  };
+  const ema = (value, previous, period) =>
+    previous == null
+      ? value
+      : previous + (2 / (Math.max(1, period) + 1)) * (value - previous);
+  const rsi = (a, n = 14) => {
+    if (a.length < n + 1) return null;
+    const v = tail(a, n + 1);
+    let up = 0,
+      down = 0;
+    for (let i = 1; i < v.length; i++) {
+      const d = v[i] - v[i - 1];
+      up += Math.max(0, d);
+      down += Math.max(0, -d);
+    }
+    return !up && !down ? 50 : !down ? 100 : 100 - 100 / (1 + up / down);
+  };
+  const percentile = (a, p) => {
+    const v = [...clean(a)].sort((a, b) => a - b);
+    if (!v.length) return null;
+    const x = Math.max(0, Math.min(1, p)) * (v.length - 1),
+      lo = Math.floor(x);
+    return v[lo] + (v[Math.ceil(x)] - v[lo]) * (x - lo);
+  };
+  const correlation = (a, b, n) => {
+    const x = tail(a, n),
+      y = tail(b, n);
+    if (x.length < n || y.length < n || x.length !== y.length || x.length < 2)
+      return null;
+    const mx = mean(x),
+      my = mean(y);
+    let c = 0,
+      vx = 0,
+      vy = 0;
+    for (let i = 0; i < x.length; i++) {
+      c += (x[i] - mx) * (y[i] - my);
+      vx += (x[i] - mx) ** 2;
+      vy += (y[i] - my) ** 2;
+    }
+    return vx && vy ? c / Math.sqrt(vx * vy) : null;
+  };
+  const regression = (a, n) => {
+    const y = tail(a, n),
+      m = mean(y);
+    if (y.length < n || y.length < 2) return null;
+    const mx = (y.length - 1) / 2;
+    let c = 0,
+      v = 0;
+    for (let i = 0; i < y.length; i++) {
+      c += (i - mx) * (y[i] - m);
+      v += (i - mx) ** 2;
+    }
+    const slope = c / v;
+    return { slope, intercept: m - slope * mx, value: m + slope * mx };
+  };
+  const ta = Object.freeze({
+    sma,
+    ema,
+    rsi,
+    std,
+    percentile,
+    correlation,
+    regression,
+    sum: (a, n) => tail(a, n).reduce((s, v) => s + v, 0),
+    highest: (a, n) => {
+      const v = tail(a, n);
+      return v.length ? Math.max(...v) : null;
+    },
+    lowest: (a, n) => {
+      const v = tail(a, n);
+      return v.length ? Math.min(...v) : null;
+    },
+    zscore: (a, n) => {
+      const m = sma(a, n),
+        s = std(a, n);
+      return m === null || !s ? null : (a[a.length - 1] - m) / s;
+    },
+    wma: (a, n) => {
+      if (a.length < n) return null;
+      const v = tail(a, n);
+      return (
+        v.reduce((s, x, i) => s + x * (i + 1), 0) /
+        ((v.length * (v.length + 1)) / 2)
+      );
+    },
+    atr: (bars, n = 14) => {
+      if (bars.length < n + 1) return null;
+      const t = [];
+      for (let i = 1; i < bars.length; i++)
+        t.push(
+          Math.max(
+            bars[i].high - bars[i].low,
+            Math.abs(bars[i].high - bars[i - 1].close),
+            Math.abs(bars[i].low - bars[i - 1].close),
+          ),
+        );
+      return sma(t, n);
+    },
+    bands: (a, n = 20, k = 2) => {
+      const m = sma(a, n),
+        s = std(a, n);
+      return m === null || s === null
+        ? null
+        : { middle: m, upper: m + k * s, lower: m - k * s };
+    },
+    crossover: (a, b, prevA, prevB) => a > b && prevA <= prevB,
+    crossunder: (a, b, prevA, prevB) => a < b && prevA >= prevB,
+    push: (a, value, limit = 200) =>
+      [...a, value].slice(-Math.max(1, Math.min(5000, limit))),
+  });
+  return Object.freeze({
+    defineIndicator: (s) => s,
+    defineExpert: (s) => s,
+    ta,
+    clamp: (v, a, b) => Math.max(a, Math.min(b, v)),
+    ratio: (n, d) => (d === 0 ? null : n / d),
+  });
+}
+module.exports = { makeSDK };
diff --git a/packages/tickscript/test/batch.test.cjs b/packages/tickscript/test/batch.test.cjs
