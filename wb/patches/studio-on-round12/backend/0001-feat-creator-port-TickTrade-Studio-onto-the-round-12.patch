+    offsetValue?: string,
+    snapshot?: string,
+  ) {
+    const offset = Number(offsetValue || 0);
+    if (!Number.isInteger(offset) || offset < 0 || offset > 500)
+      throw new BadRequestException('Invalid offset');
+    for (const [key, value] of this.exports)
+      if (value.until < Date.now()) this.exports.delete(key);
+    let bank: any,
+      token = snapshot;
+    if (token) {
+      const saved = this.exports.get(token);
+      if (!saved || saved.owner !== owner)
+        throw new NotFoundException('Export snapshot expired');
+      bank = saved.bank;
+    } else {
+      if (offset)
+        throw new BadRequestException(
+          'A continuation requires its export snapshot',
+        );
+      if (this.exports.size >= 8)
+        throw new ServiceUnavailableException(
+          'Export queue is full. Try again shortly.',
+        );
+      bank = await this.bank(round);
+      for (const [key, value] of [...this.exports.entries()]
+        .filter(([, v]) => v.owner === owner)
+        .slice(0, -1))
+        this.exports.delete(key);
+      if (this.exports.size >= 8)
+        throw new ServiceUnavailableException(
+          'Export queue is full. Try again shortly.',
+        );
+      token = randomUUID();
+      this.exports.set(token, { owner, until: Date.now() + 120000, bank });
+    }
+    return {
+      version: bank.version,
+      asOf: bank.asOf,
+      round: bank.round,
+      summary: bank.summary,
+      coverage: bank.coverage,
+      snapshot: token,
+      records: bank.records
+        .slice(offset, offset + 25)
+        .map((r: any) => this.hydrate(r, bank)),
+      next: offset + 25 < bank.records.length ? offset + 25 : null,
+    };
+  }
+}
