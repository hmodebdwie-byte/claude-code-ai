+      // null (the peer-benchmark percentiles do the latter when their source
+      // metric is not finite). `typeof null` is "object", so the older check
+      // only caught the first form and those fields shipped as a bare null with
+      // no explanation, which the bank contract does not allow.
+      if (value === null || value === undefined ||
+          (typeof value === "number" && !finite(value)))
+        reason ||= "Required source observations are unavailable";
+      if (reason && typeof value === "number") put(record, key, null);
+      provenance[key] = {
+        source: reason
+          ? "unavailable"
+          : key.startsWith("trackRecord.") ||
+              key.startsWith("statisticalReliability.")
