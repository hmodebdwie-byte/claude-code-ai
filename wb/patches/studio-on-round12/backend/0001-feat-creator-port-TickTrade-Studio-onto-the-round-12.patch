+ onUpdate(c){const m=c.data.market!,t=c.data.traders!,q=c.data.quality!,flow=c.data.liquidity!;
+  const raw=flow.imbalance>Number(c.params.threshold)?'BUY':flow.imbalance< -Number(c.params.threshold)?'SELL':null;
