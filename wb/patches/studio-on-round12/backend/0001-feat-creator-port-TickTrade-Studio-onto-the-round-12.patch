--- /dev/null
+++ b/packages/tickscript/intelligence-utils.cjs
@@ -0,0 +1,37 @@
+"use strict";
+const sum = (v) => v.reduce((a, b) => a + b, 0),
+  mean = (v) => (v.length ? sum(v) / v.length : null);
+const q = (v, p) => {
+  if (!v.length) return null;
+  const s = [...v].sort((a, b) => a - b),
+    i = (s.length - 1) * p;
+  return s[Math.floor(i)] + (s[Math.ceil(i)] - s[Math.floor(i)]) * (i % 1);
+};
+// `mean(v)` is loop-invariant. It used to sit inside the map callback, so an
+// O(n) reduce ran once per element and sd() was O(n^2); it is the dominant cost
+// of a DataBank build. Hoisting is arithmetically identical - mean(v) is
+// deterministic for a given array, so every digit of the result is unchanged.
+const sd = (v) => {
+  if (v.length <= 1) return null;
+  const m = mean(v);
+  return Math.sqrt(sum(v.map((x) => (x - m) ** 2)) / (v.length - 1));
+};
+const ratio = (a, b) =>
+  Number.isFinite(a) && Number.isFinite(b) && b !== 0 ? a / b : null;
+const effective = (v) => ratio(sum(v) ** 2, sum(v.map((x) => x * x)));
+const entropy = (v) => {
+  const t = sum(v);
+  return t
+    ? -sum(v.filter((x) => x > 0).map((x) => (x / t) * Math.log2(x / t)))
+    : null;
+};
+function wilson(w, n) {
+  if (!n) return { low: null, high: null };
+  const z = 1.96,
+    p = w / n,
+    d = 1 + (z * z) / n,
+    c = (p + (z * z) / (2 * n)) / d,
+    h = (z * Math.sqrt((p * (1 - p) + (z * z) / (4 * n)) / n)) / d;
+  return { low: Math.max(0, c - h), high: Math.min(1, c + h) };
+}
+module.exports = { sum, mean, q, sd, ratio, effective, entropy, wilson };
