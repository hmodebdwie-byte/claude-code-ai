+    averageForecastReadiness: average('forecast.readiness'),
+    averageCausalGrade: average('causalLab.gradeScore'),
+    averageGraphConfidence: average('graph.confidence'),
+    averageRegimeFit: average('regime.currentFit'),
+    averageShadowReadiness: average('modelAudit.shadowReadiness'),
+    shadowReadyProfiles: above('modelAudit.productionGateScore', 82),
+    averageEvidenceQuality: average('governance.evidenceGradeScore'),
+    averageExecutionQuality: average('industrial.executionQualityScore'),
+    averageBehavioralStability: average('industrial.behavioralStabilityScore'),
+    averagePeerPercentile: average('benchmark.overallPercentile'),
+    highSignalRecords: above('intelligence.score', 58),
+    anomalyWatch: above('risk.anomalyScore', 70),
