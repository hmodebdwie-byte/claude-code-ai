+  },
+]);
+const fail = (message) => {
+  throw new Error(message);
+};
+const object = (value, label) => {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    fail(`${label} must be an object`);
+  return value;
+};
+const string = (value, label, max = 120) => {
+  if (typeof value !== "string" || !value.trim() || value.length > max)
+    fail(`${label} must contain 1-${max} characters`);
+  return value;
+};
+const finite = (value, label, min = -1e12, max = 1e12) => {
+  if (
+    typeof value !== "number" ||
+    !Number.isFinite(value) ||
+    value < min ||
+    value > max
+  )
+    fail(`${label} must be a finite number between ${min} and ${max}`);
+  return value;
+};
+const identifier = (value) => {
+  if (
+    typeof value !== "string" ||
+    !/^[a-zA-Z][a-zA-Z0-9_-]{0,39}$/.test(value) ||
+    ["constructor", "prototype", "__proto__"].includes(value)
+  )
+    fail("Invalid identifier");
+  return value;
+};
+function validateManifest(m) {
+  object(m, "Manifest");
+  string(m.name, "Name", 80);
+  string(m.description, "Description", 600);
+  if (m.sdkVersion !== "1" || !["indicator", "expert"].includes(m.kind))
+    fail("Use TickScript SDK 1 and kind indicator or expert");
+  if (
+    !Array.isArray(m.modes) ||
+    !m.modes.length ||
+    m.modes.length > 2 ||
+    m.modes.some((v) => !["arena", "binary"].includes(v)) ||
+    new Set(m.modes).size !== m.modes.length
+  )
+    fail("Modes must contain arena and/or binary");
+  if (m.stateScope != null && !["round", "series"].includes(m.stateScope))
+    fail("Invalid stateScope");
+  if (m.warmupBars != null) finite(m.warmupBars, "warmupBars", 0, 5000);
+  if (
+    !Array.isArray(m.requires) ||
+    m.requires.length < 1 ||
+    m.requires.length > FEATURES.length ||
+    new Set(m.requires).size !== m.requires.length ||
+    m.requires.some((id) => !FEATURES.some((f) => f.id === id))
+  )
+    fail("Unknown or duplicate feature dependency");
+  const parameters = object(m.parameters || {}, "Parameters");
+  if (Object.keys(parameters).length > 24) fail("At most 24 parameters");
+  for (const [key, p] of Object.entries(parameters)) {
+    identifier(key);
+    object(p, "Parameter");
+    string(p.label, "Parameter label", 60);
+    if (!["number", "integer", "boolean"].includes(p.type))
+      fail("Unsupported parameter type");
+    if (p.type === "boolean") {
+      if (typeof p.default !== "boolean") fail("Boolean default required");
+    } else {
+      finite(p.min, "Minimum");
+      finite(p.max, "Maximum", p.min);
+      finite(p.default, "Default", p.min, p.max);
+      if (p.type === "integer" && !Number.isInteger(p.default))
+        fail("Integer default required");
+    }
+    if (
+      key === "windowSeconds" &&
+      (p.type !== "integer" || p.min < 5 || p.max > 300)
+    )
+      fail("windowSeconds must be an integer between 5 and 300");
+  }
+  return {
+    sdkVersion: "1",
+    name: m.name,
+    description: m.description,
+    kind: m.kind,
+    modes: m.modes,
+    stateScope: m.stateScope || "round",
+    warmupBars: Math.floor(m.warmupBars ?? 600),
+    requires: m.requires,
+    parameters,
+  };
+}
+function parametersFor(manifest, supplied = {}) {
+  object(supplied, "Parameter values");
+  const values = Object.create(null);
+  for (const key of Object.keys(supplied))
+    if (!Object.hasOwn(manifest.parameters, key))
+      fail(`Unknown parameter: ${key}`);
+  for (const [key, p] of Object.entries(manifest.parameters)) {
+    const v = Object.hasOwn(supplied, key) ? supplied[key] : p.default;
+    if (p.type === "boolean") {
+      if (typeof v !== "boolean") fail(`${key} must be boolean`);
+    } else {
+      finite(v, key, p.min, p.max);
+      if (p.type === "integer" && !Number.isInteger(v))
+        fail(`${key} must be integer`);
+    }
+    values[key] = v;
+  }
+  return values;
+}
+function validateOutput(output, kind) {
+  object(output, "Output");
+  if (Buffer.byteLength(JSON.stringify(output)) > LIMITS.outputBytes)
+    fail("Output exceeds 32 KB");
+  const plots = output.plots || [];
+  if (!Array.isArray(plots) || plots.length > LIMITS.plots)
+    fail("At most 8 plots");
+  const ids = new Set();
+  for (const p of plots) {
+    object(p, "Plot");
+    identifier(p.id);
+    if (ids.has(p.id)) fail("Duplicate plot identifier");
+    ids.add(p.id);
+    string(p.label, "Plot label", 60);
+    if (!["overlay", "pane"].includes(p.placement))
+      fail("Invalid plot placement");
+    if (p.value !== null) finite(p.value, "Plot value");
+    if (p.color != null && !/^#[0-9a-fA-F]{6}$/.test(p.color))
+      fail("Use a six-digit hex color");
+    if (
+      p.style != null &&
+      !["line", "histogram", "area", "step"].includes(p.style)
+    )
+      fail("Invalid plot style");
+    if (p.pane != null) identifier(p.pane);
+    if (p.unit != null) string(p.unit, "Plot unit", 16);
+    if (p.precision != null && (!Number.isInteger(p.precision) || p.precision < 0 || p.precision > 8)) fail("Plot precision must be an integer from 0 to 8");
+    if (p.scaleMin != null) finite(p.scaleMin, "scaleMin");
+    if (p.scaleMax != null) finite(p.scaleMax, "scaleMax", p.scaleMin ?? -1e12);
+    if (p.levels != null) {
+      if (!Array.isArray(p.levels) || p.levels.length > 8)
+        fail("At most 8 levels");
+      for (const level of p.levels) finite(level, "Level");
+    }
+  }
+  const tones = ["buy", "sell", "neutral", "warning"];
+  if (output.card != null) {
+    const c = object(output.card, "Card");
+    string(c.title, "Card title", 80);
+    if (c.status != null) string(c.status, "Card status", 160);
+    if (c.tone != null && !tones.includes(c.tone)) fail("Invalid card tone");
+    if (!Array.isArray(c.metrics) || c.metrics.length > LIMITS.metrics)
+      fail("At most 12 card metrics");
+    if (c.plots != null && (!Array.isArray(c.plots) || c.plots.length > LIMITS.plots || c.plots.some(id => !ids.has(id)) || new Set(c.plots).size !== c.plots.length)) fail("Card plots must reference unique output plots");
+    if (c.footer != null && (!Array.isArray(c.footer) || c.footer.length > 4)) fail("At most 4 footer metrics");
+    for (const m of [...c.metrics, ...(c.footer || [])]) {
+      string(m.label, "Metric label", 60);
+      if (typeof m.value === "number") finite(m.value, "Metric value");
+      else if (m.value !== null) string(m.value, "Metric value", 120);
+      if (m.suffix != null) string(m.suffix, "Metric suffix", 24);
+      if (m.precision != null && (!Number.isInteger(m.precision) || m.precision < 0 || m.precision > 8)) fail("Metric precision must be an integer from 0 to 8");
+      if (m.tone != null && !tones.includes(m.tone))
+        fail("Invalid metric tone");
+    }
+  }
+  const signals = output.signals || [];
+  if (!Array.isArray(signals) || signals.length > LIMITS.signals)
+    fail("At most 4 signals");
+  if (kind !== "expert" && signals.length)
+    fail("Indicators cannot emit trade requests");
+  const signalIds = new Set();
+  for (const s of signals) {
+    identifier(s.id);
+    if (signalIds.has(s.id)) fail("Duplicate signal identifier");
+    signalIds.add(s.id);
+    if (!["BUY", "SELL"].includes(s.side)) fail("Invalid signal side");
+    finite(s.amount, "Paper stake", 0.01, 100000);
+    string(s.reason, "Signal reason", 240);
+  }
+  const state = output.state || {};
+  object(state, "State");
+  if (Buffer.byteLength(JSON.stringify(state)) > LIMITS.stateBytes)
+    fail("State exceeds 8 KB");
+  return {
+    plots,
+    ...(output.card ? { card: output.card } : {}),
+    signals,
+    state,
+  };
+}
+module.exports = {
+  LIMITS,
+  FEATURES,
+  validateManifest,
+  parametersFor,
+  validateOutput,
+};
