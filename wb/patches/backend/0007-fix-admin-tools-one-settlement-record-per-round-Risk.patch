+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { replayBattlePricing, type ReplayTrade } from './price-audit-replay';
+import { PRICE_PIP_SIZE } from './pip-size';
+import type { PipImpactConfigValue } from '../events/pip-impact-config.redis';
+
+const CONFIG: PipImpactConfigValue = { referenceAmount: 1_000_000, referencePips: 10, curve: 'linear', sensitivity: 8, multiplier: 10 };
+const t0 = new Date('2026-01-01T00:00:00Z');
+const trade = (id: string, side: 'BUY' | 'SELL', amount: number, isNpc: boolean, sec: number): ReplayTrade => ({
+    id,
+    userId: isNpc ? null : 1,
+    side,
+    amount,
+    quantity: amount,
+    entryPrice: null,
+    createdAt: new Date(t0.getTime() + sec * 1000),
+    isNpc,
+});
+const input = { battleId: 1, startPrice: 1.42938, durationSeconds: 60, startTime: t0, trades: [trade('npc-1', 'BUY', 20_000, true, 5), trade('stake-1', 'SELL', 100_000, false, 10), trade('npc-2', 'SELL', 30_000, true, 20)] };
+
+test('recorded NPC moves are applied verbatim; real trades still move by the exact formula', () => {
+    const r = replayBattlePricing(input, CONFIG, 0, { actualNpcTicks: [{ deltaPips: 2.4 }, { deltaPips: -1.1 }] });
+    assert.equal(r.method, 'formula_real_plus_actual_npc');
+    assert.equal(r.npcTicksMatched, 2);
+    assert.equal(r.npcTicksMissing, 0);
+    assert.deepEqual(r.ticks.map((t) => t.source), ['actual_npc', 'formula', 'actual_npc']);
+    assert.equal(r.ticks[0]!.deltaPips, 2.4);
+    assert.equal(r.ticks[2]!.deltaPips, -1.1);
+    // $100k SELL, linear, sensitivity 8 (×1.6), multiplier 10: exactly 16 pips down.
+    assert.equal(r.ticks[1]!.deltaPips, -16);
+    const expectedEnd = Math.round((1.42938 + (2.4 - 16 - 1.1) * PRICE_PIP_SIZE) * 100000) / 100000;
+    assert.equal(r.expectedEndPrice, expectedEnd);
+});
+
+test('an NPC trade with no recorded tick left is re-run through the formula and counted as missing', () => {
+    const r = replayBattlePricing(input, CONFIG, 0, { actualNpcTicks: [{ deltaPips: 2.4 }] });
+    assert.equal(r.npcTicksMatched, 1);
+    assert.equal(r.npcTicksMissing, 1);
+    assert.equal(r.ticks[2]!.source, 'formula');
+});
+
+test('without recorded ticks the replay is the full formula replay, as before', () => {
+    const r = replayBattlePricing(input, CONFIG, 0);
+    assert.equal(r.method, 'full_replay');
+    assert.equal(r.npcTicksMatched, 0);
+    assert.ok(r.ticks.every((t) => t.source === 'formula'));
+});
