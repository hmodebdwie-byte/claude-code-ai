@@ -0,0 +1,108 @@
+import { Injectable, Logger, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
+import { parseRoundValuation } from '@ticktrade/shared';
+import { PrismaService } from '../prisma/prisma.service';
+import { AdminPlatformSettingsService } from './platform-settings/admin-platform-settings.service';
+import { AdminAlertsService } from './alerts/admin-alerts.service';
+import { RiskTerminalAlertLeaderService } from './risk-terminal-alert-leader.service';
+
+const SCAN_INTERVAL_MS = Math.max(
+    15_000,
+    Number.parseInt(process.env.RISK_BREACH_ALERT_SCAN_INTERVAL_MS || String(60_000), 10) || 60_000,
+);
+/** Only rounds settled within this window are considered (older ones were alerted, or predate the scanner). */
+const LOOKBACK_MS = Math.max(
+    5 * 60_000,
+    Number.parseInt(process.env.RISK_BREACH_ALERT_LOOKBACK_MS || String(6 * 60 * 60_000), 10) || 6 * 60 * 60_000,
+);
+const MONEY_EPS = 0.01;
+
+/**
+ * Raises the `RISK_BREACH` admin alert the Notification Preferences toggles ("Risk breaches",
+ * in-app / email) promise but nothing produced before. Reads the round valuations settlement
+ * writes (`npc_round_audit.settlement`) — one alert per breached round, deduplicated on the
+ * battle id. Leader-elected like the other scanners so a multi-worker deployment alerts once.
+ */
+@Injectable()
+export class RiskBreachAlertScannerService implements OnModuleInit, OnModuleDestroy {
+    private readonly logger = new Logger(RiskBreachAlertScannerService.name);
+    private timer: NodeJS.Timeout | null = null;
+    private running = false;
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly platformSettings: AdminPlatformSettingsService,
+        private readonly adminAlertsService: AdminAlertsService,
+        private readonly leader: RiskTerminalAlertLeaderService,
+    ) {}
+
+    onModuleInit(): void {
+        this.timer = setInterval(() => void this.tick(), SCAN_INTERVAL_MS);
+    }
+
+    onModuleDestroy(): void {
+        if (this.timer) {
+            clearInterval(this.timer);
+            this.timer = null;
+        }
+    }
+
+    private async tick(): Promise<void> {
+        if (this.running || !this.leader.isAlertScanLeader()) return;
+        this.running = true;
+        try {
+            await this.scan();
+        } catch (err) {
+            this.logger.error('Risk breach alert scan failed', err as Error);
+        } finally {
+            this.running = false;
+        }
+    }
+
+    async scan(): Promise<number> {
+        const prefs = await this.platformSettings.getNotificationPreferences();
+        const { alertRiskBreaches, emailAlertRiskBreaches } = prefs.settings;
+        if (!alertRiskBreaches && !emailAlertRiskBreaches) return 0;
+
+        const since = new Date(Date.now() - LOOKBACK_MS);
+        const audits = await this.prisma.npcRoundAudit.findMany({
+            where: { updatedAt: { gte: since }, settlement: { not: null as never } },
+            select: { battleId: true, settlement: true },
+            orderBy: { battleId: 'desc' },
+            take: 500,
+        });
+        const breached = audits
+            .map((a) => ({ battleId: a.battleId, valuation: parseRoundValuation(a.settlement) }))
+            .filter((a) => a.valuation != null && (a.valuation.shortfall > MONEY_EPS || a.valuation.houseCashResult < -MONEY_EPS));
+        if (breached.length === 0) return 0;
+
+        const already = await this.prisma.adminAlert.findMany({
+            where: { type: 'RISK_BREACH', relatedId: { in: breached.map((b) => b.battleId) } },
+            select: { relatedId: true },
+        });
+        const alertedIds = new Set(already.map((a) => a.relatedId));
+        let raised = 0;
+        for (const { battleId, valuation } of breached) {
+            if (alertedIds.has(battleId) || !valuation) continue;
+            const shortfall = valuation.shortfall;
+            const cash = valuation.houseCashResult;
+            const parts: string[] = [];
+            if (shortfall > MONEY_EPS) {
+                parts.push(`real winners were paid $${valuation.realWinnersTotal.toFixed(2)} of profit against a net real loser pool of $${valuation.netRealLoserPool.toFixed(2)} (shortfall $${shortfall.toFixed(2)})`);
+            }
+            if (cash < -MONEY_EPS) {
+                parts.push(`real money out exceeded real money in by $${(-cash).toFixed(2)}`);
+            }
+            await this.adminAlertsService.raise({
+                type: 'RISK_BREACH',
+                title: `Risk breach on battle #${battleId}: $${Math.max(shortfall, -cash).toFixed(2)}`,
+                message: `Battle #${battleId} (${valuation.winnerSide} won, ${valuation.model} model): ${parts.join('; ')}. Open Risk Breaches for the full audit.`,
+                relatedId: battleId,
+                inAppEnabled: alertRiskBreaches,
+                emailEnabled: emailAlertRiskBreaches,
+                pushEnabled: false,
+            });
+            raised += 1;
+        }
+        return raised;
+    }
+}
