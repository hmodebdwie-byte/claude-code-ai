+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { computeDirectiveSettlement } from '../npc-organic/directive-settlement';
+import { parseRoundValuation, valuationFromDirective, valuationFromModelA, valuationFromTie } from './round-valuation';
+
+const stake = (id: number, userId: number, side: 'BUY' | 'SELL', amount: number) => ({ id, userId, side, amount, entryPrice: 1, entryTimestampMs: 0 });
+const npc = (id: number, side: 'BUY' | 'SELL', amount: number) => ({ id, npcId: 900 + id, side, amount, entryPrice: 1, entryTimestampMs: 0 });
+
+test('directive valuation: house cash = real losing − real winners profit; shortfall = paid beyond the net real pool', () => {
+    // Real BUY 100 wins against real SELL 50 and NPC SELL 500, fee 30%.
+    const result = computeDirectiveSettlement({
+        buyPot: 100,
+        sellPot: 550,
+        realStakes: [stake(1, 1, 'BUY', 100), stake(2, 2, 'SELL', 50)],
+        npcTrades: [npc(1, 'SELL', 500)],
+        finalPrice: 1.1,
+        startPrice: 1,
+        roundHigh: 1.1,
+        roundLow: 1,
+        pricePoints: [],
+        platformFeeRate: 0.3,
+        forceWinnerSide: 'BUY',
+    });
+    const v = valuationFromDirective(result, { hedgedUserCount: 0, settingsVersion: 3 });
+    assert.equal(v.model, 'directive');
+    assert.equal(v.winnerSide, 'BUY');
+    assert.equal(v.realLosingVolume, 50);
+    assert.equal(v.commission, 15);
+    assert.equal(v.netRealLoserPool, 35);
+    assert.equal(v.houseCashResult, Math.round((50 - result.realWinnersTotal) * 100) / 100);
+    assert.equal(v.shortfall, Math.round(Math.max(0, result.realWinnersTotal - 35) * 100) / 100);
+    assert.equal(v.settingsVersion, 3);
+    assert.equal(v.realWinnerUserCount, 1);
+    assert.equal(v.realLoserUserCount, 1);
+    // Round trip through JSON, as npc_round_audit.settlement stores it.
+    const parsed = parseRoundValuation(JSON.parse(JSON.stringify(v)));
+    assert.deepEqual(parsed, v);
+});
+
+test('legacy valuation: real losers fund real winners → commission from real, no shortfall', () => {
+    const v = valuationFromModelA({
+        winnerSide: 'SELL',
+        winnerReason: 'pot_dominance',
+        platformFeeRate: 0.3,
+        realLosingVolume: 200,
+        realWinningVolume: 100,
+        npcLosingVolume: 0,
+        npcWinningVolume: 300,
+        losingPot: 200,
+        platformFee: 60,
+        netLoserPool: 140,
+        distributedToRealUsers: 35,
+        npcRetainedRewardShare: 105,
+        dilutionTriggered: true,
+        injectionAmount: 0,
+        distributedToNpcWinners: 0,
+        npcWinnerPoolFee: 0,
+        realWinnerUserCount: 1,
+        realLoserUserCount: 2,
+        hedgedUserCount: 0,
+    });
+    assert.equal(v.model, 'model_a');
+    assert.equal(v.commissionSource, 'real');
+    assert.equal(v.netRealLoserPool, 140);
+    assert.equal(v.shortfall, 0);
+    assert.equal(v.houseCashResult, 165);
+    assert.equal(v.companyNet, 165);
+});
+
+test('legacy valuation: no real losers → the NPC pool funded real winners, which is a shortfall and a house cash loss', () => {
+    const v = valuationFromModelA({
+        winnerSide: 'BUY',
+        winnerReason: 'pot_dominance',
+        platformFeeRate: 0.3,
+        realLosingVolume: 0,
+        realWinningVolume: 100,
+        npcLosingVolume: 500,
+        npcWinningVolume: 0,
+        losingPot: 500,
+        platformFee: 150,
+        netLoserPool: 350,
+        distributedToRealUsers: 350,
+        npcRetainedRewardShare: 0,
+        dilutionTriggered: false,
+        injectionAmount: 0,
+        distributedToNpcWinners: 0,
+        npcWinnerPoolFee: 0,
+        realWinnerUserCount: 1,
+        realLoserUserCount: 0,
+        hedgedUserCount: 0,
+    });
+    assert.equal(v.commissionSource, 'simulator');
+    assert.equal(v.netRealLoserPool, 0);
+    assert.equal(v.shortfall, 350);
+    assert.equal(v.houseCashResult, -350);
+    // The fee taken from the simulator's own pool is not real income.
+    assert.equal(v.companyNet, 0);
+});
+
+test('tie valuation: everything refunded, nothing earned, nothing owed', () => {
+    const v = valuationFromTie({ platformFeeRate: 0.3, realBuyVolume: 10, realSellVolume: 10, npcBuyVolume: 5, npcSellVolume: 5, refundedToRealUsers: 20, hedgedUserCount: 1 });
+    assert.equal(v.model, 'tie');
+    assert.equal(v.winnerSide, 'TIE');
+    assert.equal(v.commission, 0);
+    assert.equal(v.houseCashResult, 0);
+    assert.equal(v.refundedToRealUsers, 20);
+    assert.equal(v.hedgedUserCount, 1);
+});
+
+test('parseRoundValuation rejects rows written before the record existed', () => {
+    assert.equal(parseRoundValuation(null), null);
+    assert.equal(parseRoundValuation({ model: 'directive', commission: 1 }), null);
+    assert.equal(parseRoundValuation({ model: 'unknown', houseCashResult: 0, shortfall: 0 }), null);
+});
diff --git a/packages/shared/src/risk/round-valuation.ts b/packages/shared/src/risk/round-valuation.ts
new file mode 100644
index 0000000..6bb798e
--- /dev/null
+++ b/packages/shared/src/risk/round-valuation.ts
@@ -0,0 +1,278 @@
+/**
+ * One record of what a settled round did with the money — written by settlement (every model:
+ * directive, legacy Model A, tie) into `npc_round_audit.settlement`, and read by the admin risk
+ * and inspection tools instead of re-deriving settlement with their own formulas.
+ *
+ * Conventions (all USD, 2 dp):
+ *  - "real" = human stakes, net per user (hedged / matched volume removed), exactly as settlement
+ *    valued them; "sim" = NPC trades.
+ *  - `commission` is the platform fee actually taken (on the real losing pool; in the legacy model
+ *    it may have been taken from an NPC-only losing pool — see `commissionSource`).
+ *  - `netRealLoserPool` = real losing volume after commission: the money that funds real winners.
+ *  - `realWinnersTotal` = profit paid to real winners (stakes returned are not included).
+ *  - `shortfall` = real winners paid beyond the net real loser pool (funded by NPC / house money).
+ *  - `houseCashResult` = real money in − real money out for the round = realLosingVolume −
+ *    realWinnersTotal − refunds that came from house money (0 in every current model). Negative
+ *    means the round cost the house cash.
+ */
+import type { DirectiveSettlementResult } from '../npc-organic/directive-settlement';
+
+export type RoundValuationModel = 'directive' | 'model_a' | 'tie';
+
+export interface RoundValuation {
+    model: RoundValuationModel;
+    winnerSide: 'BUY' | 'SELL' | 'TIE';
+    winnerReason: string;
+    settledAt: string;
+    platformFeeRate: number;
+    /** Where the commission came from: real losers, the simulator's own losing pool, or nobody. */
+    commissionSource: 'real' | 'simulator' | 'none';
+    realLosingVolume: number;
+    realWinningVolume: number;
+    commission: number;
+    netRealLoserPool: number;
+    realWinnersTotal: number;
+    houseRetained: number;
+    simLosingVolume: number;
+    simWinningVolume: number;
+    simProfit: number;
+    surplusToReal: number;
+    simulatorNet: number;
+    /** The settlement model's own "company" figure (directive: commission + unpaid pool). */
+    companyNet: number;
+    /** Real money in minus real money out. Negative = the round cost the house cash. */
+    houseCashResult: number;
+    shortfall: number;
+    /** Real winners' profit funded by NPC / house money (= shortfall, kept explicit). */
+    simulatorFundedRealWinners: number;
+    realWinnerUserCount: number;
+    realLoserUserCount: number;
+    hedgedUserCount: number;
+    refundedToRealUsers: number;
+    /** Legacy model only. */
+    npcRetainedRewardShare: number;
+    npcWinnerPoolFee: number;
+    distributedToNpcWinners: number;
+    dilutionTriggered: boolean;
+    injectionAmount: number;
+    settingsVersion: number | null;
+}
+
+const r2 = (n: number): number => Math.round((Number.isFinite(n) ? n : 0) * 100) / 100;
+
+export function valuationFromDirective(
+    result: DirectiveSettlementResult,
+    extra: { hedgedUserCount: number; settingsVersion: number | null; refundedToRealUsers?: number; settledAt?: string },
+): RoundValuation {
+    const realWinnersTotal = r2(result.realWinnersTotal);
+    const netPool = r2(result.netRealLoserPool);
+    const shortfall = r2(Math.max(0, realWinnersTotal - netPool));
+    return {
+        model: 'directive',
+        winnerSide: result.winnerSide,
+        winnerReason: result.winnerReason,
+        settledAt: extra.settledAt ?? new Date().toISOString(),
+        platformFeeRate: result.platformFeeRate,
+        commissionSource: result.commission > 0 ? 'real' : 'none',
+        realLosingVolume: r2(result.realLosingVolume),
+        realWinningVolume: r2(result.realWinningVolume),
+        commission: r2(result.commission),
+        netRealLoserPool: netPool,
+        realWinnersTotal,
+        houseRetained: r2(result.houseRetained),
+        simLosingVolume: r2(result.simLosingVolume),
+        simWinningVolume: r2(result.simWinningVolume),
+        simProfit: r2(result.simProfit),
+        surplusToReal: r2(result.surplusToReal),
+        simulatorNet: r2(result.simulatorNet),
+        companyNet: r2(result.companyNet),
+        houseCashResult: r2(result.realLosingVolume - realWinnersTotal),
+        shortfall,
+        simulatorFundedRealWinners: r2(Math.max(result.simulatorFundedRealWinners, shortfall)),
+        realWinnerUserCount: result.realWinnerUserCount,
+        realLoserUserCount: result.realLoserUserCount,
+        hedgedUserCount: extra.hedgedUserCount,
+        refundedToRealUsers: r2(extra.refundedToRealUsers ?? 0),
+        npcRetainedRewardShare: 0,
+        npcWinnerPoolFee: 0,
+        distributedToNpcWinners: r2(result.simProfit),
+        dilutionTriggered: result.surplusToReal > 0,
+        injectionAmount: 0,
+        settingsVersion: extra.settingsVersion,
+    };
+}
+
+export interface ModelAValuationInput {
+    winnerSide: 'BUY' | 'SELL';
+    winnerReason: string;
+    platformFeeRate: number;
+    /** Hedge-adjusted real pots, as settlement used them. */
+    realLosingVolume: number;
+    realWinningVolume: number;
+    npcLosingVolume: number;
+    npcWinningVolume: number;
+    /** From computePayouts. */
+    losingPot: number;
+    platformFee: number;
+    netLoserPool: number;
+    distributedToRealUsers: number;
+    npcRetainedRewardShare: number;
+    dilutionTriggered: boolean;
+    injectionAmount: number;
+    /** From computeOneSidedNpcWinnerPayouts (0 when none). */
+    distributedToNpcWinners: number;
+    npcWinnerPoolFee: number;
+    realWinnerUserCount: number;
+    realLoserUserCount: number;
+    hedgedUserCount: number;
+    refundedToRealUsers?: number;
+    settledAt?: string;
+}
+
+export function valuationFromModelA(i: ModelAValuationInput): RoundValuation {
+    const realLosing = r2(i.realLosingVolume);
+    const realWinnersTotal = r2(i.distributedToRealUsers);
+    const commissionSource: RoundValuation['commissionSource'] =
+        i.platformFee <= 0 ? 'none' : realLosing > 0.005 ? 'real' : 'simulator';
+    // The pool that funded real winners: the real loser pool net of fee when there were real
+    // losers, otherwise nothing real (the NPC losing pool is house money).
+    const netRealLoserPool = r2(commissionSource === 'real' ? i.netLoserPool : 0);
+    const shortfall = r2(Math.max(0, realWinnersTotal - netRealLoserPool));
+    const commissionFromReal = commissionSource === 'real' ? r2(i.platformFee) : 0;
+    return {
+        model: 'model_a',
+        winnerSide: i.winnerSide,
+        winnerReason: i.winnerReason,
+        settledAt: i.settledAt ?? new Date().toISOString(),
+        platformFeeRate: i.platformFeeRate,
+        commissionSource,
+        realLosingVolume: realLosing,
+        realWinningVolume: r2(i.realWinningVolume),
+        commission: r2(i.platformFee),
+        netRealLoserPool,
+        realWinnersTotal,
+        houseRetained: r2(i.npcRetainedRewardShare),
+        simLosingVolume: r2(i.npcLosingVolume),
+        simWinningVolume: r2(i.npcWinningVolume),
+        simProfit: r2(i.distributedToNpcWinners),
+        surplusToReal: 0,
+        simulatorNet: r2(i.distributedToNpcWinners - i.npcLosingVolume),
+        companyNet: r2(commissionFromReal + i.npcRetainedRewardShare - i.injectionAmount),
+        houseCashResult: r2(realLosing - realWinnersTotal - (i.refundedToRealUsers ?? 0)),
+        shortfall,
+        simulatorFundedRealWinners: shortfall,
+        realWinnerUserCount: i.realWinnerUserCount,
+        realLoserUserCount: i.realLoserUserCount,
+        hedgedUserCount: i.hedgedUserCount,
+        refundedToRealUsers: r2(i.refundedToRealUsers ?? 0),
+        npcRetainedRewardShare: r2(i.npcRetainedRewardShare),
+        npcWinnerPoolFee: r2(i.npcWinnerPoolFee),
+        distributedToNpcWinners: r2(i.distributedToNpcWinners),
+        dilutionTriggered: i.dilutionTriggered,
+        injectionAmount: r2(i.injectionAmount),
+        settingsVersion: null,
+    };
+}
+
+export function valuationFromTie(i: {
+    platformFeeRate: number;
+    realBuyVolume: number;
+    realSellVolume: number;
+    npcBuyVolume: number;
+    npcSellVolume: number;
+    refundedToRealUsers: number;
+    hedgedUserCount: number;
+    settledAt?: string;
+}): RoundValuation {
+    return {
+        model: 'tie',
+        winnerSide: 'TIE',
+        winnerReason: 'equal_total_buy_sell_volume',
+        settledAt: i.settledAt ?? new Date().toISOString(),
+        platformFeeRate: i.platformFeeRate,
+        commissionSource: 'none',
+        realLosingVolume: 0,
+        realWinningVolume: 0,
+        commission: 0,
+        netRealLoserPool: 0,
+        realWinnersTotal: 0,
+        houseRetained: 0,
+        simLosingVolume: 0,
+        simWinningVolume: 0,
+        simProfit: 0,
+        surplusToReal: 0,
+        simulatorNet: 0,
+        companyNet: 0,
+        houseCashResult: 0,
+        shortfall: 0,
+        simulatorFundedRealWinners: 0,
+        realWinnerUserCount: 0,
+        realLoserUserCount: 0,
+        hedgedUserCount: i.hedgedUserCount,
+        refundedToRealUsers: r2(i.refundedToRealUsers),
+        npcRetainedRewardShare: 0,
+        npcWinnerPoolFee: 0,
+        distributedToNpcWinners: 0,
+        dilutionTriggered: false,
+        injectionAmount: 0,
+        settingsVersion: null,
+    };
+}
+
+/**
+ * Reads a stored valuation. Rows the first organic release wrote (`model: 'directive'` with the
+ * settlement invariants but no `houseCashResult` / `shortfall`) are upgraded on read — they carry
+ * every figure the two derived fields need. Returns null for anything else written before this
+ * record existed.
+ */
+export function parseRoundValuation(raw: unknown): RoundValuation | null {
+    if (!raw || typeof raw !== 'object') return null;
+    const o = { ...(raw as Record<string, unknown>) };
+    if (o.model !== 'directive' && o.model !== 'model_a' && o.model !== 'tie') return null;
+    const isNum = (k: string) => typeof o[k] === 'number' && Number.isFinite(o[k] as number);
+    if (!isNum('houseCashResult') || !isNum('shortfall')) {
+        if (o.model !== 'directive' || !isNum('realLosingVolume') || !isNum('realWinnersTotal') || !isNum('netRealLoserPool')) return null;
+        const losing = o.realLosingVolume as number;
+        const winners = o.realWinnersTotal as number;
+        o.houseCashResult = r2(losing - winners);
+        o.shortfall = r2(Math.max(0, winners - (o.netRealLoserPool as number)));
+        if (!isNum('simulatorFundedRealWinners')) o.simulatorFundedRealWinners = o.shortfall;
+        if (o.commissionSource == null) o.commissionSource = (o.commission as number) > 0 ? 'real' : 'none';
+        if (!isNum('distributedToNpcWinners')) o.distributedToNpcWinners = isNum('simProfit') ? o.simProfit : 0;
+        if (o.dilutionTriggered == null) o.dilutionTriggered = isNum('surplusToReal') && (o.surplusToReal as number) > 0;
+    }
+    const num = (k: string): number => (typeof o[k] === 'number' && Number.isFinite(o[k] as number) ? (o[k] as number) : 0);
+    return {
+        model: o.model,
+        winnerSide: o.winnerSide === 'BUY' || o.winnerSide === 'SELL' ? o.winnerSide : 'TIE',
+        winnerReason: typeof o.winnerReason === 'string' ? o.winnerReason : '',
+        settledAt: typeof o.settledAt === 'string' ? o.settledAt : '',
+        platformFeeRate: num('platformFeeRate'),
+        commissionSource: o.commissionSource === 'real' || o.commissionSource === 'simulator' ? o.commissionSource : 'none',
+        realLosingVolume: num('realLosingVolume'),
+        realWinningVolume: num('realWinningVolume'),
+        commission: num('commission'),
+        netRealLoserPool: num('netRealLoserPool'),
+        realWinnersTotal: num('realWinnersTotal'),
+        houseRetained: num('houseRetained'),
+        simLosingVolume: num('simLosingVolume'),
+        simWinningVolume: num('simWinningVolume'),
+        simProfit: num('simProfit'),
+        surplusToReal: num('surplusToReal'),
+        simulatorNet: num('simulatorNet'),
+        companyNet: num('companyNet'),
+        houseCashResult: num('houseCashResult'),
+        shortfall: num('shortfall'),
+        simulatorFundedRealWinners: num('simulatorFundedRealWinners'),
+        realWinnerUserCount: num('realWinnerUserCount'),
+        realLoserUserCount: num('realLoserUserCount'),
+        hedgedUserCount: num('hedgedUserCount'),
+        refundedToRealUsers: num('refundedToRealUsers'),
+        npcRetainedRewardShare: num('npcRetainedRewardShare'),
+        npcWinnerPoolFee: num('npcWinnerPoolFee'),
+        distributedToNpcWinners: num('distributedToNpcWinners'),
+        dilutionTriggered: o.dilutionTriggered === true,
+        injectionAmount: num('injectionAmount'),
+        settingsVersion: typeof o.settingsVersion === 'number' ? o.settingsVersion : null,
+    };
+}
