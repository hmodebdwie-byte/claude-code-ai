+import type { PrismaService } from '../prisma/prisma.service';
+import { RedisPublisher } from '../redis/redis.publisher';
+import { getSharedCommandRedis } from '../redis/redis.client';
+import type { MarketStateRepository } from '../market/market-state.repository';
+import {
+    buildDirectiveRoundInput,
+    computeDualScenarioProjection,
+    humanLiveProjectionOpts,
+    projectDirectiveScenarios,
+    readNpcSimulatorActiveFromRedisOrDefault,
+    resolveNpcEngineContext,
+    RISK_TERMINAL_LAST_TICK_REDIS_KEY,
+    RISK_TERMINAL_LAST_TICK_TTL_SEC,
+    RISK_TERMINAL_TICK_CHANNEL,
+    type RiskTerminalTickPayload,
+} from '@ticktrade/shared';
+
+const SETTING_PLATFORM_FEE_RATE_ACTIVE = 'platform_fee_rate_active';
+const DEFAULT_PLATFORM_FEE_RATE = 0.3;
+/** Re-read the NPC engine mode / fee rate this often (they change rarely; the tick runs every second). */
+const CONTEXT_TTL_MS = 5_000;
+
+/**
+ * Publishes the per-second "IF BUY WINS" / "IF SELL WINS" settlement simulation (Risk Management
+ * Terminal). The projection uses the settlement model that will actually settle the round:
+ * the directive model (`projectDirectiveScenarios`) when the organic engine plays it, the
+ * legacy Model A (`computeDualScenarioProjection`) otherwise — both run the real settlement
+ * functions with the winner forced, so the terminal can never disagree with settlement.
+ *
+ * Reads the engine's own `MarketState` for the live price / pots / extremes (accurate
+ * mid-round, unlike the start-of-round `Battle` row). The last payload is also stored in Redis
+ * (`RISK_TERMINAL_LAST_TICK_REDIS_KEY`) so the REST endpoint serves the same numbers instead of
+ * computing its own. One projection at a time: a slow tick is skipped, never queued.
+ */
+export class RiskTerminalTickPublisher {
+    private inFlight = false;
+    private contextCache: { at: number; battleId: number; mode: 'organic' | 'legacy'; settings: Awaited<ReturnType<typeof resolveNpcEngineContext>>['settings']; feeRate: number } | null = null;
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly redis: RedisPublisher,
+        private readonly marketStateRepo: MarketStateRepository | null,
+    ) {}
+
+    private async context(battleId: number) {
+        const now = Date.now();
+        if (this.contextCache && this.contextCache.battleId === battleId && now - this.contextCache.at < CONTEXT_TTL_MS) {
+            return this.contextCache;
+        }
+        const [ctx, feeRow] = await Promise.all([
+            resolveNpcEngineContext(this.prisma as never, battleId, (key) => this.redis.get(key)),
+            this.prisma.systemSetting.findUnique({ where: { settingKey: SETTING_PLATFORM_FEE_RATE_ACTIVE }, select: { settingValue: true } }),
+        ]);
+        const feeRaw = Number(feeRow?.settingValue ?? DEFAULT_PLATFORM_FEE_RATE);
+        const feeRate = Number.isFinite(feeRaw) ? Math.min(0.95, Math.max(0, feeRaw)) : DEFAULT_PLATFORM_FEE_RATE;
+        this.contextCache = { at: now, battleId, mode: ctx.mode, settings: ctx.settings, feeRate };
+        return this.contextCache;
+    }
+
+    async publish(battleId: number, timeRemainingSeconds?: number) {
+        if (this.inFlight) return;
+        this.inFlight = true;
+        try {
+            await this.publishOnce(battleId, timeRemainingSeconds);
+        } finally {
+            this.inFlight = false;
+        }
+    }
+
+    private async publishOnce(battleId: number, timeRemainingSeconds?: number) {
+        const marketState = this.marketStateRepo ? await this.marketStateRepo.get(battleId) : null;
+        const currentPrice = marketState?.lastPrice;
+        if (currentPrice == null || !Number.isFinite(currentPrice)) {
+            // No live price yet (battle just started, Redis unavailable) — nothing to simulate.
+            return;
+        }
+
+        let payload: RiskTerminalTickPayload;
+        try {
+            const ctx = await this.context(battleId);
+            if (ctx.mode === 'organic') {
+                const battle = await this.prisma.battle.findUnique({ where: { id: battleId }, select: { startPrice: true, buyPot: true, sellPot: true } });
+                if (!battle) return;
+                const input = await buildDirectiveRoundInput(this.prisma as never, {
+                    battleId,
+                    startPrice: Number(battle.startPrice),
+                    finalPrice: currentPrice,
+                    buyPot: marketState?.buyPot ?? Number(battle.buyPot ?? 0),
+                    sellPot: marketState?.sellPot ?? Number(battle.sellPot ?? 0),
+                    platformFeeRate: ctx.feeRate,
+                    settings: ctx.settings,
+                    roundHighOverride: marketState?.roundHigh,
+                    roundLowOverride: marketState?.roundLow,
+                    redis: getSharedCommandRedis(),
+                });
+                const projection = projectDirectiveScenarios(input);
+                payload = {
+                    battle_id: battleId,
+                    model: 'directive',
+                    time_remaining_seconds: timeRemainingSeconds ?? null,
+                    computed_at_ms: Date.now(),
+                    current_price: currentPrice,
+                    pots: projection.pots,
+                    if_buy_wins: projection.if_buy_wins,
+                    if_sell_wins: projection.if_sell_wins,
+                    current: projection.current,
+                };
+            } else {
+                const npcSimulatorActive = await readNpcSimulatorActiveFromRedisOrDefault((key) => this.redis.get(key), true);
+                const projection = await computeDualScenarioProjection(
+                    this.prisma,
+                    battleId,
+                    currentPrice,
+                    humanLiveProjectionOpts(npcSimulatorActive, {
+                        redis: getSharedCommandRedis(),
+                        roundHighOverride: marketState?.roundHigh,
+                        roundLowOverride: marketState?.roundLow,
+                        livePots: marketState ? { buyPot: marketState.buyPot, sellPot: marketState.sellPot } : undefined,
+                    }),
+                );
+                if (!projection) return;
+                payload = {
+                    battle_id: battleId,
+                    model: 'model_a',
+                    time_remaining_seconds: timeRemainingSeconds ?? null,
+                    computed_at_ms: Date.now(),
+                    current_price: currentPrice,
+                    pots: projection.pots,
+                    if_buy_wins: projection.if_buy_wins,
+                    if_sell_wins: projection.if_sell_wins,
+                    current: null,
+                };
+            }
+        } catch (err) {
+            console.warn(`[RiskTerminalTick] projection failed battle=${battleId}: ${err instanceof Error ? err.message : err}`);
+            return;
+        }
+
+        await Promise.all([
+            this.redis.publish(RISK_TERMINAL_TICK_CHANNEL, payload),
+            getSharedCommandRedis()
+                .set(RISK_TERMINAL_LAST_TICK_REDIS_KEY, JSON.stringify(payload), 'EX', RISK_TERMINAL_LAST_TICK_TTL_SEC)
+                .catch(() => undefined),
+        ]);
+    }
+
+    forgetBattle(battleId: number): void {
+        if (this.contextCache?.battleId === battleId) this.contextCache = null;
+    }
+}
