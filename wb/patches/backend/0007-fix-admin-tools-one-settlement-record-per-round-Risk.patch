+/**
+ * Risk Management Terminal live tick (engine → API → admin socket), and the Redis key the engine
+ * keeps the last one under so `GET /admin/risk-terminal/live-state` can serve the same numbers.
+ */
+import type { DirectiveDualScenario } from '../npc-organic/directive-settlement';
+import type { DualScenarioResult } from '../payout/battle-payout.scenarios';
+
+export const RISK_TERMINAL_TICK_CHANNEL = 'engine:events:risk-terminal.tick';
+export const RISK_TERMINAL_LAST_TICK_REDIS_KEY = 'ticktrade:risk-terminal:last_tick';
+export const RISK_TERMINAL_LAST_TICK_TTL_SEC = 10;
+
+export type RiskTerminalTickPayload =
+    | {
+          battle_id: number;
+          model: 'directive';
+          time_remaining_seconds: number | null;
+          computed_at_ms: number;
+          current_price: number;
+          pots: DirectiveDualScenario['pots'];
+          if_buy_wins: DirectiveDualScenario['if_buy_wins'];
+          if_sell_wins: DirectiveDualScenario['if_sell_wins'];
+          current: DirectiveDualScenario['current'];
+      }
+    | {
+          battle_id: number;
+          model: 'model_a';
+          time_remaining_seconds: number | null;
+          computed_at_ms: number;
+          current_price: number;
+          pots: DualScenarioResult['pots'];
+          if_buy_wins: DualScenarioResult['if_buy_wins'];
+          if_sell_wins: DualScenarioResult['if_sell_wins'];
+          current: null;
+      };
+
+export function parseRiskTerminalTick(raw: string | null | undefined): RiskTerminalTickPayload | null {
+    if (!raw) return null;
+    try {
+        const o = JSON.parse(raw) as Partial<RiskTerminalTickPayload>;
+        if (!o || typeof o !== 'object') return null;
+        if (typeof o.battle_id !== 'number' || (o.model !== 'directive' && o.model !== 'model_a')) return null;
+        if (!o.pots || !o.if_buy_wins || !o.if_sell_wins) return null;
+        return o as RiskTerminalTickPayload;
+    } catch {
+        return null;
+    }
+}
