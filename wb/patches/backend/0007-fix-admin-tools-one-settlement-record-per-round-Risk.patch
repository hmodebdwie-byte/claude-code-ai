+        let min = isEnd ? 59 : 0;
+        let sec = isEnd ? 59 : 0;
+        if (timeStr) {
+            const parts = timeStr.split(':').map(Number);
+            h = parts[0] ?? 0;
+            min = parts[1] ?? 0;
+            sec = parts[2] ?? 0;
+        }
+        return new Date(Date.UTC(y, mo - 1, d, h, min, sec, isEnd ? 999 : 0));
+    }
