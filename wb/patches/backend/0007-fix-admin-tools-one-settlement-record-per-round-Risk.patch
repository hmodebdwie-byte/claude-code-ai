+} from '@ticktrade/shared';
+import { PrismaService } from '../prisma/prisma.service';
+import { RedisPublisher } from '../redis/redis.publisher';
+import { getSharedCommandRedis } from '../redis/redis.client';
+import { resolveLiveBattlePots } from '../common/battle/resolve-live-battle-pots';
+import { TradesService } from '../trades/trades.service';
+import { AdminAuditLogService } from './audit-log/admin-audit-log.service';
+
+const MAX_INJECTION_AMOUNT = 100_000;
+const HOUSE_LIQUIDITY_EMAIL = 'house_liquidity@ticktrade.internal';
+/** An engine tick older than this is ignored and the state is computed here instead. */
+const LAST_TICK_MAX_AGE_MS = 5_000;
+const SETTING_PLATFORM_FEE_RATE_ACTIVE = 'platform_fee_rate_active';
+const DEFAULT_PLATFORM_FEE_RATE = 0.3;
+
+/**
+ * Risk Management Terminal read model. The live state is the engine's own last tick whenever one
+ * is fresh (same numbers the socket shows, same market state, same settlement model); only when
+ * the engine has not published for the active round does this service compute the projection
+ * itself — with the model that will settle the round (directive for the organic engine, legacy
+ * Model A otherwise), never a hand-rolled approximation.
+ */
+@Injectable()
+export class RiskTerminalService {
+    private readonly logger = new Logger(RiskTerminalService.name);
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly redisPublisher: RedisPublisher,
+        private readonly tradesService: TradesService,
+        private readonly auditLog: AdminAuditLogService,
+    ) {}
+
+    private num(value: unknown): number {
+        if (value == null) return 0;
+        const n = Number(value);
+        return Number.isFinite(n) ? n : 0;
+    }
+
+    private roundMoney(value: number): number {
+        return Math.round(value * 100) / 100;
+    }
+
+    private async platformFeeRate(): Promise<number> {
+        const row = await this.prisma.systemSetting.findUnique({ where: { settingKey: SETTING_PLATFORM_FEE_RATE_ACTIVE }, select: { settingValue: true } });
+        const n = Number(row?.settingValue ?? DEFAULT_PLATFORM_FEE_RATE);
+        return Number.isFinite(n) ? Math.min(0.95, Math.max(0, n)) : DEFAULT_PLATFORM_FEE_RATE;
+    }
+
+    async getLiveState() {
+        const activeBattle = await this.prisma.battle.findFirst({
+            where: { status: 'ACTIVE' },
+            orderBy: { id: 'desc' },
+            select: { id: true, startTime: true, durationSeconds: true, buyPot: true, sellPot: true, startPrice: true },
+        });
+        if (!activeBattle) {
+            return { success: true, data: { active_battle: null } };
+        }
+        const elapsedSeconds = Math.floor((Date.now() - activeBattle.startTime.getTime()) / 1000);
+        const timeRemaining = Math.max(0, activeBattle.durationSeconds - elapsedSeconds);
+
+        // 1. The engine's last tick, when it is for this round and fresh.
+        let lastTick: RiskTerminalTickPayload | null = null;
+        try {
+            lastTick = parseRiskTerminalTick(await getSharedCommandRedis().get(RISK_TERMINAL_LAST_TICK_REDIS_KEY));
+        } catch {
+            lastTick = null;
+        }
+        if (lastTick && lastTick.battle_id === activeBattle.id && Date.now() - lastTick.computed_at_ms <= LAST_TICK_MAX_AGE_MS) {
+            return {
+                success: true,
+                data: {
+                    active_battle: {
+                        ...lastTick,
+                        time_remaining_seconds: timeRemaining,
+                        source: 'engine_tick' as const,
+                    },
+                },
+            };
+        }
+
+        // 2. Compute it here with the settling model.
+        const [latestTick, ctx, livePots, feeRate] = await Promise.all([
+            this.prisma.priceTick.findFirst({ where: { battleId: activeBattle.id }, orderBy: [{ createdAt: 'desc' }, { id: 'desc' }], select: { price: true } }),
+            resolveNpcEngineContext(this.prisma as never, activeBattle.id, (key) => this.redisPublisher.get(key)),
+            resolveLiveBattlePots(activeBattle.id, 'ACTIVE', this.num(activeBattle.buyPot), this.num(activeBattle.sellPot), (key) => this.redisPublisher.hgetall(key)),
