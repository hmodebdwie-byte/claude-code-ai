+     * money, and its pricing path treats the injection as a large human order (it moves the
+     * price by the admin formula). The directive model excludes the injection from "real".
+     */
+    async injectLiquidity(battleId: number, side: 'BUY' | 'SELL', amount: number, adminId: number) {
+        const amt = this.roundMoney(Number(amount));
+        if (!Number.isFinite(amt) || amt <= 0) {
+            throw new BadRequestException('amount must be a positive number');
+        }
+        if (amt > MAX_INJECTION_AMOUNT) {
+            throw new BadRequestException(`amount cannot exceed ${MAX_INJECTION_AMOUNT}`);
+        }
+        const battle = await this.prisma.battle.findUnique({ where: { id: battleId }, select: { id: true, status: true } });
+        if (!battle) {
+            throw new NotFoundException(`Battle ${battleId} not found`);
+        }
+        if (battle.status !== 'ACTIVE') {
+            throw new BadRequestException(`Battle ${battleId} is not active (status: ${battle.status})`);
+        }
+        const houseUserId = await this.resolveHouseUserId();
+        const idempotencyKey = `risk-terminal-inject-${battleId}-${side}-${Date.now()}-${Math.round(Math.random() * 1e9)}`;
+        const body = { battle_id: battleId, amount: amt, idempotencyKey };
+        const result = side === 'BUY' ? await this.tradesService.buy(houseUserId, body) : await this.tradesService.sell(houseUserId, body);
+
+        this.logger.warn(`Admin ${adminId} injected ${amt} ${side} liquidity into battle ${battleId} via house account ${houseUserId} through the real trade pipeline.`);
+        await this.auditLog.log({
+            adminId,
+            action: 'battle.liquidityInjected',
+            before: null,
+            after: null,
+            meta: { battleId, side, amount: amt, houseUserId },
+        });
+        return { success: true, battle_id: battleId, side, amount: amt, house_user_id: houseUserId, trade_result: result };
+    }
+}
