+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildDirectiveRoundInput, resolveNpcEngineContext } from './round-context';
+
+function prismaWith(opts: { auditMode?: string | null; settingMode?: string | null }) {
+    return {
+        npcRoundAudit: { findUnique: async () => (opts.auditMode ? { mode: opts.auditMode } : null) },
+        systemSetting: {
+            findMany: async () => (opts.settingMode ? [{ settingKey: 'npc_engine_mode', settingValue: opts.settingMode }] : []),
+        },
+    };
+}
+
+test('engine mode: the round audit row wins, then Redis, then system_settings, then the document default', async () => {
+    const a = await resolveNpcEngineContext(prismaWith({ auditMode: 'legacy', settingMode: 'organic' }), 7, async () => 'organic');
+    assert.equal(a.mode, 'legacy');
+    assert.equal(a.modeSource, 'round_audit');
+    const b = await resolveNpcEngineContext(prismaWith({ settingMode: 'legacy' }), 7, async (key) => (key.endsWith('engine_mode') ? 'organic' : null));
+    assert.equal(b.mode, 'organic');
+    assert.equal(b.modeSource, 'redis');
+    const c = await resolveNpcEngineContext(prismaWith({ settingMode: 'legacy' }), null, null);
+    assert.equal(c.mode, 'legacy');
+    assert.equal(c.modeSource, 'system_settings');
+    const d = await resolveNpcEngineContext(prismaWith({}), null, null);
+    assert.equal(d.modeSource, 'default');
+    assert.ok(d.settings.engine);
+});
+
+test('directive input: RPC house bots excluded from real, range folds stored extremes, ticks and overrides', async () => {
+    const t0 = new Date('2026-01-01T00:00:00Z');
+    const prisma = {
+        stake: {
+            findMany: async () => [
+                { id: 1, userId: 11, side: 'BUY' as const, amount: '100', entryPrice: '1.1', createdAt: t0 },
+                { id: 2, userId: 77, side: 'SELL' as const, amount: '25', entryPrice: '1.1', createdAt: t0 },
+                { id: 3, userId: null, side: 'SELL' as const, amount: '5', entryPrice: '1.1', createdAt: t0 },
+            ],
+        },
+        npcTrade: { findMany: async () => [{ id: 9, npcId: 5, side: 'SELL' as const, amount: '60', executionPrice: null, createdAt: t0 }] },
+        priceTick: { findMany: async () => [{ price: '1.25', createdAt: t0 }, { price: '0.95', createdAt: t0 }] },
+        battle: { findUnique: async () => ({ roundHigh: '1.2', roundLow: '1.0' }) },
+        rpcUser: { findMany: async () => [{ linkedUserId: 77 }] },
+    };
+    const input = await buildDirectiveRoundInput(prisma, {
+        battleId: 42,
+        startPrice: 1.1,
+        finalPrice: 1.15,
+        buyPot: 100,
+        sellPot: 90,
+        platformFeeRate: 0.3,
+        settings: { engine: { houseMaxRealLoserPoolRule: true }, defenses: { ghostTownFallbackMaxSimLossUsd: 250 } } as never,
+        roundHighOverride: 1.3,
+        roundLowOverride: 1.05,
+    });
+    assert.deepEqual(input.realStakes.map((s) => s.userId), [11]);
+    assert.equal(input.npcTrades[0]!.entryPrice, 1.1);
+    assert.equal(input.roundHigh, 1.3);
+    assert.equal(input.roundLow, 0.95);
