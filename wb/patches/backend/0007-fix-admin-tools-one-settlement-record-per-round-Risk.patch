+        if (period === BattleInspectorPeriod.CUSTOM) {
+            let start: Date;
+            let end: Date;
+            if (query.start_at && query.end_at) {
+                start = new Date(query.start_at);
+                end = new Date(query.end_at);
+            } else {
+                start = query.start_date ? this.buildUtcDate(query.start_date, query.start_time, false) : new Date(0);
