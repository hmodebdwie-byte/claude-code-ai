+            { header: 'total_pot', value: (r) => r.total_pot },
+            { header: 'buy_volume', value: (r) => r.buy_volume },
+            { header: 'sell_volume', value: (r) => r.sell_volume },
+            { header: 'net_volume', value: (r) => r.net_volume },
+            { header: 'pip_sensitivity_used', value: (r) => r.pip_sensitivity_used },
+            { header: 'multiplier_used', value: (r) => r.multiplier_used },
+            { header: 'curve_used', value: (r) => r.curve_used },
+            { header: 'reference_amount_used', value: (r) => r.reference_amount_used },
+            { header: 'reference_pips_used', value: (r) => r.reference_pips_used },
+            { header: 'round_override_applied', value: (r) => r.round_override_applied },
+            { header: 'config_source', value: (r) => r.config_source },
+            { header: 'freeze_seconds_used', value: (r) => r.freeze_seconds_used },
+            { header: 'replay_method', value: (r) => r.replay_method },
+            { header: 'pip_sensitivity_changed_mid_round', value: (r) => r.pip_sensitivity_changed_mid_round },
+            { header: 'has_stored_snapshot', value: (r) => r.has_stored_snapshot },
+            { header: 'flag_reason', value: (r) => r.flag_reason ?? '' },
+            { header: 'status', value: (r) => (r.is_flagged ? 'FAIL' : 'PASS') },
+        ];
+        const header = columns.map((c) => PriceMovementAuditService.csvEscape(c.header)).join(',');
+        const lines = rows.map((row) => columns.map((c) => PriceMovementAuditService.csvEscape(c.value(row))).join(','));
+        return { content: [header, ...lines].join('\n'), total: rows.length };
+    }
+
+    /**
+     * Tick-by-tick expected path for one settled round: real trades re-run through the pricing
+     * formula, NPC trades applying the price move that was actually recorded for them (the live
+     * NPC path carries order-book state a replay cannot see). Headline figures come from the
+     * snapshot settlement stored when one exists; the chart replays the same stored config.
+     */
+    async replayBattle(battleId: number) {
+        const battle = await this.prisma.battle.findUnique({
+            where: { id: battleId },
+            select: {
+                id: true,
+                status: true,
+                startPrice: true,
+                endPrice: true,
+                startTime: true,
+                durationSeconds: true,
+                expectedEndPrice: true,
+                priceVariancePct: true,
+                pipImpactConfigUsed: true,
+                pipSensitivityChangedMidRound: true,
+            },
+        });
+        if (!battle) throw new NotFoundException('Battle not found');
+        if (battle.status !== 'COMPLETED') throw new BadRequestException(`Battle ${battleId} is not settled yet (status ${battle.status}).`);
+        const hasStoredSnapshot = battle.expectedEndPrice != null && battle.priceVariancePct != null;
+        const stored = (battle.pipImpactConfigUsed as StoredPipConfig | null) ?? null;
+
+        const [stakes, npcTrades, thresholdPct, priceTicks] = await Promise.all([
+            this.prisma.stake.findMany({
+                where: { battleId },
+                orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],
+                select: { id: true, userId: true, side: true, amount: true, quantity: true, entryPrice: true, createdAt: true },
+            }),
+            this.prisma.npcTrade.findMany({
+                where: { battleId },
+                orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],
+                select: { id: true, side: true, amount: true, quantity: true, executionPrice: true, createdAt: true },
+            }),
+            this.getThresholdPct(),
+            this.prisma.priceTick.findMany({
+                where: { battleId },
+                orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],
+                select: { price: true, createdAt: true, deltaPips: true, source: true, tradeSide: true, tradeAmount: true },
+            }),
+        ]);
+        const actualPricePath = priceTicks.map((t) => ({
+            price: this.num(t.price),
+            timestampMs: t.createdAt.getTime(),
+            source: t.source ?? null,
+            delta_pips: t.deltaPips != null ? this.num(t.deltaPips) : null,
+        }));
+        const actualNpcTicks = priceTicks.filter((t) => t.source === 'npc' && t.deltaPips != null).map((t) => ({ deltaPips: this.num(t.deltaPips) }));
+
+        const trades: ReplayTrade[] = [
+            ...stakes.map((s): ReplayTrade => ({
+                id: `stake-${s.id}`,
+                userId: s.userId,
+                side: s.side as 'BUY' | 'SELL',
+                amount: this.num(s.amount),
+                quantity: this.num(s.quantity),
+                entryPrice: s.entryPrice != null ? this.num(s.entryPrice) : null,
+                createdAt: s.createdAt,
+                isNpc: false,
+            })),
+            ...npcTrades.map((t): ReplayTrade => ({
+                id: `npc-${t.id}`,
+                userId: null,
+                side: t.side as 'BUY' | 'SELL',
+                amount: this.num(t.amount),
+                quantity: this.num(t.quantity),
+                entryPrice: t.executionPrice != null ? this.num(t.executionPrice) : null,
+                createdAt: t.createdAt,
+                isNpc: true,
+            })),
+        ].sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime() || a.id.localeCompare(b.id));
+
+        const startPrice = this.num(battle.startPrice);
+        const actualEndPrice = battle.endPrice != null ? this.num(battle.endPrice) : startPrice;
+
+        // Config and freeze seconds: the snapshot's own when stored, else reconstructed from the
+        // change logs at the round's start (per-round overrides are not reconstructible).
+        let pipImpactConfig: PipImpactConfigValue;
+        let freezeSeconds: number;
+        let configSource: string;
+        if (stored && Number.isFinite(Number(stored.sensitivity))) {
+            pipImpactConfig = { referenceAmount: stored.referenceAmount, referencePips: stored.referencePips, curve: stored.curve, sensitivity: stored.sensitivity, multiplier: stored.multiplier };
+            freezeSeconds = stored.freezeSeconds != null ? stored.freezeSeconds : await resolveHistoricalFreezeSeconds(this.prisma, battle.startTime);
+            configSource = stored.configSource ?? 'round_record';
+        } else {
+            [pipImpactConfig, freezeSeconds] = await Promise.all([resolveHistoricalPipImpactConfig(this.prisma, battle.startTime), resolveHistoricalFreezeSeconds(this.prisma, battle.startTime)]);
+            configSource = 'historical_reconstruction';
+        }
+        const battleEndTime = new Date(battle.startTime.getTime() + battle.durationSeconds * 1000);
+        const configChangedMidBattle = hasStoredSnapshot ? battle.pipSensitivityChangedMidRound : await this.hasSensitivityChangeBetween(battle.startTime, battleEndTime);
+
+        const replay = replayBattlePricing(
+            { battleId: battle.id, startPrice, durationSeconds: battle.durationSeconds, startTime: battle.startTime, trades },
+            pipImpactConfig,
+            freezeSeconds,
+            { actualNpcTicks },
+        );
+        const expectedEndPrice = hasStoredSnapshot ? this.num(battle.expectedEndPrice) : replay.expectedEndPrice;
+        const variancePct = hasStoredSnapshot
+            ? this.roundMoney(this.num(battle.priceVariancePct))
+            : startPrice > 0
+              ? this.roundMoney(((actualEndPrice - expectedEndPrice) / startPrice) * 100)
+              : 0;
+
+        return {
+            success: true,
+            data: {
+                battle_id: battle.id,
+                start_price: startPrice,
+                actual_end_price: actualEndPrice,
+                expected_end_price: Number(expectedEndPrice.toFixed(5)),
+                replayed_end_price: Number(replay.expectedEndPrice.toFixed(5)),
+                variance_pct: variancePct,
+                threshold_pct: thresholdPct,
+                is_flagged: Math.abs(variancePct) >= thresholdPct,
+                config_used: pipImpactConfig,
+                config_source: configSource,
+                round_override_applied: stored?.roundOverrideApplied ?? null,
+                freeze_seconds_used: freezeSeconds,
+                replay_method: replay.method,
+                npc_ticks_matched: replay.npcTicksMatched,
+                npc_ticks_missing: replay.npcTicksMissing,
+                config_changed_mid_battle: configChangedMidBattle,
+                trade_count: trades.length,
+                real_trade_count: stakes.length,
+                npc_trade_count: npcTrades.length,
+                ticks: replay.ticks,
+                actual_price_path: actualPricePath,
+                is_stored_snapshot: hasStoredSnapshot,
+            },
+        };
+    }
+
+    /** True if any Market Sensitivity field changed within the battle's own window. */
+    private async hasSensitivityChangeBetween(start: Date, end: Date): Promise<boolean> {
+        const row = await this.prisma.marketSensitivityChangeLog.findFirst({ where: { createdAt: { gte: start, lte: end } }, select: { id: true } });
+        return row != null;
+    }
+}
