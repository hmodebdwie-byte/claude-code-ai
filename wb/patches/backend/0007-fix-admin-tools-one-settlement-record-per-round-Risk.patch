+            success: true,
+            data: {
+                active_battle: {
+                    battle_id: activeBattle.id,
+                    model: 'model_a' as const,
+                    time_remaining_seconds: timeRemaining,
+                    computed_at_ms: Date.now(),
+                    current_price: currentPrice,
+                    pots: projection.pots,
+                    if_buy_wins: projection.if_buy_wins,
+                    if_sell_wins: projection.if_sell_wins,
+                    current: null,
+                    source: 'api_compute' as const,
+                },
+            },
+        };
+    }
+
+    /** Trading-integrity alerts the detection scanner wrote (unexpired first, newest first). */
+    async listAlerts(query: { limit?: number; include_expired?: boolean }) {
+        const limit = Math.min(200, Math.max(1, Number(query.limit) || 50));
+        const now = new Date();
+        const rows = await this.prisma.riskTerminalAlert.findMany({
+            where: query.include_expired ? {} : { expiresAt: { gt: now } },
+            orderBy: [{ detectedAt: 'desc' }, { id: 'desc' }],
+            take: limit,
+            include: { user: { select: { id: true, name: true, email: true } } },
+        });
+        return {
+            success: true,
+            data: rows.map((r) => ({
+                id: r.id,
+                kind: r.kind,
+                severity: r.severity,
+                confidence: Number(r.confidence),
+                user: { id: r.user.id, name: r.user.name, email: r.user.email },
+                related_battle_id: r.relatedBattleId,
+                related_trade_id: r.relatedTradeId,
+                evidence: r.evidence,
+                detected_at: r.detectedAt.toISOString(),
+                expires_at: r.expiresAt.toISOString(),
+                expired: r.expiresAt <= now,
+            })),
