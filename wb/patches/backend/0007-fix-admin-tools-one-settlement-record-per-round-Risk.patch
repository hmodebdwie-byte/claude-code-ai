+
+/** One forced-winner scenario under the directive model, in the shape the Risk Terminal shows. */
+export interface DirectiveScenarioProjection {
+    model: 'directive';
+    winning_side: NpcSide;
+    /** What the house pays real winners if this side wins: their returned stakes plus profit. */
+    payout_owed: number;
+    /** Real money in − real money out (real losing volume − real winners' profit). Negative = the round costs the house cash. */
+    company_net_position: number;
+    house_cash_result: number;
+    /** The model's own company figure: commission (+ the unpaid pool when there are no real winners). */
+    company_net_model: number;
+    real_losing_volume: number;
+    /** Real winners' profit beyond the net real loser pool (funded by the simulator's losing volume). */
+    shortfall: number;
+    /** Net real loser pool after commission — the money that funds real winners. */
+    distributable_pool: number;
+    platform_fee: number;
+    real_winner_volume: number;
+    /** Real winners' profit as a share of the net real loser pool (0–1); > 1 impossible under the cap. */
+    payout_to_pool_ratio: number;
+    /** Simulator profit after the zero-profit cap, and its net for the round (never positive; it may lose its own seed). */
+    sim_profit: number;
+    simulator_net: number;
+    /** Surplus pushed to real winners when the simulator's share would exceed its own losses. */
+    surplus_to_real: number;
+    /** Seed the simulator would lose to fund real winners with no real losers (Ghost Town off). */
+    simulator_funded_real_winners: number;
+    real_winner_users: number;
+    real_loser_users: number;
+}
+
+export interface DirectiveDualScenario {
+    model: 'directive';
+    pots: {
+        real_buy: number;
+        npc_buy: number;
+        real_sell: number;
+        npc_sell: number;
+        buy_share_pct: number;
+        sell_share_pct: number;
+    };
+    if_buy_wins: DirectiveScenarioProjection;
+    if_sell_wins: DirectiveScenarioProjection;
+    /** Which side would win right now on the actual pots, and why. */
+    current: { winner: NpcSide | 'TIE'; reason: string };
+}
+
+function toDirectiveScenario(side: NpcSide, r: DirectiveSettlementResult): DirectiveScenarioProjection {
+    const ratio = r.netRealLoserPool > 0 ? Math.min(1, r.realWinnersTotal / r.netRealLoserPool) : 0;
+    const houseCash = round2(r.realLosingVolume - r.realWinnersTotal);
+    return {
+        model: 'directive',
+        winning_side: side,
+        payout_owed: round2(r.realWinningVolume + r.realWinnersTotal),
+        company_net_position: houseCash,
+        house_cash_result: houseCash,
+        company_net_model: round2(r.companyNet),
+        real_losing_volume: round2(r.realLosingVolume),
+        shortfall: round2(Math.max(0, r.realWinnersTotal - r.netRealLoserPool)),
+        distributable_pool: round2(r.netRealLoserPool),
+        platform_fee: round2(r.commission),
+        real_winner_volume: round2(r.realWinningVolume),
+        payout_to_pool_ratio: Math.round(ratio * 10000) / 10000,
+        sim_profit: round2(r.simProfit),
+        simulator_net: round2(r.simulatorNet),
+        surplus_to_real: round2(r.surplusToReal),
+        simulator_funded_real_winners: round2(r.simulatorFundedRealWinners),
+        real_winner_users: r.realWinnerUserCount,
+        real_loser_users: r.realLoserUserCount,
+    };
+}
+
+/**
+ * "IF BUY WINS" / "IF SELL WINS" under the directive settlement — the projection the Risk
+ * Management Terminal must show while the organic engine is the settling model. Both scenarios
+ * are the real `computeDirectiveSettlement` with the winner forced, so the terminal can never
+ * disagree with what settlement will do.
+ */
+export function projectDirectiveScenarios(input: DirectiveRoundInput): DirectiveDualScenario {
+    const base: DirectiveRoundInput = { ...input, forceWinnerSide: undefined };
+    const buy = computeDirectiveSettlement({ ...base, forceWinnerSide: 'BUY' });
+    const sell = computeDirectiveSettlement({ ...base, forceWinnerSide: 'SELL' });
+    const current = computeDirectiveSettlement(base);
+    let npcBuy = 0;
+    let npcSell = 0;
+    for (const t of input.npcTrades) {
+        if (t.side === 'BUY') npcBuy += t.amount;
+        else npcSell += t.amount;
+    }
+    const realBuyGross = input.realStakes.reduce((s, x) => s + (x.side === 'BUY' ? x.amount : 0), 0);
+    const realSellGross = input.realStakes.reduce((s, x) => s + (x.side === 'SELL' ? x.amount : 0), 0);
+    const total = realBuyGross + realSellGross + npcBuy + npcSell;
+    const buyShare = total > 0 ? Math.round(((realBuyGross + npcBuy) / total) * 10000) / 100 : 50;
+    return {
+        model: 'directive',
+        pots: {
+            real_buy: round2(realBuyGross),
+            npc_buy: round2(npcBuy),
+            real_sell: round2(realSellGross),
+            npc_sell: round2(npcSell),
+            buy_share_pct: buyShare,
+            sell_share_pct: Math.round((100 - buyShare) * 100) / 100,
+        },
+        if_buy_wins: toDirectiveScenario('BUY', buy),
+        if_sell_wins: toDirectiveScenario('SELL', sell),
+        current: { winner: current.winnerSide, reason: current.winnerReason },
+    };
+}
