+                battleId: activeBattle.id,
+                startPrice: this.num(activeBattle.startPrice),
+                finalPrice: currentPrice,
+                buyPot: livePots.buyPot,
+                sellPot: livePots.sellPot,
+                platformFeeRate: feeRate,
+                settings: ctx.settings,
+                redis: getSharedCommandRedis(),
+            });
+            const projection = projectDirectiveScenarios(input);
+            return {
+                success: true,
+                data: {
+                    active_battle: {
+                        battle_id: activeBattle.id,
+                        model: 'directive' as const,
+                        time_remaining_seconds: timeRemaining,
+                        computed_at_ms: Date.now(),
+                        current_price: currentPrice,
+                        pots: projection.pots,
+                        if_buy_wins: projection.if_buy_wins,
+                        if_sell_wins: projection.if_sell_wins,
+                        current: projection.current,
+                        source: 'api_compute' as const,
+                    },
+                },
+            };
+        }
+
+        const npcSimulatorActive = await readNpcSimulatorActiveFromRedisOrDefault((key) => this.redisPublisher.get(key), true);
+        const projection = await computeDualScenarioProjection(
+            this.prisma,
+            activeBattle.id,
+            currentPrice,
+            humanLiveProjectionOpts(npcSimulatorActive, { redis: getSharedCommandRedis(), livePots }),
