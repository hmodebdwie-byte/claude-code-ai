@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { computeDirectiveSettlement, projectDirectiveScenarios, type DirectiveRoundInput } from './directive-settlement';
+
+const stake = (id: number, userId: number, side: 'BUY' | 'SELL', amount: number) => ({ id, userId, side, amount, entryPrice: 1, entryTimestampMs: 0 });
+const npc = (id: number, side: 'BUY' | 'SELL', amount: number) => ({ id, npcId: 900 + id, side, amount, entryPrice: 1, entryTimestampMs: 0 });
+
+const round: DirectiveRoundInput = {
+    buyPot: 100,
+    sellPot: 560,
+    realStakes: [stake(1, 1, 'BUY', 100), stake(2, 2, 'SELL', 60)],
+    npcTrades: [npc(1, 'SELL', 500)],
+    finalPrice: 1,
+    startPrice: 1,
+    roundHigh: 1,
+    roundLow: 1,
+    pricePoints: [],
+    platformFeeRate: 0.3,
+};
+
+test('forceWinnerSide settles as if that side won, whatever the pots say', () => {
+    const buy = computeDirectiveSettlement({ ...round, forceWinnerSide: 'BUY' });
+    const sell = computeDirectiveSettlement({ ...round, forceWinnerSide: 'SELL' });
+    assert.equal(buy.winnerSide, 'BUY');
+    assert.equal(buy.winnerReason, 'forced_scenario');
+    assert.equal(sell.winnerSide, 'SELL');
+    // The natural winner is SELL (pot dominance).
+    assert.equal(computeDirectiveSettlement(round).winnerSide, 'SELL');
+});
+
+test('scenario projection carries the terminal figures for both sides and the current leader', () => {
+    const p = projectDirectiveScenarios(round);
+    assert.equal(p.model, 'directive');
+    assert.equal(p.pots.real_buy, 100);
+    assert.equal(p.pots.real_sell, 60);
+    assert.equal(p.pots.npc_sell, 500);
+    assert.equal(p.current.winner, 'SELL');
+    for (const s of [p.if_buy_wins, p.if_sell_wins]) {
+        assert.equal(s.model, 'directive');
+        assert.equal(s.house_cash_result, s.company_net_position);
+        assert.equal(s.house_cash_result, Math.round((s.real_losing_volume - (s.payout_owed - s.real_winner_volume)) * 100) / 100);
+        assert.ok(s.shortfall >= 0);
+        // Zero net NPC profit: the simulator never ends a round ahead (it may lose its own seed).
+        assert.ok(s.simulator_net <= 0);
+    }
+    // BUY wins: the only real loser is the $60 SELL; the winner's profit beyond 60×0.7 comes from the simulator.
+    assert.equal(p.if_buy_wins.real_losing_volume, 60);
+    assert.equal(p.if_buy_wins.distributable_pool, 42);
+    assert.ok(p.if_buy_wins.shortfall > 0);
+    assert.ok(p.if_buy_wins.house_cash_result < 60);
+    // SELL wins: real BUY 100 loses; commission 30; real SELL winner is paid from the 70 pool.
+    assert.equal(p.if_sell_wins.real_losing_volume, 100);
+    assert.equal(p.if_sell_wins.platform_fee, 30);
+    assert.equal(p.if_sell_wins.shortfall, 0);
+    // SELL wins with the simulator on the winning side: its profit is capped at its own losses (0).
+    assert.equal(p.if_sell_wins.simulator_net, 0);
+    assert.equal(p.if_sell_wins.sim_profit, 0);
+});
+
+test('forceWinnerSide never leaks into the projection input', () => {
+    const p = projectDirectiveScenarios({ ...round, forceWinnerSide: 'BUY' });
+    assert.equal(p.current.winner, 'SELL');
+});
