+    parseOrganicSettingsDocument,
+    parseRoundValuation,
+    resolveNpcVolumesFromBattlePots,
+    valuationFromModelA,
+    valuationFromTie,
+    type NpcEngineMode,
+    type OrganicNpcSettings,
+    type PayoutContext,
+    type RoundValuation,
+} from '@ticktrade/shared';
+import { PrismaService } from '../prisma/prisma.service';
+
+export type RoundValuationSource = 'stored' | 'recomputed';
+
+export interface RoundValuationRecord {
+    valuation: RoundValuation;
+    source: RoundValuationSource;
+    /** Engine that played the round, when known. */
+    npcMode: string | null;
+}
+
+export type ValuationBattleRow = {
+    id: number;
+    status: string;
+    winnerSide: 'BUY' | 'SELL' | 'TIE' | null;
+    startTime: Date;
+    endTime: Date | null;
+    updatedAt: Date;
+    startPrice: Prisma.Decimal | number;
+    endPrice: Prisma.Decimal | number | null;
+    roundHigh: Prisma.Decimal | number | null;
+    roundLow: Prisma.Decimal | number | null;
+    buyPot: Prisma.Decimal | number | null;
+    sellPot: Prisma.Decimal | number | null;
+};
+
+type StakeLine = {
+    id: number;
+    battleId: number;
+    userId: number | null;
+    amount: unknown;
+    side: 'BUY' | 'SELL';
+    status: string;
+    payout: unknown;
+    entryPrice: unknown;
+    createdAt: Date;
+};
+
+const SETTING_PLATFORM_FEE_RATE_ACTIVE = 'platform_fee_rate_active';
+const DEFAULT_PLATFORM_FEE_RATE = 0.3;
+/** Rounds without a stored valuation are recomputed at most this many per request. */
+export const MAX_RECOMPUTED_ROUNDS_PER_REQUEST = 300;
+
+const num = (v: unknown): number => {
+    const n = Number(v ?? 0);
+    return Number.isFinite(n) ? n : 0;
+};
+
+@Injectable()
+export class RoundValuationReader {
+    constructor(private readonly prisma: PrismaService) {}
+
+    async platformFeeRate(): Promise<number> {
+        const row = await this.prisma.systemSetting.findUnique({
+            where: { settingKey: SETTING_PLATFORM_FEE_RATE_ACTIVE },
+            select: { settingValue: true },
+        });
+        const n = Number(row?.settingValue ?? DEFAULT_PLATFORM_FEE_RATE);
+        return Number.isFinite(n) ? Math.min(0.95, Math.max(0, n)) : DEFAULT_PLATFORM_FEE_RATE;
+    }
+
+    /**
+     * Which NPC engine played (or is playing) a round, and the organic settings in force —
+     * the same resolution order settlement uses: the round's audit row, then Redis, then
+     * `system_settings`.
+     */
+    async npcEngineContext(
+        battleId: number | null,
+        redisGet: (key: string) => Promise<string | null>,
+    ): Promise<{ mode: NpcEngineMode; settings: OrganicNpcSettings; settingsVersion: number }> {
+        let mode: NpcEngineMode | null = null;
+        if (battleId != null) {
+            try {
+                const audit = await this.prisma.npcRoundAudit.findUnique({ where: { battleId }, select: { mode: true } });
+                if (audit?.mode) mode = parseNpcEngineMode(audit.mode);
+            } catch {
+                /* table may be missing on an old database */
+            }
+        }
+        let rawDoc: string | null = null;
+        try {
+            if (!mode) {
+                const rawMode = await redisGet(NPC_ENGINE_MODE_REDIS_KEY);
+                if (rawMode) mode = parseNpcEngineMode(rawMode);
+            }
+            rawDoc = await redisGet(NPC_ORGANIC_SETTINGS_REDIS_KEY);
+        } catch {
+            /* Redis unavailable: use the database */
+        }
+        if (!mode || rawDoc == null) {
+            const rows = await this.prisma.systemSetting.findMany({
+                where: { settingKey: { in: [NPC_ENGINE_MODE_SETTING_KEY, NPC_ORGANIC_SETTINGS_SETTING_KEY] } },
+                select: { settingKey: true, settingValue: true },
+            });
+            for (const r of rows) {
+                if (r.settingKey === NPC_ENGINE_MODE_SETTING_KEY && !mode) mode = parseNpcEngineMode(r.settingValue);
+                if (r.settingKey === NPC_ORGANIC_SETTINGS_SETTING_KEY && rawDoc == null) rawDoc = r.settingValue;
+            }
+        }
+        const doc = parseOrganicSettingsDocument(rawDoc);
+        return { mode: mode ?? parseNpcEngineMode(doc.values.engine.mode), settings: doc.values, settingsVersion: doc.version };
+    }
+
+    /** Stored valuations for the given battles (no recompute). */
+    async loadStored(battleIds: number[]): Promise<Map<number, RoundValuationRecord>> {
+        const out = new Map<number, RoundValuationRecord>();
+        if (battleIds.length === 0) return out;
+        const rows = await this.prisma.npcRoundAudit.findMany({
+            where: { battleId: { in: battleIds } },
+            select: { battleId: true, mode: true, settlement: true },
+        });
+        for (const r of rows) {
+            const v = parseRoundValuation(r.settlement);
+            if (v) out.set(r.battleId, { valuation: v, source: 'stored', npcMode: r.mode });
+        }
+        return out;
+    }
+
+    /**
+     * Valuation for every COMPLETED battle in `battles`: stored where available, recomputed
+     * otherwise (up to `MAX_RECOMPUTED_ROUNDS_PER_REQUEST`, newest first). Returns which rounds
+     * could not be valued because the cap was hit.
+     */
+    async loadForBattles(battles: ValuationBattleRow[]): Promise<{
+        byBattle: Map<number, RoundValuationRecord>;
+        recomputeSkipped: number[];
+    }> {
+        const completed = battles.filter((b) => b.status === 'COMPLETED' && b.winnerSide != null);
+        const byBattle = await this.loadStored(completed.map((b) => b.id));
+        const missing = completed.filter((b) => !byBattle.has(b.id));
+        // Which engine played the rounds we must rebuild (the audit row's mode, when it exists).
+        const modeByBattle = new Map<number, string>();
+        if (missing.length > 0) {
+            const modeRows = await this.prisma.npcRoundAudit.findMany({ where: { battleId: { in: missing.map((b) => b.id) } }, select: { battleId: true, mode: true } });
+            for (const r of modeRows) modeByBattle.set(r.battleId, r.mode);
+        }
+        const toRecompute = missing.slice(0, MAX_RECOMPUTED_ROUNDS_PER_REQUEST);
+        const recomputeSkipped = missing.slice(MAX_RECOMPUTED_ROUNDS_PER_REQUEST).map((b) => b.id);
+        if (toRecompute.length > 0) {
+            const feeRate = await this.platformFeeRate();
+            const lines = await this.loadLines(toRecompute.map((b) => b.id));
+            for (const b of toRecompute) {
+                const npcMode = modeByBattle.get(b.id) ?? null;
+                const v =
+                    npcMode === 'organic'
+                        ? this.recomputeDirective(b, lines.stakes.get(b.id) ?? [], lines.npcWinning.get(b.id) ?? [], lines.ticks.get(b.id) ?? [], lines.rpcUserIds, feeRate)
+                        : this.recompute(b, lines.stakes.get(b.id) ?? [], lines.npcSums.get(b.id) ?? { BUY: 0, SELL: 0 }, lines.ticks.get(b.id) ?? [], lines.npcWinning.get(b.id) ?? [], lines.rpcUserIds, feeRate);
+                if (v) byBattle.set(b.id, { valuation: v, source: 'recomputed', npcMode });
+            }
+        }
+        return { byBattle, recomputeSkipped };
+    }
+
+    async loadForBattle(battle: ValuationBattleRow): Promise<RoundValuationRecord | null> {
+        const { byBattle } = await this.loadForBattles([battle]);
+        return byBattle.get(battle.id) ?? null;
+    }
+
+    private async loadLines(battleIds: number[]): Promise<{
+        stakes: Map<number, StakeLine[]>;
+        npcSums: Map<number, { BUY: number; SELL: number }>;
+        ticks: Map<number, Array<{ price: number; timestampMs: number }>>;
+        npcWinning: Map<number, Array<{ id: number; amount: number; side: 'BUY' | 'SELL'; createdAt: Date; npcId: number; entryPrice: number | null; payout: number }>>;
+        rpcUserIds: Set<number>;
+    }> {
+        const [stakes, npcGroups, ticks, npcTrades, rpcRows] = await Promise.all([
+            this.prisma.stake.findMany({
+                where: { battleId: { in: battleIds } },
+                select: { id: true, battleId: true, userId: true, amount: true, side: true, status: true, payout: true, entryPrice: true, createdAt: true },
+            }),
+            this.prisma.npcTrade.groupBy({ by: ['battleId', 'side'], where: { battleId: { in: battleIds } }, _sum: { amount: true } }),
+            this.prisma.priceTick.findMany({
+                where: { battleId: { in: battleIds } },
+                orderBy: [{ createdAt: 'asc' }, { id: 'asc' }],
+                select: { battleId: true, price: true, createdAt: true },
+            }),
+            this.prisma.npcTrade.findMany({
+                where: { battleId: { in: battleIds } },
+                select: { id: true, battleId: true, npcId: true, amount: true, side: true, createdAt: true, executionPrice: true, payout: true },
+            }),
+            this.prisma.rpcUser.findMany({ select: { linkedUserId: true } }),
+        ]);
+        const stakesBy = new Map<number, StakeLine[]>();
+        for (const s of stakes as StakeLine[]) {
+            const arr = stakesBy.get(s.battleId);
+            if (arr) arr.push(s);
+            else stakesBy.set(s.battleId, [s]);
+        }
+        const npcSums = new Map<number, { BUY: number; SELL: number }>();
+        for (const g of npcGroups) {
+            const cur = npcSums.get(g.battleId) ?? { BUY: 0, SELL: 0 };
+            cur[g.side as 'BUY' | 'SELL'] = num(g._sum.amount);
+            npcSums.set(g.battleId, cur);
+        }
+        const ticksBy = new Map<number, Array<{ price: number; timestampMs: number }>>();
+        for (const t of ticks) {
+            const arr = ticksBy.get(t.battleId) ?? [];
+            arr.push({ price: num(t.price), timestampMs: t.createdAt.getTime() });
+            ticksBy.set(t.battleId, arr);
+        }
+        const npcWinning = new Map<number, Array<{ id: number; amount: number; side: 'BUY' | 'SELL'; createdAt: Date; npcId: number; entryPrice: number | null; payout: number }>>();
+        for (const t of npcTrades) {
+            const arr = npcWinning.get(t.battleId) ?? [];
+            arr.push({ id: t.id, amount: num(t.amount), side: t.side as 'BUY' | 'SELL', createdAt: t.createdAt, npcId: t.npcId, entryPrice: t.executionPrice != null ? num(t.executionPrice) : null, payout: num(t.payout) });
+            npcWinning.set(t.battleId, arr);
+        }
+        return { stakes: stakesBy, npcSums, ticks: ticksBy, npcWinning, rpcUserIds: new Set(rpcRows.map((r) => r.linkedUserId)) };
+    }
+
+    /**
+     * Directive (organic) valuation rebuilt from the rows: the same `computeDirectiveSettlement`
+     * settlement ran, on the round's stakes and NPC trades. Fee rate is the current one.
+     */
+    private recomputeDirective(
+        b: ValuationBattleRow,
+        stakes: StakeLine[],
+        npcTrades: Array<{ id: number; amount: number; side: 'BUY' | 'SELL'; createdAt: Date; npcId: number; entryPrice: number | null }>,
+        pricePoints: Array<{ price: number; timestampMs: number }>,
+        rpcUserIds: Set<number>,
+        platformFeeRate: number,
+    ): RoundValuation | null {
+        if (b.winnerSide == null) return null;
+        const settledAt = (b.endTime ?? b.updatedAt).toISOString();
+        const startPrice = num(b.startPrice);
+        const finalPrice = b.endPrice != null ? num(b.endPrice) : startPrice;
+        let roundHigh = Math.max(b.roundHigh != null ? num(b.roundHigh) : -Infinity, finalPrice, startPrice);
+        let roundLow = Math.min(b.roundLow != null ? num(b.roundLow) : Infinity, finalPrice, startPrice);
+        for (const pt of pricePoints) {
+            if (pt.price > roundHigh) roundHigh = pt.price;
+            if (pt.price < roundLow) roundLow = pt.price;
+        }
+        const human = stakes.filter((s): s is StakeLine & { userId: number } => s.userId != null && !rpcUserIds.has(s.userId));
+        const result = computeDirectiveSettlement({
+            buyPot: num(b.buyPot),
+            sellPot: num(b.sellPot),
+            realStakes: human.map((s) => ({ id: s.id, userId: s.userId, amount: num(s.amount), side: s.side, entryPrice: num(s.entryPrice) || startPrice, entryTimestampMs: s.createdAt.getTime() })),
+            npcTrades: npcTrades.map((t) => ({ id: t.id, npcId: t.npcId, amount: t.amount, side: t.side, entryPrice: t.entryPrice ?? startPrice, entryTimestampMs: t.createdAt.getTime() })),
+            finalPrice,
+            startPrice,
+            roundHigh,
+            roundLow,
+            pricePoints,
+            platformFeeRate,
+            // The stored winner is the truth; force it so a changed pot rule cannot flip the round.
+            forceWinnerSide: b.winnerSide === 'TIE' ? undefined : b.winnerSide,
+        });
+        if (b.winnerSide === 'TIE' || result.winnerSide === 'TIE') {
+            const refunded = stakes.filter((s) => s.status === 'REFUNDED').reduce((sum, s) => sum + num(s.amount), 0);
+            let npcBuy = 0;
+            let npcSell = 0;
+            for (const t of npcTrades) {
+                if (t.side === 'BUY') npcBuy += t.amount;
+                else npcSell += t.amount;
+            }
+            return valuationFromTie({ platformFeeRate, realBuyVolume: 0, realSellVolume: 0, npcBuyVolume: npcBuy, npcSellVolume: npcSell, refundedToRealUsers: refunded, hedgedUserCount: 0, settledAt });
+        }
+        const hedged = new Set<number>();
+        const sides = new Map<number, Set<string>>();
+        for (const s of human) {
+            const set = sides.get(s.userId) ?? new Set<string>();
+            set.add(s.side);
+            sides.set(s.userId, set);
+            if (set.size > 1) hedged.add(s.userId);
+        }
+        const v = valuationFromDirective(result, { hedgedUserCount: hedged.size, settingsVersion: null, settledAt });
+        v.winnerReason = 'recomputed_from_rows';
+        return v;
+    }
+
+    /**
+     * Legacy Model A valuation rebuilt from the rows, the way settlement valued the round: human
+     * stakes net per user (fully hedged users removed, as the legacy engine does), RPC house bots
+     * excluded from "real", NPC volume resolved from the pots. Fee rate is the current one.
+     */
+    private recompute(
+        b: ValuationBattleRow,
+        stakes: StakeLine[],
+        npcSums: { BUY: number; SELL: number },
+        pricePoints: Array<{ price: number; timestampMs: number }>,
+        npcTrades: Array<{ id: number; amount: number; side: 'BUY' | 'SELL'; createdAt: Date; npcId: number; entryPrice: number | null; payout: number }>,
+        rpcUserIds: Set<number>,
+        platformFeeRate: number,
+    ): RoundValuation | null {
+        if (b.winnerSide == null) return null;
+        const settledAt = (b.endTime ?? b.updatedAt).toISOString();
+        const human = stakes.filter((s): s is StakeLine & { userId: number } => s.userId != null && !rpcUserIds.has(s.userId));
+        const realBySide = { BUY: 0, SELL: 0 };
+        for (const s of stakes) realBySide[s.side] += num(s.amount);
+        const resolvedNpc = resolveNpcVolumesFromBattlePots({
+            buyPot: num(b.buyPot),
+            sellPot: num(b.sellPot),
+            realBuyStakeTotal: realBySide.BUY,
+            realSellStakeTotal: realBySide.SELL,
+            npcBuyFromTrades: npcSums.BUY,
+            npcSellFromTrades: npcSums.SELL,
+        });
+        const hedge = computeHedgedUserIdsAndAdjustedPots(human.map((s) => ({ userId: s.userId, side: s.side, amount: s.amount })));
+
+        if (b.winnerSide === 'TIE') {
+            const refunded = stakes.filter((s) => s.status === 'REFUNDED').reduce((sum, s) => sum + num(s.amount), 0);
+            return valuationFromTie({
+                platformFeeRate,
+                realBuyVolume: hedge.realBuyPotAdjusted,
+                realSellVolume: hedge.realSellPotAdjusted,
+                npcBuyVolume: resolvedNpc.npcBuyVolume,
+                npcSellVolume: resolvedNpc.npcSellVolume,
+                refundedToRealUsers: refunded,
+                hedgedUserCount: hedge.hedgedUserIds.size,
+                settledAt,
+            });
+        }
+
+        const winnerSide = b.winnerSide;
+        const finalPrice = b.endPrice != null ? num(b.endPrice) : num(b.startPrice);
+        const startPrice = num(b.startPrice);
+        let roundHigh = b.roundHigh != null ? num(b.roundHigh) : finalPrice;
+        let roundLow = b.roundLow != null ? num(b.roundLow) : finalPrice;
+        for (const pt of pricePoints) {
+            if (pt.price > roundHigh) roundHigh = pt.price;
+            if (pt.price < roundLow) roundLow = pt.price;
+        }
+        roundHigh = Math.max(roundHigh, finalPrice, startPrice);
+        roundLow = Math.min(roundLow, finalPrice, startPrice);
+        const npcWinningVolume = winnerSide === 'BUY' ? resolvedNpc.npcBuyVolume : resolvedNpc.npcSellVolume;
+        const npcLosingVolume = winnerSide === 'BUY' ? resolvedNpc.npcSellVolume : resolvedNpc.npcBuyVolume;
+        const winningStakes = human.filter((s) => s.side === winnerSide && s.status !== 'REFUNDED');
+        const ctx: PayoutContext = {
+            battleId: b.id,
+            winnerSide,
+            finalPrice,
+            startPrice,
+            roundHigh,
+            roundLow,
+            realBuyPot: hedge.realBuyPotAdjusted,
+            realSellPot: hedge.realSellPotAdjusted,
+            buyPot: num(b.buyPot),
+            sellPot: num(b.sellPot),
+            winningStakes: winningStakes.map((s) => ({ id: s.id, userId: s.userId, amount: num(s.amount), side: s.side, entryPrice: num(s.entryPrice) || startPrice, createdAt: s.createdAt })),
+            npcWinningVolume,
+            npcLosingVolume,
+            roundStartTimeMs: b.startTime.getTime(),
+            pricePoints,
+            platformFeeRate,
+            npcWinningTrades: npcTrades.filter((t) => t.side === winnerSide).map((t) => ({ id: t.id, amount: t.amount, side: t.side, createdAt: t.createdAt })),
+        };
+        const payout = computePayouts(ctx);
+        // What was actually credited (stake.payout is the profit part) beats the re-derived split.
+        const paidProfit = human.filter((s) => s.status === 'WON').reduce((sum, s) => sum + num(s.payout), 0);
+        const distributedToRealUsers = paidProfit > 0 ? paidProfit : payout.distributedToRealUsers;
+        const npcWinners = npcTrades.filter((t) => t.side === winnerSide);
+        const npcPayoutRecorded = npcWinners.reduce((sum, t) => sum + t.payout, 0);
+        let distributedToNpcWinners = npcPayoutRecorded;
+        let npcWinnerPoolFee = 0;
+        if (npcPayoutRecorded <= 0 && npcWinners.length > 0 && npcLosingVolume > 0) {
+            const r = computeOneSidedNpcWinnerPayouts({
+                totalLosingPool: npcLosingVolume,
+                winningNpcTrades: npcWinners.map((t) => ({ id: t.id, npcId: t.npcId, amount: t.amount, side: t.side, createdAt: t.createdAt, entryPrice: t.entryPrice ?? startPrice })),
+                finalPrice,
+                roundHigh,
+                roundLow,
+                pricePoints,
+                npcEntryPrice: startPrice,
+                platformFeeRate,
+            });
+            distributedToNpcWinners = r.distributedToNpcs;
+            npcWinnerPoolFee = r.platformFee;
+        }
+        const winnerUsers = new Set(human.filter((s) => s.status === 'WON').map((s) => s.userId));
+        const loserUsers = new Set(human.filter((s) => s.status === 'LOST' && !winnerUsers.has(s.userId)).map((s) => s.userId));
+        return valuationFromModelA({
+            winnerSide,
+            winnerReason: 'recomputed_from_rows',
+            platformFeeRate,
+            realLosingVolume: winnerSide === 'BUY' ? hedge.realSellPotAdjusted : hedge.realBuyPotAdjusted,
+            realWinningVolume: winnerSide === 'BUY' ? hedge.realBuyPotAdjusted : hedge.realSellPotAdjusted,
+            npcLosingVolume,
+            npcWinningVolume,
+            losingPot: payout.losingPot,
+            platformFee: payout.platformFee,
+            netLoserPool: payout.netLoserPool,
+            distributedToRealUsers,
+            npcRetainedRewardShare: Math.max(0, payout.netLoserPool - distributedToRealUsers),
+            dilutionTriggered: payout.dilutionTriggered,
+            injectionAmount: payout.injectionAmount,
+            distributedToNpcWinners,
+            npcWinnerPoolFee,
+            realWinnerUserCount: winnerUsers.size,
+            realLoserUserCount: loserUsers.size,
+            hedgedUserCount: hedge.hedgedUserIds.size,
+            settledAt,
+        });
+    }
+}
