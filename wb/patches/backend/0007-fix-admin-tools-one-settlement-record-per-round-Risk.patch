+    /** CSV of the rows the list endpoint would return for the same filters (status included), without pagination. */
+    async exportFlaggedBattlesCsv(query: ListBattlesInspectorQueryDto): Promise<{ content: string; total: number }> {
+        const { rows } = await this.getFlaggedRows(query);
+        const columns: { header: string; value: (r: (typeof rows)[number]) => unknown }[] = [
+            { header: 'battle_id', value: (r) => r.battle_id },
+            { header: 'start_time', value: (r) => r.start_time },
+            { header: 'end_time', value: (r) => r.end_time },
+            { header: 'start_price', value: (r) => r.start_price },
+            { header: 'end_price', value: (r) => r.end_price },
+            { header: 'expected_end_price', value: (r) => r.expected_end_price },
+            { header: 'price_variance_pct', value: (r) => r.price_variance_pct },
+            { header: 'round_high', value: (r) => r.round_high },
+            { header: 'round_low', value: (r) => r.round_low },
+            { header: 'swing_pct', value: (r) => r.swing_pct },
+            { header: 'net_change_pct', value: (r) => r.net_change_pct },
