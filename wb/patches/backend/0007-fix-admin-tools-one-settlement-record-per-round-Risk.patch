diff --git a/packages/shared/src/npc-organic/round-context.ts b/packages/shared/src/npc-organic/round-context.ts
new file mode 100644
index 0000000..429a396
--- /dev/null
+++ b/packages/shared/src/npc-organic/round-context.ts
@@ -0,0 +1,224 @@
+/**
+ * Round-level helpers shared by the engine (Risk Terminal tick), the API (Risk Terminal REST
+ * fallback, Battle Inspector) and any other reader that must see a round the way settlement will:
+ * which NPC engine plays it, and the directive settlement input built from the database.
+ */
+import type { PricePoint } from '../score/score-calculator.impl';
+import { listBufferedNpcTrades, npcTradeBufferEnabled, type RedisNpcTradeBufferClient } from '../redis/battle-npc-trade-buffer';
+import { listBufferedStakes, redisStakeBufferEnabled, type RedisStakeBufferClient } from '../redis/battle-stake-buffer';
+import { NPC_ENGINE_MODE_REDIS_KEY, NPC_ORGANIC_SETTINGS_REDIS_KEY } from './redis-keys';
+import {
+    NPC_ENGINE_MODE_SETTING_KEY,
+    NPC_ORGANIC_SETTINGS_SETTING_KEY,
+    parseNpcEngineMode,
+    parseOrganicSettingsDocument,
+    type NpcEngineMode,
+    type OrganicNpcSettings,
+} from './settings';
+import type { DirectiveRoundInput } from './directive-settlement';
+
+export type RedisGetter = (key: string) => Promise<string | null | undefined>;
+
+export interface NpcEngineContext {
+    mode: NpcEngineMode;
+    settings: OrganicNpcSettings;
+    settingsVersion: number;
+    /** Where the mode came from: the round's audit row, Redis, system_settings or the document default. */
+    modeSource: 'round_audit' | 'redis' | 'system_settings' | 'default';
+}
+
+export interface NpcEngineContextPrisma {
+    npcRoundAudit: {
+        findUnique(args: { where: { battleId: number }; select: { mode: true } }): Promise<{ mode: string } | null>;
+    };
+    systemSetting: {
+        findMany(args: {
+            where: { settingKey: { in: string[] } };
+            select: { settingKey: true; settingValue: true };
+        }): Promise<Array<{ settingKey: string; settingValue: string }>>;
+    };
+}
+
+/**
+ * Which NPC engine played (or is playing) a round and the organic settings in force — the
+ * resolution order settlement uses: the round's audit row (stamped when the engine opened the
+ * round), then Redis, then `system_settings`, then the settings document default.
+ */
+export async function resolveNpcEngineContext(
+    prisma: NpcEngineContextPrisma,
+    battleId: number | null,
+    redisGet: RedisGetter | null,
+): Promise<NpcEngineContext> {
+    let mode: NpcEngineMode | null = null;
+    let modeSource: NpcEngineContext['modeSource'] = 'default';
+    if (battleId != null) {
+        try {
+            const audit = await prisma.npcRoundAudit.findUnique({ where: { battleId }, select: { mode: true } });
+            if (audit?.mode) {
+                mode = parseNpcEngineMode(audit.mode);
+                modeSource = 'round_audit';
+            }
+        } catch {
+            /* table may be missing on an old database */
+        }
+    }
+    let rawDoc: string | null = null;
+    if (redisGet) {
+        try {
+            if (!mode) {
+                const rawMode = await redisGet(NPC_ENGINE_MODE_REDIS_KEY);
+                if (rawMode) {
+                    mode = parseNpcEngineMode(rawMode);
+                    modeSource = 'redis';
+                }
+            }
+            rawDoc = (await redisGet(NPC_ORGANIC_SETTINGS_REDIS_KEY)) ?? null;
+        } catch {
+            /* Redis unavailable: use the database */
+        }
+    }
+    if (!mode || rawDoc == null) {
+        const rows = await prisma.systemSetting.findMany({
+            where: { settingKey: { in: [NPC_ENGINE_MODE_SETTING_KEY, NPC_ORGANIC_SETTINGS_SETTING_KEY] } },
+            select: { settingKey: true, settingValue: true },
+        });
+        for (const r of rows) {
+            if (r.settingKey === NPC_ENGINE_MODE_SETTING_KEY && !mode) {
+                mode = parseNpcEngineMode(r.settingValue);
+                modeSource = 'system_settings';
+            }
+            if (r.settingKey === NPC_ORGANIC_SETTINGS_SETTING_KEY && rawDoc == null) rawDoc = r.settingValue;
+        }
+    }
+    const doc = parseOrganicSettingsDocument(rawDoc);
+    return { mode: mode ?? parseNpcEngineMode(doc.values.engine.mode), settings: doc.values, settingsVersion: doc.version, modeSource };
+}
+
+export interface DirectiveInputPrisma {
+    stake: {
+        findMany(args: {
+            where: { battleId: number; status: 'ACTIVE' };
+            select: { id: true; userId: true; side: true; amount: true; entryPrice: true; createdAt: true };
+        }): Promise<Array<{ id: number; userId: number | null; side: 'BUY' | 'SELL'; amount: unknown; entryPrice: unknown; createdAt: Date }>>;
+    };
+    npcTrade: {
+        findMany(args: {
+            where: { battleId: number };
+            select: { id: true; npcId: true; side: true; amount: true; executionPrice: true; createdAt: true };
+        }): Promise<Array<{ id: number; npcId: number; side: 'BUY' | 'SELL'; amount: unknown; executionPrice: unknown; createdAt: Date }>>;
+    };
+    priceTick: {
+        findMany(args: {
+            where: { battleId: number };
+            orderBy: Array<{ createdAt: 'asc' } | { id: 'asc' }>;
+            select: { price: true; createdAt: true };
+        }): Promise<Array<{ price: unknown; createdAt: Date }>>;
+    };
+    battle: {
+        findUnique(args: {
+            where: { id: number };
+            select: { roundHigh: true; roundLow: true };
+        }): Promise<{ roundHigh: unknown; roundLow: unknown } | null>;
+    };
+    rpcUser: {
+        findMany(args: { select: { linkedUserId: true } }): Promise<Array<{ linkedUserId: number }>>;
+    };
+}
+
+export interface BuildDirectiveInputParams {
+    battleId: number;
+    startPrice: number;
+    /** Current price for a live round; the end price for a settled one. */
+    finalPrice: number;
+    buyPot: number;
+    sellPot: number;
+    platformFeeRate: number;
+    settings: OrganicNpcSettings;
+    /** Live extremes from the engine's market state; folded in with the stored ones and the ticks. */
+    roundHighOverride?: number;
+    roundLowOverride?: number;
+    /**
+     * Live rounds only: while `LIVE_BATTLE_REDIS_ONLY` buffering is on, stakes and NPC trades sit
+     * in Redis until the round closes, so a projection must read them from there (as the legacy
+     * live context does). Settlement runs after the flush and reads Postgres.
+     */
+    redis?: RedisStakeBufferClient & RedisNpcTradeBufferClient;
+}
+
+const num = (v: unknown): number => {
+    const n = Number(v ?? 0);
+    return Number.isFinite(n) ? n : 0;
+};
+
+/**
+ * The directive model's view of a round from the database: real stakes (RPC house bots
+ * excluded), all NPC trades, the recorded price path and the real range. Same shape settlement
+ * builds inside its transaction, so a projection built from this can never disagree with it.
+ */
+export async function buildDirectiveRoundInput(prisma: DirectiveInputPrisma, p: BuildDirectiveInputParams): Promise<DirectiveRoundInput> {
+    type StakeLike = { id: number; userId: number | null; side: 'BUY' | 'SELL'; amount: unknown; entryPrice: unknown; createdAt: Date };
+    type NpcLike = { id: number; npcId: number; side: 'BUY' | 'SELL'; amount: unknown; executionPrice: unknown; createdAt: Date };
+    const stakesPromise: Promise<StakeLike[]> =
+        p.redis && redisStakeBufferEnabled()
+            ? listBufferedStakes(p.redis, p.battleId).then((rows) =>
+                  rows.map((r) => ({ id: r.tempStakeId, userId: r.userId, side: r.side, amount: r.amount, entryPrice: r.entryPrice, createdAt: new Date(r.createdAtMs) })),
+              )
+            : prisma.stake.findMany({
+                  where: { battleId: p.battleId, status: 'ACTIVE' },
+                  select: { id: true, userId: true, side: true, amount: true, entryPrice: true, createdAt: true },
+              });
+    const npcPromise: Promise<NpcLike[]> =
+        p.redis && npcTradeBufferEnabled()
+            ? listBufferedNpcTrades(p.redis, p.battleId).then((rows) =>
+                  rows.map((r, i) => ({ id: -(i + 1), npcId: r.npcId, side: r.side, amount: r.amount, executionPrice: r.executionPrice, createdAt: new Date(r.createdAtMs) })),
+              )
+            : prisma.npcTrade.findMany({
+                  where: { battleId: p.battleId },
+                  select: { id: true, npcId: true, side: true, amount: true, executionPrice: true, createdAt: true },
+              });
+    const [stakes, npcTrades, ticks, range, rpcRows] = await Promise.all([
+        stakesPromise,
+        npcPromise,
+        prisma.priceTick.findMany({ where: { battleId: p.battleId }, orderBy: [{ createdAt: 'asc' }, { id: 'asc' }], select: { price: true, createdAt: true } }),
+        prisma.battle.findUnique({ where: { id: p.battleId }, select: { roundHigh: true, roundLow: true } }),
+        prisma.rpcUser.findMany({ select: { linkedUserId: true } }),
+    ]);
+    const rpcUserIds = new Set(rpcRows.map((r) => r.linkedUserId));
+    const pricePoints: PricePoint[] = ticks.map((t) => ({ price: num(t.price), timestampMs: t.createdAt.getTime() }));
+    let roundHigh = Math.max(p.finalPrice, p.startPrice, range?.roundHigh != null ? num(range.roundHigh) : -Infinity, p.roundHighOverride ?? -Infinity);
+    let roundLow = Math.min(p.finalPrice, p.startPrice, range?.roundLow != null ? num(range.roundLow) : Infinity, p.roundLowOverride ?? Infinity);
+    for (const pt of pricePoints) {
+        if (pt.price > roundHigh) roundHigh = pt.price;
+        if (pt.price < roundLow) roundLow = pt.price;
+    }
+    return {
+        buyPot: p.buyPot,
+        sellPot: p.sellPot,
+        realStakes: stakes
+            .filter((s) => s.userId != null && !rpcUserIds.has(s.userId))
+            .map((s) => ({
+                id: s.id,
+                userId: s.userId as number,
+                amount: num(s.amount),
+                side: s.side,
+                entryPrice: num(s.entryPrice) || p.startPrice,
+                entryTimestampMs: s.createdAt.getTime(),
+            })),
+        npcTrades: npcTrades.map((t) => ({
+            id: t.id,
+            npcId: t.npcId,
+            amount: num(t.amount),
+            side: t.side,
+            entryPrice: t.executionPrice != null ? num(t.executionPrice) : p.startPrice,
+            entryTimestampMs: t.createdAt.getTime(),
+        })),
+        finalPrice: p.finalPrice,
+        startPrice: p.startPrice,
+        roundHigh,
+        roundLow,
+        pricePoints,
+        platformFeeRate: p.platformFeeRate,
+        houseMaxRealLoserPoolRule: p.settings.engine.houseMaxRealLoserPoolRule,
+        maxSimulatorLossUsd: p.settings.defenses.ghostTownFallbackMaxSimLossUsd,
+    };
+}
