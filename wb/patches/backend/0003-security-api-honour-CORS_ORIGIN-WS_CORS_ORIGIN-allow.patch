 apps/api/src/config/env.validation.ts       | 170 +++++++-------
 apps/api/src/main.ts                        | 244 +++++++++++---------
 runtime-fixtures.cjs                        |  95 ++++++++
 6 files changed, 457 insertions(+), 231 deletions(-)
 create mode 100644 apps/api/src/common/utlis/cors.util.spec.ts
 create mode 100644 runtime-fixtures.cjs

