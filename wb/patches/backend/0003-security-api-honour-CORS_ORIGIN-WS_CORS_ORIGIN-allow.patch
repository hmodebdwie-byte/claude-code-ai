index 8655770..7759bca 100644
--- a/.env.example
+++ b/.env.example
@@ -95,3 +95,11 @@ REDIS_URL=""
 # LOGGING
 # =========================
 LOG_LEVEL=
+
+# --- Browser origins allowed to call the API / WebSocket with credentials.
+# Comma-separated. Exact origins, bare hosts (both schemes) or *.domain wildcards.
+# Empty = reflect any origin (development only; the API warns in production).
+CORS_ORIGIN=
+WS_CORS_ORIGIN=
+# Swagger UI is served at /docs outside production; set true to expose it in production.
+SWAGGER_ENABLED=
diff --git a/apps/api/src/common/utlis/cors.util.spec.ts b/apps/api/src/common/utlis/cors.util.spec.ts
new file mode 100644
index 0000000..a40f06c
--- /dev/null
+++ b/apps/api/src/common/utlis/cors.util.spec.ts
@@ -0,0 +1,38 @@
+import { __cors } from './cors.util';
+
+describe('cors.util origin rules', () => {
+  const rules = __cors.parseRules('https://ticktrade.app, dev.ticktrade.app ,*.ngrok-free.dev,http://localhost:2940/');
+
+  it('parses exact, host and wildcard entries', () => {
+    expect(rules).toEqual([
+      { kind: 'exact', value: 'https://ticktrade.app' },
+      { kind: 'host', value: 'dev.ticktrade.app' },
+      { kind: 'suffix', value: '.ngrok-free.dev' },
+      { kind: 'exact', value: 'http://localhost:2940' },
+    ]);
+  });
+
+  it('matches exact origins only exactly', () => {
+    expect(__cors.matches('https://ticktrade.app', rules)).toBe(true);
+    expect(__cors.matches('http://ticktrade.app', rules)).toBe(false);
+    expect(__cors.matches('https://ticktrade.app.evil.com', rules)).toBe(false);
+  });
+
+  it('matches bare hosts on either scheme and respects ports', () => {
+    expect(__cors.matches('https://dev.ticktrade.app', rules)).toBe(true);
+    expect(__cors.matches('http://dev.ticktrade.app', rules)).toBe(true);
+    expect(__cors.matches('http://localhost:2940', rules)).toBe(true);
+    expect(__cors.matches('http://localhost:5002', rules)).toBe(false);
+  });
+
+  it('matches wildcard subdomains but not the bare apex or look-alikes', () => {
+    expect(__cors.matches('https://abc123.ngrok-free.dev', rules)).toBe(true);
+    expect(__cors.matches('https://ngrok-free.dev', rules)).toBe(false);
+    expect(__cors.matches('https://evilngrok-free.dev', rules)).toBe(false);
+  });
+
+  it('rejects garbage origins', () => {
+    expect(__cors.matches('not a url', rules)).toBe(false);
+    expect(__cors.matches('', rules)).toBe(false);
+  });
+});
diff --git a/apps/api/src/common/utlis/cors.util.ts b/apps/api/src/common/utlis/cors.util.ts
index c5a048b..778a034 100644
--- a/apps/api/src/common/utlis/cors.util.ts
+++ b/apps/api/src/common/utlis/cors.util.ts
@@ -1,32 +1,101 @@
-/**
- * CORS: allow all origins (reflect request `Origin`) with credentials.
- *
- * `allowedHeaders` must include every custom request header any client may
- * send, otherwise the browser preflight (OPTIONS) is rejected. Recent additions:
- *   - `X-Idempotency-Key` — required by the trade flow (see TradeIdempotencyService).
- *   - `X-Request-Id`     — accepted by RequestIdMiddleware (clients may echo back for tracing).
- *   - `Idempotency-Key`  — RFC 8674 alias some HTTP libs default to.
- *
- * `exposedHeaders` lets browser code read response headers via fetch().headers.get(...).
- * We expose `X-Request-Id` so clients/SDKs can correlate logs with server side.
- */
-export const corsOptions = {
-  origin: true,
-  methods: ['GET', 'HEAD', 'PUT', 'PATCH', 'POST', 'DELETE', 'OPTIONS'],
-  allowedHeaders: [
-    'Content-Type',
-    'Authorization',
-    'Accept',
-    'Origin',
-    'X-Requested-With',
-    'X-Idempotency-Key',
-    'Idempotency-Key',
-    'X-Request-Id',
-  ],
-  exposedHeaders: ['X-Request-Id'],
-  credentials: true,
-  maxAge: 86400,
-};
-
-/** Same for WebSocket gateways (allow all). */
-export const wsCorsOptions = { origin: true, credentials: true };
+/**
+ * CORS policy for HTTP and the Socket.IO gateways.
+ *
+ * Allowed origins come from the environment:
+ *   CORS_ORIGIN     comma-separated list for HTTP, e.g.
+ *                   "https://ticktrade.app,https://dev.ticktrade.app,https://*.ticktrade.app"
+ *   WS_CORS_ORIGIN  same format for WebSocket; falls back to CORS_ORIGIN.
+ *
+ * A `*.example.com` entry matches any subdomain (any scheme), an entry without a
+ * scheme matches both http and https on that host, and an exact origin matches
+ * exactly. Requests that carry no Origin header (server-to-server, curl, mobile
+ * SDKs) are never blocked by CORS — the browser is what CORS protects.
+ *
+ * When the variable is EMPTY the previous behaviour is kept — every origin is
+ * reflected — so existing deployments keep working until they set the list.
+ * The API logs which mode is active at boot (see main.ts). Set the list in
+ * production: a money-moving API with credentials:true must not reflect
+ * arbitrary origins.
+ *
+ * `allowedHeaders` must include every custom request header any client may
+ * send, otherwise the browser preflight (OPTIONS) is rejected:
+ *   - `X-Idempotency-Key` — required by the trade flow (see TradeIdempotencyService).
+ *   - `X-Request-Id`     — accepted by RequestIdMiddleware (clients may echo back for tracing).
+ *   - `Idempotency-Key`  — RFC 8674 alias some HTTP libs default to.
+ * `exposedHeaders` lets browser code read response headers via fetch().headers.get(...).
+ */
+
+type OriginCallback = (err: Error | null, allow?: boolean | string) => void;
+type OriginRule = { kind: 'exact' | 'host' | 'suffix'; value: string };
+
+function parseRules(raw: string | undefined): OriginRule[] {
+  return String(raw || '')
+    .split(',')
+    .map((s) => s.trim().toLowerCase().replace(/\/+$/, ''))
+    .filter(Boolean)
+    .map((entry): OriginRule => {
+      if (entry.startsWith('*.')) return { kind: 'suffix', value: entry.slice(1) }; // ".ticktrade.app"
+      if (entry.includes('://')) return { kind: 'exact', value: entry };
+      return { kind: 'host', value: entry }; // "ticktrade.app" → http(s)://ticktrade.app
+    });
+}
+
+function matches(origin: string, rules: OriginRule[]): boolean {
+  const o = origin.toLowerCase().replace(/\/+$/, '');
+  let host = '';
+  try {
+    host = new URL(o).host;
+  } catch {
+    return false;
+  }
+  return rules.some((r) => {
+    if (r.kind === 'exact') return o === r.value;
+    if (r.kind === 'host') return host === r.value;
+    // suffix: "*.ticktrade.app" matches "dev.ticktrade.app" (not the bare apex)
+    return host.endsWith(r.value) && host.length > r.value.length;
+  });
+}
+
+/** Build an `origin` option for cors/socket.io from a rule list; empty list = reflect all. */
+function originOption(rules: OriginRule[]): true | ((origin: string | undefined, cb: OriginCallback) => void) {
+  if (rules.length === 0) return true;
+  return (origin, cb) => {
+    if (!origin) return cb(null, true); // no Origin header: not a browser cross-site request
+    if (matches(origin, rules)) return cb(null, origin);
+    return cb(null, false);
+  };
+}
+
+const httpRules = parseRules(process.env.CORS_ORIGIN);
+const wsRules = parseRules(process.env.WS_CORS_ORIGIN || process.env.CORS_ORIGIN);
+
+/** Human-readable description for the boot log. */
+export const corsMode = {
+  http: httpRules.length ? `allowlist (${httpRules.length} rule${httpRules.length === 1 ? '' : 's'})` : 'reflect any origin (CORS_ORIGIN not set)',
+  ws: wsRules.length ? `allowlist (${wsRules.length} rule${wsRules.length === 1 ? '' : 's'})` : 'reflect any origin (WS_CORS_ORIGIN/CORS_ORIGIN not set)',
+  restricted: httpRules.length > 0,
+};
+
+export const corsOptions = {
+  origin: originOption(httpRules),
+  methods: ['GET', 'HEAD', 'PUT', 'PATCH', 'POST', 'DELETE', 'OPTIONS'],
+  allowedHeaders: [
+    'Content-Type',
+    'Authorization',
+    'Accept',
+    'Origin',
+    'X-Requested-With',
+    'X-Idempotency-Key',
+    'Idempotency-Key',
+    'X-Request-Id',
+  ],
+  exposedHeaders: ['X-Request-Id'],
+  credentials: true,
+  maxAge: 86400,
+};
+
+/** Same policy for the WebSocket gateways. */
+export const wsCorsOptions = { origin: originOption(wsRules), credentials: true };
+
+/** Exported for unit tests. */
+export const __cors = { parseRules, matches };
