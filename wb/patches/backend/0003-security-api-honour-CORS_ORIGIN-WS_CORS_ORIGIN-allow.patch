+import './load-env';
+import { NestFactory } from '@nestjs/core';
+import { SwaggerModule } from '@nestjs/swagger';
+import { Logger, ValidationPipe, VersioningType } from '@nestjs/common';
+import type { NestExpressApplication } from '@nestjs/platform-express';
+import { Logger as PinoLogger } from 'nestjs-pino';
+import { AppModule } from './app.module';
+import { corsOptions, corsMode } from './common/utlis/cors.util';
+import { RedisIoAdapter } from './ws/redis-io.adapter';
+import { buildSwaggerConfig } from './common/swagger/swagger.config';
+
+/**
+ * Express's default JSON body limit is ~100kb — far too small for the Email
+ * Campaigns API, which accepts attachments as base64 directly in the JSON
+ * body (see email-campaign-attachment.constants.ts: up to 15MB of raw
+ * attachment bytes, which base64 inflates by ~33%). 20MB covers that with
+ * headroom for the rest of the JSON payload. Override with BODY_SIZE_LIMIT
+ * (e.g. "25mb") if a future feature needs more.
+ *
+ * Uses app.useBodyParser (not a manual express.json() app.use()) so Nest's
+ * own rawBody-capture verify hook stays wired — the Stripe webhook signature
+ * check reads req.rawBody, which the app boots with rawBody: true for.
+ */
+const BODY_SIZE_LIMIT = process.env.BODY_SIZE_LIMIT?.trim() || '20mb';
+
+async function bootstrap() {
+  const bootstrapLogger = new Logger('Bootstrap');
+  const app = await NestFactory.create<NestExpressApplication>(AppModule, {
+    rawBody: true,
+    bufferLogs: true,
+  });
+
+  app.useBodyParser('json', { limit: BODY_SIZE_LIMIT });
+  app.useBodyParser('urlencoded', { limit: BODY_SIZE_LIMIT, extended: true });
+
+  // Without this, req.ip is the immediate socket peer (the load balancer),
+  // not the real client — breaks IP-based rate limiting and any
+  // unusual-IP/location risk signal. TRUST_PROXY_HOPS controls how many
+  // reverse-proxy hops to trust in front of this process (default: 1, e.g.
+  // a single load balancer). See Express's `trust proxy` setting docs for
+  // the exact semantics of a numeric hop count.
+  const trustProxyHops = Number(process.env.TRUST_PROXY_HOPS ?? '1');
+  app.set('trust proxy', Number.isFinite(trustProxyHops) ? trustProxyHops : 1);
+
+  app.useLogger(app.get(PinoLogger));
+  app.flushLogs();
+
+  app.enableCors(corsOptions);
+
+  app.useGlobalPipes(
+    new ValidationPipe({
+      whitelist: true,
+      forbidNonWhitelisted: true,
+      transform: true,
+      transformOptions: {
+        enableImplicitConversion: true,
+      },
+    }),
+  );
+
+  app.enableVersioning({ type: VersioningType.URI });
+
+  const redisIoAdapter = new RedisIoAdapter(app);
+  const wsDisabled =
+    String(process.env.DISABLE_WS || 'false').toLowerCase() === 'true';
+  if (!wsDisabled) {
+    if (process.env.WS_REDIS_ADAPTER !== 'false') {
+      await redisIoAdapter.connectToRedis();
+      bootstrapLogger.log('WebSocket: Redis adapter enabled');
+    } else {
+      bootstrapLogger.warn(
+        'WebSocket: Redis pub/sub adapter disabled (WS_REDIS_ADAPTER=false); ping/timeouts still active',
+      );
+    }
+    app.useWebSocketAdapter(redisIoAdapter);
+  } else {
+    bootstrapLogger.log('WebSocket disabled (DISABLE_WS=true) — HTTP-only API');
+  }
+
+  // Swagger UI is a development aid. In production it stays off unless
+  // SWAGGER_ENABLED=true is set explicitly (the committed spec under
+  // apps/api/spec/ remains the reference for integrators).
+  const swaggerEnabled =
+    process.env.NODE_ENV !== 'production' ||
+    String(process.env.SWAGGER_ENABLED || 'false').toLowerCase() === 'true';
+  const swaggerPath = process.env.SWAGGER_PATH || 'docs';
+  if (swaggerEnabled) {
+    const config = buildSwaggerConfig();
+    const document = SwaggerModule.createDocument(app, config, {
+      operationIdFactory: (_controllerKey, methodKey) => methodKey,
+    });
+    SwaggerModule.setup(swaggerPath, app, document, {
+      swaggerOptions: {
+        persistAuthorization: true,
+        tagsSorter: 'alpha',
+        operationsSorter: 'alpha',
+      },
+    });
+  }
+
+  if (process.env.DISABLE_HTTP === 'true') {
+    await app.init();
+    bootstrapLogger.log('Running as RPC worker (no HTTP listener)');
+    return;
+  }
+
+  const port = Number(process.env.PORT ?? 3000);
+  await app.listen(port);
+
+  bootstrapLogger.log(`API listening on port ${port}`);
+  if (process.env.REDIS_URL?.trim()) {
+    bootstrapLogger.log('Redis: REDIS_URL configured');
+  } else {
+    bootstrapLogger.warn(
+      'Redis: REDIS_URL missing — RPC scheduler leader + WS adapter need Redis on live',
+    );
+  }
+  bootstrapLogger.log(`CORS: http ${corsMode.http}; ws ${corsMode.ws}`);
+  if (!corsMode.restricted && process.env.NODE_ENV === 'production') {
+    bootstrapLogger.warn(
+      'CORS: reflecting every origin with credentials in production — set CORS_ORIGIN to your web origins',
+    );
+  }
+  bootstrapLogger.log(
+    swaggerEnabled ? `Swagger UI: /${swaggerPath}` : 'Swagger UI: disabled (production; set SWAGGER_ENABLED=true to expose)',
+  );
+}
+
+bootstrap();
