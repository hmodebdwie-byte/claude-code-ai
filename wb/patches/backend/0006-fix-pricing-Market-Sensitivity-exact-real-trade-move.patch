+        const trackChange = (field: string, oldVal: unknown, newVal: unknown) => {
+            if (String(oldVal) !== String(newVal)) {
+                changedFields.push({ field, oldValue: String(oldVal), newValue: String(newVal) });
+            }
+        };
+        trackChange('SENSITIVITY', current.sensitivity, next.sensitivity);
+        trackChange('MULTIPLIER', current.multiplier, next.multiplier);
+        trackChange('REFERENCE_AMOUNT', current.referenceAmount, next.referenceAmount);
+        trackChange('REFERENCE_PIPS', current.referencePips, next.referencePips);
+        trackChange('CURVE', current.curve, next.curve);
+
+        await writePipImpactConfigToRedis((key, value) => this.redisPublisher.set(key, value), next);
+        invalidatePipImpactConfigCache();
+        await this.push({ config: next });
+
+        if (changedFields.length) {
+            await this.prisma.marketSensitivityChangeLog.createMany({
+                data: changedFields.map((c) => ({ adminId, ...c })),
+            });
+            await this.auditLog.log({
+                adminId,
+                action: 'systemSetting.marketSensitivityUpdated',
+                before: current as unknown as Record<string, unknown>,
+                after: next as unknown as Record<string, unknown>,
+            });
+        }
+
+        return { success: true, data: next };
+    }
+
+    async setRoundOverride(input: { enabled: boolean; sensitivity?: number }, adminId: number) {
+        const previous = await readPipImpactRoundOverrideFromRedisOrDefault(this.get);
+
+        if (!input.enabled) {
+            await clearPipImpactRoundOverrideInRedis((key) => this.redisPublisher.del(key));
+            invalidatePipImpactRoundOverrideCache();
+            await this.push({ roundOverride: DEFAULT_PIP_IMPACT_ROUND_OVERRIDE });
+            if (previous.enabled) {
+                await this.prisma.marketSensitivityChangeLog.create({
+                    data: {
+                        adminId,
+                        field: 'PER-ROUND OVERRIDE',
+                        oldValue: `ON (${previous.sensitivity})`,
+                        newValue: 'OFF',
+                    },
+                });
+                await this.auditLog.log({
+                    adminId,
+                    action: 'systemSetting.marketSensitivityRoundOverrideSet',
+                    before: { enabled: previous.enabled, sensitivity: previous.sensitivity },
+                    after: { enabled: false },
+                });
+            }
+            return { success: true, data: DEFAULT_PIP_IMPACT_ROUND_OVERRIDE };
+        }
+
+        const sensitivity = input.sensitivity ?? previous.sensitivity ?? DEFAULT_PIP_IMPACT_ROUND_OVERRIDE.sensitivity;
+        if (!Number.isInteger(sensitivity) || sensitivity < 1 || sensitivity > 10) {
+            throw new BadRequestException('sensitivity must be a whole number between 1 and 10');
+        }
+
+        const next: PipImpactRoundOverrideValue = { enabled: true, sensitivity };
+        await writePipImpactRoundOverrideToRedis(
+            (key, seconds, value) => this.redisPublisher.setex(key, seconds, value),
+            next,
+        );
+        invalidatePipImpactRoundOverrideCache();
+        await this.push({ roundOverride: next });
+
+        if (!previous.enabled || previous.sensitivity !== next.sensitivity) {
+            await this.prisma.marketSensitivityChangeLog.create({
+                data: {
+                    adminId,
+                    field: 'PER-ROUND OVERRIDE',
+                    oldValue: previous.enabled ? `ON (${previous.sensitivity})` : 'OFF',
+                    newValue: `ON (${next.sensitivity})`,
+                },
+            });
+            await this.auditLog.log({
+                adminId,
+                action: 'systemSetting.marketSensitivityRoundOverrideSet',
+                before: { enabled: previous.enabled, sensitivity: previous.sensitivity },
+                after: { enabled: next.enabled, sensitivity: next.sensitivity },
+            });
+        }
+
+        return { success: true, data: next };
+    }
+
+    async getChangeLog(query: ChangeLogQuery = {}) {
+        const page = Math.max(1, Number(query.page) || 1);
+        const limit = Math.min(CHANGE_LOG_PAGE_SIZE_MAX, Math.max(1, Number(query.limit) || CHANGE_LOG_PAGE_SIZE_DEFAULT));
+        const offset = (page - 1) * limit;
+
+        const where: Prisma.MarketSensitivityChangeLogWhereInput = {};
+        const field = String(query.field ?? '').trim().toUpperCase();
+        if (field && field !== 'ALL') {
+            if (field === 'OVERRIDE' || field === 'PER-ROUND OVERRIDE') where.field = { contains: 'OVERRIDE' };
+            else if (field === 'REFERENCE') where.field = { startsWith: 'REFERENCE' };
+            else where.field = { contains: field, mode: 'insensitive' };
+        }
+        const from = query.from ? new Date(query.from) : null;
+        const to = query.to ? new Date(query.to) : null;
+        if ((from && !Number.isNaN(from.getTime())) || (to && !Number.isNaN(to.getTime()))) {
+            where.createdAt = {
+                ...(from && !Number.isNaN(from.getTime()) ? { gte: from } : {}),
+                ...(to && !Number.isNaN(to.getTime()) ? { lte: to } : {}),
+            };
+        }
+        const search = String(query.search ?? '').trim();
+        if (search) {
+            const idMatch = /^#?(?:LOG-)?(\d+)$/i.exec(search);
+            const admins = await this.prisma.user.findMany({
+                where: {
+                    OR: [
+                        { name: { contains: search, mode: 'insensitive' } },
+                        { email: { contains: search, mode: 'insensitive' } },
+                    ],
+                },
+                select: { id: true },
+                take: 200,
+            });
+            where.OR = [
+                ...(idMatch ? [{ id: Number(idMatch[1]) }] : []),
+                { field: { contains: search, mode: 'insensitive' } },
+                { oldValue: { contains: search, mode: 'insensitive' } },
+                { newValue: { contains: search, mode: 'insensitive' } },
+                ...(admins.length ? [{ adminId: { in: admins.map((a) => a.id) } }] : []),
+            ];
+        }
+
+        const [entries, total] = await Promise.all([
+            this.prisma.marketSensitivityChangeLog.findMany({
+                where,
+                orderBy: { createdAt: 'desc' },
+                skip: offset,
+                take: limit,
+            }),
+            this.prisma.marketSensitivityChangeLog.count({ where }),
+        ]);
+
+        const adminIds = [...new Set(entries.map((e) => e.adminId))];
+        const adminRows = adminIds.length
+            ? await this.prisma.user.findMany({
+                  where: { id: { in: adminIds } },
+                  select: { id: true, name: true, email: true },
+              })
+            : [];
+        const adminById = new Map(adminRows.map((a) => [a.id, a]));
+
+        return {
+            success: true,
+            data: entries.map((e) => {
+                const admin = adminById.get(e.adminId);
+                return {
+                    id: e.id,
+                    changedBy: admin?.name || `Admin #${e.adminId}`,
+                    changedByEmail: admin?.email || '',
+                    timestamp: e.createdAt.toISOString(),
+                    field: e.field,
+                    oldValue: e.oldValue,
+                    newValue: e.newValue,
+                    status: 'Applied',
+                };
+            }),
+            pagination: { page, limit, total, totalPages: Math.max(1, Math.ceil(total / limit)) },
+        };
+    }
+
+    private num(value: unknown): number {
+        if (value == null) return 0;
+        const n = Number(value);
+        return Number.isFinite(n) ? n : 0;
+    }
+
+    /** Current price of the active battle from the engine's market state in Redis. */
+    private async readActiveBattlePrice(): Promise<{ price: number; source: 'live' | 'round_start' } | null> {
+        const active = await this.prisma.battle.findFirst({
+            where: { status: 'ACTIVE' },
+            orderBy: { id: 'desc' },
+            select: { id: true, startPrice: true },
+        });
+        if (!active) return null;
+        const raw = await this.redisPublisher.get(marketStateRedisKey(active.id)).catch(() => null);
+        const live = parseLastPriceFromMarketStateJson(raw);
+        if (live != null && Number.isFinite(live) && live > 0) return { price: live, source: 'live' };
+        const start = this.num(active.startPrice);
+        return start > 0 ? { price: start, source: 'round_start' } : null;
+    }
+
+    /**
+     * Live, trade-by-trade price-impact breakdown for the active battle (or a given one).
+     *
+     * Rows come from `price_ticks` rows written for every priced trade (engine event
+     * `trade.priced.v1`, never coalesced). The round total is measured on the price itself
+     * (current price − round start price) so it is exact regardless of how many rows exist;
+     * the real / NPC split comes from the rows' own realised pips, and whatever is left
+     * (quote rounding on individual ticks, ticks from before this feature) is reported as
+     * `other`, never silently attributed to either side.
+     */
+    async getLiveTradeLog(battleId?: number) {
+        let resolvedBattleId = battleId;
+        if (resolvedBattleId == null) {
+            const activeBattle = await this.prisma.battle.findFirst({
+                where: { status: 'ACTIVE' },
+                orderBy: { id: 'desc' },
+                select: { id: true },
+            });
+            resolvedBattleId = activeBattle?.id;
+        }
+        const empty = {
+            battle_id: null as number | null,
+            status: null as string | null,
+            start_price: null as number | null,
+            current_price: null as number | null,
+            rows: [] as Array<Record<string, unknown>>,
+            row_count: 0,
+            real_trade_count: 0,
+            npc_trade_count: 0,
+            total_delta_pips: 0,
+            real_delta_pips_sum: 0,
+            npc_delta_pips_sum: 0,
+            other_delta_pips: 0,
+            sensitivity_used: null as number | null,
+            override_active: false,
+            config: null as PipImpactConfigValue | null,
+        };
+        if (resolvedBattleId == null) {
+            return { success: true as const, data: empty };
+        }
+
+        const battle = await this.prisma.battle.findUnique({
+            where: { id: resolvedBattleId },
+            select: { id: true, status: true, startPrice: true, endPrice: true },
+        });
+        if (!battle) {
+            return { success: true as const, data: empty };
+        }
+
+        const attributed = { battleId: battle.id, deltaPips: { not: null } } as const;
+        const [ticks, groups, latestTick, config, override] = await Promise.all([
+            this.prisma.priceTick.findMany({
+                where: attributed,
+                orderBy: { id: 'desc' },
+                take: LIVE_LOG_ROWS,
+                select: { createdAt: true, price: true, deltaPips: true, tradeAmount: true, tradeSide: true, source: true },
+            }),
+            this.prisma.priceTick.groupBy({
+                by: ['source'],
+                where: attributed,
+                _sum: { deltaPips: true },
+                _count: { _all: true },
+            }),
+            this.prisma.priceTick.findFirst({
+                where: { battleId: battle.id },
+                orderBy: { id: 'desc' },
+                select: { price: true },
+            }),
+            readPipImpactConfigFromRedisOrDefault(this.get),
+            readPipImpactRoundOverrideFromRedisOrDefault(this.get),
+        ]);
+        const sensitivityUsed = override.enabled ? override.sensitivity : config.sensitivity;
+
+        const startPrice = this.num(battle.startPrice);
+        let currentPrice: number | null = null;
+        if (battle.status === 'ACTIVE') {
+            const raw = await this.redisPublisher.get(marketStateRedisKey(battle.id)).catch(() => null);
+            const live = parseLastPriceFromMarketStateJson(raw);
+            if (live != null && Number.isFinite(live) && live > 0) currentPrice = live;
+        } else if (battle.endPrice != null) {
+            currentPrice = this.num(battle.endPrice);
+        }
+        if (currentPrice == null) {
+            currentPrice = latestTick ? this.num(latestTick.price) : startPrice;
+        }
+
+        let realSum = 0;
+        let npcSum = 0;
+        let realCount = 0;
+        let npcCount = 0;
+        for (const g of groups) {
+            const sum = this.num(g._sum.deltaPips);
+            const count = g._count._all;
+            if (g.source === 'npc') {
+                npcSum += sum;
+                npcCount += count;
+            } else {
+                realSum += sum;
+                realCount += count;
+            }
+        }
+        const total = startPrice > 0 ? (currentPrice - startPrice) / PRICE_PIP_SIZE : realSum + npcSum;
+
+        const rows = ticks.map((t) => {
+            const amount = t.tradeAmount != null ? this.num(t.tradeAmount) : null;
+            const isReal = t.source !== 'npc';
+            const side = t.tradeSide === 'SELL' ? 'SELL' : t.tradeSide === 'BUY' ? 'BUY' : null;
+            const formula =
+                isReal && amount != null && side
+                    ? r4((side === 'BUY' ? 1 : -1) * computeDeterministicPips(amount, config, sensitivityUsed))
+                    : null;
+            return {
+                time: t.createdAt.toISOString(),
+                side,
+                amount,
+                source: t.source,
+                /** Real trades: what the admin formula says for this amount with the settings in force now. */
+                formula_pips: formula,
+                /** What the tick actually moved the 5-decimal quote (flat 0.0001 pips). */
+                delta_pips: t.deltaPips != null ? this.num(t.deltaPips) : null,
+                price_after: this.num(t.price),
+            };
+        });
+
+        return {
+            success: true as const,
+            data: {
+                battle_id: battle.id,
+                status: battle.status,
+                start_price: startPrice,
+                current_price: currentPrice,
+                rows,
+                row_count: realCount + npcCount,
+                real_trade_count: realCount,
+                npc_trade_count: npcCount,
+                total_delta_pips: r4(total),
+                real_delta_pips_sum: r4(realSum),
+                npc_delta_pips_sum: r4(npcSum),
+                other_delta_pips: r4(total - realSum - npcSum),
+                sensitivity_used: sensitivityUsed,
+                override_active: override.enabled,
+                config,
+            },
+        };
+    }
+
+    private async push(payload: { config?: PipImpactConfigValue; roundOverride?: PipImpactRoundOverrideValue }): Promise<void> {
+        try {
+            await this.redisPublisher.publish(PIP_IMPACT_CONFIG_CHANNEL, { ...payload, timestamp: Date.now() });
+        } catch {
+            // Durable write already landed; the engine's poller picks it up within 5 s.
+        }
+    }
+}
