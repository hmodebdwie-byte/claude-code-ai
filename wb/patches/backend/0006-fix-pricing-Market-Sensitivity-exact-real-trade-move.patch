     }
 }
 
+export function parsePipImpactConfigPush(raw: string | null | undefined): PipImpactConfigPushV1 | null {
+    if (!raw) return null;
+    try {
+        const parsed = JSON.parse(raw) as { config?: unknown; roundOverride?: unknown; timestamp?: unknown };
+        const out: PipImpactConfigPushV1 = { timestamp: Number(parsed.timestamp) || Date.now() };
+        if (parsed.config != null && typeof parsed.config === 'object') {
+            out.config = parseConfig(JSON.stringify(parsed.config));
+        }
+        if (parsed.roundOverride != null && typeof parsed.roundOverride === 'object') {
+            out.roundOverride = parseRoundOverride(JSON.stringify(parsed.roundOverride));
+        }
+        return out;
+    } catch {
+        return null;
+    }
+}
+
+export function parsePipImpactConfigUsed(raw: string | null | undefined): PipImpactConfigUsedValue | null {
+    if (!raw) return null;
+    try {
+        const parsed = JSON.parse(raw) as Record<string, unknown>;
+        const base = parseConfig(raw);
+        return {
+            ...base,
+            roundOverrideApplied: parsed.roundOverrideApplied === true,
+            recordedAt: Number(parsed.recordedAt) || 0,
+        };
+    } catch {
+        return null;
+    }
+}
