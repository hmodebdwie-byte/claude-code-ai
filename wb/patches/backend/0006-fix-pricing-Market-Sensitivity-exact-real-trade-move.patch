diff --git a/packages/shared/src/battle/price-impact-deterministic.spec.ts b/packages/shared/src/battle/price-impact-deterministic.spec.ts
new file mode 100644
index 0000000..0886802
--- /dev/null
+++ b/packages/shared/src/battle/price-impact-deterministic.spec.ts
@@ -0,0 +1,98 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    computePriceFromImbalance,
+    computeDeterministicPips,
+    previewDeterministicPriceImpact,
+    PRICE_PIP_SIZE,
+    PRICE_QUOTE_TICK,
+    type PipImpactConfig,
+} from './price-from-imbalance';
+import { replayBattlePricing } from './price-audit-replay';
+
+/** The developer's own test case: $100k, linear, $1M → 10 pips, sensitivity 8, multiplier 10. */
+const DEV_CONFIG: PipImpactConfig & { sensitivity: number; multiplier: number } = { referenceAmount: 1_000_000, referencePips: 10, curve: 'linear', sensitivity: 8, multiplier: 10 };
+
+function realTrade(amount: number, side: 'BUY' | 'SELL', lastPrice: number, config = DEV_CONFIG, extra: Record<string, unknown> = {}) {
+    return computePriceFromImbalance({
+        lastPrice,
+        buyPot: side === 'BUY' ? 500_000 + amount : 500_000,
+        sellPot: side === 'SELL' ? 500_000 + amount : 500_000,
+        startPrice: lastPrice,
+        pressureSmoothedPrev: 0.4,
+        elapsedFraction: 0.5,
+        isFinalize: false,
+        tradeAmount: amount,
+        mandatoryTradeSide: side,
+        isNpcOrder: false,
+        pipImpactConfig: config,
+        sensitivity: config.sensitivity,
+        ...extra,
+    });
+}
+
+test('formula: $100k linear with sensitivity 8 and multiplier 10 is exactly 16.0 pips', () => {
+    assert.equal(computeDeterministicPips(100_000, DEV_CONFIG), 16);
+    const r = realTrade(100_000, 'SELL', 1.42938);
+    assert.equal(r.price, 1.42778);
+    assert.equal(Math.round((r.price - 1.42938) / PRICE_PIP_SIZE * 10000) / 10000, -16);
+});
+
+test('the same trade moves the same number of pips at any price level (no price scaling)', () => {
+    for (const p of [0.9, 1.0, 1.25, 1.42938, 1.72, 4.5]) {
+        const r = realTrade(100_000, 'BUY', p);
+        assert.equal(Math.round((r.price - p) / PRICE_PIP_SIZE * 10000) / 10000, 16, `at ${p}`);
+    }
+});
+
+test('round state (pots, pressure, elapsed, finalize) has no effect on a real trade', () => {
+    const base = realTrade(50_000, 'BUY', 1.25);
+    const skewed = realTrade(50_000, 'BUY', 1.25, DEV_CONFIG, { buyPot: 10, sellPot: 900_000, pressureSmoothedPrev: -0.9, elapsedFraction: 0.99, isFinalize: true });
+    assert.equal(skewed.price, base.price);
+    assert.equal(skewed.pressureSmoothed, -0.9, 'pressure passes through untouched');
+});
+
+test('a trade below one quote tick still registers exactly one tick (0.1 pip) in its own direction', () => {
+    // $10 × linear → 0.016 pips: rounds to zero on a 5-decimal quote.
+    const p = previewDeterministicPriceImpact({ tradeAmount: 10, side: 'SELL', lastPrice: 1.25416, config: DEV_CONFIG });
+    assert.ok(p.formulaPips < 0.1);
+    assert.equal(p.flooredToQuoteTick, true);
+    assert.equal(p.executedPips, -0.1);
+    assert.equal(p.priceAfter, Number((1.25416 - PRICE_QUOTE_TICK).toFixed(5)));
+    const r = realTrade(10, 'SELL', 1.25416);
+    assert.equal(r.price, p.priceAfter);
+    // Independent of the book skew that used to drive the hidden nudge.
+    const r2 = realTrade(10, 'SELL', 1.25416, DEV_CONFIG, { buyPot: 1_000, sellPot: 900_000 });
+    assert.equal(r2.price, p.priceAfter);
+});
+
+test('a zero-amount trade moves nothing', () => {
+    const p = previewDeterministicPriceImpact({ tradeAmount: 0, side: 'BUY', lastPrice: 1.25, config: DEV_CONFIG });
+    assert.equal(p.executedPips, 0);
+    assert.equal(p.flooredToQuoteTick, false);
+});
+
+test('sensitivity factor is sensitivity ÷ 5 and the per-round value overrides the config', () => {
+    assert.equal(computeDeterministicPips(100_000, DEV_CONFIG, 4), 8);
+    assert.equal(computeDeterministicPips(100_000, { ...DEV_CONFIG, sensitivity: 5 }), 10);
+    assert.equal(computeDeterministicPips(100_000, { ...DEV_CONFIG, sensitivity: 5, multiplier: 1 }), 1);
+});
+
+test('curves: sqrt and log agree with the documented formulas', () => {
+    const sqrtCfg = { ...DEV_CONFIG, curve: 'sqrt' as const, sensitivity: 5, multiplier: 1 };
+    assert.ok(Math.abs(computeDeterministicPips(250_000, sqrtCfg) - 10 * Math.sqrt(0.25)) < 1e-9);
+    const logCfg = { ...DEV_CONFIG, curve: 'log' as const, sensitivity: 5, multiplier: 1 };
+    assert.ok(Math.abs(computeDeterministicPips(100_000, logCfg) - 10 * (Math.log10(1 + 100_000) / Math.log10(1 + 1_000_000))) < 1e-9);
+});
+
+test('replay of real trades reproduces the deterministic move exactly (no post-clamp nudge)', () => {
+    const start = new Date('2026-01-01T00:00:00Z');
+    const trades = [
+        { id: 'a', userId: 1, side: 'SELL' as const, amount: 20_000, quantity: 1, entryPrice: null, createdAt: new Date(start.getTime() + 1000), isNpc: false },
+        { id: 'b', userId: 1, side: 'SELL' as const, amount: 10, quantity: 1, entryPrice: null, createdAt: new Date(start.getTime() + 2000), isNpc: false },
+        { id: 'c', userId: 1, side: 'BUY' as const, amount: 100_000, quantity: 1, entryPrice: null, createdAt: new Date(start.getTime() + 3000), isNpc: false },
+    ];
+    const r = replayBattlePricing({ battleId: 1, startPrice: 1.25544, durationSeconds: 300, startTime: start, trades }, DEV_CONFIG, 10);
+    assert.deepEqual(r.ticks.map((t) => t.deltaPips), [-3.2, -0.1, 16]);
+    assert.equal(r.expectedEndPrice, Number((1.25544 - 0.00032 - 0.00001 + 0.0016).toFixed(5)));
+});
