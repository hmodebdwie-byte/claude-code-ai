+import { BadRequestException, Injectable } from '@nestjs/common';
+import { Prisma } from '@prisma/client';
+import {
+    DEFAULT_PIP_IMPACT_CONFIG,
+    DEFAULT_PIP_IMPACT_ROUND_OVERRIDE,
+    PIP_IMPACT_CONFIG_CHANNEL,
+    PRICE_PIP_SIZE,
+    PRICE_QUOTE_TICK,
+    PRICE_SENSITIVITY_DEFAULT,
+    computeDeterministicPips,
+    previewDeterministicPriceImpact,
+    invalidatePipImpactConfigCache,
+    invalidatePipImpactRoundOverrideCache,
+    readPipImpactConfigFromRedisOrDefault,
+    readPipImpactRoundOverrideFromRedisOrDefault,
+    writePipImpactConfigToRedis,
+    writePipImpactRoundOverrideToRedis,
+    clearPipImpactRoundOverrideInRedis,
+    type PipImpactConfigValue,
+    type PipImpactRoundOverrideValue,
+} from '@ticktrade/shared';
+import { RedisPublisher } from '../redis/redis.publisher';
+import { PrismaService } from '../prisma/prisma.service';
+import { AdminAuditLogService } from './audit-log/admin-audit-log.service';
+import { marketStateRedisKey, parseLastPriceFromMarketStateJson } from '../redis/market-state.util';
+
+const CHANGE_LOG_PAGE_SIZE_DEFAULT = 20;
+const CHANGE_LOG_PAGE_SIZE_MAX = 100;
+const LIVE_LOG_ROWS = 50;
+
+export interface ChangeLogQuery {
+    page?: number;
+    limit?: number;
+    /** Free text: log id (#LOG-12 / 12), admin name or e-mail, field, old/new value. */
+    search?: string;
+    /** SENSITIVITY | MULTIPLIER | OVERRIDE | CURVE | REFERENCE | All */
+    field?: string;
+    /** ISO date/time lower bound (inclusive). */
+    from?: string;
+    /** ISO date/time upper bound (inclusive). */
+    to?: string;
+}
+
+function r4(n: number): number {
+    return Math.round(n * 10000) / 10000;
+}
+
+/**
+ * Admin-facing read/write for Market Sensitivity (PipImpactConfig) — the
+ * live price-impact-per-trade-size curve used by the trading engine.
+ * Redis is the durable store and the only channel this API process shares
+ * with the separate engine process; every save is also pushed on
+ * {@link PIP_IMPACT_CONFIG_CHANNEL} so the engine applies it immediately
+ * (its pollers remain the fallback).
+ */
+@Injectable()
+export class MarketSensitivityService {
+    constructor(
+        private readonly redisPublisher: RedisPublisher,
+        private readonly prisma: PrismaService,
+        private readonly auditLog: AdminAuditLogService,
+    ) {}
+
+    private readonly get = (key: string) => this.redisPublisher.get(key);
+
+    async getConfig() {
+        const data = await readPipImpactConfigFromRedisOrDefault(this.get);
+        return {
+            success: true as const,
+            data: {
+                ...data,
+                /** The sensitivity at which the factor is exactly 1 (factor = sensitivity / this). */
+                defaultSensitivity: PRICE_SENSITIVITY_DEFAULT,
+                pipSize: PRICE_PIP_SIZE,
+                quoteTick: PRICE_QUOTE_TICK,
+            },
+        };
+    }
+
+    async getRoundOverride(): Promise<{ success: true; data: PipImpactRoundOverrideValue }> {
+        const data = await readPipImpactRoundOverrideFromRedisOrDefault(this.get);
+        return { success: true, data };
+    }
+
+    /**
+     * Exactly what a real-user trade of `amount` would do right now: the engine's own
+     * deterministic function, with the saved config, the effective sensitivity (per-round
+     * override when active) and the live price. Byte-for-byte the engine's execution path.
+     */
+    async preview(query: { amount?: string; side?: string; price?: string }) {
+        const amount = Number(query.amount);
+        if (!Number.isFinite(amount) || amount < 0) {
+            throw new BadRequestException('amount must be a non-negative number');
+        }
+        const side: 'BUY' | 'SELL' = String(query.side ?? 'BUY').toUpperCase() === 'SELL' ? 'SELL' : 'BUY';
+        const [config, override] = await Promise.all([
+            readPipImpactConfigFromRedisOrDefault(this.get),
+            readPipImpactRoundOverrideFromRedisOrDefault(this.get),
+        ]);
+        const sensitivity = override.enabled ? override.sensitivity : config.sensitivity;
+
+        let lastPrice = Number(query.price);
+        let priceSource: 'request' | 'live' | 'round_start' | 'default' = 'request';
+        if (!Number.isFinite(lastPrice) || lastPrice <= 0) {
+            const live = await this.readActiveBattlePrice();
+            if (live) {
+                lastPrice = live.price;
+                priceSource = live.source;
+            } else {
+                lastPrice = 1.25;
+                priceSource = 'default';
+            }
+        }
+
+        const p = previewDeterministicPriceImpact({ tradeAmount: amount, side, lastPrice, config, sensitivity });
+        return {
+            success: true as const,
+            data: {
+                amount,
+                side,
+                formula_pips: r4(p.formulaPips),
+                executed_pips: p.executedPips,
+                price_before: p.priceBefore,
+                price_after: p.priceAfter,
+                floored_to_quote_tick: p.flooredToQuoteTick,
+                price_source: priceSource,
+                sensitivity_used: sensitivity,
+                override_active: override.enabled,
+                config,
+                default_sensitivity: PRICE_SENSITIVITY_DEFAULT,
+                pip_size: PRICE_PIP_SIZE,
+                quote_tick: PRICE_QUOTE_TICK,
+            },
+        };
+    }
+
+    async updateConfig(
+        input: {
+            referenceAmount?: number;
+            referencePips?: number;
+            curve?: 'linear' | 'sqrt' | 'log';
+            sensitivity?: number;
+            multiplier?: number;
+        },
+        adminId: number,
+    ) {
+        const current = await readPipImpactConfigFromRedisOrDefault(this.get);
+        const next: PipImpactConfigValue = {
+            referenceAmount: input.referenceAmount ?? current.referenceAmount,
+            referencePips: input.referencePips ?? current.referencePips,
+            curve: input.curve ?? current.curve ?? DEFAULT_PIP_IMPACT_CONFIG.curve,
+            sensitivity: input.sensitivity ?? current.sensitivity ?? DEFAULT_PIP_IMPACT_CONFIG.sensitivity,
+            multiplier: input.multiplier ?? current.multiplier ?? DEFAULT_PIP_IMPACT_CONFIG.multiplier,
+        };
