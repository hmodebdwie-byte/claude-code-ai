+        if (!Number.isFinite(next.referenceAmount) || next.referenceAmount <= 0) {
+            throw new BadRequestException('referenceAmount must be a positive number');
+        }
+        if (!Number.isFinite(next.referencePips) || next.referencePips < 0) {
+            throw new BadRequestException('referencePips must be a non-negative number');
+        }
+        if (!Number.isInteger(next.sensitivity) || next.sensitivity < 1 || next.sensitivity > 10) {
+            throw new BadRequestException('sensitivity must be a whole number between 1 and 10');
+        }
+        if (!Number.isFinite(next.multiplier) || next.multiplier <= 0) {
+            throw new BadRequestException('multiplier must be a positive number');
+        }
