+ * in another process that never loads the live config — for the Price Movement Audit snapshot.
+ */
+export interface PipImpactConfigUsedValue extends PipImpactConfigValue {
+    roundOverrideApplied: boolean;
+    recordedAt: number;
+}
+export function pipImpactUsedKey(battleId: number): string {
+    return `ticktrade:market:pip_impact_used:${battleId}`;
+}
+export const PIP_IMPACT_USED_TTL_SECONDS = 6 * 60 * 60;
