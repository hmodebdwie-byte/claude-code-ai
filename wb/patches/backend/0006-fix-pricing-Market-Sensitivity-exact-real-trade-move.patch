@@ -0,0 +1,27 @@
+/**
+ * Event: one executed trade has been priced by the engine (engine → API).
+ *
+ * Published for EVERY priced trade, real and NPC, independently of the coalesced
+ * `engine:events:price.tick` fan-out — so the admin Live Trade Log and the price-tick
+ * audit table never miss a trade that landed inside the coalescing window.
+ */
+export const TRADE_PRICED_CHANNEL = 'engine:events:trade.priced.v1';
+
+export interface TradePricedV1 {
+    eventId: string;
+    battleId: number;
+    /** 0 for NPC trades. */
+    userId: number;
+    source: 'real' | 'npc';
+    side: 'BUY' | 'SELL';
+    amount: number;
+    priceBefore: number;
+    priceAfter: number;
+    /** Realised move on the 5-decimal quote, in flat 0.0001 pips (signed). */
+    deltaPips: number;
+    /** Real trades only: the admin formula's unrounded pips (signed); null for NPC trades. */
+    formulaPips: number | null;
+    /** Real trades only: true when the formula move was below one quote tick and the 0.1-pip floor applied. */
+    flooredToQuoteTick: boolean;
+    timestamp: number;
+}
