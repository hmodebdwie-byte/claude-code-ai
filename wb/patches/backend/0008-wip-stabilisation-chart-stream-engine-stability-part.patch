@@ -0,0 +1,42 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { NpcParticipationSessionTracker } from './npc-participation-session';
+
+test('a participation session commits once per (npc, battle), not per trade', () => {
+    const t = new NpcParticipationSessionTracker();
+    assert.equal(t.firstFillInRound(5, 100), true, 'first fill opens the session');
+    assert.equal(t.firstFillInRound(5, 100), false, 'second fill in the same round is the same session');
+    assert.equal(t.firstFillInRound(5, 100), false);
+    assert.equal(t.hasSession(5, 100), true);
+    assert.equal(t.sessionCount(100), 1);
+});
+
+test('a new round opens a new session for the same NPC', () => {
+    const t = new NpcParticipationSessionTracker();
+    assert.equal(t.firstFillInRound(5, 100), true);
+    assert.equal(t.firstFillInRound(5, 101), true);
+    assert.equal(t.firstFillInRound(5, 101), false);
+    assert.equal(t.sessionCount(101), 1);
+});
+
+test('different NPCs in one round each get their own session', () => {
+    const t = new NpcParticipationSessionTracker();
+    assert.equal(t.firstFillInRound(1, 100), true);
+    assert.equal(t.firstFillInRound(2, 100), true);
+    assert.equal(t.firstFillInRound(1, 100), false);
+    assert.equal(t.sessionCount(100), 2);
+});
+
+test('forgetBattle drops the round and memory stays bounded to the newest battles', () => {
+    const t = new NpcParticipationSessionTracker(2);
+    t.firstFillInRound(1, 100);
+    t.firstFillInRound(1, 101);
+    t.firstFillInRound(1, 102); // prunes battle 100
+    assert.equal(t.hasSession(1, 100), false);
+    assert.equal(t.hasSession(1, 101), true);
+    assert.equal(t.hasSession(1, 102), true);
+    t.forgetBattle(101);
+    assert.equal(t.hasSession(1, 101), false);
+    // A forgotten round would re-open a session if it ever came back (safe: at most one extra commit).
+    assert.equal(t.firstFillInRound(1, 101), true);
+});
