@@ -0,0 +1,178 @@
+/**
+ * The ONE NPC selection gate (pure part). Every NPC producer — the legacy
+ * simulator's tick layers, the liquidity heartbeat, the npc-worker
+ * intelligence runner, reactive bursts, defense paths and the organic engine —
+ * resolves "which NPC trades now" through this function so rotation
+ * (window, caps, cooldown, hard floor, no-repeat, min-distinct, strategy)
+ * and the starvation policy are applied in exactly one place.
+ *
+ * Redis / DB I/O (side locks, eligibility script, recent list, cursor, last
+ * clocks) is done by the caller and passed in, which keeps this testable.
+ */
+import {
+    applyMinDistinctGuard,
+    isWithinAllowedWindow,
+    NpcRotationReasonCode,
+    selectNpc,
+    type NpcRotationCandidate,
+    type NpcRotationSettings,
+} from './npc-rotation';
+
+export type NpcSelectionPurpose = 'organic' | 'defense';
+
+export interface NpcSelectionInput {
+    /** Candidates that already passed the per-battle side lock (and `rotationPaused`). */
+    candidates: NpcRotationCandidate[];
+    settings: NpcRotationSettings;
+    /** Result of the Redis eligibility script; missing ids count as eligible (fail open). */
+    eligibilityByNpc?: Map<number, NpcRotationReasonCode>;
+    /** Most-recently-used-first ids for the min-distinct guard. */
+    recentIds?: number[];
+    /** Full roster ordering + shared cursor for `round_robin`. */
+    rosterIds?: number[];
+    roundRobinCursor?: number;
+    now?: Date;
+    random?: () => number;
+    /**
+     * `organic` (default): the tape may pause under the `pause` starvation
+     * policy. `defense`: house-protection paths — caps are still *preferred*
+     * (an eligible NPC wins over a rested one) but the pick never starves.
+     */
+    purpose?: NpcSelectionPurpose;
+    /** Skip window/caps/cooldown/no-repeat entirely (side lock still applies). */
+    bypassCaps?: boolean;
+    /** Cap-free pick used for fallbacks (volume-weighted in the simulator). */
+    fallbackPick: (candidateIds: number[]) => number | null;
+}
+
+export type NpcSelectionReason =
+    | 'rotation_disabled'
+    | 'bypass'
+    | 'rotation'
+    | 'outside_window'
+    | 'starved'
+    | 'no_candidates';
+
+export interface NpcSelectionResult {
+    npcId: number | null;
+    /** True when the rotation filters left nothing (or the window is closed) and a policy decision was taken. */
+    starved: boolean;
+    /** Whether the cap-free fallback produced the pick. */
+    relaxed: boolean;
+    reason: NpcSelectionReason;
+}
+
+/**
+ * Resolves one NPC pick. Never throws.
+ *
+ * Order: side-locked candidates (input) → allowed window → Redis eligibility
+ * → min-distinct guard → strategy. Under starvation: `bypassCaps` or purpose
+ * `defense` or policy `relax` → cap-free fallback; policy `pause` (organic)
+ * → `null` so the organic tape pauses until an NPC is eligible again.
+ */
+export function resolveNpcSelection(input: NpcSelectionInput): NpcSelectionResult {
+    const candidates = input.candidates;
+    if (candidates.length === 0) {
+        return { npcId: null, starved: false, relaxed: false, reason: 'no_candidates' };
+    }
+    const ids = candidates.map((c) => c.npcId);
+    const settings = input.settings;
+    const purpose = input.purpose ?? 'organic';
+
+    if (!settings.enabled) {
+        return {
+            npcId: input.fallbackPick(ids),
+            starved: false,
+            relaxed: false,
+            reason: 'rotation_disabled',
+        };
+    }
+    if (input.bypassCaps) {
+        return { npcId: input.fallbackPick(ids), starved: false, relaxed: false, reason: 'bypass' };
+    }
+
+    const now = input.now ?? new Date();
+    const neverStarve = purpose === 'defense' || settings.starvationPolicy !== 'pause';
+    const starve = (reason: 'outside_window' | 'starved'): NpcSelectionResult =>
+        neverStarve
+            ? { npcId: input.fallbackPick(ids), starved: true, relaxed: true, reason }
+            : { npcId: null, starved: true, relaxed: false, reason };
+
+    if (
+        !isWithinAllowedWindow(
+            now,
+            settings.windowFrom,
+            settings.windowTo,
+            settings.timezoneOffsetMinutes,
+        )
+    ) {
+        return starve('outside_window');
+    }
+
+    const eligibility = input.eligibilityByNpc;
+    let filtered = eligibility
+        ? candidates.filter(
+              (c) =>
+                  (eligibility.get(c.npcId) ?? NpcRotationReasonCode.ELIGIBLE) ===
+                  NpcRotationReasonCode.ELIGIBLE,
+          )
+        : candidates.slice();
+    filtered = applyMinDistinctGuard(
+        filtered,
+        input.recentIds ?? [],
+        settings.minDistinct,
+        candidates.length,
+    );
+    const picked = selectNpc(filtered, settings.strategy, input.random ?? Math.random, {
+        roundRobinCursor: input.roundRobinCursor,
+        rosterIds: input.rosterIds,
+    });
+    if (picked == null) return starve('starved');
+    return { npcId: picked.npcId, starved: false, relaxed: false, reason: 'rotation' };
+}
+
+/**
+ * Batch form used where a producer iterates its own candidate list (the
+ * legacy activity layer, the organic engine's tier buckets): returns the ids
+ * that pass window + eligibility, applying the same starvation policy — under
+ * `relax` (or `defense`) an empty result is widened back to `ids`, under
+ * `pause` it stays empty so the producer skips this arrival.
+ */
+export function filterNpcIdsForSelection(input: {
+    ids: number[];
+    settings: NpcRotationSettings;
+    eligibilityByNpc?: Map<number, NpcRotationReasonCode>;
+    now?: Date;
+    purpose?: NpcSelectionPurpose;
+    bypassCaps?: boolean;
+}): { ids: number[]; starved: boolean; reason: NpcSelectionReason } {
+    const { ids, settings } = input;
+    if (ids.length === 0) return { ids: [], starved: false, reason: 'no_candidates' };
+    if (!settings.enabled) return { ids, starved: false, reason: 'rotation_disabled' };
+    if (input.bypassCaps) return { ids, starved: false, reason: 'bypass' };
+    const purpose = input.purpose ?? 'organic';
+    const neverStarve = purpose === 'defense' || settings.starvationPolicy !== 'pause';
+    const now = input.now ?? new Date();
+    if (
+        !isWithinAllowedWindow(
+            now,
+            settings.windowFrom,
+            settings.windowTo,
+            settings.timezoneOffsetMinutes,
+        )
+    ) {
+        return { ids: neverStarve ? ids : [], starved: true, reason: 'outside_window' };
+    }
+    const eligibility = input.eligibilityByNpc;
+    const eligible = eligibility
+        ? ids.filter(
+              (id) =>
+                  (eligibility.get(id) ?? NpcRotationReasonCode.ELIGIBLE) ===
+                  NpcRotationReasonCode.ELIGIBLE,
+          )
+        : ids;
+    if (eligible.length === 0) {
+        return { ids: neverStarve ? ids : [], starved: true, reason: 'starved' };
+    }
+    return { ids: eligible, starved: false, reason: 'rotation' };
+}
