--- /dev/null
+++ b/packages/shared/src/npc/npc-participation-session.ts
@@ -0,0 +1,64 @@
+/**
+ * Rotation "participation session" bookkeeping.
+ *
+ * A session is one (npcId, battleId) pair: the first fill an NPC lands in a
+ * round opens its session; every further fill in the same round belongs to
+ * the same session. Rotation caps (`max_per_day/week/month`), the drawn
+ * cooldown and the hard floor are committed ONCE per session — previously they
+ * were committed per trade, so `max_per_day = 12` meant twelve *trades* and a
+ * single fill sent the NPC into a 2-6 h cooldown, which is why the admin
+ * "sessions" copy never matched what players saw.
+ *
+ * Pure and in-memory (no Redis): one tracker per process, bounded to the last
+ * few battles so a long-lived worker never grows without limit.
+ */
+export class NpcParticipationSessionTracker {
+    private readonly byBattle = new Map<number, Set<number>>();
+
+    constructor(private readonly maxBattles: number = 4) {}
+
+    /**
+     * Returns true exactly once per (npcId, battleId) — on the first landed
+     * fill — and false for every later fill of the same NPC in that round.
+     */
+    firstFillInRound(npcId: number, battleId: number): boolean {
+        let npcs = this.byBattle.get(battleId);
+        if (!npcs) {
+            npcs = new Set<number>();
+            this.byBattle.set(battleId, npcs);
+            this.prune();
+        }
+        if (npcs.has(npcId)) return false;
+        npcs.add(npcId);
+        return true;
+    }
+
+    /** Whether the NPC already has an open session in this round. */
+    hasSession(npcId: number, battleId: number): boolean {
+        return this.byBattle.get(battleId)?.has(npcId) === true;
+    }
+
+    /** Distinct NPCs with a session in this round. */
+    sessionCount(battleId: number): number {
+        return this.byBattle.get(battleId)?.size ?? 0;
+    }
+
+    /** Drops a finished round (called on battle end / stop). */
+    forgetBattle(battleId: number): void {
+        this.byBattle.delete(battleId);
+    }
+
+    clear(): void {
+        this.byBattle.clear();
+    }
+
+    /** Keeps only the newest `maxBattles` battle ids (ids are monotonically increasing). */
+    private prune(): void {
+        if (this.byBattle.size <= this.maxBattles) return;
+        const ids = [...this.byBattle.keys()].sort((a, b) => a - b);
+        while (ids.length > this.maxBattles) {
+            const oldest = ids.shift()!;
+            this.byBattle.delete(oldest);
+        }
+    }
+}
