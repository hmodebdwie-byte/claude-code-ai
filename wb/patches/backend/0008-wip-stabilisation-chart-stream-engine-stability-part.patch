+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { NpcTradePublishCoalescer, type NpcTradeWireBatch } from './npc-trade-publish.coalescer';
+
+function harness() {
+    const snapshots: number[] = [];
+    const published: Array<{ channel: string; payload: NpcTradeWireBatch }> = [];
+    const snapshotPublisher: any = { publish: async (battleId: number) => { snapshots.push(battleId); } };
+    const redisPublisher: any = { publish: async (channel: string, payload: NpcTradeWireBatch) => { published.push({ channel, payload }); } };
+    const coalescer = new NpcTradePublishCoalescer(snapshotPublisher, redisPublisher);
+    return { coalescer, snapshots, published };
+}
+
+const fill = (npcId: number, amount: number, side: 'BUY' | 'SELL' = 'BUY') => ({ battleId: 9, npcId, side, amount, buyPot: 100 + amount, sellPot: 100 });
+
+test('fills scheduled within one coalesce window are accumulated, not overwritten', async () => {
+    const h = harness();
+    // First schedule flushes immediately (no previous flush) and opens the window.
+    h.coalescer.scheduleNpcTradePublish(9, fill(1, 10));
+    await new Promise((r) => setImmediate(r));
+    assert.equal(h.published.length, 1);
+    assert.equal(h.published[0]!.payload.fillCount, 1);
+    // Three more fills inside the window: previously only the last survived.
+    h.coalescer.scheduleNpcTradePublish(9, fill(2, 20));
+    h.coalescer.scheduleNpcTradePublish(9, fill(3, 30, 'SELL'));
+    h.coalescer.scheduleNpcTradePublish(9, fill(4, 40));
+    await h.coalescer.flushBattle(9);
+    assert.equal(h.published.length, 2);
+    const batch = h.published[1]!.payload;
+    assert.equal(h.published[1]!.channel, 'engine:events:npc.trade');
+    assert.equal(batch.fillCount, 3);
+    assert.equal(batch.totalAmount, 90);
+    assert.deepEqual(batch.fills.map((f) => f.npcId), [2, 3, 4]);
+    // Backwards compatible top level = the last fill (existing consumers read these fields).
+    assert.equal(batch.npcId, 4);
+    assert.equal(batch.amount, 40);
+    assert.equal(batch.side, 'BUY');
+    assert.equal(batch.buyPot, 140);
+    h.coalescer.forgetBattle(9);
+});
+
+test('an empty pending set publishes nothing and forgetBattle drops queued fills', async () => {
+    const h = harness();
+    h.coalescer.scheduleNpcTradePublish(5, fill(1, 1));
+    await new Promise((r) => setImmediate(r));
+    h.coalescer.scheduleNpcTradePublish(5, fill(2, 2));
+    h.coalescer.forgetBattle(5);
+    await h.coalescer.flushBattle(5);
+    assert.equal(h.published.length, 1);
+});
