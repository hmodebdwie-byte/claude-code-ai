-const lastPriceTickAtByBattle = new Map<number, number>();
+export interface CoalescedPriceTick {
+    price: number;
+    displayPrice: number;
+    /** Trade notional of THIS trade; the coalescer sums it across the window. */
+    volumeScale: number;
+}
+
+export type PriceTickPublishFn<T extends CoalescedPriceTick> = (
+    tick: T,
+    /** Sum of `volumeScale` of every trade since the previous PUBLISHED tick (this one included). */
+    accumulatedVolume: number,
+) => Promise<void>;
+
+interface BattleWindow<T extends CoalescedPriceTick> {
+    lastPublishedAt: number;
+    lastPublishedPrice: number | null;
+    pendingVolume: number;
+    pendingTick: T | null;
+    timer: ReturnType<typeof setTimeout> | null;
+    publish: PriceTickPublishFn<T> | null;
+}
 
 /**
- * Cap `engine:events:price.tick` publishes per battle (Fix 2 — engine side).
- * Market state still updates on every trade; only Redis fan-out is coalesced.
+ * Per-battle `engine:events:price.tick` coalescer (200 ms window).
+ *
+ * Old behaviour: the first tick in a window was published, every later one was
+ * DROPPED together with its `volumeScale`, so (a) chart volume bars reflected
+ * sampling luck rather than traded notional — a $100k order landing 50 ms after
+ * another trade never reached the candle — and (b) the last price of a burst was
+ * not published until the next trade.
+ *
+ * New behaviour (contract C1):
+ *   - leading edge: the first trade of a quiet window publishes immediately;
+ *   - inside the window volume ACCUMULATES and the latest tick is remembered;
+ *   - trailing edge: a timer flushes the latest tick with the accumulated volume
+ *     at the end of the window, so the last price of a burst is always published
+ *     and `volumeScale` on the wire is the SUM of notional since the previous
+ *     published tick.
+ * Market state is never coalesced — only the Redis fan-out is.
  */
-export function shouldPublishEnginePriceTick(battleId: number): boolean {
-    if (PRICE_TICK_COALESCE_MS <= 0) return true;
-    const now = Date.now();
