@@ -0,0 +1,79 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PerBattleSerialQueue } from './per-battle-serial-queue';
+
+const tick = () => new Promise<void>((r) => setImmediate(r));
+
+test('tasks for the same battle run strictly one at a time, in arrival order', async () => {
+    const q = new PerBattleSerialQueue();
+    const log: string[] = [];
+    let inFlight = 0;
+    let maxInFlight = 0;
+    const mk = (name: string, delayMs: number) => async () => {
+        inFlight += 1;
+        maxInFlight = Math.max(maxInFlight, inFlight);
+        log.push(`${name}:start`);
+        await new Promise((r) => setTimeout(r, delayMs));
+        log.push(`${name}:end`);
+        inFlight -= 1;
+    };
+    const all = Promise.all([
+        q.enqueue(1, mk('a', 15)),
+        q.enqueue(1, mk('b', 1)),
+        q.enqueue(1, mk('c', 1)),
+    ]);
+    assert.equal(q.depth(1), 3);
+    await all;
+    assert.equal(maxInFlight, 1);
+    assert.deepEqual(log, ['a:start', 'a:end', 'b:start', 'b:end', 'c:start', 'c:end']);
+    assert.equal(q.depth(1), 0);
+});
+
+test('lost-update regression: a read-compute-write applied through the queue never loses a trade', async () => {
+    // Model of MarketStateService.applyTradeExecuted: read cached state, await
+    // something, then write. Unserialised, both trades read version 0 and the
+    // second write clobbers the first (version ends at 1, not 2).
+    const state = { version: 0, pot: 0 };
+    const apply = (amount: number) => async () => {
+        const read = { ...state };
+        await tick();
+        state.version = read.version + 1;
+        state.pot = read.pot + amount;
+    };
+    await Promise.all([apply(100)(), apply(50)()]);
+    assert.equal(state.version, 1, 'unserialised: one update is lost (this is the bug)');
+    assert.equal(state.pot, 50);
+
+    state.version = 0;
+    state.pot = 0;
+    const q = new PerBattleSerialQueue();
+    await Promise.all([q.enqueue(7, apply(100)), q.enqueue(7, apply(50))]);
+    assert.equal(state.version, 2);
+    assert.equal(state.pot, 150);
+});
+
+test('different battles do not block each other', async () => {
+    const q = new PerBattleSerialQueue();
+    const order: string[] = [];
+    const slow = q.enqueue(1, async () => {
+        await new Promise((r) => setTimeout(r, 20));
+        order.push('slow-1');
+    });
+    const fast = q.enqueue(2, async () => {
+        order.push('fast-2');
+    });
+    await Promise.all([slow, fast]);
+    assert.deepEqual(order, ['fast-2', 'slow-1']);
+});
+
+test('a rejected task surfaces to its caller but does not break the chain behind it', async () => {
+    const q = new PerBattleSerialQueue();
+    const failing = q.enqueue(3, async () => {
+        throw new Error('boom');
+    });
+    const next = q.enqueue(3, async () => 'ok');
+    await assert.rejects(failing, /boom/);
+    assert.equal(await next, 'ok');
+    await q.drain(3);
+    assert.equal(q.depth(3), 0);
+});
diff --git a/apps/engine/src/events/per-battle-serial-queue.ts b/apps/engine/src/events/per-battle-serial-queue.ts
new file mode 100644
index 0000000..af5ae23
--- /dev/null
+++ b/apps/engine/src/events/per-battle-serial-queue.ts
@@ -0,0 +1,77 @@
+/**
+ * Strict FIFO execution per key (battle id).
+ *
+ * `trade.executed` messages used to be handled concurrently: ioredis emits every
+ * `message` of one socket read in a tight loop, so handler B started (and read the
+ * cached market state) before handler A had written its result — B's `repo.set`
+ * then overwrote A's price impact, pots, `lastSequence` and `lastProcessedEventId`.
+ * Because `ticktrade:price:last` (the settlement final price) and roundHigh/Low
+ * derive from that path, the race was money-affecting.
+ *
+ * Every mutation of a battle's market state now goes through {@link enqueue}: one
+ * task in flight per battle, the rest wait in arrival order. State updates are
+ * never dropped — only the depth is watched so a runaway backlog is visible in
+ * the logs (the publishers downstream already coalesce their own fan-out).
+ */
+export class PerBattleSerialQueue {
+    private readonly tails = new Map<number, Promise<void>>();
+    private readonly depths = new Map<number, number>();
+    private lastDepthWarnAt = 0;
+
+    constructor(
+        private readonly warnDepth = 200,
+        private readonly label = '[SerialQueue]',
+    ) {}
+
+    /** Queued + in-flight tasks for `key`. */
+    depth(key: number): number {
+        return this.depths.get(key) ?? 0;
+    }
+
+    /**
+     * Run `task` after every task previously enqueued for `key` has settled.
+     * The returned promise resolves/rejects with the task's own outcome; a
+     * rejection never breaks the chain for the tasks behind it.
+     */
+    enqueue<T>(key: number, task: () => Promise<T>): Promise<T> {
+        const prev = this.tails.get(key) ?? Promise.resolve();
+        const depth = (this.depths.get(key) ?? 0) + 1;
+        this.depths.set(key, depth);
+        if (depth >= this.warnDepth) {
+            const now = Date.now();
+            if (now - this.lastDepthWarnAt > 5_000) {
+                this.lastDepthWarnAt = now;
+                console.warn(`${this.label} backlog key=${key} depth=${depth}`);
+            }
+        }
+        const run = prev.then(task);
+        const settled: Promise<void> = run.then(
+            () => undefined,
+            () => undefined,
+        );
+        const tail = settled.then(() => {
+            const d = (this.depths.get(key) ?? 1) - 1;
+            if (d <= 0) {
+                this.depths.delete(key);
+                // Only forget the tail when nothing else was chained behind us.
+                if (this.tails.get(key) === tail) this.tails.delete(key);
+            } else {
+                this.depths.set(key, d);
+            }
+        });
+        this.tails.set(key, tail);
+        return run;
+    }
+
+    /** Wait until everything queued for `key` so far has settled. */
+    async drain(key: number): Promise<void> {
+        const tail = this.tails.get(key);
+        if (tail) await tail;
+    }
+
+    /** Drop bookkeeping for a finished battle (tasks already in flight still complete). */
+    forget(key: number): void {
+        this.tails.delete(key);
+        this.depths.delete(key);
+    }
+}
diff --git a/apps/engine/src/events/price-tick-coalesce.spec.ts b/apps/engine/src/events/price-tick-coalesce.spec.ts
new file mode 100644
index 0000000..397aa3b
--- /dev/null
+++ b/apps/engine/src/events/price-tick-coalesce.spec.ts
@@ -0,0 +1,108 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { PriceTickCoalescer } from './price-tick-coalesce';
+
+type Tick = { price: number; displayPrice: number; volumeScale: number; tag: string };
+
+function harness(windowMs = 200) {
+    let now = 10_000;
+    const published: Array<{ tag: string; price: number; volume: number }> = [];
+    const c = new PriceTickCoalescer<Tick>(windowMs, () => now);
+    const publish = async (t: Tick, volume: number) => {
+        published.push({ tag: t.tag, price: t.price, volume });
+    };
+    const offer = (tag: string, price: number, volumeScale: number) => c.offer(1, { price, displayPrice: price, volumeScale, tag }, publish);
+    const advance = (ms: number) => {
+        now += ms;
+    };
+    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+    return { c, published, offer, advance, wait };
+}
+
+test('leading edge publishes immediately; volume inside the window accumulates into ONE trailing tick', async () => {
+    const h = harness(50);
+    h.offer('a', 1.10, 100_000); // quiet window → publish now
+    assert.equal(h.published.length, 1);
+    assert.equal(h.published[0]!.volume, 100_000);
+    h.advance(10);
+    h.offer('b', 1.11, 10_000); // inside window → deferred
+    h.advance(10);
+    h.offer('c', 1.12, 5_000); // inside window → deferred, latest price wins
+    assert.equal(h.published.length, 1, 'nothing extra published inside the window');
+    assert.equal(h.c.hasPending(1), true);
+    await h.wait(80); // trailing timer fires
+    assert.equal(h.published.length, 2);
+    assert.equal(h.published[1]!.tag, 'c', 'the LAST price of the burst is what goes out');
+    assert.equal(h.published[1]!.price, 1.12);
+    assert.equal(h.published[1]!.volume, 15_000, 'sum of every trade since the previous published tick');
+    assert.equal(h.c.hasPending(1), false);
+    assert.equal(h.c.lastPublishedPrice(1), 1.12);
+    h.c.forget(1);
+});
+
+test('no volume is ever lost across windows (regression for the $100k-order-vanishes bug)', async () => {
+    const h = harness(20);
+    const amounts = [100_000, 7, 3, 12_000, 1, 1, 90, 2_500];
+    let expected = 0;
+    for (const [i, a] of amounts.entries()) {
+        expected += a;
+        h.offer(`t${i}`, 1 + i / 1000, a);
+        h.advance(4);
+    }
+    await h.wait(60);
+    const total = h.published.reduce((s, p) => s + p.volume, 0);
+    assert.equal(total, expected);
+    assert.equal(h.published.at(-1)!.tag, 't7');
+    h.c.forget(1);
+});
+
+test('a window of 0 publishes every tick with its own volume', () => {
+    const h = harness(0);
+    h.offer('a', 1, 5);
+    h.offer('b', 1, 6);
+    assert.deepEqual(h.published.map((p) => p.volume), [5, 6]);
+    h.c.forget(1);
+});
+
+test('flush() publishes the pending tick right away and forget() cancels the timer', async () => {
+    const h = harness(1_000);
+    h.offer('a', 1, 1);
+    h.advance(5);
+    h.offer('b', 2, 2);
+    h.c.flush(1);
+    assert.equal(h.published.length, 2);
+    assert.equal(h.published[1]!.tag, 'b');
+    h.advance(5);
+    h.offer('c', 3, 3);
+    assert.equal(h.c.hasPending(1), true);
+    h.c.forget(1);
+    await h.wait(5);
+    assert.equal(h.published.length, 2, 'forgotten battle never flushes');
+});
+
+test('a failing publish is logged, not thrown, and does not poison the next window', async () => {
+    let now = 0;
+    const c = new PriceTickCoalescer<Tick>(10, () => now);
+    const seen: string[] = [];
+    const origWarn = console.warn;
+    const warnings: string[] = [];
+    console.warn = (...args: unknown[]) => {
+        warnings.push(String(args[0]));
+    };
+    try {
+        c.offer(1, { price: 1, displayPrice: 1, volumeScale: 1, tag: 'fail' }, async () => {
+            throw new Error('redis down');
+        });
+        await new Promise((r) => setImmediate(r));
+        now += 20;
+        c.offer(1, { price: 2, displayPrice: 2, volumeScale: 1, tag: 'ok' }, async (t) => {
+            seen.push(t.tag);
+        });
+        await new Promise((r) => setImmediate(r));
+    } finally {
+        console.warn = origWarn;
+    }
+    assert.deepEqual(seen, ['ok']);
+    assert.ok(warnings.some((w) => w.includes('redis down')));
+    c.forget(1);
+});
diff --git a/apps/engine/src/events/price-tick-coalesce.ts b/apps/engine/src/events/price-tick-coalesce.ts
index 34757c5..d0c57ca 100644
--- a/apps/engine/src/events/price-tick-coalesce.ts
+++ b/apps/engine/src/events/price-tick-coalesce.ts
