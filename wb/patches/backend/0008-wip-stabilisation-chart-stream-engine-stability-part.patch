-    return true;
+export class PriceTickCoalescer<T extends CoalescedPriceTick = CoalescedPriceTick> {
+    private readonly windows = new Map<number, BattleWindow<T>>();
+
+    constructor(
+        private readonly windowMs = PRICE_TICK_COALESCE_MS,
+        private readonly now: () => number = Date.now,
+    ) {}
+
+    private window(battleId: number): BattleWindow<T> {
+        let w = this.windows.get(battleId);
+        if (!w) {
+            // -Infinity: the very first tick of a battle is always a leading edge.
+            w = { lastPublishedAt: Number.NEGATIVE_INFINITY, lastPublishedPrice: null, pendingVolume: 0, pendingTick: null, timer: null, publish: null };
+            this.windows.set(battleId, w);
+        }
+        return w;
+    }
+
+    /** Offer a tick; it is published now, or folded into the trailing flush. Never throws. */
+    offer(battleId: number, tick: T, publish: PriceTickPublishFn<T>): void {
+        const w = this.window(battleId);
+        w.publish = publish;
+        const now = this.now();
+        const volume = Number.isFinite(tick.volumeScale) ? Math.max(0, tick.volumeScale) : 0;
+        if (this.windowMs <= 0) {
+            void this.emit(battleId, w, tick, w.pendingVolume + volume, now);
+            return;
+        }
+        const elapsed = now - w.lastPublishedAt;
+        if (w.timer === null && elapsed >= this.windowMs) {
+            void this.emit(battleId, w, tick, w.pendingVolume + volume, now);
+            return;
+        }
+        w.pendingVolume += volume;
+        w.pendingTick = tick;
+        if (w.timer === null) {
+            const delay = Math.max(1, this.windowMs - elapsed);
+            w.timer = setTimeout(() => this.flush(battleId), delay);
+        }
+    }
+
+    /** Publish the pending trailing tick now (window end, battle close). */
+    flush(battleId: number): void {
+        const w = this.windows.get(battleId);
+        if (!w) return;
+        if (w.timer !== null) {
+            clearTimeout(w.timer);
+            w.timer = null;
+        }
+        const tick = w.pendingTick;
+        if (!tick || !w.publish) {
+            w.pendingTick = null;
+            return;
+        }
+        void this.emit(battleId, w, tick, w.pendingVolume, this.now());
+    }
+
+    private async emit(battleId: number, w: BattleWindow<T>, tick: T, volume: number, at: number): Promise<void> {
+        w.pendingVolume = 0;
+        w.pendingTick = null;
+        w.lastPublishedAt = at;
+        w.lastPublishedPrice = tick.price;
+        const publish = w.publish;
+        if (!publish) return;
+        try {
+            await publish(tick, volume);
+        } catch (err) {
+            console.warn(
+                `[PriceTickCoalescer] publish failed battle=${battleId}: ${err instanceof Error ? err.message : err}`,
+            );
+        }
+    }
+
+    /** Last price that actually went out on the wire for this battle (null before the first publish). */
+    lastPublishedPrice(battleId: number): number | null {
+        return this.windows.get(battleId)?.lastPublishedPrice ?? null;
+    }
+
+    /** True while a trailing flush is armed (a newer price will go out within the window). */
+    hasPending(battleId: number): boolean {
+        const w = this.windows.get(battleId);
+        return !!w && w.pendingTick !== null;
+    }
+
+    /** Record an out-of-band publish (heartbeat re-publish) so change detection stays accurate. */
+    notePublished(battleId: number, price: number): void {
+        const w = this.window(battleId);
+        w.lastPublishedPrice = price;
+    }
+
+    forget(battleId: number): void {
+        const w = this.windows.get(battleId);
+        if (w?.timer !== null && w?.timer !== undefined) clearTimeout(w.timer);
+        this.windows.delete(battleId);
+    }
+}
+
+/** Tick shape the trade pipeline hands to the process-wide coalescer. */
