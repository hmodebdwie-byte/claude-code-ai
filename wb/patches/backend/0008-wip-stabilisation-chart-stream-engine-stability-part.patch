+/**
+ * Durable copy of the operator's START/STOP choice in `system_settings`
+ * (`'1'` / `'0'`). Written by the admin start/stop endpoints; read by the
+ * npc-worker (and the admin status endpoint) whenever the Redis mirror is
+ * missing, so a Redis flush/restart can never silently re-enable NPC trading.
+ */
+export const NPC_SIMULATOR_ACTIVE_SETTING_KEY = 'npc_simulator_active';
+
+/**
+ * Missing or empty key now means OFF.
+ *
+ * Before this change a missing key meant ON ("legacy auto-start"), which is
+ * exactly the wrong failure mode for a finance app: any Redis restart after an
+ * admin STOP silently resumed NPC trading (which spends NPC balances with auto
+ * top-up and, in legacy mode, force-wins pots against real users). The worker
+ * mirrors the durable DB choice back into Redis on boot/poll, so in steady
+ * state the key is always present and this default only matters while the
+ * worker is down or has never run — in which case nothing should trade.
+ */
+export function isNpcSimulatorDesiredActive(raw: string | null | undefined): boolean {
+    if (raw == null || raw === '') return false;
     return raw !== NPC_SIMULATOR_ACTIVE_OFF;
 }
 
+export type NpcSimulatorDesiredSource = 'redis' | 'db' | 'default';
+
+export interface NpcSimulatorDesiredState {
+    active: boolean;
+    /** Where the answer came from: the Redis hot mirror, the durable DB row, or the OFF default. */
+    source: NpcSimulatorDesiredSource;
+}
+
+/**
+ * Resolves the operator's desired ON/OFF state with the documented precedence:
+ * Redis mirror (if present) → `system_settings.npc_simulator_active` (if a row
+ * exists) → OFF. Pure so it can be unit-tested and shared by the worker, the
+ * engine listener and the admin status endpoint.
+ */
+export function resolveNpcSimulatorDesiredActive(input: {
+    redisRaw: string | null | undefined;
+    dbRaw: string | null | undefined;
+}): NpcSimulatorDesiredState {
+    const redisRaw = input.redisRaw;
+    if (redisRaw != null && redisRaw !== '') {
+        return { active: redisRaw !== NPC_SIMULATOR_ACTIVE_OFF, source: 'redis' };
+    }
+    const dbRaw = input.dbRaw;
+    if (dbRaw != null && String(dbRaw).trim() !== '') {
+        const v = String(dbRaw).trim().toLowerCase();
+        return { active: v === NPC_SIMULATOR_ACTIVE_ON || v === 'true', source: 'db' };
+    }
+    return { active: false, source: 'default' };
+}
+
+// ──────────────────────────────────────────────────────────────────────────
+// Recent NPC fills ring (admin "NPC Traders" tab)
+// ──────────────────────────────────────────────────────────────────────────
+
+/** Redis list of the last {@link NPC_RECENT_TRADES_MAX} NPC fills, newest first, one JSON entry each. */
+export const NPC_RECENT_TRADES_REDIS_KEY = 'ticktrade:npc:recent_trades';
+export const NPC_RECENT_TRADES_MAX = 50;
+const NPC_RECENT_TRADES_TTL_SEC = 7 * 24 * 60 * 60;
+
+export interface NpcRecentTradeEntry {
+    /** ISO timestamp of the fill. */
+    at: string;
+    battle_id: number;
+    npc_id: number;
+    username: string;
+    side: 'BUY' | 'SELL';
+    amount: number;
+    source: 'legacy' | 'organic';
+    /** Code path that placed the fill (e.g. `liquidity`, `organic_arrival`, `endgame`). */
+    reason?: string;
+}
+
+export interface NpcRecentTradesRedis {
+    lpush(key: string, ...values: string[]): Promise<unknown>;
+    ltrim(key: string, start: number, stop: number): Promise<unknown>;
+    expire(key: string, seconds: number): Promise<unknown>;
+    lrange(key: string, start: number, stop: number): Promise<string[]>;
+}
+
+/** LPUSH + LTRIM 0 49. Best-effort: never throws, never awaited on the trade path. */
+export async function pushNpcRecentTrade(
+    redis: Pick<NpcRecentTradesRedis, 'lpush' | 'ltrim' | 'expire'>,
+    entry: NpcRecentTradeEntry,
+): Promise<void> {
+    try {
+        await redis.lpush(NPC_RECENT_TRADES_REDIS_KEY, JSON.stringify(entry));
+        await redis.ltrim(NPC_RECENT_TRADES_REDIS_KEY, 0, NPC_RECENT_TRADES_MAX - 1);
+        await redis.expire(NPC_RECENT_TRADES_REDIS_KEY, NPC_RECENT_TRADES_TTL_SEC);
+    } catch {
+        // diagnostics only
+    }
+}
+
+/** Newest first. Malformed entries are dropped; a Redis error yields []. */
+export async function readNpcRecentTrades(
+    redis: Pick<NpcRecentTradesRedis, 'lrange'>,
+    limit: number = NPC_RECENT_TRADES_MAX,
+): Promise<NpcRecentTradeEntry[]> {
+    try {
+        const raw = await redis.lrange(NPC_RECENT_TRADES_REDIS_KEY, 0, Math.max(0, limit - 1));
+        const out: NpcRecentTradeEntry[] = [];
+        for (const s of raw) {
+            try {
+                const p = JSON.parse(s) as Partial<NpcRecentTradeEntry>;
+                if (!p || typeof p !== 'object') continue;
+                if (!Number.isFinite(Number(p.battle_id)) || !Number.isFinite(Number(p.npc_id))) continue;
+                out.push({
+                    at: typeof p.at === 'string' ? p.at : new Date(0).toISOString(),
+                    battle_id: Number(p.battle_id),
+                    npc_id: Number(p.npc_id),
+                    username: typeof p.username === 'string' ? p.username : `NPC #${Number(p.npc_id)}`,
+                    side: p.side === 'SELL' ? 'SELL' : 'BUY',
+                    amount: Number(p.amount) || 0,
+                    source: p.source === 'organic' ? 'organic' : 'legacy',
+                    reason: typeof p.reason === 'string' ? p.reason : undefined,
+                });
+            } catch {
+                // skip malformed entry
+            }
+        }
+        return out;
+    } catch {
+        return [];
+    }
+}
+
+/**
+ * Rotation starvation marker written by the legacy simulator / organic engine
+ * when the rotation filters leave no eligible NPC (value: JSON `{at, policy}`,
+ * short TTL so it clears by itself once picks succeed again). The admin
+ * status endpoint surfaces it as `rotation_starved`.
+ */
+export const NPC_ROTATION_STARVED_REDIS_KEY = 'ticktrade:npc:rotation:starved';
+export const NPC_ROTATION_STARVED_TTL_SEC = 120;
+
