@@ -0,0 +1,218 @@
+/**
+ * Regression specs for the chart candle pipeline (C1: continuous `all` stream).
+ * Covers: flat-fill contiguity of the batch window, $-notional volume accumulation (live and DB
+ * rebuild), late-tick folding (no volume loss at the second boundary) and eventId dedupe.
+ */
+import {
+    applyTickToState,
+    buildContiguousWindow,
+    buildFlatAllStreamCandle,
+    collectBattleIds,
+    createCandleState,
+    getBucketStart,
+    priceTickDedupeKey,
+    rebuildCandlesFromPriceTicks,
+    resolveTickBucketStart,
+    toCandle,
+    toUnifiedCandle,
+    type AllStreamCandle,
+} from './candle-aggregation';
+import { BUCKET_MS, CANDLE_BATCH_WINDOW_SECONDS, ALL_STREAM_MAX_POINTS, MAX_POINTS } from './candle-types';
+
+const T0 = Date.UTC(2026, 0, 1, 12, 0, 0); // bucket-aligned
+
+function candleAt(
+    bucketStartMs: number,
+    close: number,
+    battleId: number | null,
+    volume = 0,
+    count = 0,
+): AllStreamCandle {
+    return {
+        timestamp: new Date(bucketStartMs).toISOString(),
+        open: close,
