+++ b/apps/engine/src/battle/battle-engine.stability.spec.ts
@@ -0,0 +1,263 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { installRedisClientMock } from '../redis/redis-client.test-mock';
+
+// Constants are read at module load: shrink the retry/watchdog budgets first.
+process.env.ENGINE_FINISH_IO_ATTEMPTS = '2';
+process.env.ENGINE_FINISH_RETRY_MS = '1000';
+process.env.ENGINE_SETTLEMENT_WATCHDOG_MS = '1000';
+process.env.ENGINE_HEARTBEAT_BOUNDARY_OFFSET_MS = '30';
+process.env.ENGINE_PRICE_TICK_COALESCE_MS = '0';
+const fakeRedis = installRedisClientMock();
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { BattleEngineService } = require('./battle-engine.service');
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+type Opts = {
+    updateFails?: number;
+    endFails?: number;
+    enqueueFails?: number;
+    lastPrice?: number | null;
+    completedEndPrice?: number | null;
+    battleRow?: () => { status: string; state: string } | null;
+    jobState?: string;
+    onTrade?: (p: unknown) => Promise<void>;
+};
+
+function makeService(opts: Opts = {}) {
+    const calls: string[] = [];
+    const timers: Array<{ timeRemaining: number; timeElapsed: number; timestamp: number }> = [];
+    const store = new Map<number, any>();
+    let created: any = null;
+    const prisma = {
+        battle: {
+            update: async () => {
+                calls.push('update');
+                if ((opts.updateFails ?? 0) > 0) {
+                    opts.updateFails!--;
+                    throw new Error('P2024 pool timeout');
+                }
+                return {};
+            },
+            findFirst: async (args: any) => {
+                const status = args?.where?.status;
+                calls.push(`findFirst:${status}`);
+                if (status === 'COMPLETED') {
+                    return opts.completedEndPrice != null ? { id: 80, endPrice: String(opts.completedEndPrice) } : null;
+                }
+                return created ?? null;
+            },
+            findUnique: async () => opts.battleRow?.() ?? null,
+            create: async (args: any) => {
+                calls.push('create');
+                created = {
+                    id: 81,
+                    status: 'ACTIVE',
+                    state: 'OPEN',
+                    startTime: new Date(),
+                    durationSeconds: args.data.durationSeconds,
+                    startPrice: args.data.startPrice,
+                };
+                return created;
+            },
+        },
+        systemSetting: { findUnique: async () => null, findMany: async () => [] },
+    };
+    const events = {
+        battleEnd: async () => {
+            calls.push('battleEnd');
+            if ((opts.endFails ?? 0) > 0) {
+                opts.endFails!--;
+                throw new Error('redis publish failed');
+            }
+        },
+        timerUpdate: async (p: any) => {
+            timers.push(p);
+        },
+        priceTick: async () => undefined,
+        battleStarted: async () => undefined,
+        settlementCompleted: async () => undefined,
+        battleCancelled: async () => undefined,
+    };
+    const snapshotPublisher = {
+        publish: async () => undefined,
+        clearActiveBattleMeta: () => calls.push('stop'),
+        setActiveBattleMeta: () => undefined,
+        patchActiveBattleState: () => undefined,
+        forgetBattle: () => undefined,
+    };
+    const redisState = {
+        getLastPrice: async () => opts.lastPrice ?? null,
+        setLastPrice: async () => undefined,
+        setPressureSmoothed: async () => undefined,
+        getPressureSmoothed: async () => 0,
+        exists: async () => false,
+        setNxPx: async () => true,
+        get: async () => null,
+        del: async () => undefined,
+    };
+    const marketStateRepo = {
+        get: async (id: number) => store.get(id) ?? null,
+        set: async (s: any) => {
+            store.set(s.battleId, s);
+        },
+        forget: () => undefined,
+        delete: async (id: number) => {
+            store.delete(id);
+            calls.push('delete-state');
+        },
+    };
+    const settlementQueue = {
+        enqueue: async () => {
+            calls.push('enqueue');
+            if ((opts.enqueueFails ?? 0) > 0) {
+                opts.enqueueFails!--;
+                throw new Error('bullmq add failed');
+            }
+        },
+        getJobState: async () => opts.jobState ?? 'active',
+        retryFailed: async () => {
+            calls.push('retryFailed');
+            return true;
+        },
+        enqueueFresh: async () => {
+            calls.push('enqueueFresh');
+            return 'battle-x-r1';
+        },
+    };
+    const svc = new BattleEngineService(
+        prisma,
+        events,
+        {},
+        {},
+        snapshotPublisher,
+        redisState,
+        { forget: () => undefined },
+        marketStateRepo,
+        opts.onTrade ?? null,
+        null,
+        null,
+        null,
+        settlementQueue,
+        null,
+        null,
+    );
+    const attach = (id: number) => {
+        svc.activeBattleId = id;
+        svc.activeBattleCache = { id, status: 'ACTIVE', state: 'FINALIZE', startTimeMs: Date.now() - 300_000, durationSeconds: 300, startPrice: 1.25 };
+        svc.runtimeActive = true;
+    };
+    return { svc, calls, timers, prisma, store, attach, createdRow: () => created };
+}
+
+test('finishBattle: heartbeat is stopped only AFTER close write, battle.end and enqueue succeeded (with retries)', async () => {
+    const h = makeService({ updateFails: 1, lastPrice: 1.27 });
+    h.attach(81);
+    await h.svc.finishBattle(81, 1.27);
+    const order = h.calls.filter((c) => ['update', 'battleEnd', 'enqueue', 'stop'].includes(c));
+    assert.deepEqual(order, ['update', 'update', 'battleEnd', 'enqueue', 'stop']);
+    assert.equal(h.svc.getActiveBattleId(), null);
+    assert.deepEqual(h.svc.getWatchdogState().settlementWatchdogs, [81]);
+    await h.svc.onModuleDestroy();
+});
+
+test('finishBattle: when a step keeps failing the engine schedules a retry and resumes at the failed step (battle.end exactly once)', async () => {
+    const h = makeService({ enqueueFails: 2, lastPrice: 1.3 });
+    h.attach(82);
+    await h.svc.finishBattle(82, 1.3);
+    // Two attempts failed → not finished yet, heartbeat NOT stopped, retry armed.
+    assert.equal(h.calls.filter((c) => c === 'enqueue').length, 2);
+    assert.equal(h.calls.filter((c) => c === 'stop').length, 0);
+    assert.equal(h.svc.getActiveBattleId(), 82);
+    assert.equal(h.svc.getWatchdogState().settlementWatchdogs.length, 0);
+    await sleep(1_300);
+    // The retry re-ran only the enqueue (close write + battle.end are not repeated).
+    assert.equal(h.calls.filter((c) => c === 'update').length, 1);
+    assert.equal(h.calls.filter((c) => c === 'battleEnd').length, 1);
+    assert.equal(h.calls.filter((c) => c === 'enqueue').length, 3);
+    assert.equal(h.calls.filter((c) => c === 'stop').length, 1);
+    assert.equal(h.svc.getActiveBattleId(), null);
+    await h.svc.onModuleDestroy();
+});
+
+test('settlement watchdog: COMPLETED row without settlement.completed schedules the next round; FAILED job is retried', async () => {
+    let row = { status: 'ACTIVE', state: 'CLOSE' };
+    const h = makeService({ lastPrice: 1.2, battleRow: () => row, jobState: 'failed' });
+    h.attach(83);
+    await h.svc.finishBattle(83, 1.2);
+    assert.deepEqual(h.svc.getWatchdogState().settlementWatchdogs, [83]);
+    await sleep(1_200);
+    assert.ok(h.calls.includes('retryFailed'), 'failed job retried');
+    assert.deepEqual(h.svc.getWatchdogState().settlementWatchdogs, [83], 're-armed while still pending');
+    row = { status: 'COMPLETED', state: 'CLOSE' };
+    await sleep(1_200);
+    const state = h.svc.getWatchdogState();
+    assert.equal(state.nextBattlePending, true, 'next round scheduled by the watchdog');
+    assert.deepEqual(state.settlementWatchdogs, []);
+    assert.ok(h.calls.includes('delete-state'), 'market:state key cleaned up after settlement');
+    // A late settlement.completed for the same battle is a no-op (no second timer).
+    await h.svc.scheduleNextBattleAfterSettlement(83, 1.2);
+    assert.equal(h.calls.filter((c) => c === 'delete-state').length, 1);
+    await h.svc.onModuleDestroy();
+});
+
+test('recalcPriceFromTrade: trades for one battle are applied strictly FIFO, one at a time', async () => {
+    let inFlight = 0;
+    let maxInFlight = 0;
+    const seen: number[] = [];
+    const h = makeService({
+        onTrade: async (p: any) => {
+            inFlight++;
+            maxInFlight = Math.max(maxInFlight, inFlight);
+            await sleep(p.amount === 1 ? 15 : 1);
+            seen.push(p.amount);
+            inFlight--;
+        },
+    });
+    await Promise.all([1, 2, 3].map((amount) => h.svc.recalcPriceFromTrade({ battleId: 5, buyPot: 0, sellPot: 0, startPrice: 1, amount, entryPrice: 1 })));
+    assert.equal(maxInFlight, 1);
+    assert.deepEqual(seen, [1, 2, 3]);
+    assert.equal(h.svc.getTradeQueueDepth(5), 0);
+});
+
+test('continuity price: with Redis and memory empty, the next round starts at the last COMPLETED endPrice (no 1.23 spawn cliff)', async () => {
+    const h = makeService({ lastPrice: null, completedEndPrice: 1.28337 });
+    h.svc.runtimeActive = true;
+    await h.svc.start();
+    const row = h.createdRow();
+    assert.ok(row, 'a battle was created');
+    assert.equal(Number(row.startPrice), 1.28337);
+    assert.ok(fakeRedis.calls.some((c) => c.cmd === 'del'), 'free-tap display price cleared at start');
+    // Heartbeat: aligned to the round's second boundary, one tick per second, no duplicates.
+    await sleep(2_350);
+    const heartbeat = h.timers.filter((t) => t.timeElapsed > 0);
+    assert.ok(heartbeat.length >= 2, `expected >=2 heartbeat ticks, got ${heartbeat.length}`);
+    const remainings = heartbeat.map((t) => t.timeRemaining);
+    assert.equal(new Set(remainings).size, remainings.length, 'no duplicate seconds');
+    for (let i = 1; i < remainings.length; i++) assert.equal(remainings[i], remainings[i - 1]! - 1);
+    for (const t of heartbeat) {
+        const phase = (t.timestamp - row.startTime.getTime()) % 1000;
+        assert.ok(phase >= 20 && phase < 400, `tick lands just after the boundary (phase=${phase}ms)`);
+    }
+    await h.svc.onModuleDestroy();
+    assert.equal(h.svc.getActiveBattleId(), null);
+});
+
+test('startEngine keeps an existing market state (re-attach) instead of rebuilding it from the battles row', async () => {
+    const h = makeService({ lastPrice: 1.31 });
+    h.store.set(90, {
+        battleId: 90, version: 42, lastPrice: 1.31, startPrice: 1.25, buyPot: 5000, sellPot: 3000,
+        realBuyQty: 1, realSellQty: 1, npcBuyQty: 1, npcSellQty: 1, smoothedPressure: 0.2,
+        roundHigh: 1.35, roundLow: 1.2, lastTradeAt: 1, lastProcessedEventId: 'e', lastSequence: 42,
+        freezeState: 'OPEN', status: 'ACTIVE', updatedAt: 1,
+    });
+    h.svc.runtimeActive = true;
+    await h.svc.startEngine({ id: 90, status: 'ACTIVE', state: 'OPEN', startTime: new Date(), durationSeconds: 300, startPrice: '1.25', buyPot: 0, sellPot: 0 });
+    const state = h.store.get(90);
+    assert.equal(state.version, 42);
+    assert.equal(state.buyPot, 5000);
+    assert.equal(state.roundHigh, 1.35);
+    assert.equal(state.lastSequence, 42);
+    await h.svc.onModuleDestroy();
+});
