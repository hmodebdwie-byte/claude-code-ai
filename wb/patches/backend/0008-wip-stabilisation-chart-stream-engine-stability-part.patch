+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { invalidateNpcEngineModeCache, isOrganicNpcEngineMode, readNpcEngineModeFromRedis } from './engine-mode.redis';
+import { NPC_ENGINE_MODE_REDIS_KEY } from './redis-keys';
+import { NPC_ENGINE_MODE_SETTING_KEY } from './settings';
+
+test('engine mode: Redis value wins and the DB is not consulted', async () => {
+    invalidateNpcEngineModeCache();
+    let dbReads = 0;
+    const mode = await readNpcEngineModeFromRedis(async () => 'legacy', { dbFallback: async () => { dbReads++; return 'organic'; } });
+    assert.equal(mode, 'legacy');
+    assert.equal(dbReads, 0);
+});
+
+test('engine mode: missing Redis key falls back to the DB row and mirrors it back', async () => {
+    invalidateNpcEngineModeCache();
+    const mirrored: Array<[string, string]> = [];
+    let askedKey = '';
+    const mode = await readNpcEngineModeFromRedis(async () => null, {
+        dbFallback: async (k) => { askedKey = k; return 'legacy'; },
+        mirror: async (k, v) => { mirrored.push([k, v]); },
+    });
+    assert.equal(mode, 'legacy');
+    assert.equal(askedKey, NPC_ENGINE_MODE_SETTING_KEY);
+    assert.deepEqual(mirrored, [[NPC_ENGINE_MODE_REDIS_KEY, 'legacy']]);
+    invalidateNpcEngineModeCache();
+    assert.equal(await isOrganicNpcEngineMode(async () => null, { dbFallback: async () => 'legacy' }), false);
+});
+
+test('engine mode: no Redis key and no DB row defaults to organic; DB errors are swallowed', async () => {
+    invalidateNpcEngineModeCache();
+    assert.equal(await readNpcEngineModeFromRedis(async () => null, { dbFallback: async () => null }), 'organic');
+    invalidateNpcEngineModeCache();
+    assert.equal(await readNpcEngineModeFromRedis(async () => '', { dbFallback: async () => { throw new Error('db down'); } }), 'organic');
+    invalidateNpcEngineModeCache();
+});
