diff --git a/apps/engine/src/npc/npc-force-win-precedence.spec.ts b/apps/engine/src/npc/npc-force-win-precedence.spec.ts
new file mode 100644
index 0000000..6d004e7
--- /dev/null
+++ b/apps/engine/src/npc/npc-force-win-precedence.spec.ts
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { NpcSimulatorService } from './npc-simulator.service';
+
+/**
+ * BUG-5 regression: saving the NPC Behavior pace (which creates the
+ * `npc_behavior_preset` row, even for "normal" = '') used to force
+ * `forceNpcWinEnable = true` and silently ignore an explicit
+ * `npc_force_win_enable = 0` forever. Force-win / counter-win injects NPC
+ * volume to flip pots at close, so the explicit row must be authoritative.
+ */
+function makeService() {
+    const prisma: any = {};
+    const snapshotPublisher: any = { publish: async () => {} };
+    const redisPublisher: any = { publish: async () => {} };
+    const redisState: any = { getLastPrice: async () => 1 };
+    const marketConfigCache: any = { getFreezeSeconds: async () => 20 };
+    return new NpcSimulatorService(prisma, snapshotPublisher, redisPublisher, redisState, marketConfigCache) as any;
+}
+
+type Row = { settingKey: string; settingValue: string | null };
+
+test('explicit npc_force_win_enable=0 wins over the pace preset row', () => {
+    const svc = makeService();
+    const rows: Row[] = [
+        { settingKey: 'npc_behavior_preset', settingValue: '' }, // "normal" as the admin stores it
+        { settingKey: 'npc_force_win_enable', settingValue: '0' },
+    ];
+    svc.applyNpcPaceOutcomeStrategy(rows);
+    assert.equal(svc.forceNpcWinEnable, false);
+    assert.equal(svc.npcPaceTier, 'normal');
+});
+
+test('explicit npc_force_win_enable=false (string) also wins, for calm and intense', () => {
+    for (const preset of ['calm', 'intense']) {
+        const svc = makeService();
+        svc.applyNpcPaceOutcomeStrategy([
+            { settingKey: 'npc_behavior_preset', settingValue: preset },
+            { settingKey: 'npc_force_win_enable', settingValue: 'false' },
+        ] as Row[]);
+        assert.equal(svc.forceNpcWinEnable, false, preset);
+        assert.equal(svc.npcPaceTier, preset);
+    }
+});
+
+test('explicit npc_force_win_enable=1 stays ON with any preset', () => {
+    const svc = makeService();
+    svc.forceNpcWinEnable = false;
+    svc.applyNpcPaceOutcomeStrategy([
+        { settingKey: 'npc_behavior_preset', settingValue: 'calm' },
+        { settingKey: 'npc_force_win_enable', settingValue: '1' },
+    ] as Row[]);
+    assert.equal(svc.forceNpcWinEnable, true);
+});
+
+test('without an explicit row the preset keeps the default (ON) — unchanged behaviour', () => {
+    const svc = makeService();
+    svc.forceNpcWinEnable = false; // simulate a stale in-memory value
+    svc.applyNpcPaceOutcomeStrategy([{ settingKey: 'npc_behavior_preset', settingValue: 'intense' }] as Row[]);
+    assert.equal(svc.forceNpcWinEnable, true);
+});
+
+test('without a preset row nothing is touched (refreshConfig loop already applied the explicit row)', () => {
+    const svc = makeService();
+    svc.forceNpcWinEnable = false;
+    svc.applyNpcPaceOutcomeStrategy([{ settingKey: 'npc_force_win_enable', settingValue: '1' }] as Row[]);
+    assert.equal(svc.forceNpcWinEnable, false);
+});
