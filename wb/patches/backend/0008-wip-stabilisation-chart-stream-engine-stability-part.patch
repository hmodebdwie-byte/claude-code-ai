@@ -0,0 +1,97 @@
+/**
+ * Test support: replaces `redis/redis.client` for every module loaded after
+ * {@link installRedisClientMock} so specs can exercise engine services without
+ * a live Redis (`battle.state.ts` opens the shared connection at import time).
+ * Not part of the runtime build path — only spec files import it.
+ */
+import Module from 'node:module';
+
+export type FakeRedis = {
+    calls: Array<{ cmd: string; args: unknown[] }>;
+    store: Map<string, string>;
+    get(key: string): Promise<string | null>;
+    set(key: string, value: string, ...rest: unknown[]): Promise<'OK'>;
+    del(...keys: string[]): Promise<number>;
+    exists(key: string): Promise<number>;
+    eval(script: string, numKeys: number, ...args: unknown[]): Promise<unknown>;
+    zcard(key: string): Promise<number>;
+    lrange(key: string, start: number, stop: number): Promise<string[]>;
+    publish(channel: string, message: string): Promise<number>;
+    multi(): { get(k: string): unknown; hgetall(k: string): unknown; exec(): Promise<null> };
+    quit(): Promise<'OK'>;
+    evalResult: unknown;
+    zcardResult: number;
+};
+
+export function createFakeRedis(): FakeRedis {
+    const fake: FakeRedis = {
+        calls: [],
+        store: new Map(),
+        evalResult: 0,
+        zcardResult: 0,
+        async get(key) {
+            fake.calls.push({ cmd: 'get', args: [key] });
+            return fake.store.get(key) ?? null;
+        },
+        async set(key, value, ...rest) {
+            fake.calls.push({ cmd: 'set', args: [key, value, ...rest] });
+            fake.store.set(key, value);
+            return 'OK';
+        },
+        async del(...keys) {
+            fake.calls.push({ cmd: 'del', args: keys });
+            let n = 0;
+            for (const k of keys) if (fake.store.delete(k)) n++;
+            return n;
+        },
+        async exists(key) {
+            return fake.store.has(key) ? 1 : 0;
+        },
+        async eval(script, numKeys, ...args) {
+            fake.calls.push({ cmd: 'eval', args: [script, numKeys, ...args] });
+            return fake.evalResult;
+        },
+        async zcard(key) {
+            fake.calls.push({ cmd: 'zcard', args: [key] });
+            return fake.zcardResult;
+        },
+        async lrange() {
+            return [];
+        },
+        async publish(channel, message) {
+            fake.calls.push({ cmd: 'publish', args: [channel, message] });
+            return 1;
+        },
+        multi() {
+            return { get: () => undefined, hgetall: () => undefined, exec: async () => null };
+        },
+        async quit() {
+            return 'OK';
+        },
+    };
+    return fake;
+}
+
+let installed: { fake: FakeRedis; restore: () => void } | null = null;
+
+/** Install once per test file, BEFORE requiring the module under test. */
+export function installRedisClientMock(): FakeRedis {
+    if (installed) return installed.fake;
+    const fake = createFakeRedis();
+    const mockModule = {
+        getSharedCommandRedis: () => fake,
+        getSharedSubscriberRedis: () => fake,
+        getTimerPublishRedis: () => fake,
+        createRedisClient: () => fake,
+        buildRedisOptions: () => ({}),
+        shutdownSharedRedisConnections: async () => undefined,
+    };
+    const m = Module as unknown as { _load: (request: string, parent: unknown, isMain: boolean) => unknown };
+    const origLoad = m._load;
+    m._load = function (request: string, parent: unknown, isMain: boolean) {
+        if (/(^|[\\/])redis\.client$/.test(request)) return mockModule;
+        return origLoad.call(this, request, parent, isMain);
+    };
+    installed = { fake, restore: () => (m._load = origLoad) };
+    return fake;
+}
