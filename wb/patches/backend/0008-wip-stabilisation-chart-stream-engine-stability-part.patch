@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    invalidateLiveProjectionMemo,
+    liveProjectionMemoKey,
+    liveProjectionMemoSize,
+    liveProjectionPotSignature,
+    liveProjectionPriceBucket,
+    memoizeLiveProjection,
+} from './live-projection-memo';
+
+test('memoizeLiveProjection shares one computation per key within the TTL', async () => {
+    invalidateLiveProjectionMemo();
+    let calls = 0;
+    const compute = async () => {
+        calls += 1;
+        await new Promise((r) => setTimeout(r, 5));
+        return { calls };
+    };
+    const key = liveProjectionMemoKey('t', 1, 1.23456, { buyPot: 100, sellPot: 50 });
+    const [a, b] = await Promise.all([
+        memoizeLiveProjection(key, 1, compute, 500),
+        memoizeLiveProjection(key, 1, compute, 500),
+    ]);
+    const c = await memoizeLiveProjection(key, 1, compute, 500);
+    assert.equal(calls, 1, 'concurrent + subsequent callers share one compute');
+    assert.equal(a, b);
+    assert.equal(b, c);
+});
+
+test('memoizeLiveProjection expires after the TTL and is dropped by battle invalidation', async () => {
+    invalidateLiveProjectionMemo();
+    let calls = 0;
+    const compute = async () => ++calls;
+    const key = liveProjectionMemoKey('t', 7, 1.1, null);
+    await memoizeLiveProjection(key, 7, compute, 20);
+    await new Promise((r) => setTimeout(r, 35));
+    await memoizeLiveProjection(key, 7, compute, 20);
+    assert.equal(calls, 2, 'recomputed after expiry');
+    assert.ok(liveProjectionMemoSize() >= 1);
+    invalidateLiveProjectionMemo(7);
+    await memoizeLiveProjection(key, 7, compute, 500);
+    assert.equal(calls, 3, 'recomputed after battle invalidation');
+});
+
+test('a rejected compute is not cached', async () => {
+    invalidateLiveProjectionMemo();
+    let calls = 0;
+    const key = liveProjectionMemoKey('t', 9, 1, null);
+    await assert.rejects(
+        memoizeLiveProjection(key, 9, async () => {
+            calls += 1;
+            throw new Error('boom');
+        }),
+    );
+    const v = await memoizeLiveProjection(key, 9, async () => ++calls);
+    assert.equal(v, 2);
+});
+
+test('price bucket and pot signature quantise as documented', () => {
+    assert.equal(liveProjectionPriceBucket(1.234567), '1.23457');
+    assert.equal(liveProjectionPriceBucket(Number.NaN), 'nan');
+    // 0.5 % of 200,000 = 1,000 per step: a $300 NPC nudge stays in the bucket.
+    const a = liveProjectionPotSignature({ buyPot: 150_000, sellPot: 50_000 });
+    const b = liveProjectionPotSignature({ buyPot: 150_300, sellPot: 50_000 });
+    assert.equal(a, b);
+    // A 5 % move does not.
+    const c = liveProjectionPotSignature({ buyPot: 160_000, sellPot: 50_000 });
+    assert.notEqual(a, c);
+    assert.equal(liveProjectionPotSignature(null), 'db');
+});
diff --git a/packages/shared/src/payout/live-projection-memo.ts b/packages/shared/src/payout/live-projection-memo.ts
new file mode 100644
index 0000000..5752fca
--- /dev/null
+++ b/packages/shared/src/payout/live-projection-memo.ts
@@ -0,0 +1,177 @@
+/**
+ * Shared, short-lived memo for live payout projections.
+ *
+ * The API recomputed `computeLiveProjectedSettlementPayouts` (stakes + NPC
+ * volumes + price path + `computePayouts`) independently for the trading
+ * dashboard, the active-trade stream, the balance/equity snapshot, the Market
+ * Flip endpoint and the estimate endpoint — several times per second per
+ * battle for the same price and the same pots. One memo keyed by
+ * `battleId | price bucket | pot signature` (plus the option flags that change
+ * the maths) lets every consumer share one computation per ~750 ms.
+ *
+ * Display-only: settlement never reads from here.
+ */
+import {
+    computeLiveProjectedSettlementPayouts,
+    type LiveSettlementProjectionOpts,
+    type SettlementLiveProjection,
+} from './battle-payout.live';
+
+type Db = any;
+
+type MemoEntry = {
+    battleId: number;
+    value: unknown;
+    expiresAtMs: number;
+};
+
+const DEFAULT_TTL_MS = 750;
+const MAX_ENTRIES = 500;
+
+const memo = new Map<string, MemoEntry>();
+const inFlight = new Map<string, Promise<unknown>>();
+
+/** TTL for memoised live projections (ms). Env `LIVE_PROJECTION_MEMO_TTL_MS`, default 750. */
+export function liveProjectionMemoTtlMs(): number {
+    const n = Number.parseInt(process.env.LIVE_PROJECTION_MEMO_TTL_MS ?? '', 10);
+    return Number.isFinite(n) && n >= 100 ? Math.min(n, 5_000) : DEFAULT_TTL_MS;
+}
+
+/** Price bucket used in memo keys: 5 decimals, the same rounding the WS price path uses. */
+export function liveProjectionPriceBucket(price: number): string {
+    const n = Number(price);
+    return Number.isFinite(n) ? (Math.round(n * 1e5) / 1e5).toFixed(5) : 'nan';
+}
+
+/**
+ * Pot signature used in memo keys. Pots are quantised to 0.5 % of the total
+ * pot (never below $1) so NPC churn of a few dollars on a large pot reuses the
+ * memo while a material move always misses it.
+ */
+export function liveProjectionPotSignature(
+    pots?: { buyPot: number; sellPot: number } | null,
+): string {
+    if (!pots) return 'db';
+    const buy = Number(pots.buyPot) || 0;
+    const sell = Number(pots.sellPot) || 0;
+    // Step = the power of ten at or below 0.5 % of the total pot, so the
+    // quantisation grid does not itself drift with every small pot move.
+    const raw = Math.max(1, (buy + sell) * 0.005);
+    const step = 10 ** Math.floor(Math.log10(raw));
+    return `${Math.round(buy / step)}:${Math.round(sell / step)}@${step}`;
+}
+
+export function liveProjectionMemoKey(
+    kind: string,
+    battleId: number,
+    price: number,
+    pots?: { buyPot: number; sellPot: number } | null,
+    extra: string = '',
+): string {
+    return `${kind}|${battleId}|${liveProjectionPriceBucket(price)}|${liveProjectionPotSignature(pots)}|${extra}`;
+}
+
+function evictIfNeeded(): void {
+    if (memo.size <= MAX_ENTRIES) return;
+    const now = Date.now();
+    for (const [k, v] of memo) {
+        if (v.expiresAtMs <= now) memo.delete(k);
+    }
+    while (memo.size > MAX_ENTRIES) {
+        const first = memo.keys().next();
+        if (first.done) return;
+        memo.delete(first.value);
+    }
+}
+
+/**
+ * Memoise `compute` under `key` for `ttlMs` (default {@link liveProjectionMemoTtlMs}).
+ * Concurrent callers with the same key share one in-flight promise. A rejected
+ * compute is not cached.
+ */
+export async function memoizeLiveProjection<T>(
+    key: string,
+    battleId: number,
+    compute: () => Promise<T>,
+    ttlMs: number = liveProjectionMemoTtlMs(),
+): Promise<T> {
+    const now = Date.now();
+    const hit = memo.get(key);
+    if (hit && hit.expiresAtMs > now) {
+        return hit.value as T;
+    }
+    const pending = inFlight.get(key);
+    if (pending) {
+        return pending as Promise<T>;
+    }
+    let promise: Promise<T> | undefined;
+    promise = (async () => {
+        try {
+            const value = await compute();
+            memo.set(key, { battleId, value, expiresAtMs: Date.now() + ttlMs });
+            evictIfNeeded();
+            return value;
+        } finally {
+            if (inFlight.get(key) === promise) inFlight.delete(key);
+        }
+    })();
+    inFlight.set(key, promise);
+    return promise;
+}
+
+/** Drop memo entries for one battle (battle end / settlement) or everything. */
+export function invalidateLiveProjectionMemo(battleId?: number): void {
+    if (battleId == null) {
+        memo.clear();
+        return;
+    }
+    for (const [k, v] of memo) {
+        if (v.battleId === battleId) memo.delete(k);
+    }
+}
+
+/** Number of live memo entries — for tests and diagnostics. */
+export function liveProjectionMemoSize(): number {
+    return memo.size;
+}
+
+function optsSignature(opts?: LiveSettlementProjectionOpts): string {
+    if (!opts) return 'o:';
+    return [
+        'o:',
+        opts.npcSimulatorActive ? 'npc1' : 'npc0',
+        opts.humanDisplayOnly ? 'h1' : 'h0',
+        opts.hedgeRefundEnabled ? 'hr1' : 'hr0',
+        opts.redis ? 'r1' : 'r0',
+        opts.roundHighOverride != null ? `rh${opts.roundHighOverride}` : '',
+        opts.roundLowOverride != null ? `rl${opts.roundLowOverride}` : '',
+    ].join(',');
+}
+
+/**
+ * Drop-in for {@link computeLiveProjectedSettlementPayouts} that shares the
+ * result across callers for the memo TTL. Same inputs (battle, price bucket,
+ * pots, option flags) → same projection object. Callers must treat the
+ * returned maps/sets as read-only.
+ */
+export async function computeLiveProjectedSettlementPayoutsMemoized(
+    prisma: Db,
+    battleId: number,
+    currentPrice: number,
+    opts?: LiveSettlementProjectionOpts,
+    ttlMs?: number,
+): Promise<SettlementLiveProjection> {
+    const key = liveProjectionMemoKey(
+        'proj',
+        battleId,
+        currentPrice,
+        opts?.livePots ?? null,
+        optsSignature(opts),
+    );
+    return memoizeLiveProjection(
+        key,
+        battleId,
+        () => computeLiveProjectedSettlementPayouts(prisma, battleId, currentPrice, opts),
+        ttlMs,
+    );
+}
