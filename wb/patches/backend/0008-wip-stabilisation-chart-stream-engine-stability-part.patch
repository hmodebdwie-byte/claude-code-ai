+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    DEFAULT_NPC_ROTATION_SETTINGS,
+    NpcRotationReasonCode,
+    isWithinAllowedWindow,
+    pickRoundRobinFromRoster,
+    selectNpc,
+    type NpcRotationCandidate,
+    type NpcRotationSettings,
+} from './npc-rotation';
+import { filterNpcIdsForSelection, resolveNpcSelection } from './npc-selection-gate';
+
+function settings(over: Partial<NpcRotationSettings> = {}): NpcRotationSettings {
+    return {
+        ...DEFAULT_NPC_ROTATION_SETTINGS,
+        enabled: true,
+        windowFrom: '00:00',
+        windowTo: '00:00', // always open
+        minDistinct: 0,
+        ...over,
+    };
+}
+
+function cands(ids: number[], last?: Record<number, number>): NpcRotationCandidate[] {
+    return ids.map((npcId) => ({ npcId, aggressiveness: 50, lastParticipatedAtMs: last?.[npcId] ?? null }));
+}
+
+const firstId = (ids: number[]) => ids[0] ?? null;
+
+test('rotation disabled: cap-free fallback pick, not starved', () => {
+    const r = resolveNpcSelection({ candidates: cands([3, 4]), settings: settings({ enabled: false }), fallbackPick: firstId });
+    assert.deepEqual(r, { npcId: 3, starved: false, relaxed: false, reason: 'rotation_disabled' });
+});
+
+test('eligible candidates are picked through the strategy and caps are honoured', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([
+        [1, NpcRotationReasonCode.COOLDOWN],
+        [2, NpcRotationReasonCode.ELIGIBLE],
+        [3, NpcRotationReasonCode.DAILY_CAP],
+    ]);
+    const r = resolveNpcSelection({
+        candidates: cands([1, 2, 3]),
+        settings: settings({ strategy: 'weighted_random' }),
+        eligibilityByNpc: eligibility,
+        fallbackPick: () => { throw new Error('fallback must not run'); },
+    });
+    assert.equal(r.npcId, 2);
+    assert.equal(r.starved, false);
+    assert.equal(r.reason, 'rotation');
+});
+
+test('starvation under policy=relax falls back (cap-free) and reports starved', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.COOLDOWN], [2, NpcRotationReasonCode.COOLDOWN]]);
+    let fallbackIds: number[] = [];
+    const r = resolveNpcSelection({
+        candidates: cands([1, 2]),
+        settings: settings({ starvationPolicy: 'relax' }),
+        eligibilityByNpc: eligibility,
+        fallbackPick: (ids) => { fallbackIds = ids; return 2; },
+    });
+    assert.deepEqual(r, { npcId: 2, starved: true, relaxed: true, reason: 'starved' });
+    assert.deepEqual(fallbackIds, [1, 2], 'fallback still sees only side-eligible candidates');
+});
+
+test('starvation under policy=pause returns null for organic producers', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.HARD_FLOOR]]);
+    const r = resolveNpcSelection({
+        candidates: cands([1]),
+        settings: settings({ starvationPolicy: 'pause' }),
+        eligibilityByNpc: eligibility,
+        purpose: 'organic',
+        fallbackPick: () => { throw new Error('organic pause must not fall back'); },
+    });
+    assert.deepEqual(r, { npcId: null, starved: true, relaxed: false, reason: 'starved' });
+});
+
+test('defense purpose never starves even under policy=pause (house protection keeps working)', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.MONTHLY_CAP]]);
+    const r = resolveNpcSelection({
+        candidates: cands([1]),
+        settings: settings({ starvationPolicy: 'pause' }),
+        eligibilityByNpc: eligibility,
+        purpose: 'defense',
+        fallbackPick: firstId,
+    });
+    assert.deepEqual(r, { npcId: 1, starved: true, relaxed: true, reason: 'starved' });
+});
+
+test('bypassCaps skips window and caps entirely (side lock is still the caller\'s input)', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.COOLDOWN]]);
+    const r = resolveNpcSelection({
+        candidates: cands([1]),
+        settings: settings({ starvationPolicy: 'pause', windowFrom: '09:00', windowTo: '10:00' }),
+        eligibilityByNpc: eligibility,
+        now: new Date('2026-01-01T03:00:00Z'),
+        bypassCaps: true,
+        fallbackPick: firstId,
+    });
+    assert.deepEqual(r, { npcId: 1, starved: false, relaxed: false, reason: 'bypass' });
+});
+
+test('closed window: pause → null for organic, relax → fallback; evaluated with the timezone offset', () => {
+    const base = { candidates: cands([1, 2]), fallbackPick: firstId, now: new Date('2026-01-01T03:00:00Z') };
+    // 03:00 UTC is outside 09:00-17:00 UTC …
+    const closed = resolveNpcSelection({ ...base, settings: settings({ windowFrom: '09:00', windowTo: '17:00', starvationPolicy: 'pause', timezoneOffsetMinutes: 0 }) });
+    assert.deepEqual(closed, { npcId: null, starved: true, relaxed: false, reason: 'outside_window' });
+    const relaxed = resolveNpcSelection({ ...base, settings: settings({ windowFrom: '09:00', windowTo: '17:00', starvationPolicy: 'relax', timezoneOffsetMinutes: 0 }) });
+    assert.deepEqual(relaxed, { npcId: 1, starved: true, relaxed: true, reason: 'outside_window' });
+    // … but inside it at UTC+7 (10:00 local).
+    const open = resolveNpcSelection({ ...base, settings: settings({ windowFrom: '09:00', windowTo: '17:00', starvationPolicy: 'pause', timezoneOffsetMinutes: 420 }) });
+    assert.equal(open.reason, 'rotation');
+    assert.ok(open.npcId != null);
+});
+
+test('isWithinAllowedWindow: 22:30Z at UTC+3 is 01:30 (outside 08-22) and UTC-3 is 19:30 (inside)', () => {
+    const at = new Date('2026-06-15T22:30:00Z');
+    assert.equal(isWithinAllowedWindow(at, '08:00', '22:00', 180), false);
+    assert.equal(isWithinAllowedWindow(at, '08:00', '22:00', -180), true);
+});
+
+test('least_recently_used picks the oldest real participation clock, unknown clocks first', () => {
+    const c = cands([1, 2, 3], { 1: 5_000, 2: 1_000 });
+    assert.equal(selectNpc(c, 'least_recently_used', () => 0)?.npcId, 3, 'never-participated wins');
+    const c2 = cands([1, 2], { 1: 5_000, 2: 1_000 });
+    assert.equal(selectNpc(c2, 'least_recently_used', () => 0)?.npcId, 2, 'oldest clock wins');
+});
+
+test('round_robin with a shared cursor walks the full roster and skips ineligible ids', () => {
+    const roster = [10, 20, 30, 40];
+    assert.equal(pickRoundRobinFromRoster(roster, [10, 30], 0), 10);
+    assert.equal(pickRoundRobinFromRoster(roster, [10, 30], 1), 30, 'cursor 1 → 20 is ineligible → 30');
+    assert.equal(pickRoundRobinFromRoster(roster, [10, 30], 3), 10, 'wraps around');
+    assert.equal(pickRoundRobinFromRoster(roster, [], 0), null);
+    const c = cands([10, 30]);
+    const picked = selectNpc(c, 'round_robin', Math.random, { roundRobinCursor: 5, rosterIds: roster });
+    assert.equal(picked?.npcId, 30, 'cursor 5 % 4 = 1 → 20 skipped → 30');
+});
+
+test('min-distinct guard excludes recently used NPCs before the strategy runs', () => {
+    const r = resolveNpcSelection({
+        candidates: cands([1, 2, 3, 4, 5]),
+        settings: settings({ minDistinct: 3, strategy: 'least_recently_used' }),
+        recentIds: [1, 2, 3],
+        fallbackPick: firstId,
+        random: () => 0,
+    });
+    assert.ok(r.npcId === 4 || r.npcId === 5);
+});
+
+test('filterNpcIdsForSelection: batch form applies window/eligibility with the same starvation policy', () => {
+    const eligibility = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.COOLDOWN], [2, NpcRotationReasonCode.ELIGIBLE]]);
+    assert.deepEqual(filterNpcIdsForSelection({ ids: [1, 2], settings: settings(), eligibilityByNpc: eligibility }), { ids: [2], starved: false, reason: 'rotation' });
+    const allCapped = new Map<number, NpcRotationReasonCode>([[1, NpcRotationReasonCode.COOLDOWN], [2, NpcRotationReasonCode.COOLDOWN]]);
+    assert.deepEqual(filterNpcIdsForSelection({ ids: [1, 2], settings: settings({ starvationPolicy: 'relax' }), eligibilityByNpc: allCapped }), { ids: [1, 2], starved: true, reason: 'starved' });
+    assert.deepEqual(filterNpcIdsForSelection({ ids: [1, 2], settings: settings({ starvationPolicy: 'pause' }), eligibilityByNpc: allCapped }), { ids: [], starved: true, reason: 'starved' });
+    assert.deepEqual(filterNpcIdsForSelection({ ids: [1, 2], settings: settings({ starvationPolicy: 'pause' }), eligibilityByNpc: allCapped, purpose: 'defense' }), { ids: [1, 2], starved: true, reason: 'starved' });
+    assert.deepEqual(filterNpcIdsForSelection({ ids: [1, 2], settings: settings({ enabled: false }), eligibilityByNpc: allCapped }), { ids: [1, 2], starved: false, reason: 'rotation_disabled' });
+});
