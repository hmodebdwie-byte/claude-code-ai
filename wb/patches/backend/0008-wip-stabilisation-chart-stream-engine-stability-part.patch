@@ -0,0 +1,108 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    isNpcSimulatorDesiredActive,
+    resolveNpcSimulatorDesiredActive,
+    NPC_SIMULATOR_ACTIVE_OFF,
+    NPC_SIMULATOR_ACTIVE_ON,
+    pushNpcRecentTrade,
+    readNpcRecentTrades,
+    NPC_RECENT_TRADES_MAX,
+    NPC_RECENT_TRADES_REDIS_KEY,
+} from './npc-simulator.redis';
+
+// --- default OFF ---------------------------------------------------------
+
+test('missing / empty Redis flag means OFF (never silently re-enables NPC trading)', () => {
+    assert.equal(isNpcSimulatorDesiredActive(null), false);
+    assert.equal(isNpcSimulatorDesiredActive(undefined), false);
+    assert.equal(isNpcSimulatorDesiredActive(''), false);
+});
+
+test('explicit flag values keep their meaning', () => {
+    assert.equal(isNpcSimulatorDesiredActive(NPC_SIMULATOR_ACTIVE_ON), true);
+    assert.equal(isNpcSimulatorDesiredActive(NPC_SIMULATOR_ACTIVE_OFF), false);
+});
+
+test('resolver: Redis mirror wins when present', () => {
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: '1', dbRaw: '0' }), { active: true, source: 'redis' });
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: '0', dbRaw: '1' }), { active: false, source: 'redis' });
+});
+
+test('resolver: missing Redis key falls back to the DB row', () => {
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: null, dbRaw: '1' }), { active: true, source: 'db' });
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: '', dbRaw: '0' }), { active: false, source: 'db' });
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: undefined, dbRaw: 'true' }), { active: true, source: 'db' });
+});
+
+test('resolver: no Redis key and no DB row is OFF by default', () => {
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: null, dbRaw: null }), { active: false, source: 'default' });
+    assert.deepEqual(resolveNpcSimulatorDesiredActive({ redisRaw: '', dbRaw: '' }), { active: false, source: 'default' });
+});
+
+// --- recent trades ring --------------------------------------------------
+
+function fakeListRedis() {
+    const lists = new Map<string, string[]>();
+    const calls: string[] = [];
+    return {
+        lists,
+        calls,
+        async lpush(key: string, ...values: string[]) {
+            calls.push('lpush');
+            const l = lists.get(key) ?? [];
+            lists.set(key, [...values.reverse(), ...l]);
+            return lists.get(key)!.length;
+        },
+        async ltrim(key: string, start: number, stop: number) {
+            calls.push(`ltrim:${start}:${stop}`);
+            const l = lists.get(key) ?? [];
+            lists.set(key, l.slice(start, stop + 1));
+            return 'OK';
+        },
+        async expire() {
+            calls.push('expire');
+            return 1;
+        },
+        async lrange(key: string, start: number, stop: number) {
+            const l = lists.get(key) ?? [];
+            return l.slice(start, stop + 1);
+        },
+    };
+}
+
+test('recent trades ring keeps the newest 50 fills, newest first', async () => {
+    const redis = fakeListRedis();
+    for (let i = 1; i <= 60; i++) {
+        await pushNpcRecentTrade(redis, {
+            at: new Date(i * 1000).toISOString(),
+            battle_id: 7,
+            npc_id: i,
+            username: `npc${i}`,
+            side: i % 2 ? 'BUY' : 'SELL',
+            amount: i,
+            source: i % 3 ? 'legacy' : 'organic',
+            reason: 'spec',
+        });
+    }
+    const list = redis.lists.get(NPC_RECENT_TRADES_REDIS_KEY)!;
+    assert.equal(list.length, NPC_RECENT_TRADES_MAX);
+    assert.ok(redis.calls.includes(`ltrim:0:${NPC_RECENT_TRADES_MAX - 1}`));
+    const read = await readNpcRecentTrades(redis);
+    assert.equal(read.length, 50);
+    assert.equal(read[0]!.npc_id, 60);
+    assert.equal(read[49]!.npc_id, 11);
+    assert.equal(read[0]!.side, 'SELL');
+});
+
+test('recent trades reader drops malformed entries and never throws', async () => {
+    const redis = fakeListRedis();
+    redis.lists.set(NPC_RECENT_TRADES_REDIS_KEY, ['not json', JSON.stringify({ battle_id: 'x' }), JSON.stringify({ battle_id: 1, npc_id: 2, side: 'SELL', amount: '3.5' })]);
+    const read = await readNpcRecentTrades(redis);
+    assert.equal(read.length, 1);
+    assert.equal(read[0]!.username, 'NPC #2');
+    assert.equal(read[0]!.amount, 3.5);
+    assert.equal(read[0]!.source, 'legacy');
+    const broken = { lrange: async () => { throw new Error('down'); } };
+    assert.deepEqual(await readNpcRecentTrades(broken), []);
+});
