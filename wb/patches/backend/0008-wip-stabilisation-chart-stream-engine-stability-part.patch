+
+/**
+ * Per-battle scratch key used by {@link countBattleLeaderboardUsers}. The Lua
+ * script deletes it in the same call, so it never outlives the command.
+ */
+export function battleLeaderboardUnionScratchKey(battleId: number): string {
+    return `lb:battle:${battleId}:users:union:tmp`;
+}
+
+/**
+ * ZUNIONSTORE both real-user sides into a scratch key, ZCARD it and DEL it —
+ * all inside one Lua call, so the count is exact (a user on both sides counts
+ * once) and no member list is ever transferred to the caller.
+ */
+export const BATTLE_LEADERBOARD_COUNT_USERS_LUA = `
+local n = redis.call('ZUNIONSTORE', KEYS[3], 2, KEYS[1], KEYS[2])
+redis.call('DEL', KEYS[3])
+return n
+`;
+
+/**
+ * Distinct real users that traded this round (either side), computed server-side.
+ * Replaces `listBattleLeaderboardUserIds(...).length` on hot paths — the old
+ * approach shipped both full ZSETs to the caller up to 5×/s just to count them.
+ */
+export async function countBattleLeaderboardUsers(
+    redis: RedisLeaderboardCountClient,
+    battleId: number,
+): Promise<number> {
+    const n = await redis.eval(
+        BATTLE_LEADERBOARD_COUNT_USERS_LUA,
+        3,
+        battleLeaderboardUserKey(battleId, 'BUY'),
+        battleLeaderboardUserKey(battleId, 'SELL'),
+        battleLeaderboardUnionScratchKey(battleId),
+    );
+    const count = Number(n);
+    return Number.isFinite(count) && count > 0 ? count : 0;
+}
