+/**
+ * Behavioural specs for the C1 continuous `all` candle stream in LineChartGateway.
+ * Timers are disabled (DISABLE_WS_GATEWAY_TIMERS) and the boundary closer is driven by hand
+ * under a fake clock, with Redis/Prisma/publisher replaced by in-memory fakes.
+ */
+process.env.DISABLE_WS_GATEWAY_TIMERS = 'true';
+
+import { LineChartGateway } from './line-chart.gateway';
+import { BUCKET_MS, CANDLE_BATCH_WINDOW_SECONDS } from '../chart/candle-types';
+
+type Published = { room: string; event: string; payload: Record<string, any> };
+
+const T0 = Date.UTC(2026, 0, 1, 12, 0, 0);
+
+function makeGateway() {
+    const published: Published[] = [];
+    let active: any = null;
+    const coordinator = { isLeader: () => true };
+    const redisState = {
+        getActiveCandle: jest.fn(async () => active),
+        setActiveCandle: jest.fn(async (s: any) => {
+            active = s;
+        }),
+        clearActiveCandle: jest.fn(async () => {
+            active = null;
+        }),
+    };
+    const publisher = {
+        publish: jest.fn(async (_channel: string, message: any) => {
+            published.push(message);
+        }),
+    };
+    const prisma = {
+        battle: { findFirst: jest.fn(async () => null) },
+        priceTick: { findFirst: jest.fn(async () => null), findMany: jest.fn(async () => []) },
+    };
+    const gw = new LineChartGateway(
+        coordinator as any,
+        redisState as any,
+        publisher as any,
+        prisma as any,
+        {} as any,
+    );
+    // No Redis in tests: memory paths only.
+    (gw as any).redis = null;
+    return { gw, published, prisma, redisState };
+}
+
+function closedAll(published: Published[]) {
+    return published.filter((m) => m.room === 'line_chart_all' && m.event === 'candleClosed').map((m) => m.payload);
+}
+
+describe('LineChartGateway continuous all stream (C1)', () => {
+    let nowMs = T0;
+    let nowSpy: jest.SpyInstance<number, []>;
+
+    beforeEach(() => {
+        nowMs = T0;
+        nowSpy = jest.spyOn(Date, 'now').mockImplementation(() => nowMs);
+    });
+    afterEach(() => {
+        nowSpy.mockRestore();
+    });
+
+    const tick = (gw: LineChartGateway, battleId: number, price: number, volume: number, atMs: number) => {
+        nowMs = atMs;
+        gw.handlePriceTick({ battle_id: battleId, price, timestamp: atMs, volumeScale: volume });
+    };
+    const boundary = (gw: LineChartGateway, atMs: number) => {
+        nowMs = atMs;
+        (gw as any).closeCandlesAtBoundary();
+    };
+
+    it('closes exactly one candle per second, flat (volume 0, count 0) when nothing traded, and keeps ticking through cooldown with battle_id null', async () => {
+        const { gw, published } = makeGateway();
+        tick(gw, 7, 1.25, 1000, T0 + 100);
+        tick(gw, 7, 1.26, 500, T0 + 600);
+        boundary(gw, T0 + 1000); // closes bucket T0
+        boundary(gw, T0 + 2000); // flat bucket T0+1s (battle still active)
+        await gw.archiveBattleCandleHistory(7); // battle.end → cooldown
+        boundary(gw, T0 + 3000); // flat, idle second
+        boundary(gw, T0 + 4000); // flat, idle second
+
+        const closed = closedAll(published);
+        expect(closed.map((c) => c.timestamp)).toEqual([T0 / 1000, T0 / 1000 + 1, T0 / 1000 + 2, T0 / 1000 + 3]);
+        expect(closed[0]).toMatchObject({ open: 1.25, high: 1.26, low: 1.25, close: 1.26, volume: 1500, count: 2, battle_id: 7 });
+        expect(closed[1]).toMatchObject({ open: 1.26, close: 1.26, volume: 0, count: 0, battle_id: 7 });
+        expect(closed[2]).toMatchObject({ close: 1.26, volume: 0, count: 0, battle_id: null });
+        expect(closed[3]).toMatchObject({ close: 1.26, volume: 0, count: 0, battle_id: null });
+        // server_time is the server clock in epoch MILLISECONDS
+        expect(closed[3].server_time).toBe(T0 + 4000);
+        expect(gw.getActiveBattleId()).toBeNull();
+    });
+
