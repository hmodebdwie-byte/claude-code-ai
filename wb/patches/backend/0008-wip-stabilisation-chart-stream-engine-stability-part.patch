+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { EngineLeaderService } from './engine-leader.service';
+
+function fakeRedis() {
+    const f = {
+        failing: false,
+        renewResult: 1 as number,
+        async set() {
+            if (f.failing) throw new Error('ECONNRESET');
+            return 'OK';
+        },
+        async get() {
+            return null;
+        },
+        async expire() {
+            return 1;
+        },
+        async eval() {
+            if (f.failing) throw new Error('ECONNRESET');
+            return f.renewResult;
+        },
+    };
+    return f;
+}
+
+test('a transient Redis error does not drop leadership until the lock TTL has provably elapsed', async () => {
+    const redis = fakeRedis();
+    const leader = new EngineLeaderService(redis as never);
+    const changes: boolean[] = [];
+    leader.onLeadershipChange((v) => changes.push(v));
+    const realNow = Date.now;
+    try {
+        await leader.start();
+        assert.equal(leader.isEngineLeader(), true);
+        redis.failing = true;
+        await leader.tickOnce();
+        assert.equal(leader.isEngineLeader(), true, 'still leader right after a blip');
+        assert.deepEqual(changes, [true]);
+        // 11 s later (TTL 10 s default) with Redis still failing: the lock may
+        // have expired for real → release.
+        const base = realNow();
+        Date.now = () => base + 11_000;
+        await leader.tickOnce();
+        assert.equal(leader.isEngineLeader(), false);
+        assert.deepEqual(changes, [true, false]);
+    } finally {
+        Date.now = realNow;
+        redis.failing = false;
+        await leader.stop();
+    }
+});
+
+test('an observed loss of the key (renew returns 0, someone else holds it) releases immediately', async () => {
+    const redis = fakeRedis();
+    const leader = new EngineLeaderService(redis as never);
+    try {
+        await leader.start();
+        assert.equal(leader.isEngineLeader(), true);
+        redis.renewResult = 0;
+        redis.set = async () => null as never; // re-acquire fails: held by another
+        redis.get = async () => 'other-host:1:abcd' as never;
+        await leader.tickOnce();
+        assert.equal(leader.isEngineLeader(), false);
+    } finally {
+        await leader.stop();
+    }
+});
