+        tick(gw, 7, 1.27, 100_000, T0 + 950);
+        expect(gw.getLiveAllCandleSnapshot()).toMatchObject({ bucket_ts: T0 / 1000 + 1, volume: 100_000, close: 1.27 });
+        boundary(gw, T0 + 2000);
