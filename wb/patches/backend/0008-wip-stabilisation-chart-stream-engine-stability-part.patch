+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { installRedisClientMock } from '../redis/redis-client.test-mock';
+import { RISK_TERMINAL_WATCHERS_REDIS_KEY } from '@ticktrade/shared';
+
+process.env.LIVE_BATTLE_REDIS_ONLY = '0';
+process.env.RISK_TERMINAL_IDLE_INTERVAL_MS = '5000';
+installRedisClientMock();
+// eslint-disable-next-line @typescript-eslint/no-var-requires
+const { RiskTerminalTickPublisher } = require('./risk-terminal-tick.publisher');
+
+function harness() {
+    const t0 = new Date('2026-01-01T00:00:00Z');
+    const reads = { stakes: 0, ticks: 0, rpc: 0 };
+    const published: any[] = [];
+    const watchers = { present: true };
+    const market = { lastPrice: 1.1, roundHigh: 1.1, roundLow: 1.1, buyPot: 100, sellPot: 60, version: 1 };
+    const prisma = {
+        battle: { findUnique: async () => ({ startPrice: '1', startTime: t0, buyPot: 100, sellPot: 60, roundHigh: '1', roundLow: '1' }) },
+        stake: {
+            findMany: async () => {
+                reads.stakes++;
+                return [{ id: 1, userId: 11, side: 'BUY', amount: '100', entryPrice: '1', createdAt: t0 }];
+            },
+        },
+        npcTrade: { findMany: async () => [{ id: 3, npcId: 9, side: 'SELL', amount: '60', executionPrice: '1', createdAt: t0 }], groupBy: async () => [] },
+        systemSetting: { findUnique: async () => null, findMany: async () => [{ settingKey: 'npc_engine_mode', settingValue: 'organic' }] },
+        npcRoundAudit: { findUnique: async () => null },
+        priceTick: {
+            findMany: async () => {
+                reads.ticks++;
+                return [];
+            },
+        },
+        rpcUser: {
+            findMany: async () => {
+                reads.rpc++;
+                return [];
+            },
+        },
+    };
+    const redis = {
+        get: async (key: string) => (key === RISK_TERMINAL_WATCHERS_REDIS_KEY ? (watchers.present ? '1' : null) : key === 'ticktrade:npc:engine_mode' ? 'organic' : null),
+        publish: async (_c: string, p: any) => published.push(JSON.parse(JSON.stringify(p))),
+    };
+    const pub = new RiskTerminalTickPublisher(prisma, redis, { get: async () => market });
+    return { pub, published, reads, watchers, market };
+}
+
+test('unchanged inputs: the projection is not recomputed, the previous payload is re-issued with the new countdown', async () => {
+    const h = harness();
+    await h.pub.publish(42, 30);
+    assert.equal(h.published.length, 1);
+    assert.equal(h.reads.stakes, 1);
+    // Cadence: a second call inside the same second is dropped outright …
+    await h.pub.publish(42, 30);
+    assert.equal(h.published.length, 1);
+    // … a call one second later with the same market-state version re-uses the payload.
+    await new Promise((r) => setTimeout(r, 1_000));
+    await h.pub.publish(42, 29);
+    assert.equal(h.published.length, 2);
+    assert.equal(h.reads.stakes, 1, 'no second stake read');
+    assert.equal(h.published[1].time_remaining_seconds, 29);
+    assert.deepEqual(h.published[1].if_buy_wins, h.published[0].if_buy_wins);
+    // A trade lands (version bump) → recompute.
+    h.market.version = 2;
+    await new Promise((r) => setTimeout(r, 1_000));
+    await h.pub.publish(42, 28);
+    assert.equal(h.reads.stakes, 2);
+    assert.equal(h.published.length, 3);
+    assert.equal(h.reads.rpc, 1, 'rpc-linked user ids memoised across recomputes');
+});
+
+test('nobody watching: at most one projection per idle interval, and the first one is still published', async () => {
+    const h = harness();
+    h.watchers.present = false;
+    await h.pub.publish(42, 30);
+    assert.equal(h.published.length, 1, 'first payload of the round goes out');
+    await new Promise((r) => setTimeout(r, 1_100));
+    await h.pub.publish(42, 29);
+    assert.equal(h.published.length, 1, 'inside the 5 s idle interval nothing runs');
+    assert.equal(h.reads.stakes, 1);
+});
