+import type { ChainableCommander } from 'ioredis';
 import {
+    BATTLE_STAKE_BUFFER_TTL_SEC,
     appendBufferedStake,
     allocateTempStakeId,
+    battleStakeBufferKey,
+    battleStakeFlushDoneKey,
     listBufferedStakes,
     purgeBufferedStakesForUserIds,
     redisStakeBufferEnabled,
@@ -33,6 +37,33 @@ export class BattleStakeBufferService {
         return appendBufferedStake(this.redis, row);
     }
 
+    /**
+     * Append the stake row and, in the SAME Redis MULTI, whatever commands
+     * `withMulti` adds (the pending Postgres debit — see
+     * `UserSpendableBalanceService.appendPendingDebitToMulti`). Either both the
+     * position and its debit exist afterwards, or neither does: a crash or a
+     * Redis error can no longer leave money taken with no stake, or a stake
+     * with no debit (audit F3).
+     */
+    async appendWithPendingDebit(
+        row: BufferedStakeRow,
+        withMulti?: (multi: ChainableCommander) => void,
+    ): Promise<void> {
+        const key = battleStakeBufferKey(row.battleId);
+        const multi = this.redis.multi();
+        multi.rpush(key, JSON.stringify(row));
+        multi.expire(key, BATTLE_STAKE_BUFFER_TTL_SEC);
+        multi.del(battleStakeFlushDoneKey(row.battleId));
+        withMulti?.(multi);
+        const replies = await multi.exec();
+        if (!replies) {
+            throw new Error('stake buffer MULTI aborted');
+        }
+        for (const [err] of replies) {
+            if (err) throw err;
+        }
+    }
+
     async listForBattle(battleId: number): Promise<BufferedStakeRow[]> {
         return listBufferedStakes(this.redis, battleId);
     }
