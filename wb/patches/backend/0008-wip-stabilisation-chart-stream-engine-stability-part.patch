+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    BATTLE_LEADERBOARD_COUNT_USERS_LUA,
+    battleLeaderboardUnionScratchKey,
+    battleLeaderboardUserKey,
+    countBattleLeaderboardUsers,
+} from './battle-leaderboard';
+
+test('countBattleLeaderboardUsers runs one Lua call over both side keys and never ships members', async () => {
+    const calls: Array<{ script: string; numKeys: number; args: (string | number)[] }> = [];
+    const redis = {
+        eval: async (script: string, numKeys: number, ...args: (string | number)[]) => {
+            calls.push({ script, numKeys, args });
+            return 7;
+        },
+    };
+    const n = await countBattleLeaderboardUsers(redis, 83);
+    assert.equal(n, 7);
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0]!.script, BATTLE_LEADERBOARD_COUNT_USERS_LUA);
+    assert.equal(calls[0]!.numKeys, 3);
+    assert.deepEqual(calls[0]!.args, [
+        battleLeaderboardUserKey(83, 'BUY'),
+        battleLeaderboardUserKey(83, 'SELL'),
+        battleLeaderboardUnionScratchKey(83),
+    ]);
+    assert.match(BATTLE_LEADERBOARD_COUNT_USERS_LUA, /ZUNIONSTORE/);
+    assert.match(BATTLE_LEADERBOARD_COUNT_USERS_LUA, /DEL/);
+});
+
+test('countBattleLeaderboardUsers treats a missing or invalid reply as zero', async () => {
+    assert.equal(await countBattleLeaderboardUsers({ eval: async () => null }, 1), 0);
+    assert.equal(await countBattleLeaderboardUsers({ eval: async () => 'x' }, 1), 0);
+    assert.equal(await countBattleLeaderboardUsers({ eval: async () => -3 }, 1), 0);
+});
