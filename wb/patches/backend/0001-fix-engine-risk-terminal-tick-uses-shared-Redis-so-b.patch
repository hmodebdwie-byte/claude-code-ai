+// Portable source-level regressions: real publisher/projection, in-memory I/O only.
+// Run from backend root: node --test apps/engine/src/battle/risk-terminal-regression.cjs
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const rootBackend = path.resolve(__dirname, '../../../..');
+const engineRequire = createRequire(path.join(rootBackend, 'apps/engine/package.json'));
+const ts = engineRequire('typescript');
+engineRequire('ts-node').register({
+  project: path.join(rootBackend, 'apps/engine/tsconfig.json'),
+  transpileOnly: true,
+  preferTsExts: true,
+});
+const sourceFor = () => path.join(__dirname, 'risk-terminal-tick.publisher.ts');
+const realProjection = require(path.join(rootBackend, 'packages/shared/src/payout/battle-payout.scenarios.ts'));
+const live = require(path.join(rootBackend, 'packages/shared/src/payout/battle-payout.live.ts'));
+const flags = require(path.join(rootBackend, 'packages/shared/src/events/npc-simulator.redis.ts'));
+
+function loadSource(file, mocks = {}, globals = {}) {
+  const localRequire = createRequire(file);
+  const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    fileName: file,
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2021, jsx: ts.JsxEmit.React }
+  }).outputText;
+  const exports = {};
+  const context = { module: { exports }, exports, console, setTimeout, clearTimeout,
+    require: id => Object.hasOwn(mocks, id) ? mocks[id] : localRequire(id), ...globals };
+  vm.runInNewContext(code, context, { filename: file });
+  return context.module.exports;
+}
+
+async function publishFixture({ buffered = true, rpc = false, noPrice = false, failRead = false, malformed = false, invalidPrice = false } = {}) {
+  const previous = process.env.LIVE_BATTLE_REDIS_ONLY;
+  process.env.LIVE_BATTLE_REDIS_ONLY = buffered ? '1' : '0';
+  flags.invalidateNpcSimulatorActiveCache();
+  try {
+    const startTime = new Date('2026-01-01T00:00:00Z');
+    const stake = { tempStakeId: -1, id: 1, userId: 11, battleId: 42, side: 'BUY',
+      amount: rpc ? 75 : 100, entryPrice: 1, createdAtMs: startTime.getTime(), createdAt: startTime };
+    const rpcStake = { ...stake, tempStakeId: -2, id: 2, userId: 77, amount: 25 };
+    const stakes = rpc ? [stake, rpcStake] : [stake];
+    const npc = { id: 3, npcId: 9, battleId: 42, side: 'SELL', amount: 60,
+      executionPrice: 1, createdAtMs: startTime.getTime(), createdAt: startTime };
+    let listReads = 0;
+    const redis = { get: async () => '1', lrange: async key => {
+      listReads++;
+      if (failRead) throw new Error("Synthetic Redis read failure");
+      return key.endsWith(':stakes:buffer') ? [...stakes.map(row => JSON.stringify(row)), ...(malformed ? ['{', JSON.stringify({ userId: 'invalid', side: 'BUY', amount: 999 })] : [])]
+        : key.endsWith(':npc_trades:buffer') ? [JSON.stringify(npc)] : [];
+    }};
+    const db = {
+      battle: { findUnique: async () => ({ startPrice: 1, startTime, buyPot: 100, sellPot: 60, roundHigh: 1, roundLow: 1 }) },
+      stake: { findMany: async q => buffered ? [] : stakes.filter(s => !q.where.side || s.side === q.where.side) },
+      npcTrade: { groupBy: async () => buffered ? [] : [{ side: 'SELL', _sum: { amount: 60 } }],
+        findMany: async q => buffered || q.where.side !== 'SELL' ? [] : [npc] },
+      systemSetting: { findUnique: async () => null },
+      priceTick: { findMany: async () => [] },
+      rpcUser: { findMany: async () => rpc ? [{ linkedUserId: 77 }] : [] },
+    };
+    const published = [];
+    const { RiskTerminalTickPublisher } = loadSource(sourceFor('backend', 'risk-terminal-tick.publisher.ts'), {
+      '@ticktrade/shared': { ...realProjection, humanLiveProjectionOpts: live.humanLiveProjectionOpts,
+        readNpcSimulatorActiveFromRedis: flags.readNpcSimulatorActiveFromRedis },
+      '../redis/redis.client': { getSharedCommandRedis: () => redis },
+    }, { console: { ...console, warn: message => { if (!String(message).includes('Synthetic Redis read failure')) console.warn(message); } } });
+    const publisher = new RiskTerminalTickPublisher(db,
+      { get: redis.get, publish: async (channel, data) => published.push({ channel, data: JSON.parse(JSON.stringify(data)) }) },
+      { get: async () => noPrice ? null : { lastPrice: invalidPrice ? NaN : 1, roundHigh: 1, roundLow: 1, buyPot: 100, sellPot: 60 } });
+    await publisher.publish(42, 30);
+    return { published, listReads };
+  } finally {
+    if (previous === undefined) delete process.env.LIVE_BATTLE_REDIS_ONLY;
+    else process.env.LIVE_BATTLE_REDIS_ONLY = previous;
+    flags.invalidateNpcSimulatorActiveCache();
+  }
+}
+
+test('buffered real stake remains REAL in engine socket projection before PostgreSQL flush', async () => {
+  const { published, listReads } = await publishFixture();
+  assert.equal(published.length, 1);
+  assert.equal(published[0].channel, 'engine:events:risk-terminal.tick');
+  assert.equal(published[0].data.pots.real_buy, 100);
+  assert.equal(published[0].data.pots.npc_buy, 0);
+  assert.equal(published[0].data.pots.npc_sell, 60);
+  assert.equal(published[0].data.if_buy_wins.real_winner_volume, 100);
+  assert.ok(listReads > 0);
+});
+test('buffered RPC-linked stake stays outside REAL while human stake stays inside', async () => {
+  const { published } = await publishFixture({ rpc: true });
+  assert.equal(published[0].data.pots.real_buy, 75);
+  assert.equal(published[0].data.pots.npc_buy, 25);
+  assert.equal(published[0].data.if_buy_wins.real_winner_volume, 75);
+});
+test('buffering disabled retains PostgreSQL projection path', async () => {
+  const { published, listReads } = await publishFixture({ buffered: false });
+  assert.equal(published[0].data.pots.real_buy, 100);
+  assert.equal(published[0].data.pots.npc_buy, 0);
+  assert.equal(listReads, 0);
+});
+test('no live price emits no fabricated projection', async () => {
+  assert.equal((await publishFixture({ noPrice: true })).published.length, 0);
+});
+
+test('invalid live price emits no misleading projection', async () => {
+  assert.equal((await publishFixture({ invalidPrice: true })).published.length, 0);
+});
+test('Redis read failure does not silently publish a PostgreSQL-based split', async () => {
+  assert.equal((await publishFixture({ failRead: true })).published.length, 0);
+});
+test('malformed buffer entries do not invent human stake volume', async () => {
+  const { published } = await publishFixture({ malformed: true });
+  assert.equal(published[0].data.pots.real_buy, 100);
+  assert.equal(published[0].data.pots.npc_buy, 0);
+});
+test('projection retains battle identity, countdown and computation timestamp', async () => {
+  const before = Date.now();
+  const { published } = await publishFixture();
+  assert.equal(published[0].data.battle_id, 42);
+  assert.equal(published[0].data.time_remaining_seconds, 30);
+  assert.ok(published[0].data.computed_at_ms >= before);
+  assert.ok(published[0].data.computed_at_ms <= Date.now());
+});
