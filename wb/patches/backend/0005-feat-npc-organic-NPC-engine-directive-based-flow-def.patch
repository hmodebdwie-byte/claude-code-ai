@@ -0,0 +1,98 @@
+import {
+    Body,
+    Controller,
+    Get,
+    Param,
+    ParseIntPipe,
+    Post,
+    Put,
+    Query,
+    Req,
+    UseGuards,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import { ApiBearerAuth, ApiOperation, ApiParam, ApiQuery, ApiTags } from '@nestjs/swagger';
+import { JwtAuthGuard } from '../../auth/guards/jwt-auth.guard';
+import { RolesGuard } from '../../auth/guards/roles.guard';
+import { Roles } from '../../auth/decorators/roles.decorator';
+import { RequirePermission } from '../roles/require-permission.decorator';
+import { AdminNpcOrganicService } from './admin-npc-organic.service';
+
+interface AuthenticatedAdminRequest extends Request {
+    user: { userId: number };
+}
+
+@ApiTags('admin/npc')
+@ApiBearerAuth('bearer')
+@Controller('admin/npc/organic')
+@UseGuards(JwtAuthGuard, RolesGuard)
+@Roles('ADMIN')
+export class AdminNpcOrganicController {
+    constructor(private readonly organic: AdminNpcOrganicService) {}
+
+    @Get('schema')
+    @ApiOperation({ summary: 'Field schema (groups, labels, ranges, defaults) of the organic NPC engine settings' })
+    @RequirePermission('npcSimulator.view')
+    getSchema() {
+        return this.organic.getSchema();
+    }
+
+    @Get('settings')
+    @ApiOperation({ summary: 'Current organic NPC engine settings, mode and engine status' })
+    @RequirePermission('npcSimulator.view')
+    getSettings() {
+        return this.organic.getSettings();
+    }
+
+    @Put('settings')
+    @ApiOperation({ summary: 'Save organic NPC engine settings (full or partial document); pushed live to the engine' })
+    @RequirePermission('npcSimulator.edit')
+    updateSettings(@Body() body: Record<string, unknown>, @Req() req: AuthenticatedAdminRequest) {
+        const values = body && typeof body === 'object' && 'values' in body ? body.values : body;
+        return this.organic.updateSettings(values, req.user.userId);
+    }
+
+    @Post('settings/reset')
+    @ApiOperation({ summary: 'Reset organic NPC engine settings to the directive defaults (mode unchanged)' })
+    @RequirePermission('npcSimulator.edit')
+    resetSettings(@Req() req: AuthenticatedAdminRequest) {
+        return this.organic.resetSettings(req.user.userId);
+    }
+
+    @Put('mode')
+    @ApiOperation({ summary: "Switch the NPC engine mode ('organic' | 'legacy') live" })
+    @RequirePermission('npcSimulator.edit')
+    setMode(@Body() body: { mode?: unknown }, @Req() req: AuthenticatedAdminRequest) {
+        return this.organic.setMode(body?.mode, req.user.userId);
+    }
+
+    @Get('status')
+    @ApiOperation({ summary: 'Engine mode, settings version and the engine heartbeat' })
+    @RequirePermission('npcSimulator.view')
+    getStatus() {
+        return this.organic.getStatus();
+    }
+
+    @Get('live')
+    @ApiOperation({ summary: 'Live round telemetry published by the organic engine (1 s)' })
+    @RequirePermission('npcSimulator.view')
+    getLive() {
+        return this.organic.getLive();
+    }
+
+    @Get('rounds')
+    @ApiOperation({ summary: 'Recent rounds: plan, projection, final injection and settlement invariants' })
+    @ApiQuery({ name: 'limit', required: false })
+    @RequirePermission('npcSimulator.view')
+    listRounds(@Query('limit') limit?: string) {
+        return this.organic.listRounds(limit);
+    }
+
+    @Get('rounds/:battleId')
+    @ApiOperation({ summary: 'Audit row of one round' })
+    @ApiParam({ name: 'battleId' })
+    @RequirePermission('npcSimulator.view')
+    getRound(@Param('battleId', ParseIntPipe) battleId: number) {
+        return this.organic.getRound(battleId);
+    }
+}
diff --git a/apps/api/src/admin/npc/admin-npc-organic.service.ts b/apps/api/src/admin/npc/admin-npc-organic.service.ts
new file mode 100644
index 0000000..1841450
--- /dev/null
+++ b/apps/api/src/admin/npc/admin-npc-organic.service.ts
@@ -0,0 +1,292 @@
+/**
+ * Admin API for the Organic NPC Engine: one JSON settings document (`system_settings.npc_organic_settings`)
+ * that is mirrored to Redis and pushed to the engine on every save, plus the engine mode, the live
+ * round telemetry and the per-round audit rows written at settlement.
+ *
+ * Every field in the document is described by `ORGANIC_FIELD_SPECS` (shared package); the admin UI
+ * renders the form from that schema so a new setting only needs a spec entry to be editable.
+ */
+import { BadRequestException, Injectable, Logger, NotFoundException } from '@nestjs/common';
+import {
+    DEFAULT_ORGANIC_NPC_SETTINGS,
+    NPC_ENGINE_MODE_REDIS_KEY,
+    NPC_ENGINE_MODE_SETTING_KEY,
+    NPC_ORGANIC_ENGINE_STATUS_REDIS_KEY,
+    NPC_ORGANIC_LIVE_REDIS_KEY,
+    NPC_ORGANIC_SETTINGS_CHANNEL,
+    NPC_ORGANIC_SETTINGS_REDIS_KEY,
+    NPC_ORGANIC_SETTINGS_SETTING_KEY,
+    ORGANIC_FIELD_SPECS,
+    ORGANIC_GROUPS,
+    cloneOrganicSettings,
+    getPath,
+    invalidateNpcEngineModeCache,
+    parseNpcEngineMode,
+    parseOrganicSettingsDocument,
+    setPath,
+    validateOrganicSettings,
+    type NpcEngineMode,
+    type OrganicNpcSettings,
+    type OrganicSettingsDocument,
+} from '@ticktrade/shared';
+import { PrismaService } from '../../prisma/prisma.service';
+import { RedisPublisher } from '../../redis/redis.publisher';
+import { AdminAuditLogService } from '../audit-log/admin-audit-log.service';
+
+interface StoredState {
+    doc: OrganicSettingsDocument;
+    mode: NpcEngineMode;
+}
+
+export interface OrganicEngineStatus {
+    mode: NpcEngineMode;
+    active: boolean;
+    settingsVersion: number;
+    /** Round the engine is currently working on (null between rounds). */
+    battleId: number | null;
+    appliedAt: string | null;
+    host: string | null;
+    /** Age of the status heartbeat in ms; null when the engine has not reported. */
+    heartbeatAgeMs: number | null;
+}
+
+const ROUND_LIST_MAX = 100;
+const ROUND_LIST_DEFAULT = 20;
+
+/** Accepts the loose values a form posts (numeric strings, "true") before strict validation. */
+function normalizeIncoming(current: OrganicNpcSettings, input: Record<string, unknown>): OrganicNpcSettings {
+    const merged = JSON.parse(JSON.stringify(current)) as OrganicNpcSettings;
+    for (const spec of ORGANIC_FIELD_SPECS) {
+        const v = getPath(input, spec.path);
+        if (v === undefined) continue;
+        let next: unknown = v;
+        if ((spec.type === 'number' || spec.type === 'integer') && typeof v === 'string' && v.trim() !== '') {
+            const n = Number(v);
+            if (Number.isFinite(n)) next = n;
+        } else if (spec.type === 'boolean' && typeof v === 'string') {
+            if (v === 'true' || v === '1') next = true;
+            else if (v === 'false' || v === '0') next = false;
+        }
+        setPath(merged as unknown as Record<string, unknown>, spec.path, next);
+    }
+    return merged;
+}
+
+@Injectable()
+export class AdminNpcOrganicService {
+    private readonly logger = new Logger(AdminNpcOrganicService.name);
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly redisPublisher: RedisPublisher,
+        private readonly auditLog: AdminAuditLogService,
+    ) {}
+
+    getSchema() {
+        return {
+            success: true,
+            groups: ORGANIC_GROUPS,
+            fields: ORGANIC_FIELD_SPECS,
+            defaults: DEFAULT_ORGANIC_NPC_SETTINGS,
+        };
+    }
+
+    async getSettings() {
+        const [state, engine] = await Promise.all([this.readStored(), this.readEngineStatus()]);
+        return {
+            success: true,
+            version: state.doc.version,
+            updatedAt: state.doc.version > 0 ? state.doc.updatedAt : null,
+            updatedBy: state.doc.updatedBy,
+            mode: state.mode,
+            values: state.doc.values,
+            defaults: DEFAULT_ORGANIC_NPC_SETTINGS,
+            engine,
+        };
+    }
+
+    async updateSettings(input: unknown, adminId: number) {
+        if (input == null || typeof input !== 'object' || Array.isArray(input)) {
+            throw new BadRequestException('values must be an object');
+        }
+        const current = await this.readStored();
+        const merged = normalizeIncoming(current.doc.values, input as Record<string, unknown>);
+        const errors = validateOrganicSettings(merged);
+        if (errors.length > 0) {
+            // One "<path>: <message>" line per problem; the admin form maps them back to fields.
+            throw new BadRequestException(errors.map((e) => `${e.path}: ${e.message}`));
+        }
+        return this.persist(merged, adminId, 'systemSetting.npcOrganicUpdated', current);
+    }
+
+    async resetSettings(adminId: number) {
+        const current = await this.readStored();
+        const values = cloneOrganicSettings();
+        values.engine.mode = current.mode;
+        return this.persist(values, adminId, 'systemSetting.npcOrganicReset', current);
+    }
+
+    async setMode(modeRaw: unknown, adminId: number) {
+        if (modeRaw !== 'organic' && modeRaw !== 'legacy') {
+            throw new BadRequestException("mode must be 'organic' or 'legacy'");
+        }
+        const current = await this.readStored();
+        const values = JSON.parse(JSON.stringify(current.doc.values)) as OrganicNpcSettings;
+        values.engine.mode = modeRaw;
+        return this.persist(values, adminId, 'systemSetting.npcEngineModeChanged', current);
+    }
+
+    async getStatus() {
+        const [state, engine] = await Promise.all([this.readStored(), this.readEngineStatus()]);
+        return { success: true, mode: state.mode, version: state.doc.version, engine };
+    }
+
+    async getLive() {
+        const [raw, engine] = await Promise.all([
+            this.redisPublisher.get(NPC_ORGANIC_LIVE_REDIS_KEY),
+            this.readEngineStatus(),
+        ]);
+        let live: unknown = null;
+        if (raw) {
+            try {
+                live = JSON.parse(raw);
+            } catch {
+                live = null;
+            }
+        }
+        return { success: true, live, engine, now: new Date().toISOString() };
+    }
+
+    async listRounds(limitRaw?: string) {
+        const parsed = Number.parseInt(String(limitRaw ?? ''), 10);
+        const take = Number.isFinite(parsed) && parsed > 0 ? Math.min(parsed, ROUND_LIST_MAX) : ROUND_LIST_DEFAULT;
+        const rows = await this.prisma.npcRoundAudit.findMany({
+            orderBy: { battleId: 'desc' },
+            take,
+            select: {
+                battleId: true,
+                mode: true,
+                settingsVersion: true,
+                lockedAt: true,
+                plan: true,
+                projection: true,
+                finalInjection: true,
+                settlement: true,
+                createdAt: true,
+                updatedAt: true,
+            },
+        });
+        return { success: true, rounds: rows };
+    }
+
+    async getRound(battleId: number) {
+        const row = await this.prisma.npcRoundAudit.findUnique({ where: { battleId } });
+        if (!row) throw new NotFoundException(`No NPC audit for battle ${battleId}`);
+        return { success: true, round: row };
+    }
+
+    // ------------------------------------------------------------------------------------------
+
+    private async readStored(): Promise<StoredState> {
+        const rows = await this.prisma.systemSetting.findMany({
+            where: { settingKey: { in: [NPC_ORGANIC_SETTINGS_SETTING_KEY, NPC_ENGINE_MODE_SETTING_KEY] } },
+            select: { settingKey: true, settingValue: true },
+        });
+        let rawDoc: string | null = null;
+        let rawMode: string | null = null;
+        for (const r of rows) {
+            if (r.settingKey === NPC_ORGANIC_SETTINGS_SETTING_KEY) rawDoc = r.settingValue;
+            if (r.settingKey === NPC_ENGINE_MODE_SETTING_KEY) rawMode = r.settingValue;
+        }
+        const doc = parseOrganicSettingsDocument(rawDoc);
+        const mode = parseNpcEngineMode(rawMode ?? doc.values.engine.mode);
+        doc.values.engine.mode = mode;
+        return { doc, mode };
+    }
+
+    private async readEngineStatus(): Promise<OrganicEngineStatus | null> {
+        const raw = await this.redisPublisher.get(NPC_ORGANIC_ENGINE_STATUS_REDIS_KEY).catch(() => null);
+        if (!raw) return null;
+        try {
+            const p = JSON.parse(raw) as Record<string, unknown>;
+            const at = typeof p.at === 'number' ? p.at : Date.parse(String(p.at ?? ''));
+            return {
+                mode: parseNpcEngineMode(p.mode),
+                active: p.active === true,
+                settingsVersion: Number(p.settingsVersion) || 0,
+                battleId: Number.isFinite(Number(p.battleId)) && Number(p.battleId) > 0 ? Number(p.battleId) : null,
+                appliedAt: typeof p.appliedAt === 'string' ? p.appliedAt : null,
+                host: typeof p.host === 'string' ? p.host : null,
+                heartbeatAgeMs: Number.isFinite(at) ? Math.max(0, Date.now() - at) : null,
+            };
+        } catch {
+            return null;
+        }
+    }
+
+    /**
+     * Single write path: DB (source of truth) → Redis mirror → pub/sub push → audit log.
+     * The engine applies the pushed document within a heartbeat; the poll and the DB fallback
+     * cover a missed message.
+     */
+    private async persist(
+        values: OrganicNpcSettings,
+        adminId: number,
+        action: string,
+        current: StoredState,
+    ) {
+        const mode = parseNpcEngineMode(values.engine.mode);
+        values.engine.mode = mode;
+        const doc: OrganicSettingsDocument = {
+            version: current.doc.version + 1,
+            updatedAt: new Date().toISOString(),
+            updatedBy: adminId,
+            values,
+        };
+        const json = JSON.stringify(doc);
+        await this.prisma.$transaction([
+            this.prisma.systemSetting.upsert({
+                where: { settingKey: NPC_ORGANIC_SETTINGS_SETTING_KEY },
+                update: { settingValue: json },
+                create: {
+                    settingKey: NPC_ORGANIC_SETTINGS_SETTING_KEY,
+                    settingValue: json,
+                    description: 'Organic NPC engine settings document (JSON, versioned)',
+                },
+            }),
+            this.prisma.systemSetting.upsert({
+                where: { settingKey: NPC_ENGINE_MODE_SETTING_KEY },
+                update: { settingValue: mode },
+                create: {
+                    settingKey: NPC_ENGINE_MODE_SETTING_KEY,
+                    settingValue: mode,
+                    description: 'NPC engine mode: organic (directives) or legacy (reactive simulator)',
+                },
+            }),
+        ]);
+        try {
+            await this.redisPublisher.set(NPC_ORGANIC_SETTINGS_REDIS_KEY, json);
+            await this.redisPublisher.set(NPC_ENGINE_MODE_REDIS_KEY, mode);
+            invalidateNpcEngineModeCache();
+            await this.redisPublisher.publish(NPC_ORGANIC_SETTINGS_CHANNEL, {
+                document: doc,
+                mode,
+                timestamp: doc.updatedAt,
+            });
+        } catch (err) {
+            // The DB write is durable; the engine's poll picks the document up within 20 s.
+            this.logger.warn(
+                `Organic settings saved (v${doc.version}) but the Redis push failed: ${
+                    err instanceof Error ? err.message : String(err)
+                }`,
+            );
+        }
+        await this.auditLog.log({
+            adminId,
+            action,
+            before: { version: current.doc.version, mode: current.mode, values: current.doc.values },
+            after: { version: doc.version, mode, values },
+        });
+        return this.getSettings();
+    }
+}
