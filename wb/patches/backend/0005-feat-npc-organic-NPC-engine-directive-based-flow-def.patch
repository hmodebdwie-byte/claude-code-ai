+            this.log.warn(`[OrganicNpc] organic trade failed: ${err instanceof Error ? err.message : String(err)}`);
+        }
+    }
+
+    private recordTrade(session: RoundSession, t: Omit<OrganicTradeRecord, 'elapsedSec'>): void {
+        session.sideByNpc.set(t.npcId, t.side);
+        session.simVolume[t.side] += t.amount;
+        session.tradeCount += 1;
+        session.lastPots = { buyPot: t.buyPot, sellPot: t.sellPot };
+        session.trades.push({ ...t, elapsedSec: Math.round((t.atMs - session.battle.startTimeMs) / 100) / 10 });
