+/**
+ * NPC Organic Engine — settings schema (single source of truth).
+ *
+ * The same schema drives:
+ *   - API validation (`validateOrganicSettings`) when the admin saves,
+ *   - engine parsing (`coerceOrganicSettings`) so a bad row can never take the engine down,
+ *   - the admin form, which renders `ORGANIC_FIELD_SPECS` (label, help, unit, range, "applies").
+ *
+ * Directives implemented: Master NPC Architecture & Risk Management Directives 2.1 and the
+ * "Live Testing & Artificial Reaction Flaw" memo (organic trickle-in, tier stake brackets,
+ * decoupled risk with a final-millisecond injection and lock, zero-profit cap).
+ */
+
+export type NpcEngineMode = 'organic' | 'legacy';
+export type OrganicLeadSideMode = 'random' | 'follow_real' | 'against_real';
+export type OrganicApplies = 'live' | 'next_round';
+
+export interface OrganicTierSettings {
+    /** Share of the active roster (by volume profile rank) that belongs to this tier. */
+    rosterSharePct: number;
+    /** Share of NPC trades this tier places. */
+    tradeSharePct: number;
+    stakeMin: number;
+    stakeMax: number;
+}
+
+export interface OrganicNpcSettings {
+    engine: {
+        mode: NpcEngineMode;
+        /** Legacy hidden rule (winner = side with the smaller real pot when both sides have real users). Off = pot dominance. */
+        houseMaxRealLoserPoolRule: boolean;
+    };
+    roundStart: {
+        initialSpawnsMin: number;
+        initialSpawnsMax: number;
+        spawnDelayMinMs: number;
+        spawnDelayMaxMs: number;
+        peakInitialSpawnsMin: number;
+        peakInitialSpawnsMax: number;
+        peakInitialWindowMs: number;
+        /** Comma separated HH:mm-HH:mm ranges, e.g. "18:00-23:00,12:00-14:00". Empty = never peak. */
+        peakHours: string;
+        /** Offset from UTC in minutes used to evaluate `peakHours` (e.g. 180 for UTC+3). */
+        peakTimezoneOffsetMinutes: number;
+        /** Model B anchor: invisible baseline weight added to the price-impact denominator. 0 = off. */
+    };
+    momentum: {
+        baseArrivalsPerMinute: number;
+        peakArrivalsPerMinute: number;
+        rampToPeakFraction: number;
+        lateFadeFraction: number;
+        peakHoursMultiplier: number;
+        realTradeBoostMultiplier: number;
+        realTradeBoostSeconds: number;
+        quietPeriodChancePct: number;
+        quietPeriodMinSec: number;
+        quietPeriodMaxSec: number;
+        maxDistinctNpcsPerRound: number;
+        /** 0 = unlimited. Organic flow stops once the simulator has this much volume in the round. */
+        maxSimVolumePerRound: number;
+    };
+    tiers: {
+        whale: OrganicTierSettings;
+        mid: OrganicTierSettings;
+        retail: OrganicTierSettings;
+        sizeJitterPct: number;
+        roundToLadder: boolean;
+    };
+    asymmetry: {
+        organicWindowFraction: number;
+        leadSharePctMin: number;
+        leadSharePctMax: number;
+        leadSideMode: OrganicLeadSideMode;
+        fomoFollowStrengthPct: number;
+    };
+    defenses: {
+        steeringEnabled: boolean;
+        steeringStrengthPct: number;
+        steeringStartFraction: number;
+        dilutionEnabled: boolean;
+        dilutionSafetyMarginPct: number;
+        finalInjectionLeadMs: number;
+        finalInjectionMaxSlices: number;
+        /** 0 = unlimited. */
+        finalInjectionMaxUsd: number;
+        ghostTownEnabled: boolean;
+        ghostTownMarginPct: number;
+        /** When Ghost Town is off and all real users won: max simulator seed that may fund them. 0 = unlimited. */
+        ghostTownFallbackMaxSimLossUsd: number;
+    };
+    audit: {
+        keepRounds: number;
+    };
+}
+
+export interface OrganicSettingsDocument {
+    version: number;
+    updatedAt: string;
+    updatedBy: number | null;
+    values: OrganicNpcSettings;
+}
+
+export const NPC_ORGANIC_SETTINGS_SETTING_KEY = 'npc_organic_settings';
+export const NPC_ENGINE_MODE_SETTING_KEY = 'npc_engine_mode';
+
+export const DEFAULT_ORGANIC_NPC_SETTINGS: OrganicNpcSettings = Object.freeze({
+    engine: { mode: 'organic', houseMaxRealLoserPoolRule: false },
+    roundStart: {
+        initialSpawnsMin: 1,
+        initialSpawnsMax: 5,
+        spawnDelayMinMs: 1_000,
+        spawnDelayMaxMs: 15_000,
+        peakInitialSpawnsMin: 10,
+        peakInitialSpawnsMax: 20,
+        peakInitialWindowMs: 15_000,
+        peakHours: '',
+        peakTimezoneOffsetMinutes: 0,
+    },
+    momentum: {
+        baseArrivalsPerMinute: 4,
+        peakArrivalsPerMinute: 24,
+        rampToPeakFraction: 0.6,
+        lateFadeFraction: 0.95,
+        peakHoursMultiplier: 1.6,
+        realTradeBoostMultiplier: 1.5,
+        realTradeBoostSeconds: 20,
+        quietPeriodChancePct: 12,
+        quietPeriodMinSec: 4,
+        quietPeriodMaxSec: 12,
+        maxDistinctNpcsPerRound: 120,
+        maxSimVolumePerRound: 0,
+    },
+    tiers: {
+        whale: { rosterSharePct: 5, tradeSharePct: 10, stakeMin: 5_000, stakeMax: 50_000 },
+        mid: { rosterSharePct: 25, tradeSharePct: 30, stakeMin: 500, stakeMax: 5_000 },
+        retail: { rosterSharePct: 70, tradeSharePct: 60, stakeMin: 10, stakeMax: 500 },
+        sizeJitterPct: 15,
+        roundToLadder: true,
+    },
+    asymmetry: {
+        organicWindowFraction: 0.85,
+        leadSharePctMin: 60,
+        leadSharePctMax: 90,
+        leadSideMode: 'random',
+        fomoFollowStrengthPct: 35,
+    },
+    defenses: {
+        steeringEnabled: true,
+        steeringStrengthPct: 50,
+        steeringStartFraction: 0.2,
+        dilutionEnabled: true,
+        dilutionSafetyMarginPct: 2,
+        finalInjectionLeadMs: 150,
+        finalInjectionMaxSlices: 3,
+        finalInjectionMaxUsd: 0,
+        ghostTownEnabled: true,
+        ghostTownMarginPct: 5,
+        ghostTownFallbackMaxSimLossUsd: 0,
+    },
+    audit: { keepRounds: 50 },
+}) as OrganicNpcSettings;
+
+export type OrganicFieldType = 'number' | 'integer' | 'boolean' | 'select' | 'text';
+
+export interface OrganicFieldSpec {
+    /** Dotted path inside {@link OrganicNpcSettings}, e.g. `tiers.whale.stakeMin`. */
+    path: string;
+    group: string;
+    label: string;
+    help: string;
+    type: OrganicFieldType;
+    applies: OrganicApplies;
+    unit?: string;
+    min?: number;
+    max?: number;
+    step?: number;
+    options?: Array<{ value: string; label: string }>;
+    /** Regex (as string) for text fields. */
+    pattern?: string;
+}
+
+export const ORGANIC_GROUPS: Array<{ key: string; title: string; description: string }> = [
+    { key: 'engine', title: 'Engine', description: 'Which NPC engine runs and how the winner is decided.' },
+    { key: 'roundStart', title: 'Round start (trickle-in)', description: 'How many NPCs enter at the start of a round and when. No NPC ever trades at 0 ms.' },
+    { key: 'momentum', title: 'Momentum', description: 'How the arrival rate of NPC trades builds up during the round.' },
+    { key: 'tiers', title: 'Tiers & stake sizes', description: 'Whale / mid / retail brackets. Whales place bigger orders, not more orders.' },
+    { key: 'asymmetry', title: 'Organic asymmetry', description: 'One side is allowed to lead heavily for most of the round. No parity logic.' },
+    { key: 'defenses', title: 'Risk defenses & lock', description: 'Continuous steering (A), final-millisecond Lightning Dilution (B), Ghost Town (C) and the lock.' },
+    { key: 'audit', title: 'Audit', description: 'How many settled rounds keep a full audit record.' },
+];
+
+const num = (
+    path: string,
+    group: string,
+    label: string,
+    help: string,
+    applies: OrganicApplies,
+    range: { min: number; max: number; step?: number; unit?: string; integer?: boolean },
+): OrganicFieldSpec => ({
+    path,
+    group,
+    label,
+    help,
+    applies,
+    type: range.integer ? 'integer' : 'number',
+    unit: range.unit,
+    min: range.min,
+    max: range.max,
+    step: range.step,
+});
+const bool = (path: string, group: string, label: string, help: string, applies: OrganicApplies): OrganicFieldSpec => ({
+    path,
+    group,
+    label,
+    help,
+    applies,
+    type: 'boolean',
+});
+
+const tierFields = (tier: 'whale' | 'mid' | 'retail', title: string): OrganicFieldSpec[] => [
+    num(`tiers.${tier}.rosterSharePct`, 'tiers', `${title}: share of roster`, 'Top NPCs by volume profile go to the whale tier, then mid, the rest are retail.', 'live', { min: 0, max: 100, step: 1, unit: '%' }),
+    num(`tiers.${tier}.tradeSharePct`, 'tiers', `${title}: share of trades`, 'How many of the NPC trades in a round come from this tier.', 'live', { min: 0, max: 100, step: 1, unit: '%' }),
+    num(`tiers.${tier}.stakeMin`, 'tiers', `${title}: minimum stake`, 'Smallest order this tier places.', 'live', { min: 1, max: 5_000_000, step: 1, unit: '$' }),
+    num(`tiers.${tier}.stakeMax`, 'tiers', `${title}: maximum stake`, 'Largest order this tier places.', 'live', { min: 1, max: 5_000_000, step: 1, unit: '$' }),
+];
+
+export const ORGANIC_FIELD_SPECS: OrganicFieldSpec[] = [
+    {
+        path: 'engine.mode',
+        group: 'engine',
+        label: 'NPC engine',
+        help: 'Organic = the directive engine (this page). Legacy = the previous reactive simulator; the settings below are then ignored.',
+        type: 'select',
+        applies: 'live',
+        options: [
+            { value: 'organic', label: 'Organic (directives)' },
+            { value: 'legacy', label: 'Legacy simulator' },
+        ],
+    },
+    bool('engine.houseMaxRealLoserPoolRule', 'engine', 'House winner rule', 'ON = when both sides have real users the smaller real pot wins (legacy). OFF = the larger pot wins (pot dominance).', 'next_round'),
+
+    num('roundStart.initialSpawnsMin', 'roundStart', 'Initial spawns min', 'Fewest NPCs that enter in the first seconds of a normal round.', 'next_round', { min: 0, max: 200, integer: true }),
+    num('roundStart.initialSpawnsMax', 'roundStart', 'Initial spawns max', 'Most NPCs that enter in the first seconds of a normal round.', 'next_round', { min: 0, max: 200, integer: true }),
+    num('roundStart.spawnDelayMinMs', 'roundStart', 'Spawn delay min', 'Earliest an initial NPC may enter after the round starts.', 'next_round', { min: 200, max: 120_000, step: 100, unit: 'ms', integer: true }),
+    num('roundStart.spawnDelayMaxMs', 'roundStart', 'Spawn delay max', 'Latest an initial NPC may enter after the round starts.', 'next_round', { min: 200, max: 120_000, step: 100, unit: 'ms', integer: true }),
