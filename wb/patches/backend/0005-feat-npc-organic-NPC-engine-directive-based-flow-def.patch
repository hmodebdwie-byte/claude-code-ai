+    }
+
+    /** Snapshot for the admin Live Round tab. */
+    liveView(): Record<string, unknown> | null {
+        const s = this.session;
+        if (!s) return null;
+        const now = this.clock.now();
+        return {
+            battleId: s.battle.id,
+            startedAt: new Date(s.battle.startTimeMs).toISOString(),
+            durationSeconds: s.battle.durationSeconds,
+            elapsedSec: Math.max(0, Math.floor((now - s.battle.startTimeMs) / 1000)),
+            remainingMs: Math.max(0, s.endMs - now),
