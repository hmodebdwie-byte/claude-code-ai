+        }, LIVE_MS);
+    }
+
+    // ------------------------------------------------------------------
+    // Final millisecond: lock + injection
+    // ------------------------------------------------------------------
+
+    private scheduleFinalInjection(session: RoundSession): void {
+        if (session.closed || session.finalScheduled) return;
+        const lead = this.settings().defenses.finalInjectionLeadMs;
+        const at = session.endMs - lead;
+        const wait = Math.max(0, at - this.clock.now());
+        session.finalScheduled = true;
+        session.finalTimer = this.clock.setTimeout(() => {
+            session.finalTimer = null;
+            void this.runFinalInjection(session);
+        }, wait);
+    }
+
+    private async runFinalInjection(session: RoundSession): Promise<void> {
+        if (session.closed || session.locked || !this.active) return;
+        const settings = this.settings();
+        const battleId = session.battle.id;
+        const lockedAt = this.clock.now();
+        session.locked = true;
+        const graceKey = redisSettlementGraceKey(battleId);
+        const t0 = lockedAt;
+        try {
+            // 1) Hold settlement while we work, then lock the book for real users.
+            await this.deps.redis.setPx(graceKey, '1', 6_000);
+            await this.deps.redis.setPx(battleLockKey(battleId), String(lockedAt), BATTLE_LOCK_TTL_SEC * 1000);
+            await this.deps.redis.publish(BATTLE_LOCKED_CHANNEL, { battleId, lockedAtMs: lockedAt, timestamp: lockedAt });
+            // 2) Let orders accepted before the lock finish committing.
+            await new Promise<void>((resolve) => this.clock.setTimeout(resolve, this.deps.lockDrainMs ?? 40));
+            // 3) Exposure at the lock and the single defensive decision.
+            const ctx = await this.deps.reader.read(battleId, {
