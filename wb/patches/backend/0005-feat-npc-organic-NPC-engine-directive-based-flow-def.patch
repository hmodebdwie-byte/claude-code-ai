+        void this.deps.audit.open(battle.id, 'organic', doc.version, {
+            initialSpawns: wave.count,
+            initialDelaysMs: wave.delaysMs,
+            peak,
+            lead,
+            tiers: { whale: tiers.whale.length, mid: tiers.mid.length, retail: tiers.retail.length },
+            roster: roster.length,
+            settings: { roundStart: settings.roundStart, asymmetry: settings.asymmetry, momentum: settings.momentum, tiers: settings.tiers, defenses: settings.defenses },
+        });
