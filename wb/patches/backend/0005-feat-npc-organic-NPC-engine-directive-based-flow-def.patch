+                const ctx = await this.deps.reader.read(battle.id);
+                if (ctx) {
+                    const real = summarizeNetReal(computeUserNetPositions(ctx.realStakes));
+                    realFavoured = real.buyNet > real.sellNet ? 'BUY' : real.sellNet > real.buyNet ? 'SELL' : null;
+                }
+            } catch {
+                /* fall back to random */
+            }
+        }
+        const lead = drawLeadTarget(settings, { realFavouredSide: realFavoured, rng });
+        const endMs = battle.startTimeMs + battle.durationSeconds * 1000;
+        const session: RoundSession = {
+            battle,
+            endMs,
+            rng,
+            frozen: { roundStart: settings.roundStart, asymmetry: settings.asymmetry, engine: settings.engine },
+            settingsVersion: doc.version,
+            wave,
+            lead,
+            peak,
+            tiers,
+            sideByNpc: new Map(),
+            simVolume: { BUY: 0, SELL: 0 },
+            trades: [],
+            tradeCount: 0,
+            lastRealTrade: null,
+            realTradeCount: 0,
+            boostUntilMs: 0,
+            quietUntilMs: 0,
+            steeringSide: null,
+            projection: null,
+            projectionAtMs: 0,
+            injection: null,
+            locked: false,
+            finalScheduled: false,
+            timers: new Set(),
+            finalTimer: null,
+            projectionTimer: null,
+            liveTimer: null,
+            closed: false,
+            lastPots: { buyPot: 0, sellPot: 0 },
