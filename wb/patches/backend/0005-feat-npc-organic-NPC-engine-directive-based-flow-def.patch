+/** Redis keys and pub/sub channels shared by API, engine, npc-worker and settlement for the organic engine. */
+
+/** JSON {@link OrganicSettingsDocument}; written by the API on every save, read by the engine. */
+export const NPC_ORGANIC_SETTINGS_REDIS_KEY = 'ticktrade:npc:organic:settings';
+/** 'organic' | 'legacy' — mirrored from system_settings so hot paths never touch Postgres. */
+export const NPC_ENGINE_MODE_REDIS_KEY = 'ticktrade:npc:engine_mode';
+/** Published with the full settings document whenever the admin saves. */
+export const NPC_ORGANIC_SETTINGS_CHANNEL = 'engine:events:npc.organic.settings';
+/** Published by the organic engine once per second (leader) with the live round telemetry. */
+export const NPC_ORGANIC_LIVE_REDIS_KEY = 'ticktrade:npc:organic:live';
+export const NPC_ORGANIC_LIVE_TTL_SEC = 30;
+/** Engine status heartbeat for the admin page: {mode, active, settingsVersion, appliedAt}. */
+export const NPC_ORGANIC_ENGINE_STATUS_REDIS_KEY = 'ticktrade:npc:organic:engine_status';
+export const NPC_ORGANIC_ENGINE_STATUS_TTL_SEC = 15;
+
+/**
+ * Round lock. Set by the engine immediately before the final defensive injection; every real
+ * order that arrives afterwards is rejected with ROUND_LOCKED. Value = ms epoch of the lock.
+ */
+export function battleLockKey(battleId: number): string {
+    return `tt:battle:lock:${battleId}`;
+}
+export const BATTLE_LOCK_TTL_SEC = 15 * 60;
+/** Published right after the lock is set (payload: {battleId, lockedAtMs, injections}). */
+export const BATTLE_LOCKED_CHANNEL = 'engine:events:battle.locked';
+
+/** Set of NPC ids that traded in this round (distinct trader count for the snapshot). */
+export function npcOrganicRoundTradersKey(battleId: number): string {
+    return `ticktrade:npc:organic:round:${battleId}:traders`;
+}
+export const NPC_ORGANIC_ROUND_TRADERS_TTL_SEC = 2 * 60 * 60;
diff --git a/packages/shared/src/npc-organic/settings.spec.ts b/packages/shared/src/npc-organic/settings.spec.ts
