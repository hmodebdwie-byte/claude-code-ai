--- /dev/null
+++ b/packages/shared/src/npc-organic/engine-mode.redis.ts
@@ -0,0 +1,44 @@
+/**
+ * Cached reader of the NPC engine mode (`organic` | `legacy`) for hot paths (API trade
+ * validation). Mirrors {@link readNpcSimulatorActiveFromRedis}: a short per-process cache,
+ * one in-flight read at a time, and `organic` when Redis is empty or fails.
+ */
+import { NPC_ENGINE_MODE_REDIS_KEY } from './redis-keys';
+import { parseNpcEngineMode, type NpcEngineMode } from './settings';
+
+type Getter = (key: string) => Promise<string | null>;
+
+const CACHE_TTL_MS = 2_000;
+let cachedMode: NpcEngineMode | null = null;
+let cachedAtMs = 0;
+let inFlight: Promise<NpcEngineMode> | null = null;
+
+export async function readNpcEngineModeFromRedis(get: Getter): Promise<NpcEngineMode> {
+    const nowMs = Date.now();
+    if (cachedMode !== null && nowMs - cachedAtMs < CACHE_TTL_MS) return cachedMode;
+    if (inFlight) return inFlight;
+    inFlight = (async () => {
+        try {
+            const raw = await get(NPC_ENGINE_MODE_REDIS_KEY);
+            const mode = parseNpcEngineMode(raw);
+            cachedMode = mode;
+            cachedAtMs = Date.now();
+            return mode;
+        } catch {
+            return cachedMode ?? 'organic';
+        } finally {
+            inFlight = null;
+        }
+    })();
+    return inFlight;
+}
+
+/** Drop the per-process cache (call after writing the mode key). */
+export function invalidateNpcEngineModeCache(): void {
+    cachedMode = null;
+    cachedAtMs = 0;
+}
+
+export async function isOrganicNpcEngineMode(get: Getter): Promise<boolean> {
+    return (await readNpcEngineModeFromRedis(get)) === 'organic';
+}
