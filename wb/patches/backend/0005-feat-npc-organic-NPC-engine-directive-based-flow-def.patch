+        // Initial wave: absolute delays from the round start (a late engine start still honours them).
+        const elapsedAtOpen = now - battle.startTimeMs;
+        for (const delay of wave.delaysMs) {
+            const wait = delay - elapsedAtOpen;
+            if (wait <= 0) continue;
