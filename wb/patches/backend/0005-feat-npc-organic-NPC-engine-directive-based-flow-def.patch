diff --git a/packages/shared/src/npc-organic/organic-plan.spec.ts b/packages/shared/src/npc-organic/organic-plan.spec.ts
new file mode 100644
index 0000000..6539bdf
--- /dev/null
+++ b/packages/shared/src/npc-organic/organic-plan.spec.ts
@@ -0,0 +1,181 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { DEFAULT_ORGANIC_NPC_SETTINGS, cloneOrganicSettings } from './settings';
+import {
+    arrivalsPerMinute,
+    assignTiers,
+    chooseSide,
+    drawLeadTarget,
+    drawNextArrivalDelayMs,
+    drawStake,
+    pickTier,
+    planInitialWave,
+    roundToHumanLadder,
+    seededRng,
+    sliceInjection,
+} from './organic-plan';
+
+const S = DEFAULT_ORGANIC_NPC_SETTINGS;
+
+test('initial wave: count inside the configured bounds and no NPC at 0 ms', () => {
+    const rng = seededRng(7);
+    for (let i = 0; i < 200; i++) {
+        const plan = planInitialWave(S, { isPeak: false, rng });
+        assert.ok(plan.count >= 1 && plan.count <= 5, `count ${plan.count}`);
+        assert.equal(plan.delaysMs.length, plan.count);
+        for (const d of plan.delaysMs) assert.ok(d >= 1_000 && d <= 15_000, `delay ${d}`);
+        for (let j = 1; j < plan.delaysMs.length; j++) assert.ok(plan.delaysMs[j]! >= plan.delaysMs[j - 1]!);
+    }
+    const peak = planInitialWave(S, { isPeak: true, rng });
+    assert.ok(peak.count >= 10 && peak.count <= 20);
+    for (const d of peak.delaysMs) assert.ok(d >= 1_000 && d <= 15_000);
+});
+
+test('initial wave: entry times are genuinely staggered, not synchronized', () => {
+    const rng = seededRng(99);
+    const plan = planInitialWave({ ...S, roundStart: { ...S.roundStart, initialSpawnsMin: 5, initialSpawnsMax: 5 } }, { isPeak: false, rng });
+    const distinct = new Set(plan.delaysMs.map((d) => Math.round(d / 500)));
+    assert.ok(distinct.size >= 3, `delays ${plan.delaysMs.join(',')} look synchronized`);
+});
+
+test('arrival rate ramps up monotonically to the peak, then fades to zero at the end', () => {
+    let prev = -1;
+    for (let f = 0; f <= 0.6; f += 0.05) {
+        const r = arrivalsPerMinute(S, { elapsedFraction: f, isPeak: false, realTradeBoostActive: false });
+        assert.ok(r >= prev - 1e-9, `rate fell at ${f}`);
+        prev = r;
+    }
+    assert.equal(arrivalsPerMinute(S, { elapsedFraction: 0, isPeak: false, realTradeBoostActive: false }), 4);
+    assert.equal(arrivalsPerMinute(S, { elapsedFraction: 0.6, isPeak: false, realTradeBoostActive: false }), 24);
+    assert.equal(arrivalsPerMinute(S, { elapsedFraction: 1, isPeak: false, realTradeBoostActive: false }), 0);
+    assert.ok(arrivalsPerMinute(S, { elapsedFraction: 0.3, isPeak: true, realTradeBoostActive: true }) > arrivalsPerMinute(S, { elapsedFraction: 0.3, isPeak: false, realTradeBoostActive: false }));
+});
+
+test('inter-arrival delays follow the rate and stay bounded', () => {
+    const rng = seededRng(3);
+    let sum = 0;
+    const n = 2_000;
+    for (let i = 0; i < n; i++) sum += drawNextArrivalDelayMs(24, rng);
+    const mean = sum / n;
+    assert.ok(mean > 2_000 && mean < 3_200, `mean ${mean} for 24/min should be near 2500 ms`);
+    assert.equal(drawNextArrivalDelayMs(0, rng), 60_000);
+    for (let i = 0; i < 200; i++) assert.ok(drawNextArrivalDelayMs(6_000, rng) >= 250);
+});
+
+test('tier assignment follows roster shares and every tier gets at least one NPC', () => {
+    const roster = Array.from({ length: 100 }, (_, i) => ({ id: i + 1, volumeProfile: (i * 37) % 100 }));
+    const tiers = assignTiers(roster, S);
+    assert.equal(tiers.whale.length, 5);
+    assert.equal(tiers.mid.length, 25);
+    assert.equal(tiers.retail.length, 70);
+    const byId = new Map(roster.map((r) => [r.id, r.volumeProfile]));
+    const minWhale = Math.min(...tiers.whale.map((id) => byId.get(id)!));
+    const maxRetail = Math.max(...tiers.retail.map((id) => byId.get(id)!));
+    assert.ok(minWhale >= maxRetail, 'whales must outrank retail by volume profile');
+    const tiny = assignTiers([{ id: 1, volumeProfile: 10 }, { id: 2, volumeProfile: 20 }, { id: 3, volumeProfile: 30 }], S);
+    assert.equal(tiny.whale.length + tiny.mid.length + tiny.retail.length, 3);
+    assert.ok(tiny.whale.length >= 1 && tiny.mid.length >= 1 && tiny.retail.length >= 1);
+    assert.equal(assignTiers([], S).whale.length, 0);
+});
+
+test('tier picking follows trade shares and skips empty tiers', () => {
+    const rng = seededRng(11);
+    const assignment = { whale: [1], mid: [2], retail: [3] };
+    const counts = { whale: 0, mid: 0, retail: 0 };
+    for (let i = 0; i < 5_000; i++) counts[pickTier(S, assignment, rng)!] += 1;
+    assert.ok(Math.abs(counts.whale / 5_000 - 0.1) < 0.03);
+    assert.ok(Math.abs(counts.retail / 5_000 - 0.6) < 0.03);
+    for (let i = 0; i < 100; i++) assert.notEqual(pickTier(S, { whale: [], mid: [2], retail: [3] }, rng), 'whale');
+    assert.equal(pickTier(S, { whale: [], mid: [], retail: [] }, rng), null);
+});
+
+test('stakes stay inside the tier bracket, look human and vary', () => {
+    const rng = seededRng(5);
+    const seen = new Set<number>();
+    for (let i = 0; i < 500; i++) {
+        const a = drawStake(S.tiers.whale, S, rng);
+        assert.ok(a >= 5_000 && a <= 50_000, `whale ${a}`);
+        assert.equal(a % 100, 0, `whale ${a} not on the ladder`);
+        seen.add(a);
+        const r = drawStake(S.tiers.retail, S, rng);
+        assert.ok(r >= 10 && r <= 500, `retail ${r}`);
+    }
+    assert.ok(seen.size > 30, 'whale sizes should not collapse to a few values');
+    assert.equal(roundToHumanLadder(1_234), 1_200);
+    assert.equal(roundToHumanLadder(48), 50);
+    assert.equal(roundToHumanLadder(12_345), 12_500);
+    assert.equal(roundToHumanLadder(0), 0);
+    const noLadder = cloneOrganicSettings();
+    noLadder.tiers.roundToLadder = false;
+    noLadder.tiers.sizeJitterPct = 0;
+    const exact = drawStake({ rosterSharePct: 1, tradeSharePct: 1, stakeMin: 100, stakeMax: 100 }, noLadder, rng);
+    assert.equal(exact, 100);
+});
+
+test('lead target respects the side mode and the share bounds', () => {
+    const rng = seededRng(2);
+    const follow = cloneOrganicSettings();
+    follow.asymmetry.leadSideMode = 'follow_real';
+    assert.equal(drawLeadTarget(follow, { realFavouredSide: 'SELL', rng }).side, 'SELL');
+    const against = cloneOrganicSettings();
+    against.asymmetry.leadSideMode = 'against_real';
+    assert.equal(drawLeadTarget(against, { realFavouredSide: 'SELL', rng }).side, 'BUY');
+    let buys = 0;
+    for (let i = 0; i < 1_000; i++) {
+        const t = drawLeadTarget(S, { realFavouredSide: null, rng });
+        if (t.side === 'BUY') buys += 1;
+        assert.ok(t.sharePct >= 60 && t.sharePct <= 90);
+    }
+    assert.ok(buys > 400 && buys < 600, `random lead side is biased: ${buys}`);
+});
+
+test('side choice honours the drawn asymmetry inside the organic window and softens after it', () => {
+    const rng = seededRng(8);
+    const lead = { side: 'BUY' as const, sharePct: 85 };
+    let leadHits = 0;
+    for (let i = 0; i < 4_000; i++) {
+        const c = chooseSide(S, { lead, elapsedFraction: 0.4, lastRealTradeSide: null, lastRealTradeAgeMs: null, steeringSide: null, rng });
+        if (c.side === 'BUY') leadHits += 1;
+    }
+    assert.ok(Math.abs(leadHits / 4_000 - 0.85) < 0.03, `lead share ${leadHits / 4_000}`);
+    let late = 0;
+    for (let i = 0; i < 4_000; i++) {
+        const c = chooseSide(S, { lead, elapsedFraction: 0.95, lastRealTradeSide: null, lastRealTradeAgeMs: null, steeringSide: null, rng });
+        if (c.side === 'BUY') late += 1;
+    }
+    assert.ok(Math.abs(late / 4_000 - 0.675) < 0.03, `softened share ${late / 4_000}`);
+});
+
+test('FOMO and steering take precedence with their configured probabilities', () => {
+    const rng = seededRng(13);
+    const lead = { side: 'BUY' as const, sharePct: 90 };
+    let fomo = 0;
+    for (let i = 0; i < 4_000; i++) {
+        const c = chooseSide(S, { lead, elapsedFraction: 0.5, lastRealTradeSide: 'SELL', lastRealTradeAgeMs: 3_000, steeringSide: null, rng });
+        if (c.reason === 'fomo') fomo += 1;
+    }
+    assert.ok(Math.abs(fomo / 4_000 - 0.35) < 0.03, `fomo ${fomo / 4_000}`);
+    let steer = 0;
+    for (let i = 0; i < 4_000; i++) {
+        const c = chooseSide(S, { lead, elapsedFraction: 0.5, lastRealTradeSide: 'SELL', lastRealTradeAgeMs: 60_000, steeringSide: 'SELL', rng });
+        if (c.reason === 'steering') steer += 1;
+    }
+    assert.ok(Math.abs(steer / 4_000 - 0.5) < 0.03, `steering ${steer / 4_000}`);
+    const early = chooseSide(S, { lead, elapsedFraction: 0.1, lastRealTradeSide: null, lastRealTradeAgeMs: null, steeringSide: 'SELL', rng });
+    assert.notEqual(early.reason, 'steering', 'steering must wait for its start fraction');
+});
+
+test('injection slicing sums exactly and never exceeds the slice cap', () => {
+    const rng = seededRng(21);
+    for (let i = 0; i < 200; i++) {
+        const total = Number((rng() * 90_000 + 1_000).toFixed(2));
+        const slices = sliceInjection(total, [1, 2, 3, 4, 5], 3, rng);
+        assert.ok(slices.length >= 1 && slices.length <= 3);
+        const sum = Number(slices.reduce((a, s) => a + s.amount, 0).toFixed(2));
+        assert.equal(sum, total);
+        for (const s of slices) assert.ok(s.amount > 0);
+    }
+    assert.deepEqual(sliceInjection(500, [9], 3, rng), [{ npcId: 9, amount: 500 }]);
+    assert.deepEqual(sliceInjection(0, [9], 3, rng), []);
+    assert.deepEqual(sliceInjection(100, [], 3, rng), []);
+});
diff --git a/packages/shared/src/npc-organic/organic-plan.ts b/packages/shared/src/npc-organic/organic-plan.ts
new file mode 100644
index 0000000..87084eb
--- /dev/null
+++ b/packages/shared/src/npc-organic/organic-plan.ts
@@ -0,0 +1,309 @@
+/**
+ * Pure planners for the organic NPC flow. No I/O, no timers — every function takes an explicit
+ * random source so the engine and the tests can reproduce a round exactly.
+ */
+import type { OrganicNpcSettings, OrganicTierSettings } from './settings';
+
+export type Rng = () => number;
+export type NpcSide = 'BUY' | 'SELL';
+export type OrganicTier = 'whale' | 'mid' | 'retail';
+
+export const ORGANIC_TIERS: readonly OrganicTier[] = ['whale', 'mid', 'retail'] as const;
+
+/** Deterministic PRNG (mulberry32) for reproducible plans in tests and audits. */
+export function seededRng(seed: number): Rng {
+    let a = seed >>> 0;
+    return () => {
+        a = (a + 0x6d2b79f5) >>> 0;
+        let t = a;
+        t = Math.imul(t ^ (t >>> 15), t | 1);
+        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+}
+
+export function randInt(rng: Rng, min: number, max: number): number {
+    const lo = Math.ceil(Math.min(min, max));
+    const hi = Math.floor(Math.max(min, max));
+    return lo + Math.floor(rng() * (hi - lo + 1));
+}
+
+export function randBetween(rng: Rng, min: number, max: number): number {
+    const lo = Math.min(min, max);
+    const hi = Math.max(min, max);
+    return lo + rng() * (hi - lo);
+}
+
+// ---------------------------------------------------------------------------
+// Round start: the "trickle-in" first wave
+// ---------------------------------------------------------------------------
+
+export interface InitialWavePlan {
+    count: number;
+    /** Milliseconds after round start, ascending. Never 0. */
+    delaysMs: number[];
+    peak: boolean;
+}
+
+export function planInitialWave(
+    settings: OrganicNpcSettings,
+    opts: { isPeak: boolean; rng: Rng },
+): InitialWavePlan {
+    const r = settings.roundStart;
+    const count = opts.isPeak
+        ? randInt(opts.rng, r.peakInitialSpawnsMin, r.peakInitialSpawnsMax)
+        : randInt(opts.rng, r.initialSpawnsMin, r.initialSpawnsMax);
+    const lo = Math.max(1, r.spawnDelayMinMs);
+    const hi = opts.isPeak ? Math.max(lo, r.peakInitialWindowMs) : Math.max(lo, r.spawnDelayMaxMs);
+    const delays: number[] = [];
+    for (let i = 0; i < count; i++) {
+        delays.push(Math.round(randBetween(opts.rng, lo, hi)));
+    }
+    delays.sort((a, b) => a - b);
+    return { count, delaysMs: delays, peak: opts.isPeak };
+}
+
+// ---------------------------------------------------------------------------
+// Momentum: arrival rate over the round
+// ---------------------------------------------------------------------------
+
+export interface ArrivalRateContext {
+    elapsedFraction: number;
+    isPeak: boolean;
+    realTradeBoostActive: boolean;
+}
+
+/** NPC arrivals per minute at this point of the round (0 once the late fade completes). */
+export function arrivalsPerMinute(settings: OrganicNpcSettings, ctx: ArrivalRateContext): number {
+    const m = settings.momentum;
+    const f = Math.max(0, Math.min(1, ctx.elapsedFraction));
+    const ramp = m.rampToPeakFraction > 0 ? Math.min(1, f / m.rampToPeakFraction) : 1;
+    let rate = m.baseArrivalsPerMinute + (m.peakArrivalsPerMinute - m.baseArrivalsPerMinute) * ramp;
+    if (f >= m.lateFadeFraction) {
+        const span = Math.max(1e-9, 1 - m.lateFadeFraction);
+        rate *= Math.max(0, 1 - (f - m.lateFadeFraction) / span);
+    }
+    if (ctx.isPeak) rate *= m.peakHoursMultiplier;
+    if (ctx.realTradeBoostActive) rate *= m.realTradeBoostMultiplier;
+    return Math.max(0, rate);
+}
+
+export const MIN_ARRIVAL_GAP_MS = 250;
+export const MAX_ARRIVAL_GAP_MS = 60_000;
+
+/** Exponential inter-arrival delay for a Poisson process with `ratePerMinute`. */
+export function drawNextArrivalDelayMs(ratePerMinute: number, rng: Rng): number {
+    if (!(ratePerMinute > 0)) return MAX_ARRIVAL_GAP_MS;
+    const lambdaPerMs = ratePerMinute / 60_000;
+    const u = Math.min(0.999999, Math.max(1e-9, rng()));
+    const delay = -Math.log(1 - u) / lambdaPerMs;
+    return Math.round(Math.min(MAX_ARRIVAL_GAP_MS, Math.max(MIN_ARRIVAL_GAP_MS, delay)));
+}
+
+export function drawQuietPeriodMs(settings: OrganicNpcSettings, rng: Rng): number {
+    const m = settings.momentum;
+    if (rng() * 100 >= m.quietPeriodChancePct) return 0;
+    return Math.round(randBetween(rng, m.quietPeriodMinSec, m.quietPeriodMaxSec) * 1000);
+}
+
+// ---------------------------------------------------------------------------
+// Tiers
+// ---------------------------------------------------------------------------
+
+export interface RosterRow {
+    id: number;
+    volumeProfile: number | null | undefined;
+}
+
+export interface TierAssignment {
+    whale: number[];
+    mid: number[];
+    retail: number[];
+}
+
+/** Stable hash so ties in volume profile do not always favour the lowest id. */
+function idHash(id: number): number {
+    let h = Math.imul(id ^ 0x9e3779b9, 0x85ebca6b);
+    h ^= h >>> 13;
+    h = Math.imul(h, 0xc2b2ae35);
+    return (h ^ (h >>> 16)) >>> 0;
+}
+
+/**
+ * Splits the roster into tiers by volume-profile rank: the top `whale.rosterSharePct` are whales,
+ * the next `mid.rosterSharePct` are mid, everyone else retail. Every tier gets at least one NPC when
+ * the roster has three or more.
+ */
+export function assignTiers(roster: RosterRow[], settings: OrganicNpcSettings): TierAssignment {
+    const sorted = [...roster].sort((a, b) => {
+        const d = (Number(b.volumeProfile ?? 50) || 0) - (Number(a.volumeProfile ?? 50) || 0);
+        return d !== 0 ? d : idHash(a.id) - idHash(b.id);
+    });
+    const n = sorted.length;
+    const t = settings.tiers;
+    const total = Math.max(1e-9, t.whale.rosterSharePct + t.mid.rosterSharePct + t.retail.rosterSharePct);
+    let whaleCount = Math.round((n * t.whale.rosterSharePct) / total);
+    let midCount = Math.round((n * t.mid.rosterSharePct) / total);
+    if (n >= 3) {
+        whaleCount = Math.max(1, whaleCount);
+        midCount = Math.max(1, midCount);
+        if (whaleCount + midCount >= n) {
+            midCount = Math.max(1, n - whaleCount - 1);
+            whaleCount = Math.max(1, n - midCount - 1);
+        }
+    } else {
+        whaleCount = Math.min(whaleCount, n);
+        midCount = Math.min(midCount, n - whaleCount);
+    }
+    return {
+        whale: sorted.slice(0, whaleCount).map((r) => r.id),
+        mid: sorted.slice(whaleCount, whaleCount + midCount).map((r) => r.id),
+        retail: sorted.slice(whaleCount + midCount).map((r) => r.id),
+    };
+}
+
+/** Picks a tier weighted by `tradeSharePct`, skipping tiers with no members. */
+export function pickTier(settings: OrganicNpcSettings, assignment: TierAssignment, rng: Rng): OrganicTier | null {
+    const weights = ORGANIC_TIERS.map((tier) => (assignment[tier].length > 0 ? Math.max(0, settings.tiers[tier].tradeSharePct) : 0));
+    const total = weights.reduce((a, b) => a + b, 0);
+    if (total <= 0) {
+        const nonEmpty = ORGANIC_TIERS.filter((tier) => assignment[tier].length > 0);
+        return nonEmpty.length ? nonEmpty[Math.floor(rng() * nonEmpty.length)]! : null;
+    }
+    let roll = rng() * total;
+    for (let i = 0; i < ORGANIC_TIERS.length; i++) {
+        roll -= weights[i]!;
+        if (roll <= 0) return ORGANIC_TIERS[i]!;
+    }
+    return ORGANIC_TIERS[ORGANIC_TIERS.length - 1]!;
+}
+
+// ---------------------------------------------------------------------------
+// Stake sizes
+// ---------------------------------------------------------------------------
+
+/** Rounds to an amount a person would type: 5s below 100, 25s below 1k, 100s below 10k, 500s below 100k, 1000s above. */
+export function roundToHumanLadder(amount: number): number {
+    if (!(amount > 0)) return 0;
+    const step = amount < 100 ? 5 : amount < 1_000 ? 25 : amount < 10_000 ? 100 : amount < 100_000 ? 500 : 1_000;
+    return Math.max(step, Math.round(amount / step) * step);
+}
+
+/** Log-uniform draw inside the tier bracket with jitter, then ladder rounding (clamped to the bracket). */
+export function drawStake(tier: OrganicTierSettings, settings: OrganicNpcSettings, rng: Rng): number {
+    const lo = Math.max(0.01, Math.min(tier.stakeMin, tier.stakeMax));
+    const hi = Math.max(lo, Math.max(tier.stakeMin, tier.stakeMax));
+    const u = rng();
+    let amount = Math.exp(Math.log(lo) + u * (Math.log(hi) - Math.log(lo)));
+    const jitter = Math.max(0, settings.tiers.sizeJitterPct) / 100;
+    amount *= 1 + (rng() * 2 - 1) * jitter;
+    if (settings.tiers.roundToLadder) amount = roundToHumanLadder(amount);
+    amount = Math.min(hi, Math.max(lo, amount));
+    return Number(amount.toFixed(2));
+}
+
+// ---------------------------------------------------------------------------
+// Asymmetry and side choice
+// ---------------------------------------------------------------------------
+
+export interface LeadTarget {
+    side: NpcSide;
+    sharePct: number;
+}
+
+export function drawLeadTarget(
+    settings: OrganicNpcSettings,
+    ctx: { realFavouredSide: NpcSide | null; rng: Rng },
+): LeadTarget {
+    const a = settings.asymmetry;
+    let side: NpcSide;
+    if (a.leadSideMode === 'follow_real' && ctx.realFavouredSide) side = ctx.realFavouredSide;
+    else if (a.leadSideMode === 'against_real' && ctx.realFavouredSide) side = ctx.realFavouredSide === 'BUY' ? 'SELL' : 'BUY';
+    else side = ctx.rng() < 0.5 ? 'BUY' : 'SELL';
+    const sharePct = randBetween(ctx.rng, a.leadSharePctMin, a.leadSharePctMax);
+    return { side, sharePct: Number(sharePct.toFixed(2)) };
+}
+
+export interface SideChoiceInput {
+    lead: LeadTarget;
+    elapsedFraction: number;
+    /** NpcSide of the most recent real trade and how long ago it landed (ms), if any. */
+    lastRealTradeSide: NpcSide | null;
+    lastRealTradeAgeMs: number | null;
+    /** NpcSide that lowers projected company exposure right now (Defense A), if steering applies. */
+    steeringSide: NpcSide | null;
+    rng: Rng;
+}
+
+export type SideChoiceReason = 'fomo' | 'steering' | 'lead' | 'other';
+
+/**
+ * NpcSide for one organic order. Order of precedence: FOMO after a real trade, continuous steering,
+ * then the drawn asymmetry target (softened after the organic window).
+ */
+export function chooseSide(settings: OrganicNpcSettings, input: SideChoiceInput): { side: NpcSide; reason: SideChoiceReason } {
+    const a = settings.asymmetry;
+    const d = settings.defenses;
+    const boostMs = settings.momentum.realTradeBoostSeconds * 1000;
+    if (
+        input.lastRealTradeSide &&
+        input.lastRealTradeAgeMs != null &&
+        input.lastRealTradeAgeMs <= boostMs &&
+        input.rng() * 100 < a.fomoFollowStrengthPct
+    ) {
+        return { side: input.lastRealTradeSide, reason: 'fomo' };
+    }
+    if (
+        d.steeringEnabled &&
+        input.steeringSide &&
+        input.elapsedFraction >= d.steeringStartFraction &&
+        input.rng() * 100 < d.steeringStrengthPct
+    ) {
+        return { side: input.steeringSide, reason: 'steering' };
+    }
+    let pLead = Math.max(0, Math.min(1, input.lead.sharePct / 100));
+    if (input.elapsedFraction > a.organicWindowFraction) {
+        // After the organic window the flow drifts toward balance but keeps a mild lean.
+        pLead = 0.5 + (pLead - 0.5) * 0.5;
+    }
+    const takeLead = input.rng() < pLead;
+    const other: NpcSide = input.lead.side === 'BUY' ? 'SELL' : 'BUY';
+    return takeLead ? { side: input.lead.side, reason: 'lead' } : { side: other, reason: 'other' };
+}
+
+// ---------------------------------------------------------------------------
+// Final injection slicing
+// ---------------------------------------------------------------------------
+
+export interface InjectionSlice {
+    npcId: number;
+    amount: number;
+}
+
+/**
+ * Splits `total` across up to `maxSlices` whale NPCs with uneven, human-looking shares. The sum
+ * of the slices equals `total` to the cent.
+ */
+export function sliceInjection(total: number, npcIds: number[], maxSlices: number, rng: Rng): InjectionSlice[] {
+    const amount = Number(Math.max(0, total).toFixed(2));
+    if (amount <= 0 || npcIds.length === 0) return [];
+    const n = Math.max(1, Math.min(maxSlices, npcIds.length, amount >= 1_000 ? maxSlices : 1));
+    if (n === 1) return [{ npcId: npcIds[0]!, amount }];
+    const weights: number[] = [];
+    for (let i = 0; i < n; i++) weights.push(0.5 + rng());
+    const sum = weights.reduce((a, b) => a + b, 0);
+    const slices: InjectionSlice[] = [];
+    let assigned = 0;
+    for (let i = 0; i < n; i++) {
+        const raw = i === n - 1 ? amount - assigned : Number(((amount * weights[i]!) / sum).toFixed(2));
+        const part = Number(Math.max(0.01, raw).toFixed(2));
+        assigned += part;
+        slices.push({ npcId: npcIds[i]!, amount: part });
+    }
+    const drift = Number((amount - assigned).toFixed(2));
+    if (drift !== 0) {
+        const last = slices[slices.length - 1]!;
+        last.amount = Number((last.amount + drift).toFixed(2));
+    }
+    return slices.filter((s) => s.amount > 0);
+}
