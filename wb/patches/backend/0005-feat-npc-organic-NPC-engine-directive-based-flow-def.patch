diff --git a/packages/shared/src/npc-organic/directive-settlement.spec.ts b/packages/shared/src/npc-organic/directive-settlement.spec.ts
new file mode 100644
index 0000000..a8e4202
--- /dev/null
+++ b/packages/shared/src/npc-organic/directive-settlement.spec.ts
@@ -0,0 +1,307 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    computeDirectiveSettlement,
+    computeUserNetPositions,
+    planFinalInjection,
+    resolveDirectiveWinner,
+    steeringSideFor,
+    summarizeNetReal,
+    type DirectiveNpcTrade,
+    type DirectiveRealStake,
+    type DirectiveRoundInput,
+} from './directive-settlement';
+import { seededRng } from './organic-plan';
+
+const T0 = Date.parse('2026-09-13T10:00:00Z');
+const END = T0 + 300_000;
+const FEE = 0.3;
+
+function pricePath(start: number, end: number): Array<{ price: number; timestampMs: number }> {
+    const pts = [];
+    for (let i = 0; i <= 60; i++) {
+        pts.push({ price: start + ((end - start) * i) / 60, timestampMs: T0 + i * 5_000 });
+    }
+    return pts;
+}
+
+function round(input: Partial<DirectiveRoundInput> & { realStakes: DirectiveRealStake[]; npcTrades: DirectiveNpcTrade[] }): DirectiveRoundInput {
+    const start = 1.2;
+    const end = input.finalPrice ?? 1.23;
+    let buy = 0;
+    let sell = 0;
+    for (const s of input.realStakes) (s.side === 'BUY' ? (buy += s.amount) : (sell += s.amount));
+    for (const t of input.npcTrades) (t.side === 'BUY' ? (buy += t.amount) : (sell += t.amount));
+    return {
+        buyPot: input.buyPot ?? buy,
+        sellPot: input.sellPot ?? sell,
+        realStakes: input.realStakes,
+        npcTrades: input.npcTrades,
+        finalPrice: end,
+        startPrice: start,
+        roundHigh: Math.max(start, end),
+        roundLow: Math.min(start, end),
+        pricePoints: pricePath(start, end),
+        platformFeeRate: FEE,
+        houseMaxRealLoserPoolRule: input.houseMaxRealLoserPoolRule,
+        maxSimulatorLossUsd: input.maxSimulatorLossUsd,
+    };
+}
+
+const stake = (id: number, userId: number, side: 'BUY' | 'SELL', amount: number, atSec = 30): DirectiveRealStake => ({
+    id,
+    userId,
+    side,
+    amount,
+    entryPrice: 1.2,
+    entryTimestampMs: T0 + atSec * 1000,
+});
+const npc = (id: number, side: 'BUY' | 'SELL', amount: number, atSec = 30): DirectiveNpcTrade => ({
+    id,
+    npcId: 1000 + id,
+    side,
+    amount,
+    entryPrice: 1.2,
+    entryTimestampMs: T0 + atSec * 1000,
+});
+
+function sum(map: Map<number, { credit: number; profit: number }>, key: 'credit' | 'profit'): number {
+    let s = 0;
+    for (const v of map.values()) s += v[key];
+    return s;
+}
+
+function assertInvariants(input: DirectiveRoundInput, label: string) {
+    const r = computeDirectiveSettlement(input);
+    if (r.winnerSide === 'TIE') {
+        assert.equal(sum(r.stakes, 'credit'), Number(input.realStakes.reduce((a, s) => a + s.amount, 0).toFixed(2)), `${label}: tie refunds everything`);
+        return r;
+    }
+    const realIn = input.realStakes.reduce((a, s) => a + s.amount, 0);
+    const realOut = sum(r.stakes, 'credit') + sum(r.stakes, 'profit');
+    const simIn = input.npcTrades.reduce((a, t) => a + t.amount, 0);
+    const simOut = sum(r.npcTrades, 'credit') + sum(r.npcTrades, 'profit');
+    // Money conservation: everything that came in leaves as real payouts, simulator returns or company net.
+    assert.ok(Math.abs(realIn + simIn - (realOut + simOut + r.companyNet)) < 0.05, `${label}: conservation ${realIn + simIn} vs ${realOut + simOut + r.companyNet}`);
+    // Company earns the commission on the real losing pool (plus the unpaid pool only when nobody real won).
+    assert.ok(Math.abs(r.commission - r.realLosingVolume * FEE) < 1e-6, `${label}: commission`);
+    if (r.realWinnerUserCount > 0) {
+        assert.ok(Math.abs(r.companyNet - r.commission) < 0.05, `${label}: company net must equal the commission`);
+    }
+    // Simulator never profits above its seed.
+    assert.ok(r.simulatorNet <= 1e-6, `${label}: simulator profited ${r.simulatorNet}`);
+    assert.ok(Math.abs(simOut - simIn - r.simulatorNet) < 0.05, `${label}: simulator cash flow`);
+    // Real winners collectively receive R plus any simulator surplus; never less than R when protected.
+    if (r.realWinnerUserCount > 0 && r.realLoserUserCount > 0) {
+        assert.ok(r.realWinnersTotal + 1e-6 >= r.netRealLoserPool, `${label}: real winners got less than R`);
+    }
+    return r;
+}
+
+test('mixed round: the real winners share exactly R when the simulator is not diluted below its seed', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'BUY', 1_000, 10), stake(2, 2, 'SELL', 4_000, 20)],
+        npcTrades: [npc(1, 'BUY', 20_000, 5), npc(2, 'SELL', 3_000, 40)],
+    });
+    const r = assertInvariants(input, 'mixed');
+    assert.equal(r.winnerSide, 'BUY');
+    assert.equal(r.realLosingVolume, 4_000);
+    assert.ok(Math.abs(r.netRealLoserPool - 2_800) < 1e-6);
+    // Simulator holds most of the winning score, so its raw share exceeds its seed and the surplus flows to the real winner.
+    assert.ok(r.simProfitRaw > r.simLosingVolume);
+    assert.ok(Math.abs(r.simProfit - r.simLosingVolume) < 1e-6);
+    assert.ok(Math.abs(r.realWinnersTotal - r.netRealLoserPool) < 1e-6, 'real winner receives exactly R');
+    assert.ok(Math.abs(r.simulatorNet) < 1e-6, 'simulator breaks even');
+    assert.ok(Math.abs(r.companyNet - 1_200) < 1e-6);
+    const winner = r.stakes.get(1)!;
+    assert.equal(winner.status, 'WON');
+    assert.ok(Math.abs(winner.credit + winner.profit - (1_000 + 2_800)) < 0.01);
+    assert.equal(r.stakes.get(2)!.status, 'LOST');
+    assert.equal(r.stakes.get(2)!.credit, 0);
+});
+
+test('exposure case: an early real whale takes simulator seed unless the final injection lands', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'BUY', 50_000, 2), stake(2, 2, 'SELL', 5_000, 100)],
+        npcTrades: [npc(1, 'BUY', 2_000, 200), npc(2, 'SELL', 40_000, 20)],
+    });
+    const before = computeDirectiveSettlement(input);
+    assert.equal(before.winnerSide, 'BUY');
+    assert.ok(before.realWinnersTotal > before.netRealLoserPool + 1, 'whale would take simulator seed');
+    assert.ok(before.simulatorNet < 0);
+
+    const plan = planFinalInjection(input, {
+        dilutionEnabled: true,
+        dilutionSafetyMarginPct: 0,
+        ghostTownEnabled: true,
+        ghostTownMarginPct: 5,
+        maxUsd: 0,
+        nowMs: END - 150,
+        currentPrice: input.finalPrice,
+    });
+    assert.equal(plan.kind, 'dilution');
+    assert.equal(plan.side, 'BUY');
+    assert.ok(plan.amount > 0);
+    assert.ok(plan.projected.realWinnersTotalAfter <= before.netRealLoserPool + 0.05, `after ${plan.projected.realWinnersTotalAfter} vs R ${before.netRealLoserPool}`);
+    assert.ok(plan.projected.realWinnersTotalAfter >= before.netRealLoserPool - 5, 'injection is minimal, not a sledgehammer');
+
+    const after = assertInvariants(
+        { ...input, buyPot: input.buyPot + plan.amount, npcTrades: [...input.npcTrades, { id: 99, npcId: 9, side: 'BUY', amount: plan.amount, entryPrice: input.finalPrice, entryTimestampMs: END - 150 }] },
+        'after injection',
+    );
+    assert.ok(Math.abs(after.simulatorNet) < 0.05, `simulator net after injection ${after.simulatorNet}`);
+    assert.ok(Math.abs(after.realWinnersTotal - after.netRealLoserPool) < 0.05);
+});
+
+test('safety margin and cap are applied to the injection', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'BUY', 50_000, 2), stake(2, 2, 'SELL', 5_000, 100)],
+        npcTrades: [npc(1, 'BUY', 2_000, 200), npc(2, 'SELL', 40_000, 20)],
+    });
+    const base = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 0, ghostTownEnabled: false, ghostTownMarginPct: 0, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    const margin = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 10, ghostTownEnabled: false, ghostTownMarginPct: 0, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.ok(Math.abs(margin.amount / base.amount - 1.1) < 0.001);
+    const capped = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 0, ghostTownEnabled: false, ghostTownMarginPct: 0, maxUsd: 1_000, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.equal(capped.amount, 1_000);
+    assert.equal(capped.capped, true);
+    const off = planFinalInjection(input, { dilutionEnabled: false, dilutionSafetyMarginPct: 0, ghostTownEnabled: false, ghostTownMarginPct: 0, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.equal(off.kind, 'none');
+});
+
+test('no injection when the real winners are already within the pool', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'BUY', 1_000, 10), stake(2, 2, 'SELL', 4_000, 20)],
+        npcTrades: [npc(1, 'BUY', 20_000, 5), npc(2, 'SELL', 3_000, 40)],
+    });
+    const plan = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 2, ghostTownEnabled: true, ghostTownMarginPct: 5, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.equal(plan.kind, 'none');
+    assert.equal(plan.reason, 'real_winners_within_pool');
+});
+
+test('ghost town: all real users on one side → the other side must lead by the margin and the simulator wins', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'BUY', 30_000, 10), stake(2, 2, 'BUY', 20_000, 50)],
+        npcTrades: [npc(1, 'BUY', 5_000, 5), npc(2, 'SELL', 12_000, 40)],
+    });
+    const plan = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 2, ghostTownEnabled: true, ghostTownMarginPct: 5, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.equal(plan.kind, 'ghost_town');
+    assert.equal(plan.side, 'SELL');
+    assert.ok(Math.abs(plan.amount - (55_000 * 1.05 - 12_000 + 0.01)) < 0.02);
+    assert.equal(plan.projected.winner, 'SELL');
+    const after = assertInvariants(
+        { ...input, sellPot: input.sellPot + plan.amount, npcTrades: [...input.npcTrades, { id: 99, npcId: 9, side: 'SELL', amount: plan.amount, entryPrice: input.finalPrice, entryTimestampMs: END - 150 }] },
+        'ghost town',
+    );
+    assert.equal(after.winnerSide, 'SELL');
+    assert.equal(after.realWinnerUserCount, 0);
+    assert.ok(Math.abs(after.commission - 50_000 * FEE) < 1e-6);
+    assert.ok(Math.abs(after.houseRetained - 50_000 * (1 - FEE)) < 0.05, 'unpaid real pool stays with the house');
+    assert.ok(Math.abs(after.simulatorNet) < 0.05, 'simulator recovers its seed');
+    const already = planFinalInjection({ ...input, sellPot: 80_000 }, { dilutionEnabled: true, dilutionSafetyMarginPct: 2, ghostTownEnabled: true, ghostTownMarginPct: 5, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+    assert.equal(already.reason, 'ghost_town_already_leading');
+});
+
+test('ghost town off: real winners on one side are funded by simulator seed, bounded by the cap', () => {
+    const base = round({
+        realStakes: [stake(1, 1, 'BUY', 10_000, 10)],
+        npcTrades: [npc(1, 'BUY', 1_000, 5), npc(2, 'SELL', 6_000, 40)],
+    });
+    const unlimited = assertInvariants(base, 'fallback unlimited');
+    assert.equal(unlimited.winnerSide, 'BUY');
+    assert.equal(unlimited.realLosingVolume, 0);
+    assert.ok(unlimited.realWinnersTotal > 0 && unlimited.realWinnersTotal <= 6_000);
+    assert.ok(Math.abs(unlimited.simulatorNet + unlimited.realWinnersTotal) < 0.05, 'seed loss equals what real winners received');
+    const capped = assertInvariants({ ...base, maxSimulatorLossUsd: 500 }, 'fallback capped');
+    assert.ok(Math.abs(capped.realWinnersTotal - 500) < 0.05);
+    assert.ok(Math.abs(capped.simulatorNet + 500) < 0.05);
+});
+
+test('net positions: matched hedge portions are returned untouched on both sides', () => {
+    const input = round({
+        realStakes: [stake(1, 1, 'SELL', 1_000, 10), stake(2, 1, 'BUY', 2_000, 20), stake(3, 2, 'SELL', 3_000, 30), stake(4, 3, 'BUY', 700, 40), stake(5, 3, 'SELL', 700, 45)],
+        npcTrades: [npc(1, 'BUY', 10_000, 5), npc(2, 'SELL', 500, 40)],
+    });
+    const users = computeUserNetPositions(input.realStakes);
+    assert.deepEqual({ side: users.get(1)!.side, net: users.get(1)!.net, matched: users.get(1)!.matched }, { side: 'BUY', net: 1_000, matched: 1_000 });
+    assert.equal(users.get(3)!.side, null, 'fully hedged user has no net side');
+    const summary = summarizeNetReal(users);
+    assert.deepEqual(summary, { buyNet: 1_000, sellNet: 3_000, buyUsers: 1, sellUsers: 1 });
+    const r = assertInvariants(input, 'hedge');
+    assert.equal(r.winnerSide, 'BUY');
+    assert.equal(r.realLosingVolume, 3_000);
+    assert.equal(r.stakes.get(1)!.credit, 1_000, 'matched SELL leg comes back');
+    assert.equal(r.stakes.get(1)!.status, 'REFUNDED');
+    assert.equal(r.stakes.get(2)!.status, 'WON');
+    assert.equal(r.stakes.get(2)!.credit, 2_000);
+    assert.equal(r.stakes.get(2)!.participating, 1_000, 'only the net $1,000 is scored');
+    assert.ok(r.stakes.get(2)!.profit > 0);
+    assert.equal(r.stakes.get(4)!.status, 'REFUNDED');
+    assert.equal(r.stakes.get(5)!.status, 'REFUNDED');
+    // A partially hedged net loser gets the matched share of each losing stake back.
+    const loser = round({
+        realStakes: [stake(1, 1, 'BUY', 500, 10), stake(2, 1, 'SELL', 2_000, 20), stake(3, 2, 'BUY', 5_000, 30)],
+        npcTrades: [npc(1, 'BUY', 100, 5)],
+    });
+    const lr = assertInvariants(loser, 'partial loser');
+    assert.equal(lr.winnerSide, 'BUY');
+    assert.equal(lr.realLosingVolume, 1_500);
+    assert.equal(lr.stakes.get(1)!.credit, 500);
+    assert.equal(lr.stakes.get(2)!.credit, 500);
+    assert.equal(lr.stakes.get(2)!.status, 'LOST');
+});
+
+test('tie refunds everyone and the house winner rule is opt-in', () => {
+    const tie = round({ realStakes: [stake(1, 1, 'BUY', 100), stake(2, 2, 'SELL', 100)], npcTrades: [] });
+    const tr = computeDirectiveSettlement(tie);
+    assert.equal(tr.winnerSide, 'TIE');
+    assert.equal(tr.stakes.get(1)!.status, 'REFUNDED');
+    const summary = { buyNet: 1_000, sellNet: 5_000, buyUsers: 1, sellUsers: 1 };
+    assert.equal(resolveDirectiveWinner({ buyPot: 10_000, sellPot: 20_000, real: summary }).winner, 'SELL');
+    assert.equal(resolveDirectiveWinner({ buyPot: 10_000, sellPot: 20_000, real: summary, houseMaxRealLoserPoolRule: true }).winner, 'BUY');
+});
+
+test('steering side points against real winners only while they are ahead of the pool', () => {
+    const exposed = round({
+        realStakes: [stake(1, 1, 'BUY', 50_000, 2), stake(2, 2, 'SELL', 5_000, 100)],
+        npcTrades: [npc(1, 'BUY', 2_000, 200), npc(2, 'SELL', 40_000, 20)],
+    });
+    assert.equal(steeringSideFor(exposed, exposed.finalPrice), 'SELL');
+    const safe = round({
+        realStakes: [stake(1, 1, 'BUY', 1_000, 10), stake(2, 2, 'SELL', 4_000, 20)],
+        npcTrades: [npc(1, 'BUY', 20_000, 5), npc(2, 'SELL', 3_000, 40)],
+    });
+    assert.equal(steeringSideFor(safe, safe.finalPrice), null);
+});
+
+test('property: invariants hold across randomised rounds and the solver always protects the simulator', () => {
+    const rng = seededRng(4242);
+    for (let n = 0; n < 250; n++) {
+        const realStakes: DirectiveRealStake[] = [];
+        const npcTrades: DirectiveNpcTrade[] = [];
+        const users = 1 + Math.floor(rng() * 6);
+        let id = 1;
+        for (let u = 1; u <= users; u++) {
+            const legs = 1 + Math.floor(rng() * 3);
+            for (let l = 0; l < legs; l++) {
+                realStakes.push(stake(id++, u, rng() < 0.5 ? 'BUY' : 'SELL', Math.round(10 + rng() * 60_000), Math.floor(rng() * 290)));
+            }
+        }
+        const trades = Math.floor(rng() * 12);
+        for (let t = 0; t < trades; t++) {
+            npcTrades.push(npc(t + 1, rng() < 0.5 ? 'BUY' : 'SELL', Math.round(10 + rng() * 30_000), Math.floor(rng() * 290)));
+        }
+        const input = round({ realStakes, npcTrades, finalPrice: 1.15 + rng() * 0.1 });
+        assertInvariants(input, `random #${n}`);
+        const plan = planFinalInjection(input, { dilutionEnabled: true, dilutionSafetyMarginPct: 1, ghostTownEnabled: true, ghostTownMarginPct: 3, maxUsd: 0, nowMs: END - 150, currentPrice: input.finalPrice });
+        if (plan.kind === 'none') continue;
+        const side = plan.side!;
+        const after = computeDirectiveSettlement({
+            ...input,
+            buyPot: input.buyPot + (side === 'BUY' ? plan.amount : 0),
+            sellPot: input.sellPot + (side === 'SELL' ? plan.amount : 0),
+            npcTrades: [...npcTrades, { id: 999, npcId: 9, side, amount: plan.amount, entryPrice: input.finalPrice, entryTimestampMs: END - 150 }],
+        });
+        assert.ok(after.simulatorNet >= -0.05, `random #${n}: simulator still exposed after ${plan.kind} (${after.simulatorNet})`);
+        if (plan.kind === 'ghost_town') assert.equal(after.realWinnerUserCount, 0, `random #${n}: ghost town must leave no real winners`);
+    }
+});
