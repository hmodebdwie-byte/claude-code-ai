@@ -0,0 +1,63 @@
+import type { NpcEngineMode } from '@ticktrade/shared';
+import type { NpcSimulatorService } from '../npc/npc-simulator.service';
+import type { OrganicEngineBundle } from './create-organic-engine';
+
+/**
+ * Routes the admin START/STOP desire to the engine selected by `npc_engine_mode` and switches
+ * engines live when the mode changes. Exactly one of the two engines trades at any time.
+ */
+export class NpcEngineSwitch {
+    private desired = false;
+    private lastMode: NpcEngineMode | null = null;
+
+    constructor(
+        private readonly legacy: NpcSimulatorService,
+        private readonly organic: OrganicEngineBundle,
+    ) {
+        organic.settings.onChange((_doc, mode) => this.applyMode(mode));
+    }
+
+    mode(): NpcEngineMode {
+        return this.organic.settings.mode();
+    }
+
+    isOrganic(): boolean {
+        return this.mode() === 'organic';
+    }
+
+    isActive(): boolean {
+        return this.isOrganic() ? this.organic.engine.isActive() : this.legacy.isActive();
+    }
+
+    start(): boolean {
+        this.desired = true;
+        this.lastMode = this.mode();
+        if (this.isOrganic()) {
+            if (this.legacy.isActive()) this.legacy.stop();
+            return this.organic.engine.start();
+        }
+        if (this.organic.engine.isActive()) this.organic.engine.stop();
+        return this.legacy.start();
+    }
+
+    stop(): boolean {
+        this.desired = false;
+        const a = this.organic.engine.isActive() ? this.organic.engine.stop() : false;
+        const b = this.legacy.isActive() ? this.legacy.stop() : false;
+        return a || b;
+    }
+
+    private applyMode(mode: NpcEngineMode): void {
+        if (!this.desired) return;
+        const changed = this.lastMode !== mode;
+        this.lastMode = mode;
+        if (mode === 'organic') {
+            if (this.legacy.isActive()) this.legacy.stop();
+            if (!this.organic.engine.isActive()) this.organic.engine.start();
+        } else {
+            if (this.organic.engine.isActive()) this.organic.engine.stop();
+            if (!this.legacy.isActive()) this.legacy.start();
+        }
+        if (changed) console.log(`[NpcEngineSwitch] mode → ${mode}`);
+    }
+}
diff --git a/apps/engine/src/npc-organic/organic-npc-engine.spec.ts b/apps/engine/src/npc-organic/organic-npc-engine.spec.ts
