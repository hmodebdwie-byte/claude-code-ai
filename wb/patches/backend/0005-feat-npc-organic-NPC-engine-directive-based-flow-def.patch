+export function getPath(obj: unknown, path: string): unknown {
+    let cur: unknown = obj;
+    for (const part of path.split('.')) {
+        if (cur == null || typeof cur !== 'object') return undefined;
+        cur = (cur as Record<string, unknown>)[part];
+    }
+    return cur;
+}
+
+export function setPath(obj: Record<string, unknown>, path: string, value: unknown): void {
+    const parts = path.split('.');
+    let cur: Record<string, unknown> = obj;
+    for (let i = 0; i < parts.length - 1; i++) {
+        const key = parts[i]!;
+        const next = cur[key];
+        if (next == null || typeof next !== 'object') {
+            cur[key] = {};
+        }
+        cur = cur[key] as Record<string, unknown>;
+    }
+    cur[parts[parts.length - 1]!] = value;
+}
+
+export function cloneOrganicSettings(source: OrganicNpcSettings = DEFAULT_ORGANIC_NPC_SETTINGS): OrganicNpcSettings {
+    return JSON.parse(JSON.stringify(source)) as OrganicNpcSettings;
+}
+
+export interface OrganicValidationError {
+    path: string;
+    message: string;
+}
+
+function isNumberLike(v: unknown): v is number {
+    return typeof v === 'number' && Number.isFinite(v);
+}
+
+const MIN_MAX_PAIRS: Array<[string, string]> = [
+    ['roundStart.initialSpawnsMin', 'roundStart.initialSpawnsMax'],
+    ['roundStart.spawnDelayMinMs', 'roundStart.spawnDelayMaxMs'],
+    ['roundStart.peakInitialSpawnsMin', 'roundStart.peakInitialSpawnsMax'],
+    ['momentum.quietPeriodMinSec', 'momentum.quietPeriodMaxSec'],
+    ['asymmetry.leadSharePctMin', 'asymmetry.leadSharePctMax'],
+    ['tiers.whale.stakeMin', 'tiers.whale.stakeMax'],
+    ['tiers.mid.stakeMin', 'tiers.mid.stakeMax'],
+    ['tiers.retail.stakeMin', 'tiers.retail.stakeMax'],
+];
+
+/**
+ * Strict validation for the admin write path. Returns every problem found; an empty array
+ * means the values can be stored as they are.
+ */
+export function validateOrganicSettings(values: unknown): OrganicValidationError[] {
+    const errors: OrganicValidationError[] = [];
+    if (values == null || typeof values !== 'object') {
+        return [{ path: '', message: 'Settings must be an object' }];
+    }
+    for (const spec of ORGANIC_FIELD_SPECS) {
+        const v = getPath(values, spec.path);
+        if (v === undefined) {
+            errors.push({ path: spec.path, message: 'Missing value' });
+            continue;
+        }
+        switch (spec.type) {
+            case 'boolean':
+                if (typeof v !== 'boolean') errors.push({ path: spec.path, message: 'Must be true or false' });
+                break;
+            case 'select':
+                if (typeof v !== 'string' || !spec.options?.some((o) => o.value === v)) {
+                    errors.push({ path: spec.path, message: `Must be one of ${spec.options?.map((o) => o.value).join(', ')}` });
+                }
+                break;
+            case 'text':
+                if (typeof v !== 'string') errors.push({ path: spec.path, message: 'Must be text' });
+                else if (spec.pattern && !new RegExp(spec.pattern).test(v)) {
+                    errors.push({ path: spec.path, message: 'Format is not valid' });
+                }
+                break;
+            case 'integer':
+            case 'number': {
+                if (!isNumberLike(v)) {
+                    errors.push({ path: spec.path, message: 'Must be a number' });
+                    break;
+                }
+                if (spec.type === 'integer' && !Number.isInteger(v)) {
+                    errors.push({ path: spec.path, message: 'Must be a whole number' });
+                }
+                if (spec.min != null && v < spec.min) errors.push({ path: spec.path, message: `Must be at least ${spec.min}` });
+                if (spec.max != null && v > spec.max) errors.push({ path: spec.path, message: `Must be at most ${spec.max}` });
+                break;
+            }
+        }
+    }
+    if (errors.length > 0) return errors;
+
+    const s = values as OrganicNpcSettings;
+    for (const [lo, hi] of MIN_MAX_PAIRS) {
+        const a = getPath(s, lo) as number;
+        const b = getPath(s, hi) as number;
+        if (a > b) errors.push({ path: hi, message: `Must be greater than or equal to ${lo.split('.').pop()}` });
+    }
+    const rosterSum = s.tiers.whale.rosterSharePct + s.tiers.mid.rosterSharePct + s.tiers.retail.rosterSharePct;
+    if (Math.abs(rosterSum - 100) > 0.01) {
+        errors.push({ path: 'tiers.retail.rosterSharePct', message: `Roster shares must add up to 100 (now ${rosterSum})` });
+    }
+    const tradeSum = s.tiers.whale.tradeSharePct + s.tiers.mid.tradeSharePct + s.tiers.retail.tradeSharePct;
+    if (tradeSum <= 0) {
+        errors.push({ path: 'tiers.retail.tradeSharePct', message: 'At least one tier must place trades' });
+    }
+    if (s.momentum.rampToPeakFraction > s.momentum.lateFadeFraction) {
+        errors.push({ path: 'momentum.lateFadeFraction', message: 'Fade out must start after the ramp reaches its peak' });
+    }
+    if (s.momentum.baseArrivalsPerMinute <= 0 && s.momentum.peakArrivalsPerMinute <= 0 && s.roundStart.initialSpawnsMax <= 0) {
+        errors.push({ path: 'momentum.peakArrivalsPerMinute', message: 'With no initial spawns and zero arrival rates the engine would never trade' });
+    }
+    return errors;
+}
+
+/**
+ * Lenient parse for the engine: every invalid or missing field falls back to its default and
+ * inverted min/max pairs are swapped, so a hand-edited row never stops the engine.
+ */
+export function coerceOrganicSettings(raw: unknown): OrganicNpcSettings {
+    const out = cloneOrganicSettings();
+    if (raw == null || typeof raw !== 'object') return out;
+    for (const spec of ORGANIC_FIELD_SPECS) {
+        const v = getPath(raw, spec.path);
+        const fallback = getPath(DEFAULT_ORGANIC_NPC_SETTINGS, spec.path);
+        let next: unknown = fallback;
+        switch (spec.type) {
+            case 'boolean':
+                if (typeof v === 'boolean') next = v;
+                else if (v === 'true' || v === '1' || v === 1) next = true;
+                else if (v === 'false' || v === '0' || v === 0) next = false;
+                break;
+            case 'select':
+                if (typeof v === 'string' && spec.options?.some((o) => o.value === v)) next = v;
+                break;
+            case 'text':
+                if (typeof v === 'string' && (!spec.pattern || new RegExp(spec.pattern).test(v))) next = v;
+                break;
+            case 'integer':
+            case 'number': {
+                const n = typeof v === 'string' ? Number(v) : v;
+                if (isNumberLike(n)) {
+                    let c = n;
+                    if (spec.type === 'integer') c = Math.round(c);
+                    if (spec.min != null) c = Math.max(spec.min, c);
+                    if (spec.max != null) c = Math.min(spec.max, c);
+                    next = c;
+                }
+                break;
+            }
+        }
+        setPath(out as unknown as Record<string, unknown>, spec.path, next);
+    }
+    for (const [lo, hi] of MIN_MAX_PAIRS) {
+        const a = getPath(out, lo) as number;
+        const b = getPath(out, hi) as number;
+        if (a > b) {
+            setPath(out as unknown as Record<string, unknown>, lo, b);
+            setPath(out as unknown as Record<string, unknown>, hi, a);
+        }
+    }
+    const rosterSum = out.tiers.whale.rosterSharePct + out.tiers.mid.rosterSharePct + out.tiers.retail.rosterSharePct;
+    if (rosterSum <= 0) {
+        out.tiers.whale.rosterSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.whale.rosterSharePct;
+        out.tiers.mid.rosterSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.mid.rosterSharePct;
+        out.tiers.retail.rosterSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.retail.rosterSharePct;
+    }
+    const tradeSum = out.tiers.whale.tradeSharePct + out.tiers.mid.tradeSharePct + out.tiers.retail.tradeSharePct;
+    if (tradeSum <= 0) {
+        out.tiers.whale.tradeSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.whale.tradeSharePct;
+        out.tiers.mid.tradeSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.mid.tradeSharePct;
+        out.tiers.retail.tradeSharePct = DEFAULT_ORGANIC_NPC_SETTINGS.tiers.retail.tradeSharePct;
+    }
+    if (out.momentum.rampToPeakFraction > out.momentum.lateFadeFraction) {
+        out.momentum.rampToPeakFraction = out.momentum.lateFadeFraction;
+    }
+    return out;
+}
+
+export function parseOrganicSettingsDocument(raw: string | null | undefined): OrganicSettingsDocument {
+    const fallback: OrganicSettingsDocument = {
+        version: 0,
+        updatedAt: new Date(0).toISOString(),
+        updatedBy: null,
+        values: cloneOrganicSettings(),
+    };
+    if (!raw) return fallback;
+    try {
+        const parsed = JSON.parse(raw) as Partial<OrganicSettingsDocument>;
+        const version = Number(parsed?.version);
+        return {
+            version: Number.isFinite(version) && version >= 0 ? Math.floor(version) : 0,
+            updatedAt: typeof parsed?.updatedAt === 'string' ? parsed.updatedAt : fallback.updatedAt,
+            updatedBy: typeof parsed?.updatedBy === 'number' ? parsed.updatedBy : null,
+            values: coerceOrganicSettings(parsed?.values),
+        };
+    } catch {
+        return fallback;
+    }
+}
+
+export function parseNpcEngineMode(raw: unknown): NpcEngineMode {
+    return raw === 'legacy' ? 'legacy' : 'organic';
+}
+
+/** Parses "HH:mm-HH:mm,HH:mm-HH:mm" into minute-of-day ranges. Invalid parts are dropped. */
+export function parsePeakHours(spec: string): Array<{ from: number; to: number }> {
+    const out: Array<{ from: number; to: number }> = [];
+    for (const part of String(spec ?? '').split(',')) {
+        const m = part.trim().match(/^([01]\d|2[0-3]):([0-5]\d)-([01]\d|2[0-3]):([0-5]\d)$/);
+        if (!m) continue;
+        out.push({ from: Number(m[1]) * 60 + Number(m[2]), to: Number(m[3]) * 60 + Number(m[4]) });
+    }
+    return out;
+}
+
+/** True when `at` falls inside any configured peak range (handles ranges that wrap midnight). */
+export function isPeakTime(roundStart: OrganicNpcSettings['roundStart'], at: Date = new Date()): boolean {
+    const ranges = parsePeakHours(roundStart.peakHours);
+    if (ranges.length === 0) return false;
+    const localMinutes = (((at.getTime() / 60_000) + roundStart.peakTimezoneOffsetMinutes) % 1440 + 1440) % 1440;
+    for (const r of ranges) {
+        if (r.from === r.to) return true;
+        if (r.from < r.to) {
+            if (localMinutes >= r.from && localMinutes < r.to) return true;
+        } else if (localMinutes >= r.from || localMinutes < r.to) {
+            return true;
+        }
+    }
+    return false;
+}
