+            const npcRow = await this.prisma.npcTrader.findUnique({
+                where: { id: npcId },
+                select: { balance: true, isActive: true },
+            });
+            if (!npcRow?.isActive) return null;
+            const balance = Number(npcRow.balance);
+            if (balance + 1e-9 < amount) {
+                if (!topUp) return null;
+                const credit = amount - balance + 0.01;
+                await this.prisma.npcTrader.update({ where: { id: npcId }, data: { balance: { increment: credit } } });
+                await forceRefreshNpcBalanceCache(getSharedCommandRedis(), npcId, balance + credit);
+            }
+            const txResult = await this.commitNpcTradeToRedisBuffer({
+                npcId,
+                battleId,
+                side,
+                clampedAmount: amount,
+                execPxNpc: execPx,
+                hedgeChoice: null,
+                potField,
+                mainQtyField: qtyField,
+                mainQty: qty,
+                npcTradeCreatedAt: new Date(),
+                houseDefenseLiquidity: allowFinalize,
+            });
+            if (!txResult) return null;
+            potDeltas = txResult.potDeltas;
+        } else {
+            const txResult = await this.prisma.$transaction(async (tx: PrismaTx) => {
+                const row = await tx.battle.findUnique({ where: { id: battleId }, select: { state: true } });
+                if (!row || (row.state !== 'OPEN' && !(allowFinalize && row.state === 'FINALIZE'))) return null;
+                const npcRow = await tx.npcTrader.findUnique({ where: { id: npcId }, select: { balance: true, isActive: true } });
