+++ b/apps/engine/src/npc-organic/organic-npc-engine.spec.ts
@@ -0,0 +1,301 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    BATTLE_LOCKED_CHANNEL,
+    DEFAULT_ORGANIC_NPC_SETTINGS,
+    battleLockKey,
+    cloneOrganicSettings,
+    redisSettlementGraceKey,
+    seededRng,
+    type DirectiveRealStake,
+    type OrganicNpcSettings,
+} from '@ticktrade/shared';
+import { OrganicNpcEngine, type OrganicClock, type OrganicEngineDeps } from './organic-npc-engine';
+import type { RoundExposureContext } from './round-exposure.reader';
+
+/** Deterministic virtual clock: timers fire in order when the test advances time. */
+class FakeClock implements OrganicClock {
+    private t = 1_000_000;
+    private seq = 0;
+    private readonly timers = new Map<number, { at: number; fn: () => void }>();
+    now(): number {
+        return this.t;
+    }
+    setTimeout(fn: () => void, ms: number): unknown {
+        const id = ++this.seq;
+        this.timers.set(id, { at: this.t + Math.max(0, ms), fn });
+        return id;
+    }
+    clearTimeout(handle: unknown): void {
+        this.timers.delete(handle as number);
+    }
+    /** Advances time, running due timers (and the microtasks they start) in chronological order. */
+    async advance(ms: number): Promise<void> {
+        const target = this.t + ms;
+        for (;;) {
+            let next: { id: number; at: number; fn: () => void } | null = null;
+            for (const [id, tm] of this.timers) {
+                if (tm.at <= target && (next == null || tm.at < next.at || (tm.at === next.at && id < next.id))) next = { id, ...tm };
+            }
+            if (!next) break;
+            this.timers.delete(next.id);
+            this.t = Math.max(this.t, next.at);
+            next.fn();
+            for (let i = 0; i < 20; i++) await Promise.resolve();
+        }
+        this.t = target;
+        for (let i = 0; i < 20; i++) await Promise.resolve();
+    }
+}
+
+interface Harness {
+    engine: OrganicNpcEngine;
+    clock: FakeClock;
+    trades: Array<{ npcId: number; side: 'BUY' | 'SELL'; amount: number; source: string; atMs: number; allowFinalize?: boolean }>;
+    redis: Map<string, string>;
+    published: Array<{ channel: string; payload: unknown }>;
+    battle: { id: number; startTimeMs: number; durationSeconds: number; startPrice: number } | null;
+    realStakes: DirectiveRealStake[];
+    pots: { buyPot: number; sellPot: number };
+    settings: OrganicNpcSettings;
+    npcTrades: Array<{ id: number; npcId: number; amount: number; side: 'BUY' | 'SELL'; entryPrice: number; entryTimestampMs: number }>;
+}
+
+function harness(overrides: Partial<OrganicNpcSettings> = {}, opts: { roster?: number; lockDrainMs?: number } = {}): Harness {
+    const clock = new FakeClock();
+    const settings: OrganicNpcSettings = { ...cloneOrganicSettings(), ...overrides };
+    const h: Harness = {
+        engine: null as unknown as OrganicNpcEngine,
+        clock,
+        trades: [],
+        redis: new Map(),
+        published: [],
+        battle: null,
+        realStakes: [],
+        pots: { buyPot: 0, sellPot: 0 },
+        settings,
+        npcTrades: [],
+    };
+    const npcTrades = h.npcTrades;
+    const deps: OrganicEngineDeps = {
+        settings: { current: () => ({ version: 3, updatedAt: '', updatedBy: null, values: h.settings }), mode: () => 'organic' },
+        executor: {
+            execute: async (args) => {
+                h.trades.push({ npcId: args.npcId, side: args.side, amount: args.amount, source: args.source, atMs: clock.now(), allowFinalize: args.allowFinalize });
+                if (args.side === 'BUY') h.pots.buyPot += args.amount;
+                else h.pots.sellPot += args.amount;
+                npcTrades.push({ id: npcTrades.length + 1, npcId: args.npcId, amount: args.amount, side: args.side, entryPrice: 1.2, entryTimestampMs: clock.now() });
+                return { buyPot: h.pots.buyPot, sellPot: h.pots.sellPot, side: args.side, amount: args.amount, execPrice: 1.2 };
+            },
+        },
+        reader: {
+            read: async (): Promise<RoundExposureContext | null> => {
+                if (!h.battle) return null;
+                return {
+                    battleId: h.battle.id,
+                    startTimeMs: h.battle.startTimeMs,
+                    durationSeconds: h.battle.durationSeconds,
+                    currentPrice: 1.23,
+                    realUserCount: new Set(h.realStakes.map((s) => s.userId)).size,
+                    npcTradeCount: npcTrades.length,
+                    buyPot: h.pots.buyPot,
+                    sellPot: h.pots.sellPot,
+                    realStakes: h.realStakes,
+                    npcTrades,
+                    finalPrice: 1.23,
+                    startPrice: 1.2,
+                    roundHigh: 1.23,
+                    roundLow: 1.2,
+                    pricePoints: [
+                        { price: 1.2, timestampMs: h.battle.startTimeMs },
+                        { price: 1.23, timestampMs: clock.now() },
+                    ],
+                    platformFeeRate: 0.3,
+                };
+            },
+        },
+        audit: { open: async () => {}, update: async () => {}, publishLive: async () => {}, publishStatus: async () => {}, prune: async () => {} },
+        battles: { findOpen: async () => h.battle },
+        roster: { load: async () => Array.from({ length: opts.roster ?? 60 }, (_, i) => ({ id: i + 1, volumeProfile: (i * 13) % 100 })) },
+        redis: {
+            get: async (k) => h.redis.get(k) ?? null,
+            setPx: async (k, v) => {
+                h.redis.set(k, v);
+            },
+            del: async (k) => {
+                h.redis.delete(k);
+            },
+            publish: async (channel, payload) => {
+                h.published.push({ channel, payload });
+            },
+        },
+        onTradeExecuted: async () => {},
+        isLeader: () => true,
+        clock,
+        rngFactory: seededRng,
+        lockDrainMs: opts.lockDrainMs ?? 5,
+        logger: { log: () => {}, warn: () => {} },
+    };
+    h.engine = new OrganicNpcEngine(deps);
+    return h;
+}
+
+function openRound(h: Harness, durationSeconds = 300): void {
+    h.battle = { id: 42, startTimeMs: h.clock.now(), durationSeconds, startPrice: 1.2 };
+    h.pots = { buyPot: 0, sellPot: 0 };
+    h.trades.length = 0;
+}
+
+test('no NPC trades at 0 ms; the first wave trickles in inside the configured delay range', async () => {
+    const h = harness();
+    openRound(h);
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(999);
+    assert.equal(h.trades.length, 0, 'nothing may trade before spawnDelayMinMs');
+    await h.clock.advance(15_000);
+    const initial = h.trades.filter((t) => t.source === 'organic_initial');
+    assert.ok(initial.length >= 1 && initial.length <= 5, `initial wave size ${initial.length}`);
+    for (const t of initial) {
+        const delay = t.atMs - h.battle!.startTimeMs;
+        assert.ok(delay >= 1_000 && delay <= 15_000, `initial NPC entered at ${delay} ms`);
+    }
+    h.engine.stop();
+});
+
+test('momentum: arrivals keep coming through the round and the rate rises toward the peak', async () => {
+    const h = harness();
+    openRound(h);
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(60_000);
+    const firstMinute = h.trades.length;
+    await h.clock.advance(120_000);
+    const later = h.trades.length - firstMinute;
+    assert.ok(firstMinute >= 3, `first minute should show some flow, got ${firstMinute}`);
+    assert.ok(later > firstMinute, `flow should build up (first minute ${firstMinute}, next two minutes ${later})`);
+    const distinct = new Set(h.trades.map((t) => t.npcId)).size;
+    assert.ok(distinct > 5, 'many different NPCs appear');
+    h.engine.stop();
+});
+
+test('a real whale order gets no sized counter-trade, only a bounded momentum boost', async () => {
+    const h = harness();
+    openRound(h);
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(40_000);
+    const before = h.trades.length;
+    h.realStakes.push({ id: 1, userId: 7, amount: 100_000, side: 'SELL', entryPrice: 1.2, entryTimestampMs: h.clock.now() });
+    h.pots.sellPot += 100_000;
+    h.engine.recordRealTrade(42, 'SELL', 100_000);
+    await h.clock.advance(3_000);
+    const reaction = h.trades.slice(before);
+    const counterVolume = reaction.filter((t) => t.side === 'BUY').reduce((a, t) => a + t.amount, 0);
+    assert.ok(counterVolume < 60_000, `no instant mirror: BUY volume in 3 s after the whale was ${counterVolume}`);
+    for (const t of reaction) assert.ok(t.amount <= 50_000, 'organic sizes stay inside the whale bracket');
+    h.engine.stop();
+});
+
+const QUIET: Partial<OrganicNpcSettings> = {
+    roundStart: { ...DEFAULT_ORGANIC_NPC_SETTINGS.roundStart, initialSpawnsMin: 0, initialSpawnsMax: 0 },
+    momentum: { ...DEFAULT_ORGANIC_NPC_SETTINGS.momentum, baseArrivalsPerMinute: 0, peakArrivalsPerMinute: 0 },
+};
+
+test('final millisecond: lock is set before the injection, published, and settlement grace is released', async () => {
+    const h = harness(QUIET);
+    openRound(h, 120);
+    // Simulator seed already in the round: mostly on SELL (the losing side), a little on BUY.
+    h.npcTrades.push({ id: 1, npcId: 100, amount: 40_000, side: 'SELL', entryPrice: 1.2, entryTimestampMs: h.clock.now() + 5_000 });
+    h.npcTrades.push({ id: 2, npcId: 101, amount: 2_000, side: 'BUY', entryPrice: 1.2, entryTimestampMs: h.clock.now() + 90_000 });
+    // One real whale on BUY early, a small real SELL: real winners would exceed the pool.
+    h.realStakes.push({ id: 1, userId: 1, amount: 50_000, side: 'BUY', entryPrice: 1.2, entryTimestampMs: h.clock.now() + 2_000 });
+    h.realStakes.push({ id: 2, userId: 2, amount: 5_000, side: 'SELL', entryPrice: 1.2, entryTimestampMs: h.clock.now() + 50_000 });
+    h.pots = { buyPot: 52_000, sellPot: 45_000 };
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(120_000 - 151);
+    assert.equal(h.redis.has(battleLockKey(42)), false, 'not locked yet at T-151ms');
+    await h.clock.advance(1);
+    assert.equal(h.redis.has(battleLockKey(42)), true, 'locked at T-150ms');
+    const lockedEvent = h.published.find((p) => p.channel === BATTLE_LOCKED_CHANNEL);
+    assert.ok(lockedEvent, 'battle.locked published');
+    await h.clock.advance(100);
+    const injections = h.trades.filter((t) => t.source.startsWith('final_'));
+    assert.ok(injections.length >= 1, 'a final injection executed');
+    for (const inj of injections) {
+        assert.equal(inj.side, 'BUY', 'dilution goes on the winning side');
+        assert.equal(inj.allowFinalize, true);
+        assert.ok(inj.atMs >= h.battle!.startTimeMs + 120_000 - 150, 'injection after the lock instant');
+    }
+    const lockAt = Number(h.redis.get(battleLockKey(42)));
+    for (const inj of injections) assert.ok(inj.atMs >= lockAt, 'lock precedes every injection slice');
+    assert.equal(h.redis.has(redisSettlementGraceKey(42)), false, 'grace key released after the injection');
+    const organicAfterLock = h.trades.filter((t) => !t.source.startsWith('final_') && t.atMs >= lockAt);
+    assert.equal(organicAfterLock.length, 0, 'no organic trade after the lock');
+    const view = h.engine.liveView();
+    assert.equal(view?.locked, true);
+    assert.equal((view?.injection as { kind: string }).kind, 'dilution');
+    h.engine.stop();
+});
+
+test('ghost town: all real users on one side → the opposite side is bought at the lock so the simulator wins', async () => {
+    const h = harness(QUIET);
+    openRound(h, 60);
+    h.realStakes.push({ id: 1, userId: 1, amount: 20_000, side: 'BUY', entryPrice: 1.2, entryTimestampMs: h.clock.now() + 1_000 });
+    h.pots = { buyPot: 20_000, sellPot: 0 };
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(60_000);
+    const injections = h.trades.filter((t) => t.source.startsWith('final_ghost_town'));
+    assert.ok(injections.length >= 1, 'ghost town injection executed');
+    const total = injections.reduce((a, t) => a + t.amount, 0);
+    assert.ok(h.pots.sellPot > h.pots.buyPot, `SELL must lead after the lock (buy ${h.pots.buyPot}, sell ${h.pots.sellPot}, injected ${total})`);
+    h.engine.stop();
+});
+
+test('a safe round gets no injection and the lock still happens', async () => {
+    const h = harness(QUIET);
+    openRound(h, 60);
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(60_000);
+    assert.equal(h.trades.filter((t) => t.source.startsWith('final_')).length, 0);
+    assert.equal(h.redis.has(battleLockKey(42)), true);
+    h.engine.stop();
+});
+
+test('stop cancels every timer and a new round gets a fresh session', async () => {
+    const h = harness();
+    openRound(h);
+    h.engine.start();
+    await h.clock.advance(0);
+    await h.clock.advance(30_000);
+    const n = h.trades.length;
+    h.engine.stop();
+    await h.clock.advance(60_000);
+    assert.equal(h.trades.length, n, 'no trades after stop');
+    h.engine.start();
+    h.battle = { id: 43, startTimeMs: h.clock.now(), durationSeconds: 300, startPrice: 1.2 };
+    await h.clock.advance(0);
+    await h.clock.advance(20_000);
+    assert.ok(h.trades.length > n, 'the next round trades again');
+    assert.equal(h.engine.liveView()?.battleId, 43);
+    h.engine.stop();
+});
+
+test('settings changes apply live: raising the peak rate produces more arrivals', async () => {
+    const slow = harness({ momentum: { ...DEFAULT_ORGANIC_NPC_SETTINGS.momentum, baseArrivalsPerMinute: 1, peakArrivalsPerMinute: 2 } });
+    openRound(slow);
+    slow.engine.start();
+    await slow.clock.advance(0);
+    await slow.clock.advance(180_000);
+    const fast = harness({ momentum: { ...DEFAULT_ORGANIC_NPC_SETTINGS.momentum, baseArrivalsPerMinute: 30, peakArrivalsPerMinute: 60 } });
+    openRound(fast);
+    fast.engine.start();
+    await fast.clock.advance(0);
+    await fast.clock.advance(180_000);
+    assert.ok(fast.trades.length > slow.trades.length * 3, `fast ${fast.trades.length} vs slow ${slow.trades.length}`);
+    slow.engine.stop();
+    fast.engine.stop();
+});
