+
+    private armTimer(session: RoundSession, ms: number, fn: () => void): void {
+        const handle = this.clock.setTimeout(() => {
+            session.timers.delete(handle);
+            if (session.closed || !this.active) return;
+            fn();
+        }, Math.max(0, ms));
+        session.timers.add(handle);
+    }
+
+    // ------------------------------------------------------------------
+    // Organic flow
+    // ------------------------------------------------------------------
+
+    private elapsedFraction(session: RoundSession, now: number): number {
+        const total = Math.max(1, session.endMs - session.battle.startTimeMs);
+        return Math.max(0, Math.min(1, (now - session.battle.startTimeMs) / total));
+    }
+
+    private scheduleNextArrival(session: RoundSession): void {
+        if (session.closed || session.locked) return;
+        const settings = this.settings();
+        const now = this.clock.now();
+        const lead = settings.defenses.finalInjectionLeadMs;
+        const rate = arrivalsPerMinute(settings, {
+            elapsedFraction: this.elapsedFraction(session, now),
+            isPeak: session.peak,
+            realTradeBoostActive: session.boostUntilMs > now,
+        });
+        let delay = drawNextArrivalDelayMs(rate, session.rng);
+        if (session.quietUntilMs <= now) {
+            const quiet = drawQuietPeriodMs(settings, session.rng);
+            if (quiet > 0) session.quietUntilMs = now + quiet;
+        }
+        if (session.quietUntilMs > now) delay += session.quietUntilMs - now;
+        const fireAt = now + delay;
+        if (fireAt >= session.endMs - lead - 250) return; // nothing organic inside the final window
+        this.armTimer(session, delay, () => {
+            void this.fireOrganicTrade(session, 'arrival').finally(() => this.scheduleNextArrival(session));
+        });
+    }
+
+    private pickNpc(session: RoundSession, tier: OrganicTier, side: NpcSide): number | null {
+        const bucket = session.tiers[tier];
+        if (bucket.length === 0) return null;
+        const settings = this.settings();
+        const capReached = session.sideByNpc.size >= settings.momentum.maxDistinctNpcsPerRound;
+        for (let attempt = 0; attempt < 8; attempt++) {
+            const id = bucket[Math.floor(session.rng() * bucket.length)]!;
+            const used = session.sideByNpc.get(id);
+            if (used && used !== side) continue; // one side per NPC per round
+            if (!used && capReached) continue;
+            return id;
+        }
+        if (capReached) {
+            const sameSide = [...session.sideByNpc.entries()].filter(([id, s]) => s === side && bucket.includes(id)).map(([id]) => id);
+            if (sameSide.length) return sameSide[Math.floor(session.rng() * sameSide.length)]!;
+        }
+        return null;
+    }
+
+    private async fireOrganicTrade(session: RoundSession, kind: 'initial' | 'arrival'): Promise<void> {
+        if (session.closed || session.locked || !this.active) return;
+        const settings = this.settings();
+        const now = this.clock.now();
+        if (now >= session.endMs - settings.defenses.finalInjectionLeadMs - 100) return;
+        const maxSim = settings.momentum.maxSimVolumePerRound;
+        if (maxSim > 0 && session.simVolume.BUY + session.simVolume.SELL >= maxSim) return;
+        const tier = pickTier(settings, session.tiers, session.rng);
+        if (!tier) return;
+        const choice = chooseSide(settings, {
+            lead: session.lead,
+            elapsedFraction: this.elapsedFraction(session, now),
+            lastRealTradeSide: session.lastRealTrade?.side ?? null,
+            lastRealTradeAgeMs: session.lastRealTrade ? now - session.lastRealTrade.atMs : null,
+            steeringSide: session.steeringSide,
+            rng: session.rng,
+        });
+        // Apply the frozen asymmetry window of this round, not a mid-round edit.
+        const frozenSettings: OrganicNpcSettings = { ...settings, asymmetry: session.frozen.asymmetry };
+        const finalChoice = choice.reason === 'lead' || choice.reason === 'other'
+            ? chooseSide(frozenSettings, { lead: session.lead, elapsedFraction: this.elapsedFraction(session, now), lastRealTradeSide: null, lastRealTradeAgeMs: null, steeringSide: null, rng: session.rng })
+            : choice;
+        const side = finalChoice.side;
+        const npcId = this.pickNpc(session, tier, side);
+        if (npcId == null) return;
+        if (this.deps.isNpcEligible && !(await this.deps.isNpcEligible(npcId))) return;
+        const amount = drawStake(settings.tiers[tier], settings, session.rng);
+        try {
+            const result = await this.deps.executor.execute({ npcId, battleId: session.battle.id, side, amount, source: `organic_${kind}` });
