diff --git a/apps/engine/src/npc-organic/create-organic-engine.ts b/apps/engine/src/npc-organic/create-organic-engine.ts
new file mode 100644
index 0000000..9dba5fd
--- /dev/null
+++ b/apps/engine/src/npc-organic/create-organic-engine.ts
@@ -0,0 +1,163 @@
+/**
+ * Wires the Organic NPC Engine to the process it runs in (engine leader or npc-worker leader).
+ * Both hosts already construct a `NpcSimulatorService`; in organic mode that instance is used only
+ * as the trade committer (`executeOrganicNpcTrade`) — its legacy loop is never started.
+ */
+import {
+    checkNpcRotationEligibility,
+    commitNpcRotationParticipation,
+    drawCooldownMs,
+    parseRotationSettings,
+    NpcRotationReasonCode,
+    type NpcRotationSettings,
+} from '@ticktrade/shared';
+import type { PrismaService } from '../prisma/prisma.service';
+import type { RedisPublisher } from '../redis/redis.publisher';
+import type { RedisStateService } from '../redis/redis-state.service';
+import type { BattlePotCache } from '../redis/battle-pot-cache';
+import type { MarketConfigCache } from '../market/market-config.cache';
+import type { NpcSimulatorService, OnNpcTradeExecuted } from '../npc/npc-simulator.service';
+import { getSharedCommandRedis } from '../redis/redis.client';
+import { OrganicNpcEngine } from './organic-npc-engine';
+import { OrganicSettingsSource } from './organic-settings.source';
+import { RoundAuditStore } from './round-audit.store';
+import { RoundExposureReader } from './round-exposure.reader';
+
+const ROTATION_KEYS = [
+    'npc_rotation_enabled',
+    'npc_rotation_max_per_day',
+    'npc_rotation_max_per_week',
+    'npc_rotation_max_per_month',
+    'npc_rotation_cooldown_min_hours',
+    'npc_rotation_cooldown_max_hours',
+    'npc_rotation_hard_floor_minutes',
+    'npc_rotation_window_from',
+    'npc_rotation_window_to',
+    'npc_rotation_strategy',
+    'npc_rotation_no_repeat_minutes',
+    'npc_rotation_min_distinct',
+];
+
+export interface OrganicEngineBundle {
+    engine: OrganicNpcEngine;
+    settings: OrganicSettingsSource;
+    audit: RoundAuditStore;
+    start(): Promise<void>;
+    stop(): Promise<void>;
+}
+
+export function createOrganicNpcEngine(params: {
+    prisma: PrismaService;
+    redisPublisher: RedisPublisher;
+    redisState: RedisStateService;
+    battlePotCache: BattlePotCache | null;
+    marketConfigCache: MarketConfigCache;
+    simulator: NpcSimulatorService;
+    onTradeExecuted: OnNpcTradeExecuted;
+    isLeader: () => boolean;
+}): OrganicEngineBundle {
+    const { prisma, redisPublisher, redisState, battlePotCache, marketConfigCache, simulator, onTradeExecuted, isLeader } = params;
+    const settings = new OrganicSettingsSource(prisma, redisPublisher);
+    const audit = new RoundAuditStore(prisma, redisPublisher);
+    const reader = new RoundExposureReader(
+        prisma,
+        battlePotCache,
+        () => redisState.getLastPrice(),
+        () => marketConfigCache.getPlatformFeeRate(),
+    );
+    const commandRedis = getSharedCommandRedis();
+
+    let rotation: NpcRotationSettings = parseRotationSettings(new Map());
+    let rotationLoadedAt = 0;
+    const loadRotation = async (): Promise<NpcRotationSettings> => {
+        if (Date.now() - rotationLoadedAt < 20_000) return rotation;
+        try {
+            const rows = await prisma.systemSetting.findMany({ where: { settingKey: { in: ROTATION_KEYS } }, select: { settingKey: true, settingValue: true } });
+            rotation = parseRotationSettings(new Map(rows.map((r) => [r.settingKey, r.settingValue])));
+        } catch {
+            /* keep the previous value */
+        }
+        rotationLoadedAt = Date.now();
+        return rotation;
+    };
+
+    const engine = new OrganicNpcEngine({
+        settings,
+        executor: {
+            execute: (args) => simulator.executeOrganicNpcTrade(args),
+        },
+        reader,
+        audit,
+        battles: {
+            findOpen: async () => {
+                const b = await prisma.battle.findFirst({
+                    where: { status: 'ACTIVE', state: 'OPEN' },
+                    orderBy: { id: 'desc' },
+                    select: { id: true, startTime: true, durationSeconds: true, startPrice: true },
+                });
+                if (!b) return null;
+                return { id: b.id, startTimeMs: b.startTime.getTime(), durationSeconds: b.durationSeconds, startPrice: Number(b.startPrice) };
+            },
+        },
+        roster: {
+            load: async () => {
+                const rows = await prisma.npcTrader.findMany({
+                    where: { isActive: true, rotationPaused: false },
+                    select: { id: true, volumeProfile: true },
+                });
+                return rows.map((r) => ({ id: r.id, volumeProfile: r.volumeProfile }));
+            },
+        },
+        redis: {
+            get: (key) => redisPublisher.get(key),
+            setPx: (key, value, ttlMs) => redisPublisher.setPx(key, value, ttlMs),
+            del: (key) => redisPublisher.del(key),
+            publish: (channel, payload) => redisPublisher.publish(channel, payload),
+            sadd: async (key, member, ttlSec) => {
+                try {
+                    await commandRedis.multi().sadd(key, member).expire(key, ttlSec).exec();
+                } catch {
+                    /* best effort */
+                }
+            },
+        },
+        onTradeExecuted,
+        isNpcEligible: async (npcId) => {
+            const r = await loadRotation();
+            if (!r.enabled) return true;
+            try {
+                const map = await checkNpcRotationEligibility(commandRedis, [npcId], r);
+                return (map.get(npcId) ?? NpcRotationReasonCode.ELIGIBLE) === NpcRotationReasonCode.ELIGIBLE;
+            } catch {
+                return true;
+            }
+        },
+        onNpcParticipated: async (npcId) => {
+            const r = await loadRotation();
+            const now = new Date();
+            if (r.enabled) {
+                const cooldownMs = drawCooldownMs(r);
+                void commitNpcRotationParticipation(commandRedis, npcId, now.getTime() + cooldownMs, Math.ceil(cooldownMs / 1000) + 60, now);
+            }
+            try {
+                await prisma.npcTrader.update({ where: { id: npcId }, data: { lastParticipatedAt: now } });
+            } catch {
+                /* best effort */
+            }
+        },
+        isLeader,
+    });
+
+    return {
+        engine,
+        settings,
+        audit,
+        async start() {
+            await settings.start();
+        },
+        async stop() {
+            engine.stop();
+            await settings.stop();
+        },
+    };
+}
