new file mode 100644
index 0000000..75bf95d
--- /dev/null
+++ b/packages/shared/src/npc-organic/directive-settlement.ts
@@ -0,0 +1,574 @@
+/**
+ * Directive settlement model ("Zero net NPC profit").
+ *
+ * Definitions (per round, real users netted per user — a $1,000 SELL + $2,000 BUY is a $1,000 BUY):
+ *   V_rl  real losing volume (sum of net losers), V_rw real winning volume
+ *   V_sl  simulator losing volume, V_sw simulator winning volume
+ *   fee   platform commission rate
+ *   R     = V_rl × (1 − fee)   net real loser pool (the only money real winners can be paid from)
+ *   Pot   = R + V_sl           everything the losing side leaves on the table after commission
+ *
+ * Scores (Model A, `computeStakeScore`) split Pot between real winners and simulator winners.
+ * The simulator's profit is capped at V_sl (it may only recover its own seed); every dollar above
+ * that is redistributed to real winners. The company earns fee × V_rl and nothing else, except in
+ * a Ghost Town round (no real winners) where the unpaid R stays with the house.
+ *
+ * Matched hedge portions (min(buy, sell) per user) are returned on both sides untouched.
+ */
+import { computeStakeScore, type PricePoint } from '../score/score-calculator.impl';
+import { HEDGE_EPSILON, isPotDominanceTieOrNearTie } from '../payout/battle-payout.engine';
+
+import type { NpcSide } from './organic-plan';
+
+export interface DirectiveRealStake {
+    id: number;
+    userId: number;
+    amount: number;
+    side: NpcSide;
+    entryPrice: number;
+    entryTimestampMs: number;
+}
+
+export interface DirectiveNpcTrade {
+    id: number;
+    npcId: number;
+    amount: number;
+    side: NpcSide;
+    entryPrice: number;
+    entryTimestampMs: number;
+}
+
+export interface DirectiveRoundInput {
+    /** Total pots including simulator volume — the pot-dominance winner is decided on these. */
+    buyPot: number;
+    sellPot: number;
+    realStakes: DirectiveRealStake[];
+    npcTrades: DirectiveNpcTrade[];
+    finalPrice: number;
+    startPrice: number;
+    roundHigh: number;
+    roundLow: number;
+    pricePoints: PricePoint[];
+    platformFeeRate: number;
+    /** Legacy rule: with real users on both sides, the smaller real pot wins. Default off. */
+    houseMaxRealLoserPoolRule?: boolean;
+    /** No real losers but real winners: max simulator seed that may fund them. 0/undefined = unlimited. */
+    maxSimulatorLossUsd?: number;
+}
+
+export interface UserNetPosition {
+    userId: number;
+    grossBuy: number;
+    grossSell: number;
+    /** Net side, or null when fully hedged. */
+    side: NpcSide | null;
+    net: number;
+    matched: number;
+}
+
+export type StakeOutcomeStatus = 'WON' | 'LOST' | 'REFUNDED';
+
+export interface StakeOutcome {
+    stakeId: number;
+    userId: number;
+    amount: number;
+    side: NpcSide;
+    /** Cash returned to the user for this stake (stake back and/or matched refund), excluding profit. */
+    credit: number;
+    /** Profit paid on top of the credit. */
+    profit: number;
+    status: StakeOutcomeStatus;
+    /** Model-A score of the net-scaled amount, null for non-winning stakes. */
+    score: number | null;
+    /** Portion of this stake that took part in the round (net share), for the audit. */
+    participating: number;
+}
+
+export interface NpcTradeOutcome {
+    tradeId: number;
+    npcId: number;
+    amount: number;
+    side: NpcSide;
+    /** Stake returned (winners) — losers get nothing back. */
+    credit: number;
+    profit: number;
+}
+
+export interface DirectiveSettlementResult {
+    winnerSide: NpcSide | 'TIE';
+    winnerReason: string;
+    platformFeeRate: number;
+    realLosingVolume: number;
+    realWinningVolume: number;
+    commission: number;
+    netRealLoserPool: number;
+    simLosingVolume: number;
+    simWinningVolume: number;
+    distributablePot: number;
+    realScoreSum: number;
+    simScoreSum: number;
+    simProfitRaw: number;
+    simProfit: number;
+    surplusToReal: number;
+    realWinnersTotal: number;
+    houseRetained: number;
+    simulatorNet: number;
+    companyNet: number;
+    /** Seed the simulator lost to fund real winners when there were no real losers (Ghost Town off). */
+    simulatorFundedRealWinners: number;
+    realWinnerUserCount: number;
+    realLoserUserCount: number;
+    stakes: Map<number, StakeOutcome>;
+    npcTrades: Map<number, NpcTradeOutcome>;
+    users: Map<number, UserNetPosition>;
+}
+
+const EPS = 1e-9;
+
+function round2(n: number): number {
+    return Number(n.toFixed(2));
+}
+
+export function computeUserNetPositions(stakes: DirectiveRealStake[]): Map<number, UserNetPosition> {
+    const users = new Map<number, UserNetPosition>();
+    for (const s of stakes) {
+        const u = users.get(s.userId) ?? { userId: s.userId, grossBuy: 0, grossSell: 0, side: null, net: 0, matched: 0 };
+        if (s.side === 'BUY') u.grossBuy += s.amount;
+        else u.grossSell += s.amount;
+        users.set(s.userId, u);
+    }
+    for (const u of users.values()) {
+        const diff = u.grossBuy - u.grossSell;
+        u.matched = Math.min(u.grossBuy, u.grossSell);
+        if (Math.abs(diff) < HEDGE_EPSILON) {
+            u.side = null;
+            u.net = 0;
+        } else {
+            u.side = diff > 0 ? 'BUY' : 'SELL';
+            u.net = Math.abs(diff);
+        }
+    }
+    return users;
+}
+
+export interface NetRealSummary {
+    buyNet: number;
+    sellNet: number;
+    buyUsers: number;
+    sellUsers: number;
+}
+
+export function summarizeNetReal(users: Map<number, UserNetPosition>): NetRealSummary {
+    let buyNet = 0;
+    let sellNet = 0;
+    let buyUsers = 0;
+    let sellUsers = 0;
+    for (const u of users.values()) {
+        if (u.side === 'BUY') {
+            buyNet += u.net;
+            buyUsers += 1;
+        } else if (u.side === 'SELL') {
+            sellNet += u.net;
+            sellUsers += 1;
+        }
+    }
+    return { buyNet, sellNet, buyUsers, sellUsers };
+}
+
+export function resolveDirectiveWinner(params: {
+    buyPot: number;
+    sellPot: number;
+    real: NetRealSummary;
+    houseMaxRealLoserPoolRule?: boolean;
+}): { winner: NpcSide | 'TIE'; reason: string } {
+    const { buyPot, sellPot, real } = params;
+    if (!Number.isFinite(buyPot) || !Number.isFinite(sellPot) || isPotDominanceTieOrNearTie(buyPot, sellPot)) {
+        return { winner: 'TIE', reason: 'equal_total_buy_sell_volume' };
+    }
+    if (params.houseMaxRealLoserPoolRule && real.buyUsers > 0 && real.sellUsers > 0) {
+        if (real.buyNet < real.sellNet) return { winner: 'BUY', reason: 'house_max_real_loser_pool' };
+        if (real.sellNet < real.buyNet) return { winner: 'SELL', reason: 'house_max_real_loser_pool' };
+    }
+    return { winner: buyPot > sellPot ? 'BUY' : 'SELL', reason: 'pot_dominance' };
+}
+
+/**
+ * Full settlement of one round under the directive model. Pure; the caller persists the outcome.
+ */
+export function computeDirectiveSettlement(input: DirectiveRoundInput): DirectiveSettlementResult {
+    const fee = Number.isFinite(input.platformFeeRate) ? Math.min(0.95, Math.max(0, input.platformFeeRate)) : 0.3;
+    const users = computeUserNetPositions(input.realStakes);
+    const real = summarizeNetReal(users);
+    const { winner, reason } = resolveDirectiveWinner({
+        buyPot: input.buyPot,
+        sellPot: input.sellPot,
+        real,
+        houseMaxRealLoserPoolRule: input.houseMaxRealLoserPoolRule,
+    });
+
+    const stakes = new Map<number, StakeOutcome>();
+    const npcTrades = new Map<number, NpcTradeOutcome>();
+
+    const base: Omit<DirectiveSettlementResult, 'stakes' | 'npcTrades' | 'users'> = {
+        winnerSide: winner,
+        winnerReason: reason,
+        platformFeeRate: fee,
+        realLosingVolume: 0,
+        realWinningVolume: 0,
+        commission: 0,
+        netRealLoserPool: 0,
+        simLosingVolume: 0,
+        simWinningVolume: 0,
+        distributablePot: 0,
+        realScoreSum: 0,
+        simScoreSum: 0,
+        simProfitRaw: 0,
+        simProfit: 0,
+        surplusToReal: 0,
+        realWinnersTotal: 0,
+        houseRetained: 0,
+        simulatorNet: 0,
+        companyNet: 0,
+        simulatorFundedRealWinners: 0,
+        realWinnerUserCount: 0,
+        realLoserUserCount: 0,
+    };
+
+    if (winner === 'TIE') {
+        for (const s of input.realStakes) {
+            stakes.set(s.id, { stakeId: s.id, userId: s.userId, amount: s.amount, side: s.side, credit: round2(s.amount), profit: 0, status: 'REFUNDED', score: null, participating: 0 });
+        }
+        for (const t of input.npcTrades) {
+            npcTrades.set(t.id, { tradeId: t.id, npcId: t.npcId, amount: t.amount, side: t.side, credit: round2(t.amount), profit: 0 });
+        }
+        return { ...base, stakes, npcTrades, users };
+    }
+
+    const loser: NpcSide = winner === 'BUY' ? 'SELL' : 'BUY';
+    const V_rl = winner === 'BUY' ? real.sellNet : real.buyNet;
+    const V_rw = winner === 'BUY' ? real.buyNet : real.sellNet;
+    let V_sl = 0;
+    let V_sw = 0;
+    for (const t of input.npcTrades) {
+        if (t.side === winner) V_sw += t.amount;
+        else V_sl += t.amount;
+    }
+    const commission = V_rl * fee;
+    const R = V_rl - commission;
+
+    // --- Scores on the winning team (real net-scaled winners + simulator winners) ---
+    const winningReal = input.realStakes.filter((s) => {
+        const u = users.get(s.userId)!;
+        return u.side === winner && s.side === winner;
+    });
+    const scaleByUser = new Map<number, number>();
+    for (const u of users.values()) {
+        if (u.side !== winner) continue;
+        const gross = winner === 'BUY' ? u.grossBuy : u.grossSell;
+        scaleByUser.set(u.userId, gross > EPS ? u.net / gross : 0);
+    }
+    const winningSim = input.npcTrades.filter((t) => t.side === winner);
+    const totalTeamStake = V_rw + V_sw;
+
+    let realScoreSum = 0;
+    const realScoreByStake = new Map<number, number>();
+    for (const s of winningReal) {
+        const scaled = s.amount * (scaleByUser.get(s.userId) ?? 0);
+        if (scaled <= EPS) {
+            realScoreByStake.set(s.id, 0);
+            continue;
+        }
+        const r = computeStakeScore(
+            { stakeId: s.id, side: s.side, amount: scaled, entryPrice: s.entryPrice, entryTimestampMs: s.entryTimestampMs },
+            input.finalPrice,
+            input.roundHigh,
+            input.roundLow,
+            totalTeamStake,
+            input.pricePoints,
+        );
+        realScoreByStake.set(s.id, r.score);
+        realScoreSum += r.score;
+    }
+    let simScoreSum = 0;
+    const simScoreByTrade = new Map<number, number>();
+    for (const t of winningSim) {
+        const r = computeStakeScore(
+            { stakeId: t.id, side: t.side, amount: t.amount, entryPrice: t.entryPrice, entryTimestampMs: t.entryTimestampMs },
+            input.finalPrice,
+            input.roundHigh,
+            input.roundLow,
+            totalTeamStake,
+            input.pricePoints,
+        );
+        simScoreByTrade.set(t.id, r.score);
+        simScoreSum += r.score;
+    }
+    const totalScore = realScoreSum + simScoreSum;
+
+    // --- Split the pot ---
+    const Pot = R + V_sl;
+    let simProfitRaw = 0;
+    let simProfit = 0;
+    let realWinnersTotal = 0;
+    let houseRetained = 0;
+    let surplusToReal = 0;
+    let simulatorFundedRealWinners = 0;
+    if (realScoreSum <= EPS) {
+        // No real winners: the simulator recovers its seed, the unpaid real pool stays with the house.
+        simProfitRaw = Pot;
+        simProfit = Math.min(Pot, V_sl);
+        houseRetained = Math.max(0, Pot - simProfit);
+    } else if (totalScore > EPS) {
+        simProfitRaw = (Pot * simScoreSum) / totalScore;
+        simProfit = Math.min(simProfitRaw, V_sl);
+        surplusToReal = Math.max(0, simProfitRaw - simProfit);
+        realWinnersTotal = Pot - simProfit;
+        if (V_rl <= EPS) {
+            // Every real user is on the winning side: the simulator's losing seed is the only pool.
+            const cap = input.maxSimulatorLossUsd && input.maxSimulatorLossUsd > 0 ? input.maxSimulatorLossUsd : Number.POSITIVE_INFINITY;
+            const funded = Math.min(realWinnersTotal, cap);
+            simProfit += realWinnersTotal - funded;
+            realWinnersTotal = funded;
+            simulatorFundedRealWinners = funded;
+        } else {
+            simulatorFundedRealWinners = Math.max(0, realWinnersTotal - R);
+        }
+    }
+
+    // --- Real stakes: credits + profits ---
+    let realWinnerUserCount = 0;
+    let realLoserUserCount = 0;
+    for (const u of users.values()) {
+        if (u.side === winner) realWinnerUserCount += 1;
+        else if (u.side === loser) realLoserUserCount += 1;
+    }
+    for (const s of input.realStakes) {
+        const u = users.get(s.userId)!;
+        let credit = 0;
+        let profit = 0;
+        let status: StakeOutcomeStatus = 'REFUNDED';
+        let score: number | null = null;
+        let participating = 0;
+        if (u.side == null) {
+            credit = s.amount;
+        } else if (u.side === winner) {
+            credit = s.amount;
+            if (s.side === winner) {
+                const sc = realScoreByStake.get(s.id) ?? 0;
+                score = sc;
+                participating = s.amount * (scaleByUser.get(s.userId) ?? 0);
+                profit = realScoreSum > EPS ? (realWinnersTotal * sc) / realScoreSum : 0;
+                status = 'WON';
+            }
+        } else {
+            // Net loser: winning-side stakes are matched (returned); losing-side stakes return their matched share.
+            const grossLosing = loser === 'BUY' ? u.grossBuy : u.grossSell;
+            if (s.side === winner) {
+                credit = s.amount;
+            } else {
+                const lostShare = grossLosing > EPS ? u.net / grossLosing : 1;
+                participating = s.amount * lostShare;
+                credit = s.amount - participating;
+                status = credit + EPS >= s.amount ? 'REFUNDED' : 'LOST';
+            }
+        }
+        stakes.set(s.id, {
+            stakeId: s.id,
+            userId: s.userId,
+            amount: s.amount,
+            side: s.side,
+            credit: round2(credit),
+            profit: round2(profit),
+            status,
+            score,
+            participating: round2(participating),
+        });
+    }
+
+    // --- NPC trades: winners get their stake back plus a pro-rata share of the simulator profit ---
+    for (const t of input.npcTrades) {
+        if (t.side === winner) {
+            const share = V_sw > EPS ? (simProfit * t.amount) / V_sw : 0;
+            npcTrades.set(t.id, { tradeId: t.id, npcId: t.npcId, amount: t.amount, side: t.side, credit: round2(t.amount), profit: round2(share) });
+        } else {
+            npcTrades.set(t.id, { tradeId: t.id, npcId: t.npcId, amount: t.amount, side: t.side, credit: 0, profit: 0 });
+        }
+    }
+
+    return {
+        ...base,
+        realLosingVolume: V_rl,
+        realWinningVolume: V_rw,
+        commission,
+        netRealLoserPool: R,
+        simLosingVolume: V_sl,
+        simWinningVolume: V_sw,
+        distributablePot: Pot,
+        realScoreSum,
+        simScoreSum,
+        simProfitRaw,
+        simProfit,
+        surplusToReal,
+        realWinnersTotal,
+        houseRetained,
+        simulatorNet: simProfit - V_sl,
+        companyNet: commission + houseRetained,
+        simulatorFundedRealWinners,
+        realWinnerUserCount,
+        realLoserUserCount,
+        stakes,
+        npcTrades,
+        users,
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Final-millisecond defenses
+// ---------------------------------------------------------------------------
+
+export interface FinalInjectionOptions {
+    dilutionEnabled: boolean;
+    dilutionSafetyMarginPct: number;
+    ghostTownEnabled: boolean;
+    ghostTownMarginPct: number;
+    /** 0 = unlimited. */
+    maxUsd: number;
+    /** Entry time of the hypothetical injection (the lock instant). */
+    nowMs: number;
+    /** Current price at the lock instant (entry price of the injection). */
+    currentPrice: number;
+}
+
+export interface FinalInjectionPlan {
+    kind: 'none' | 'ghost_town' | 'dilution';
+    side: NpcSide | null;
+    amount: number;
+    capped: boolean;
+    reason: string;
+    projected: {
+        winner: NpcSide | 'TIE';
+        netRealLoserPool: number;
+        realWinnersTotalBefore: number;
+        realWinnersTotalAfter: number;
+        simulatorNetBefore: number;
+        simulatorNetAfter: number;
+        realBuyNet: number;
+        realSellNet: number;
+        realBuyUsers: number;
+        realSellUsers: number;
+    };
+}
+
+function withInjection(input: DirectiveRoundInput, side: NpcSide, amount: number, opts: FinalInjectionOptions): DirectiveRoundInput {
+    if (amount <= 0) return input;
+    return {
+        ...input,
+        buyPot: input.buyPot + (side === 'BUY' ? amount : 0),
+        sellPot: input.sellPot + (side === 'SELL' ? amount : 0),
+        npcTrades: [
+            ...input.npcTrades,
+            { id: -1, npcId: -1, amount, side, entryPrice: opts.currentPrice, entryTimestampMs: opts.nowMs },
+        ],
+        finalPrice: opts.currentPrice,
+    };
+}
+
+/**
+ * Decides the single defensive trade executed at T − lead.
+ *
+ * Ghost Town first: every real user on one side → the other side must lead by the margin.
+ * Otherwise Lightning Dilution: the smallest X on the winning side that brings the real winners'
+ * collective payout down to R (bisection on the real score function, so the impact bonus of X is exact).
+ */
+export function planFinalInjection(base: DirectiveRoundInput, opts: FinalInjectionOptions): FinalInjectionPlan {
+    const evalInput: DirectiveRoundInput = { ...base, finalPrice: opts.currentPrice };
+    const before = computeDirectiveSettlement(evalInput);
+    const real = summarizeNetReal(before.users);
+    const projectedBase = {
+        winner: before.winnerSide,
+        netRealLoserPool: before.netRealLoserPool,
+        realWinnersTotalBefore: before.realWinnersTotal,
+        realWinnersTotalAfter: before.realWinnersTotal,
+        simulatorNetBefore: before.simulatorNet,
+        simulatorNetAfter: before.simulatorNet,
+        realBuyNet: real.buyNet,
+        realSellNet: real.sellNet,
+        realBuyUsers: real.buyUsers,
+        realSellUsers: real.sellUsers,
+    };
+    const none = (reason: string): FinalInjectionPlan => ({ kind: 'none', side: null, amount: 0, capped: false, reason, projected: projectedBase });
+    const cap = opts.maxUsd > 0 ? opts.maxUsd : Number.POSITIVE_INFINITY;
+
+    const oneSided = (real.buyUsers > 0 && real.sellUsers === 0) || (real.sellUsers > 0 && real.buyUsers === 0);
+    if (oneSided && opts.ghostTownEnabled) {
+        const realSide: NpcSide = real.buyUsers > 0 ? 'BUY' : 'SELL';
+        const opposite: NpcSide = realSide === 'BUY' ? 'SELL' : 'BUY';
+        const realPot = realSide === 'BUY' ? base.buyPot : base.sellPot;
+        const oppPot = realSide === 'BUY' ? base.sellPot : base.buyPot;
+        const needed = realPot * (1 + Math.max(0, opts.ghostTownMarginPct) / 100) - oppPot + 0.01;
+        if (needed <= 0) {
+            const after = computeDirectiveSettlement(evalInput);
+            return { ...none('ghost_town_already_leading'), projected: { ...projectedBase, realWinnersTotalAfter: after.realWinnersTotal, simulatorNetAfter: after.simulatorNet } };
+        }
+        const amount = round2(Math.min(needed, cap));
+        const after = computeDirectiveSettlement(withInjection(evalInput, opposite, amount, opts));
+        return {
+            kind: 'ghost_town',
+            side: opposite,
+            amount,
+            capped: needed > cap,
+            reason: needed > cap ? 'ghost_town_capped' : 'ghost_town',
+            projected: { ...projectedBase, winner: after.winnerSide, realWinnersTotalAfter: after.realWinnersTotal, simulatorNetAfter: after.simulatorNet },
+        };
+    }
+
+    if (!opts.dilutionEnabled) return none('dilution_disabled');
+    if (before.winnerSide === 'TIE') return none('tie');
+    const winner = before.winnerSide;
+    const R = before.netRealLoserPool;
+    if (before.realWinnersTotal <= R + 0.005) return none('real_winners_within_pool');
+    if (before.realLosingVolume <= EPS) return none('no_real_losers');
+
+    const f = (x: number) => computeDirectiveSettlement(withInjection(evalInput, winner, x, opts)).realWinnersTotal;
+    // Closed-form estimate with early bonus 0 as the starting bracket.
+    const est = Math.max(1, (before.simLosingVolume * before.realScoreSum) / Math.max(EPS, R) - before.simScoreSum);
+    let lo = 0;
+    let hi = est;
+    let guard = 0;
+    while (f(hi) > R && guard < 40) {
+        hi *= 2;
+        guard += 1;
+    }
+    if (f(hi) > R) {
+        const amount = round2(Math.min(hi, cap));
+        const after = computeDirectiveSettlement(withInjection(evalInput, winner, amount, opts));
+        return { kind: 'dilution', side: winner, amount, capped: true, reason: 'dilution_unsolvable_capped', projected: { ...projectedBase, realWinnersTotalAfter: after.realWinnersTotal, simulatorNetAfter: after.simulatorNet } };
+    }
+    for (let i = 0; i < 60 && hi - lo > 0.005; i++) {
+        const mid = (lo + hi) / 2;
+        if (f(mid) > R) lo = mid;
+        else hi = mid;
+    }
+    let amount = hi * (1 + Math.max(0, opts.dilutionSafetyMarginPct) / 100);
+    const capped = amount > cap;
+    amount = round2(Math.min(amount, cap));
+    const after = computeDirectiveSettlement(withInjection(evalInput, winner, amount, opts));
+    return {
+        kind: 'dilution',
+        side: winner,
+        amount,
+        capped,
+        reason: capped ? 'dilution_capped' : 'dilution',
+        projected: { ...projectedBase, realWinnersTotalAfter: after.realWinnersTotal, simulatorNetAfter: after.simulatorNet },
+    };
+}
+
+/** NpcSide that lowers projected exposure right now (Defense A), or null when nothing needs steering. */
+export function steeringSideFor(base: DirectiveRoundInput, currentPrice: number): NpcSide | null {
+    const result = computeDirectiveSettlement({ ...base, finalPrice: currentPrice });
+    if (result.winnerSide === 'TIE') return null;
+    if (result.realWinnersTotal <= result.netRealLoserPool + 0.005) return null;
+    // Real winners are ahead of the pool: lean against them — organic volume on the losing side
+    // moves the price against their early bonus and feeds the loser pool.
+    return result.winnerSide === 'BUY' ? 'SELL' : 'BUY';
+}
diff --git a/packages/shared/src/npc-organic/engine-mode.redis.ts b/packages/shared/src/npc-organic/engine-mode.redis.ts
