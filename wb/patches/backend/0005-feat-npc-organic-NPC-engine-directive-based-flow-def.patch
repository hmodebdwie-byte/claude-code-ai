+        const buyPot = snapshot ? snapshot.buyPot : livePotsBefore.buyPot + (side === 'BUY' ? amount : 0);
+        const sellPot = snapshot ? snapshot.sellPot : livePotsBefore.sellPot + (side === 'SELL' ? amount : 0);
