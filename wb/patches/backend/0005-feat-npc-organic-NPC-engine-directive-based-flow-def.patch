+                session.projection = null;
+                return;
+            }
+            const now = this.clock.now();
+            session.projection = planFinalInjection(ctx, {
+                dilutionEnabled: settings.defenses.dilutionEnabled,
+                dilutionSafetyMarginPct: settings.defenses.dilutionSafetyMarginPct,
+                ghostTownEnabled: settings.defenses.ghostTownEnabled,
+                ghostTownMarginPct: settings.defenses.ghostTownMarginPct,
+                maxUsd: settings.defenses.finalInjectionMaxUsd,
+                nowMs: now,
