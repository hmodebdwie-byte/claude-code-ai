+            if (!ctx) {
+                this.log.warn(`[OrganicNpc] round ${battleId}: exposure unavailable at the lock`);
+                return;
+            }
+            const plan = planFinalInjection(ctx, {
+                dilutionEnabled: settings.defenses.dilutionEnabled,
+                dilutionSafetyMarginPct: settings.defenses.dilutionSafetyMarginPct,
+                ghostTownEnabled: settings.defenses.ghostTownEnabled,
+                ghostTownMarginPct: settings.defenses.ghostTownMarginPct,
+                maxUsd: settings.defenses.finalInjectionMaxUsd,
+                nowMs: this.clock.now(),
+                currentPrice: ctx.currentPrice,
+            });
+            session.projection = plan;
+            session.projectionAtMs = this.clock.now();
+            const slicesDone: Array<{ npcId: number; amount: number; ok: boolean }> = [];
+            let executed = 0;
+            let lastPots: { buyPot: number; sellPot: number } | null = null;
+            if (plan.kind !== 'none' && plan.side && plan.amount > 0) {
+                const side = plan.side;
+                const candidates = [...session.tiers.whale, ...session.tiers.mid, ...session.tiers.retail].filter((id) => {
+                    const used = session.sideByNpc.get(id);
+                    return !used || used === side;
+                });
+                const shuffled = candidates.slice().sort(() => session.rng() - 0.5);
+                const slices = sliceInjection(plan.amount, shuffled, settings.defenses.finalInjectionMaxSlices, session.rng);
+                const results = await Promise.all(
+                    slices.map(async (slice) => {
+                        try {
+                            const r = await this.deps.executor.execute({ npcId: slice.npcId, battleId, side, amount: slice.amount, allowFinalize: true, urgent: true, topUpIfShort: true, source: `final_${plan.kind}` });
+                            return { slice, r };
+                        } catch (err) {
+                            this.log.warn(`[OrganicNpc] injection slice failed: ${err instanceof Error ? err.message : String(err)}`);
+                            return { slice, r: null };
+                        }
+                    }),
+                );
+                let missing = 0;
+                for (const { slice, r } of results) {
+                    slicesDone.push({ npcId: slice.npcId, amount: slice.amount, ok: r != null });
+                    if (r) {
+                        executed += r.amount;
+                        lastPots = { buyPot: r.buyPot, sellPot: r.sellPot };
+                        this.recordTrade(session, { atMs: this.clock.now(), npcId: slice.npcId, tier: 'injection', side, amount: r.amount, reason: plan.kind, buyPot: r.buyPot, sellPot: r.sellPot });
+                    } else {
+                        missing += slice.amount;
+                    }
+                }
+                // One retry for a failed slice with a fresh NPC so the protection is not left short.
+                if (missing > 0) {
+                    const retryIds = shuffled.filter((id) => !slicesDone.some((s) => s.npcId === id));
+                    const npcId = retryIds[0] ?? shuffled[0];
+                    if (npcId != null) {
+                        try {
+                            const r = await this.deps.executor.execute({ npcId, battleId, side, amount: Number(missing.toFixed(2)), allowFinalize: true, urgent: true, topUpIfShort: true, source: `final_${plan.kind}_retry` });
+                            slicesDone.push({ npcId, amount: Number(missing.toFixed(2)), ok: r != null });
+                            if (r) {
+                                executed += r.amount;
+                                lastPots = { buyPot: r.buyPot, sellPot: r.sellPot };
+                                this.recordTrade(session, { atMs: this.clock.now(), npcId, tier: 'injection', side, amount: r.amount, reason: `${plan.kind}_retry`, buyPot: r.buyPot, sellPot: r.sellPot });
+                            }
+                        } catch (err) {
+                            this.log.warn(`[OrganicNpc] injection retry failed: ${err instanceof Error ? err.message : String(err)}`);
+                        }
+                    }
+                }
+                if (lastPots) {
+                    await this.deps.onTradeExecuted({ battleId, buyPot: lastPots.buyPot, sellPot: lastPots.sellPot, startPrice: session.battle.startPrice, side, amount: executed });
+                }
+            }
+            const durationMs = this.clock.now() - t0;
+            session.injection = { plan, executed, slices: slicesDone, lockedAtMs: lockedAt, durationMs };
+            this.log.log(
+                `[OrganicNpc] round ${battleId} locked at T-${Math.max(0, session.endMs - lockedAt)}ms: ${plan.kind}` +
+                    (plan.kind !== 'none' ? ` ${plan.side} planned ${plan.amount.toFixed(2)} executed ${executed.toFixed(2)} in ${slicesDone.length} slice(s)` : ` (${plan.reason})`) +
+                    ` in ${durationMs} ms`,
+            );
+            void this.deps.audit.update(battleId, {
+                lockedAt: new Date(lockedAt),
+                finalInjection: { kind: plan.kind, side: plan.side, planned: plan.amount, executed, capped: plan.capped, reason: plan.reason, slices: slicesDone, projected: plan.projected, durationMs, lockLeadMs: Math.max(0, session.endMs - lockedAt) },
+                projection: { ...plan.projected, kind: plan.kind, atMs: lockedAt },
+            });
+            const view = this.liveView();
+            if (view) void this.deps.audit.publishLive(view);
+        } catch (err) {
+            this.log.warn(`[OrganicNpc] final injection failed round ${battleId}: ${err instanceof Error ? err.message : String(err)}`);
+        } finally {
+            await this.deps.redis.del(graceKey).catch(() => undefined);
+        }
+    }
+}
diff --git a/apps/engine/src/npc-organic/organic-settings.source.ts b/apps/engine/src/npc-organic/organic-settings.source.ts
new file mode 100644
index 0000000..a66ea6b
--- /dev/null
+++ b/apps/engine/src/npc-organic/organic-settings.source.ts
@@ -0,0 +1,135 @@
+import type Redis from 'ioredis';
+import {
+    NPC_ENGINE_MODE_REDIS_KEY,
+    NPC_ENGINE_MODE_SETTING_KEY,
+    NPC_ORGANIC_SETTINGS_CHANNEL,
+    NPC_ORGANIC_SETTINGS_REDIS_KEY,
+    NPC_ORGANIC_SETTINGS_SETTING_KEY,
+    parseNpcEngineMode,
+    parseOrganicSettingsDocument,
+    type NpcEngineMode,
+    type OrganicSettingsDocument,
+} from '@ticktrade/shared';
+import type { PrismaService } from '../prisma/prisma.service';
+import { createRedisClient } from '../redis/redis.client';
+
+const POLL_MS = Math.max(5_000, Number(process.env.NPC_ORGANIC_SETTINGS_POLL_MS ?? 20_000));
+
+type Getter = { get(key: string): Promise<string | null> };
+
+/**
+ * Live view of the organic engine settings and the engine mode.
+ *
+ * Fast path: the API writes the document to Redis and publishes it on
+ * {@link NPC_ORGANIC_SETTINGS_CHANNEL}; we apply it the moment it arrives. Fallbacks: a poll of
+ * the Redis key every {@link POLL_MS}, and the `system_settings` rows when Redis is empty (first boot).
+ */
+export class OrganicSettingsSource {
+    private doc: OrganicSettingsDocument = parseOrganicSettingsDocument(null);
+    private engineMode: NpcEngineMode = 'organic';
+    private appliedAtMs = 0;
+    private subscriber: Redis | null = null;
+    private pollTimer: ReturnType<typeof setInterval> | null = null;
+    private readonly listeners = new Set<(doc: OrganicSettingsDocument, mode: NpcEngineMode) => void>();
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly redis: Getter,
+    ) {}
+
+    current(): OrganicSettingsDocument {
+        return this.doc;
+    }
+
+    mode(): NpcEngineMode {
+        return this.engineMode;
+    }
+
+    appliedAt(): number {
+        return this.appliedAtMs;
+    }
+
+    onChange(listener: (doc: OrganicSettingsDocument, mode: NpcEngineMode) => void): () => void {
+        this.listeners.add(listener);
+        return () => this.listeners.delete(listener);
+    }
+
+    async start(): Promise<void> {
+        await this.refresh('boot');
+        try {
+            this.subscriber = createRedisClient('subscriber');
+            await this.subscriber.subscribe(NPC_ORGANIC_SETTINGS_CHANNEL);
+            this.subscriber.on('message', (channel, message) => {
+                if (channel !== NPC_ORGANIC_SETTINGS_CHANNEL) return;
+                try {
+                    const payload = JSON.parse(message) as { document?: unknown; mode?: unknown };
+                    const doc = parseOrganicSettingsDocument(
+                        payload.document != null ? JSON.stringify(payload.document) : null,
+                    );
+                    const mode = parseNpcEngineMode(payload.mode);
+                    this.apply(doc, mode, 'push');
+                } catch (err) {
+                    console.warn('[OrganicSettings] bad push payload', err instanceof Error ? err.message : err);
+                }
+            });
+        } catch (err) {
+            console.warn('[OrganicSettings] subscribe failed, polling only', err instanceof Error ? err.message : err);
+        }
+        this.pollTimer = setInterval(() => void this.refresh('poll'), POLL_MS);
+        if (typeof this.pollTimer.unref === 'function') this.pollTimer.unref();
+    }
+
+    async stop(): Promise<void> {
+        if (this.pollTimer) {
+            clearInterval(this.pollTimer);
+            this.pollTimer = null;
+        }
+        if (this.subscriber) {
+            try {
+                await this.subscriber.quit();
+            } catch {
+                /* ignore */
+            }
+            this.subscriber = null;
+        }
+    }
+
+    /** Reads Redis first, then the database; never throws. */
+    async refresh(reason: 'boot' | 'poll' | 'manual'): Promise<void> {
+        try {
+            let rawDoc = await this.redis.get(NPC_ORGANIC_SETTINGS_REDIS_KEY);
+            let rawMode = await this.redis.get(NPC_ENGINE_MODE_REDIS_KEY);
+            if (rawDoc == null || rawMode == null) {
+                const rows = await this.prisma.systemSetting.findMany({
+                    where: { settingKey: { in: [NPC_ORGANIC_SETTINGS_SETTING_KEY, NPC_ENGINE_MODE_SETTING_KEY] } },
+                    select: { settingKey: true, settingValue: true },
+                });
+                for (const r of rows) {
+                    if (r.settingKey === NPC_ORGANIC_SETTINGS_SETTING_KEY && rawDoc == null) rawDoc = r.settingValue;
+                    if (r.settingKey === NPC_ENGINE_MODE_SETTING_KEY && rawMode == null) rawMode = r.settingValue;
+                }
+            }
+            const doc = parseOrganicSettingsDocument(rawDoc);
+            const mode = parseNpcEngineMode(rawMode ?? doc.values.engine.mode);
+            this.apply(doc, mode, reason);
+        } catch (err) {
+            console.warn(`[OrganicSettings] refresh (${reason}) failed`, err instanceof Error ? err.message : err);
+        }
+    }
+
+    private apply(doc: OrganicSettingsDocument, mode: NpcEngineMode, reason: string): void {
+        const changed = doc.version !== this.doc.version || mode !== this.engineMode || this.appliedAtMs === 0;
+        this.doc = doc;
+        this.engineMode = mode;
+        this.appliedAtMs = Date.now();
+        if (!changed) return;
+        console.log(`[OrganicSettings] applied v${doc.version} mode=${mode} (${reason})`);
+        for (const l of this.listeners) {
+            try {
+                l(doc, mode);
+            } catch (err) {
+                console.warn('[OrganicSettings] listener failed', err instanceof Error ? err.message : err);
+            }
+        }
+    }
+}
diff --git a/apps/engine/src/npc-organic/round-audit.store.ts b/apps/engine/src/npc-organic/round-audit.store.ts
new file mode 100644
index 0000000..76a8ecc
--- /dev/null
+++ b/apps/engine/src/npc-organic/round-audit.store.ts
@@ -0,0 +1,99 @@
+import {
+    NPC_ORGANIC_ENGINE_STATUS_REDIS_KEY,
+    NPC_ORGANIC_ENGINE_STATUS_TTL_SEC,
+    NPC_ORGANIC_LIVE_REDIS_KEY,
+    NPC_ORGANIC_LIVE_TTL_SEC,
+} from '@ticktrade/shared';
+import type { PrismaService } from '../prisma/prisma.service';
+
+type Json = Record<string, unknown>;
+
+type RedisWriter = { setPx(key: string, value: string, ttlMs: number): Promise<void> };
+
+/**
+ * Persists the per-round audit (`npc_round_audit`) and the live telemetry documents the admin
+ * page polls. Every method is best-effort: an audit failure must never affect trading.
+ */
+export class RoundAuditStore {
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly redis: RedisWriter,
+    ) {}
+
+    async open(battleId: number, mode: string, settingsVersion: number, plan: Json): Promise<void> {
+        try {
+            await this.prisma.npcRoundAudit.upsert({
+                where: { battleId },
+                create: { battleId, mode, settingsVersion, plan: plan as never },
+                update: { mode, settingsVersion, plan: plan as never },
+            });
+        } catch (err) {
+            console.warn('[RoundAudit] open failed', err instanceof Error ? err.message : err);
+        }
+    }
+
+    async update(
+        battleId: number,
+        patch: { timeline?: Json; projection?: Json; finalInjection?: Json; lockedAt?: Date; settlement?: Json },
+    ): Promise<void> {
+        try {
+            await this.prisma.npcRoundAudit.updateMany({
+                where: { battleId },
+                data: {
+                    ...(patch.timeline ? { timeline: patch.timeline as never } : {}),
+                    ...(patch.projection ? { projection: patch.projection as never } : {}),
+                    ...(patch.finalInjection ? { finalInjection: patch.finalInjection as never } : {}),
+                    ...(patch.lockedAt ? { lockedAt: patch.lockedAt } : {}),
+                    ...(patch.settlement ? { settlement: patch.settlement as never } : {}),
+                },
+            });
+        } catch (err) {
+            console.warn('[RoundAudit] update failed', err instanceof Error ? err.message : err);
+        }
+    }
+
+    /** Settlement writes its invariants here; creates the row when the engine never opened it. */
+    async recordSettlement(battleId: number, mode: string, settlement: Json): Promise<void> {
+        try {
+            await this.prisma.npcRoundAudit.upsert({
+                where: { battleId },
+                create: { battleId, mode, settlement: settlement as never },
+                update: { settlement: settlement as never },
+            });
+        } catch (err) {
+            console.warn('[RoundAudit] recordSettlement failed', err instanceof Error ? err.message : err);
+        }
+    }
+
+    async prune(keepRounds: number): Promise<void> {
+        try {
+            const keep = Math.max(5, Math.floor(keepRounds));
+            const cutoff = await this.prisma.npcRoundAudit.findMany({
+                orderBy: { battleId: 'desc' },
+                skip: keep,
+                take: 1,
+                select: { battleId: true },
+            });
+            if (cutoff.length === 0) return;
+            await this.prisma.npcRoundAudit.deleteMany({ where: { battleId: { lte: cutoff[0]!.battleId } } });
+        } catch (err) {
+            console.warn('[RoundAudit] prune failed', err instanceof Error ? err.message : err);
+        }
+    }
+
+    async publishLive(doc: Json): Promise<void> {
+        try {
+            await this.redis.setPx(NPC_ORGANIC_LIVE_REDIS_KEY, JSON.stringify(doc), NPC_ORGANIC_LIVE_TTL_SEC * 1000);
+        } catch (err) {
+            console.warn('[RoundAudit] publishLive failed', err instanceof Error ? err.message : err);
+        }
+    }
+
+    async publishStatus(doc: Json): Promise<void> {
+        try {
+            await this.redis.setPx(NPC_ORGANIC_ENGINE_STATUS_REDIS_KEY, JSON.stringify(doc), NPC_ORGANIC_ENGINE_STATUS_TTL_SEC * 1000);
+        } catch (err) {
+            console.warn('[RoundAudit] publishStatus failed', err instanceof Error ? err.message : err);
+        }
+    }
+}
diff --git a/apps/engine/src/npc-organic/round-exposure.reader.ts b/apps/engine/src/npc-organic/round-exposure.reader.ts
new file mode 100644
index 0000000..40f7e54
--- /dev/null
+++ b/apps/engine/src/npc-organic/round-exposure.reader.ts
@@ -0,0 +1,189 @@
+import {
+    listBufferedNpcTrades,
+    listBufferedStakes,
+    npcTradeBufferEnabled,
+    redisStakeBufferEnabled,
+    type DirectiveNpcTrade,
+    type DirectiveRealStake,
+    type DirectiveRoundInput,
+} from '@ticktrade/shared';
+import type { PrismaService } from '../prisma/prisma.service';
+import { getSharedCommandRedis } from '../redis/redis.client';
+import type { BattlePotCache } from '../redis/battle-pot-cache';
+
+export interface RoundExposureContext extends DirectiveRoundInput {
+    battleId: number;
+    startTimeMs: number;
+    durationSeconds: number;
+    currentPrice: number;
+    realUserCount: number;
+    npcTradeCount: number;
+}
+
+/**
+ * Builds the settlement-equivalent view of a running round: real stakes (Postgres + Redis buffer,
+ * RPC bots excluded), simulator trades (Postgres + Redis buffer), live pots and the price path.
+ * The same shape feeds the final injection solver and the settlement, so the projection at the
+ * lock equals what settlement will compute.
+ */
+export class RoundExposureReader {
+    private readonly priceCache = new Map<number, { lastId: number; points: Array<{ price: number; timestampMs: number }> }>();
+
+    constructor(
+        private readonly prisma: PrismaService,
+        private readonly battlePotCache: BattlePotCache | null,
+        private readonly getLastPrice: () => Promise<number | null>,
+        private readonly getPlatformFeeRate: () => Promise<number>,
+    ) {}
+
+    forget(battleId: number): void {
+        this.priceCache.delete(battleId);
+    }
+
+    async read(battleId: number, opts?: { houseMaxRealLoserPoolRule?: boolean; maxSimulatorLossUsd?: number }): Promise<RoundExposureContext | null> {
+        const battle = await this.prisma.battle.findUnique({
+            where: { id: battleId },
+            select: { id: true, startPrice: true, startTime: true, durationSeconds: true, buyPot: true, sellPot: true, roundHigh: true, roundLow: true, status: true },
+        });
+        if (!battle || battle.status !== 'ACTIVE') return null;
+        const redis = getSharedCommandRedis();
+
+        const [dbStakes, dbNpc, bufferedStakes, bufferedNpc, feeRate, lastPrice, pots, pricePoints] = await Promise.all([
+            this.prisma.stake.findMany({
+                where: { battleId, status: 'ACTIVE' },
+                select: { id: true, userId: true, side: true, amount: true, entryPrice: true, createdAt: true },
+            }),
+            this.prisma.npcTrade.findMany({
+                where: { battleId },
+                select: { id: true, npcId: true, side: true, amount: true, executionPrice: true, createdAt: true },
+            }),
+            redisStakeBufferEnabled() ? listBufferedStakes(redis, battleId) : Promise.resolve([]),
+            npcTradeBufferEnabled() ? listBufferedNpcTrades(redis, battleId) : Promise.resolve([]),
+            this.getPlatformFeeRate(),
+            this.getLastPrice(),
+            this.battlePotCache ? this.battlePotCache.read(battleId) : Promise.resolve(null),
+            this.readPricePoints(battleId),
+        ]);
+
+        const userIds = new Set<number>();
+        for (const s of dbStakes) if (s.userId != null) userIds.add(s.userId);
+        for (const s of bufferedStakes) userIds.add(s.userId);
+        const rpcIds = new Set<number>();
+        if (userIds.size > 0) {
+            const ids = [...userIds];
+            const [linked, flagged] = await Promise.all([
+                this.prisma.rpcUser.findMany({ where: { linkedUserId: { in: ids } }, select: { linkedUserId: true } }),
+                this.prisma.user.findMany({ where: { id: { in: ids }, isRpc: true }, select: { id: true } }),
+            ]);
+            for (const r of linked) rpcIds.add(r.linkedUserId);
+            for (const u of flagged) rpcIds.add(u.id);
+        }
+
+        const startPrice = Number(battle.startPrice ?? 0);
+        const realStakes: DirectiveRealStake[] = [];
+        for (const s of dbStakes) {
+            if (s.userId == null || rpcIds.has(s.userId)) continue;
+            realStakes.push({
+                id: s.id,
+                userId: s.userId,
+                amount: Number(s.amount),
+                side: s.side as 'BUY' | 'SELL',
+                entryPrice: Number(s.entryPrice ?? startPrice) || startPrice,
+                entryTimestampMs: s.createdAt.getTime(),
+            });
+        }
+        for (const s of bufferedStakes) {
+            if (rpcIds.has(s.userId)) continue;
+            realStakes.push({
+                id: s.tempStakeId,
+                userId: s.userId,
+                amount: Number(s.amount),
+                side: s.side,
+                entryPrice: Number(s.entryPrice) || startPrice,
+                entryTimestampMs: Number(s.createdAtMs) || Date.now(),
+            });
+        }
+        const npcTrades: DirectiveNpcTrade[] = [];
+        for (const t of dbNpc) {
+            npcTrades.push({
+                id: t.id,
+                npcId: t.npcId,
+                amount: Number(t.amount),
+                side: t.side as 'BUY' | 'SELL',
+                entryPrice: t.executionPrice != null ? Number(t.executionPrice) : startPrice,
+                entryTimestampMs: t.createdAt.getTime(),
+            });
+        }
+        let tempId = -1_000_000;
+        for (const t of bufferedNpc) {
+            npcTrades.push({
+                id: tempId--,
+                npcId: t.npcId,
+                amount: Number(t.amount),
+                side: t.side,
+                entryPrice: Number(t.executionPrice) || startPrice,
+                entryTimestampMs: Number(t.createdAtMs) || Date.now(),
+            });
+        }
+
+        const currentPrice = lastPrice != null && Number.isFinite(lastPrice) && lastPrice > 0 ? lastPrice : startPrice;
+        let buyPot = Number(battle.buyPot ?? 0);
+        let sellPot = Number(battle.sellPot ?? 0);
+        if (pots) {
+            buyPot = pots.buyPot;
+            sellPot = pots.sellPot;
+        } else {
+            // No pot hash: rebuild from what we hold so a Redis blip never reads as an empty round.
+            buyPot = 0;
+            sellPot = 0;
+            for (const s of realStakes) (s.side === 'BUY' ? (buyPot += s.amount) : (sellPot += s.amount));
+            for (const t of npcTrades) (t.side === 'BUY' ? (buyPot += t.amount) : (sellPot += t.amount));
+        }
+        let roundHigh = battle.roundHigh != null ? Number(battle.roundHigh) : currentPrice;
+        let roundLow = battle.roundLow != null ? Number(battle.roundLow) : currentPrice;
+        for (const p of pricePoints) {
+            if (p.price > roundHigh) roundHigh = p.price;
+            if (p.price < roundLow) roundLow = p.price;
+        }
+        roundHigh = Math.max(roundHigh, currentPrice, startPrice);
+        roundLow = Math.min(roundLow, currentPrice, startPrice);
+
+        return {
+            battleId,
+            startTimeMs: battle.startTime.getTime(),
+            durationSeconds: battle.durationSeconds,
+            currentPrice,
+            realUserCount: realStakes.length ? new Set(realStakes.map((s) => s.userId)).size : 0,
+            npcTradeCount: npcTrades.length,
+            buyPot,
+            sellPot,
+            realStakes,
+            npcTrades,
+            finalPrice: currentPrice,
+            startPrice,
+            roundHigh,
+            roundLow,
+            pricePoints,
+            platformFeeRate: feeRate,
+            houseMaxRealLoserPoolRule: opts?.houseMaxRealLoserPoolRule,
+            maxSimulatorLossUsd: opts?.maxSimulatorLossUsd,
+        };
+    }
+
+    /** Incremental price path: only ticks newer than the last one seen are fetched. */
+    private async readPricePoints(battleId: number): Promise<Array<{ price: number; timestampMs: number }>> {
+        const cached = this.priceCache.get(battleId) ?? { lastId: 0, points: [] };
+        const rows = await this.prisma.priceTick.findMany({
+            where: { battleId, id: { gt: cached.lastId } },
+            orderBy: { id: 'asc' },
+            select: { id: true, price: true, createdAt: true },
+            take: 5_000,
+        });
+        for (const r of rows) {
+            cached.points.push({ price: Number(r.price), timestampMs: r.createdAt.getTime() });
+            cached.lastId = r.id;
+        }
+        this.priceCache.set(battleId, cached);
+        return cached.points;
+    }
+}
diff --git a/apps/engine/src/npc/npc-simulator.service.ts b/apps/engine/src/npc/npc-simulator.service.ts
index 000f04a..c673196 100644
--- a/apps/engine/src/npc/npc-simulator.service.ts
+++ b/apps/engine/src/npc/npc-simulator.service.ts
@@ -15814,6 +15814,112 @@ export class NpcSimulatorService {
         return { buyPot, sellPot, side, amount: clampedAmount };
     }
 
+    /**
+     * Cap-free commit path used by the Organic NPC Engine. It reuses the exact persistence steps of
+     * the legacy paths (Redis buffer or Postgres transaction, pot cache deltas, wire publish,
+     * leaderboard, per-round side lock) but applies none of the legacy pacing / defense policies —
+     * the organic engine decides what to place; this method only records it.
+     */
+    async executeOrganicNpcTrade(args: {
+        npcId: number;
+        battleId: number;
+        side: 'BUY' | 'SELL';
+        amount: number;
+        allowFinalize?: boolean;
+        urgent?: boolean;
+        topUpIfShort?: boolean;
+        source?: string;
+    }): Promise<{ buyPot: number; sellPot: number; side: 'BUY' | 'SELL'; amount: number; execPrice: number } | null> {
+        const amount = Number(Math.max(0.01, Number(args.amount)).toFixed(2));
+        if (!Number.isFinite(amount) || amount <= 0) return null;
+        const { npcId, battleId, side } = args;
+        const allowFinalize = args.allowFinalize === true;
+        const battle = await this.prisma.battle.findUnique({
+            where: { id: battleId },
+            select: { state: true, status: true, startTime: true, durationSeconds: true, startPrice: true },
+        });
+        if (!battle || battle.status !== 'ACTIVE') return null;
+        if (battle.state !== 'OPEN' && !(allowFinalize && battle.state === 'FINALIZE')) return null;
+        const remainingMs = battle.startTime.getTime() + (battle.durationSeconds ?? 0) * 1000 - Date.now();
+        if (!allowFinalize && remainingMs <= 0) return null;
+        if (!(await this.npcMayPlaceOnSide(npcId, battleId, side))) return null;
+
+        let execPx = await this.redisState.getLastPrice();
+        if (execPx == null || !Number.isFinite(execPx) || execPx <= 0) execPx = Number(battle.startPrice) || 0.23;
+        execPx = Math.max(1e-8, execPx);
+        const qty = computeTradeQuantityCoins(amount, execPx, {});
+        const potField = side === 'BUY' ? 'buyPot' : 'sellPot';
+        const qtyField = side === 'BUY' ? 'buyQtyNpc' : 'sellQtyNpc';
+        const livePotsBefore = await this.resolveLivePots(battleId);
+        const topUp = args.topUpIfShort !== false;
+
+        let potDeltas: BattlePotDelta[];
