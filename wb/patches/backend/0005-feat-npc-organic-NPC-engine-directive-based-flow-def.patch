+        this.armProjection(session, 2_000);
+        this.armLive(session);
+    }
+
+    private closeSession(reason: string): void {
+        const s = this.session;
+        if (!s) return;
+        s.closed = true;
+        for (const t of s.timers) this.clock.clearTimeout(t);
+        s.timers.clear();
+        if (s.finalTimer) this.clock.clearTimeout(s.finalTimer);
+        if (s.projectionTimer) this.clock.clearTimeout(s.projectionTimer);
+        if (s.liveTimer) this.clock.clearTimeout(s.liveTimer);
+        this.session = null;
+        this.deps.reader.forget?.(s.battle.id);
