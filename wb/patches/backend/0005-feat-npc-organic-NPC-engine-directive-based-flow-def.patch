+++ b/packages/shared/src/npc-organic/settings.spec.ts
@@ -0,0 +1,103 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    DEFAULT_ORGANIC_NPC_SETTINGS,
+    ORGANIC_FIELD_SPECS,
+    cloneOrganicSettings,
+    coerceOrganicSettings,
+    getPath,
+    isPeakTime,
+    parseOrganicSettingsDocument,
+    parsePeakHours,
+    validateOrganicSettings,
+} from './settings';
+
+test('defaults satisfy their own schema', () => {
+    assert.deepEqual(validateOrganicSettings(DEFAULT_ORGANIC_NPC_SETTINGS), []);
+    for (const spec of ORGANIC_FIELD_SPECS) {
+        assert.notEqual(getPath(DEFAULT_ORGANIC_NPC_SETTINGS, spec.path), undefined, `${spec.path} has no default`);
+    }
+});
+
+test('every field spec has a label, help text and a valid range', () => {
+    const paths = new Set<string>();
+    for (const spec of ORGANIC_FIELD_SPECS) {
+        assert.ok(!paths.has(spec.path), `duplicate ${spec.path}`);
+        paths.add(spec.path);
+        assert.ok(spec.label.length > 2 && spec.help.length > 10, spec.path);
+        if (spec.type === 'number' || spec.type === 'integer') {
+            assert.ok(spec.min != null && spec.max != null && spec.min <= spec.max, spec.path);
+        }
+        if (spec.type === 'select') assert.ok(spec.options && spec.options.length >= 2, spec.path);
+    }
+});
+
+test('validation reports type, range, inverted pairs and tier sums', () => {
+    const s = cloneOrganicSettings();
+    (s.roundStart as any).initialSpawnsMin = 'x';
+    s.roundStart.spawnDelayMinMs = 99;
+    let errors = validateOrganicSettings(s);
+    assert.ok(errors.some((e) => e.path === 'roundStart.initialSpawnsMin'));
+    assert.ok(errors.some((e) => e.path === 'roundStart.spawnDelayMinMs'));
+
+    const t = cloneOrganicSettings();
+    t.roundStart.spawnDelayMinMs = 20_000;
+    t.roundStart.spawnDelayMaxMs = 5_000;
+    t.tiers.whale.stakeMin = 60_000;
+    t.tiers.retail.rosterSharePct = 10;
+    errors = validateOrganicSettings(t);
+    assert.ok(errors.some((e) => e.path === 'roundStart.spawnDelayMaxMs'));
+    assert.ok(errors.some((e) => e.path === 'tiers.whale.stakeMax'));
+    assert.ok(errors.some((e) => e.path === 'tiers.retail.rosterSharePct'));
+
+    const u = cloneOrganicSettings();
+    u.momentum.rampToPeakFraction = 0.99;
+    u.momentum.lateFadeFraction = 0.9;
+    assert.ok(validateOrganicSettings(u).some((e) => e.path === 'momentum.lateFadeFraction'));
+});
+
+test('coercion never throws and falls back per field', () => {
+    const coerced = coerceOrganicSettings({
+        engine: { mode: 'weird' },
+        roundStart: { initialSpawnsMin: '7', initialSpawnsMax: 3, spawnDelayMinMs: -5, peakHours: 'garbage' },
+        momentum: { baseArrivalsPerMinute: 'NaN', peakArrivalsPerMinute: 10_000 },
+        tiers: { whale: { rosterSharePct: 0 }, mid: { rosterSharePct: 0 }, retail: { rosterSharePct: 0 } },
+        defenses: { dilutionEnabled: '0', ghostTownEnabled: 'true' },
+    });
+    assert.deepEqual(validateOrganicSettings(coerced), []);
+    assert.equal(coerced.engine.mode, 'organic');
+    assert.equal(coerced.roundStart.initialSpawnsMin, 3, 'inverted pair swapped');
+    assert.equal(coerced.roundStart.initialSpawnsMax, 7);
+    assert.equal(coerced.roundStart.spawnDelayMinMs, 200, 'clamped to min');
+    assert.equal(coerced.roundStart.peakHours, '', 'invalid text falls back');
+    assert.equal(coerced.momentum.baseArrivalsPerMinute, DEFAULT_ORGANIC_NPC_SETTINGS.momentum.baseArrivalsPerMinute);
+    assert.equal(coerced.momentum.peakArrivalsPerMinute, 600, 'clamped to max');
+    assert.equal(coerced.tiers.whale.rosterSharePct, 5, 'empty roster shares fall back to defaults');
+    assert.equal(coerced.defenses.dilutionEnabled, false);
+    assert.equal(coerced.defenses.ghostTownEnabled, true);
+    assert.equal(coerceOrganicSettings(null).momentum.peakArrivalsPerMinute, 24);
+});
+
+test('document parsing tolerates garbage and keeps version', () => {
+    const doc = parseOrganicSettingsDocument('{"version":12,"updatedAt":"2026-09-13T10:00:00.000Z","values":{"momentum":{"baseArrivalsPerMinute":9}}}');
+    assert.equal(doc.version, 12);
+    assert.equal(doc.values.momentum.baseArrivalsPerMinute, 9);
+    assert.equal(doc.values.momentum.peakArrivalsPerMinute, 24);
+    assert.equal(parseOrganicSettingsDocument('not json').version, 0);
+    assert.equal(parseOrganicSettingsDocument(null).values.engine.mode, 'organic');
+});
+
+test('peak hours parse and evaluate with timezone and midnight wrap', () => {
+    assert.deepEqual(parsePeakHours('18:00-23:00, 12:00-14:00, bad'), [
+        { from: 1080, to: 1380 },
+        { from: 720, to: 840 },
+    ]);
+    const rs = { ...DEFAULT_ORGANIC_NPC_SETTINGS.roundStart, peakHours: '22:00-02:00', peakTimezoneOffsetMinutes: 0 };
+    assert.equal(isPeakTime(rs, new Date('2026-09-13T23:30:00Z')), true);
+    assert.equal(isPeakTime(rs, new Date('2026-09-13T01:30:00Z')), true);
+    assert.equal(isPeakTime(rs, new Date('2026-09-13T12:00:00Z')), false);
+    const withOffset = { ...rs, peakHours: '09:00-10:00', peakTimezoneOffsetMinutes: 180 };
+    assert.equal(isPeakTime(withOffset, new Date('2026-09-13T06:30:00Z')), true, '06:30 UTC is 09:30 at UTC+3');
+    assert.equal(isPeakTime(withOffset, new Date('2026-09-13T09:30:00Z')), false);
+    assert.equal(isPeakTime({ ...rs, peakHours: '' }, new Date()), false);
+});
