+        void this.deps.redis.sadd?.(npcOrganicRoundTradersKey(session.battle.id), String(t.npcId), NPC_ORGANIC_ROUND_TRADERS_TTL_SEC);
+        void this.deps.onNpcParticipated?.(t.npcId);
+    }
+
+    // ------------------------------------------------------------------
+    // Projection (steering + live exposure)
+    // ------------------------------------------------------------------
+
+    private armProjection(session: RoundSession, delayMs: number): void {
+        if (session.closed) return;
+        session.projectionTimer = this.clock.setTimeout(() => {
+            session.projectionTimer = null;
+            if (session.closed || session.locked) return;
+            void this.refreshProjection(session).finally(() => this.armProjection(session, PROJECTION_MS));
+        }, delayMs);
+    }
+
+    private async refreshProjection(session: RoundSession): Promise<void> {
+        const settings = this.settings();
+        try {
+            const ctx = await this.deps.reader.read(session.battle.id, {
+                houseMaxRealLoserPoolRule: session.frozen.engine.houseMaxRealLoserPoolRule,
+                maxSimulatorLossUsd: settings.defenses.ghostTownFallbackMaxSimLossUsd,
+            });
