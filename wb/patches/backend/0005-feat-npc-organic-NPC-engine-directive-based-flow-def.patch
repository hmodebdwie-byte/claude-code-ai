@@ -0,0 +1,741 @@
+/**
+ * Organic NPC Engine — implements the NPC directives:
+ *   - organic trickle-in at round start, Poisson arrivals with momentum, tier stake brackets,
+ *   - a drawn per-round asymmetry (no parity logic, no reaction sized to real trades),
+ *   - Defense A (continuous steering of the organic flow),
+ *   - Defense B/C at T − lead: lock the round, then execute the single computed injection
+ *     (Lightning Dilution or Ghost Town), sliced across whale NPCs at the same instant.
+ *
+ * Everything time-related goes through an injectable clock so the behaviour is testable.
+ */
+import {
+    BATTLE_LOCKED_CHANNEL,
+    BATTLE_LOCK_TTL_SEC,
+    NPC_ORGANIC_ROUND_TRADERS_TTL_SEC,
+    arrivalsPerMinute,
+    assignTiers,
+    battleLockKey,
+    chooseSide,
+    computeDirectiveSettlement,
+    drawLeadTarget,
+    drawNextArrivalDelayMs,
+    drawQuietPeriodMs,
+    drawStake,
+    isPeakTime,
+    npcOrganicRoundTradersKey,
+    pickTier,
+    planFinalInjection,
+    planInitialWave,
+    redisSettlementGraceKey,
+    seededRng,
+    sliceInjection,
+    steeringSideFor,
+    summarizeNetReal,
+    computeUserNetPositions,
+    type FinalInjectionPlan,
+    type InitialWavePlan,
+    type LeadTarget,
+    type NpcSide,
+    type OrganicNpcSettings,
+    type OrganicTier,
+    type Rng,
+    type RosterRow,
+    type TierAssignment,
+} from '@ticktrade/shared';
+import type { OrganicSettingsSource } from './organic-settings.source';
+import type { RoundAuditStore } from './round-audit.store';
+import type { RoundExposureContext } from './round-exposure.reader';
+
+export interface OpenBattle {
+    id: number;
+    startTimeMs: number;
+    durationSeconds: number;
+    startPrice: number;
+}
+
+export interface ExecutedNpcTrade {
+    buyPot: number;
+    sellPot: number;
+    side: NpcSide;
+    amount: number;
+    execPrice: number;
+}
+
+export interface OrganicTradeExecutor {
+    execute(args: {
+        npcId: number;
+        battleId: number;
+        side: NpcSide;
+        amount: number;
+        allowFinalize?: boolean;
+        urgent?: boolean;
+        topUpIfShort?: boolean;
+        source: string;
+    }): Promise<ExecutedNpcTrade | null>;
+}
+
+export interface OrganicClock {
+    now(): number;
+    setTimeout(fn: () => void, ms: number): unknown;
+    clearTimeout(handle: unknown): void;
+}
+
+export interface OrganicEngineDeps {
+    settings: Pick<OrganicSettingsSource, 'current' | 'mode'> & Partial<Pick<OrganicSettingsSource, 'onChange'>>;
+    executor: OrganicTradeExecutor;
+    reader: { read(battleId: number, opts?: { houseMaxRealLoserPoolRule?: boolean; maxSimulatorLossUsd?: number }): Promise<RoundExposureContext | null>; forget?(battleId: number): void };
+    audit: Pick<RoundAuditStore, 'open' | 'update' | 'publishLive' | 'publishStatus' | 'prune'>;
+    battles: { findOpen(): Promise<OpenBattle | null> };
+    roster: { load(): Promise<RosterRow[]> };
+    redis: {
+        get(key: string): Promise<string | null>;
+        setPx(key: string, value: string, ttlMs: number): Promise<void>;
+        del(key: string): Promise<void>;
+        publish(channel: string, payload: unknown): Promise<void>;
+        sadd?(key: string, member: string, ttlSec: number): Promise<void>;
+    };
+    onTradeExecuted: (payload: { battleId: number; buyPot: number; sellPot: number; startPrice: number; side: NpcSide; amount: number }) => Promise<void>;
+    /** Called after a trade landed so rotation counters / lastParticipatedAt can be stamped. */
+    onNpcParticipated?: (npcId: number) => Promise<void>;
+    /** Returns true when this NPC may trade now (rotation caps, cooldowns). Default: always. */
+    isNpcEligible?: (npcId: number) => Promise<boolean>;
+    isLeader: () => boolean;
+    clock?: OrganicClock;
+    rngFactory?: (seed: number) => Rng;
+    /** Milliseconds to wait after the lock so in-flight real orders commit before the exposure read. */
+    lockDrainMs?: number;
+    logger?: { log(msg: string): void; warn(msg: string): void };
+}
+
+const POLL_MS = 1_000;
+const PROJECTION_MS = 5_000;
+const LIVE_MS = 1_000;
+/** Engine status heartbeat outside the live loop (between rounds). */
+const STATUS_HEARTBEAT_MS = 5_000;
+const ROSTER_TTL_MS = 60_000;
+const MAX_TIMELINE = 400;
+
+export interface OrganicTradeRecord {
+    atMs: number;
+    elapsedSec: number;
+    npcId: number;
+    tier: OrganicTier | 'injection';
+    side: NpcSide;
+    amount: number;
+    reason: string;
+    buyPot: number;
+    sellPot: number;
+}
+
+interface RoundSession {
+    battle: OpenBattle;
+    endMs: number;
+    rng: Rng;
+    frozen: Pick<OrganicNpcSettings, 'roundStart' | 'asymmetry' | 'engine'>;
+    settingsVersion: number;
+    wave: InitialWavePlan;
+    lead: LeadTarget;
+    peak: boolean;
+    tiers: TierAssignment;
+    sideByNpc: Map<number, NpcSide>;
+    simVolume: { BUY: number; SELL: number };
+    trades: OrganicTradeRecord[];
+    tradeCount: number;
+    lastRealTrade: { side: NpcSide; atMs: number; amount: number } | null;
+    realTradeCount: number;
+    boostUntilMs: number;
+    quietUntilMs: number;
+    steeringSide: NpcSide | null;
+    projection: FinalInjectionPlan | null;
+    projectionAtMs: number;
+    injection: { plan: FinalInjectionPlan; executed: number; slices: Array<{ npcId: number; amount: number; ok: boolean }>; lockedAtMs: number; durationMs: number } | null;
+    locked: boolean;
+    finalScheduled: boolean;
+    timers: Set<unknown>;
+    finalTimer: unknown;
+    projectionTimer: unknown;
+    liveTimer: unknown;
+    closed: boolean;
+    lastPots: { buyPot: number; sellPot: number };
