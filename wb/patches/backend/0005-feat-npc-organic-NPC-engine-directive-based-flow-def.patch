+++ b/apps/engine/src/battle/directive-settlement.applier.ts
@@ -0,0 +1,263 @@
+/**
+ * Applies the directive settlement (`computeDirectiveSettlement`) inside the settlement
+ * transaction: user balances + ledger, stake rows, NPC balances + trade payouts, MVP, and the
+ * audit row with the three invariants (company = commission, simulator = seed back, real winners
+ * = net real loser pool + surplus).
+ */
+import { Prisma } from '@prisma/client';
+import {
+    computeDirectiveSettlement,
+    type DirectiveRoundInput,
+    type DirectiveSettlementResult,
+} from '@ticktrade/shared';
+
+type Tx = Prisma.TransactionClient;
+
+export interface DirectiveApplyParams {
+    battleId: number;
+    input: DirectiveRoundInput;
+    finalPrice: number;
+    startPrice: number;
+    winnerResolution: Record<string, unknown>;
+    biggestTrade: { userId: number; amount: number } | null;
+    battleBuyPot: number;
+    battleSellPot: number;
+    realUserCount: number;
+    npcUserCount: number;
+    hedgedUserCount: number;
+    realBetAmount: number;
+    npcBetAmount: number;
+    totalBetAmount: number;
+    rpcLinkedUserIds: number[];
+    settingsVersion: number;
+}
+
+export interface DirectiveApplyOutput {
+    result: DirectiveSettlementResult;
+    postSettlementUsers: Array<{ userId: number; stakeAmount: number; payout: number; isWinner: boolean }>;
+    lastBattleLog: Record<string, unknown>;
+    battleEndCore: {
+        winnerSide: 'BUY' | 'SELL' | 'TIE';
+        buyPot: number;
+        sellPot: number;
+        mvpUserId: number | null;
+        mvpProfit: number | null;
+        biggestTradeUserId: number | null;
+        biggestTradeAmount: number | null;
+    };
+}
+
+function r2(n: number): number {
+    return Math.round(n * 100) / 100;
+}
+
+export async function applyDirectiveSettlement(tx: Tx, p: DirectiveApplyParams): Promise<DirectiveApplyOutput> {
+    const { battleId } = p;
+    const result = computeDirectiveSettlement(p.input);
+
+    // ---- Real users ---------------------------------------------------------------------
+    type StakeWrite = { stakeId: number; userId: number; payout: number; status: 'WON' | 'LOST' | 'REFUNDED'; score: number | null; credit: number; amount: number };
+    const stakeWrites: StakeWrite[] = [...result.stakes.values()]
+        .map((o) => ({ stakeId: o.stakeId, userId: o.userId, payout: r2(o.profit), status: o.status, score: o.score == null ? null : r2(o.score), credit: r2(o.credit), amount: o.amount }))
+        .sort((a, b) => a.stakeId - b.stakeId);
+
+    const rewardMap = new Map<number, { stakeAmount: number; payout: number; isWinner: boolean }>();
+    for (const w of stakeWrites) {
+        const u = result.users.get(w.userId);
+        const prev = rewardMap.get(w.userId) ?? { stakeAmount: 0, payout: 0, isWinner: false };
+        rewardMap.set(w.userId, {
+            stakeAmount: prev.stakeAmount + w.amount,
+            payout: prev.payout + w.payout,
+            isWinner: u?.side != null && u.side === result.winnerSide,
+        });
+    }
+
+    const userIds = [...new Set(stakeWrites.map((w) => w.userId))];
+    if (userIds.length > 0) {
+        const prior = await tx.user.findMany({ where: { id: { in: userIds } }, select: { id: true, balance: true } });
+        const running = new Map<number, number>(prior.map((u: { id: number; balance: unknown }) => [u.id, Number(u.balance)]));
+        const ledgerRows: Array<{ userId: number; type: string; amount: number; balanceAfter: number; description: string; battleId: number }> = [];
+        const netCredit = new Map<number, number>();
+        for (const w of stakeWrites) {
+            const total = r2(w.credit + w.payout);
+            if (total <= 0) continue;
+            const bal = running.get(w.userId);
+            if (bal == null) continue;
+            const after = r2(bal + total);
+            running.set(w.userId, after);
+            netCredit.set(w.userId, r2((netCredit.get(w.userId) ?? 0) + total));
+            const description =
+                w.status === 'WON'
+                    ? `Battle #${battleId} won - stake + payout`
+                    : w.credit + 1e-6 >= w.amount
+                      ? `Battle #${battleId} hedge refund`
+                      : `Battle #${battleId} matched hedge portion returned`;
+            ledgerRows.push({ userId: w.userId, type: w.status === 'WON' ? 'payout' : 'refund', amount: total, balanceAfter: after, description, battleId });
+        }
+        if (netCredit.size > 0) {
+            const rows = Prisma.join([...netCredit.entries()].map(([userId, credit]) => Prisma.sql`(${userId}::int, ${credit}::numeric)`));
+            await tx.$executeRaw(Prisma.sql`
+                UPDATE "users" AS u
+                   SET "balance" = u."balance" + v.credit,
+                       "updatedAt" = NOW()
+                  FROM (VALUES ${rows}) AS v(id, credit)
+                 WHERE u.id = v.id
+            `);
+        }
+        if (ledgerRows.length > 0) {
+            await tx.ledger.createMany({ data: ledgerRows });
+        }
+        const stakeRows = Prisma.join(
+            stakeWrites.map((w) => Prisma.sql`(${w.stakeId}::int, ${w.payout}::numeric, ${w.status}::text, ${w.score}::numeric)`),
+        );
+        await tx.$executeRaw(Prisma.sql`
+            UPDATE "stakes" AS s
+               SET "payout" = v.payout,
+                   "status" = v.status::"StakeStatus",
+                   "calculatedScore" = COALESCE(v.score, s."calculatedScore"),
+                   "updatedAt" = NOW()
+              FROM (VALUES ${stakeRows}) AS v(id, payout, status, score)
+             WHERE s.id = v.id
+        `);
+    }
+    // RPC-linked users never take part in real payouts; close their rows like the legacy path.
+    if (p.rpcLinkedUserIds.length > 0) {
+        await tx.stake.updateMany({ where: { battleId, userId: { in: p.rpcLinkedUserIds }, status: 'ACTIVE' }, data: { status: 'LOST', payout: 0 } });
+    }
+    await tx.stake.updateMany({ where: { battleId, status: 'ACTIVE' }, data: { status: 'LOST', payout: 0 } });
+
+    // ---- NPC traders ----------------------------------------------------------------------
+    const npcCredit = new Map<number, number>();
+    const npcPayoutRows: Array<{ tradeId: number; profit: number }> = [];
+    let distributedToNpcs = 0;
+    for (const o of result.npcTrades.values()) {
+        if (o.tradeId < 0) continue; // hypothetical rows never reach settlement
+        const total = r2(o.credit + o.profit);
+        npcPayoutRows.push({ tradeId: o.tradeId, profit: r2(o.profit) });
+        if (total > 0) {
+            npcCredit.set(o.npcId, r2((npcCredit.get(o.npcId) ?? 0) + total));
+            distributedToNpcs += o.profit;
+        }
+    }
+    if (npcCredit.size > 0) {
+        const rows = Prisma.join([...npcCredit.entries()].map(([npcId, credit]) => Prisma.sql`(${npcId}::int, ${credit}::numeric)`));
+        await tx.$executeRaw(Prisma.sql`
+            UPDATE "npc_traders" AS n
+               SET "balance" = n."balance" + v.credit
+              FROM (VALUES ${rows}) AS v(id, credit)
+             WHERE n.id = v.id
+        `);
+    }
+    if (npcPayoutRows.length > 0) {
+        const rows = Prisma.join(npcPayoutRows.map((w) => Prisma.sql`(${w.tradeId}::int, ${w.profit}::numeric)`));
+        await tx.$executeRaw(Prisma.sql`
+            UPDATE "npc_trades" AS t
+               SET "payout" = v.payout
+              FROM (VALUES ${rows}) AS v(id, payout)
+             WHERE t.id = v.id
+        `);
+    }
+
+    // ---- MVP --------------------------------------------------------------------------------
+    let mvpUserId: number | null = null;
+    let mvpProfit = 0;
+    for (const [userId, data] of rewardMap) {
+        if (!data.isWinner) continue;
+        if (mvpUserId === null || data.payout > mvpProfit || (data.payout === mvpProfit && userId < mvpUserId)) {
+            mvpProfit = data.payout;
+            mvpUserId = userId;
+        }
+    }
+    if (mvpUserId != null) {
+        await tx.battle.update({ where: { id: battleId }, data: { mvpUserId, mvpProfit } });
+    }
+
+    // ---- Details for logs / post-settlement work ----------------------------------------------
+    const postSettlementUsers = [...rewardMap.entries()].map(([userId, data]) => ({ userId, ...data }));
+    const names = userIds.length > 0 ? await tx.user.findMany({ where: { id: { in: userIds } }, select: { id: true, name: true } }) : [];
+    const nameById = new Map<number, string>(names.map((u: { id: number; name: string }) => [u.id, u.name]));
+    const realUserDetails = [...rewardMap.entries()].map(([userId, data]) => ({
+        userId,
+        userName: nameById.get(userId) ?? `user-${userId}`,
+        totalStakeAmount: data.stakeAmount,
+        distributedAmount: data.payout,
+        isWinner: data.isWinner,
+    }));
+
+    const invariants = {
+        model: 'directive',
+        winnerSide: result.winnerSide,
+        winnerReason: result.winnerReason,
+        platformFeeRate: result.platformFeeRate,
+        realLosingVolume: r2(result.realLosingVolume),
+        realWinningVolume: r2(result.realWinningVolume),
+        commission: r2(result.commission),
+        netRealLoserPool: r2(result.netRealLoserPool),
+        simLosingVolume: r2(result.simLosingVolume),
+        simWinningVolume: r2(result.simWinningVolume),
+        distributablePot: r2(result.distributablePot),
+        simProfitRaw: r2(result.simProfitRaw),
+        simProfit: r2(result.simProfit),
+        surplusToReal: r2(result.surplusToReal),
+        realWinnersTotal: r2(result.realWinnersTotal),
+        houseRetained: r2(result.houseRetained),
+        simulatorFundedRealWinners: r2(result.simulatorFundedRealWinners),
+        simulatorNet: r2(result.simulatorNet),
+        companyNet: r2(result.companyNet),
+        realWinnerUserCount: result.realWinnerUserCount,
+        realLoserUserCount: result.realLoserUserCount,
+        settingsVersion: p.settingsVersion,
+    };
+    await tx.npcRoundAudit.upsert({
+        where: { battleId },
+        create: { battleId, mode: 'organic', settingsVersion: p.settingsVersion, settlement: invariants as never },
+        update: { settlement: invariants as never },
+    });
+
+    const lastBattleLog: Record<string, unknown> = {
+        battleId,
+        settledAt: new Date().toISOString(),
+        winnerSide: result.winnerSide,
+        winnerResolution: p.winnerResolution,
+        settlementModel: 'directive',
+        finalPrice: p.finalPrice,
+        startPrice: p.startPrice,
+        pots: {
+            buyPot: p.battleBuyPot,
+            sellPot: p.battleSellPot,
+            realBuyNet: r2(result.winnerSide === 'BUY' ? result.realWinningVolume : result.realLosingVolume),
+            realSellNet: r2(result.winnerSide === 'SELL' ? result.realWinningVolume : result.realLosingVolume),
+        },
+        participants: { realUsers: p.realUserCount, npcUsers: p.npcUserCount, hedgedUsers: p.hedgedUserCount },
+        bettingAmounts: { realBetAmount: p.realBetAmount, npcBetAmount: p.npcBetAmount, totalBetAmount: p.totalBetAmount },
+        distribution: {
+            losingPoolUsed: r2(result.realLosingVolume),
+            rewardPool: r2(result.netRealLoserPool),
+            platformFee: r2(result.commission),
+            distributedToRealUsers: r2(result.realWinnersTotal),
+            npcRetainedRewardShare: r2(result.houseRetained),
+            distributedToNpcWinners: r2(distributedToNpcs),
+            npcWinnerPoolFee: 0,
+            payoutLiability: r2(result.realWinnersTotal),
+            dilutionTriggered: result.surplusToReal > 0,
+            injectionAmount: 0,
+        },
+        directive: invariants,
+        realUserDetails,
+    };
+
+    return {
+        result,
+        postSettlementUsers,
+        lastBattleLog,
+        battleEndCore: {
+            winnerSide: result.winnerSide,
+            buyPot: p.battleBuyPot,
+            sellPot: p.battleSellPot,
+            mvpUserId,
+            mvpProfit: mvpUserId != null ? mvpProfit : null,
+            biggestTradeUserId: p.biggestTrade?.userId ?? null,
+            biggestTradeAmount: p.biggestTrade != null ? p.biggestTrade.amount : null,
+        },
+    };
+}
