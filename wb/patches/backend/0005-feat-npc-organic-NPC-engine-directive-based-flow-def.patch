+    }
+
+    // ------------------------------------------------------------------
+    // Round detection
+    // ------------------------------------------------------------------
+
+    private settings(): OrganicNpcSettings {
+        return this.deps.settings.current().values;
+    }
+
+    private schedulePoll(delayMs: number): void {
+        if (!this.active) return;
+        if (this.pollTimer) this.clock.clearTimeout(this.pollTimer);
+        this.pollTimer = this.clock.setTimeout(() => {
+            this.pollTimer = null;
+            void this.poll();
+        }, delayMs);
+    }
+
+    private async poll(): Promise<void> {
+        if (!this.active || this.polling) {
+            if (this.active) this.schedulePoll(POLL_MS);
+            return;
+        }
+        this.polling = true;
+        try {
+            if (!this.deps.isLeader()) {
+                if (this.session) this.closeSession('not_leader');
+                return;
+            }
+            const battle = await this.deps.battles.findOpen();
+            if (!battle) {
+                if (this.session) this.closeSession('no_open_battle');
+                return;
+            }
+            if (this.session && this.session.battle.id !== battle.id) this.closeSession('new_battle');
+            if (!this.session) await this.openSession(battle);
+        } catch (err) {
+            this.log.warn(`[OrganicNpc] poll failed: ${err instanceof Error ? err.message : String(err)}`);
+        } finally {
+            this.polling = false;
+            this.schedulePoll(POLL_MS);
+        }
+    }
+
+    private async loadRoster(): Promise<RosterRow[]> {
+        const now = this.clock.now();
