diff -ruN '--exclude=.npmrc' a/apps/engine/src/npc/npc-startup-off.regression.cjs b/apps/engine/src/npc/npc-startup-off.regression.cjs
--- a/apps/engine/src/npc/npc-startup-off.regression.cjs	1970-01-01 00:00:00.000000000 +0000
