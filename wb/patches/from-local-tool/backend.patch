+// Run from backend root: node --test apps/engine/src/npc/npc-startup-off.regression.cjs
+// Loads the actual listener and shared flag policy with every I/O dependency
+// replaced in memory. No simulator implementation, trades or services execute.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const root = path.resolve(__dirname, '../../../..');
+const engineRequire = createRequire(path.join(root, 'apps/engine/package.json'));
+const ts = engineRequire('typescript');
+
+function loadSource(file, dependencies = {}) {
+  const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+    fileName: file,
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2021 },
+  }).outputText;
+  const exports = {};
+  const context = {
+    exports, module: { exports }, process: { env: {} },
+    console: { error: (...args) => { throw Error('Unexpected listener error: ' + String(args[0])); } },
+    require: name => {
+      if (!Object.hasOwn(dependencies, name)) throw Error('Unexpected dependency: ' + name);
+      return dependencies[name];
+    },
+  };
+  vm.runInNewContext(code, context, { filename: file, timeout: 1000 });
+  return context.module.exports;
+}
+
+const flags = loadSource(path.join(root, 'packages/shared/src/events/npc-simulator.redis.ts'));
+const { NpcWorkerCommandListener } = loadSource(
+  path.join(root, 'apps/npc-worker/src/npc-worker.command.listener.ts'), {
+    '@ticktrade/shared': flags,
+    '@engine/redis/redis.client': {
+      createRedisClient: () => ({}), getSharedCommandRedis: () => ({}),
+    },
+  });
+
+function fixture(raw, { active = false, leader = true, afterRead } = {}) {
+  let desired = raw;
+  const calls = { starts: 0, stops: 0, reads: 0, desiredWrites: [], heartbeats: [], published: [], startedCallbacks: 0 };
+  const simulator = {
+    isActive: () => active,
+    start: () => { calls.starts++; active = true; return true; },
+    stop: () => { calls.stops++; active = false; return true; },
+    getNpcPaceTier: () => 'normal',
+  };
+  const publisher = {
+    get: async key => {
+      assert.equal(key, flags.NPC_SIMULATOR_ACTIVE_REDIS_KEY);
+      calls.reads++;
+      const seen = desired;
+      if (afterRead) desired = afterRead(seen);
+      return seen;
+    },
+    set: async (key, value) => {
+      assert.equal(key, flags.NPC_SIMULATOR_ACTIVE_REDIS_KEY);
+      calls.desiredWrites.push([key, value]); desired = value;
+    },
+    setPx: async (key, value) => {
+      assert.notEqual(key, flags.NPC_SIMULATOR_ACTIVE_REDIS_KEY, 'heartbeat must not write operator choice');
+      calls.heartbeats.push([key, value]);
+    },
+    publish: async (channel, value) => calls.published.push({ channel, value }),
+  };
+  const listener = new NpcWorkerCommandListener(simulator, publisher, () => leader,
+    undefined, undefined, () => calls.startedCallbacks++);
+  return { listener, calls, desired: () => desired, active: () => active };
+}
+
+test('persisted OFF before startup remains OFF without start or enable write', async () => {
+  const f = fixture(flags.NPC_SIMULATOR_ACTIVE_OFF);
+  await f.listener.syncDesiredStateFromRedis('boot');
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_OFF);
+  assert.equal(f.calls.starts, 0);
+  assert.equal(f.calls.startedCallbacks, 0);
+  assert.equal(f.active(), false);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
+
+test('OFF on leadership startup stops an already active stub without changing the flag', async () => {
+  const f = fixture(flags.NPC_SIMULATOR_ACTIVE_OFF, { active: true });
+  await f.listener.syncDesiredStateFromRedis('boot');
+  assert.equal(f.calls.stops, 1);
+  assert.equal(f.calls.starts, 0);
+  assert.equal(f.active(), false);
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_OFF);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
+
+test('persisted ON starts once without rewriting the operator flag', async () => {
+  const f = fixture(flags.NPC_SIMULATOR_ACTIVE_ON);
+  await f.listener.syncDesiredStateFromRedis('boot');
+  await f.listener.syncDesiredStateFromRedis('boot');
+  assert.equal(f.calls.starts, 1);
+  assert.equal(f.calls.startedCallbacks, 1);
+  assert.equal(f.active(), true);
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_ON);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
+
+for (const [name, raw] of [['missing', null], ['empty', '']]) {
+  test(name + ' flag retains the existing shared default ON without persisting a new choice', async () => {
+    const f = fixture(raw);
+    assert.equal(flags.isNpcSimulatorDesiredActive(raw), true);
+    await f.listener.syncDesiredStateFromRedis('boot');
+    assert.equal(f.calls.starts, 1);
+    assert.equal(f.active(), true);
+    assert.equal(f.desired(), raw);
+    assert.deepEqual(f.calls.desiredWrites, []);
+  });
+}
+
+test('standby startup does not read, start or overwrite the operator choice', async () => {
+  const f = fixture(flags.NPC_SIMULATOR_ACTIVE_ON, { leader: false });
+  await f.listener.syncDesiredStateFromRedis('boot');
+  assert.equal(f.calls.reads, 0);
+  assert.equal(f.calls.starts, 0);
+  assert.equal(f.calls.heartbeats.length, 0);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
+
+test('poll continues to honour OFF without rewriting it', async () => {
+  const f = fixture(flags.NPC_SIMULATOR_ACTIVE_OFF, { active: true });
+  await f.listener.syncDesiredStateFromRedis('poll');
+  assert.equal(f.calls.stops, 1);
+  assert.equal(f.active(), false);
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_OFF);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
+
+test('operator STOP arriving after boot read is not overwritten and the next poll stops', async () => {
+  const f = fixture(null, { afterRead: () => flags.NPC_SIMULATOR_ACTIVE_OFF });
+  await f.listener.syncDesiredStateFromRedis('boot');
+  // Startup may act on its old read. This test does not claim an atomic
+  // read/start boundary: it proves the newer STOP survives and is reconciled.
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_OFF);
+  assert.deepEqual(f.calls.desiredWrites, []);
+  await f.listener.syncDesiredStateFromRedis('poll');
+  assert.equal(f.active(), false);
+  assert.equal(f.calls.stops, 1);
+  assert.equal(f.desired(), flags.NPC_SIMULATOR_ACTIVE_OFF);
+  assert.deepEqual(f.calls.desiredWrites, []);
+});
