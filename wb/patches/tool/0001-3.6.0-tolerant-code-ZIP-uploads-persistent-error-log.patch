 Use current source evidence. Owner-approved specifications and owner decisions outrank references and research; code behavior is not proof of intended behavior. Explicitly identify conflicts and missing rules. Cite source-backed factual claims with [S1], [S2], etc. Only cite identifiers actually provided. Distinguish your general knowledge or proposals from facts established by supplied sources.
@@ -68,6 +68,10 @@ class Application:
         self.model_probe_thread = None
         self.model_probe_checked_at = None
         self.model_config_revision = 0
+        self.logs_dir = self.data_dir / 'logs'
+        self.logs_dir.mkdir(exist_ok=True, mode=0o700)
+        self.error_log = self.logs_dir / 'errors.log'
+        self.error_log_lock = threading.Lock()
         if seed and not self.memory.state('seed_imported'):
             path = ROOT / 'seed' / 'TickTrade Master Specification.txt'
             if path.exists():
@@ -94,6 +98,28 @@ class Application:
         self._development = None
         self.development_lock = threading.Lock()
 
+    def log_error(self, context, exc=None):
+        """Append a redacted traceback to data/logs/errors.log so a failure can be diagnosed later.
+
+        Never raises. Secrets known to the app (API key, GitHub session token) are redacted.
+        The log rotates once at 2 MB so it cannot grow without bound.
+        """
+        try:
+            from core.memory import now
+            text = traceback.format_exc() if exc is None else ''.join(traceback.format_exception(type(exc), exc, exc.__traceback__))
+            secrets = [self.api_key, getattr(self._github, 'token', '') if self._github is not None else '']
+            for secret in secrets:
+                if secret:
+                    text = text.replace(secret, '[redacted]')
+            entry = f'{now()} {context}\n{text.rstrip()}\n\n'
+            with self.error_log_lock:
+                if self.error_log.exists() and self.error_log.stat().st_size > 2 * 1024 * 1024:
+                    os.replace(self.error_log, self.error_log.with_name('errors.log.1'))
+                with self.error_log.open('a', encoding='utf-8') as stream:
+                    stream.write(entry)
+        except Exception:
+            pass
+
     @property
     def development(self):
         with self.development_lock:
