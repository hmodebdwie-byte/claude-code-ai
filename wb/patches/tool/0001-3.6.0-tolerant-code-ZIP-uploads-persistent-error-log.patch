diff --git a/tests/test_upload_robustness.py b/tests/test_upload_robustness.py
new file mode 100644
index 0000000..a885122
--- /dev/null
+++ b/tests/test_upload_robustness.py
@@ -0,0 +1,122 @@
+"""Owner ZIP uploads made from working folders, Finder exports and failures that must stay diagnosable."""
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+import warnings
+import zipfile
+
+from app import Application
+from core import github_projects as projects
+
+
+def archive(files, compression=zipfile.ZIP_DEFLATED):
+    target = io.BytesIO()
+    with warnings.catch_warnings(), zipfile.ZipFile(target, 'w', compression) as output:
+        warnings.simplefilter('ignore', UserWarning)
+        for name, text in files:
+            output.writestr(name, text)
+    return target.getvalue()
+
+
+class WorkingFolderZipTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.destination = Path(self.temporary.name) / 'destination'
+        self.destination.mkdir()
+
+    def tearDown(self):
+        self.temporary.cleanup()
+
+    def test_dependency_folders_are_ignored_before_entry_limits(self):
+        files = [('project/src/app.ts', 'export const a = 1;'), ('project/package.json', '{"name":"x"}')]
+        files += [(f'project/node_modules/pkg{n // 50}/index{n}.js', 'x') for n in range(3000)]
+        files += [('project/dist/bundle.js', 'built'), ('project/.git/HEAD', 'ref: refs/heads/dev')]
+        with patch.object(projects, 'MAX_ZIP_HEADERS', 100):
+            report = projects.extract_repository_zip(archive(files, zipfile.ZIP_STORED), self.destination)
+        self.assertEqual(report['files_copied'], 2)
+        self.assertEqual(report['ignored_folders']['node_modules'], 3000)
+        self.assertEqual(report['ignored_folders']['dist'], 1)
+        self.assertEqual(report['ignored_folders']['.git'], 1)
+        self.assertEqual(report['excluded_count'], 3002)
+        self.assertTrue((self.destination / 'src/app.ts').is_file())
+        self.assertFalse((self.destination / 'node_modules').exists())
+
+    def test_retained_entry_limit_names_the_count_and_remedy(self):
+        files = [(f'project/src/file{n}.ts', 'x') for n in range(30)]
+        with patch.object(projects, 'MAX_ZIP_HEADERS', 10), self.assertRaisesRegex(ValueError, r'holds 30 files .* limit is 10 files'):
+            projects.extract_repository_zip(archive(files), self.destination)
+
+    def test_raw_header_flood_is_still_bounded(self):
+        files = [(f'project/node_modules/file{n}.js', 'x') for n in range(50)]
+        with patch.object(projects, 'MAX_ZIP_TOTAL_HEADERS', 20), self.assertRaisesRegex(ValueError, 'more than 20 entries'):
+            projects.extract_repository_zip(archive(files, zipfile.ZIP_STORED), self.destination)
+
+    def test_finder_metadata_does_not_defeat_root_stripping(self):
+        files = [('ASPR-backend-/README.md', 'Read me'), ('ASPR-backend-/src/main.ts', 'const x = 1;'),
+                 ('ASPR-backend-/.DS_Store', b'\x00\x00\x00\x01Bud1' + b'\x00' * 40),
+                 ('__MACOSX/ASPR-backend-/._README.md', b'\x00\x05\x16\x07' + b'\x00' * 40),
+                 ('__MACOSX/._ASPR-backend-', b'\x00\x05\x16\x07' + b'\x00' * 40)]
+        report = projects.extract_repository_zip(archive(files), self.destination)
+        self.assertEqual(report['files_copied'], 2)
+        self.assertTrue((self.destination / 'src/main.ts').is_file(), 'the single real root must still be stripped')
+        self.assertEqual(report['ignored_folders'][projects.MAC_METADATA_LABEL], 3)
+
+    def test_unreadable_archive_message_tells_the_owner_what_to_do(self):
+        with self.assertRaisesRegex(ValueError, 'not a readable ZIP archive'):
+            projects.extract_repository_zip(b'PKbroken bytes that are not a zip', self.destination)
+
+
+class ErrorLogTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        with patch('app.hardware_info', return_value={'chip': 'Test Mac', 'memory_gb': 16}), patch.dict('os.environ', {}, clear=True):
+            self.app = Application(Path(self.temporary.name) / 'data', seed=False)
+        self.client = Mock()
+        self.manager = projects.GitHubProjects(self.app, client=self.client)
+        self.app._github = self.manager
+
+    def tearDown(self):
+        self.manager.close()
+        self.app.close()
+        self.temporary.cleanup()
+
+    def test_log_error_writes_redacted_traceback_and_never_raises(self):
+        self.manager.token = 'ghp_secret_token_value_1234567890'
+        self.manager.token_repositories = set()
+        try:
+            raise RuntimeError('boom ghp_secret_token_value_1234567890')
+        except RuntimeError as exc:
+            self.app.log_error('unit test', exc)
+        text = self.app.error_log.read_text(encoding='utf-8')
+        self.assertIn('unit test', text)
+        self.assertIn('RuntimeError: boom [redacted]', text)
+        self.assertNotIn('ghp_secret_token_value', text)
+        self.app.error_log.unlink()
+        self.app.log_error('no exception object')  # outside an except block: must not raise
+
+    def test_unexpected_import_failure_keeps_the_type_and_logs_the_traceback(self):
+        record = self.manager.register('https://github.com/Owner/backend', 'Backend', branch='dev')
+        blob = archive([('backend/src/app.ts', 'export const a = 1;')])
+        with patch('core.project_sources.publish_repository', side_effect=RuntimeError('disk exploded')):
+            result = self.manager.upload(record['id'], 'backend.zip', blob, synchronous=True)
+        self.assertEqual(result['status'], 'error')
+        self.assertIn('Repository import failed (RuntimeError)', result['error'])
+        self.assertNotIn('disk exploded', result['error'], 'raw messages of unexpected errors stay out of the UI')
+        self.assertIn('RuntimeError: disk exploded', self.app.error_log.read_text(encoding='utf-8'))
+
+    def test_import_with_node_modules_in_zip_succeeds_end_to_end(self):
+        record = self.manager.register('https://github.com/Owner/frontend', 'Frontend', branch='dev')
+        files = [('frontend/src/App.jsx', 'export default () => null;'), ('frontend/package.json', '{"name":"frontend"}')]
+        files += [(f'frontend/node_modules/m{n}/index.js', 'x') for n in range(500)]
+        result = self.manager.upload(record['id'], 'frontend.zip', archive(files, zipfile.ZIP_STORED), synchronous=True)
+        self.assertEqual(result['status'], 'ready', result.get('error'))
+        capture = self.manager.get(record['id'])['report']['archive_capture']
+        self.assertEqual(capture['ignored_folders']['node_modules'], 500)
+        self.assertEqual(capture['files_copied'], 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
