 if __name__ == '__main__':
     unittest.main()
+
+
+class DockerFailureHintTests(unittest.TestCase):
+    def test_failed_docker_commands_are_explained(self):
+        from core.runtime import _failure_hint, _registry_failure
+        cases = [
+            ({'exit_code': 1, 'output': ''}, 'not running, paused'),
+            ({'exit_code': 1, 'output': 'Cannot connect to the Docker daemon at unix:///Users/x/.docker/run/docker.sock. Is the docker daemon running?'}, 'Docker Desktop is not running'),
+            ({'exit_code': 17, 'output': '#3 ERROR: failed to resolve source metadata for docker.io/library/node:22: dial tcp: lookup registry-1.docker.io: no such host'}, 'reach the image registry'),
+            ({'exit_code': 1, 'output': 'toomanyrequests: You have reached your pull rate limit'}, 'rate limit'),
+            ({'exit_code': 1, 'output': 'write /var/lib/docker/x: no space left on device'}, 'disk is full'),
+            ({'exit_code': 2, 'output': 'error: some other build failure\nat step 4'}, 'Last output: error: some other build failure'),
+        ]
+        for result, expected in cases:
+            with self.subTest(expected=expected):
+                hint = _failure_hint(result)
+                self.assertIn(expected, hint)
+                self.assertIn(f"Exit code {result['exit_code']}", hint)
+        self.assertTrue(_registry_failure('failed to resolve source metadata for docker.io/library/node:22: no such host'))
+        self.assertTrue(_registry_failure('toomanyrequests: pull rate limit'))
+        self.assertFalse(_registry_failure('no space left on device'))
+        self.assertFalse(_registry_failure(''))
