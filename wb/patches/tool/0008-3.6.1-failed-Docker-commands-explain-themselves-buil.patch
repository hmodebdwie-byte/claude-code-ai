+_FAILURE_HINTS = (
+    (re.compile(r'Cannot connect to the Docker daemon|Is the docker daemon running|docker\.sock', re.I),
+     'Docker Desktop is not running or its engine is not ready. Open Docker Desktop, wait for "Engine running", then retry.'),
+    (re.compile(r'no such host|failed to resolve source metadata|failed to fetch oauth token|dial tcp|i/o timeout|TLS handshake timeout|connection reset by peer|EOF$', re.I | re.M),
+     'Docker could not reach the image registry (internet, VPN or proxy). Check the connection and Docker Desktop → Settings → Resources → Proxies, then retry.'),
+    (re.compile(r'toomanyrequests|rate ?limit', re.I),
+     'Docker Hub refused the download because of its rate limit. Sign in to Docker Desktop with a Docker account, then retry.'),
+    (re.compile(r'no space left on device|ENOSPC|disk quota exceeded', re.I),
+     "Docker Desktop's disk is full. Docker Desktop → Settings → Resources → raise the disk image size, or Troubleshoot → Clean / Purge data, then retry."),
+    (re.compile(r'permission denied while trying to connect|EACCES', re.I),
+     'Docker refused access. Restart Docker Desktop and accept its privileged-helper prompt if it appears.'),
+)
+
+
+def _failure_hint(result):
+    """Explain a failed Docker command in plain words: exit code, a known cause when recognizable, last output."""
+    output = (result.get('output') or '').strip()
+    code = result.get('exit_code')
+    tail = output[-400:].strip()
+    for pattern, hint in _FAILURE_HINTS:
+        if pattern.search(output):
+            return f' Exit code {code}. {hint}' + (f' Last output: {tail}' if tail else '')
+    if not output:
+        return (f' Exit code {code} and no output at all: Docker Desktop is probably not running, paused (Resource Saver) or still starting. '
+                'Open it, wait for "Engine running", then retry.')
+    return f' Exit code {code}. Last output: {tail}'
+
+
+def _registry_failure(output):
+    return bool(_FAILURE_HINTS[1][0].search(output or '') or _FAILURE_HINTS[2][0].search(output or ''))
+
+
 def _excluded_path(relative):
     parts = PurePosixPath(relative).parts
     return (any(p.casefold() in _EXCLUDED for p in parts)
