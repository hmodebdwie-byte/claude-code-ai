+"""Regression tests for the 3.6.0 review fixes: Studio working ZIPs, model error text, timeouts,
+knowledge-store atomicity and locators, redaction alignment, document decoding and runtime manifests."""
+import hashlib
+import io
+import json
+from pathlib import Path
+import re
+import sqlite3
+import tempfile
+import threading
+import unittest
+from unittest.mock import Mock, patch
+import urllib.error
+import warnings
+import zipfile
+
+from app import Application
+from core import development, ingest, models, repository
+from core import memory as memory_module
+from core.memory import Memory, chunks
+
+
+def archive(files, compression=zipfile.ZIP_DEFLATED):
+    target = io.BytesIO()
+    with warnings.catch_warnings(), zipfile.ZipFile(target, 'w', compression) as output:
+        warnings.simplefilter('ignore', UserWarning)
+        for name, text in files:
+            output.writestr(name, text)
+    return target.getvalue()
+
+
+class WorkingZipToleranceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.destination = Path(self.temp.name) / 'copy'
+        self.destination.mkdir()
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def test_finder_metadata_and_dependency_folders_keep_relative_paths_identical_to_the_baseline(self):
+        files = [('repo/README.md', 'Source'), ('repo/src/main.ts', 'const a = 1;'), ('repo/package.json', '{}'),
+                 ('repo/.DS_Store', b'\x00\x00\x00\x01Bud1' + b'\x00' * 40), ('__MACOSX/repo/._README.md', b'\x00\x05\x16\x07' + b'\x00' * 40)]
+        files += [(f'repo/node_modules/m{n}/index.js', 'x') for n in range(300)] + [('repo/.git/HEAD', 'ref'), ('repo/dist/app.js', 'built')]
+        with patch.object(development, 'MAX_ZIP_HEADERS', 50):
+            report = development.extract_working_zip(archive(files, zipfile.ZIP_STORED), self.destination)
+        self.assertEqual(sorted(f['path'] for f in report['files']), ['README.md', 'package.json', 'src/main.ts'])
+        self.assertEqual(report['ignored_folders']['node_modules'], 300)
+        self.assertIn('.git', report['ignored_folders'])
+        self.assertIn('dist', report['ignored_folders'])
+        self.assertEqual(report['ignored_folders'][development.MAC_METADATA_LABEL], 2)
+        self.assertTrue((self.destination / 'src/main.ts').is_file())
+        self.assertFalse((self.destination / 'repo').exists(), 'the single real root must be stripped despite __MACOSX')
+
+    def test_retained_entry_limit_still_applies_after_ignoring(self):
+        files = [(f'repo/src/f{n}.ts', 'x') for n in range(30)]
+        with patch.object(development, 'MAX_ZIP_HEADERS', 10), self.assertRaisesRegex(ValueError, 'holds 30 entries'):
+            development.extract_working_zip(archive(files), self.destination)
+
+    def test_unreadable_zip_message(self):
+        with self.assertRaisesRegex(ValueError, 'not a readable ZIP'):
+            development.extract_working_zip(b'not a zip at all', self.destination)
+
+
+class ModelErrorTextTests(unittest.TestCase):
+    def test_http_error_detail_is_kept_for_the_log_but_not_the_message(self):
+        body = json.dumps({'error': 'model requires more system memory (9.1 GiB) than is available (6.2 GiB)'}).encode()
+        exc = urllib.error.HTTPError('http://127.0.0.1:11434/api/chat', 500, 'Internal Server Error', {}, io.BytesIO(body))
+        self.assertEqual(models._server_detail(exc), 'model requires more system memory (9.1 GiB) than is available (6.2 GiB)')
+        nested = json.dumps({'error': {'message': 'insufficient_quota: You exceeded your current quota', 'type': 'x'}}).encode()
+        exc = urllib.error.HTTPError('https://api.openai.com/v1/chat/completions', 429, 'Too Many Requests', {}, io.BytesIO(nested))
