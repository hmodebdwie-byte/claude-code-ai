+def _decode_text(data):
+    """Decode text bytes without ever raising: UTF-16 with BOM, UTF-8, then Windows-1252, then Latin-1.
+
+    cp1252 is undefined for five byte values that are ordinary in Shift-JIS, GBK, EUC-KR and Big5 text,
+    which used to escape as UnicodeDecodeError or a misleading 'valid, unlocked file' error.
+    """
+    if data.startswith((b'\xff\xfe', b'\xfe\xff')):
+        return data.decode('utf-16', 'replace')
+    for encoding in ('utf-8-sig', 'cp1252', 'latin-1'):
+        try:
+            return data.decode(encoding)
+        except UnicodeDecodeError:
+            continue
+    return data.decode('utf-8', 'replace')
