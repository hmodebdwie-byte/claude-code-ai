+class KnowledgeStoreTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.memory = Memory(Path(self.temp.name) / 'knowledge.sqlite3')
+
+    def tearDown(self):
+        self.memory.close() if hasattr(self.memory, 'close') else None
+        self.temp.cleanup()
+
+    def test_concurrent_identical_adds_never_raise_and_versions_stay_unique(self):
+        results, errors = [], []
+        def worker(index):
+            try:
+                results.append(self.memory.add(space='general', title='Rules', content='Rule text ' + ('same' if index % 2 == 0 else str(index)),
+                                               kind='note', source_uri='note:rules', authority='reference', tags=''))
+            except Exception as exc:  # pragma: no cover - the assertion below reports it
+                errors.append(repr(exc))
+        threads = [threading.Thread(target=worker, args=(i,)) for i in range(8)]
+        for t in threads: t.start()
+        for t in threads: t.join()
+        self.assertEqual(errors, [])
+        with sqlite3.connect(str(self.memory.path)) as db:
+            versions = [row[0] for row in db.execute("SELECT version FROM sources WHERE source_uri='note:rules' ORDER BY version")]
+        self.assertEqual(versions, list(range(1, len(versions) + 1)), 'every stored version must get a distinct number')
+        self.assertGreaterEqual(sum(1 for r in results if r['duplicate']), 3)
+
+    def test_reimporting_content_of_an_archived_version_warns_instead_of_silent_duplicate(self):
+        first = self.memory.add(space='general', title='Rules', content='100', kind='note', source_uri='note:r', authority='reference', tags='')
+        second = self.memory.add(space='general', title='Rules', content='200', kind='note', source_uri='note:r', authority='reference', tags='')
+        with sqlite3.connect(str(self.memory.path)) as db:
+            db.execute("UPDATE sources SET status='archived' WHERE id=?", (first['source']['id'],))
+            db.execute("UPDATE sources SET status='active' WHERE id=?", (second['source']['id'],))
+        again = self.memory.add(space='general', title='Rules', content='100', kind='note', source_uri='note:r', authority='reference', tags='')
+        self.assertTrue(again['duplicate'])
+        self.assertIn('currently archived', again['warning'])
+
+    def test_chunk_locators_match_a_full_rescan(self):
+        text = ''.join(f'--- PAGE {p} ---\n' + ('line of page text\n' * 120) for p in range(1, 40)) + '[Page 40]\n' + 'tail\n' * 300
+        def reference(text, size=1600, overlap=180):
+            offset = 0
+            while offset < len(text):
+                end = min(offset + size, len(text))
+                if end < len(text):
+                    boundary = text.rfind('\n', offset + size // 2, end)
+                    if boundary > offset: end = boundary + 1
+                page = list(re.finditer(r'(?:\[Page (\d+)\]|--- PAGE (\d+) ---)', text[:offset + 50]))
+                locator = f'Extracted text, characters {offset + 1}–{end}'
+                if page: locator = f'Page {page[-1].group(1) or page[-1].group(2)} · ' + locator
+                yield text[offset:end], locator
+                if end >= len(text): break
+                offset = max(offset + 1, end - overlap)
+        self.assertEqual(list(chunks(text)), list(reference(text)))
+
