+_FAILED_CONTAINER_RE = re.compile(r'container ttlocal-[0-9a-f]{32}-([a-z][a-z0-9-]*?)-\d+\s+(?:exited \((\d+)\)|is unhealthy|error\b)', re.I)
+_RESET = ' Use "Reset local database", then Start again; the tool re-creates and re-seeds it, the local login stays the same.'
