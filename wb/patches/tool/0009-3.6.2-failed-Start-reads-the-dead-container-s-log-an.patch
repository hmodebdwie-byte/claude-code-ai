+     'The local database settings are incomplete. Prepare the latest code again, then Start.'),
+    (re.compile(r'lock file "postmaster\.pid" already exists|Is another postmaster', re.I),
+     'A previous database process left a lock file behind. Press Stop, then Start again; if it repeats, use "Reset local database".'),
+    (re.compile(r'PANIC|invalid checkpoint record|could not locate a valid checkpoint|could not read block|Input/output error|invalid page|checksum|corrupt|unexpected pageaddr|could not open file|exists but is not empty|failed migrations|P3009', re.I),
+     'The local database files are damaged or half-written, usually after the Mac shut down while Docker was running.' + _RESET),
+    (re.compile(r'permission denied|invalid permissions|could not (?:open|access|create) directory', re.I),
+     'Docker could not use the local database volume because of its file permissions.' + _RESET),
+    (re.compile(r"P1001|Can't reach database server|ECONNREFUSED|getaddrinfo E(?:NOTFOUND|AI_AGAIN)", re.I),
+     'The application could not reach the local database or Redis service inside Docker. Press Stop, then Start again; if it repeats, use "Reset local database".'),
+    (re.compile(r'JavaScript heap out of memory|Out of memory|Killed process', re.I),
+     'The container ran out of memory. Docker Desktop → Settings → Resources → give Docker more memory, then Start again.'),
+)
+
+
+def _failed_services(output):
+    """Services that `up --wait` reported as exited or unhealthy, in order of appearance, with their exit codes."""
+    found = {}
+    for match in _FAILED_CONTAINER_RE.finditer(output or ''):
+        service, code = match.group(1), match.group(2)
+        if service not in found or (code and found[service] is None):
+            found[service] = int(code) if code else found.get(service)
+    return list(found.items())
+
+
+def _service_hint(service, logs, exit_code):
+    """Plain-language cause for a container that died, read from its own log."""
+    text = (logs or '').strip()
+    if exit_code == 137:
+        return _SERVICE_HINTS[-1][1]
+    for pattern, hint in _SERVICE_HINTS:
+        if pattern.search(text):
+            return hint
+    if not text:
+        return f'The {service} container printed nothing before it stopped.'
+    return ''
+
