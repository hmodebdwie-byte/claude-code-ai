+        self._command(docker, ['image', 'prune', '--force'], 'Remove unused image layers', remaining(), allow_failure=True, verify=False)
+        self._command(docker, ['system', 'df'], 'Docker disk usage after', remaining(), allow_failure=True, verify=False)
