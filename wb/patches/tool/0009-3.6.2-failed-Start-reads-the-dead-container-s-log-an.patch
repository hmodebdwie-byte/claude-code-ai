+    def test_failed_start_reads_the_dead_container_log_before_cleanup(self):
+        self.lab.prepare()
+        project = self.lab.current_id[8:]
+        calls = []
+        def failure(argv, timeout, **kwargs):
+            calls.append(argv)
+            if 'up' in argv:
+                return {'exit_code': 1, 'truncated': False, 'duration_seconds': .1, 'created_at': 't',
+                        'output': f' Container ttlocal-{project}-redis-1  Healthy\n Container ttlocal-{project}-postgres-1  Error\n'
+                                  f'dependency failed to start: container ttlocal-{project}-postgres-1 exited (1)\n'}
+            if 'logs' in argv:
+                self.assertEqual(argv[-1], 'postgres', 'only the dead service log is read')
+                return {'exit_code': 0, 'truncated': False, 'duration_seconds': .1, 'created_at': 't',
+                        'output': 'postgres-1  | LOG:  database system was interrupted\npostgres-1  | PANIC:  could not locate a valid checkpoint record\n'}
+            return self.run_success([])(argv, timeout, **kwargs)
+        with self.available(), patch.object(self.lab, '_run', side_effect=failure):
+            self.lab.action('start'); self.finish()
+        status = self.lab.status()
+        self.assertEqual(status['job']['state'], 'error')
+        self.assertIn('The postgres container exited (code 1).', status['job']['error'])
+        self.assertIn('damaged', status['job']['error'])
+        self.assertIn('Reset local database', status['job']['error'])
+        self.assertIn('valid checkpoint record', status['job']['error'])
+        order = [next(k for k in ('up', 'logs', 'down') if k in argv) for argv in calls if any(k in argv for k in ('up', 'logs', 'down'))]
