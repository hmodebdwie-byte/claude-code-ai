+    def _explain_failed_start(self, prefix, result, remaining):
+        """Read the log of the container that died before cleanup removes it, and say what it means."""
+        failed = _failed_services(result.get('output', ''))
+        if not failed:
+            return 'Start and check local services failed.' + _failure_hint(result) + ' The complete output is under Build & test output.'
+        explanations = []
+        for service, code in failed[:2]:
+            try:
+                logs = self._command(prefix, ['logs', '--no-color', '--tail', '80', service], f'Log of failed service {service}',
+                                     max(5, remaining()), allow_failure=True, verify=False)
+                text = logs['output'] if logs['exit_code'] == 0 else ''
+            except ValueError:
+                text = ''
+            why = f'exited (code {code})' if code is not None else 'never became healthy'
+            hint = _service_hint(service, text, code)
+            tail = text.strip()[-500:].strip()
+            explanations.append(f'The {service} container {why}.' + (f' {hint}' if hint else '') + (f' Last lines of its log: {tail}' if tail else ''))
+        return 'Start and check local services failed. ' + ' '.join(explanations) + ' The complete log is under Build & test output.'
+
