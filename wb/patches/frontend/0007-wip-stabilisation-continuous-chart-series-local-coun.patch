+ * Never rejects. Works with socket.io-client v4 (`socket.timeout(ms).emit`) and with a plain
+ * `emit(event, ack)` object (fallback timer).
+ */
+export function probeSocket(socket, { event = DEFAULT_PROBE_EVENT, timeoutMs = DEFAULT_PROBE_TIMEOUT_MS } = {}) {
+  return new Promise((resolve) => {
+    if (!socket || typeof socket.emit !== 'function') {
+      resolve(false);
+      return;
+    }
+    let done = false;
+    let fallbackTimer = null;
+    const finish = (alive) => {
+      if (done) return;
+      done = true;
+      if (fallbackTimer != null) clearTimeout(fallbackTimer);
