+} from './chartGeometryService.js';
+
+test('fixedViewportOptions: barSpacing = plotWidth / 80, rightOffset = 18, never re-zooms by bar count', () => {
+  assert.deepEqual(fixedViewportOptions(360), { barSpacing: 360 / INITIAL_VISIBLE_BARS, rightOffset: RIGHT_OFFSET });
+  assert.equal(fixedViewportOptions(360).barSpacing, 4.5);
+  // Tiny plot: clamp to LWC's floor instead of collapsing.
+  assert.equal(fixedViewportOptions(10).barSpacing, 0.5);
+  // Unknown width (before layout): keep the current spacing, only pin the offset.
+  assert.deepEqual(fixedViewportOptions(0), { rightOffset: RIGHT_OFFSET });
+  assert.deepEqual(fixedViewportOptions(null), { rightOffset: RIGHT_OFFSET });
+});
+
+test('cursorFraction: server-clock progress past the newest bar, clamped to [0, 1.25]', () => {
+  const bar = 1_700_000_000;
+  assert.equal(cursorFraction(bar * 1000, bar), 0);
+  assert.equal(cursorFraction(bar * 1000 + 400, bar), 0.4);
+  assert.equal(cursorFraction(bar * 1000 + 1000, bar), 1);
+  assert.equal(cursorFraction(bar * 1000 + 5000, bar), CURSOR_MAX_FRACTION, 'late candle parks the cursor');
+  assert.equal(cursorFraction(bar * 1000 - 3000, bar), 0, 'never behind the newest bar');
+  assert.equal(cursorFraction(NaN, bar), 0);
