+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { planDispatch, potSignatureOf, priceSideOf } from './requestThrottle.js';
+
+test('leading edge: first trigger after idle dispatches immediately', () => {
+  const p = planDispatch({ nowMs: 10_000, lastDispatchAtMs: 0, throttleMs: 750 });
+  assert.deepEqual(p, { action: 'now', delayMs: 0 });
+});
+
+test('inside the window: one trailing dispatch at the end of the window', () => {
+  const p = planDispatch({ nowMs: 10_300, lastDispatchAtMs: 10_000, throttleMs: 750 });
+  assert.deepEqual(p, { action: 'trailing', delayMs: 450 });
+});
+
+test('inside the window with a trailing dispatch pending: nothing new is scheduled (no starvation)', () => {
+  const p = planDispatch({
+    nowMs: 10_400,
+    lastDispatchAtMs: 10_000,
+    throttleMs: 750,
+    trailingPending: true,
+  });
+  assert.equal(p.action, 'none');
+});
+
+test('forceNow (verdict side change) bypasses the throttle', () => {
+  const p = planDispatch({ nowMs: 10_050, lastDispatchAtMs: 10_000, throttleMs: 750, forceNow: true });
+  assert.equal(p.action, 'now');
+});
+
+test('minTrailingDelay keeps a small debounce for keystrokes', () => {
+  const p = planDispatch({
+    nowMs: 10_950,
+    lastDispatchAtMs: 10_000,
+    throttleMs: 1000,
+    minTrailingDelayMs: 200,
+  });
+  assert.deepEqual(p, { action: 'trailing', delayMs: 200 });
+});
+
+test('potSignatureOf ignores sub-0.5 % pool churn but tracks real moves', () => {
+  const a = potSignatureOf(203_695, 3_160);
+  const b = potSignatureOf(203_995, 3_160); // +$300 on a $207k pot (0.15 %)
+  assert.equal(a, b);
+  const c = potSignatureOf(203_695, 6_500); // sell pool doubled (+1.6 % of total)
+  assert.notEqual(a, c);
+});
+
+test('potSignatureOf refreshes when the whole pot grows ~5 % even if shares are unchanged', () => {
+  const a = potSignatureOf(100_000, 100_000);
+  const b = potSignatureOf(101_000, 101_000);
+  assert.equal(a, b);
+  const c = potSignatureOf(110_000, 110_000);
+  assert.notEqual(a, c);
+});
+
+test('potSignatureOf is stable for empty / invalid pots', () => {
+  assert.equal(potSignatureOf(0, 0), '0:0:0');
+  assert.equal(potSignatureOf(null, undefined), '0:0:0');
+  assert.equal(potSignatureOf('x', -5), '0:0:0');
+});
+
+test('priceSideOf extracts the sign part of the price signature', () => {
+  assert.equal(priceSideOf('1:12'), '1');
+  assert.equal(priceSideOf('-1:0'), '-1');
+  assert.equal(priceSideOf('0:0'), '0');
+  assert.equal(priceSideOf('nostart'), 'nostart');
+  assert.equal(priceSideOf(''), '');
+  assert.equal(priceSideOf(null), '');
+});
