@@ -0,0 +1,108 @@
+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  deriveRemainingFromAnchor,
+  reanchorFromServerFrame,
+  msUntilNextLocalTick,
+  applyRemainingToTimer,
+} from './timerCountdownAnchor.js';
+
+const T0 = 1_700_000_000_000;
+
+test('first frame creates a fresh anchor (snapped)', () => {
+  const r = reanchorFromServerFrame(null, { time_remaining: 60, battle_id: 5, timestamp: T0 }, T0);
+  assert.equal(r.snapped, true);
+  assert.equal(r.remaining, 60);
+  assert.deepEqual(r.anchor, { remaining: 60, receivedAt: T0, battleId: 5, serverTs: T0 });
+});
+
+test('local clock counts down 1 Hz from the anchor and clamps at 0', () => {
+  const anchor = { remaining: 3, receivedAt: T0, battleId: 1 };
+  assert.equal(deriveRemainingFromAnchor(anchor, T0), 3);
+  assert.equal(deriveRemainingFromAnchor(anchor, T0 + 999), 3);
+  assert.equal(deriveRemainingFromAnchor(anchor, T0 + 1000), 2);
+  assert.equal(deriveRemainingFromAnchor(anchor, T0 + 2999), 1);
+  assert.equal(deriveRemainingFromAnchor(anchor, T0 + 3000), 0);
+  assert.equal(deriveRemainingFromAnchor(anchor, T0 + 60_000), 0);
+});
+
+test('a frame that agrees with the local clock keeps the local phase (no jitter)', () => {
+  const first = reanchorFromServerFrame(null, { time_remaining: 60, battle_id: 1 }, T0).anchor;
+  // Server frame arrives 1.3 s later saying 59; local says 59 too → keep anchor.
+  const r = reanchorFromServerFrame(first, { time_remaining: 59, battle_id: 1, timestamp: 42 }, T0 + 1300);
+  assert.equal(r.snapped, false);
+  assert.equal(r.remaining, 59);
+  assert.equal(r.anchor.receivedAt, T0);
+  assert.equal(r.anchor.serverTs, 42);
+});
+
+test('a frame that differs by >= 1 s snaps to the server value (reconnect / resume)', () => {
+  const first = reanchorFromServerFrame(null, { time_remaining: 60, battle_id: 1 }, T0).anchor;
+  // Tab was frozen: local would say 30, server says 25 → snap.
+  const r = reanchorFromServerFrame(first, { time_remaining: 25, battle_id: 1 }, T0 + 30_000);
+  assert.equal(r.snapped, true);
+  assert.equal(r.remaining, 25);
+  assert.equal(r.anchor.receivedAt, T0 + 30_000);
+});
+
+test('server reporting 0 always wins over a local clock that is still > 0 (trade gate closes)', () => {
+  const first = reanchorFromServerFrame(null, { time_remaining: 2, battle_id: 1 }, T0).anchor;
+  const r = reanchorFromServerFrame(first, { time_remaining: 0, battle_id: 1 }, T0 + 900);
+  assert.equal(r.snapped, true);
+  assert.equal(r.remaining, 0);
+});
+
+test('a frame for a different battle always re-anchors', () => {
+  const first = reanchorFromServerFrame(null, { time_remaining: 10, battle_id: 1 }, T0).anchor;
+  const r = reanchorFromServerFrame(first, { time_remaining: 10, battle_id: 2 }, T0 + 100);
+  assert.equal(r.snapped, true);
+  assert.equal(r.anchor.battleId, 2);
+});
+
+test('a frame without a usable time_remaining yields no anchor', () => {
+  const r = reanchorFromServerFrame(null, { battle_id: 1 }, T0);
+  assert.equal(r.anchor, null);
+  assert.equal(r.remaining, null);
+});
+
+test('fractional / negative server values are floored and clamped', () => {
+  const r = reanchorFromServerFrame(null, { time_remaining: 59.9 }, T0);
+  assert.equal(r.remaining, 59);
+  const n = reanchorFromServerFrame(null, { time_remaining: -3 }, T0);
+  assert.equal(n.remaining, 0);
+});
+
+test('next local tick is phase-aligned to the anchor second', () => {
+  const anchor = { remaining: 10, receivedAt: T0 };
+  assert.equal(msUntilNextLocalTick(anchor, T0), 1000);
+  assert.equal(msUntilNextLocalTick(anchor, T0 + 250), 750);
+  assert.equal(msUntilNextLocalTick(anchor, T0 + 1999), 10); // never 0/1 ms busy loops
+  assert.equal(msUntilNextLocalTick(anchor, T0 + 2000), 1000);
+});
+
+test('applyRemainingToTimer keeps server fields and recomputes elapsed / percentage', () => {
+  const timer = {
+    battle_id: 7,
+    time_remaining: 30,
+    time_elapsed: 30,
+    total_duration: 60,
+    percentage_complete: 50,
+    is_finalize: false,
+    timestamp: T0,
+  };
+  const next = applyRemainingToTimer(timer, 29);
+  assert.equal(next.time_remaining, 29);
+  assert.equal(next.time_elapsed, 31);
+  assert.equal(Math.round(next.percentage_complete * 100) / 100, 51.67);
+  assert.equal(next.battle_id, 7);
+  assert.equal(next.is_finalize, false);
+  assert.equal(next.timestamp, T0);
+  // Original untouched.
+  assert.equal(timer.time_remaining, 30);
+});
+
+test('applyRemainingToTimer without total_duration only changes time_remaining', () => {
+  const next = applyRemainingToTimer({ time_remaining: 5, foo: 'bar' }, 4);
+  assert.deepEqual(next, { time_remaining: 4, foo: 'bar' });
+});
