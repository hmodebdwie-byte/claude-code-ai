+  if (!prevAnchor || !sameBattle(prevAnchor.battleId, fresh.battleId)) {
+    return { anchor: fresh, remaining: serverRemaining, snapped: true };
+  }
+  const local = deriveRemainingFromAnchor(prevAnchor, nowMs);
+  if (local == null || Math.abs(serverRemaining - local) >= TIMER_SNAP_THRESHOLD_S) {
+    return { anchor: fresh, remaining: serverRemaining, snapped: true };
+  }
