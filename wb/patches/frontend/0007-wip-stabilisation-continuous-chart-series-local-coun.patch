@@ -0,0 +1,102 @@
+/**
+ * Contract C2 (client): the battle countdown ticks LOCALLY at 1 Hz, anchored to the last
+ * server `timerUpdate` frame. Server frames stay the authority — every frame re-anchors —
+ * but a late, dropped or throttled frame no longer freezes the digits.
+ *
+ * Anchor shape: `{ remaining, receivedAt, battleId, serverTs }`
+ *   remaining  — whole seconds the server reported (floored, >= 0)
+ *   receivedAt — local Date.now() when that frame was applied
+ *
+ * Re-anchor rule: if the server value differs from the locally derived value by >= 1 s the
+ * anchor SNAPS to the server value (drift, reconnect, resume); otherwise the existing local
+ * phase is kept so the digits do not jitter when frames arrive a few hundred ms early/late.
+ *
+ * Pure module (no React, no store) so it runs under `node --test`.
+ */
+
+/** Snap when |server - local| >= this many seconds. */
+export const TIMER_SNAP_THRESHOLD_S = 1;
+
+function toWholeSeconds(v) {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return null;
+  return Math.max(0, Math.floor(n));
+}
+
+function sameBattle(a, b) {
+  if (a == null || b == null) return true; // unknown id never forces a re-anchor by itself
+  return Number(a) === Number(b);
+}
+
+/** Whole seconds remaining at `nowMs` according to `anchor`; null when the anchor is unusable. */
+export function deriveRemainingFromAnchor(anchor, nowMs) {
+  if (!anchor) return null;
+  const remaining = toWholeSeconds(anchor.remaining);
+  const receivedAt = Number(anchor.receivedAt);
+  if (remaining == null || !Number.isFinite(receivedAt)) return null;
