+ * Apply a server frame to the previous anchor.
+ * @returns {{ anchor: object|null, remaining: number|null, snapped: boolean }}
+ *   anchor null when the frame carries no usable `time_remaining` (caller keeps the old timer
+ *   behaviour: no local ticking).
+ */
+export function reanchorFromServerFrame(prevAnchor, frame, nowMs) {
+  const serverRemaining = toWholeSeconds(frame?.time_remaining);
+  if (serverRemaining == null) return { anchor: null, remaining: null, snapped: false };
+  const battleId = frame?.battle_id ?? frame?.battleId ?? null;
+  const serverTs = frame?.timestamp ?? null;
