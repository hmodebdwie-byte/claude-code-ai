+ * Timer object to store for a locally derived `remaining`: keeps every server field, updates
+ * `time_remaining`, and keeps `time_elapsed` / `percentage_complete` consistent when
+ * `total_duration` is known (progress bar / entry multiplier read them).
+ */
+export function applyRemainingToTimer(timer, remaining) {
+  const base = timer && typeof timer === 'object' ? timer : {};
+  const r = toWholeSeconds(remaining) ?? 0;
+  const next = { ...base, time_remaining: r };
+  const total = Number(base.total_duration);
+  if (Number.isFinite(total) && total > 0) {
+    const elapsed = Math.max(0, Math.min(total, total - r));
+    next.time_elapsed = elapsed;
+    if (base.percentage_complete != null) {
+      next.percentage_complete = Math.min(100, Math.max(0, (elapsed / total) * 100));
+    }
+  }
+  return next;
+}
diff --git a/src/live/utils/timerCountdownAnchor.test.js b/src/live/utils/timerCountdownAnchor.test.js
