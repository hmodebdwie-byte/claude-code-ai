@@ -0,0 +1,162 @@
+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  lineChartStore,
+  LINE_CHART_MAX_CANDLES,
+  toBucketSec,
+  toStoreCandle,
+  sortAndDedupeBySecond,
+  upsertSorted,
+  maxVolumeOf,
+} from './lineChartStore.js';
+
+const S = () => lineChartStore.getState();
+const candle = (sec, close, extra = {}) => ({
+  timestamp: sec,
+  open: close,
+  high: close,
+  low: close,
+  close,
+  volume: 0,
+  count: 0,
+  battle_id: 1,
+  ...extra,
+});
+
+beforeEach(() => {
+  S().clearLineChart();
+});
+
+test('toBucketSec normalises seconds and milliseconds to the same bucket', () => {
+  assert.equal(toBucketSec(1_700_000_000), 1_700_000_000);
+  assert.equal(toBucketSec(1_700_000_000_999), 1_700_000_000);
+  assert.equal(toBucketSec('1700000000'), 1_700_000_000);
+  assert.equal(toBucketSec(null), null);
+  assert.equal(toBucketSec('abc'), null);
+});
+
+test('toStoreCandle rejects invalid price and keeps battle_id null for idle seconds', () => {
+  assert.equal(toStoreCandle({ timestamp: 10, close: 0 }), null);
+  assert.equal(toStoreCandle({ timestamp: 10 }), null);
+  const c = toStoreCandle({ timestamp: 10, o: 1, h: 2, l: 0.5, c: 1.5, v: 100, battle_id: null });
+  assert.deepEqual(c, {
+    timestamp: 10, open: 1, high: 2, low: 0.5, close: 1.5, volume: 100, count: 0,
+    battle_id: null, partial: false,
+  });
+  // bucket_ts wins when timestamp is absent (priceUpdate ticks)
+  assert.equal(toStoreCandle({ bucket_ts: 42, price: 1.2 }).timestamp, 42);
+});
+
+test('sortAndDedupeBySecond: dedupe key is the second alone, last write wins, ascending', () => {
+  const out = sortAndDedupeBySecond([
+    candle(3, 1.3),
+    candle(1, 1.1),
+    candle(2, 1.2, { battle_id: 7 }),
+    candle(2, 1.25, { battle_id: null }),
+    candle(0, 9, { timestamp: 1_700_000_000_250 }), // epoch ms → second 1_700_000_000
+  ]);
+  assert.deepEqual(out.map((c) => c.timestamp), [1, 2, 3, 1_700_000_000]);
+  assert.equal(out[1].close, 1.25);
+  assert.equal(out[1].battle_id, null);
+});
+
+test('upsertSorted: O(1) append/replace and correct late insert', () => {
+  const base = [candle(1, 1), candle(2, 2), candle(4, 4)];
+  assert.deepEqual(upsertSorted(base, candle(5, 5)).map((c) => c.timestamp), [1, 2, 4, 5]);
+  assert.equal(upsertSorted(base, candle(4, 4.5))[2].close, 4.5);
+  assert.deepEqual(upsertSorted(base, candle(3, 3)).map((c) => c.timestamp), [1, 2, 3, 4]);
+  assert.equal(upsertSorted(base, candle(2, 2.5))[1].close, 2.5);
+  assert.deepEqual(upsertSorted(base, candle(0, 0.5)).map((c) => c.timestamp), [0, 1, 2, 4]);
+  assert.equal(base.length, 3, 'input array is never mutated');
+});
+
+test('replaceCandles replaces everything local, bumps batchGeneration, marks history ready', () => {
+  S().appendClosedCandle(candle(50, 1.5));
+  S().appendClosedCandle(candle(51, 1.6));
+  const gen0 = S().batchGeneration;
+  S().replaceCandles([candle(100, 2, { volume: 10 }), candle(101, 2.1, { volume: 40, partial: true })]);
+  const st = S();
+  assert.deepEqual(st.prices.map((c) => c.timestamp), [100, 101]);
+  assert.equal(st.batchGeneration, gen0 + 1);
+  assert.equal(st.serverHistoryReady, true);
+  assert.equal(st.maxVolume, 40);
+  assert.equal(st.prices[1].partial, true);
+});
+
+test('appendClosedCandle: one bar per second, replaces the in-progress bar with the exact close', () => {
+  S().upsertInProgress({ bucket_ts: 10, price: 1.10, volume: 5 });
+  S().upsertInProgress({ bucket_ts: 10, price: 1.12, volume: 25 });
+  assert.equal(S().prices.length, 1);
+  assert.equal(S().prices[0].close, 1.12);
+  assert.equal(S().prices[0].volume, 25, 'bucket volume only grows');
+  S().appendClosedCandle(candle(10, 1.11, { volume: 30 }));
+  assert.equal(S().prices.length, 1);
+  assert.equal(S().prices[0].close, 1.11, 'server close is final');
+  assert.equal(S().prices[0].partial, false);
+  // a late tick for a closed second is ignored
+  S().upsertInProgress({ bucket_ts: 10, price: 9.99 });
+  assert.equal(S().prices[0].close, 1.11);
+  // a tick for the next second opens a new partial bar
+  S().upsertInProgress({ bucket_ts: 11, price: 1.2, volume: 3 });
+  assert.equal(S().prices.length, 2);
+  assert.equal(S().prices[1].partial, true);
+  assert.equal(S().prices[1].open, 1.2);
+});
+
+test('flat cooldown candles (battle_id null, volume 0) are appended like any other second', () => {
+  S().appendClosedCandle(candle(20, 1.5, { battle_id: 3 }));
+  S().appendClosedCandle({ timestamp: 21, o: 1.5, h: 1.5, l: 1.5, c: 1.5, volume: 0, count: 0, battle_id: null });
+  S().appendClosedCandle({ timestamp: 22, o: 1.5, h: 1.5, l: 1.5, c: 1.5, volume: 0, count: 0, battle_id: null });
+  assert.deepEqual(S().prices.map((c) => c.timestamp), [20, 21, 22]);
+  assert.equal(S().prices[2].battle_id, null);
+});
+
+test('late close for an older second is inserted in order and does not drop newer bars', () => {
+  S().appendClosedCandle(candle(30, 1));
+  S().upsertInProgress({ bucket_ts: 32, price: 1.3 });
+  S().appendClosedCandle(candle(31, 1.1)); // arrives after the tick for 32 opened a bar
+  assert.deepEqual(S().prices.map((c) => c.timestamp), [30, 31, 32]);
+  assert.equal(S().prices[2].partial, true);
+});
+
+test('resetLineChart keeps the candles (no per-round reset); clearLineChart empties', () => {
+  S().replaceCandles([candle(1, 1), candle(2, 2)]);
+  S().resetLineChart();
+  assert.equal(S().prices.length, 2);
+  assert.equal(S().serverHistoryReady, true);
+  S().clearLineChart();
+  assert.equal(S().prices.length, 0);
+  assert.equal(S().serverHistoryReady, false);
+});
+
+test('store is capped at LINE_CHART_MAX_CANDLES (900) keeping the newest', () => {
+  const many = [];
+  for (let i = 0; i < 1000; i += 1) many.push(candle(1000 + i, 1 + i / 1e5, { volume: i }));
+  S().replaceCandles(many);
+  assert.equal(S().prices.length, LINE_CHART_MAX_CANDLES);
+  assert.equal(S().prices[0].timestamp, 1000 + 100);
+  assert.equal(S().maxVolume, 999);
+  for (let i = 0; i < 5; i += 1) S().appendClosedCandle(candle(2000 + i, 2));
+  assert.equal(S().prices.length, LINE_CHART_MAX_CANDLES);
+  assert.equal(S().prices[S().prices.length - 1].timestamp, 2004);
+});
+
+test('maxVolume tracks the whole loaded series, not the visible window', () => {
+  S().replaceCandles([candle(1, 1, { volume: 100_000 }), candle(2, 1, { volume: 10_000 })]);
+  assert.equal(S().maxVolume, 100_000);
+  for (let i = 3; i < 200; i += 1) S().appendClosedCandle(candle(i, 1, { volume: 10_000 }));
+  assert.equal(S().maxVolume, 100_000, 'a $100k bar stays the scale reference while loaded');
+  assert.equal(maxVolumeOf(S().prices), 100_000);
+});
+
+test('revision increments on every write so late closes are observable by subscribers', () => {
+  const r0 = S().revision;
+  S().appendClosedCandle(candle(5, 1));
+  S().upsertInProgress({ bucket_ts: 7, price: 1 });
+  S().appendClosedCandle(candle(6, 1)); // late close, length changes
+  const r1 = S().revision;
+  S().appendClosedCandle(candle(6, 1.01)); // late close, same length
+  assert.equal(r1, r0 + 3);
+  assert.equal(S().revision, r1 + 1);
+});
