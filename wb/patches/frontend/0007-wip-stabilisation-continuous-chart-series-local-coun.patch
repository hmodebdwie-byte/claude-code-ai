diff --git a/src/live/services/chartClockService.js b/src/live/services/chartClockService.js
new file mode 100644
index 0000000..5403ec1
--- /dev/null
+++ b/src/live/services/chartClockService.js
@@ -0,0 +1,53 @@
+/**
+ * Server clock estimate for the chart's time cursor (contract C1).
+ *
+ * Every `candleClosed` / `candleBatch` carries `server_time` (epoch ms, the server clock at emit).
+ * We keep an EMA of `server_time - Date.now()` so `serverNowMs()` is the server's wall clock as
+ * seen from this device, immune to the phone's clock being a few seconds off. The cursor is then
+ * placed at `serverNow` relative to the newest bar's bucket start, which is what makes it sit
+ * "where the round ended" and glide right through the cooldown on every device alike.
+ *
+ * Pure module (no DOM) so it can be exercised by `node --test`.
+ */
+
+const EMA_ALPHA = 0.2;
+/** A single sample this far from the running estimate is a clock step (NTP/resume): snap. */
+const SNAP_THRESHOLD_MS = 2000;
+
+let offsetMs = 0;
+let sampleCount = 0;
+
+/** Feed one `server_time` sample (ms). `localNowMs` is injectable for tests. */
+export function noteServerTime(serverTimeMs, localNowMs = Date.now()) {
+  const st = Number(serverTimeMs);
+  if (!Number.isFinite(st) || st <= 0) return offsetMs;
+  const sample = st - Number(localNowMs);
+  if (!Number.isFinite(sample)) return offsetMs;
+  if (sampleCount === 0 || Math.abs(sample - offsetMs) > SNAP_THRESHOLD_MS) {
+    offsetMs = sample;
+  } else {
+    offsetMs += (sample - offsetMs) * EMA_ALPHA;
+  }
+  sampleCount += 1;
+  return offsetMs;
+}
+
+/** `server_time - Date.now()` estimate in ms (0 until the first sample). */
+export function getServerOffsetMs() {
+  return offsetMs;
+}
+
+export function hasServerClock() {
+  return sampleCount > 0;
+}
+
+/** Server wall clock now (ms). */
+export function serverNowMs(localNowMs = Date.now()) {
+  return Number(localNowMs) + offsetMs;
+}
+
+/** Tests / teardown. */
+export function resetServerClock() {
+  offsetMs = 0;
+  sampleCount = 0;
+}
