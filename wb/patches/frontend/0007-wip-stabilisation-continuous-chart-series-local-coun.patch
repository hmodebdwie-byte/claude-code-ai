+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  createRealtimeEventGuard,
+  isActiveBattlePayload,
+  normalizeSocketTimerUpdate,
+} from './realtimeEventGuards.js';
+
+test('timerUpdate tolerates <= 2 s backwards clock skew (API-stamped start tick vs engine ticks)', () => {
+  const g = createRealtimeEventGuard();
+  const apiNow = Date.now();
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow), false); // API stamp (host clock leads)
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow - 1500), false); // engine tick 1.5 s behind
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow - 500), false); // next engine tick
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow - 2500), true); // beyond tolerance: dropped
+  // Watermark stayed at the API stamp: a later frame past it advances normally.
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow + 1000), false);
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow - 900), false); // 1.9 s behind: tolerated
+  assert.equal(g.isOutOfOrder('timerUpdate', apiNow - 1100), true); // 2.1 s behind the new mark
+});
+
+test('other events keep strict ordering (no tolerance)', () => {
+  const g = createRealtimeEventGuard();
+  const now = Date.now();
+  assert.equal(g.isOutOfOrder('priceUpdate', now), false);
+  assert.equal(g.isOutOfOrder('priceUpdate', now - 1), true);
+  assert.equal(g.isOutOfOrder('priceUpdate', now), false);
+});
+
+test('tolerance can be configured per key and seconds timestamps are normalised', () => {
+  const g = createRealtimeEventGuard({ backwardToleranceMsByKey: { priceUpdate: 100 } });
+  const nowSec = Math.floor(Date.now() / 1000);
+  assert.equal(g.isOutOfOrder('priceUpdate', nowSec), false);
+  assert.equal(g.isOutOfOrder('priceUpdate', nowSec * 1000 - 50), false);
+  assert.equal(g.isOutOfOrder('priceUpdate', nowSec * 1000 - 500), true);
+});
+
+test('future timestamps beyond 30 s are still rejected; clear() resets the watermark', () => {
+  const g = createRealtimeEventGuard();
+  const now = Date.now();
+  assert.equal(g.isOutOfOrder('timerUpdate', now + 60_000), true);
+  assert.equal(g.isOutOfOrder('timerUpdate', now), false);
+  g.clear();
+  assert.equal(g.isOutOfOrder('timerUpdate', now - 10_000), false);
+});
+
+test('isActiveBattlePayload accepts any payload while the client has no battle id (T10)', () => {
+  assert.equal(isActiveBattlePayload(88, null), true);
+  assert.equal(isActiveBattlePayload(null, null), true);
+  assert.equal(isActiveBattlePayload(88, undefined), true);
+});
+
+test('isActiveBattlePayload still rejects a different round once a battle id is known', () => {
+  assert.equal(isActiveBattlePayload(87, 88), false);
+  assert.equal(isActiveBattlePayload(88, 88), true);
+  assert.equal(isActiveBattlePayload('88', 88), true);
+  assert.equal(isActiveBattlePayload(null, 88), true); // payload without id: not filtered here
+});
+
+test('normalizeSocketTimerUpdate floors and clamps time_remaining, unwraps {timer}', () => {
+  const t = normalizeSocketTimerUpdate({ timer: { battleId: '5', time_remaining: 12.9, timestamp: 1 } });
+  assert.equal(t.battle_id, 5);
+  assert.equal(t.time_remaining, 12);
+  assert.equal(t.timestamp, 1);
+  const n = normalizeSocketTimerUpdate([null, { battle_id: 6, time_remaining: -1 }]);
+  assert.equal(n.time_remaining, 0);
+  assert.equal(normalizeSocketTimerUpdate(null), null);
+});
diff --git a/src/live/utils/requestThrottle.js b/src/live/utils/requestThrottle.js
new file mode 100644
index 0000000..a8655f3
--- /dev/null
+++ b/src/live/utils/requestThrottle.js
@@ -0,0 +1,66 @@
+/**
+ * Pure helpers shared by the estimator fetch loops (useMarketFlip / useWinEstimate).
+ *
+ * Audit E1/E3: both hooks used a trailing debounce whose timer was restarted by every
+ * dependency change and a `requestId` bumped on every effect run, so under continuous NPC pot
+ * ticks the debounce never matured and every response that did arrive was discarded. These
+ * helpers implement a leading+trailing throttle instead: the first trigger fires at once, later
+ * triggers inside the window coalesce into ONE trailing dispatch at the end of the window.
+ *
+ * Kept free of React so `node --test` covers the scheduling decisions.
+ */
+
+/**
+ * Decide how to handle a trigger.
+ * @param {{ nowMs: number, lastDispatchAtMs: number, throttleMs: number, forceNow?: boolean,
+ *           trailingPending?: boolean, minTrailingDelayMs?: number }} p
+ * @returns {{ action: 'now' | 'trailing' | 'none', delayMs: number }}
+ *   'now'      — dispatch immediately (leading edge, or forced e.g. by a verdict-side change)
+ *   'trailing' — schedule one dispatch `delayMs` from now (nothing scheduled yet)
+ *   'none'     — a trailing dispatch is already scheduled; it will pick up the latest inputs
+ */
+export function planDispatch({
+  nowMs,
+  lastDispatchAtMs,
+  throttleMs,
+  forceNow = false,
+  trailingPending = false,
+  minTrailingDelayMs = 0,
+}) {
+  if (forceNow) return { action: 'now', delayMs: 0 };
+  const elapsed = nowMs - (Number(lastDispatchAtMs) || 0);
+  if (elapsed >= throttleMs) return { action: 'now', delayMs: 0 };
+  if (trailingPending) return { action: 'none', delayMs: 0 };
+  const delay = Math.max(minTrailingDelayMs, throttleMs - elapsed);
+  return { action: 'trailing', delayMs: Math.max(1, Math.round(delay)) };
+}
+
+/** Fraction of the total pot one quantum of `potSignatureOf` represents (0.5 %). */
+export const POT_SIGNATURE_STEP_FRACTION = 0.005;
+/** Extra bucket on the total pot so pure growth (both sides up) still refreshes eventually. */
+const POT_TOTAL_GROWTH_FACTOR = 1.05;
+
+/**
+ * Coarse pool signature: the fetch loops key on this instead of the raw $1-rounded pots, so
+ * NPC churn that moves a pool by a few dollars does not retrigger a request. Each side is
+ * quantised to 0.5 % of the total pot, plus a 5 % logarithmic bucket on the total.
+ */
+export function potSignatureOf(buyPot, sellPot) {
+  const buy = Math.max(0, Number(buyPot) || 0);
+  const sell = Math.max(0, Number(sellPot) || 0);
+  const total = buy + sell;
+  if (total <= 0) return '0:0:0';
+  const step = Math.max(1, total * POT_SIGNATURE_STEP_FRACTION);
+  const totalBucket = Math.round(Math.log(total) / Math.log(POT_TOTAL_GROWTH_FACTOR));
+  return `${Math.round(buy / step)}:${Math.round(sell / step)}:${totalBucket}`;
+}
+
+/**
+ * Verdict side of a WinEstimatorSheet price signature (`"<sign>:<bucket>"`, `'nostart'`, `''`).
+ * A change of side is the LOSING/IN_PROFIT flip and must bypass the throttle.
+ */
+export function priceSideOf(priceSignature) {
+  const s = priceSignature == null ? '' : String(priceSignature);
+  const i = s.indexOf(':');
+  return i > 0 ? s.slice(0, i) : s;
+}
