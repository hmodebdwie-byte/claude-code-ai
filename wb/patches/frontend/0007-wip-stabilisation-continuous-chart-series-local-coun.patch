+export function msUntilNextLocalTick(anchor, nowMs) {
+  const receivedAt = Number(anchor?.receivedAt);
+  if (!Number.isFinite(receivedAt)) return 1000;
+  const elapsed = Math.max(0, nowMs - receivedAt);
+  const wait = 1000 - (elapsed % 1000);
+  return Math.max(10, Math.min(1000, wait));
