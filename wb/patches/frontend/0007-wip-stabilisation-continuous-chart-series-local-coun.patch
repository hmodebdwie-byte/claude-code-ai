+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  INITIAL_VISIBLE_BARS,
+  RIGHT_OFFSET,
+  CURSOR_MAX_FRACTION,
+  fixedViewportOptions,
+  cursorFraction,
+  cursorX,
+  barSpacingFromLogicals,
