--- /dev/null
+++ b/src/live/services/socketHealthService.test.js
@@ -0,0 +1,119 @@
+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  resolveStaleThresholdMs,
+  probeSocket,
+  startSocketHealthWatchdog,
+  MIN_STALE_THRESHOLD_MS,
+  STALE_JITTER_MAX_MS,
+} from './socketHealthService.js';
+
+test('stale threshold has a 12 s floor plus 0-4 s jitter', () => {
+  assert.equal(resolveStaleThresholdMs(5000, 0), MIN_STALE_THRESHOLD_MS);
+  assert.equal(resolveStaleThresholdMs(20_000, 1500), 21_500);
+  for (let i = 0; i < 50; i++) {
+    const v = resolveStaleThresholdMs(undefined);
+    assert.ok(v >= MIN_STALE_THRESHOLD_MS && v < MIN_STALE_THRESHOLD_MS + STALE_JITTER_MAX_MS);
+  }
+});
+
+test('probeSocket resolves true on ack (socket.io v4 timeout().emit shape)', async () => {
+  const socket = {
+    timeout: () => ({ emit: (_ev, ack) => ack(null, { ok: true }) }),
+    emit: () => {},
+  };
+  assert.equal(await probeSocket(socket, { timeoutMs: 50 }), true);
+});
+
+test('probeSocket resolves false on ack timeout error and on a missing socket', async () => {
+  const socket = { timeout: () => ({ emit: (_ev, ack) => ack(new Error('timeout')) }), emit: () => {} };
+  assert.equal(await probeSocket(socket, { timeoutMs: 50 }), false);
+  assert.equal(await probeSocket(null), false);
+});
+
+test('probeSocket falls back to a local timer when the socket has no timeout()', async () => {
+  const silent = { emit: () => {} };
+  assert.equal(await probeSocket(silent, { timeoutMs: 20 }), false);
+  const acking = { emit: (_ev, ack) => ack() };
+  assert.equal(await probeSocket(acking, { timeoutMs: 20 }), true);
+});
+
+const tick = (ms) => new Promise((r) => setTimeout(r, ms));
+
+test('watchdog: a socket that answers the ping is NOT reconnected (onAlive instead of onStale)', async () => {
+  let staleCalls = 0;
+  let aliveCalls = 0;
+  const stop = startSocketHealthWatchdog({
+    getSocket: () => ({}),
+    getLastDataReceivedAt: () => 0, // very stale
+    isConnected: () => true,
+    onStale: () => { staleCalls += 1; },
+    onAlive: () => { aliveCalls += 1; },
+    intervalMs: 5,
+    jitterMs: 0,
+    requiredConsecutiveStaleChecks: 2,
+    minRecoveryGapMs: 1000,
+    probe: async () => true,
+  });
+  await tick(60);
+  stop();
+  assert.equal(aliveCalls, 1);
+  assert.equal(staleCalls, 0);
+});
+
+test('watchdog: a failed probe triggers exactly one reconnect per recovery gap', async () => {
+  let staleCalls = 0;
+  const stop = startSocketHealthWatchdog({
+    getSocket: () => ({}),
+    getLastDataReceivedAt: () => 0,
+    isConnected: () => true,
+    onStale: () => { staleCalls += 1; },
+    intervalMs: 5,
+    jitterMs: 0,
+    requiredConsecutiveStaleChecks: 2,
+    minRecoveryGapMs: 1000,
+    probe: async () => false,
+  });
+  await tick(60);
+  stop();
+  assert.equal(staleCalls, 1);
+});
+
+test('watchdog: fresh data during the probe counts as alive', async () => {
+  let staleCalls = 0;
+  let aliveArg = null;
+  let lastData = 0;
+  const stop = startSocketHealthWatchdog({
+    getSocket: () => ({}),
+    getLastDataReceivedAt: () => lastData,
+    isConnected: () => true,
+    onStale: () => { staleCalls += 1; },
+    onAlive: (arg) => { aliveArg = arg; },
+    intervalMs: 5,
+    jitterMs: 0,
+    requiredConsecutiveStaleChecks: 1,
+    minRecoveryGapMs: 1000,
+    probe: async () => { lastData = Date.now(); return false; },
+  });
+  await tick(40);
+  stop();
+  assert.equal(staleCalls, 0);
+  assert.deepEqual(aliveArg, { acked: false, dataArrived: true });
+});
+
+test('watchdog: healthy data never probes', async () => {
+  let probes = 0;
+  const stop = startSocketHealthWatchdog({
+    getSocket: () => ({}),
+    getLastDataReceivedAt: () => Date.now(),
+    isConnected: () => true,
+    onStale: () => {},
+    intervalMs: 5,
+    jitterMs: 0,
+    probe: async () => { probes += 1; return true; },
+  });
+  await tick(30);
+  stop();
+  assert.equal(probes, 0);
