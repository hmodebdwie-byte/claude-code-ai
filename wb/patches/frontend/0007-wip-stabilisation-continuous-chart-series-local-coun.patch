+++ b/src/live/services/chartClockService.test.js
@@ -0,0 +1,41 @@
+// Run: node --test "src/**/*.test.js"   (from /home/claude/wb/frontend)
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  noteServerTime,
+  getServerOffsetMs,
+  serverNowMs,
+  hasServerClock,
+  resetServerClock,
+} from './chartClockService.js';
+
+beforeEach(() => resetServerClock());
+
+test('no samples: offset 0, serverNow == local now', () => {
+  assert.equal(hasServerClock(), false);
+  assert.equal(getServerOffsetMs(), 0);
+  assert.equal(serverNowMs(1000), 1000);
+});
+
+test('first sample snaps, later samples are smoothed (EMA 0.2)', () => {
+  noteServerTime(10_000, 9_000); // server is 1 s ahead
+  assert.equal(getServerOffsetMs(), 1000);
+  assert.equal(hasServerClock(), true);
+  noteServerTime(11_500, 10_000); // sample 1500 → 1000 + 0.2 * 500
+  assert.equal(getServerOffsetMs(), 1100);
+  assert.equal(serverNowMs(20_000), 21_100);
+});
+
+test('a clock step larger than 2 s re-snaps instead of drifting for minutes', () => {
+  noteServerTime(10_000, 10_000);
+  noteServerTime(20_000, 15_000); // +5 s step (resume / NTP)
+  assert.equal(getServerOffsetMs(), 5000);
+});
+
+test('ignores invalid samples', () => {
+  noteServerTime(10_000, 9_500);
+  noteServerTime(NaN, 9_600);
+  noteServerTime(null, 9_600);
+  noteServerTime(0, 9_600);
+  assert.equal(getServerOffsetMs(), 500);
+});
diff --git a/src/live/services/chartGeometryService.js b/src/live/services/chartGeometryService.js
new file mode 100644
index 0000000..62ea04c
--- /dev/null
+++ b/src/live/services/chartGeometryService.js
@@ -0,0 +1,129 @@
+/**
+ * Pure chart geometry helpers for NewChart (no DOM, no lightweight-charts imports) so the
+ * money/state-visible behaviour — fixed viewport, time cursor, ROUND ENTRY autoscale, histogram
+ * scale, series build — can be pinned by `node --test` specs.
+ */
+
+/** Bars that fit the plot width; the viewport is FIXED at this density, never re-zoomed. */
+export const INITIAL_VISIBLE_BARS = 80;
+/** Empty columns kept to the right of the newest bar (room for the cursor + tag). */
+export const RIGHT_OFFSET = 18;
+/** Cursor may run this far past the newest bar while a candle is late (server hiccup). */
+export const CURSOR_MAX_FRACTION = 1.25;
+/** lightweight-charts' own floor for barSpacing. */
+const MIN_BAR_SPACING_PX = 0.5;
+
+/**
+ * Time-scale options for a fixed 80-bar window: `barSpacing = plotWidth / 80`, `rightOffset = 18`.
+ * Applied on chart creation and on resize only — never `setVisibleRange` over N bars, so a short
+ * series (first seconds after a reconnect) can no longer collapse the zoom.
+ */
+export function fixedViewportOptions(plotWidthPx) {
+  const w = Number(plotWidthPx);
+  const barSpacing =
+    Number.isFinite(w) && w > 0 ? Math.max(MIN_BAR_SPACING_PX, w / INITIAL_VISIBLE_BARS) : null;
+  return barSpacing == null
+    ? { rightOffset: RIGHT_OFFSET }
+    : { barSpacing, rightOffset: RIGHT_OFFSET };
+}
+
+/**
+ * How far past the newest bar's bucket start the server clock is, in bars (1 bar = 1 s).
+ * Clamped to [0, CURSOR_MAX_FRACTION]: never behind the newest bar, and parked ~1 column ahead
+ * if the next candle is late rather than marching off to the right edge.
+ */
+export function cursorFraction(serverNowMs, lastBarSec) {
+  const now = Number(serverNowMs);
+  const bar = Number(lastBarSec);
+  if (!Number.isFinite(now) || !Number.isFinite(bar)) return 0;
+  const frac = (now - bar * 1000) / 1000;
+  if (!Number.isFinite(frac)) return 0;
+  return Math.max(0, Math.min(CURSOR_MAX_FRACTION, frac));
+}
+
+/**
+ * Cursor x in overlay-parent px: pixel of the newest bar (from `timeToCoordinate`, plot-wrapper
+ * box) + cached plot→overlay offset + fractional progress × LIVE bar spacing.
+ * Returns null when any input is unusable so the caller keeps the last written position.
+ */
+export function cursorX(xLastBarPx, plotOffsetPx, fraction, barSpacingPx) {
+  if (xLastBarPx == null || plotOffsetPx == null || fraction == null || barSpacingPx == null) return null;
+  const x = Number(xLastBarPx);
+  const off = Number(plotOffsetPx);
+  const bs = Number(barSpacingPx);
+  const f = Number(fraction);
+  if (![x, off, bs, f].every(Number.isFinite) || bs <= 0) return null;
+  return x + off + f * bs;
+}
+
+/**
+ * Live bar spacing from two adjacent logical→pixel projections. `timeScale().options().barSpacing`
+ * is NOT used anywhere: lightweight-charts never writes the live value back into options, so it
+ * always reports the constructor default (6) regardless of the real zoom.
+ */
+export function barSpacingFromLogicals(xAtLogicalI, xAtLogicalIPlus1) {
+  if (xAtLogicalI == null || xAtLogicalIPlus1 == null) return null;
+  const a = Number(xAtLogicalI);
+  const b = Number(xAtLogicalIPlus1);
+  if (!Number.isFinite(a) || !Number.isFinite(b)) return null;
+  const bs = b - a;
+  return bs > 0 ? bs : null;
+}
+
+/**
+ * AreaSeries `autoscaleInfoProvider` body: widen the library's own visible-range result so the
+ * ROUND ENTRY price is always inside the axis range (price lines are never part of LWC autoscale).
+ */
+export function widenAutoscaleToInclude(original, price) {
+  if (!original || !original.priceRange) return original ?? null;
+  const p = Number(price);
+  if (!Number.isFinite(p) || p <= 0) return original;
+  const { minValue, maxValue } = original.priceRange;
+  if (p >= minValue && p <= maxValue) return original;
+  return {
+    priceRange: { minValue: Math.min(minValue, p), maxValue: Math.max(maxValue, p) },
+    ...(original.margins ? { margins: original.margins } : {}),
+  };
+}
+
+/**
+ * Histogram `autoscaleInfoProvider` result: 0..max(volume over the WHOLE loaded series), not the
+ * visible window. A $100k bar is therefore always taller than a $10k bar on the same chart, and
+ * two devices holding the same server window draw identical bar heights.
+ */
+export function volumeAutoscaleInfo(maxVolume) {
+  const m = Number(maxVolume);
+  return { priceRange: { minValue: 0, maxValue: Number.isFinite(m) && m > 0 ? m : 1 } };
+}
+
+export function volumeBarColor(candle, colors) {
+  const open = Number(candle?.open ?? candle?.close ?? 0);
+  const close = Number(candle?.close ?? candle?.open ?? 0);
+  return close >= open ? colors.volumeUp : colors.volumeDown;
+}
+
+/**
+ * Store candles (sorted, one per second) → lightweight-charts points. One bar per candle, flat
+ * candles included, so the x-axis is wall-clock across rounds and the cooldown.
+ */
+export function buildSeriesData(candles, colors) {
+  const rawData = [];
+  const volumeData = [];
+  const fallbackColor = colors?.volumeUp || '#888888';
+  let prevTime = null;
+  for (const c of Array.isArray(candles) ? candles : []) {
+    const time = Number(c?.timestamp);
+    const value = Number(c?.close);
+    if (!Number.isFinite(time) || !Number.isFinite(value) || value <= 0) continue;
+    if (prevTime != null && time <= prevTime) continue;
+    prevTime = time;
+    const vol = Number(c.volume);
+    rawData.push({ time, value });
+    volumeData.push({
+      time,
+      value: Number.isFinite(vol) && vol > 0 ? vol : 0,
+      color: volumeBarColor(c, colors) || fallbackColor,
+    });
+  }
+  return { rawData, volumeData };
+}
