+/**
+ * Stale-socket watchdog.
+ *
+ * Audit P3: the old thresholds (≈5–6 s stale, 2 s interval, 0–1 s jitter) made every client
+ * force-reconnect within the same second whenever the broadcaster stalled for ~10 s — each
+ * reconnect re-running the full subscribe bootstrap on the already-saturated API. Now:
+ *   - stale threshold floor 12 s plus 0–4 s per-client jitter (spread the herd),
+ *   - a cheap `ping` ack probe BEFORE any reconnect: a socket that answers is alive and merely
+ *     quiet (cooldown, broadcaster hiccup) — reconnecting would only add load,
+ *   - reconnect only when the probe fails / times out.
+ * The server side needs a `@SubscribeMessage('ping')` handler that acks; until it exists the
+ * probe times out and the behaviour degrades to the old "reconnect when stale" (later, and
+ * jittered).
+ */
+
+export const MIN_STALE_THRESHOLD_MS = 12_000;
+export const STALE_JITTER_MAX_MS = 4_000;
+export const DEFAULT_PROBE_TIMEOUT_MS = 2_500;
+export const DEFAULT_PROBE_EVENT = 'ping';
+
+/** Effective threshold: never below the floor, plus per-client jitter. */
+export function resolveStaleThresholdMs(requestedMs, jitterMs) {
+  const base = Math.max(Number(requestedMs) || 0, MIN_STALE_THRESHOLD_MS);
+  const jitter = Number.isFinite(Number(jitterMs))
+    ? Math.max(0, Number(jitterMs))
+    : Math.floor(Math.random() * STALE_JITTER_MAX_MS);
+  return base + jitter;
