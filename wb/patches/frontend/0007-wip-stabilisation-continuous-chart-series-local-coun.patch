+  for (let ms = 0; ms <= 1000; ms += 250) {
+    xs.push(cursorX(xBar, 10, cursorFraction(bar * 1000 + ms, bar), bs));
+  }
+  assert.deepEqual(xs, [310, 311.125, 312.25, 313.375, 314.5]);
+  // Next bar appends (same on-screen pixel for the newest bar under shiftVisibleRangeOnNewBar):
+  // at t = bar+1 the cursor sits exactly one bar-width past the previous position origin.
+  const handoff = cursorX(xBar, 10, cursorFraction((bar + 1) * 1000 + 0, bar + 1), bs);
+  assert.equal(handoff, 310);
+  assert.equal(xs[4] - handoff, bs);
+});
