@@ -0,0 +1,91 @@
+import React, { useEffect, useRef } from 'react';
+import './TradeConfirmSheet.css';
+
+/**
+ * Trade confirmation (service agreement, Aug 2026 — "Trade Confirmation per the
+ * latest Figma frame"). Shown only when the trader has switched on
+ * Settings → Trade confirmation (`User.tradeConfirmation`); the preference
+ * existed but was never read before this sheet.
+ *
+ * Purely presentational: the caller decides to open it and places the order on
+ * confirm. Nothing is debited while the sheet is open.
+ */
+const money = (n) =>
+    Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+
+const TradeConfirmSheet = ({ isOpen, side, amount, balance, onConfirm, onCancel }) => {
+    const confirmRef = useRef(null);
+    const isSell = String(side).toLowerCase() === 'sell';
+
+    useEffect(() => {
+        if (!isOpen) return undefined;
+        const onKeyDown = (e) => {
+            if (e.key === 'Escape') onCancel?.();
+            if (e.key === 'Enter') onConfirm?.();
+        };
+        document.addEventListener('keydown', onKeyDown);
+        const previousOverflow = document.body.style.overflow;
+        document.body.style.overflow = 'hidden';
+        confirmRef.current?.focus();
+        return () => {
+            document.removeEventListener('keydown', onKeyDown);
+            document.body.style.overflow = previousOverflow;
+        };
+    }, [isOpen, onCancel, onConfirm]);
+
+    if (!isOpen) return null;
+
+    const remaining = Number(balance) - Number(amount);
+
+    return (
+        <div className="trade-confirm-overlay" onClick={onCancel} role="presentation">
+            <div
+                className={`trade-confirm-sheet ${isSell ? 'trade-confirm-sell' : 'trade-confirm-buy'}`}
+                role="dialog"
+                aria-modal="true"
+                aria-labelledby="trade-confirm-title"
+                onClick={(e) => e.stopPropagation()}
+            >
+                <div className="trade-confirm-grabber" aria-hidden="true" />
+                <h2 id="trade-confirm-title" className="trade-confirm-title">
+                    Confirm {isSell ? 'SELL' : 'BUY'}
+                </h2>
+                <p className="trade-confirm-subtitle">
+                    Your stake joins the {isSell ? 'Sell' : 'Buy'} pool for this round and stays committed until settlement.
+                </p>
+
+                <dl className="trade-confirm-rows">
+                    <div className="trade-confirm-row">
+                        <dt>Side</dt>
+                        <dd className="trade-confirm-side">{isSell ? 'SELL' : 'BUY'}</dd>
+                    </div>
+                    <div className="trade-confirm-row">
+                        <dt>Stake</dt>
+                        <dd>${money(amount)}</dd>
+                    </div>
+                    <div className="trade-confirm-row">
+                        <dt>Balance after</dt>
+                        <dd className={remaining < 0 ? 'trade-confirm-negative' : ''}>${money(remaining)}</dd>
+                    </div>
+                </dl>
+
+                <div className="trade-confirm-actions">
+                    <button type="button" className="trade-confirm-cancel" onClick={onCancel}>
+                        Cancel
+                    </button>
+                    <button
+                        type="button"
+                        ref={confirmRef}
+                        className="trade-confirm-go"
+                        onClick={onConfirm}
+                    >
+                        Place {isSell ? 'SELL' : 'BUY'} · ${money(amount)}
+                    </button>
+                </div>
+                <p className="trade-confirm-hint">Turn this step off in Settings → Trade confirmation.</p>
+            </div>
+        </div>
+    );
+};
+
+export default TradeConfirmSheet;
