index 0000000..4130bef
--- /dev/null
+++ b/src/live/services/tradeRejectionToast.js
@@ -0,0 +1,38 @@
+import { toast } from '../../utils/toast';
+
+/**
+ * Server-side order rejections the trading UI should explain instead of dropping silently.
+ * Codes come from the API (`error` field of the WsException payload).
+ */
+const MESSAGES = {
+  ROUND_LOCKED: 'The round is locked for its final moment — no more orders.',
+  BATTLE_FROZEN: 'The round is closing — orders are paused until the next round.',
+  ORDER_FREEZE: 'Orders are closed for the last seconds of this round.',
+  LAST_SECOND_SNIPE_LOCK: 'No further orders on this round after your last-second stake.',
+  AGGRESSIVE_TRADE_THROTTLED: 'Slow down — that order was throttled. Try again in a moment.',
+  'Insufficient balance': 'Insufficient balance for this order.',
+  'Battle is not active': 'This round has already ended.',
+};
+
+const REPEAT_GUARD_MS = 1500;
+let lastCode = null;
+let lastAt = 0;
+
+/**
+ * Shows one toast per rejection code (rate-limited so a burst of taps on a locked round
+ * produces one message).
+ *
+ * @returns {boolean} true when the error was a known trade rejection.
+ */
+export function handleTradeRejection(err) {
+  const code = err?.code ?? err?.error;
+  if (typeof code !== 'string') return false;
+  const message = MESSAGES[code];
+  if (!message) return false;
+  const now = Date.now();
+  if (code === lastCode && now - lastAt < REPEAT_GUARD_MS) return true;
+  lastCode = code;
+  lastAt = now;
+  toast.info(typeof err?.message === 'string' && err.message.trim() ? err.message : message);
+  return true;
+}
