+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { toast } from 'react-toastify';
+import { PermissionGate } from '../../hooks/usePermission';
+import { npcOrganicApi, getPath, withPath, describeApiError, fieldErrorsFrom } from './npcOrganicApi';
+
+const LIVE_POLL_MS = 1000;
+const STATUS_POLL_MS = 5000;
+const ROUNDS_POLL_MS = 10000;
+
+const APPLIES_LABEL = {
+  live: 'applies instantly',
+  next_round: 'from the next round',
+  settlement: 'at settlement',
+};
+
+const money = (v) => {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return '—';
+  return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
+};
+const num = (v, d = 0) => {
+  const n = Number(v);
+  return Number.isFinite(n) ? n.toFixed(d) : '—';
+};
+const when = (iso) => {
+  if (!iso) return '—';
+  const d = new Date(iso);
+  return Number.isNaN(d.getTime()) ? String(iso) : d.toLocaleString();
+};
+const sideClass = (side) => (side === 'BUY' ? 'organic-side-buy' : side === 'SELL' ? 'organic-side-sell' : '');
+const isSame = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+
+function usePoll(enabled, intervalMs, fn) {
+  const fnRef = useRef(fn);
+  useEffect(() => {
+    fnRef.current = fn;
+  }, [fn]);
+  useEffect(() => {
+    if (!enabled) return undefined;
+    let alive = true;
+    const tick = async () => {
+      if (!alive) return;
+      try {
+        await fnRef.current();
+      } catch {
+        /* the caller renders its own error state */
+      }
+    };
+    tick();
+    const id = setInterval(tick, intervalMs);
+    return () => {
+      alive = false;
+      clearInterval(id);
+    };
+  }, [enabled, intervalMs]);
+}
+
+/* ------------------------------------------------------------------------------------------ */
+
+function EngineStatusBar({ mode, savedVersion, status, onSwitchMode, switching }) {
+  const engine = status?.engine ?? null;
+  const reporting = engine != null && (engine.heartbeatAgeMs == null || engine.heartbeatAgeMs < 20000);
+  const applied = engine?.settingsVersion ?? null;
+  const behind = reporting && applied != null && savedVersion != null && applied < savedVersion;
+  return (
+    <div className="organic-status-bar">
+      <div className="organic-status-cell">
+        <span className="organic-status-label">Engine mode</span>
+        <span className={`organic-pill ${mode === 'organic' ? 'organic-pill-on' : 'organic-pill-legacy'}`}>
+          {mode === 'organic' ? 'ORGANIC (directives)' : 'LEGACY simulator'}
+        </span>
+        <PermissionGate permission="npcSimulator.edit">
+          <button
+            type="button"
+            className="rotation-reset-link"
+            disabled={switching}
+            onClick={() => onSwitchMode(mode === 'organic' ? 'legacy' : 'organic')}
+          >
+            {switching ? 'Switching…' : mode === 'organic' ? 'Switch to legacy' : 'Switch to organic'}
+          </button>
+        </PermissionGate>
+      </div>
+      <div className="organic-status-cell">
+        <span className="organic-status-label">Engine</span>
+        {reporting ? (
+          <span className={`organic-pill ${engine.active ? 'organic-pill-on' : 'organic-pill-off'}`}>
+            {engine.active ? 'RUNNING' : 'STOPPED'}
+            {engine.battleId ? ` · round #${engine.battleId}` : ''}
+          </span>
+        ) : (
+          <span className="organic-pill organic-pill-off">NOT REPORTING</span>
+        )}
+        <span className="organic-status-hint">
+          {reporting
+            ? `heartbeat ${Math.round((engine.heartbeatAgeMs ?? 0) / 1000)} s ago`
+            : 'start the NPC simulator (worker) to see live status'}
+        </span>
+      </div>
+      <div className="organic-status-cell">
+        <span className="organic-status-label">Settings</span>
+        <span className="organic-pill organic-pill-neutral">saved v{savedVersion ?? 0}</span>
+        {reporting && (
+          <span className={`organic-pill ${behind ? 'organic-pill-warn' : 'organic-pill-on'}`}>
+            engine applied v{applied ?? 0}
+          </span>
+        )}
+      </div>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------------------------------ */
+
+function FieldInput({ spec, value, disabled, onChange }) {
+  const id = `organic-${spec.path.replace(/\./g, '-')}`;
+  if (spec.type === 'boolean') {
+    return (
+      <label className="organic-toggle" htmlFor={id}>
+        <input id={id} type="checkbox" checked={Boolean(value)} disabled={disabled} onChange={(e) => onChange(e.target.checked)} />
+        <span className="organic-toggle-track">
+          <span className="organic-toggle-thumb" />
+        </span>
+        <span className="organic-toggle-text">{value ? 'ON' : 'OFF'}</span>
+      </label>
+    );
+  }
+  if (spec.type === 'select') {
+    return (
+      <select id={id} className="rotation-input organic-select" value={value ?? ''} disabled={disabled} onChange={(e) => onChange(e.target.value)}>
+        {(spec.options ?? []).map((o) => (
+          <option key={o.value} value={o.value}>
+            {o.label}
+          </option>
+        ))}
+      </select>
+    );
+  }
+  if (spec.type === 'text') {
+    return (
+      <input id={id} type="text" className="rotation-input left-align" value={value ?? ''} disabled={disabled} onChange={(e) => onChange(e.target.value)} />
+    );
+  }
+  const step = spec.step ?? (spec.type === 'integer' ? 1 : 'any');
+  return (
+    <div className="rotation-input-container">
+      <input
+        id={id}
+        type="number"
+        className="rotation-input left-align"
+        value={value ?? ''}
+        min={spec.min}
+        max={spec.max}
+        step={step}
+        disabled={disabled}
+        onWheel={(e) => e.target.blur()}
+        onChange={(e) => {
+          const raw = e.target.value;
+          if (raw === '') {
+            onChange('');
+            return;
+          }
+          const n = Number(raw);
+          onChange(Number.isFinite(n) ? n : raw);
+        }}
+      />
+      {spec.unit ? <span className="rotation-input-suffix">{spec.unit}</span> : null}
+    </div>
+  );
+}
+
+function FieldRow({ spec, value, savedValue, defaultValue, error, disabled, onChange }) {
+  const changed = !isSame(value, savedValue);
+  const isDefault = isSame(value, defaultValue);
+  const range =
+    spec.type === 'number' || spec.type === 'integer'
+      ? [spec.min != null ? `min ${spec.min}` : null, spec.max != null ? `max ${spec.max}` : null].filter(Boolean).join(' · ')
+      : '';
+  return (
+    <div className={`organic-field ${changed ? 'organic-field-changed' : ''} ${error ? 'organic-field-error' : ''}`}>
+      <div className="organic-field-head">
+        <label className="rotation-label" htmlFor={`organic-${spec.path.replace(/\./g, '-')}`}>
+          {spec.label}
+        </label>
+        <span className={`organic-applies organic-applies-${spec.applies}`}>{APPLIES_LABEL[spec.applies] ?? spec.applies}</span>
+        {changed && <span className="organic-badge organic-badge-changed">unsaved</span>}
+      </div>
+      <FieldInput spec={spec} value={value} disabled={disabled} onChange={onChange} />
+      <div className="rotation-italic-text organic-help">{spec.help}</div>
+      <div className="organic-field-foot">
+        {range && <span>{range}</span>}
+        {!isDefault && (
+          <button type="button" className="organic-link" disabled={disabled} onClick={() => onChange(defaultValue)}>
+            default: {String(defaultValue)}
+          </button>
+        )}
+        {error && <span className="organic-error">{error}</span>}
+      </div>
+    </div>
+  );
+}
+
+function SettingsView({ schema, doc, form, errors, saving, onChange, onSave, onDiscard, onReset }) {
+  const groups = useMemo(() => schema?.groups ?? [], [schema]);
+  const fields = useMemo(() => schema?.fields ?? [], [schema]);
+  const dirtyPaths = useMemo(
+    () => fields.filter((f) => !isSame(getPath(form, f.path), getPath(doc?.values, f.path))).map((f) => f.path),
+    [fields, form, doc],
+  );
+  const errorCount = Object.keys(errors ?? {}).length;
+  return (
+    <>
+      <div className="organic-intro rotation-italic-text">
+        Every value below is pushed to the engine the moment you save. “applies instantly” fields change the running round;
+        “from the next round” fields are read when a round opens; “at settlement” fields are read when the round is settled.
+        Rotation &amp; Limits still apply in organic mode. Volume Distribution, Pool Balance and NPC Behavior only affect the legacy engine.
+      </div>
+      {groups.map((g) => {
+        const groupFields = fields.filter((f) => f.group === g.key);
+        if (!groupFields.length) return null;
+        return (
+          <div className="rotation-card organic-group" key={g.key}>
+            <h3 className="rotation-card-title">{g.title}</h3>
+            <div className="rotation-italic-text organic-group-desc">{g.description}</div>
+            <div className="organic-grid">
+              {groupFields.map((spec) => (
+                <FieldRow
+                  key={spec.path}
+                  spec={spec}
+                  value={getPath(form, spec.path)}
+                  savedValue={getPath(doc?.values, spec.path)}
+                  defaultValue={getPath(schema?.defaults, spec.path)}
+                  error={errors?.[spec.path]}
+                  disabled={saving}
+                  onChange={(v) => onChange(spec.path, v)}
+                />
+              ))}
+            </div>
+          </div>
+        );
+      })}
+      <div className="rotation-footer organic-footer">
+        <span className="organic-footer-status">
+          {dirtyPaths.length ? `${dirtyPaths.length} unsaved change${dirtyPaths.length === 1 ? '' : 's'}` : 'All changes saved'}
+          {errorCount ? ` · ${errorCount} invalid` : ''}
+          {doc?.updatedAt ? ` · last saved ${when(doc.updatedAt)}` : ''}
+        </span>
+        <PermissionGate permission="npcSimulator.edit">
+          <button type="button" className="rotation-reset-link" onClick={onReset} disabled={saving}>
+            Reset to directive defaults
+          </button>
+          <button type="button" className="rotation-reset-link" onClick={onDiscard} disabled={saving || !dirtyPaths.length}>
+            Discard changes
+          </button>
+          <button type="button" className="rotation-save-btn" onClick={onSave} disabled={saving || !dirtyPaths.length}>
+            {saving ? 'Saving…' : 'Save & push to engine'}
+          </button>
+        </PermissionGate>
+      </div>
+    </>
+  );
+}
+
+/* ------------------------------------------------------------------------------------------ */
+
+function Stat({ label, value, className }) {
+  return (
+    <div className="organic-stat">
+      <div className="organic-stat-label">{label}</div>
+      <div className={`organic-stat-value ${className ?? ''}`}>{value}</div>
+    </div>
+  );
+}
+
+function LiveView({ live, engine, error }) {
+  if (error) return <div className="rotation-card organic-empty">{error}</div>;
+  if (!live) {
+    return (
+      <div className="rotation-card organic-empty">
+        No live round telemetry. The organic engine publishes this once per second while a round is open
+        {engine?.active === false ? ' — the NPC simulator is stopped.' : engine == null ? ' — the engine is not reporting.' : '.'}
+      </div>
+    );
+  }
+  const pots = live.pots ?? {};
+  const buyPot = Number(pots.buyPot ?? pots.buy_pot ?? NaN);
+  const sellPot = Number(pots.sellPot ?? pots.sell_pot ?? NaN);
+  const total = (Number.isFinite(buyPot) ? buyPot : 0) + (Number.isFinite(sellPot) ? sellPot : 0);
+  const buyShare = total > 0 ? buyPot / total : 0.5;
+  const phase = live.locked
+    ? 'LOCKED — final injection'
+    : live.steeringSide
+      ? `steering → ${live.steeringSide}`
+      : live.quietUntilMs
+        ? 'quiet period'
+        : live.boostActive
+          ? 'real-trade boost'
+          : 'organic flow';
+  const proj = live.projection;
+  const inj = live.injection;
+  const trades = Array.isArray(live.recentTrades) ? live.recentTrades.slice().reverse() : [];
+  const remainingSec = Math.max(0, Math.round(Number(live.remainingMs ?? 0) / 1000));
+  return (
+    <>
+      <div className="rotation-card organic-group">
+        <h3 className="rotation-card-title">
+          Round #{live.battleId} <span className="organic-phase">{phase}</span>
+        </h3>
+        <div className="organic-stats">
+          <Stat label="Elapsed / remaining" value={`${live.elapsedSec ?? 0} s / ${remainingSec} s`} />
+          <Stat label="Peak hours" value={live.peak ? 'yes' : 'no'} />
+          <Stat label="Settings applied" value={`v${live.settingsVersion ?? 0}`} />
+          <Stat label="Lead target" value={live.lead ? `${live.lead.side} ${num(live.lead.sharePct, 1)}% of NPC volume` : '—'} className={sideClass(live.lead?.side)} />
+          <Stat label="Initial wave" value={`${live.plan?.initialSpawns ?? 0} NPCs`} />
+          <Stat label="Tiers (whale/mid/retail)" value={`${live.tiers?.whale ?? 0} / ${live.tiers?.mid ?? 0} / ${live.tiers?.retail ?? 0}`} />
+          <Stat label="NPC trades" value={`${live.npcTradeCount ?? 0} by ${live.distinctNpcs ?? 0} NPCs`} />
+          <Stat label="Real trades" value={live.realTradeCount ?? 0} />
+          <Stat label="Sim volume BUY" value={money(live.simVolume?.BUY)} className="organic-side-buy" />
+          <Stat label="Sim volume SELL" value={money(live.simVolume?.SELL)} className="organic-side-sell" />
+          <Stat label="Last real trade" value={live.lastRealTrade ? `${live.lastRealTrade.side ?? ''} ${money(live.lastRealTrade.amount)}` : '—'} />
+          <Stat label="Steering (Defense A)" value={live.steeringSide ?? 'off'} className={sideClass(live.steeringSide)} />
+        </div>
+        <div className="organic-potbar">
+          <div className="organic-potbar-buy" style={{ width: `${Math.round(buyShare * 100)}%` }}>
+            BUY {money(buyPot)}
+          </div>
+          <div className="organic-potbar-sell" style={{ width: `${Math.round((1 - buyShare) * 100)}%` }}>
+            SELL {money(sellPot)}
+          </div>
+        </div>
+      </div>
+
+      <div className="rotation-card organic-group">
+        <h3 className="rotation-card-title">Projection (refreshed every 5 s) &amp; final injection</h3>
+        {proj ? (
+          <div className="organic-stats">
+            <Stat label="Planned defense" value={proj.kind === 'none' ? 'none needed' : `${proj.kind} → ${proj.side ?? ''} ${money(proj.amount)}`} className={sideClass(proj.side)} />
+            <Stat label="Projected winner" value={proj.winnerSide ?? '—'} className={sideClass(proj.winnerSide)} />
+            <Stat label="Real losing volume" value={money(proj.realLosingVolume)} />
+            <Stat label="Real winning volume" value={money(proj.realWinningVolume)} />
+            <Stat label="Sim profit (capped)" value={money(proj.simProfit)} />
+            <Stat label="Surplus to real winners" value={money(proj.surplusToReal)} />
+            <Stat label="Company net" value={money(proj.companyNet)} />
+            <Stat label="Simulator net" value={money(proj.simulatorNet)} />
+            <Stat label="Reason" value={proj.reason ?? '—'} />
+          </div>
+        ) : (
+          <div className="rotation-italic-text">
+            {Number(live.realTradeCount ?? 0) === 0
+              ? 'No real stakes in this round yet — there is nothing to defend. The projection starts with the first real trade.'
+              : 'Projection pending (refreshed every 5 s).'}
+          </div>
+        )}
+        {inj && (
+          <div className="organic-injection">
+            <strong>Executed:</strong> {inj.kind} on {inj.side} — planned {money(inj.planned)}, executed {money(inj.executed)} in{' '}
+            {Array.isArray(inj.slices) ? inj.slices.length : 0} slices; locked at {when(inj.lockedAt)}; took {inj.durationMs ?? 0} ms.
+          </div>
+        )}
+      </div>
+
+      <div className="rotation-card organic-group">
+        <h3 className="rotation-card-title">Recent NPC trades</h3>
+        {trades.length ? (
+          <div className="organic-table-wrap">
+            <table className="organic-table">
+              <thead>
+                <tr>
+                  <th>t+ (s)</th>
+                  <th>NPC</th>
+                  <th>Tier</th>
+                  <th>Side</th>
+                  <th>Amount</th>
+                  <th>Reason</th>
+                </tr>
+              </thead>
+              <tbody>
+                {trades.map((t, i) => (
+                  <tr key={`${t.npcId ?? i}-${t.atMs ?? i}`}>
+                    <td>{t.elapsedSec != null ? num(t.elapsedSec, 1) : '—'}</td>
+                    <td>#{t.npcId ?? '—'}</td>
+                    <td>{t.tier ?? '—'}</td>
+                    <td className={sideClass(t.side)}>{t.side ?? '—'}</td>
+                    <td>{money(t.amount)}</td>
+                    <td>{t.reason ?? '—'}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        ) : (
+          <div className="rotation-italic-text">No NPC trade yet in this round.</div>
+        )}
+      </div>
+    </>
+  );
+}
+
+/* ------------------------------------------------------------------------------------------ */
+
+function RoundsView({ rounds, error, expanded, onToggle }) {
+  if (error) return <div className="rotation-card organic-empty">{error}</div>;
+  if (!rounds?.length) {
+    return <div className="rotation-card organic-empty">No settled rounds recorded yet. Rows appear after the first organic round settles.</div>;
+  }
+  return (
+    <div className="rotation-card organic-group">
+      <h3 className="rotation-card-title">Recent rounds (audit)</h3>
+      <div className="organic-table-wrap">
+        <table className="organic-table">
+          <thead>
+            <tr>
+              <th>Round</th>
+              <th>Winner</th>
+              <th>Real loser pool</th>
+              <th>Commission</th>
+              <th>Sim profit</th>
+              <th>Surplus → real</th>
+              <th>Company net</th>
+              <th>Simulator net</th>
+              <th>Final defense</th>
+              <th>Locked</th>
+              <th />
+            </tr>
+          </thead>
+          <tbody>
+            {rounds.map((r) => {
+              const s = r.settlement ?? {};
+              const f = r.finalInjection ?? {};
+              const open = expanded === r.battleId;
+              return (
+                <React.Fragment key={r.battleId}>
+                  <tr className="organic-row" onClick={() => onToggle(r.battleId)}>
+                    <td>#{r.battleId}</td>
+                    <td className={sideClass(s.winnerSide)}>{s.winnerSide ?? '—'}</td>
+                    <td>{money(s.realLosingVolume)}</td>
+                    <td>{money(s.commission)}</td>
+                    <td>{money(s.simProfit)}</td>
+                    <td>{money(s.surplusToReal)}</td>
+                    <td>{money(s.companyNet)}</td>
+                    <td>{money(s.simulatorNet)}</td>
+                    <td>{f.kind ? `${f.kind} ${f.side ?? ''} ${money(f.executed)}` : '—'}</td>
+                    <td>{r.lockedAt ? when(r.lockedAt) : '—'}</td>
+                    <td>{open ? '▲' : '▼'}</td>
+                  </tr>
+                  {open && (
+                    <tr>
+                      <td colSpan={11}>
+                        <pre className="organic-json">
+                          {JSON.stringify({ plan: r.plan, projection: r.projection, finalInjection: r.finalInjection, settlement: r.settlement }, null, 2)}
+                        </pre>
+                      </td>
+                    </tr>
+                  )}
+                </React.Fragment>
+              );
+            })}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------------------------------ */
+
+export default function NpcOrganicEngine() {
+  const [view, setView] = useState('settings');
+  const [schema, setSchema] = useState(null);
+  const [doc, setDoc] = useState(null);
+  const [form, setForm] = useState(null);
+  const [errors, setErrors] = useState({});
+  const [loadError, setLoadError] = useState(null);
+  const [saving, setSaving] = useState(false);
+  const [switching, setSwitching] = useState(false);
+  const [status, setStatus] = useState(null);
+  const [live, setLive] = useState(null);
+  const [liveError, setLiveError] = useState(null);
+  const [rounds, setRounds] = useState([]);
+  const [roundsError, setRoundsError] = useState(null);
+  const [expandedRound, setExpandedRound] = useState(null);
+
+  const applyDoc = useCallback((data) => {
+    setDoc(data);
+    setForm(JSON.parse(JSON.stringify(data?.values ?? {})));
+    setErrors({});
+    setStatus({ engine: data?.engine ?? null, mode: data?.mode, version: data?.version });
+  }, []);
+
+  useEffect(() => {
+    let alive = true;
+    Promise.all([npcOrganicApi.schema(), npcOrganicApi.settings()])
+      .then(([s, d]) => {
+        if (!alive) return;
+        setSchema(s);
+        applyDoc(d);
+        setLoadError(null);
+      })
+      .catch((err) => {
+        if (!alive) return;
+        setLoadError(describeApiError(err, 'Failed to load the organic engine settings'));
+      });
+    return () => {
+      alive = false;
+    };
+  }, [applyDoc]);
+
+  usePoll(true, STATUS_POLL_MS, async () => {
+    const s = await npcOrganicApi.status();
+    setStatus(s);
+  });
+  usePoll(view === 'live', LIVE_POLL_MS, async () => {
+    try {
+      const r = await npcOrganicApi.live();
+      setLive(r.live ?? null);
+      setLiveError(null);
+    } catch (err) {
+      setLiveError(describeApiError(err, 'Failed to load live telemetry'));
+    }
+  });
+  usePoll(view === 'rounds', ROUNDS_POLL_MS, async () => {
+    try {
+      const r = await npcOrganicApi.rounds(25);
+      setRounds(r.rounds ?? []);
+      setRoundsError(null);
+    } catch (err) {
+      setRoundsError(describeApiError(err, 'Failed to load round audits'));
+    }
+  });
+
+  const onChange = useCallback((path, value) => {
+    setForm((prev) => withPath(prev ?? {}, path, value));
+    setErrors((prev) => {
+      if (!prev?.[path]) return prev;
+      const next = { ...prev };
+      delete next[path];
+      return next;
+    });
+  }, []);
+
+  const onSave = async () => {
+    if (!form) return;
+    setSaving(true);
+    try {
+      const data = await npcOrganicApi.save(form);
+      applyDoc(data);
+      toast.success(`Organic engine settings saved (v${data?.version}) and pushed to the engine`);
+    } catch (err) {
+      const fieldErrors = fieldErrorsFrom(err);
+      setErrors(fieldErrors);
+      toast.error(describeApiError(err, 'Failed to save settings'));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const onDiscard = () => {
+    setForm(JSON.parse(JSON.stringify(doc?.values ?? {})));
+    setErrors({});
+  };
+
+  const onReset = async () => {
+    if (!window.confirm('Reset every organic engine setting to the directive defaults? The engine mode is kept.')) return;
+    setSaving(true);
+    try {
+      const data = await npcOrganicApi.reset();
+      applyDoc(data);
+      toast.success('Organic engine settings reset to defaults');
+    } catch (err) {
+      toast.error(describeApiError(err, 'Failed to reset settings'));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const onSwitchMode = async (mode) => {
+    const text =
+      mode === 'legacy'
+        ? 'Switch to the LEGACY simulator? The organic engine stops trading immediately and the old reactive logic takes over.'
+        : 'Switch to the ORGANIC engine? The legacy simulator stops immediately and the directive engine takes over from the next poll.';
+    if (!window.confirm(text)) return;
+    setSwitching(true);
+    try {
+      const data = await npcOrganicApi.setMode(mode);
+      applyDoc(data);
+      toast.success(`NPC engine mode is now ${mode}`);
+    } catch (err) {
+      toast.error(describeApiError(err, 'Failed to switch engine mode'));
+    } finally {
+      setSwitching(false);
+    }
+  };
+
+  if (loadError) return <div className="rotation-card organic-empty">{loadError}</div>;
+  if (!schema || !doc || !form) return <div className="rotation-card organic-empty">Loading organic engine…</div>;
+
+  const mode = status?.mode ?? doc.mode;
+
+  return (
+    <div className="rotation-limits-wrapper organic-wrapper">
+      <EngineStatusBar mode={mode} savedVersion={status?.version ?? doc.version} status={status} onSwitchMode={onSwitchMode} switching={switching} />
+      <div className="organic-subnav">
+        {[
+          ['settings', 'Settings'],
+          ['live', 'Live round'],
+          ['rounds', 'Round audits'],
+        ].map(([key, label]) => (
+          <button key={key} type="button" className={`organic-subtab ${view === key ? 'active' : ''}`} onClick={() => setView(key)}>
+            {label}
+          </button>
+        ))}
+      </div>
+      {view === 'settings' && (
+        <SettingsView schema={schema} doc={doc} form={form} errors={errors} saving={saving} onChange={onChange} onSave={onSave} onDiscard={onDiscard} onReset={onReset} />
+      )}
+      {view === 'live' && <LiveView live={live} engine={status?.engine ?? null} error={liveError} />}
+      {view === 'rounds' && <RoundsView rounds={rounds} error={roundsError} expanded={expandedRound} onToggle={(id) => setExpandedRound((p) => (p === id ? null : id))} />}
+    </div>
+  );
+}
