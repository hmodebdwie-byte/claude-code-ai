diff --git a/src/Pages/AdminDashboard/npcOrganicApi.js b/src/Pages/AdminDashboard/npcOrganicApi.js
new file mode 100644
index 0000000..b14aee5
--- /dev/null
+++ b/src/Pages/AdminDashboard/npcOrganicApi.js
@@ -0,0 +1,75 @@
+import axiosInstance from '../../utils/axios';
+
+const BASE = '/admin/npc/organic';
+
+const authConfig = (extra = {}) => ({
+  ...extra,
+  headers: {
+    Authorization: localStorage.getItem('token'),
+    'Content-Type': 'application/json',
+    ...(extra.headers ?? {}),
+  },
+});
+
+/** Thin client for the Organic NPC Engine admin endpoints. Every call resolves to the response body. */
+export const npcOrganicApi = {
+  schema: () => axiosInstance.get(`${BASE}/schema`, authConfig()).then((r) => r.data),
+  settings: () => axiosInstance.get(`${BASE}/settings`, authConfig()).then((r) => r.data),
+  status: () => axiosInstance.get(`${BASE}/status`, authConfig()).then((r) => r.data),
+  save: (values) => axiosInstance.put(`${BASE}/settings`, { values }, authConfig()).then((r) => r.data),
+  reset: () => axiosInstance.post(`${BASE}/settings/reset`, {}, authConfig()).then((r) => r.data),
+  setMode: (mode) => axiosInstance.put(`${BASE}/mode`, { mode }, authConfig()).then((r) => r.data),
+  live: () => axiosInstance.get(`${BASE}/live`, authConfig()).then((r) => r.data),
+  rounds: (limit = 20) =>
+    axiosInstance.get(`${BASE}/rounds`, authConfig({ params: { limit } })).then((r) => r.data),
+};
+
+/** Reads `a.b.c` from a nested object; undefined when any segment is missing. */
+export function getPath(obj, path) {
+  let cur = obj;
+  for (const key of String(path).split('.')) {
+    if (cur == null || typeof cur !== 'object') return undefined;
+    cur = cur[key];
+  }
+  return cur;
+}
+
+/** Returns a copy of `obj` with `a.b.c` set to `value` (never mutates the input). */
+export function withPath(obj, path, value) {
+  const keys = String(path).split('.');
+  const clone = (node, depth) => {
+    if (depth === keys.length) return value;
+    const key = keys[depth];
+    const base = node && typeof node === 'object' ? { ...node } : {};
+    base[key] = clone(base[key], depth + 1);
+    return base;
+  };
+  return clone(obj, 0);
+}
+
+/** Human message for an axios error: joins the API's per-field `errors` list when present. */
+export function describeApiError(err, fallback) {
+  const data = err?.response?.data;
+  const msg = data?.message;
+  if (typeof msg === 'string' && msg.trim()) return msg;
+  if (Array.isArray(msg) && msg.length) return msg.join(' · ');
+  if (msg && typeof msg === 'object' && typeof msg.message === 'string') return msg.message;
+  return err?.message || fallback;
+}
+
+const FIELD_LINE = /^([a-zA-Z0-9_.]+):\s*(.+)$/;
+
+/**
+ * Per-field error map from a 400 response. The API answers with one
+ * `"<path>: <message>"` line per invalid field (`message` is an array of strings).
+ */
+export function fieldErrorsFrom(err) {
+  const data = err?.response?.data;
+  const lines = Array.isArray(data?.message) ? data.message : typeof data?.message === 'string' ? [data.message] : [];
+  const out = {};
+  for (const line of lines) {
+    const m = typeof line === 'string' ? line.match(FIELD_LINE) : null;
+    if (m) out[m[1]] = m[2];
+  }
+  return out;
+}
