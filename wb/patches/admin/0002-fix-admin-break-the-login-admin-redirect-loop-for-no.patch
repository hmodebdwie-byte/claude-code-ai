@@ -0,0 +1,146 @@
+// Portable source-component regression: npm run test:regression:admin-auth
+// Uses esbuild already installed by Vite; no browser, network, or real session.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const root = path.resolve(__dirname, '..');
+const localRequire = createRequire(path.join(root, 'package.json'));
+const esbuild = createRequire(localRequire.resolve('vite'))('esbuild');
+const sourceCache = new Map();
+const jsx = (type, props) => ({ type, props: props || {} });
+const Navigate = function Navigate() {};
+const Link = function Link() {};
+
+function fixture(auth, storedToken = auth.token) {
+  const events = [], effects = [];
+  const entries = new Map(storedToken ? [['token', storedToken]] : []);
+  const state = { ...auth };
+  const storage = { getItem: key => entries.get(key) ?? null,
+    setItem: (key, value) => entries.set(key, String(value)),
+    removeItem: key => entries.delete(key) };
+  const navigate = (to, options) => events.push({ type: 'navigate', to, options });
+  const dispatch = action => {
+    events.push({ type: 'dispatch', action });
+    if (action.type === 'auth/logout') {
+      state.isAuthenticated = false;
+      state.user = null;
+      state.token = null;
+      entries.delete('token');
+    }
+    return action;
+  };
+  const hooks = { useAuth: () => state, useAppDispatch: () => dispatch };
+  const authActions = {
+    logout: () => ({ type: 'auth/logout' }),
+    clearError: () => ({ type: 'auth/clearError' }),
+    loginUser: Object.assign(() => {}, { fulfilled: { match: () => false } }),
+    verifyOTP: Object.assign(() => {}, { fulfilled: { match: () => false } }),
+  };
+  const modules = {
+    react: { useState: initial => [initial, () => {}], useEffect: fn => effects.push(fn) },
+    'react/jsx-runtime': { jsx, jsxs: jsx, Fragment: 'fragment' },
+    'react-router-dom': { Navigate, Link, useNavigate: () => navigate },
+    'react-toastify': { toast: { info() {}, success() {}, error() {} } },
+    '../store/hooks': hooks, './store/hooks': hooks, '../../store/hooks': hooks,
+    './store/slices/authSlice': authActions, '../../store/slices/authSlice': authActions,
+    '../utils/encryption': { getEncryptedUser: () => state.user },
+  };
+  function component(relative) {
+    if (!sourceCache.has(relative)) sourceCache.set(relative,
+      esbuild.transformSync(fs.readFileSync(path.join(root, relative), 'utf8'),
+        { loader: 'jsx', format: 'cjs', jsx: 'automatic' }).code);
+    const module = { exports: {} };
+    vm.runInNewContext(sourceCache.get(relative), {
+      module, exports: module.exports, localStorage: storage, console,
+      require(name) {
+        if (Object.hasOwn(modules, name)) return modules[name];
+        if (/\.(css|png)$/.test(name)) return {};
+        throw new Error('Unexpected component dependency: ' + name);
+      },
+    }, { filename: relative });
+    return module.exports.default;
+  }
+  function guard() {
+    return component('src/Pages/ProtectedRoute.jsx')({ requireRole: 'admin', children: 'ADMIN_CONTENT' });
+  }
+  function login() {
+    effects.length = 0;
+    events.length = 0;
+    const view = component('src/Login.jsx')();
+    effects.forEach(effect => effect());
+    return { view, next: events.find(event => event.type === 'navigate')?.to };
+  }
+  function settle(initial) {
+    let route = initial;
+    const visited = new Set();
+    for (let step = 0; step < 8; step++) {
+      assert.ok(!visited.has(route), 'Redirect loop revisited ' + route);
+      visited.add(route);
+      if (route === '/unauthorized') return route;
+      if (route === '/admin') {
+        const result = guard();
+        if (result === 'ADMIN_CONTENT') return route;
+        route = result.props.to;
+      } else {
+        const result = login();
+        if (!result.next) return route;
+        route = result.next;
+      }
+    }
+    throw new Error('Redirect chain did not settle');
+  }
+  return { state, events, guard, login, settle, component };
+}
+
+const SESSION_ID = ['fixture', 'session'].join('-');
+const ORPHAN_ID = ['orphan', 'session'].join('-');
+const signedOut = { isAuthenticated: false, user: null, token: null };
+const session = role => ({ isAuthenticated: true, user: { role }, token: SESSION_ID });
+
+test('fully signed-out visitor reaches login', () => {
+  const f = fixture(signedOut);
+  assert.equal(f.guard().props.to, '/login');
+  assert.equal(f.settle('/admin'), '/login');
+});
+test('existing ADMIN role remains allowed', () => assert.equal(fixture(session('ADMIN')).guard(), 'ADMIN_CONTENT'));
+test('existing lowercase admin role remains allowed', () => assert.equal(fixture(session('admin')).guard(), 'ADMIN_CONTENT'));
+test('USER role reaches a stable denied page', () => assert.equal(fixture(session('USER')).settle('/'), '/unauthorized'));
+test('unrecognized role is denied without expanding privileges', () => assert.equal(fixture(session('SUPER_ADMIN')).settle('/admin'), '/unauthorized'));
+test('missing role is denied without a redirect cycle', () => assert.equal(fixture(session(undefined)).settle('/admin'), '/unauthorized'));
+test('malformed role value cannot crash the route guard', () => assert.equal(fixture(session({ name: 'ADMIN' })).settle('/admin'), '/unauthorized'));
+test('stored token with no user reaches session recovery', () => {
+  const f = fixture({ ...signedOut, token: ORPHAN_ID });
+  assert.equal(f.settle('/login'), '/unauthorized');
+});
+test('authenticated flag without a profile reaches session recovery', () => {
+  const f = fixture({ isAuthenticated: true, user: null, token: SESSION_ID });
+  assert.equal(f.settle('/'), '/unauthorized');
+});
+test('authenticated user without a token cannot enter admin', () => {
+  const f = fixture({ isAuthenticated: true, user: { role: 'ADMIN' }, token: null });
+  assert.equal(f.settle('/'), '/unauthorized');
+});
+test('authenticated admin login still settles on the dashboard', () => assert.equal(fixture(session('ADMIN')).settle('/login'), '/admin'));
+test('recovery signs out before navigating, so login stays usable', () => {
+  const f = fixture(session('USER'));
+  const view = f.component('src/Pages/UnauthorizedPage/index.jsx')();
+  let button;
+  function visit(node) {
+    if (!node || typeof node !== 'object') return;
+    if (node.type === 'button') button = node;
+    const children = node.props?.children;
+    (Array.isArray(children) ? children : [children]).forEach(visit);
+  }
+  visit(view);
+  assert.ok(button?.props.onClick, 'Recovery control must exist');
+  button.props.onClick();
+  assert.equal(f.events[0].type, 'dispatch');
+  assert.equal(f.events[0].action.type, 'auth/logout');
+  assert.equal(f.events[1].type, 'navigate');
+  assert.equal(f.events[1].to, '/login');
+  assert.equal(f.events[1].options.replace, true);
+  assert.equal(f.settle('/login'), '/login');
+});
