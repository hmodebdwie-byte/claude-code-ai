+/** One pip on the 5-decimal quote. */
+const PIP_SIZE = 0.0001;
+/** Smallest step the quote can show (0.1 pip) — the engine's floor for a real trade whose formula move is smaller. */
+const QUOTE_TICK = 0.00001;
+const OVERRIDE_POLL_MS = 5000;
+const LIVE_LOG_POLL_MS = 4000;
+const PREVIEW_POLL_MS = 5000;
+
+const authHeaders = () => ({ Authorization: localStorage.getItem('token'), 'Content-Type': 'application/json' });
+
+/**
+ * Same maths as the engine's `computeDeterministicPips` + `previewDeterministicPriceImpact`
+ * (packages/shared/src/battle/price-from-imbalance.ts): curve(amount) × (sensitivity / default) × multiplier,
+ * then rounded to the 5-decimal quote with a one-quote-tick floor. Used for the "unsaved settings"
+ * what-if; the "engine now" figure next to it comes from the API running the real function.
+ */
+function formulaPips({ amount, referenceAmount, referencePips, curve, sensitivity, multiplier, defaultSensitivity }) {
+  const amt = Math.max(0, Number(amount) || 0);
+  if (amt <= 0) return 0;
+  const refAmt = Math.max(1, Number(referenceAmount) || 1);
+  const refPips = Math.max(0.0001, Number(referencePips) || 0.0001);
+  const ratio = amt / refAmt;
+  let expected;
+  if (curve === 'linear') expected = refPips * ratio;
+  else if (curve === 'sqrt') expected = refPips * Math.sqrt(ratio);
+  else expected = refPips * (Math.log10(1 + amt) / Math.log10(1 + refAmt));
+  const sens = Math.min(10, Math.max(1, Math.round(Number(sensitivity) || 1)));
+  const mult = Math.max(0.1, Number(multiplier) || 1);
+  return expected * (sens / (Number(defaultSensitivity) || 5)) * mult;
+}
+
+function executedMove(pips, side, lastPrice) {
+  const price = Number(lastPrice) > 0 ? Number(lastPrice) : 1.25;
+  const sign = side === 'SELL' ? -1 : 1;
+  let after = parseFloat((price + sign * pips * PIP_SIZE).toFixed(5));
+  let floored = false;
+  if (pips > 0 && after === price) {
+    after = parseFloat((price + sign * QUOTE_TICK).toFixed(5));
+    floored = true;
+  }
+  const executedPips = Math.round(((after - price) / PIP_SIZE) * 10000) / 10000;
+  return { before: price, after, executedPips, floored };
+}
+
+const fmtPips = (v, digits = 2) => {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return '—';
+  return `${n > 0 ? '+' : ''}${n.toFixed(digits)}`;
+};
+const fmtPrice = (v) => (Number.isFinite(Number(v)) ? Number(v).toFixed(5) : '—');
+
