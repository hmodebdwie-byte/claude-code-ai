@@ -0,0 +1,18 @@
+/** Desired enablement controls Start/Stop; leader heartbeat controls activity. */
+export function deriveNpcRuntimeStatus(status) {
+  if (!status || typeof status !== "object") {
+    return { enabled: false, running: false, label: "STATUS UNAVAILABLE" };
+  }
+  const enabled = (status.desiredActive ?? status.active) === true;
+  const running = enabled && status.runningOnLeader === true;
+  const host = status.mode === "npc-worker" ? "WORKER" : "ENGINE";
+  return {
+    enabled,
+    running,
+    label: running
+      ? "SIMULATOR RUNNING"
+      : enabled
+        ? `ENABLED · ${host} NOT RUNNING`
+        : "SIMULATOR STOPPED",
+  };
+}
