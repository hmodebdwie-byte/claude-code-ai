diff --git a/src/hooks/useRiskTerminalSocket.js b/src/hooks/useRiskTerminalSocket.js
index c67c5e2..c758b52 100644
--- a/src/hooks/useRiskTerminalSocket.js
+++ b/src/hooks/useRiskTerminalSocket.js
@@ -15,14 +15,28 @@ export function useRiskTerminalSocket() {
   useEffect(() => {
     if (!socket) return undefined;
 
+    let expiryTimer = null;
+    const clearTick = () => {
+      if (expiryTimer !== null) clearTimeout(expiryTimer);
+      expiryTimer = null;
+      setTick(null);
+    };
+    // A connected socket can stop publishing this channel. Expire its last
+    // tick so the periodic REST response becomes authoritative again.
     const onUpdate = (payload) => {
       if (!payload || typeof payload !== "object") return;
+      if (expiryTimer !== null) clearTimeout(expiryTimer);
       setTick(payload);
+      expiryTimer = setTimeout(clearTick, 5000);
     };
 
+    setTick(null);
     socket.on("riskTerminalUpdate", onUpdate);
+    socket.on("disconnect", clearTick);
     return () => {
+      if (expiryTimer !== null) clearTimeout(expiryTimer);
       socket.off("riskTerminalUpdate", onUpdate);
+      socket.off("disconnect", clearTick);
     };
   }, [socket]);
 
