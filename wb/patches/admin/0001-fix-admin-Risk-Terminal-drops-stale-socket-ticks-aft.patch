+// Run from admin root: npm run test:regression:npc-risk
+// Uses Babel already installed by @vitejs/plugin-react; no new dependency or service.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const rootAdmin = path.resolve(__dirname, '..');
+const localRequire = createRequire(path.join(rootAdmin, 'package.json'));
+const babel = createRequire(localRequire.resolve('@vitejs/plugin-react'))('@babel/core');
+const sourceFor = (_project, suffix) => path.join(rootAdmin, {
+  'index.jsx': 'src/Pages/RiskManagementTerminal/index.jsx',
+  'useRiskTerminalSocket.js': 'src/hooks/useRiskTerminalSocket.js',
+  'npcSimulator.jsx': 'src/Pages/AdminDashboard/npcSimulator.jsx',
+  'npcRuntimeStatus.js': 'src/utils/npcRuntimeStatus.js',
+}[suffix]);
+function parse(file) {
+  const text = fs.readFileSync(file, 'utf8');
+  return { text, ast: babel.parseSync(text, { configFile: false, babelrc: false, parserOpts: { plugins: ['jsx'] } }) };
+}
+function walk(node, visit) {
+  if (!node || typeof node !== 'object') return;
+  if (typeof node.type === 'string') visit(node);
+  for (const value of Object.values(node)) {
+    if (Array.isArray(value)) value.forEach(child => walk(child, visit));
+    else if (value && typeof value === 'object') walk(value, visit);
+  }
+}
+function loadSource(file, mocks = {}, globals = {}) {
+  const imported = {}, exported = [];
+  const code = babel.transformSync(fs.readFileSync(file, 'utf8'), {
+    configFile: false, babelrc: false,
+    plugins: [() => ({ visitor: {
+      ImportDeclaration(p) {
+        const name = p.node.source.value;
+        assert.ok(Object.hasOwn(mocks, name), `Unexpected runtime dependency: ${name}`);
+        for (const binding of p.node.specifiers) {
+          imported[binding.local.name] = binding.type === 'ImportDefaultSpecifier'
+            ? mocks[name].default : binding.type === 'ImportNamespaceSpecifier'
+              ? mocks[name] : mocks[name][binding.imported.name];
+        }
+        p.remove();
+      },
+      ExportNamedDeclaration(p) {
+        assert.ok(p.node.declaration?.id?.name, 'Expected a named exported function');
+        exported.push(p.node.declaration.id.name);
+        p.replaceWith(p.node.declaration);
+      },
+    } })],
+  }).code;
+  const module = { exports: {} };
+  vm.runInNewContext(code + `\nmodule.exports = {${exported.join(',')}};`,
+    { module, console, setTimeout, clearTimeout, ...imported, ...globals }, { filename: file });
+  return module.exports;
+}
+// Extract the actual useMemo callback from the component, not a copied selector.
+function selectBattle(restBattle, liveTick, socketConnected) {
+  const { text, ast } = parse(sourceFor('admin', 'index.jsx'));
+  let callback;
+  walk(ast, node => {
+    if (node.type === 'VariableDeclarator' && node.id.name === 'activeBattle' && node.init?.type === 'CallExpression') {
+      const expression = node.init.arguments[0];
+      callback = text.slice(expression.start, expression.end);
+    }
+  });
+  assert.ok(callback, 'activeBattle useMemo callback must exist');
+  return vm.runInNewContext(`(${callback})()`, { restBattle, liveTick, socketConnected });
+}
+const rest = { battle_id: 42, pots: { real_buy: 200 } };
+const tick = { battle_id: 42, pots: { real_buy: 100 } };
+test('matching connected tick remains primary', () => assert.equal(selectBattle(rest, tick, true), tick));
+test('disconnect lets refreshed REST replace last matching socket tick', () => assert.equal(selectBattle(rest, tick, false), rest));
+test('REST no-active-battle does not resurrect old socket battle', () => assert.equal(selectBattle(null, tick, true), null));
+test('new REST battle never receives a previous battle tick', () => {
+  const next = { battle_id: 43 };
+  assert.equal(selectBattle(next, tick, true), next);
+});
+
+function hookFixture() {
+  let state = null, cleanup;
+  const handlers = new Map(), timers = new Map();
+  let nextTimer = 0;
+  const socket = { on: (event, handler) => handlers.set(event, handler),
+    off: (event, handler) => { if (handlers.get(event) === handler) handlers.delete(event); } };
+  const hook = loadSource(sourceFor('admin', 'useRiskTerminalSocket.js'), {
+    react: { useState: initial => { state = initial; return [state, value => { state = value; }]; }, useEffect: fn => { cleanup = fn(); } },
+    '../context/WebSocketProvider': { useWebSocket: () => ({ socket, connected: true }) },
+  }, {
+    setTimeout: (fn, ms) => { const id = ++nextTimer; timers.set(id, { fn, ms }); return id; },
+    clearTimeout: id => timers.delete(id),
+  });
+  hook.useRiskTerminalSocket();
+  return { read: () => state, handlers, timers,
+    emit: (event, value) => handlers.get(event)?.(value), cleanup: () => cleanup() };
+}
+test('socket disconnect clears stale stored tick', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick); f.emit('disconnect');
+  assert.equal(f.read(), null);
+});
+test('silent tick channel expires within five seconds so REST fallback can render', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick);
+  assert.equal(f.timers.size, 1);
+  const expiry = [...f.timers.values()][0];
+  assert.equal(expiry.ms, 5000); expiry.fn();
+  assert.equal(f.read(), null);
+});
+test('each new tick replaces old expiry; current tick is not cleared by a prior timer', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick);
+  const previousTimer = [...f.timers.keys()][0];
+  f.emit('riskTerminalUpdate', { ...tick, computed_at_ms: 2 });
+  assert.equal(f.timers.size, 1);
+  assert.equal(f.timers.has(previousTimer), false);
+  assert.equal(f.read().computed_at_ms, 2);
+});
+test('hook cleanup removes listeners and expiry work', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick); f.cleanup();
+  assert.equal(f.handlers.size, 0); assert.equal(f.timers.size, 0);
+});
+
+// Exercise the component's actual fetch-success callback and displayed label.
+function npcStatusDisplay(res) {
+  const { text, ast } = parse(sourceFor('admin', 'npcSimulator.jsx'));
+  let successCallback, labelExpression;
+  walk(ast, node => {
+    if (node.type === 'VariableDeclarator' && node.id.name === 'fetchSimulatorStatus') {
+      walk(node, child => {
+        if (child.type === 'CallExpression' && child.callee.type === 'MemberExpression' && child.callee.property.name === 'then') {
+          const callback = child.arguments[0];
+          successCallback = text.slice(callback.start, callback.end);
+        }
+      });
+    }
+    if (node.type === 'JSXExpressionContainer') {
+      const value = text.slice(node.expression.start, node.expression.end);
+      if (value.includes('"SIMULATOR ACTIVE"') || value === 'simulatorRuntime.label') labelExpression = value;
+    }
+  });
+  assert.ok(successCallback); assert.ok(labelExpression);
+  const derive = loadSource(sourceFor('admin', 'npcRuntimeStatus.js')).deriveNpcRuntimeStatus;
+  let enabled = false, status = null;
+  vm.runInNewContext(`(${successCallback})(res)`, {
+    res, setSimulatorStatus: value => { status = value; }, setIsRunning: value => { enabled = value; },
+    setRecentTrades: () => {}, setIsLoading: () => {}, deriveNpcRuntimeStatus: derive,
+  });
+  const label = vm.runInNewContext(labelExpression, { isRunning: enabled, simulatorRuntime: derive(status) });
+  return { enabled, label };
+}
+test('enabled simulator with absent NPC worker does not display ACTIVE', () => {
+  const shown = npcStatusDisplay({ active: true, desiredActive: true, runningOnLeader: false, mode: 'npc-worker' });
+  assert.equal(shown.enabled, true, 'Stop must remain available for desired enablement');
+  assert.equal(shown.label, 'ENABLED · WORKER NOT RUNNING');
+});
+test('enabled engine without heartbeat does not display ACTIVE', () => {
+  assert.equal(npcStatusDisplay({ active: true, desiredActive: true, runningOnLeader: false, mode: 'engine' }).label,
+    'ENABLED · ENGINE NOT RUNNING');
+});
+test('confirmed leader activity is shown as running', () => {
+  const shown = npcStatusDisplay({ active: true, desiredActive: true, runningOnLeader: true, mode: 'npc-worker' });
+  assert.equal(shown.enabled, true);
+  assert.ok(['SIMULATOR RUNNING', 'SIMULATOR ACTIVE'].includes(shown.label));
+});
+test('disabled desired state stays stopped even if stale heartbeat exists', () => {
+  const shown = npcStatusDisplay({ active: false, desiredActive: false, runningOnLeader: false, workerHeartbeatActive: true });
+  assert.equal(shown.enabled, false);
+  assert.equal(shown.label, 'SIMULATOR STOPPED');
+});
+
+test('malformed socket payload does not replace the last valid tick', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick);
+  f.emit('riskTerminalUpdate', null); f.emit('riskTerminalUpdate', 'invalid');
+  assert.equal(f.read(), tick);
+});
+test('disconnect cancels the pending expiry timer', () => {
+  const f = hookFixture(); f.emit('riskTerminalUpdate', tick); f.emit('disconnect');
+  assert.equal(f.timers.size, 0); assert.equal(f.read(), null);
+});
+test('missing status is unavailable rather than confirmed stopped', () => {
+  const derive = loadSource(sourceFor('admin', 'npcRuntimeStatus.js')).deriveNpcRuntimeStatus;
+  assert.equal(derive(null).label, 'STATUS UNAVAILABLE');
+  assert.equal(derive(null).running, false);
+});
+test('enabled flag without a confirmed heartbeat never claims running', () => {
+  assert.equal(npcStatusDisplay({ active: true, mode: 'npc-worker' }).label, 'ENABLED · WORKER NOT RUNNING');
+});
