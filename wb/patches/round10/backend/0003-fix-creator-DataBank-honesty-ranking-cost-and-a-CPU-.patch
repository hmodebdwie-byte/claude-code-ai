     r.benchmark = {
-      cohortSize: peers.length,
+      cohortSize: peersByArchetype.get(archetype).length,
       archetypePercentile: finite(r.intelligence.score)
-        ? percentileRank(
-            peers.map((x) => x.intelligence.score),
-            r.intelligence.score,
-          )
+        ? rankOn(archetypeLadders.get(archetype), r.intelligence.score)
         : null,
     };
     for (const [name, path] of Object.entries(rankSpecs)) {
       const val = get(r, path);
-      r.benchmark[name] = finite(val)
-        ? percentileRank(records.map((x) => get(x, path)).filter(finite), val)
