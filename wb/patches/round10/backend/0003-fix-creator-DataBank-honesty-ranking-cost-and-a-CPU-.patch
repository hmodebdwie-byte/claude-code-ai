+  // Cohorts and rank ladders are the same for every record, so build them once.
+  // Previously each record rebuilt one array per spec and percentileRank sorted
+  // it again, i.e. records x specs array builds and sorts (400 x 8 = 3200 sorts
+  // of a 400-element array on a full bank). Ranks are computed from the same
+  // sorted ladder with the same below + equal/2 formula, so values are identical.
+  const peersByArchetype = new Map();
+  for (const x of records) {
+    const k = x.identity.archetype;
+    let bucket = peersByArchetype.get(k);
+    if (bucket === undefined) peersByArchetype.set(k, (bucket = []));
+    bucket.push(x);
+  }
+  const ladder = (values) => values.filter(Number.isFinite).sort((a, b) => a - b);
+  const clampPercent = (v) => (v < 0 ? 0 : v > 100 ? 100 : v);
+  // Rank on a pre-sorted ladder: count strictly-below and equal by binary search.
+  const rankOn = (sorted, target) => {
+    if (!sorted.length || !Number.isFinite(target)) return 0;
+    let lo = 0, hi = sorted.length;
+    while (lo < hi) { const m = (lo + hi) >> 1; if (sorted[m] < target) lo = m + 1; else hi = m; }
+    const below = lo;
+    hi = sorted.length;
+    while (lo < hi) { const m = (lo + hi) >> 1; if (sorted[m] <= target) lo = m + 1; else hi = m; }
+    const equal = lo - below;
+    return clampPercent(((below + equal * 0.5) / sorted.length) * 100);
+  };
+  const archetypeLadders = new Map();
+  for (const [k, bucket] of peersByArchetype)
+    archetypeLadders.set(k, ladder(bucket.map((x) => x.intelligence.score)));
+  const specLadders = new Map();
+  for (const [name, path] of Object.entries(rankSpecs))
+    specLadders.set(name, ladder(records.map((x) => get(x, path))));
   for (const r of records) {
