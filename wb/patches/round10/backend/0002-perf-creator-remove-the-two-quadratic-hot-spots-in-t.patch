From 01d899390003c2eeb74458791636e4125343a5b4 Mon Sep 17 00:00:00 2001
From: TickTrade Workbench <hmodebdwie1@gmail.com>
Date: Sat, 19 Sep 2026 19:02:30 +0000
Subject: [PATCH 2/3] perf(creator): remove the two quadratic hot spots in the
 Intelligence DataBank build

Measured on synthetic data with the same shape the DataBank builds (traders x
events per trader), comparing the previous code against this one in the same
process:

  traders | events/trader | total events | before  | after  | speedup
      100 |           100 |       10,000 |    79ms |   18ms |   4.4x
      200 |           200 |       40,000 |   430ms |   73ms |   5.8x
      400 |           400 |      160,000 |  3,634ms |  310ms |  11.7x
      600 |           600 |      360,000 | 10,828ms |  731ms |  14.8x
      800 |           800 |      640,000 | 25,796ms | 1,223ms |  21.1x

Cost is now near-linear in total events (64x the events costs 68x the time)
instead of super-linear.

Two causes, both loop-invariant work inside a callback:

1. sd(v) in intelligence-utils.cjs, and its duplicate in
   intelligence-measured.cjs, called mean(v) from inside v.map(...). mean is an
   O(n) reduce, so each sd() was O(n^2). mean(v) is deterministic for a given
   array, so hoisting it changes no digit of the result. This was the dominant
   cost (~48% of profile ticks, plus the ArrayReduce time underneath it).

2. enrich() selected each trader's events with data.events.filter(e => e.id ===
   r.id) inside the row loop, i.e. O(rows x events). Replaced with a single
   bucketing pass; a forward pass appends in the same order filter produced.

Output is byte-identical: JSON.stringify of enrich() matches the previous
implementation exactly on every shape tried, including the degenerate ones
(0 and 1 events per trader) and deliberately interleaved event ordering.

No field was removed or simplified. The DataBank still carries its 20 model
sections / 200 field definitions and 76 measured fields per trader, all
verified by counting them at runtime rather than from documentation.

Suites after the change: tickscript 25/25, api jest 57 suites / 319 tests.
---
 packages/tickscript/intelligence-measured.cjs | 24 +++++++++++++++----
 packages/tickscript/intelligence-utils.cjs    | 13 ++++++----
 2 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/packages/tickscript/intelligence-measured.cjs b/packages/tickscript/intelligence-measured.cjs
index 76a0f8e..3e5e4d4 100644
--- a/packages/tickscript/intelligence-measured.cjs
+++ b/packages/tickscript/intelligence-measured.cjs
@@ -7,10 +7,13 @@ const root = { TickTradeResearchAnalytics: { mean, q, wilson, effective } };
     sum = (a) => a.reduce((s, v) => s + v, 0),
     mean = A.mean,
     q = A.q;
-  const sd = (a) =>
-    a.length > 1
-      ? Math.sqrt(sum(a.map((x) => (x - mean(a)) ** 2)) / (a.length - 1))
-      : null;
+  // Same loop-invariant hoist as intelligence-utils.cjs sd(): mean(a) was being
+  // recomputed for every element, making this O(n^2). Result is unchanged.
+  const sd = (a) => {
+    if (a.length <= 1) return null;
+    const m = mean(a);
+    return Math.sqrt(sum(a.map((x) => (x - m) ** 2)) / (a.length - 1));
+  };
   const ratio = (a, b) =>
     Number.isFinite(a) && Number.isFinite(b) && b !== 0 ? a / b : null;
   const n = (x) => (typeof x === "number" && Number.isFinite(x) ? x : null);
@@ -23,9 +26,20 @@ const root = { TickTradeResearchAnalytics: { mean, q, wilson, effective } };
   function enrich(data, snapshot) {
     const index = new Map(data.events.map((e, i) => [e.sequence, i])),
       profiles = new Map(snapshot.profiles.map((p) => [p.traderId, p]));
+    // Bucket the events by trader in one pass. This used to be a
+    // `data.events.filter(...)` inside the row loop, which is O(rows x events):
+    // at 800 traders x 640k events that scan alone cost ~23s and is on the
+    // DataBank load / profile-switch path. A forward pass appends in the same
+    // order filter produced, so every downstream metric is unchanged.
+    const eventsByTrader = new Map();
+    for (const e of data.events) {
+      let bucket = eventsByTrader.get(e.id);
+      if (bucket === undefined) eventsByTrader.set(e.id, (bucket = []));
+      bucket.push(e);
+    }
     for (const r of data.rows) {
       const p = profiles.get(r.id) || {},
-        es = data.events.filter((e) => e.id === r.id),
+        es = eventsByTrader.get(r.id) || [],
         sizes = es.map((e) => e.amount),
         imp = es.map((e) => e.impact),
         aligned = es.map((e) => e.impact * e.sign),
diff --git a/packages/tickscript/intelligence-utils.cjs b/packages/tickscript/intelligence-utils.cjs
index 9b0a6f0..ef7feb0 100644
--- a/packages/tickscript/intelligence-utils.cjs
+++ b/packages/tickscript/intelligence-utils.cjs
@@ -7,10 +7,15 @@ const q = (v, p) => {
     i = (s.length - 1) * p;
   return s[Math.floor(i)] + (s[Math.ceil(i)] - s[Math.floor(i)]) * (i % 1);
 };
-const sd = (v) =>
-  v.length > 1
-    ? Math.sqrt(sum(v.map((x) => (x - mean(v)) ** 2)) / (v.length - 1))
-    : null;
+// `mean(v)` is loop-invariant. It used to sit inside the map callback, so an
+// O(n) reduce ran once per element and sd() was O(n^2); it is the dominant cost
+// of a DataBank build. Hoisting is arithmetically identical - mean(v) is
+// deterministic for a given array, so every digit of the result is unchanged.
+const sd = (v) => {
+  if (v.length <= 1) return null;
+  const m = mean(v);
+  return Math.sqrt(sum(v.map((x) => (x - m) ** 2)) / (v.length - 1));
+};
 const ratio = (a, b) =>
   Number.isFinite(a) && Number.isFinite(b) && b !== 0 ? a / b : null;
 const effective = (v) => ratio(sum(v) ** 2, sum(v.map((x) => x * x)));
